+}
+
+fn solve(mut counts: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
+    counts.sort_unstable();
+
+    if counts.iter().all(|&count| count == 0) {
+        return 0;
+    }
+
+    if let Some(&price) = memo.get(&counts) {
+        return price;
+    }
+
+    let mut lowest = u32::MAX;
+
+    for mask in 1u8..(1 << 5) {
+        let mut remaining = counts;
+        let mut group_size = 0;
+        let mut valid = true;
+
+        for i in 0..5 {
+            if mask & (1 << i) != 0 {
+                if remaining[i] == 0 {
+                    valid = false;
+                    break;
+                }
+
+                remaining[i] -= 1;
+                group_size += 1;
+            }
+        }
+
+        if valid {
+            let group_price = match group_size {
+                1 => 800,
+                2 => 1520,
+                3 => 2160,
+                4 => 2560,
+                5 => 3000,
+                _ => unreachable!(),
+            };
+
+            lowest = lowest.min(group_price + solve(remaining, memo));
+        }
+    }
+
+    memo.insert(counts, lowest);
+    lowest
 }
