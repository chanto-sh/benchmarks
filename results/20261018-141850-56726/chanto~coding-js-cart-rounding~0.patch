diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..2e362c1
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,49 @@
+// Fixed-point money helpers. Monetary amounts are integer cents (BigInt).
+
+const DECIMAL_RE = /^\s*([+-]?)(\d*)(?:\.(\d*))?\s*$/;
+
+// Parse a decimal value into { units, scale }, where value = units / 10^scale.
+function parseDecimal(value) {
+  const match = DECIMAL_RE.exec(String(value));
+  if (!match || (match[2] === "" && (match[3] === undefined || match[3] === ""))) {
+    throw new Error(`Invalid decimal: ${value}`);
+  }
+  const sign = match[1] === "-" ? -1n : 1n;
+  const whole = match[2] || "0";
+  const fraction = match[3] || "";
+  return { units: sign * BigInt(whole + fraction), scale: fraction.length };
+}
+
+// Divide and round half up (away from zero) to the nearest integer.
+function divRoundHalfUp(numerator, denominator) {
+  const negative = (numerator < 0n) !== (denominator < 0n);
+  const n = numerator < 0n ? -numerator : numerator;
+  const d = denominator < 0n ? -denominator : denominator;
+  let quotient = n / d;
+  if (2n * (n % d) >= d) quotient += 1n;
+  return negative ? -quotient : quotient;
+}
+
+// Convert a currency amount to whole cents, rounding half up if needed.
+function moneyToCents(value) {
+  const { units, scale } = parseDecimal(value);
+  if (scale <= 2) return units * 10n ** BigInt(2 - scale);
+  return divRoundHalfUp(units, 10n ** BigInt(scale - 2));
+}
+
+// `pct` percent of `amountCents`, rounded half up to the cent.
+function percentageCents(amountCents, pct) {
+  const { units, scale } = parseDecimal(pct);
+  return divRoundHalfUp(amountCents * units, 100n * 10n ** BigInt(scale));
+}
+
+// Format integer cents as a plain "1234.50" string.
+function formatCents(cents) {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const dollars = abs / 100n;
+  const remainder = abs % 100n;
+  return `${negative ? "-" : ""}${dollars}.${remainder.toString().padStart(2, "0")}`;
+}
+
+module.exports = { parseDecimal, divRoundHalfUp, moneyToCents, percentageCents, formatCents };
