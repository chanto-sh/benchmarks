index 0000000..fba2d87
--- /dev/null
+++ b/changelog/8365.bugfix.rst
@@ -0,0 +1,4 @@
+The ``tmpdir``, ``tmpdir_factory`` and ``tmp_path_factory`` fixtures now sanitize
+the user name when creating the base temporary directory, because it may contain
+characters which are not valid in directory names (for example when using a
+domain account on Windows).
diff --git a/src/_pytest/tmpdir.py b/src/_pytest/tmpdir.py
