+def _is_all_or_any_call(call):
+    """Return True if *call* is a call to ``all`` or ``any`` over a
+    comprehension which can be unrolled into an equivalent for loop.
+    """
+    if not isinstance(call.func, ast.Name):
+        return False
+    if call.func.id not in ("all", "any"):
+        return False
+    if len(call.args) != 1 or call.keywords:
+        return False
+    arg = call.args[0]
+    if not isinstance(arg, (ast.GeneratorExp, ast.ListComp)):
+        return False
+    return not any(getattr(gen, "is_async", 0) for gen in arg.generators)
+
