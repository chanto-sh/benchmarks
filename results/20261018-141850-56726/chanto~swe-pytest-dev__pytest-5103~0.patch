+        )
+        self.statements.append(
+            ast.Assign([ast.Name(done_var, ast.Store())], _NameConstant(False))
+        )
+        self.statements.extend(loop_statements)
+        explanation = self.explanation_param(
+            ast.Name(explanation_var, ast.Load())
+        )
+        return ast.Name(result_var, ast.Load()), explanation
