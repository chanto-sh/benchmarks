+    def _visit_all_or_any(self, call):
+        """Rewrite ``all``/``any`` over a comprehension into a for loop.
+
+        This mirrors the equivalent explicit for loop, so that on failure the
+        report shows the value which made the assertion fail instead of a
+        generator object or an unhelpful list of values.
+        """
+        is_all = call.func.id == "all"
+        comp = call.args[0]
+        result_var = self.variable()
+        explanation_var = self.variable()
+        done_var = self.variable()
+
+        # Visit the element expression separately: its evaluation statements
+        # go inside the loop, while its explanation is formatted there as well
+        # so that it refers to the element which is currently being evaluated.
+        saved_statements = self.statements
+        saved_on_failure = self.on_failure
+        self.statements = []
+        self.on_failure = []
+        self.push_format_context()
+        res, expl = self.visit(comp.elt)
+        inner_body = self.statements
+        format_var = self.pop_format_context(ast.Str(expl))
+        format_body = self.on_failure
+        self.statements = saved_statements
+        self.on_failure = saved_on_failure
+
+        # Coerce the result to a bool, just like all()/any() do.
+        inner_body.append(
+            ast.Assign(
+                [ast.Name(result_var, ast.Store())],
+                ast.UnaryOp(ast.Not(), ast.UnaryOp(ast.Not(), res)),
+            )
+        )
+        result = ast.Name(result_var, ast.Load())
+        save_explanation = format_body + [
+            ast.Assign([ast.Name(explanation_var, ast.Store())], format_var)
+        ]
+        break_result = [
+            ast.Assign([ast.Name(done_var, ast.Store())], _NameConstant(True)),
+            ast.Break(),
+        ]
+        # Remember the element which is currently being evaluated, so that
+        # the explanation refers to the element which decided the result (or
+        # the last one evaluated when the iterable is exhausted).
+        inner_body.extend(save_explanation)
+        if is_all:
+            # all() fails as soon as an element is false: stop iterating.
+            inner_body.append(
+                ast.If(ast.UnaryOp(ast.Not(), result), break_result, [])
+            )
+        else:
+            # any() succeeds as soon as an element is true: stop iterating.
+            inner_body.append(ast.If(result, break_result, []))
+
+        def visit_ignored(expr):
+            """Visit *expr*, keeping its statements but discarding its
+            explanation.
+            """
+            saved_statements = self.statements
+            saved_on_failure = self.on_failure
+            self.statements = []
+            self.on_failure = []
