+        def build_filters(index, filter_index):
+            gen = generators[index]
+            if filter_index >= len(gen.ifs):
+                if index + 1 < len(generators):
+                    # Stop the enclosing loop as well if the inner loop
+                    # already found the deciding element.
+                    return build_loop(index + 1) + [
+                        ast.If(
+                            ast.Name(done_var, ast.Load()), [ast.Break()], []
+                        )
+                    ]
+                return list(inner_body)
+            statements, condition = visit_ignored(gen.ifs[filter_index])
+            statements.append(
+                ast.If(condition, build_filters(index, filter_index + 1), [])
+            )
+            return statements
+
+        def build_loop(index):
+            gen = generators[index]
