 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import cmath
+import math
+
+
+def _complex_expm1(z):
+    """exp(z) - 1 without cancellation for small |z|."""
+    if abs(z) >= 0.5:
+        return cmath.exp(z) - 1.0
+
+    term = z
+    total = z
+    n = 2
+    while n < 50:
+        term *= z / n
+        total += term
+        if abs(term) <= 1e-17 * abs(total):
+            break
+        n += 1
+    return total
+
+
+def _sinc(x):
+    """sin(x) / x, with the limiting value at zero."""
+    if x == 0.0:
+        return 1.0
+    return math.sin(x) / x
+
+
+def _sinhc(x):
+    """sinh(x) / x, with the limiting value at zero."""
+    if x == 0.0:
+        return 1.0
+    return math.sinh(x) / x
+
+
+def _detuning(m, k, omega):
+    """k - m*omega^2, factored to stay accurate near resonance."""
+    natural_frequency = math.sqrt(k / m)
+    return m * (natural_frequency - omega) * (natural_frequency + omega)
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return P and Q for the particular solution P cos(wt) + Q sin(wt)."""
+    detuning = _detuning(m, k, omega)
+    damping = c * omega
+    denominator = math.hypot(detuning, damping)
+    if denominator == 0.0:
+        return None, None, denominator
+
+    scale = F0 / denominator
+    return scale * (detuning / denominator), scale * (damping / denominator), denominator
+
 
