 def response(t, b):
     """Integral of cos(t*x) / sqrt(x) for x from 0 to b.
 
-    Composite Simpson's rule. The integrand blows up at 0, so we start just
-    past it.
+    Substituting x = u**2 gives 2 * integral of cos(t*u**2) from 0 to
+    sqrt(b), which is smooth.  The interval is split so that the phase
+    advances by at most pi/4 per piece and each piece is integrated with a
+    16-point Gauss-Legendre rule.
     """
-    a = 1e-9
-    n = 10000
-    h = (b - a) / n
-    f = lambda x: math.cos(t * x) / math.sqrt(x)
-    s = f(a) + f(b)
-    for i in range(1, n):
-        s += (4 if i % 2 else 2) * f(a + i * h)
-    return s * h / 3
+    if t == 0.0:
+        return 2.0 * math.sqrt(b)
+
+    upper = math.sqrt(b)
+    n = max(1, math.ceil(8.0 * t * b / math.pi))
+    h = upper / n
+    total = 0.0
+    for i in range(n):
+        mid = (i + 0.5) * h
+        half = 0.5 * h
+        piece = 0.0
+        for node, weight in _GL16:
+            u1 = mid - half * node
+            u2 = mid + half * node
+            piece += weight * (math.cos(t * u1 * u1) + math.cos(t * u2 * u2))
+        total += half * piece
+    return 2.0 * total
