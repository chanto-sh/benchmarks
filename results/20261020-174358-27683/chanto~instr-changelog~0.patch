+def slugify(text: str) -> str:
+    slug = ""
+    for char in text.lower():
+        if char.isascii() and char.isalnum():
+            slug += char
+        elif slug and not slug.endswith("-"):
+            slug += "-"
+    return slug.rstrip("-")
+
