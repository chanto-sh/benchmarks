+def slugify(text: str) -> str:
+    chars: list[str] = []
+    pending_dash = False
+    for ch in text.lower():
+        if ch.isascii() and ch.isalnum():
+            if pending_dash and chars:
+                chars.append("-")
+            chars.append(ch)
+            pending_dash = False
+        else:
+            pending_dash = True
+    return "".join(chars)
+
+
 def title_case(text: str) -> str:
     return " ".join(w[:1].upper() + w[1:].lower() for w in text.split())
 
