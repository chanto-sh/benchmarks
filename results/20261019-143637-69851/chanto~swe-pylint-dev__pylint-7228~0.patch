+++ b/tests/config/test_regexp_argument_error.py
@@ -0,0 +1,29 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/PyCQA/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Tests for invalid regular expressions passed as options."""
+
+from __future__ import annotations
+
+import argparse
+from collections.abc import Callable
+
+import pytest
+
+from pylint.config.argument import (
+    _regexp_csv_transfomer,
+    _regexp_paths_csv_transfomer,
+    _regexp_transformer,
+)
+
+
+@pytest.mark.parametrize(
+    "transformer",
+    [_regexp_transformer, _regexp_csv_transfomer, _regexp_paths_csv_transfomer],
+)
+def test_invalid_regexp_raises_argument_type_error(
+    transformer: Callable[[str], object]
+) -> None:
+    with pytest.raises(argparse.ArgumentTypeError):
+        transformer(r"test_)")
