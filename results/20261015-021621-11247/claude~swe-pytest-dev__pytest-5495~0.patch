+    def test_bytes_diff(self):
+        """Bytes are diffed as text instead of being compared item by item (#5495)."""
+        diff = callequal(b"spam", b"eggs")[1:]
+        assert "- 'spam" in diff
+        assert "+ 'eggs" in diff
+
+    def test_bytes_diff_is_not_confusing(self):
+        # https://github.com/pytest-dev/pytest/issues/5495
+        # b"" == b"42" used to report "Right contains more items, first
+        # extra item: 52", where 52 is the ordinal of b"4".
+        expl = callequal(b"", b"42")
+        assert not any("more item" in line for line in expl)
+        assert "+ '42" in expl
+
     def test_list(self):
         expl = callequal([0, 1], [0, 2])
         assert len(expl) > 1
