+    def _add_dependent(self, cell):
+        self._dependents.append(cell)
+
+    def _propagate(self):
+        affected = self._affected_cells()
+        previous_values = {cell: cell._value for cell in affected}
+
+        for cell in affected:
+            cell._recompute()
+
+        for cell in affected:
+            if cell._value != previous_values[cell]:
+                cell._fire_callbacks()
+
+    def _affected_cells(self):
+        visited = set()
+        order = []
+
+        def visit(cell):
+            if cell in visited:
+                return
+            visited.add(cell)
+            for dependent in cell._dependents:
+                visit(dependent)
+            order.append(cell)
+
+        visit(self)
+        order.reverse()
+        return [cell for cell in order if isinstance(cell, ComputeCell)]
 
 
