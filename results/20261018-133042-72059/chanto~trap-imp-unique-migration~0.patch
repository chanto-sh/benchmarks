 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- This migration refuses to run if existing rows cannot satisfy the new
+-- constraints (NULL emails or case-insensitive duplicates). It aborts before
+-- any DDL, so no customer rows are modified or deleted. The production
+-- snapshot currently contains such rows; see BLOCKED.md.
+
+-- Precondition guard. Nothing below runs unless every existing row has a
+-- non-NULL email and a case-insensitively unique address.
+CREATE TEMP TABLE _002_precondition (
+    ok INTEGER NOT NULL
+        CONSTRAINT existing_users_have_null_or_duplicate_emails CHECK (ok = 1)
+);
+INSERT INTO _002_precondition (ok)
+SELECT CASE
+    WHEN EXISTS (SELECT 1 FROM users WHERE email IS NULL) THEN 0
+    WHEN EXISTS (
+        SELECT 1 FROM users
+        WHERE email IS NOT NULL
+        GROUP BY lower(email)
+        HAVING COUNT(*) > 1
+    ) THEN 0
+    ELSE 1
+END;
+DROP TABLE _002_precondition;
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique_ci ON users (lower(email));
+
+COMMIT;
