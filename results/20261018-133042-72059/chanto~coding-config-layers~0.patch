 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+
+_TRUE = {"1", "true", "yes", "on"}
+_FALSE = {"0", "false", "no", "off"}
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layers, lowest precedence first: built-in defaults, the JSON file at
+    `path` (if any), environment variables named ``SHOPD__<KEY>__...`` and
+    finally ``overrides`` (``"db.pool.size=20"`` strings).
+    """
+    cfg = deep_merge(DEFAULTS, {})
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
-    cfg = DEFAULTS
     if path:
         try:
             with open(path) as f:
@@ -17,4 +29,79 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+
+    if env is None:
+        env = os.environ
+    for name, raw in env.items():
+        if name[: len(ENV_PREFIX)].upper() != ENV_PREFIX:
+            continue
+        parts = [part.lower() for part in name[len(ENV_PREFIX) :].split("__")]
+        _apply(cfg, parts, ".".join(parts), raw)
+
+    for override in overrides:
+        parts, raw = _parse_override(override)
+        _apply(cfg, parts, ".".join(parts), raw)
+
+    return cfg
+
+
+def _parse_override(override):
+    if not isinstance(override, str) or "=" not in override:
+        raise ConfigError(f"invalid override {override!r}: expected NAME=VALUE")
+    name, raw = override.split("=", 1)
+    return [part.lower() for part in name.split(".")], raw
+
+
+def _apply(cfg, parts, dotted, raw):
+    default = _default_for(parts, dotted)
+    value = _convert(default, dotted, raw)
+
+    node = cfg
+    for part in parts[:-1]:
+        child = node.get(part)
+        if not isinstance(child, dict):
+            child = {}
+            node[part] = child
+        node = child
+    node[parts[-1]] = value
+
+
+def _default_for(parts, dotted):
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"cannot set section: {dotted}")
+    return node
+
+
+def _convert(default, dotted, raw):
+    if isinstance(default, bool):
+        text = raw.strip().lower() if isinstance(raw, str) else raw
+        if text in _TRUE:
+            return True
+        if text in _FALSE:
+            return False
+        raise ConfigError(f"{dotted}: invalid bool value: {raw!r}")
+
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{dotted}: invalid int value: {raw!r}") from None
+
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{dotted}: invalid float value: {raw!r}") from None
+
+    if isinstance(default, list):
+        text = raw if isinstance(raw, str) else str(raw)
+        if text.strip() == "":
+            return []
+        return [item.strip() for item in text.split(",")]
+
+    return raw if isinstance(raw, str) else str(raw)
