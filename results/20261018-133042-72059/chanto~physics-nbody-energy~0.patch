+    def test_eccentric_two_body_energy(self):
+        # Equal masses with a highly eccentric relative orbit (e = 0.5).
+        m = [1.0, 1.0]
+        pos = [[-0.5, 0.0], [0.5, 0.0]]
+        v = math.sqrt(3.0)
+        vel = [[0.0, -v / 2], [0.0, v / 2]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_figure_eight_energy_and_momentum(self):
+        # Chenciner-Montgomery figure-eight solution for three equal masses.
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        vx, vy = -0.93240737, -0.86473146
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vel = [[vx / 2, vy / 2], [vx / 2, vy / 2], [-vx, -vy]]
+        e0 = energy(m, pos, vel)
+        p0 = total_momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        for got, want in zip(total_momentum(m, q), p0):
+            self.assertAlmostEqual(got, want, places=10)
+
+    def test_lagrange_three_body_long_run(self):
+        # Equal masses at the vertices of an equilateral triangle.
+        m = [1.0, 1.0, 1.0]
