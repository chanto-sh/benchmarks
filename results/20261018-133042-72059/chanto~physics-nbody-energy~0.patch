diff --git a/nbody.py b/nbody.py
index 133b00d..bea7cf1 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,32 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick), which is symplectic and therefore
+    keeps the energy error bounded over long integrations instead of drifting.
+    """
+    n = len(masses)
+    positions = [list(p) for p in positions]
+    velocities = [list(v) for v in velocities]
+
+    acc = accelerations(masses, positions, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        # Kick: advance velocities by half a step.
+        for i in range(n):
+            velocities[i][0] += half_dt * acc[i][0]
+            velocities[i][1] += half_dt * acc[i][1]
+
+        # Drift: advance positions using the half-step velocities.
+        for i in range(n):
+            positions[i][0] += dt * velocities[i][0]
+            positions[i][1] += dt * velocities[i][1]
+
+        # Kick: recompute accelerations and advance velocities the other half.
+        acc = accelerations(masses, positions, G)
+        for i in range(n):
+            velocities[i][0] += half_dt * acc[i][0]
+            velocities[i][1] += half_dt * acc[i][1]
+
+    return positions, velocities
