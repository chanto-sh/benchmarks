 package wordsearch
 
+import "errors"
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve locates each word in the puzzle. Coordinates are given as {column, row}
+// pairs for the first and last letter of the word. If any word cannot be found
+// its coordinates are set to {-1, -1} and an error is returned.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	locations := make(map[string][2][2]int, len(words))
+	found := true
+	for _, word := range words {
+		start, end, ok := find(word, puzzle)
+		if !ok {
+			locations[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			found = false
+			continue
+		}
+		locations[word] = [2][2]int{start, end}
+	}
+	if !found {
+		return locations, errors.New("word not found in puzzle")
+	}
+	return locations, nil
+}
+
+func find(word string, puzzle []string) (start, end [2]int, ok bool) {
+	for row, line := range puzzle {
+		for col := range line {
+			for _, dir := range directions {
+				if matches(word, puzzle, col, row, dir) {
+					last := len(word) - 1
+					return [2]int{col, row},
+						[2]int{col + dir[0]*last, row + dir[1]*last},
+						true
+				}
+			}
+		}
+	}
+	return [2]int{}, [2]int{}, false
+}
+
+func matches(word string, puzzle []string, col, row int, dir [2]int) bool {
+	for i := 0; i < len(word); i++ {
+		c := col + dir[0]*i
+		r := row + dir[1]*i
+		if r < 0 || r >= len(puzzle) || c < 0 || c >= len(puzzle[r]) {
+			return false
+		}
+		if puzzle[r][c] != word[i] {
+			return false
+		}
+	}
+	return true
 }
