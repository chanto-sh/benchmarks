 package erratum
 
-func Use(opener ResourceOpener, input string) error {
-	panic("Please implement the Use function")
+import "fmt"
+
+func Use(opener ResourceOpener, input string) (err error) {
+	var res Resource
+	for {
+		res, err = opener()
+		if err == nil {
+			break
+		}
+		if _, ok := err.(TransientError); !ok {
+			return err
+		}
+	}
+
+	defer func() {
+		if closeErr := res.Close(); err == nil {
+			err = closeErr
+		}
+	}()
+
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		if frobErr, ok := r.(FrobError); ok {
+			res.Defrob(frobErr.defrobTag)
+		}
+		if e, ok := r.(error); ok {
+			err = e
+			return
+		}
+		err = fmt.Errorf("%v", r)
+	}()
+
+	res.Frob(input)
+	return nil
 }
