+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + _tagwords(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_tagwords(note.tags)}")
