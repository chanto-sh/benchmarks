         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..54edd1e 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,29 @@
-from dataclasses import asdict, dataclass
+import re
+from dataclasses import asdict, dataclass, field
+
+_BAD = re.compile(r"[\s,#]")
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty, or contains whitespace, a comma or '#'."""
+
+
+def normalize_tag(tag):
+    """Lowercase and trim one tag, rejecting empty or malformed ones."""
+    clean = tag.strip().lower()
+    if not clean or _BAD.search(clean):
+        raise InvalidTag(tag)
+    return clean
+
+
+def normalize_tags(tags):
+    """Normalize a sequence of tags, dropping duplicates but keeping order."""
+    out = []
+    for tag in tags:
+        clean = normalize_tag(tag)
+        if clean not in out:
+            out.append(clean)
+    return out
 
 
 @dataclass
@@ -6,10 +31,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
