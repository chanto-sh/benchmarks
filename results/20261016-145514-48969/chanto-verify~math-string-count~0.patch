 MOD = 1_000_000_007
 
+# States: (last_is_A, c_count mod 3) -> index a * 3 + r, for a in {0, 1}.
+# From a state we may append:
+#   B -> (0, r)
+#   C -> (0, (r + 1) % 3)
+#   A -> (1, r), only when the last letter was not A (a == 0)
+_SIZE = 6
+
+
+def _build_matrix():
+    m = [[0] * _SIZE for _ in range(_SIZE)]
+    for a in range(2):
+        for r in range(3):
+            src = a * 3 + r
+            m[0 * 3 + r][src] += 1              # append B
+            m[0 * 3 + (r + 1) % 3][src] += 1    # append C
+            if a == 0:
+                m[1 * 3 + r][src] += 1          # append A
+    return m
+
+
+_MATRIX = _build_matrix()
+
+
+def _mat_mul(x, y):
+    n = _SIZE
+    result = [[0] * n for _ in range(n)]
+    for i in range(n):
+        xi = x[i]
+        ri = result[i]
+        for k in range(n):
+            xik = xi[k]
+            if xik:
+                yk = y[k]
+                for j in range(n):
+                    ri[j] = (ri[j] + xik * yk[j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, power):
+    result = [[1 if i == j else 0 for j in range(_SIZE)] for i in range(_SIZE)]
+    base = matrix
+    while power:
+        if power & 1:
+            result = _mat_mul(result, base)
+        base = _mat_mul(base, base)
+        power >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    powered = _mat_pow(_MATRIX, n)
+    # Start from the empty code: state (last_is_A=0, c_count=0) = index 0.
+    # Valid codes end with c_count mod 3 == 0, i.e. states 0 and 3.
+    return (powered[0][0] + powered[3][0]) % MOD
