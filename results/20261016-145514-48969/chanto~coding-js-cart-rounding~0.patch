-  return (lineTotal * pct) / 100;
+const { roundHalfUp } = require("./format");
+
+// Per-line percentage discounts, in cents. Rounded to the cent (half up) per line.
+function discountFor(lineTotalCents, pct) {
+  return roundHalfUp((lineTotalCents * pct) / 100);
