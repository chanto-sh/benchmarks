-module.exports = { fmt };
+// Round a (possibly fractional) number of cents to the nearest cent, halves up.
+function roundHalfUp(cents) {
+  return Math.round(cents + (cents < 0 ? -1e-9 : 1e-9));
+}
+
+module.exports = { fmt, roundHalfUp };
