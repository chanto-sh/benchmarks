diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..0255a50 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -1,5 +1,6 @@
 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,34 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_all_even_multiplicity(self):
+        # (x - 1)^2 (x + 2)^2: the polynomial never changes sign.
+        # (x-1)^2(x+2)^2 = x^4 + 2x^3 - 3x^2 - 4x + 4
+        self.assertRoots(real_roots([1, 2, -3, -4, 4], -10, 10), [-2, 1])
+
+    def test_close_roots(self):
+        # 10^6 x^2 - (2*10^6 + 1) x + (10^6 + 1) has roots 1 and 1 + 1e-6
+        self.assertRoots(
+            real_roots([10 ** 6, -(2 * 10 ** 6 + 1), 10 ** 6 + 1], 0, 2),
+            [1, 1 + 1e-6],
+        )
+
+    def test_root_on_boundary(self):
+        # (x + 2)(x - 2) = x^2 - 4 with both roots exactly on the bounds
+        self.assertRoots(real_roots([1, 0, -4], -2, 2), [-2, 2])
+        # (x + 3) x (x - 3) on [-3, 3]
+        self.assertRoots(real_roots([1, 0, -9, 0], -3, 3), [-3, 0, 3])
+
+    def test_fraction_bounds(self):
+        # (2x - 1)(2x + 1) = 4x^2 - 1, roots at the fractional bounds
+        self.assertRoots(
+            real_roots([4, 0, -1], Fraction(-1, 2), Fraction(1, 2)), [-0.5, 0.5]
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
