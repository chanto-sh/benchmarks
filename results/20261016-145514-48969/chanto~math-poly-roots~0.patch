+    while len(r) - 1 >= db and not _is_zero(r):
+        shift = len(r) - 1 - db
+        coeff = r[0] / b[0]
+        q[(da - db) - shift] = coeff
+        for i in range(len(b)):
+            r[i] -= coeff * b[i]
+        r = _trim(r)
+    return _trim(q), r
