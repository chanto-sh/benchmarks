+// Format an integer number of cents as a plain "1234.50" string.
+function fmtCents(cents) {
+  const neg = cents < 0n;
+  const abs = neg ? -cents : cents;
+  return (neg ? "-" : "") + (abs / 100n).toString() + "." + (abs % 100n).toString().padStart(2, "0");
+}
+
+module.exports = { fmt, fmtCents };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..ec698ae
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,34 @@
+// Exact decimal helpers. Money is handled as an integer number of cents so
+// rounding rules (half up) never depend on binary floating point.
+
+// Parse a decimal value ("19.99", 15, 7.375) into { num, den }, num / den === value.
+function toFraction(value) {
+  const s = String(value).trim();
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?$/.exec(s);
+  if (!m || (m[2] === "" && !m[3])) throw new TypeError(`not a decimal number: ${value}`);
+  const frac = m[3] || "";
+  const num = BigInt((m[1] === "-" ? "-" : "") + (m[2] || "0") + frac);
+  const den = 10n ** BigInt(frac.length);
+  return { num, den };
+}
+
+// round(num / den) half up (toward +infinity), den > 0.
+function divRoundHalfUp(num, den) {
+  let q = num / den;
+  let r = num % den;
+  if (r < 0n) {
+    q -= 1n;
+    r += den;
+  }
+  if (r * 2n >= den) q += 1n;
+  return q;
+}
+
+// Parse an amount ("19.99") into an integer number of cents, rounding half up
+// if it carries more than two decimal places.
+function toCents(value) {
+  const { num, den } = toFraction(value);
+  return divRoundHalfUp(num * 100n, den);
+}
+
+module.exports = { toFraction, divRoundHalfUp, toCents };
