-  return (amount * rate) / 100;
+const { toFraction, divRoundHalfUp } = require("./money");
+
+// Sales tax in cents: `rate` percent of `amountCents`, rounded half up once
+// (README rule 3). `rate` is a percentage, e.g. 8.25.
+function taxFor(amountCents, rate) {
+  const { num, den } = toFraction(rate);
+  return divRoundHalfUp(amountCents * num, 100n * den);
 }
 
