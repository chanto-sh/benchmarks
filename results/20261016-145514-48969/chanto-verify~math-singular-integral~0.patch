 import math
 
 
+def _gauss_legendre(n):
+    """Nodes and weights on [-1, 1] via Newton iteration on P_n."""
+    nodes = [math.cos(math.pi * (i + 0.75) / (n + 0.5)) for i in range(n)]
+    for _ in range(100):
+        for i in range(n):
+            p0, p1 = 1.0, nodes[i]
+            for k in range(2, n + 1):
+                p1, p0 = ((2 * k - 1) * nodes[i] * p1 - (k - 1) * p0) / k, p1
+            dp = n * (nodes[i] * p1 - p0) / (nodes[i] * nodes[i] - 1.0)
+            nodes[i] -= p1 / dp
+    weights = []
+    for xi in nodes:
+        p0, p1 = 1.0, xi
+        for k in range(2, n + 1):
+            p1, p0 = ((2 * k - 1) * xi * p1 - (k - 1) * p0) / k, p1
+        dp = n * (xi * p1 - p0) / (xi * xi - 1.0)
+        weights.append(2.0 / ((1.0 - xi * xi) * dp * dp))
+    return nodes, weights
+
+
+# 32-point Gauss-Legendre rule, plenty for one panel of the oscillatory
+# integrand once the panel spans less than a radian of phase.
+_GL_NODES, _GL_WEIGHTS = _gauss_legendre(32)
+_MAX_PHASE_STEP = 1.0
+
+
