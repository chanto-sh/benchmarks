 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
+from app.config.defaults import DEFAULTS
 from app.config.errors import ConfigError
 from app.config.loader import load
 
@@ -29,5 +32,140 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class EnvTest(unittest.TestCase):
+    def test_env_sets_nested(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_env_key_case_insensitive(self):
+        cfg = load(env={"SHOPD__Db__Host": "db.internal"})
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_env_ignores_other_variables(self):
+        cfg = load(env={"PATH": "/bin", "SHOPDDB__PORT": "1"})
+        self.assertEqual(cfg, DEFAULTS)
+
+    def test_env_does_not_mutate_defaults(self):
+        load(env={"SHOPD__DB__HOST": "elsewhere"})
+        self.assertEqual(DEFAULTS["db"]["host"], "localhost")
+
+    def test_env_conversions(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "1.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__FEATURES": "search, billing ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 1.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_env_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_env_defaults_to_os_environ(self):
+        old = os.environ.get("SHOPD__DB__HOST")
+        os.environ["SHOPD__DB__HOST"] = "from-os"
+        try:
+            cfg = load()
+        finally:
+            if old is None:
+                del os.environ["SHOPD__DB__HOST"]
+            else:
+                os.environ["SHOPD__DB__HOST"] = old
+        self.assertEqual(cfg["db"]["host"], "from-os")
+
+    def test_env_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "5432"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_env_bad_value(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PORT": "abc"})
+        self.assertIn("db.port", str(cm.exception))
+
+    def test_env_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+
+class OverridesTest(unittest.TestCase):
+    def test_override_sets_nested(self):
+        cfg = load(overrides=["db.pool.size=20"])
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_override_precedence_over_env(self):
+        cfg = load(env={"SHOPD__DB__PORT": "1111"}, overrides=["db.port=2222"])
+        self.assertEqual(cfg["db"]["port"], 2222)
+
+    def test_precedence_file_env_override(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1, "host": "from-file"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2"},
+                overrides=["db.port=3"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3)
+        self.assertEqual(cfg["db"]["host"], "from-file")
+
+    def test_override_bad_value(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.port=5.5"])
+        self.assertIn("db.port", str(cm.exception))
+
+    def test_override_bad_bool(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.ssl=maybe"])
+        self.assertIn("db.ssl", str(cm.exception))
+
+    def test_override_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.prot=5432"])
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_override_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db=1"])
+        self.assertIn("db", str(cm.exception))
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_option(self):
+        proc = self.run_cli("--set", "db.port=6543")
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout)["db"]["port"], 6543)
+
+    def test_set_is_repeatable(self):
+        proc = self.run_cli("--set", "db.port=6543", "--set", "log.level=debug")
+        self.assertEqual(proc.returncode, 0)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_bad_set_exits_2(self):
+        proc = self.run_cli("--set", "db.prot=5432")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.prot", proc.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
