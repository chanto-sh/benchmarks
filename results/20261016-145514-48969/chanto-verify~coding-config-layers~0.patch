@@ -1,13 +1,24 @@
 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+
+_TRUE = ("1", "true", "yes", "on")
+_FALSE = ("0", "false", "no", "off")
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layered as: built-in defaults < JSON file at `path` < `env` variables
+    named SHOPD__<KEY>__<SUBKEY>... < `overrides` ("key.path=value" strings).
+    """
+    cfg = deep_merge(DEFAULTS, {})
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
-    cfg = DEFAULTS
     if path:
         try:
             with open(path) as f:
@@ -17,4 +28,64 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+
+    if env is None:
+        env = os.environ
+    for name, value in env.items():
+        if not name.startswith(ENV_PREFIX):
+            continue
+        parts = [p.lower() for p in name[len(ENV_PREFIX):].split("__")]
+        _apply(cfg, parts, value)
+
+    for item in overrides:
+        key, sep, value = item.partition("=")
+        if not sep:
+            raise ConfigError(f"invalid override (expected KEY=VALUE): {item!r}")
+        parts = [p.lower() for p in key.split(".")]
+        _apply(cfg, parts, value)
+
+    return cfg
+
+
+def _apply(cfg, parts, value):
+    """Convert `value` to the default's type and store it at the dotted path."""
+    dotted = ".".join(parts)
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{dotted} is a section, not a setting")
+
+    converted = _convert(dotted, node, value)
+
+    target = cfg
+    for part in parts[:-1]:
+        target = target[part]
+    target[parts[-1]] = converted
+
+
+def _convert(dotted, default, value):
+    if isinstance(default, bool):
+        low = value.strip().lower()
+        if low in _TRUE:
+            return True
+        if low in _FALSE:
+            return False
+        raise ConfigError(f"cannot convert {dotted}={value!r}: not a boolean")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except ValueError:
+            raise ConfigError(f"cannot convert {dotted}={value!r}: not an integer") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except ValueError:
+            raise ConfigError(f"cannot convert {dotted}={value!r}: not a number") from None
+    if isinstance(default, str):
+        return value
+    if isinstance(default, list):
+        return [item.strip() for item in value.split(",") if item.strip()]
+    raise ConfigError(f"unsupported setting type for {dotted}")
