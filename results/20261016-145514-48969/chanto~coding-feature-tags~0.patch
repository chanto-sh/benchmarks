--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,20 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty, or contains whitespace, a comma or a '#'."""
+
+
+def normalize_tags(tags):
+    """Lowercase and trim tags, dropping duplicates but keeping first-seen order."""
+    clean = []
+    for tag in tags:
+        name = tag.strip().lower()
+        if not name or any(c.isspace() for c in name) or "," in name or "#" in name:
+            raise InvalidTag(tag)
+        if name not in clean:
+            clean.append(name)
+    return clean
 
 
 @dataclass
@@ -6,10 +22,16 @@ class Note:
