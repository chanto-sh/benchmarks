@@ -38,6 +38,26 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def tag(self, note_id, tags):
+        note = self.get(note_id)
+        for t in tags:
+            if t not in note.tags:
+                note.tags.append(t)
+        return note
+
+    def untag(self, note_id, tags):
+        note = self.get(note_id)
+        note.tags = [t for t in note.tags if t not in tags]
+        return note
+
+    def tag_counts(self):
+        """(tag, count) pairs, most used first, ties alphabetically."""
+        counts = {}
+        for n in self.notes:
+            for t in n.tags:
+                counts[t] = counts.get(t, 0) + 1
+        return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+
     def save(self):
