+def _strip(p):
+    """Drop leading zero coefficients."""
+    i = 0
+    n = len(p)
+    while i < n and p[i] == 0:
+        i += 1
+    return p[i:]
+
+
+def _derivative(p):
+    p = _strip(p)
+    n = len(p)
+    if n <= 1:
+        return []
+    return [(n - 1 - i) * p[i] for i in range(n - 1)]
+
+
+def _divmod(a, b):
+    """Polynomial division over the rationals; lists are highest degree first."""
+    a = _strip(a)
+    b = _strip(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], list(a)
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = list(a)
+    for i in range(len(q)):
+        c = r[i] / b[0]
+        q[i] = c
+        if c:
+            for j in range(len(b)):
+                r[i + j] -= c * b[j]
+    return _strip(q), _strip(r[len(q):])
+
+
+def _monic(p):
+    p = _strip(p)
+    if not p:
+        return []
+    lc = p[0]
+    return [c / lc for c in p]
+
+
+def _gcd(a, b):
+    """Monic gcd of two rational polynomials."""
+    a, b = _strip(a), _strip(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    return _monic(a)
+
+
+def _squarefree(p):
+    """Square-free part of p as a primitive integer polynomial (leading > 0).
+
+    Returns [] if p is constant (i.e. has no roots).
+    """
+    if len(p) <= 1:
+        return []
+    g = _gcd(p, _derivative(p))
+    q, _ = _divmod(p, g)
+    q = _strip(q)
+    if len(q) <= 1:
+        return []
+    # Clear denominators, then divide out the integer content.
+    den = 1
+    for c in q:
+        den = den * c.denominator // gcd(den, c.denominator)
+    ints = [int(c * den) for c in q]
+    cont = 0
+    for c in ints:
+        cont = gcd(cont, abs(c))
+    ints = [c // cont for c in ints]
+    if ints[0] < 0:
+        ints = [-c for c in ints]
+    return ints
+
+
+def _sturm(p):
+    """Sturm sequence of a square-free polynomial with rational coefficients."""
+    seq = [[Fraction(c) for c in p]]
+    d = _derivative(seq[0])
+    if not d:
+        return seq
+    seq.append([Fraction(c) for c in d])
+    while True:
+        _, r = _divmod(seq[-2], seq[-1])
+        if not r:
+            break
+        r = [-c / abs(r[0]) for c in r]  # positive scaling keeps signs valid
+        seq.append(r)
+    return seq
+
+
+def _sign_changes(seq, x):
+    """Number of sign changes in the Sturm sequence evaluated at x."""
+    prev = 0
+    changes = 0
+    for poly in seq:
+        v = evaluate(poly, x)
+        if v > 0:
+            s = 1
+        elif v < 0:
+            s = -1
+        else:
+            continue
+        if prev and s != prev:
+            changes += 1
+        prev = s
+    return changes
+
+
+def _count(seq, a, b):
+    """Number of distinct roots in the half-open interval (a, b]."""
+    return _sign_changes(seq, a) - _sign_changes(seq, b)
+
+
+def _isolate(seq, a, b, count, out):
+    """Split (a, b] until every part contains exactly one root."""
+    if count <= 0:
+        return
+    if count == 1:
+        out.append((a, b))
+        return
+    m = (a + b) / 2
+    left = _count(seq, a, m)
+    if left > 0:
+        _isolate(seq, a, m, left, out)
+    if count - left > 0:
+        _isolate(seq, m, b, count - left, out)
+
+
+_TOL = Fraction(1, 10 ** 12)
+
+
+def _refine(seq, a, b):
+    """Bisect a bracket known to contain exactly one root, using Sturm counts."""
+    va = _sign_changes(seq, a)
