diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..12bb069 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -1,5 +1,6 @@
 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,37 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_triple_root(self):
+        # (x - 2)^3 = x^3 - 6x^2 + 12x - 8
+        self.assertRoots(real_roots([1, -6, 12, -8], -5, 5), [2])
+
+    def test_close_roots_not_merged(self):
+        # 10^7 x^4 - 4*10^7 x^2 + (4*10^7 - 1); pairs near +-sqrt(2 +- 1e-3.5)
+        got = real_roots([10000000, 0, -40000000, 0, 39999999], -5, 5)
+        want = sorted(
+            s * math.sqrt(2 + t * math.sqrt(1e-7))
+            for s in (1, -1)
+            for t in (1, -1)
+        )
+        self.assertRoots(got, want)
+
+    def test_roots_on_boundaries(self):
+        # roots -1 and 2, sitting exactly on the endpoints
+        self.assertRoots(real_roots([1, -3, 0, 4], -1, 2), [-1, 2])
+        self.assertRoots(real_roots([1, -2], 0, 2), [2])
+        self.assertRoots(real_roots([1, -2], 2, 5), [2])
+
+    def test_fraction_bounds(self):
+        # 2x^2 - 1 = 0 -> x = +-sqrt(1/2)
+        self.assertRoots(
+            real_roots([2, 0, -1], Fraction(0), Fraction(1)),
+            [math.sqrt(Fraction(1, 2))],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
