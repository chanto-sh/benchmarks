 from fractions import Fraction
+from math import comb
+
+
+def _hypergeom_at_least(r, b, k, s):
+    """P(at least k reds when s cards are drawn without replacement from r reds and b blues)."""
+    if k <= 0:
+        return Fraction(1)
+    if k > r or k > s:
+        return Fraction(0)
+    total = comb(r + b, s)
+    if total == 0:
+        return Fraction(0)
+    favourable = 0
+    for i in range(k, min(r, s) + 1):
+        favourable += comb(r, i) * comb(b, s - i)
+    return Fraction(favourable, total)
 
 
