 MOD = 1_000_000_007
 
+# States track (previous char was 'A', number of 'C's mod 3).
+# Index = prev_is_A * 3 + c_mod, for 6 states total.
+_N_STATES = 6
+
+
+def _idx(prev_is_a, c_mod):
+    return prev_is_a * 3 + c_mod
+
+
+def _build_transition():
+    """T[to][from] = number of ways to go from `from` to `to` by appending one letter."""
+    t = [[0] * _N_STATES for _ in range(_N_STATES)]
+    for prev_is_a in (0, 1):
+        for c_mod in range(3):
+            frm = _idx(prev_is_a, c_mod)
+            # Append 'B': previous char is no longer 'A', C-count unchanged.
+            t[_idx(0, c_mod)][frm] += 1
+            # Append 'C': C-count increases by one.
+            t[_idx(0, (c_mod + 1) % 3)][frm] += 1
+            # Append 'A': only allowed if the previous char was not 'A'.
+            if not prev_is_a:
+                t[_idx(1, c_mod)][frm] += 1
+    return t
+
+
+_TRANSITION = _build_transition()
+
+
+def _mat_mul(a, b):
+    n = len(a)
+    result = [[0] * n for _ in range(n)]
+    for i in range(n):
+        ai = a[i]
+        ri = result[i]
+        for k in range(n):
+            aik = ai[k]
+            if aik:
+                bk = b[k]
+                for j in range(n):
+                    ri[j] = (ri[j] + aik * bk[j]) % MOD
+    return result
+
+
+def _mat_pow(mat, exp):
+    n = len(mat)
+    result = [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+    while exp:
+        if exp & 1:
+            result = _mat_mul(result, mat)
+        mat = _mat_mul(mat, mat)
+        exp >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # Start from the empty string: no previous 'A', zero 'C's.
+    power = _mat_pow(_TRANSITION, n)
+    start = _idx(0, 0)
+    # Valid codes have a C-count divisible by 3 and may end in 'A' or not.
+    return (power[_idx(0, 0)][start] + power[_idx(1, 0)][start]) % MOD
