 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    origin = xs[0]
+    offsets = [x - origin for x in xs]
+
+    if not all(math.isfinite(d) for d in offsets):
+        # Values of opposite signs near the float limit can make x - origin
+        # overflow.  The mean is still finite, but the variance is not.
+        scale = max(abs(x) for x in xs)
+        mean = scale * (math.fsum(x / scale for x in xs) / n)
+        return mean, math.inf
+
+    try:
+        mean_offset = math.fsum(offsets) / n
+    except OverflowError:
+        scale = max(abs(d) for d in offsets)
+        mean_offset = scale * (math.fsum(d / scale for d in offsets) / n)
+    mean = origin + mean_offset
+
+    try:
+        var = math.fsum((d - mean_offset) * (d - mean_offset)
+                        for d in offsets) / n
+    except OverflowError:
+        # The variance can still be finite when the sum of squared
+        # deviations overflows, so scale before summing.
+        scale = max(abs(d) for d in offsets)
+        mean_offset /= scale
+        var_norm = math.fsum((d / scale - mean_offset) *
+                             (d / scale - mean_offset)
+                             for d in offsets) / n
+        std = scale * math.sqrt(var_norm)
+        var = std * std
+    return mean, var
 
 
