+def _env_parts(name):
+    """The lowercase setting path for an `SHOPD__...` variable, else None."""
+    if not name.upper().startswith(ENV_PREFIX):
+        return None
+    parts = [p.lower() for p in name[len(ENV_PREFIX):].split("__")]
+    if any(not p for p in parts):
+        return None
+    return parts
+
+
+def _parse_override(item):
+    name, sep, value = item.partition("=")
+    name = name.strip()
+    if not sep or not name:
+        raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+    parts = [p.strip().lower() for p in name.split(".")]
+    if any(not p for p in parts):
+        raise ConfigError(f"invalid setting name: {name}")
+    return parts, value
+
+
+def _assign(target, parts, value):
+    node = target
+    for part in parts[:-1]:
+        child = node.get(part)
+        if not isinstance(child, dict):
+            child = {}
+            node[part] = child
+        node = child
+    node[parts[-1]] = value
+
+
+def _convert(parts, value):
+    """Convert a string to the type of the built-in default for `parts`."""
+    default = _default_for(parts)
+    name = ".".join(parts)
+    if isinstance(default, bool):
+        text = str(value).strip().lower()
+        if text in _TRUE:
+            return True
+        if text in _FALSE:
+            return False
+        raise ConfigError(f"{name}: {value!r} is not a boolean")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{name}: {value!r} is not an integer") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{name}: {value!r} is not a number") from None
+    if isinstance(default, list):
+        text = value if isinstance(value, str) else str(value)
+        return [part.strip() for part in text.split(",") if part.strip()]
+    return value if isinstance(value, str) else str(value)
+
+
+def _default_for(parts):
+    node = DEFAULTS
+    name = ".".join(parts)
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {name}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{name} is a section, not a setting")
+    return node
