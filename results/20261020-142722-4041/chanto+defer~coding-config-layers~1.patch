+                env={"SHOPD__DB__PORT": "7000", "SHOPD__DB__HOST": "env.host"},
+                overrides=["db.port=8000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 8000)
+        self.assertEqual(cfg["db"]["host"], "env.host")
+        self.assertEqual(cfg["db"]["ssl"], False)
