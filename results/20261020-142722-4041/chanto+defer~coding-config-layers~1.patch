+class EnvironmentTest(unittest.TestCase):
+    def test_nested_and_case_insensitive(self):
+        cfg = load(env={
+            "SHOPD__DB__POOL__SIZE": "20",
+            "SHOPD__LOG__LEVEL": "debug",
+            "shopd__NAME": "api",
+            "HOME": "/tmp",
+            "SHOPD_NOT_A_SETTING": "ignored",
+        })
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["name"], "api")
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_converts_to_default_type(self):
+        cfg = load(env={
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "3.5",
+            "SHOPD__DB__SSL": "YES",
+            "SHOPD__LOG__JSON": "off",
+            "SHOPD__FEATURES": " search , admin ",
+        })
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.5)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "admin"])
+
+    def test_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_empty_env_mapping_means_no_environment_layer(self):
+        self.assertEqual(load(env={})["db"]["port"], 5432)
+
+
