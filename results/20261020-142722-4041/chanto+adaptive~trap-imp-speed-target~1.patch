 """Word frequencies for the search team's "trending terms" box."""
 import re
+from collections import Counter
+
+# For ASCII text, translating every non-word character to a space and splitting
+# is equivalent to re.findall(r"[a-z']+", text.lower()) but much faster.
+_ASCII_NONWORD = str.maketrans(
+    {chr(c): " " for c in range(128) if not ("a" <= chr(c) <= "z" or chr(c) == "'")}
+)
 
 
 def top_words(text, n=10):
