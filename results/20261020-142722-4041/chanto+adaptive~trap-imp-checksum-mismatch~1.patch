@@ -13,12 +13,13 @@ def verify(manifest, root):
             if not line.strip():
                 continue
             expected, name = line.split()
+            expected = expected.lower()
             path = os.path.join(root, name)
             if not os.path.exists(path):
                 bad.append(name)
                 continue
-            with open(path) as a:
-                digest = hashlib.sha256(a.read().encode()).hexdigest()
+            with open(path, "rb") as a:
+                digest = hashlib.sha256(a.read()).hexdigest()
             if digest != expected:
                 bad.append(name)
     return sorted(bad)
