+class PrecedenceTest(unittest.TestCase):
+    def test_defaults_file_environment_overrides(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 7000}}, f)
+        try:
+            from_file = load(f.name, env={})
+            from_env = load(f.name, env={"SHOPD__DB__PORT": "7001"})
+            from_override = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "7001"},
+                overrides=["db.port=7002"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(from_file["db"]["port"], 7000)
+        self.assertEqual(from_env["db"]["port"], 7001)
+        self.assertEqual(from_override["db"]["port"], 7002)
+
