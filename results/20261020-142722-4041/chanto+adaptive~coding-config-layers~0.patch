+class EnvironmentTest(unittest.TestCase):
+    def test_nested_and_case_insensitive(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__POOL__SIZE": "20",
+                "SHOPD__db__HOST": "db.internal",
+            }
+        )
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_unrelated_variables_ignored(self):
+        cfg = load(
+            env={
+                "PATH": "/bin",
+                "SHOPD_HOME": "/tmp",
+                "shopd__db__port": "7000",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_value_types(self):
+        cases = [
+            ("SHOPD__DB__PORT", "6543"),
+            ("SHOPD__DB__POOL__TIMEOUT", "3"),
+            ("SHOPD__DB__SSL", "YES"),
+            ("SHOPD__LOG__JSON", "off"),
+            ("SHOPD__LOG__LEVEL", "DEBUG"),
+            ("SHOPD__FEATURES", " search, images "),
+            ("SHOPD__FEATURES", ""),
+        ]
+        expected = [6543, 3.0, True, False, "DEBUG", ["search", "images"], []]
+        for (var, raw), want in zip(cases, expected):
+            with self.subTest(var=var, raw=raw):
+                cfg = load(env={var: raw})
+                value = cfg
+                for part in var[len("SHOPD__"):].lower().split("__"):
+                    value = value[part]
+                self.assertEqual(value, want)
+                self.assertIs(type(value), type(want))
+
+    def test_bool_spellings(self):
+        for raw in ["1", "true", "TRUE", "yes", "On"]:
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True)
+        for raw in ["0", "false", "FALSE", "no", "Off"]:
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False)
