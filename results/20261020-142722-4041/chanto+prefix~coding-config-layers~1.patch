@@ -17,4 +25,57 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
+    for key, value in env.items():
+        if key.upper().startswith(ENV_PREFIX):
+            parts = tuple(p.lower() for p in key[len(ENV_PREFIX):].split("__"))
+            cfg = _apply(cfg, parts, value)
+    for raw in overrides:
+        if "=" not in raw:
+            raise ConfigError(f"invalid override {raw!r}: expected SETTING=VALUE")
+        name, value = raw.split("=", 1)
+        cfg = _apply(cfg, _split_name(name), value)
     return deep_merge(cfg, {})
+
+
+def _split_name(name):
+    return tuple(p.strip().lower() for p in name.split("."))
+
+
+def _apply(cfg, parts, raw):
+    """A new config with the dotted setting `parts` set to `raw`, converted to its type."""
+    name = ".".join(parts)
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting {name}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{name} is a section, not a setting")
+    value = _convert(name, node, raw)
+    nested = value
+    for part in reversed(parts):
+        nested = {part: nested}
+    return deep_merge(cfg, nested)
+
+
+def _convert(name, default, raw):
+    kind = type(default)
+    try:
+        if kind is bool:
+            flag = raw.strip().lower()
+            if flag in _TRUE:
+                return True
+            if flag in _FALSE:
+                return False
+            raise ValueError(raw)
+        if kind is int:
+            return int(raw.strip())
+        if kind is float:
+            return float(raw.strip())
+        if kind is list:
+            return [item.strip() for item in raw.split(",") if item.strip()]
+        if kind is str:
+            return raw
+    except ValueError:
+        pass
+    raise ConfigError(f"{name}: cannot convert {raw!r} to {kind.__name__}")
