+class EnvTest(unittest.TestCase):
+    def test_env_sets_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertIsInstance(cfg["db"]["pool"]["size"], int)
+
+    def test_env_is_case_insensitive(self):
+        cfg = load(env={"shopd__DB__POOL__Size": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_env_ignores_other_variables(self):
+        cfg = load(env={"HOME": "/tmp", "DB_PORT": "1", "SHOPD_DB_PORT": "2"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_env_converts_types(self):
+        cfg = load(env={
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "7.5",
+            "SHOPD__DB__SSL": "Yes",
+            "SHOPD__LOG__JSON": "0",
+            "SHOPD__NAME": "other",
+            "SHOPD__FEATURES": " search , api , ",
+        })
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 7.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["name"], "other")
+        self.assertEqual(cfg["features"], ["search", "api"])
+
+    def test_env_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_env_bool_spellings(self):
+        for raw, expected in [("1", True), ("TRUE", True), ("on", True),
+                              ("0", False), ("No", False), ("OFF", False)]:
+            cfg = load(env={"SHOPD__DB__SSL": raw})
+            self.assertIs(cfg["db"]["ssl"], expected, raw)
+
+    def test_env_defaults_to_os_environ(self):
+        old = os.environ.get("SHOPD__LOG__LEVEL")
+        os.environ["SHOPD__LOG__LEVEL"] = "debug"
+        try:
+            self.assertEqual(load()["log"]["level"], "debug")
+        finally:
+            if old is None:
+                del os.environ["SHOPD__LOG__LEVEL"]
+            else:
+                os.environ["SHOPD__LOG__LEVEL"] = old
+
+    def test_env_precedence_over_file(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 6000}}, f)
+        try:
+            cfg = load(f.name, env={"SHOPD__DB__PORT": "7000"})
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 7000)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+    def test_bad_int(self):
+        for raw in ("abc", "5.5"):
+            with self.assertRaises(ConfigError) as cm:
+                load(env={"SHOPD__DB__PORT": raw})
+            self.assertIn("db.port", str(cm.exception))
+
+    def test_bad_bool(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__SSL": "maybe"})
+        self.assertIn("db.ssl", str(cm.exception))
+
+    def test_defaults_not_mutated(self):
+        load(env={"SHOPD__DB__PORT": "1", "SHOPD__FEATURES": "a,b"})
+        self.assertEqual(load()["db"]["port"], 5432)
+        self.assertEqual(load()["features"], ["search"])
+
+
+class OverridesTest(unittest.TestCase):
+    def test_override(self):
