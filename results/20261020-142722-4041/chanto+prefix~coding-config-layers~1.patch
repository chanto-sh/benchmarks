+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            capture_output=True, text=True,
+            env={"PATH": os.environ.get("PATH", ""), "PYTHONPATH": os.getcwd()},
+        )
+
+    def test_set_option(self):
+        p = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=yes")
+        self.assertEqual(p.returncode, 0, p.stderr)
+        cfg = json.loads(p.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_env_is_used(self):
