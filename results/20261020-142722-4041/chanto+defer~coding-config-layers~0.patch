 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+TRUE_VALUES = {"1", "true", "yes", "on"}
+FALSE_VALUES = {"0", "false", "no", "off"}
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    The defaults, then the JSON file at `path` (if any), then the
+    ``SHOPD__...`` variables in `env` (default: ``os.environ``), then the
+    ``"name=value"`` strings in `overrides`.
+    """
     cfg = DEFAULTS
     if path:
         try:
@@ -17,4 +27,85 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+    cfg = deep_merge(cfg, {})
+    if env is None:
+        env = os.environ
+    cfg = _apply(cfg, _env_entries(env))
+    return _apply(cfg, _override_entries(overrides))
+
+
+def _env_entries(env):
+    """(parts, raw value) pairs for the ``SHOPD__A__B`` variables in `env`."""
+    entries = []
+    for key in sorted(env):
+        if not key.upper().startswith(ENV_PREFIX):
+            continue
+        suffix = key[len(ENV_PREFIX):]
+        if not suffix:
+            continue
+        parts = [part.lower() for part in suffix.split("__")]
+        entries.append((parts, env[key]))
+    return entries
+
+
+def _override_entries(overrides):
+    """(parts, raw value) pairs for ``"a.b=value"`` override strings."""
+    entries = []
+    for item in overrides or ():
+        name, sep, value = item.partition("=")
+        if not sep or not name:
+            raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+        entries.append(([part.lower() for part in name.split(".")], value))
+    return entries
+
+
+def _apply(cfg, entries):
+    """Set each entry on `cfg`, converting its string value to the default's type."""
+    values = []
+    for parts, raw in entries:
+        name = ".".join(parts)
+        values.append((parts, _convert(name, raw, _default(name, parts))))
+    for parts, value in values:
+        nested = value
+        for part in reversed(parts):
+            nested = {part: nested}
+        cfg = deep_merge(cfg, nested)
+    return cfg
+
+
+def _default(name, parts):
+    """The built-in default for the dotted setting `name`, or a ConfigError."""
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {name}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"cannot set section {name}: expected a single setting")
+    return node
+
+
+def _convert(name, raw, default):
+    """`raw` as the same type as `default`, or a ConfigError naming the setting."""
+    if isinstance(default, bool):
+        text = raw.strip().lower()
+        if text in TRUE_VALUES:
+            return True
+        if text in FALSE_VALUES:
+            return False
+        raise ConfigError(f"invalid value for {name}: {raw!r} (expected a boolean)")
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError:
+            pass
+    elif isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError:
+            pass
+    elif isinstance(default, str):
+        return raw
+    elif isinstance(default, list):
+        return [item.strip() for item in raw.split(",") if item.strip()]
+    raise ConfigError(f"invalid value for {name}: {raw!r} (expected {type(default).__name__})")
