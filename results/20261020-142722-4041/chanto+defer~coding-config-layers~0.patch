+    def write_config(self, data):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump(data, f)
+        self.addCleanup(os.unlink, f.name)
+        return f.name
+
+    def test_environment_layer(self):
+        cfg = load(env={"SHOPD__DB__HOST": "env.internal", "SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_environment_case_insensitive_and_ignores_others(self):
+        cfg = load(
+            env={
+                "SHOPD__Db__Port": "6543",
+                "PATH": "/usr/bin",
+                "SHOPD_LEGACY": "ignored",
+                "OTHER__DB__PORT": "1",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["host"], "localhost")
+
+    def test_environment_top_level(self):
+        cfg = load(env={"SHOPD__NAME": "api", "SHOPD__FEATURES": "search, reports"})
+        self.assertEqual(cfg["name"], "api")
+        self.assertEqual(cfg["features"], ["search", "reports"])
+
+    def test_environment_conversions(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "7.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__LEVEL": "debug",
+                "SHOPD__FEATURES": "",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 7.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], [])
+
+    def test_boolean_values(self):
+        for raw, expected in [
+            ("1", True),
+            ("true", True),
+            ("Yes", True),
+            ("ON", True),
+            ("0", False),
+            ("FALSE", False),
+            ("no", False),
+            ("Off", False),
+        ]:
+            with self.subTest(raw=raw):
+                cfg = load(env={"SHOPD__DB__SSL": raw, "SHOPD__LOG__JSON": raw})
+                self.assertIs(cfg["db"]["ssl"], expected)
+                self.assertIs(cfg["log"]["json"], expected)
+
+    def test_environment_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "7000"}, clear=True):
+            self.assertEqual(load()["db"]["port"], 7000)
+
+    def test_precedence(self):
+        path = self.write_config({"db": {"port": 1111}})
+        self.assertEqual(load(path)["db"]["port"], 1111)
+        self.assertEqual(
+            load(path, env={"SHOPD__DB__PORT": "2222"})["db"]["port"], 2222
+        )
+        self.assertEqual(
+            load(
+                path,
+                env={"SHOPD__DB__PORT": "2222"},
+                overrides=["db.port=3333"],
+            )["db"]["port"],
+            3333,
+        )
+
+    def test_overrides(self):
+        cfg = load(
+            overrides=["db.pool.size=9", "db.ssl=yes", "features=search, metrics"]
+        )
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+
+    def test_unknown_setting(self):
+        for kwargs in (
+            {"env": {"SHOPD__DB__PROT": "1"}},
