+                    load(**kwargs)
+
+    def test_bad_values(self):
+        for kwargs, setting in (
+            ({"env": {"SHOPD__DB__PORT": "abc"}}, r"db\.port"),
+            ({"env": {"SHOPD__DB__PORT": "5.5"}}, r"db\.port"),
+            ({"env": {"SHOPD__DB__SSL": "maybe"}}, r"db\.ssl"),
+            ({"env": {"SHOPD__DB__POOL__TIMEOUT": "fast"}}, r"db\.pool\.timeout"),
+            ({"overrides": ["db.port=abc"]}, r"db\.port"),
+        ):
+            with self.subTest(**kwargs):
+                with self.assertRaisesRegex(ConfigError, setting):
+                    load(**kwargs)
+
+    def test_section_cannot_be_set(self):
+        for kwargs, setting in (
+            ({"env": {"SHOPD__DB": "x"}}, r"\bdb\b"),
+            ({"env": {"SHOPD__DB__POOL": "x"}}, r"db\.pool"),
