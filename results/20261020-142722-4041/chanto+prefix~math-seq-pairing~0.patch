-"""Integer keys for lists of non-negative integers."""
+"""Integer keys for lists of non-negative integers.
+
+Each value is written with an Elias gamma code.  The concatenation of
+these codes is a self-delimiting bit string, and every list corresponds
+to exactly one such string.  Those strings are enumerated by length and
+then lexicographically; an integer key is the position in that
+enumeration.  The resulting keys have about the same number of bits as
+the information in the list.
+"""
+
+
+def _count(length):
+    """Number of valid code strings of the given length."""
+    if length < 0:
+        return 0
+    if length == 0:
+        return 1
+    if length & 1:
+        return ((1 << length) + 1) // 3
+    return ((1 << length) - 1) // 3
+
+
+def _before(length):
+    """Number of valid code strings shorter than ``length``."""
+    if length <= 0:
+        return 0
+    if length & 1:
+        return ((1 << length) + 1) // 3
+    return ((1 << length) + 2) // 3
+
+
+def _prefix_count(length, zeros):
+    """Valid strings whose first code word has at most ``zeros`` zeros.
+
+    A code word with ``z`` leading zeros has length ``2*z + 1`` and
+    ``2**z`` possible payloads.
+    """
+    if zeros < 0:
+        return 0
+    # Sum over z=0..zeros of 2**z * count(length - 2*z - 1).
+    total = (1 << length) - (1 << (length - zeros - 1))
+    sign = -1 if (length - 1) & 1 else 1
+    total -= sign * ((1 << (zeros + 1)) - 1)
+    total //= 3
+    # The z with no room for a suffix has count 2**z (not 0).
+    if (length & 1) and zeros == (length - 1) // 2:
+        total += 1 << zeros
+    return total
+
+
+def _gamma(value):
+    """Elias gamma code of a non-negative integer."""
+    encoded = bin(value + 1)[2:]
+    return "0" * (len(encoded) - 1) + encoded
 
 
