 """Integer keys for lists of non-negative integers."""
 
 
+def _pair(a, b):
+    """A bijection from pairs of non-negative ints to non-negative ints.
+
+    Values are ranked by the total bit length of ``a + 1`` and ``b + 1``.
+    This keeps the result's bit length linear in the inputs' bit lengths,
+    so nesting for a long list does not make the key explode.
+    """
+    ap = a + 1
+    bp = b + 1
+    i = ap.bit_length() - 1
+    j = bp.bit_length() - 1
+    n = i + j
+
+    # Binary representations of a + 1 and b + 1, with their leading 1s
+    # removed, are binary strings of lengths i and j.
+    left = ap - (1 << i)
+    right = bp - (1 << j)
+
+    # Number (1 + (n - 1) * 2**n) of pairs in earlier groups, then the
+    # position within the group of size (n + 1) * 2**n.
+    return 1 + ((n - 1) << n) + (i << n) + (left << j) + right
+
+
+def _unpair(key):
+    """Inverse of :func:`_pair`."""
+    # Find n such that 1 + (n - 1) * 2**n <= key and key is before the
+    # next group.  C(n) = 1 + (n - 1) * 2**n is increasing.
+    lo, hi = 0, key.bit_length()
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if 1 + ((mid - 1) << mid) <= key:
+            lo = mid
+        else:
+            hi = mid - 1
+    n = lo
+
+    index = key - (1 + ((n - 1) << n))
+    i = index >> n
+    remainder = index - (i << n)
+    j = n - i
+    left = remainder >> j
+    right = remainder - (left << j)
+
+    return (1 << i) + left - 1, (1 << j) + right - 1
+
+
 def encode(lst):
     """The key for a list of non-negative ints."""
-    raise NotImplementedError
+    key = 0
+    for value in reversed(lst):
+        key = _pair(value, key) + 1
+    return key
 
 
 def decode(n):
     """The list whose key is n (n >= 0)."""
-    raise NotImplementedError
