     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+
+    total_cards = r + b + g
+    turned = min(max(m, 0), total_cards)
+    probability = Fraction(0)
+
+    # The first green is card p (1-indexed) for some p <= turned: the first
