+        hi = min(r, j - 1)
+        ways = sum(comb(r, x) * comb(b, j - 1 - x) for x in range(lo, hi + 1))
+        if ways:
+            total += Fraction(g * ways, comb(n, j) * j)
+
+    # No green among the first m cards: all m are red or blue.
+    lo = max(k, m - b)
+    hi = min(r, m)
+    ways = sum(comb(r, x) * comb(b, m - x) for x in range(lo, hi + 1))
+    if ways:
+        total += Fraction(ways, comb(n, m))
+
+    return total
