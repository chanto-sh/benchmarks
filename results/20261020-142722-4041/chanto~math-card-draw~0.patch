     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+    if k > r:
+        return Fraction(0)
+
+    n = r + b + g
+    m = max(0, min(m, n))
+
+    total = Fraction(0)
+
+    # First green at position j: the j-1 cards before it are red or blue,
+    # so the red count is hypergeometric over those r+b cards.
+    for j in range(1, m + 1):
