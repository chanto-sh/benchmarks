+class CommandLineTest(unittest.TestCase):
+    def run_cli(self, *args):
+        env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=PROJECT_ROOT,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_options_are_repeatable(self):
+        result = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=true")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        cfg = json.loads(result.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_bad_override_exits_2(self):
+        result = self.run_cli("--set", "db.prot=1")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.prot", result.stderr)
+
+    def test_bad_value_exits_2(self):
+        result = self.run_cli("--set", "db.port=abc")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.port", result.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
