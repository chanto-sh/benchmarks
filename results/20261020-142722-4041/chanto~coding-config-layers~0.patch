+def _convert(name, value, default):
+    """Convert the string `value` to the type of the built-in `default`."""
+    if isinstance(default, bool):
+        lowered = value.strip().lower()
+        if lowered in _TRUE:
+            return True
+        if lowered in _FALSE:
+            return False
+        raise ConfigError(f"{name}: invalid boolean {value!r}")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except ValueError:
+            raise ConfigError(f"{name}: invalid integer {value!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except ValueError:
+            raise ConfigError(f"{name}: invalid number {value!r}") from None
+    if isinstance(default, list):
+        if not value.strip():
+            return []
+        return [item.strip() for item in value.split(",") if item.strip()]
+    if isinstance(default, str):
+        return value
+    raise ConfigError(f"{name}: cannot set a value of this type")
+
+
+def _setting(name, value):
+    """Build the nested ``{section: {key: value}}`` dict for one dotted setting."""
+    parts = name.split(".")
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"{name}: unknown setting")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{name}: cannot set a whole section")
+    converted = _convert(name, value, node)
+    out = converted
+    for part in reversed(parts):
+        out = {part: out}
+    return out
+
