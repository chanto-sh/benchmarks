+class LayersTest(unittest.TestCase):
+    def test_env_layer(self):
+        cfg = load(env={
+            "SHOPD__DB__HOST": "db.internal",
+            "SHOPD__Db__Pool__Size": "20",
+        })
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_env_ignores_other_variables(self):
+        cfg = load(env={"DB_PORT": "1", "SHOPD": "2", "SHOPD__": "3"})
+        self.assertEqual(cfg, load(env={}))
+
+    def test_env_conversions(self):
+        cfg = load(env={
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "9.5",
+            "SHOPD__DB__SSL": "YES",
+            "SHOPD__LOG__JSON": "off",
+            "SHOPD__LOG__LEVEL": "debug",
+            "SHOPD__FEATURES": "search, billing ,",
+        })
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 9.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_overrides_layer(self):
+        cfg = load(overrides=["db.pool.size=20", "db.ssl=true", "log.level=warn"])
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"]["level"], "warn")
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111, "host": "file.internal"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222", "SHOPD__DB__HOST": "env.internal"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+
+    def test_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "7000"}, clear=True):
+            self.assertEqual(load()["db"]["port"], 7000)
+
+    def test_unknown_setting(self):
+        for cfg in (
+            lambda: load(env={"SHOPD__DB__PROT": "5432"}),
+            lambda: load(overrides=["db.prot=5432"]),
+        ):
+            with self.assertRaisesRegex(ConfigError, "db\\.prot"):
+                cfg()
+
+    def test_bad_int(self):
+        with self.assertRaisesRegex(ConfigError, "db\\.port"):
+            load(env={"SHOPD__DB__PORT": "abc"})
+        with self.assertRaisesRegex(ConfigError, "db\\.port"):
+            load(overrides=["db.port=5.5"])
+
+    def test_bad_bool(self):
+        with self.assertRaisesRegex(ConfigError, "db\\.ssl"):
+            load(env={"SHOPD__DB__SSL": "maybe"})
+
+    def test_bad_float(self):
