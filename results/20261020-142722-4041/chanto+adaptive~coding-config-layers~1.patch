+class EnvLayerTest(unittest.TestCase):
+    def test_nested_and_case_insensitive(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20", "shopd__DB__Host": "envhost"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["host"], "envhost")
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_other_variables_ignored(self):
+        cfg = load(env={"HOME": "/tmp", "SHOPD_DB_PORT": "1", "SHOPDX__DB__PORT": "1"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_conversions(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "3.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__FEATURES": " search, cache , ",
+                "SHOPD__NAME": "42",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "cache"])
+        self.assertEqual(cfg["name"], "42")
+
+    def test_bool_spellings(self):
+        for raw in ("1", "true", "YES", "On"):
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True)
+        for raw in ("0", "false", "NO", "Off"):
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_default_env_is_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "6000"}):
+            self.assertEqual(load()["db"]["port"], 6000)
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(overrides=["db.pool.size=20", "features=a, b", "db.ssl=true"])
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "file", "port": 1111}}, f)
