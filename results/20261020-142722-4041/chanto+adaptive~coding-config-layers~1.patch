@@ -17,4 +31,86 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
+
+    env_layer = _env_layer(env)
+    if env_layer:
+        cfg = deep_merge(cfg, env_layer)
+
+    override_layer = {}
+    for item in overrides:
+        name, value = _split_override(item)
+        path = _path(name)
+        _assign(override_layer, path, _convert(path, value))
+    if override_layer:
+        cfg = deep_merge(cfg, override_layer)
+
     return deep_merge(cfg, {})
+
+
+def _env_layer(env):
+    """The nested settings named by ``SHOPD__...`` variables in `env`."""
+    layer = {}
+    for name, value in env.items():
+        if not isinstance(name, str) or not name.upper().startswith(ENV_PREFIX):
+            continue
+        path = name[len(ENV_PREFIX):].lower().split("__")
+        _assign(layer, path, _convert(path, value))
+    return layer
+
+
+def _split_override(item):
+    name, sep, value = item.partition("=")
+    if not sep:
+        raise ConfigError(f"invalid override {item!r}: expected KEY=VALUE")
+    return name.strip(), value
+
+
+def _path(name):
+    return [part.strip().lower() for part in name.split(".")]
+
+
+def _default_at(path):
+    """The built-in default at `path`, or a ConfigError naming it."""
+    value = DEFAULTS
+    for part in path:
+        if not isinstance(value, dict) or part not in value:
+            raise ConfigError(f"unknown setting: {'.'.join(path)}")
+        value = value[part]
+    return value
+
+
+def _convert(path, raw):
+    """`raw` as the type of the built-in default at `path`."""
+    name = ".".join(path)
+    default = _default_at(path)
+    text = raw if isinstance(raw, str) else str(raw)
+
+    if isinstance(default, dict):
+        raise ConfigError(f"{name} is a section, not a setting")
+    if isinstance(default, bool):
+        lowered = text.strip().lower()
+        if lowered in _TRUE:
+            return True
+        if lowered in _FALSE:
+            return False
+        raise ConfigError(f"{name}: not a boolean: {text!r}")
+    if isinstance(default, int):
+        try:
+            return int(text)
+        except ValueError:
+            raise ConfigError(f"{name}: not an integer: {text!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(text)
+        except ValueError:
+            raise ConfigError(f"{name}: not a number: {text!r}") from None
+    if isinstance(default, list):
+        return [item.strip() for item in text.split(",") if item.strip()]
+    return text
+
+
+def _assign(layer, path, value):
+    node = layer
+    for part in path[:-1]:
+        node = node.setdefault(part, {})
+    node[path[-1]] = value
