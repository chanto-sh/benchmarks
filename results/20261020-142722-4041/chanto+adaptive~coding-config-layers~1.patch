+                env={"SHOPD__DB__HOST": "env", "SHOPD__DB__PORT": "2222"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["host"], "env")
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["pool"], {"size": 5, "timeout": 2.5})
+
+    def test_empty_override_value_is_empty_list(self):
+        self.assertEqual(load(overrides=["features="])["features"], [])
+
