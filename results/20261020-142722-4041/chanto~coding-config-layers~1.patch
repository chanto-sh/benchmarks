+_TRUE = {"1", "true", "yes", "on"}
+_FALSE = {"0", "false", "no", "off"}
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layers, lowest precedence first: the built-in defaults, the JSON file at
+    `path` (if any), the ``SHOPD__...`` variables in `env` (defaults to
+    ``os.environ``), and the ``name=value`` strings in `overrides`.
+    """
+    if env is None:
+        env = os.environ
     cfg = DEFAULTS
     if path:
         try:
@@ -17,4 +30,71 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
+    for name, value in env.items():
+        parts = _env_parts(name)
+        if parts is not None:
+            cfg = deep_merge(cfg, _nested(parts, _convert(parts, value)))
+    for item in overrides:
+        parts, value = _parse_override(item)
+        cfg = deep_merge(cfg, _nested(parts, _convert(parts, value)))
     return deep_merge(cfg, {})
+
+
+def _env_parts(name):
+    """The setting path named by a ``SHOPD__A__B`` variable, or None if it isn't one."""
+    if not name.upper().startswith(ENV_PREFIX):
+        return None
+    return [part.lower() for part in name[len(ENV_PREFIX):].split("__")]
+
+
+def _parse_override(item):
+    name, sep, value = item.partition("=")
+    name = name.strip()
+    if not sep or not name:
+        raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+    return name.lower().split("."), value
+
+
+def _nested(parts, value):
+    out = value
+    for part in reversed(parts):
+        out = {part: out}
+    return out
+
+
+def _lookup(dotted):
+    """The built-in default for `dotted`, or raise for an unknown setting or a section."""
+    node = DEFAULTS
+    for part in dotted.split("."):
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{dotted} is a section; set one of its settings")
+    return node
+
+
+def _convert(parts, value):
+    """`value` as the type of the built-in default for the setting at `parts`."""
+    dotted = ".".join(parts)
+    default = _lookup(dotted)
+    if isinstance(default, bool):
+        lowered = value.strip().lower()
+        if lowered in _TRUE:
+            return True
+        if lowered in _FALSE:
+            return False
+        raise ConfigError(f"{dotted}: not a boolean: {value!r}")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except ValueError:
+            raise ConfigError(f"{dotted}: not an integer: {value!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except ValueError:
+            raise ConfigError(f"{dotted}: not a number: {value!r}") from None
+    if isinstance(default, list):
+        return [item.strip() for item in value.split(",") if item.strip()]
+    return value
