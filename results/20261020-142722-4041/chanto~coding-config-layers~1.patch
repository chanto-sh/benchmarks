 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
+from unittest import mock
 
 from app.config.errors import ConfigError
 from app.config.loader import load
@@ -29,5 +32,141 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+ROOT = os.path.dirname(os.path.abspath(__file__))
+
+
+def _clean_env():
+    return {k: v for k, v in os.environ.items() if not k.upper().startswith("SHOPD__")}
+
+
+class EnvTest(unittest.TestCase):
+    def test_env_layer(self):
+        cfg = load(env={"SHOPD__DB__HOST": "db.env", "SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["host"], "db.env")
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_env_names_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__Db__Pool__Size": "9"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+
+    def test_env_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__LOG__LEVEL": "debug"}):
+            self.assertEqual(load()["log"]["level"], "debug")
+
+    def test_other_variables_are_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD": "x", "OTHER__DB__PORT": "1"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_section_cannot_be_set(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(ctx.exception))
+
+    def test_bad_values(self):
+        for env in (
+            {"SHOPD__DB__PORT": "abc"},
+            {"SHOPD__DB__PORT": "5.5"},
+            {"SHOPD__DB__SSL": "maybe"},
+            {"SHOPD__DB__POOL__TIMEOUT": "soon"},
+        ):
+            with self.subTest(env=env):
+                with self.assertRaises(ConfigError):
+                    load(env=env)
+
+    def test_conversions(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "4",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__NAME": "prod",
+                "SHOPD__FEATURES": " search , cache ,, ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 4.0)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["name"], "prod")
+        self.assertEqual(cfg["features"], ["search", "cache"])
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(env={}, overrides=["db.port=6543", "features=a,b", "log.json=1"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["log"]["json"], True)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "from-file", "port": 1111}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__HOST": "from-env", "SHOPD__DB__PORT": "2222"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["host"], "from-env")
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={}, overrides=["db.prot=1"])
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_section_cannot_be_set(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={}, overrides=["db=1"])
+        self.assertIn("db", str(ctx.exception))
+
+    def test_malformed_override(self):
+        with self.assertRaises(ConfigError):
+            load(env={}, overrides=["db.port"])
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=ROOT,
+            env=_clean_env(),
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_options_are_repeatable(self):
+        proc = self.run_cli("--set", "db.port=6543", "--set", "name=prod")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["name"], "prod")
+
+    def test_bad_set_exits_2(self):
+        proc = self.run_cli("--set", "db.prot=1")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.prot", proc.stderr)
+
+    def test_bad_value_exits_2(self):
+        proc = self.run_cli("--set", "db.port=abc")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.port", proc.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
