@@ -17,4 +24,77 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
+    env = os.environ if env is None else env
+    for name, raw in env.items():
+        parts = _env_parts(name)
+        if parts is None:
+            continue
+        cfg = _set(cfg, parts, convert(parts, raw))
+    for override in overrides:
+        key, sep, raw = override.partition("=")
+        key = key.strip()
+        if not sep or not key:
+            raise ConfigError(f"bad override {override!r}: expected KEY=VALUE")
+        parts = key.lower().split(".")
+        cfg = _set(cfg, parts, convert(parts, raw))
     return deep_merge(cfg, {})
+
+
+def _env_parts(name):
+    """The dotted path a `SHOPD__A__B` variable names, or None if it is not ours."""
+    if not name.upper().startswith(ENV_PREFIX):
+        return None
+    tail = name[len(ENV_PREFIX):]
+    if not tail:
+        return None
+    return tail.lower().split("__")
+
+
+def convert(parts, raw):
+    """`raw` as the type of the built-in default for the setting at `parts`."""
+    name = ".".join(parts)
+    default = _default_for(parts, name)
+    if isinstance(default, bool):
+        text = raw.strip().lower()
+        if text in TRUES:
+            return True
+        if text in FALSES:
+            return False
+        raise ConfigError(
+            f"setting {name!r}: {raw!r} is not a bool ({', '.join(sorted(TRUES | FALSES))})"
+        )
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError:
+            raise ConfigError(f"setting {name!r}: {raw!r} is not an int") from None
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError:
+            raise ConfigError(f"setting {name!r}: {raw!r} is not a float") from None
+    if isinstance(default, list):
+        return [item.strip() for item in raw.split(",") if item.strip()]
+    return raw
+
+
+def _default_for(parts, name):
+    value = DEFAULTS
+    for part in parts:
+        if not isinstance(value, dict) or part not in value:
+            raise ConfigError(f"unknown setting {name!r}")
+        value = value[part]
+    if isinstance(value, dict):
+        raise ConfigError(f"setting {name!r} is a section, not a value")
+    return value
+
+
+def _set(cfg, parts, value):
+    """A new config with the setting at `parts` replaced by `value`."""
+    out = dict(cfg)
+    node = out
+    for part in parts[:-1]:
+        node[part] = dict(node[part])
+        node = node[part]
+    node[parts[-1]] = value
+    return out
