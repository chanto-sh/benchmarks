+def load(path=None, env=None, overrides=()):
+    """Effective configuration, lowest precedence first: defaults, the JSON file
+    at `path` (if any), `SHOPD__*` variables from `env` (default `os.environ`),
+    then `KEY=VALUE` strings from `overrides`."""
     cfg = DEFAULTS
