 from fractions import Fraction
+from math import comb, factorial
 
 
 def p_at_least(r, b, g, k, m):
@@ -6,4 +7,44 @@ def p_at_least(r, b, g, k, m):
 
     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+    if k > r:
+        return Fraction(0)
+
+    total = r + b + g
+    if m <= 0 or total == 0:
+        return Fraction(0)
+    m = min(m, total)
+
+    # Count permutations of the whole deck (all equally likely).  Split on
+    # whether a green card appears within the first m positions.
+    favourable = 0
+
+    # The first green is at position j: the j - 1 cards before it are red or
+    # blue and contain i >= k reds.
+    for j in range(1, m + 1):
+        for i in range(k, min(r, j - 1) + 1):
+            blue_before = (j - 1) - i
+            if 0 <= blue_before <= b:
+                favourable += (
+                    comb(r, i)
+                    * comb(b, blue_before)
+                    * factorial(j - 1)
+                    * g
+                    * factorial(total - j)
+                )
+
+    # No green among the first m cards: they consist of i >= k reds and
+    # m - i blues; the remaining cards are in any order.
+    for i in range(k, min(r, m) + 1):
+        blue_first = m - i
+        if 0 <= blue_first <= b:
+            favourable += (
+                comb(r, i)
+                * comb(b, blue_first)
+                * factorial(m)
+                * factorial(total - m)
+            )
+
+    return Fraction(favourable, factorial(total))
