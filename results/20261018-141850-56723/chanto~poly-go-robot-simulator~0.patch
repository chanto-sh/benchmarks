 }
 
 // Step 2
 // Define Action type here.
 
+type Action struct {
+	Command
+}
+
 func StartRobot(command chan Command, action chan Action) {
-	panic("Please implement the StartRobot function")
+	for c := range command {
+		action <- Action{Command: c}
+	}
+	close(action)
 }
 
 func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
-	panic("Please implement the Room function")
+	for a := range action {
+		switch a.Command {
+		case 'R':
+			robot.Dir = (robot.Dir + 1) % 4
+		case 'L':
+			robot.Dir = (robot.Dir + 3) % 4
+		case 'A':
+			if p := ahead(robot.Dir, robot.Pos); inRoom(extent, p) {
+				robot.Pos = p
+			}
+		}
+	}
+	report <- robot
 }
 
 // Step 3
 // Define Action3 type here.
 
+// A zero Command signals that a robot has finished its script.  It is never
+// produced from a script itself.
+type Action3 struct {
+	Name string
+	Command
+}
+
 func StartRobot3(name, script string, action chan Action3, log chan string) {
-	panic("Please implement the StartRobot3 function")
+	// Every robot that starts must report its completion, even after an
+	// undefined command, or the room would wait for it forever.
+	defer func() { action <- Action3{Name: name} }()
+
+	for _, c := range script {
+		switch c {
+		case 'R', 'L', 'A':
+			action <- Action3{Name: name, Command: Command(c)}
+		default:
+			log <- fmt.Sprintf("robot %q: undefined command %q", name, c)
+			return
+		}
+	}
 }
 
 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	index := make(map[string]int)
+	occupied := make(map[Pos]bool)
+
+	for i, r := range robots {
+		if r.Name == "" {
+			log <- "robot without a name"
+			continue
+		}
+		if _, ok := index[r.Name]; ok {
+			log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+			continue
+		}
+		if !inRoom(extent, r.Pos) {
+			log <- fmt.Sprintf("robot %q placed outside of the room", r.Name)
+			continue
+		}
+		if occupied[r.Pos] {
+			log <- fmt.Sprintf("robot %q placed at the same place as another robot", r.Name)
+			continue
+		}
+		index[r.Name] = i
+		occupied[r.Pos] = true
+	}
+
+	if len(robots) == 0 {
+		rep <- robots
+		return
+	}
+
+	finished := 0
+	for a := range action {
+		if a.Command == 0 {
+			finished++
+			if finished == len(robots) {
+				break
+			}
+			continue
+		}
+
+		i, ok := index[a.Name]
+		if !ok {
+			log <- fmt.Sprintf("action from unknown robot %q", a.Name)
+			continue
+		}
+
+		r := &robots[i]
+		switch a.Command {
+		case 'R':
+			r.Dir = (r.Dir + 1) % 4
+		case 'L':
+			r.Dir = (r.Dir + 3) % 4
+		case 'A':
+			p := ahead(r.Dir, r.Pos)
+			switch {
+			case !inRoom(extent, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", r.Name)
+			case occupied[p]:
+				log <- fmt.Sprintf("robot %q attempted to advance into another robot", r.Name)
+			default:
+				delete(occupied, r.Pos)
+				r.Pos = p
+				occupied[p] = true
+			}
+		}
+	}
+	rep <- robots
+}
+
+func ahead(d Dir, p Pos) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func inRoom(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
 }
