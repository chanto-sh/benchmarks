+    def test_first_expr_number_is_not_a_docstring(self) -> None:
+        s = "42\nassert 14"
+        m = rewrite(s)
+        # The imports must be inserted before the number, and the number must
+        # not be mistaken for a docstring.
+        assert isinstance(m.body[0], ast.Import)
+        assert isinstance(m.body[1], ast.Import)
+        assert isinstance(m.body[2], ast.Expr)
+        assert isinstance(m.body[2].value, ast.Constant)
+        assert m.body[2].value.value == 42
+
+        # A non-string first expression must not disable rewriting either.
+        s = "42\n'PYTEST_DONT_REWRITE'\nassert 14"
+        m = rewrite(s)
+        assert isinstance(m.body[0], ast.Import)
+
