 pub fn convert(input: &str) -> Result<String, Error> {
-    todo!("Convert the input '{input}' to a string");
+    let lines: Vec<&str> = input.lines().collect();
+
+    if lines.len() % 4 != 0 {
+        return Err(Error::InvalidRowCount(lines.len()));
+    }
+
+    let width = lines.first().map_or(0, |line| line.len());
+    if width % 3 != 0 {
+        return Err(Error::InvalidColumnCount(width));
+    }
+    if let Some(line) = lines.iter().find(|line| line.len() != width) {
+        return Err(Error::InvalidColumnCount(line.len()));
+    }
+
+    let rows: Vec<String> = lines
+        .chunks_exact(4)
+        .map(|rows| {
+            (0..width / 3)
+                .map(|column| {
+                    let start = column * 3;
+                    let glyph = [
+                        &rows[0][start..start + 3],
+                        &rows[1][start..start + 3],
+                        &rows[2][start..start + 3],
+                    ];
+                    DIGITS
+                        .iter()
+                        .position(|digit| digit == &glyph)
+                        .map_or('?', |d| char::from_digit(d as u32, 10).unwrap())
+                })
+                .collect()
+        })
+        .collect();
+
+    Ok(rows.join(","))
