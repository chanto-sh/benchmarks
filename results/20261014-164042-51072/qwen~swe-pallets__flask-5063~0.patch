+    def test_subdomain(self, runner):
+        app = Flask(__name__)
+        app.testing = True
+        app.config["SERVER_NAME"] = "test.local"
+
+        @app.route("/", subdomain="admin")
+        def index():
+            pass
+
+        @app.route("/", subdomain="test")
+        def test_index():
+            pass
+
+        cli = FlaskGroup(create_app=lambda: app)
+        result = runner.invoke(cli, ["routes"])
+        assert result.exit_code == 0
+        assert result.output.splitlines()[0].startswith("Domain")
+        rows = result.output.splitlines()[2:]
+        assert any(row.startswith("admin") and "index" in row for row in rows)
+        assert any(row.startswith("test") and "test_index" in row for row in rows)
