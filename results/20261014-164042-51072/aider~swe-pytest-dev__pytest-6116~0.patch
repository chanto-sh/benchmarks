+"""Regression tests for the ``--co`` alias of ``--collect-only`` (issue #5752)."""
+from _pytest.main import ExitCode
+
+
+def test_collect_only_alias(testdir):
+    """``--co`` behaves exactly like ``--collect-only``."""
+    testdir.makepyfile(
+        """
+        def test_foo():
+            pass
+        """
+    )
+    result = testdir.runpytest("--co")
+    assert result.ret == ExitCode.OK
+    result.stdout.fnmatch_lines(["*collected 1 item*"])
+
+    # The tests must not have been executed.
+    result.stdout.no_fnmatch_line("*1 passed*")
+
+
+def test_collect_only_long_and_short_are_equivalent(testdir):
+    testdir.makepyfile(
+        """
+        def test_foo():
+            pass
+        def test_bar():
+            pass
+        """
+    )
+    short = testdir.runpytest("--co")
+    long = testdir.runpytest("--collect-only")
+
+    assert short.ret == long.ret == ExitCode.OK
+    short.stdout.fnmatch_lines(["*collected 2 items*"])
+    long.stdout.fnmatch_lines(["*collected 2 items*"])
