+                    # file in it, which gets ignored by the default
+                    # "python_files" option.
+                    pass
+                return
+            yield from m
+
+    def _collectfile(self, path, handle_dupes=True):
+        assert (
+            path.isfile()
+        ), "{!r} is not a file (isdir={!r}, exists={!r}, islink={!r})".format(
