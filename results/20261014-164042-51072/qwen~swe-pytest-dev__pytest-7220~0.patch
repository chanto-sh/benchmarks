diff --git a/testing/test_cwd_traceback.py b/testing/test_cwd_traceback.py
new file mode 100644
index 0000000..537b9a2
--- /dev/null
+++ b/testing/test_cwd_traceback.py
@@ -0,0 +1,40 @@
+"""Regression test for the file paths shown in failure tracebacks.
+
+When a fixture changes the current working directory, the paths reported in a
+failure used to be computed relative to that new directory (for example
+``../test_foo.py``), which made it impossible for editors to locate the file.
+The paths must stay relative to the directory pytest was invoked from.
+"""
+import pytest
+
+
+def test_path_relative_to_invocation_dir(testdir):
+    testdir.makepyfile(
+        """
+        import os
+
+        import pytest
+
+
+        @pytest.fixture
+        def private_dir(tmpdir):
+            out_dir = tmpdir.mkdir("ddd")
+            old_dir = os.getcwd()
+            os.chdir(str(out_dir))
+            yield out_dir
+            os.chdir(old_dir)
+
+
+        def test_show_wrong_path(private_dir):
+            assert False
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*def test_show_wrong_path(private_dir):*",
+            "*E       assert False*",
+            "*test_path_relative_to_invocation_dir.py:*: AssertionError",
+        ]
+    )
+    result.stdout.no_fnmatch_line("*../test_path_relative_to_invocation_dir.py*")
