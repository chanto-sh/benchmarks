diff --git a/testing/test_collect_only_shortcut.py b/testing/test_collect_only_shortcut.py
new file mode 100644
index 0000000..f37eb3b
--- /dev/null
+++ b/testing/test_collect_only_shortcut.py
@@ -0,0 +1,15 @@
+"""Regression test for the ``--co`` shortcut of ``--collect-only``."""
+
+
+def test_collectonly_shortcut(testdir):
+    testdir.makepyfile(
+        """
+        def test_collect_me():
+            raise AssertionError("must not be executed during collection")
+        """
+    )
+
+    result = testdir.runpytest("--co")
+
+    result.stdout.fnmatch_lines(["*test_collect_me*"])
+    assert result.ret == 0
