diff --git a/ChangeLog b/ChangeLog
index b6ba4be..2a726c5 100644
--- a/ChangeLog
+++ b/ChangeLog
@@ -33,6 +33,11 @@ Release date: TBA
 
   closes #5722
 
+* Fix a false negative for the ``fixme`` checker when a note tag consisted
+  entirely of punctuation.
+
+  closes #5859
+
 * Fixed crash from ``arguments-differ`` and ``arguments-renamed`` when methods were
   defined outside the top level of a class.
 
diff --git a/pylint/checkers/misc.py b/pylint/checkers/misc.py
index 69149e6..f992f87 100644
--- a/pylint/checkers/misc.py
+++ b/pylint/checkers/misc.py
@@ -121,9 +121,9 @@ class EncodingChecker(BaseChecker):
 
         notes = "|".join(re.escape(note) for note in self.config.notes)
         if self.config.notes_rgx:
-            regex_string = rf"#\s*({notes}|{self.config.notes_rgx})\b"
+            regex_string = rf"#\s*({notes}|{self.config.notes_rgx})(?![a-zA-Z0-9])"
         else:
-            regex_string = rf"#\s*({notes})\b"
+            regex_string = rf"#\s*({notes})(?![a-zA-Z0-9])"
 
         self._fixme_pattern = re.compile(regex_string, re.I)
 
