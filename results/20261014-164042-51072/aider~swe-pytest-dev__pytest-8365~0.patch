diff --git a/changelog/8263.bugfix.rst b/changelog/8263.bugfix.rst
new file mode 100644
index 0000000..4cdbc96
--- /dev/null
+++ b/changelog/8263.bugfix.rst
@@ -0,0 +1,4 @@
+Fixed ``tmpdir``, ``tmpdir_factory`` and ``tmp_path_factory`` failing to create the base
+temporary directory when the current user name contains characters that are not allowed
+in directory names (for example the ``domain\user`` value returned by
+``getpass.getuser()`` when logging into Windows through SSH).
diff --git a/src/_pytest/tmpdir.py b/src/_pytest/tmpdir.py
index 29c7e19..e935c01 100644
--- a/src/_pytest/tmpdir.py
+++ b/src/_pytest/tmpdir.py
@@ -154,10 +154,18 @@ def get_user() -> Optional[str]:
     import getpass
 
     try:
-        return getpass.getuser()
+        user = getpass.getuser()
     except (ImportError, KeyError):
         return None
 
+    # The user name obtained through ``getpass.getuser()`` might contain
+    # characters that cannot be used in a directory name, for example when
+    # logging in via SSH on Windows the returned value may be prefixed with
+    # the domain ("domain\\user"). Replace any character that is not allowed
+    # in a directory name with an underscore so it can safely be used to
+    # build the base temporary directory name (#8263).
+    return re.sub(r"[\W]", "_", user)
+
 
 def pytest_configure(config: Config) -> None:
     """Create a TempdirFactory and attach it to the config object.
diff --git a/testing/test_tmpdir.py b/testing/test_tmpdir.py
index d123287..e07e631 100644
--- a/testing/test_tmpdir.py
+++ b/testing/test_tmpdir.py
@@ -246,6 +246,38 @@ def test_get_user(monkeypatch):
     assert get_user() is None
 
 
+@pytest.mark.parametrize(
+    ("user", "expected"),
+    [
+        ("john_doe", "john_doe"),
+        ("contoso\\john_doe", "contoso_john_doe"),
+        ("contoso/john_doe", "contoso_john_doe"),
+        ("john doe", "john_doe"),
+    ],
+)
+def test_get_user_sanitizes_illegal_characters(monkeypatch, user, expected):
+    """The user name returned by getpass.getuser() is stripped from characters
+    that cannot be used in a directory name (#8263).
+    """
+    monkeypatch.setattr("getpass.getuser", lambda: user)
+    assert get_user() == expected
+
+
+def test_default_basetemp_sanitizes_user_name(tmp_path, monkeypatch):
+    """The base temp directory name must not contain characters that are not
+    allowed in directory names, such as the "domain\\user" value returned by
+    ``getpass.getuser()`` on Windows over SSH (#8263).
+    """
+    monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(tmp_path))
+    monkeypatch.setattr("getpass.getuser", lambda: "contoso\\john_doe")
+
+    factory = TempPathFactory(None, lambda *args: None, _ispytest=True)
+    basetemp = factory.getbasetemp()
+
+    assert basetemp.is_dir()
+    assert basetemp.parent.name == "pytest-of-contoso_john_doe"
+
+
 class TestNumberedDir:
     PREFIX = "fun-"
 
