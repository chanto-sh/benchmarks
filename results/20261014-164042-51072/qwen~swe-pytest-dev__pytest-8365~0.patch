diff --git a/changelog/8365.bugfix.rst b/changelog/8365.bugfix.rst
new file mode 100644
index 0000000..b06c1af
--- /dev/null
+++ b/changelog/8365.bugfix.rst
@@ -0,0 +1,5 @@
+Fixed ``tmpdir``, ``tmpdir_factory`` and ``tmp_path_factory`` failing to create
+their base temporary directory when the user name returned by
+:func:`getpass.getuser` contains characters which are not allowed in directory
+names, for example the ``DOMAIN\user`` format returned on Windows when
+connected through SSH.
diff --git a/src/_pytest/tmpdir.py b/src/_pytest/tmpdir.py
index 29c7e19..0d4180b 100644
--- a/src/_pytest/tmpdir.py
+++ b/src/_pytest/tmpdir.py
@@ -154,7 +154,10 @@ def get_user() -> Optional[str]:
     import getpass
 
     try:
-        return getpass.getuser()
+        # Sanitize the user name as it may contain characters which are not
+        # valid in directory names, e.g. the ``DOMAIN\user`` format returned
+        # by getuser() on Windows when connected through SSH (#8365).
+        return re.sub(r"[\W]", "_", getpass.getuser())
     except (ImportError, KeyError):
         return None
 
diff --git a/testing/test_tmpdir.py b/testing/test_tmpdir.py
index d123287..daa8495 100644
--- a/testing/test_tmpdir.py
+++ b/testing/test_tmpdir.py
@@ -246,6 +246,24 @@ def test_get_user(monkeypatch):
     assert get_user() is None
 
 
+@pytest.mark.parametrize(
+    "user, expected",
+    [
+        ("user", "user"),
+        ("user/name", "user_name"),
+        (r"user\name", "user_name"),
+        (r"contoso\john_doe", "contoso_john_doe"),
+    ],
+)
+def test_get_user_with_invalid_chars(monkeypatch, user, expected):
+    """Test that get_user() replaces characters which are not valid in
+    directory names, such as the ``DOMAIN\\user`` format returned by
+    getpass on Windows (#8365).
+    """
+    monkeypatch.setenv("LOGNAME", user)
+    assert get_user() == expected
+
