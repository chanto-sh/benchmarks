index 0000000..b069706
--- /dev/null
+++ b/testing/test_assertion_bytes.py
@@ -0,0 +1,36 @@
+"""Regression tests for byte-string assertion explanations.
+
+Historically ``bytes`` operands were treated as generic sequences, so a
+failing comparison reported the ASCII ordinal of the first differing byte,
+e.g. ``Right contains 2 more items, first extra item: 52`` (``52`` is ``"4"``).
+Byte strings are now diffed as text, like ``str``.
+"""
+import _pytest.assertion.util as util
+
+
+class _Config:
+    def __init__(self, verbose=0):
+        self._verbose = verbose
+
+    def getoption(self, name):
+        assert name == "verbose"
+        return self._verbose
+
+
+def _callequal(left, right, verbose=0):
+    return util.assertrepr_compare(_Config(verbose), "==", left, right)
+
+
+def test_bytes_diff_is_readable():
+    lines = _callequal(b"spam", b"eggs")
+    assert lines is not None
+    assert "- spam" in lines
+    assert "+ eggs" in lines
+
+
+def test_bytes_diff_does_not_report_ordinals():
+    for left, right in [(b"", b"42"), (b"", b"1")]:
+        lines = _callequal(left, right)
+        assert lines is not None
+        assert not any("more items" in line for line in lines)
+        assert not any("extra item" in line for line in lines)
