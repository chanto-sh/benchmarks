+    def test_getstatementrange_with_decorator(self) -> None:
+        # A decorator belongs to the following function, not to the preceding
+        # statement (see #9059).
+        source = Source(
+            """\
+            def test_some():
+                assert 1 == 2
+
+                @decorator
+                def inner():
+                    pass
+        """
+        )
+        assert len(source) == 6
+        assert source.getstatementrange(1) == (1, 2)
+        assert source.getstatementrange(3) == (3, 4)
+        assert source.getstatementrange(4) == (4, 5)
+
     def test_getstatementrange_out_of_bounds_py3(self) -> None:
         source = Source("if xxx:\n   from .collections import something")
         r = source.getstatementrange(1)
