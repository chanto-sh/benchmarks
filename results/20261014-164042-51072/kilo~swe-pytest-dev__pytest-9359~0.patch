+    def test_getstatementrange_with_decorator_issue9359(self) -> None:
+        # The decorator of the following statement must not be part of the
+        # statement range of an earlier statement.
+        source = Source(
+            """\
+            def test_right_statement(foo):
+                assert foo == 1
+
+                @decorator
+                def inner():
+                    return 2
+            """
+        )
+        assert source.getstatementrange(1) == (1, 2)
+        assert str(source.getstatement(1)) == "    assert foo == 1"
+
 
