diff --git a/changelog/9359.bugfix.rst b/changelog/9359.bugfix.rst
new file mode 100644
index 0000000..e76bf98
--- /dev/null
+++ b/changelog/9359.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed source code lines leaking into the assertion error output: the decorator of a
+function or class following the failing statement is no longer included in the
+displayed source, which happened on Python 3.8 and later.
diff --git a/src/_pytest/_code/source.py b/src/_pytest/_code/source.py
index 6f54057..487724b 100644
--- a/src/_pytest/_code/source.py
+++ b/src/_pytest/_code/source.py
@@ -149,6 +149,15 @@ def get_statement_startend2(lineno: int, node: ast.AST) -> Tuple[int, Optional[i
     values: List[int] = []
     for x in ast.walk(node):
         if isinstance(x, (ast.stmt, ast.ExceptHandler)):
+            if isinstance(x, (ast.AsyncFunctionDef, ast.FunctionDef, ast.ClassDef)):
+                # A decorated function or class is considered to start at its
+                # first decorator, not at the ``def``/``class`` keyword.  In
+                # Python 3.8+ the AST ``lineno`` points at the ``def``/
+                # ``class`` line, so add the decorator lines explicitly to
+                # prevent them from being attributed to the previous
+                # statement (see #9359).
+                for decorator in x.decorator_list:
+                    values.append(decorator.lineno - 1)
             values.append(x.lineno - 1)
             for name in ("finalbody", "orelse"):
                 val: Optional[List[ast.stmt]] = getattr(x, name, None)
