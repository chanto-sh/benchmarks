+@pytest.mark.parametrize("runxfail", [False, True])
+def test_skip_location_is_not_affected_by_runxfail(testdir, runxfail):
+    """``--runxfail`` must not change the reported location of a skipped test (#7045)."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        @pytest.mark.skip
+        def test_skip():
+            assert 0
+        """
+    )
+    args = ["-rs", "--runxfail"] if runxfail else ["-rs"]
+    result = testdir.runpytest(*args)
+
+    # The skip location must point at the test item, not at pytest internals...
+    result.stdout.fnmatch_lines(
+        [
+            "*SKIPPED*[[]1[]]*test_skip_location_is_not_affected_by_runxfail.py:*unconditional skip*"
+        ]
+    )
+    # ...regardless of whether ``--runxfail`` is given.
+    result.stdout.no_fnmatch_line("*_pytest*skipping.py*unconditional skip*")
+
+
+@pytest.mark.parametrize("runxfail", [False, True])
+def test_skipif_location_is_not_affected_by_runxfail(testdir, runxfail):
+    """Same as above, but for ``mark.skipif`` with a condition/reason."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        @pytest.mark.skipif(True, reason="some reason")
+        def test_skip():
+            assert 0
+        """
+    )
+    args = ["-rs", "--runxfail"] if runxfail else ["-rs"]
+    result = testdir.runpytest(*args)
+
+    result.stdout.fnmatch_lines(
+        [
+            "*SKIPPED*[[]1[]]*test_skipif_location_is_not_affected_by_runxfail.py:*some reason*"
+        ]
+    )
+    result.stdout.no_fnmatch_line("*_pytest*skipping.py*some reason*")
