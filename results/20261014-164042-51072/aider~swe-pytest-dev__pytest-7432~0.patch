diff --git a/changelog/7045.bugfix.rst b/changelog/7045.bugfix.rst
new file mode 100644
index 0000000..027c856
--- /dev/null
+++ b/changelog/7045.bugfix.rst
@@ -0,0 +1 @@
+Fixed ``--runxfail`` changing the reported location of tests skipped via ``pytest.mark.skip``/``pytest.mark.skipif``; the skip location now always points to the test item.
diff --git a/src/_pytest/skipping.py b/src/_pytest/skipping.py
index 7bd975e..3f1a22a 100644
--- a/src/_pytest/skipping.py
+++ b/src/_pytest/skipping.py
@@ -270,13 +270,14 @@ def pytest_runtest_makereport(item: Item, call: CallInfo[None]):
         else:
             rep.longrepr = "Unexpected success"
         rep.outcome = "failed"
-    elif item.config.option.runxfail:
-        pass  # don't interfere
     elif call.excinfo and isinstance(call.excinfo.value, xfail.Exception):
-        assert call.excinfo.value.msg is not None
-        rep.wasxfail = "reason: " + call.excinfo.value.msg
-        rep.outcome = "skipped"
-    elif not rep.skipped and xfailed:
+        # Imperative xfail (``pytest.xfail()`` / ``[NOTRUN]``): respect
+        # ``--runxfail`` and otherwise leave the report untouched.
+        if not item.config.option.runxfail:
+            assert call.excinfo.value.msg is not None
+            rep.wasxfail = "reason: " + call.excinfo.value.msg
+            rep.outcome = "skipped"
+    elif not rep.skipped and xfailed and not item.config.option.runxfail:
         if call.excinfo:
             raises = xfailed.raises
             if raises is not None and not isinstance(call.excinfo.value, raises):
diff --git a/testing/test_skipping_runxfail.py b/testing/test_skipping_runxfail.py
new file mode 100644
index 0000000..d2c7458
--- /dev/null
+++ b/testing/test_skipping_runxfail.py
@@ -0,0 +1,51 @@
+import pytest
+
+
+@pytest.mark.parametrize("runxfail", [False, True])
+def test_skip_location_is_not_affected_by_runxfail(testdir, runxfail):
+    """``--runxfail`` must not change the reported location of a skipped test (#7045)."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        @pytest.mark.skip
+        def test_skip():
+            assert 0
+        """
+    )
+    args = ["-rs", "--runxfail"] if runxfail else ["-rs"]
+    result = testdir.runpytest(*args)
+
+    # The skip location must point at the test item, not at pytest internals...
+    result.stdout.fnmatch_lines(
+        [
+            "*SKIPPED*[[]1[]]*test_skip_location_is_not_affected_by_runxfail.py:*unconditional skip*"
+        ]
+    )
+    # ...regardless of whether ``--runxfail`` is given.
+    result.stdout.no_fnmatch_line("*_pytest*skipping.py*unconditional skip*")
+
+
+@pytest.mark.parametrize("runxfail", [False, True])
+def test_skipif_location_is_not_affected_by_runxfail(testdir, runxfail):
+    """Same as above, but for ``mark.skipif`` with a condition/reason."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        @pytest.mark.skipif(True, reason="some reason")
+        def test_skip():
+            assert 0
+        """
+    )
+    args = ["-rs", "--runxfail"] if runxfail else ["-rs"]
+    result = testdir.runpytest(*args)
+
+    result.stdout.fnmatch_lines(
+        [
+            "*SKIPPED*[[]1[]]*test_skipif_location_is_not_affected_by_runxfail.py:*some reason*"
+        ]
+    )
+    result.stdout.no_fnmatch_line("*_pytest*skipping.py*some reason*")
