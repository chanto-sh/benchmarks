+def test_getbasetemp_fallback_if_unable_to_create(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Test that getbasetemp() falls back to "unknown" if the user name
+    contains characters that are invalid for directory names (#8365)."""
+    monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(tmp_path))
+    monkeypatch.setattr("_pytest.tmpdir.get_user", lambda: "illegal/user")
+    factory = TempPathFactory(None, lambda *args: None, _ispytest=True)
+    basetemp = factory.getbasetemp()
+    assert basetemp.parent.name == "pytest-of-unknown"
+
+
 class TestNumberedDir:
     PREFIX = "fun-"
 
