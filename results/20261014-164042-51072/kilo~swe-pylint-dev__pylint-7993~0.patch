+def _get_template_arguments(template: str) -> list[str]:
+    """Return the message fields referenced by a message template.
+
+    Escaped braces (``{{`` and ``}}``) are literal characters, so they are not
+    reported as arguments.
+    """
+    try:
+        return [
+            field_name
+            for _, field_name, _, _ in Formatter().parse(template)
+            if field_name is not None
+        ]
+    except ValueError:
+        # The template is malformed. Fall back to a best-effort search so that
+        # any recognizable arguments are still handled.
+        return [match[0] for match in re.findall(r"\{(.+?)(:.*)?\}", template)]
+
