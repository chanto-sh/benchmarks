+        # Check to see if all parameters in the template are attributes of the Message.
+        # Parsing the template with ``string.Formatter`` correctly takes care of
+        # escaped (doubled) braces, so that a template such as ``{{ "a": "{msg}" }}``
+        # is not mistaken for a replacement field.
+        formatter = string.Formatter()
+        fixed_template = ""
+        for literal_text, field_name, format_spec, conversion in formatter.parse(
+            template
+        ):
+            # Re-escape stray braces coming from the template's literal parts so
+            # that ``str.format`` renders them instead of treating them as fields.
+            fixed_template += literal_text.replace("{", "{{").replace("}", "}}")
+            if field_name is None:
+                continue
+            if field_name not in MESSAGE_FIELDS:
                 warnings.warn(
-                    f"Don't recognize the argument '{argument[0]}' in the --msg-template. "
+                    f"Don't recognize the argument '{field_name}' in the --msg-template. "
