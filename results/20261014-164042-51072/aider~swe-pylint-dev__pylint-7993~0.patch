                 )
-                template = re.sub(r"\{" + argument[0] + r"(:.*?)?\}", "", template)
-        self._fixed_template = template
+                continue
+            fixed_template += "{" + field_name
+            if conversion:
+                fixed_template += "!" + conversion
+            if format_spec:
+                fixed_template += ":" + format_spec
+            fixed_template += "}"
+        self._fixed_template = fixed_template
 
