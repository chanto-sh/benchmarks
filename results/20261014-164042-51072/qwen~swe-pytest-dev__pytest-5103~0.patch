diff --git a/testing/test_unroll_all_any.py b/testing/test_unroll_all_any.py
new file mode 100644
index 0000000..b28f37d
--- /dev/null
+++ b/testing/test_unroll_all_any.py
@@ -0,0 +1,124 @@
+"""Tests for unrolling ``all()``/``any()`` calls over generator expressions.
+
+See the assertion rewriting for ``all``/``any`` in
+``_pytest.assertion.rewrite``.
+"""
+from __future__ import absolute_import
+from __future__ import division
+from __future__ import print_function
+
+import ast
+import sys
+
+import pytest
+
+import _pytest._code
+from _pytest.assertion.rewrite import rewrite_asserts
+
+
+def rewrite(src):
+    tree = ast.parse(src)
+    rewrite_asserts(tree)
+    return tree
+
+
+def getmsg(f, extra_ns=None, must_pass=False):
+    """Rewrite the assertions in f, run it, and get the failure message."""
+    src = "\n".join(_pytest._code.Code(f).source().lines)
+    mod = rewrite(src)
+    code = compile(mod, "<test>", "exec")
+    ns = {}
+    if extra_ns is not None:
+        ns.update(extra_ns)
+    exec(code, ns)
+    func = ns[f.__name__]
+    try:
+        func()
+    except AssertionError:
+        if must_pass:
+            pytest.fail("shouldn't have raised")
+        return str(sys.exc_info()[1])
+    else:
+        if not must_pass:
+            pytest.fail("function didn't raise at all")
+
+
+def test_all_unroll_genexp():
+    def is_even(number):
+        return number % 2 == 0
+
+    def f():
+        even_stevens = list(range(1, 100, 2))
+        assert all(is_even(number) for number in even_stevens)
+
+    assert (
+        getmsg(f, {"is_even": is_even})
+        == """assert False
+ +  where False = is_even(1)"""
+    )
+
+
+def test_all_unroll_with_filter():
+    def is_even(number):
+        return number % 2 == 0
+
+    def f():
+        assert all(is_even(number) for number in [1, 2, 3, 4] if number > 1)
+
+    assert (
+        getmsg(f, {"is_even": is_even})
+        == """assert False
+ +  where False = is_even(3)"""
+    )
+
+
+def test_all_unroll_passes():
+    def is_even(number):
+        return number % 2 == 0
+
+    def f():
+        assert all(is_even(number) for number in [2, 4, 6])
+
+    getmsg(f, {"is_even": is_even}, must_pass=True)
+
+
+def test_all_unroll_short_circuits():
+    evaluated = []
+
+    def track(number):
+        evaluated.append(number)
+        return number % 2 == 0
+
+    def f():
+        assert all(track(number) for number in [2, 4, 5, 6, 7])
+
+    assert (
+        getmsg(f, {"track": track})
+        == """assert False
+ +  where False = track(5)"""
+    )
+    assert evaluated == [2, 4, 5]
+
+
+def test_any_unroll_passes():
+    def is_odd(number):
+        return number % 2 == 1
+
+    def f():
+        assert any(is_odd(number) for number in [1, 2, 3])
+
+    getmsg(f, {"is_odd": is_odd}, must_pass=True)
+
+
+def test_any_unroll_fails():
+    def is_even(number):
+        return number % 2 == 0
+
+    def f():
+        assert any(is_even(number) for number in [1, 3, 5])
+
+    assert (
+        getmsg(f, {"is_even": is_even})
+        == """assert False
+ +  where False = is_even(5)"""
+    )
