+    @staticmethod
+    def _is_all_any_call(call):
+        """Return True if *call* is ``all()``/``any()`` over a generator.
+
+        These calls have a special meaning for assertion introspection: the
+        generator is unrolled so that the report can point at the element
+        which determined the result (see ``_visit_all_any``).
+        """
+        return (
+            isinstance(call.func, ast.Name)
+            and call.func.id in ("all", "any")
+            and len(call.args) == 1
+            and not call.keywords
+            and isinstance(call.args[0], ast.GeneratorExp)
+        )
+
+    def _visit_all_any(self, call):
+        """Unroll ``all()``/``any()`` calls over a generator expression.
+
+        Rewriting ``all(EXPR for TARGET in ITER)`` into the equivalent
+        short-circuiting loop allows the regular assertion reporting machinery
+        to describe the element which made the call fail, instead of showing an
+        opaque generator object.
+
+        """
+        gen = call.args[0]
+        # Only the simple case of a single ``for`` clause is unrolled; more
+        # complicated comprehensions (e.g. nested loops) are left untouched.
+        if len(gen.generators) != 1:
+            return None
+        comp = gen.generators[0]
+        if getattr(comp, "is_async", False):
+            return None
+
+        is_all = call.func.id == "all"
+
+        # Result of the call, initialised for the empty iterable case.
+        res_var = self.variable()
+        self.statements.append(
+            ast.Assign(
+                [ast.Name(res_var, ast.Store())], _NameConstant(True if is_all else False)
+            )
+        )
+
+        # Collect the statements of the loop body separately so that they end
+        # up inside the ``for`` statement.
+        save_statements = self.statements
+        self.statements = body = []
+
+        # Rewrite the body of the comprehension once; the generated statements
+        # are executed on every iteration.
+        res, expl = self.visit(gen.elt)
+
+        # Stop iterating as soon as the result of the call is known, recording
+        # it for the report.
+        if is_all:
+            test = ast.UnaryOp(ast.Not(), res)
+            result = _NameConstant(False)
+        else:
+            test = res
+            result = _NameConstant(True)
+        body.append(
+            ast.If(
+                test,
+                [
+                    ast.Assign([ast.Name(res_var, ast.Store())], result),
+                    ast.Break(),
+                ],
+                [],
+            )
+        )
+
+        # Evaluate the ``if`` filters of the comprehension before the body,
+        # wrapping from the inside out.
+        for cond in reversed(comp.ifs):
+            self.statements = filtered = []
+            cond_res, _ = self.visit(cond)
+            filtered.append(ast.If(cond_res, body, []))
+            body = filtered
+
+        self.statements = save_statements
+        self.statements.append(ast.For(comp.target, comp.iter, body, []))
+        return ast.Name(res_var, ast.Load()), expl
+
