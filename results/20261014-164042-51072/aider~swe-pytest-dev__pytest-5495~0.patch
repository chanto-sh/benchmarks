+
+class PythonConfig:
+    """Minimal stand-in for a pytest :class:`Config` object.
+
+    ``util.assertrepr_compare`` only needs ``getoption("verbose")`` from the
+    configuration, so a lightweight object is enough here.  This avoids relying
+    on the (deprecated) global ``pytest.config``.
+    """
+
+    class option:
+        verbose = 0
+
+    def getoption(self, name, default=None):
+        return getattr(self.option, name, default)
+
+
+_config = PythonConfig()
+
+
+def callequal(left, right, verbose=False):
+    """Return the explanation produced by ``util.assertrepr_compare`` for
+    the comparison ``left == right``.
