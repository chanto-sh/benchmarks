+@pytest.mark.parametrize("runxfail", [False, True])
+def test_skip_reporting_location(testdir, runxfail):
+    testdir.makepyfile(
+        test_one="""
+        import pytest
+        @pytest.mark.skip
+        def test_skip_location() -> None:
+            assert 0
+        """
+    )
+    args = ["-rs"]
+    if runxfail:
+        args.append("--runxfail")
+    result = testdir.runpytest(*args)
+    result.stdout.fnmatch_lines(
+        ["SKIPPED [[]1[]] test_one.py:2: unconditional skip"]
+    )
