+def test_statement_with_decorator() -> None:
+    """Test that the statement range of a decorated function definition is
+    correct, even on Python 3.8+ where a decorated function's lineno points to
+    the ``def`` line instead of the decorator (#9075)."""
+    source = Source(
+        """\
+        def test():
+            assert 1
+
+            @decorator
+            def nested():
+                pass
+
+            assert 2
+        """
+    )
+    # The first assert's statement range must not include the trailing blank
+    # line nor the ``@decorator`` line of the following nested function.
+    assert getstatement(1, source).lines == ["    assert 1"]
+    # The second assert is the last statement of the function.
+    assert getstatement(7, source).lines == ["    assert 2"]
+
+
