+    def test_domain(self, runner):
+        """Routes bound to subdomains or the app's SERVER_NAME show a
+        leading domain column.
+        """
+        app = Flask(__name__)
+        app.testing = True
+        app.config["SERVER_NAME"] = "test.local"
+
+        admin = Blueprint("admin_blueprint", __name__, subdomain="admin")
+
+        @admin.route("/home")
+        def admin_home():
+            pass
+
+        other = Blueprint("test_subdomain_blueprint", __name__, subdomain="test")
+
+        @other.route("/home")
+        def other_home():
+            pass
+
+        app.register_blueprint(admin)
+        app.register_blueprint(other)
+
+        cli = FlaskGroup(create_app=lambda: app)
+        result = runner.invoke(cli, ["routes"])
+        assert result.exit_code == 0
+
+        lines = result.output.splitlines()
+        assert lines[0].startswith("Domain")
+        rows = lines[2:]
+
+        # routes without a subdomain fall back to SERVER_NAME
+        assert any(row.startswith("test.local ") for row in rows)
+        # blueprint routes are shown with their subdomain prefix
+        assert any(row.startswith("admin.test.local ") for row in rows)
+        assert any(row.startswith("test.test.local ") for row in rows)
+
+    def test_sort_domain(self, runner):
+        app = Flask(__name__)
+        app.testing = True
+        app.config["SERVER_NAME"] = "test.local"
