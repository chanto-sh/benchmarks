diff --git a/testing/test_assertrewrite_all_any.py b/testing/test_assertrewrite_all_any.py
new file mode 100644
index 0000000..da62100
--- /dev/null
+++ b/testing/test_assertrewrite_all_any.py
@@ -0,0 +1,162 @@
+"""
+Tests for the special handling of ``all()``/``any()`` assertions.
+
+When the argument is a (generator/list/set) comprehension the assertion
+rewriter "unrolls" the iterable into a loop, so that a failing ``all``/``any``
+reports the element that caused the failure -- giving a "where" line just
+like the equivalent explicit ``for`` loop would.
+"""
+import pytest
+
+
+def test_all_reports_first_failing_element(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_all():
+            assert all(is_even(x) for x in [1, 3, 5])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*>       assert all(is_even(x) for x in [1, 3, 5])*",
+            "*E       assert False*",
+            "*where False = is_even(1)*",
+        ]
+    )
+    assert result.ret == 1
+
+
+def test_all_with_list_comprehension(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_all():
+            assert all([is_even(x) for x in [1, 3, 5]])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*E       assert False*",
+            "*where False = is_even(1)*",
+        ]
+    )
+    assert result.ret == 1
+
+
+def test_all_short_circuits(testdir):
+    """The unrolled loop must still short-circuit exactly like ``all``."""
+    testdir.makepyfile(
+        """
+        calls = []
+
+        def record(x):
+            calls.append(x)
+            return False
+
+        def test_all():
+            assert all(record(x) for x in [1, 2, 3])
+
+        def test_calls():
+            assert calls == [1]
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*1 failed, 1 passed*"])
+    assert result.ret == 1
+
+
+def test_any_reports_element(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_any():
+            assert any(is_even(x) for x in [1, 3])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*E       assert False*",
+            "*where False = is_even(3)*",
+        ]
+    )
+    assert result.ret == 1
+
+
+def test_all_with_condition(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_all():
+            assert all(is_even(x) for x in [1, 2, 3, 4] if x > 1)
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*E       assert False*",
+            "*where False = is_even(3)*",
+        ]
+    )
+    assert result.ret == 1
+
+
+def test_all_with_comparison(testdir):
+    testdir.makepyfile(
+        """
+        def test_all():
+            values = [1, 3, 5]
+            assert all(v % 2 == 0 for v in values)
+        """
+    )
+    result = testdir.runpytest()
+    assert result.ret == 1
+    stdout = result.stdout.str()
+    # the key regression: no more useless "<generator object ...>"
+    assert "generator object" not in stdout
+
+
+def test_all_passing(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_all():
+            assert all(is_even(x) for x in [2, 4])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*1 passed*"])
+    assert result.ret == 0
+
+
+def test_all_with_custom_message(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(x):
+            return x % 2 == 0
+
+        def test_all():
+            assert all(is_even(x) for x in [1, 3]), "some context"
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*AssertionError: some context*",
+            "*where False = is_even(1)*",
+        ]
+    )
+    assert result.ret == 1
