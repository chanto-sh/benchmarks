+    def _is_all_any_call(self, call):
+        """Return True if *call* is an ``all``/``any`` call over a simple
+        comprehension which we know how to safely unroll into a loop.
+        """
+        if not isinstance(call.func, ast.Name):
+            return False
+        if call.func.id not in ("all", "any"):
+            return False
+        if call.keywords:
+            return False
+        # The legacy ``ast.Call`` (Python 2 / < 3.5) also carries
+        # ``starargs`` and ``kwargs`` attributes which we can't handle here.
+        if getattr(call, "starargs", None) or getattr(call, "kwargs", None):
+            return False
+        if len(call.args) != 1:
+            return False
+        generator = call.args[0]
+        if not isinstance(generator, (ast.GeneratorExp, ast.ListComp, ast.SetComp)):
+            return False
+        # Only handle the (overwhelmingly common) case of a single,
+        # non-async comprehension clause with a plain name as its target.
+        # Anything more complicated falls back to the regular handling.
+        if len(generator.generators) != 1:
+            return False
+        comprehension = generator.generators[0]
+        if getattr(comprehension, "is_async", False):
+            return False
+        if not isinstance(comprehension.target, ast.Name):
+            return False
+        return True
+
+    def _visit_all_any_call(self, call):
+        """Rewrite ``all``/``any`` over a comprehension by unrolling it.
+
+        Instead of reporting a useless ``all(<generator object ...>)`` the
+        iterable is expanded into a ``for`` loop which still short-circuits
+        (exactly like the builtin does) but keeps the failing element bound
+        so that the failure message looks just like the equivalent explicit
+        ``for`` loop with an ``assert`` in its body.
+        """
+        is_all = call.func.id == "all"
+        generator = call.args[0]
+        element = generator.elt
+        comprehension = generator.generators[0]
+
+        # Evaluate the element expression using the explanation machinery,
+        # but collect the generated statements so that they end up inside the
+        # loop body rather than before it.
+        saved_statements = self.statements
+        self.statements = element_statements = []
+        try:
+            element_res, element_expl = self.visit(element)
+        finally:
+            self.statements = saved_statements
+
+        result_var = self.variable()
+        self.statements.append(
+            ast.Assign([ast.Name(result_var, ast.Store())], _NameConstant(is_all))
+        )
+
+        if is_all:
+            # ``all`` stops at the first *falsy* element.
+            break_cond = ast.UnaryOp(ast.Not(), element_res)
+            break_value = _NameConstant(False)
+        else:
+            # ``any`` stops at the first *truthy* element.
+            break_cond = element_res
+            break_value = _NameConstant(True)
+
+        body = list(element_statements)
+        body.append(
+            ast.If(
+                break_cond,
+                [
+                    ast.Assign([ast.Name(result_var, ast.Store())], break_value),
+                    ast.Break(),
+                ],
+                [],
+            )
+        )
+
+        # Wrap in the comprehension's ``if`` clauses (and-ed together).
+        loop_body = body
+        for if_ in reversed(comprehension.ifs):
+            loop_body = [ast.If(if_, loop_body, [])]
+        loop_body = [ast.For(comprehension.target, comprehension.iter, loop_body, [])]
+        self.statements.extend(loop_body)
+
+        return ast.Name(result_var, ast.Load()), element_expl
+
