+def test_dont_mangle_paths_after_chdir(testdir):
+    """The file path shown in the failure report should be relative to the
+    directory where pytest was invoked, not the (possibly changed) current
+    working directory (#6237).
+    """
+    testdir.makepyfile(
+        """
+        import os
+        import pytest
+
+
+        @pytest.fixture
+        def change_workdir(tmpdir):
+            old_dir = os.getcwd()
+            os.chdir(str(tmpdir))
+            yield
+            os.chdir(old_dir)
+
+
+        def test_fails(change_workdir):
+            assert False
+        """
+    )
+    result = testdir.runpytest_subprocess()
+    assert result.ret == 1
+    result.stdout.fnmatch_lines(
+        ["*test_dont_mangle_paths_after_chdir.py:*: AssertionError"]
+    )
+    result.stdout.no_fnmatch_line("*../test_dont_mangle_paths_after_chdir.py*")
+
