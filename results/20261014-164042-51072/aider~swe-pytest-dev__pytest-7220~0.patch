+    def __attrs_post_init__(self):
+        super().__attrs_post_init__()
+        # reprcrash and reprtraceback of the outermost (the newest) exception
+        # in the chain
+        self.reprtraceback = self.chain[-1][0]
+        self.reprcrash = self.chain[-1][1]
