 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _forcing_denominator(m, k, c, omega):
+    """Magnitude of k - m omega^2 + i c omega, computed without overflow."""
+    return math.hypot(k - m * omega * omega, c * omega)
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
