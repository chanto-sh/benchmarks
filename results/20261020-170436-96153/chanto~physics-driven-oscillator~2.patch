 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+from decimal import Decimal, localcontext
+
+_DECIMAL_PRECISION = 80
+
+
+def _residual_stiffness(m, k, omega):
+    """Return k - m*omega**2, accurately even very close to resonance."""
+    with localcontext() as ctx:
+        ctx.prec = _DECIMAL_PRECISION
+        dm = Decimal.from_float(float(m))
+        dk = Decimal.from_float(float(k))
+        dw = Decimal.from_float(float(omega))
+        return float(dk - dm * dw * dw)
+
+
+def _discriminant(m, k, c):
+    """Return c**2 - 4*m*k, accurately even very close to critical damping."""
+    with localcontext() as ctx:
+        ctx.prec = _DECIMAL_PRECISION
+        dm = Decimal.from_float(float(m))
+        dk = Decimal.from_float(float(k))
+        dc = Decimal.from_float(float(c))
+        return float(dc * dc - Decimal(4) * dm * dk)
+
+
+def _sinc(x):
+    """Return sin(x) / x, with the limiting value 1 at x == 0."""
+    if x == 0.0:
+        return 1.0
+    return math.sin(x) / x
+
+
+def _steady_coefficients(m, k, c, F0, omega):
+    """Coefficients A, B of x_p = A cos(omega t) + B sin(omega t)."""
+    residual = _residual_stiffness(m, k, omega)
+    driving = c * omega
+    scale = math.hypot(residual, driving)
+
+    if scale == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0
+        raise ValueError(
+            "no steady state for an undamped system driven exactly at resonance"
+        )
+
+    factor = F0 / scale
+    return factor * (residual / scale), factor * (driving / scale)
+
 
