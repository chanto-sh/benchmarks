 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _response(m, k, c, F0, omega):
+    """Return the normalized damping, stiffness, and steady-state coefficients.
+
+    The equation is divided by m first, which keeps the discriminant
+    a**2 - wn**2 well scaled:
+
+        x'' + 2 a x' + wn**2 x = (F0 / m) cos(omega t).
+    """
+    a = c / (2.0 * m)
+    wn2 = k / m
+    delta = wn2 - omega * omega
+    damp = 2.0 * a * omega
+    den = math.hypot(delta, damp)
+
+    if den == 0.0:
+        if F0 == 0.0:
+            return a, wn2, 0.0, 0.0, 0.0
+        raise ValueError("no steady state at exact undamped resonance")
+
+    drive = F0 / m
+    scale = drive / den
+    p = scale * (delta / den)
+    q = scale * (damp / den)
+    return a, wn2, p, q, abs(drive) / den
+
 
