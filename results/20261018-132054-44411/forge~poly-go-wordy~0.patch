 package wordy
 
+import (
+	"strconv"
+	"strings"
+)
+
+// Answer parses a simple math word problem and evaluates it from left to
+// right, ignoring the usual order of operations. The second return value is
+// false when the question is not a well-formed math word problem.
 func Answer(question string) (int, bool) {
-	panic("Please implement the Answer function")
+	const prefix = "What is "
+
+	if !strings.HasPrefix(question, prefix) || !strings.HasSuffix(question, "?") {
+		return 0, false
+	}
+
+	// Strip the question wrapper.
+	body := strings.TrimSpace(question[len(prefix) : len(question)-1])
+	if body == "" {
+		return 0, false
+	}
+
+	// Collapse the two-word operators so every token is a single word.
+	body = strings.ReplaceAll(body, "multiplied by", "multipliedBy")
+	body = strings.ReplaceAll(body, "divided by", "dividedBy")
+
+	tokens := strings.Fields(body)
+	// A valid expression must be: number (operator number)+ and therefore
+	// have an odd number of tokens.
+	if len(tokens) == 0 || len(tokens)%2 == 0 {
+		return 0, false
+	}
+
+	value, ok := parseNumber(tokens[0])
+	if !ok {
+		return 0, false
+	}
+
+	for i := 1; i < len(tokens); i += 2 {
+		operand, ok := parseNumber(tokens[i+1])
+		if !ok {
+			return 0, false
+		}
+
+		switch tokens[i] {
+		case "plus":
+			value += operand
+		case "minus":
+			value -= operand
+		case "multipliedBy":
+			value *= operand
+		case "dividedBy":
+			if operand == 0 {
+				return 0, false
+			}
+			value /= operand
+		default:
+			return 0, false
+		}
+	}
+
+	return value, true
+}
+
+func parseNumber(token string) (int, bool) {
+	n, err := strconv.Atoi(token)
+	if err != nil {
+		return 0, false
+	}
+	return n, true
 }
