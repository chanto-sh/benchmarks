+# ---------------------------------------------------------------------------
+# Exact polynomial helpers.  Polynomials are lists of coefficients ordered from
+# the highest degree down.  Trailing (high-order) zeros are stripped and a
+# polynomial is always non-empty.
+# ---------------------------------------------------------------------------
+
+
+def _trim(p):
+    """Drop leading (high-degree) zero coefficients."""
+    if not p:
+        return [Fraction(0)]
+    i = 0
+    while i < len(p) - 1 and p[i] == 0:
+        i += 1
+    return p[i:]
+
+
+def _is_zero(p):
+    return all(c == 0 for c in p)
+
+
+def _as_poly(coeffs):
+    return _trim([Fraction(c) for c in coeffs])
+
+
+def _poly_eval(p, x):
+    y = Fraction(0)
+    for c in p:
+        y = y * x + c
+    return y
+
+
+def _derivative(p):
+    n = len(p) - 1
+    if n < 1:
+        return [Fraction(0)]
+    return _trim([p[i] * (n - i) for i in range(n)])
+
+
+def _divmod(p, q):
+    """Exact polynomial division with remainder (highest degree first)."""
+    p = _trim(list(p))
+    q = _trim(list(q))
+    if _is_zero(q):
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(p) < len(q):
+        return [Fraction(0)], p
+
+    r = list(p)
+    quot = [Fraction(0)] * (len(p) - len(q) + 1)
+    lead = q[0]
+    for i in range(len(quot)):
+        c = r[i] / lead
+        quot[i] = c
+        if c:
+            for j in range(1, len(q)):
+                r[i + j] -= c * q[j]
+    rem = r[len(quot):]
+    return _trim(quot), _trim(rem)
+
+
+def _gcd(p, q):
+    """Monic greatest common divisor via the Euclidean algorithm."""
+    p = _trim(list(p))
+    q = _trim(list(q))
+    while not _is_zero(q):
+        _, r = _divmod(p, q)
+        p, q = q, r
+    if _is_zero(p):
+        return [Fraction(0)]
+    lead = p[0]
+    return [c / lead for c in p]
+
+
+def _square_free_part(p):
+    """p / gcd(p, p'): the same real roots, each with multiplicity one."""
+    dp = _derivative(p)
+    if _is_zero(dp):
+        return p  # constant polynomial
+    g = _gcd(p, dp)
+    q, r = _divmod(p, g)
+    if not _is_zero(r):  # pragma: no cover - gcd division is always exact
+        raise ArithmeticError("non-exact square-free division")
+    return q
+
+
+def _sturm_chain(p):
+    """Sturm sequence for a square-free polynomial, highest degree first."""
+    p = _trim(list(p))
+    if len(p) <= 1:
+        return [p]
+    chain = [p, _derivative(p)]
+    while True:
+        _, r = _divmod(chain[-2], chain[-1])
+        if _is_zero(r):
+            break
+        chain.append(_trim([-c for c in r]))
+    return chain
+
+
+def _sign_variations(chain, x):
+    """Number of sign changes in the chain at x, ignoring zero terms."""
+    changes = 0
+    last = 0
+    for poly in chain:
+        v = _poly_eval(poly, x)
+        if v == 0:
+            continue
+        s = 1 if v > 0 else -1
+        if last and s != last:
+            changes += 1
+        last = s
+    return changes
+
+
+def _divide_by_root(p, r):
+    """Exact division by (x - r); r must be a simple root of p."""
+    q, rem = _divmod(p, [Fraction(1), -r])
+    if not _is_zero(rem):  # pragma: no cover - guarded by callers
+        raise ArithmeticError("(x - r) is not a factor")
+    return q
+
+
+# ---------------------------------------------------------------------------
+# Isolation and refinement
+# ---------------------------------------------------------------------------
+
+# Refine isolated roots to an interval far narrower than the requested 1e-9.
+_TOLERANCE = Fraction(1, 10 ** 12)
+
+# Bisection halves the interval each step; 400 steps is far more than needed.
+_MAX_BISECTIONS = 400
+
+
+def _pick_split(p, a, b, degree):
+    """A rational point in (a, b) that is not a root of p.
+
+    p has at most `degree` roots, so `degree + 1` distinct candidate points
+    guarantee at least one non-root.
+    """
+    span = b - a
+    denom = degree + 2
+    for k in range(1, degree + 2):
+        m = a + span * Fraction(k, denom)
+        if _poly_eval(p, m) != 0:
+            return m
+    return (a + b) / 2  # pragma: no cover - unreachable for a real polynomial
+
+
+def _refine(p, a, b):
+    """Bisect (a, b) containing exactly one simple root down to _TOLERANCE."""
+    fa = _poly_eval(p, a)
+    fb = _poly_eval(p, b)
+    if fa == 0:
+        return a
+    if fb == 0:
+        return b
+    if fa * fb > 0:  # pragma: no cover - should never happen with Sturm counts
+        return (a + b) / 2
+    for _ in range(_MAX_BISECTIONS):
+        if b - a <= _TOLERANCE:
+            break
+        m = (a + b) / 2
+        fm = _poly_eval(p, m)
+        if fm == 0:
+            return m
+        if (fm > 0) == (fa > 0):
+            a, fa = m, fm
+        else:
+            b, fb = m, fm
+    return (a + b) / 2
+
+
