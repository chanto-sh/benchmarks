+    if _poly_eval(p, lo) == 0:
+        roots.append(lo)
+        p = _divide_by_root(p, lo)
+    if len(p) > 1 and _poly_eval(p, hi) == 0:
+        roots.append(hi)
+        p = _divide_by_root(p, hi)
+
+    if len(p) > 1:
+        chain = _sturm_chain(p)
+        vlo = _sign_variations(chain, lo)
+        vhi = _sign_variations(chain, hi)
+        degree = len(p) - 1
+
+        # Each stack entry is (a, b, V(a), V(b)) with a, b non-roots.  Sturm's
+        # theorem gives exactly V(a) - V(b) distinct roots in (a, b).
+        stack = [(lo, hi, vlo, vhi)]
+        while stack:
+            a, b, va, vb = stack.pop()
+            count = va - vb
+            if count <= 0:
+                continue
+            if count == 1:
+                roots.append(_refine(p, a, b))
+                continue
+            m = _pick_split(p, a, b, degree)
+            vm = _sign_variations(chain, m)
+            stack.append((a, m, va, vm))
+            stack.append((m, b, vm, vb))
+
+    roots.sort()
