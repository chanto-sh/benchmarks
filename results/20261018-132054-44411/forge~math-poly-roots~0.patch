     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
+        self.assertEqual(real_roots([1, 0, 1], -10 ** 9, 10 ** 9), [])
+
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4; the double root must appear once.
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_high_multiplicity(self):
+        # (x - 2)^4: even multiplicity gives no sign change, but 2 is a root.
+        self.assertRoots(real_roots([1, -8, 24, -32, 16], -5, 5), [2])
+
+    def test_mixed_multiplicities(self):
+        # (x - 1)(x - 2)^2 = x^3 - 5x^2 + 8x - 4
+        self.assertRoots(real_roots([1, -5, 8, -4], 1, 5), [1, 2])
+
+    def test_close_roots(self):
+        # (x - 1)(10^6 x - (10^6 + 1)) has roots 1 and 1 + 1e-6, closer
+        # than any practical uniform grid spacing.
+        self.assertRoots(
+            real_roots([10 ** 6, -(2 * 10 ** 6 + 1), 10 ** 6 + 1], 0, 2),
+            [1.0, 1.0 + 1e-6],
