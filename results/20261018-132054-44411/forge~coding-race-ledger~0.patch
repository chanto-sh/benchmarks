-        return acct
+        with self._lock:
+            acct = self.accounts[name] = Account(name, lock=self._lock)
+            if balance:
+                self.deposit(name, balance)
+            return acct
 
     def balance(self, name):
-        return self.accounts[name].balance
+        with self._lock:
+            return self.accounts[name].balance
 
