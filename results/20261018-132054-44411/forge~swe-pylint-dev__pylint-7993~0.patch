+def test_template_option_with_escaped_braces(linter) -> None:
+    """Test that escaped braces in the msg-template are left untouched.
+
+    See https://github.com/pylint-dev/pylint/issues/7993
+    """
+    output = StringIO()
+    linter.reporter.out = output
+    linter.config.msg_template = '{{ "Category": "{category}" }}'
+    linter.open()
+    with warnings.catch_warnings(record=True) as records:
+        warnings.simplefilter("always")
+        linter.set_current_module("my_mod")
+        linter.add_message("C0301", line=1, args=(1, 2))
+
+    assert not [r for r in records if issubclass(r.category, UserWarning)]
+    assert output.getvalue() == (
+        "************* Module my_mod\n" '{ "Category": "convention" }\n'
+    )
+
