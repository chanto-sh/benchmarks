+def test_statement_with_decorated_nested_function() -> None:
+    """Decorator lines of a following statement must not be included (#9359)."""
+    source = Source(
+        [
+            "def test_right_statement():",
+            "    assert 1 == 2",
+            "",
+            "    @decorator",
+            "    def inner():",
+            "        return 2",
+        ]
+    )
+    assert str(source.getstatement(1)) == "    assert 1 == 2"
+
