 impl<'a> CodonsInfo<'a> {
+    /// Return the name of the amino acid encoded by `codon`.
+    ///
+    /// `codon` may use the IUPAC shorthand letters (for example `R` stands for
+    /// `A` or `G`), in which case every concrete codon it expands to must be
+    /// known and must encode for the same amino acid.
     pub fn name_for(&self, codon: &str) -> Result<&'a str, Error> {
-        todo!(
-            "Return the protein name for a '{}' codon or Err, if codon string is invalid",
-            codon
-        );
+        let bases = codon.as_bytes();
+        if bases.len() != 3 {
+            return Err(Error);
+        }
+
+        let first = possible_bases(bases[0]).ok_or(Error)?;
+        let second = possible_bases(bases[1]).ok_or(Error)?;
+        let third = possible_bases(bases[2]).ok_or(Error)?;
+
+        let mut name: Option<&'a str> = None;
+        for &a in first {
+            for &b in second {
+                for &c in third {
+                    let concrete = [a, b, c];
+                    let key = std::str::from_utf8(&concrete).map_err(|_| Error)?;
+                    let candidate = *self.codons.get(key).ok_or(Error)?;
+                    match name {
+                        None => name = Some(candidate),
+                        Some(existing) if existing == candidate => {}
+                        Some(_) => return Err(Error),
