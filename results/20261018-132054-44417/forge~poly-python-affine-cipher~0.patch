+from math import gcd
+
+ALPHABET_SIZE = 26
+
+
+def _check_coprime(a):
+    """Ensure a and the alphabet size are coprime, otherwise raise ValueError."""
+    if gcd(a, ALPHABET_SIZE) != 1:
+        raise ValueError("a and m must be coprime.")
+
+
+def _mmi(a):
+    """Return the modular multiplicative inverse of a mod ALPHABET_SIZE."""
+    for x in range(1, ALPHABET_SIZE):
+        if (a * x) % ALPHABET_SIZE == 1:
+            return x
+    raise ValueError("a and m must be coprime.")
+
+
