+def test_paths_in_error_output_are_relative_to_invocation_dir(testdir):
+    """Paths in the failure report are not affected by a changed working directory."""
+    testdir.makepyfile(
+        """
+        import os
+
+        def test_foo():
+            os.mkdir("foo")
+            os.chdir("foo")
+            assert False
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        ["test_paths_in_error_output_are_relative_to_invocation_dir.py:*: AssertionError"]
+    )
+
+
