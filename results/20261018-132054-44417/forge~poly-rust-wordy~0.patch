+/// Parses and evaluates a simple math word problem.
+///
+/// Returns `None` for non-math questions, unsupported operations and
+/// syntactically invalid problems. Operations are evaluated strictly from
+/// left to right (no operator precedence).
 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let tokens = tokenize(command)?;
+    // tokens must be: <number> (<operator> <number>)*
+    let mut i = 0;
+    let mut acc = parse_number(tokens[i])?;
+    i += 1;
+
+    while i < tokens.len() {
+        let op = parse_operator(&tokens[i..])?;
+        i += op.consumed;
+        // Exponentials carry their own operand (`... raised to the 5th power`).
+        acc = match op.op {
+            Operator::Pow(exp) => acc.checked_pow(exp)?,
+            _ => {
+                let rhs = parse_number(tokens.get(i)?)?;
+                i += 1;
+                op.apply(acc, rhs)?
+            }
+        };
+    }
+
+    Some(acc)
+}
+
+/// Strips the question prefix/suffix and splits the rest into tokens.
+fn tokenize(command: &str) -> Option<Vec<&str>> {
+    let rest = command.strip_prefix("What is")?;
+    // The prefix must be a whole word, not part of something like "What ish".
+    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
+        return None;
+    }
+    let rest = rest.trim_end().strip_suffix('?')?;
+    let tokens: Vec<&str> = rest.split_whitespace().collect();
+    if tokens.is_empty() {
+        return None;
+    }
+    Some(tokens)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse::<i32>().ok()
+}
+
+enum Operator {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Pow(u32),
+}
+
+/// A parsed operator along with how many tokens it occupied.
+struct ParsedOperator {
+    op: Operator,
+    consumed: usize,
+}
+
+impl ParsedOperator {
+    fn apply(&self, lhs: i32, rhs: i32) -> Option<i32> {
+        match self.op {
+            Operator::Add => lhs.checked_add(rhs),
+            Operator::Sub => lhs.checked_sub(rhs),
+            Operator::Mul => lhs.checked_mul(rhs),
+            Operator::Div => lhs.checked_div(rhs),
+            Operator::Pow(_) => unreachable!("powers are applied directly"),
+        }
+    }
+}
+
+fn parse_operator(tokens: &[&str]) -> Option<ParsedOperator> {
+    match tokens {
+        ["plus", ..] => Some(ParsedOperator {
+            op: Operator::Add,
+            consumed: 1,
+        }),
+        ["minus", ..] => Some(ParsedOperator {
+            op: Operator::Sub,
+            consumed: 1,
+        }),
+        ["multiplied", "by", ..] => Some(ParsedOperator {
+            op: Operator::Mul,
+            consumed: 2,
+        }),
+        ["divided", "by", ..] => Some(ParsedOperator {
+            op: Operator::Div,
+            consumed: 2,
+        }),
+        ["raised", "to", "the", ordinal, "power", ..] => Some(ParsedOperator {
+            op: Operator::Pow(parse_ordinal(ordinal)?),
+            consumed: 5,
+        }),
+        _ => None,
+    }
+}
+
+/// Parses an English ordinal such as "1st", "2nd", "5th", "23rd".
+fn parse_ordinal(token: &str) -> Option<u32> {
+    let digits = token
+        .strip_suffix("th")
+        .or_else(|| token.strip_suffix("st"))
+        .or_else(|| token.strip_suffix("nd"))
+        .or_else(|| token.strip_suffix("rd"))?;
+    digits.parse::<u32>().ok()
 }
