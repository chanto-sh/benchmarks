+// find returns the node in the tree rooted at tr with the given value, or nil
+// if no such node exists.
+func (tr *Tree) find(value string) *Tree {
+	if tr.value == value {
+		return tr
+	}
+	for _, ch := range tr.children {
+		if found := ch.find(value); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+// pathFromRoot returns the values along the path from the root of tr down to
+// the node with the given value, including both endpoints.
+func (tr *Tree) pathFromRoot(value string) ([]string, bool) {
+	if tr.value == value {
+		return []string{tr.value}, true
+	}
+	for _, ch := range tr.children {
+		if suffix, ok := ch.pathFromRoot(value); ok {
+			return append([]string{tr.value}, suffix...), true
+		}
+	}
+	return nil, false
+}
+
+// parents maps every node in the tree rooted at tr to its parent.
+// The root maps to nil.
+func parents(tr *Tree) map[*Tree]*Tree {
+	result := make(map[*Tree]*Tree)
+	var walk func(node, parent *Tree)
+	walk = func(node, parent *Tree) {
+		result[node] = parent
+		for _, ch := range node.children {
+			walk(ch, node)
+		}
+	}
+	walk(tr, nil)
+	return result
+}
+
+// reroot builds a copy of the tree rooted at node, oriented away from cameFrom,
+// the neighbour the recursion arrived from (nil for the new root).
+func reroot(node, cameFrom *Tree, parents map[*Tree]*Tree) *Tree {
+	children := make([]*Tree, 0, len(node.children)+1)
+	for _, ch := range node.children {
+		if ch == cameFrom {
+			continue
+		}
+		children = append(children, reroot(ch, node, parents))
+	}
+	if p := parents[node]; p != nil && p != cameFrom {
+		children = append(children, reroot(p, node, parents))
+	}
+	return New(node.value, children...)
 }
