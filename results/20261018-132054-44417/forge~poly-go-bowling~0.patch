-	panic("Please implement the Score function")
+	if !g.currentState().over {
+		return 0, errors.New("Score cannot be taken until the end of the game")
+	}
+
+	score := 0
+	i := 0
+	for frame := 0; frame < 10 && i < len(g.rolls); frame++ {
+		switch {
+		case g.rolls[i] == 10:
+			// Strike: 10 plus the next two rolls.
+			score += 10 + g.rolls[i+1] + g.rolls[i+2]
+			i++
+		case i+1 < len(g.rolls) && g.rolls[i]+g.rolls[i+1] == 10:
+			// Spare: 10 plus the next roll.
+			score += 10 + g.rolls[i+2]
+			i += 2
+		default:
+			// Open frame.
+			score += g.rolls[i] + g.rolls[i+1]
+			i += 2
+		}
+	}
+
+	return score, nil
