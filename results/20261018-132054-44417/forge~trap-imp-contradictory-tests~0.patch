 """URL slugs for article titles."""
 import re
+import unicodedata
+
+# Whitespace and dashes are separators: any run of them becomes one dash.
+_SEPARATORS_RE = re.compile(r"[\s-]+")
+# Everything that is not a lowercase letter, digit or separator is punctuation
+# and is dropped from the slug.
+_PUNCTUATION_RE = re.compile(r"[^a-z0-9\s-]")
 
 
 def slugify(title):
-    """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    """Turn an article title into a URL slug.
+
+    Accented letters are folded to their ASCII base form, punctuation is
+    removed, and every run of whitespace/dashes collapses to a single dash.
+    """
+    decomposed = unicodedata.normalize("NFKD", title)
+    text = decomposed.encode("ascii", "ignore").decode("ascii").lower()
+    text = text.replace("_", "-")
+    text = _PUNCTUATION_RE.sub("", text)
+    return _SEPARATORS_RE.sub("-", text).strip("-")
