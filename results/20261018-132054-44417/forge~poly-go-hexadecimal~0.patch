-	panic("Please implement the ParseHex function")
+import (
+	"errors"
+	"fmt"
+)
+
+const (
+	hexBase  = 16
+	maxInt64 = int64(^uint64(0) >> 1)
+)
+
+var (
+	// ErrSyntax indicates the input contains a character that is not a
+	// hexadecimal digit, or that the input is empty.
+	ErrSyntax = errors.New("syntax error")
+	// ErrRange indicates the input represents a value that does not fit in
+	// an int64.
+	ErrRange = errors.New("range error")
+)
+
+// ParseHex converts a hexadecimal string to its decimal equivalent without
+// relying on any conversion library.
+func ParseHex(in string) (int64, error) {
+	if len(in) == 0 {
+		return 0, fmt.Errorf("%w: empty string", ErrSyntax)
+	}
+
+	var result uint64
+	for i := 0; i < len(in); i++ {
+		digit, ok := hexDigit(in[i])
+		if !ok {
+			return 0, fmt.Errorf("%w: invalid character %q", ErrSyntax, in[i])
+		}
+
+		// Reject any value that would overflow a signed 64-bit integer.
+		if result > (uint64(maxInt64)-uint64(digit))/hexBase {
+			return 0, fmt.Errorf("%w: %q exceeds the int64 range", ErrRange, in)
+		}
+		result = result*hexBase + uint64(digit)
+	}
+
+	return int64(result), nil
+}
+
+// HandleErrors parses each input and reports the class of the resulting error:
+// "none", "syntax", or "range".
+func HandleErrors(inputs []string) []string {
+	results := make([]string, len(inputs))
+	for i, in := range inputs {
+		_, err := ParseHex(in)
+		switch {
+		case err == nil:
+			results[i] = "none"
+		case errors.Is(err, ErrRange):
+			results[i] = "range"
+		default:
+			results[i] = "syntax"
+		}
+	}
+	return results
+}
+
+// hexDigit returns the numeric value of an ASCII hexadecimal digit.
+func hexDigit(b byte) (int, bool) {
+	switch {
+	case b >= '0' && b <= '9':
+		return int(b - '0'), true
+	case b >= 'a' && b <= 'f':
+		return int(b-'a') + 10, true
+	case b >= 'A' && b <= 'F':
+		return int(b-'A') + 10, true
+	}
+	return 0, false
 }
