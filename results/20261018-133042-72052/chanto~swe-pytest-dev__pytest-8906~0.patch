--- a/testing/test_skipping.py
+++ b/testing/test_skipping.py
@@ -1341,7 +1341,10 @@ def test_module_level_skip_error(pytester: Pytester) -> None:
     )
     result = pytester.runpytest()
     result.stdout.fnmatch_lines(
