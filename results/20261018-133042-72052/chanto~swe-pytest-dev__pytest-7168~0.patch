diff --git a/changelog/7168.bugfix.rst b/changelog/7168.bugfix.rst
new file mode 100644
index 0000000..533e52b
--- /dev/null
+++ b/changelog/7168.bugfix.rst
@@ -0,0 +1,2 @@
+Fixed a crash when an object's ``__getattribute__`` raises while pytest is
+formatting its ``repr()``.
diff --git a/src/_pytest/_io/saferepr.py b/src/_pytest/_io/saferepr.py
index 23af4d0..47a00de 100644
--- a/src/_pytest/_io/saferepr.py
+++ b/src/_pytest/_io/saferepr.py
@@ -20,7 +20,7 @@ def _format_repr_exception(exc: BaseException, obj: Any) -> str:
     except BaseException as exc:
         exc_info = "unpresentable exception ({})".format(_try_repr_or_str(exc))
     return "<[{} raised in repr()] {} object at 0x{:x}>".format(
-        exc_info, obj.__class__.__name__, id(obj)
+        exc_info, type(obj).__name__, id(obj)
     )
 
 
diff --git a/testing/io/test_saferepr.py b/testing/io/test_saferepr.py
index 0608420..63b93ec 100644
--- a/testing/io/test_saferepr.py
+++ b/testing/io/test_saferepr.py
@@ -56,6 +56,24 @@ def test_exceptions():
     )
 
 
+def test_raising_getattribute():
+    class SomeClass:
+        def __getattribute__(self, attr):
+            raise ValueError("getattribute called")
+
+        def __repr__(self):
+            raise ValueError("repr called")
+
+    obj = SomeClass()
+    # Accessing ``obj.__class__`` in the error message must not invoke
+    # ``__getattribute__``, otherwise saferepr() would raise itself.
+    assert saferepr(obj) == (
+        "<[ValueError('repr called') raised in repr()] SomeClass object at 0x{:x}>".format(
+            id(obj)
+        )
+    )
+
+
 def test_baseexception():
     """Test saferepr() with BaseExceptions, which includes pytest outcomes."""
 
