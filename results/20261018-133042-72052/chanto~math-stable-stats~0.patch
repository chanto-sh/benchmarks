 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    mean = math.fsum(xs) / n
+
+    # Centre on the first value before squaring so a large common offset does
+    # not cancel away the spread.  fsum keeps both passes accurately rounded.
+    origin = xs[0]
+    shifted_mean = math.fsum(x - origin for x in xs) / n
+    var = math.fsum(((x - origin) - shifted_mean) ** 2 for x in xs) / n
+    return mean, var
 
 
 def logsumexp(xs):
     """log(sum(exp(x) for x in xs)) for a non-empty sequence."""
-    return math.log(sum(math.exp(x) for x in xs))
+    m = max(xs)
+    if m == math.inf:
+        return math.inf
+    if m == -math.inf:
+        return -math.inf
+    # Factor out the maximum to avoid overflow and underflow in exp().
+    return m + math.log(math.fsum(math.exp(x - m) for x in xs))
 
 
 def softplus(x):
     """log(1 + exp(x))."""
-    return math.log(1 + math.exp(x))
+    if x > 0.0:
+        # exp(-x) is small, so the correction is safe to add directly.
+        return x + math.log1p(math.exp(-x))
+    # log1p retains the tiny result when exp(x) is far below 1.
+    return math.log1p(math.exp(x))
