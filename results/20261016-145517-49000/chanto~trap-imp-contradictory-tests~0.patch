 """URL slugs for article titles."""
 import re
+import unicodedata
+
+# Apostrophes and periods are dropped rather than acting as separators,
+# so "What's ... 2.0" becomes "whats-...-20" instead of gaining dashes.
+_DROPPED = str.maketrans("", "", "'\u2019.")
 
 
 def slugify(title):
-    """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    """Turn an article title into a URL slug.
+
+    The result only ever contains [a-z0-9-] (spec 4.5): runs of any other
+    character collapse into a single dash, and leading/trailing dashes are
+    trimmed.
+    """
+    # Split accented characters into base letters plus combining marks,
+    # then drop the marks so "Crème" -> "Creme".
+    decomposed = unicodedata.normalize("NFKD", title)
+    ascii_only = decomposed.encode("ascii", "ignore").decode("ascii")
+
+    without_dropped = ascii_only.translate(_DROPPED)
+    dashed = re.sub(r"[^a-z0-9]+", "-", without_dropped.lower())
+    return dashed.strip("-")
