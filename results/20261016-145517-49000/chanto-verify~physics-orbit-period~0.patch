+"""Orbit measurements for a test particle in a central force field.
+
+The radial period is the time between two successive closest approaches to the
+origin.  Because the force is central the radial motion is periodic: every
+periapsis-to-next-periapsis leg takes exactly the same amount of time (the
+effective radial potential, and hence the energy and angular momentum, are
+fixed).  So it is enough to integrate the equations of motion and measure the
+time between two consecutive periapsis passages.
+
+The integration uses a self-contained adaptive Dormand-Prince 5(4) scheme
+(no third-party dependencies).  Periapsis is the instant the radial velocity
+changes sign from inward to outward, i.e. a zero crossing of
+
+    g(t) = x * vx + y * vy = r * dr/dt
+
+from negative to positive.  The crossing time inside a step is pinned down by
+bisection using the same integrator, which makes the reported period accurate
+to far better than the requested 1e-6 relative accuracy.
+"""
+
+import math
+
+# ---------------------------------------------------------------------------
+# Dormand-Prince 5(4) coefficients.
+# ---------------------------------------------------------------------------
+_DOPRI5_A = (
+    (),
+    (1.0 / 5,),
+    (3.0 / 40, 9.0 / 40),
+    (44.0 / 45, -56.0 / 15, 32.0 / 9),
+    (19372.0 / 6561, -25360.0 / 2187, 64448.0 / 6561, -212.0 / 729),
+    (9017.0 / 3168, -355.0 / 33, 46732.0 / 5247, 49.0 / 176, -5103.0 / 18656),
+)
+# Fifth-order solution (coincides with the first six entries of the FSAL row).
+_DOPRI5_B = (35.0 / 384, 0.0, 500.0 / 1113, 125.0 / 192, -2187.0 / 6784, 11.0 / 84)
+# Fourth-order solution, used only for the embedded error estimate.
+_DOPRI5_BHAT = (5179.0 / 57600, 0.0, 7571.0 / 16695, 393.0 / 640,
+                -92097.0 / 339200, 187.0 / 2100, 1.0 / 40)
+
+# Safety budget: bound orbits need only a few thousand steps, so this only
+# ever bites for genuinely unbound motion.
+_MAX_STEPS = 2_000_000
+# Largest polar-angle advance allowed in a single step.
+_MAX_ANGLE_STEP = 0.5
+# A bound orbit keeps its radius within a finite band; wandering far outside
+# the starting radius (escape) or collapsing onto the origin (plunge, possible
+# when the attractive force overwhelms the centrifugal barrier) means there is
+# no second closest approach to report.
+_ESCAPE_FACTOR = 1e6
+_PLUNGE_FACTOR = 1e-6
 
 
 def newtonian(gm):
