--- a/test_nbody.py
+++ b/test_nbody.py
@@ -4,6 +4,19 @@ import unittest
 from nbody import energy, simulate
 
 
+def total_momentum(masses, velocities):
+    return [sum(m * v[k] for m, v in zip(masses, velocities)) for k in (0, 1)]
+
+
+def figure_eight():
+    # Known periodic three-body solution (equal masses, G = 1).
+    x = [0.97000436, -0.24308753]
+    w = [-0.93240737, -0.86473146]
+    pos = [[x[0], x[1]], [-x[0], -x[1]], [0.0, 0.0]]
+    vel = [[-w[0] / 2, -w[1] / 2], [-w[0] / 2, -w[1] / 2], [w[0], w[1]]]
+    return [1.0, 1.0, 1.0], pos, vel
+
+
 class TestNBody(unittest.TestCase):
     def test_circular_two_body(self):
         # equal masses on a circular orbit about the origin
@@ -17,6 +30,56 @@ class TestNBody(unittest.TestCase):
         for xy in p:
             self.assertAlmostEqual(math.hypot(*xy), 1.0, places=3)
 
+    def test_figure_eight_long_run(self):
+        # a genuinely 3-body interaction over a long stretch: energy must stay
+        # bounded rather than drifting, and net momentum must be conserved.
+        m, pos, vel = figure_eight()
+        e0 = energy(m, pos, vel)
+        p0 = total_momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.001, 100000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+        pf = total_momentum(m, q)
+        self.assertLess(abs(pf[0] - p0[0]) + abs(pf[1] - p0[1]), 1e-9)
+
+    def test_energy_error_does_not_grow(self):
+        # a symplectic scheme keeps the energy error bounded; check that it is
+        # no larger at 4x the integration time (i.e. no secular drift).
+        m, pos, vel = figure_eight()
+        e0 = energy(m, pos, vel)
+
+        def rel_err(steps):
+            p, q = simulate(m, pos, vel, 0.001, steps)
+            return abs(energy(m, p, q) - e0) / abs(e0)
+
+        short = rel_err(25000)
+        long = rel_err(100000)
+        self.assertLess(long, 1e-4)
+        self.assertLess(long, 10 * max(short, 1e-9))
+
+    def test_momentum_conserved_general_system(self):
+        # four bodies with unequal masses and an asymmetric, net-nonzero setup
+        m = [1.0, 2.0, 0.7, 1.3]
+        pos = [[-1.0, 0.3], [1.2, -0.7], [0.4, 1.5], [-0.9, -1.1]]
+        vel = [[0.1, -0.2], [-0.3, 0.15], [0.25, 0.05], [-0.05, 0.3]]
+        p0 = total_momentum(m, vel)
+        _, q = simulate(m, pos, vel, 0.002, 20000)
+        pf = total_momentum(m, q)
+        self.assertLess(abs(pf[0] - p0[0]) + abs(pf[1] - p0[1]), 1e-9)
+
+    def test_inputs_not_modified(self):
+        m, pos, vel = figure_eight()
+        pos0 = [list(p) for p in pos]
+        vel0 = [list(v) for v in vel]
+        simulate(m, pos, vel, 0.001, 1000)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
+    def test_zero_steps_is_identity(self):
+        m, pos, vel = figure_eight()
+        p, q = simulate(m, pos, vel, 0.01, 0)
+        self.assertEqual(p, pos)
+        self.assertEqual(q, vel)
+
 
 if __name__ == "__main__":
     unittest.main()
