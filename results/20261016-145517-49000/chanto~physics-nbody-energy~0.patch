diff --git a/nbody.py b/nbody.py
index 133b00d..a09e06c 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,32 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick), a symplectic scheme: total energy
+    stays bounded rather than drifting secularly over long integrations, and
+    momentum is conserved because the pairwise forces are equal and opposite.
+    Inputs are copied, so the caller's lists are never modified.
+    """
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        # half kick with the current accelerations
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+        # full drift
+        for i in range(n):
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        # recompute accelerations at the new positions, then the second half kick
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+    return pos, vel
diff --git a/test_nbody.py b/test_nbody.py
