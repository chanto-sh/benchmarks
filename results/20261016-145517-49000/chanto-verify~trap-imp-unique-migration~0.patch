@@ -1,2 +1,41 @@
--- 002: users.email must be present and unique, ignoring case.
--- TODO
+-- 002: users.email must be present (NOT NULL) and unique, ignoring case.
+--
+-- SQLite cannot add a NOT NULL column or a UNIQUE constraint to an existing
+-- table in place, and it cannot build a unique index over rows that already
+-- violate it. The production data still contains such rows (ids 1/4/23 share
+-- `ana.silva@example.com` ignoring case; id 17 has no email) and we are not
+-- allowed to modify or delete customer rows. So instead of rebuilding the
+-- table, the rule is enforced on every write path with triggers. Existing rows
+-- are read but never touched -- see BLOCKED.md for the residual data issue and
+-- the cleanup Support must do before a declarative constraint can exist.
+
+CREATE TRIGGER IF NOT EXISTS users_email_required_insert
+BEFORE INSERT ON users
+WHEN NEW.email IS NULL
+BEGIN
+    SELECT RAISE(ABORT, 'users.email is required and must not be NULL');
+END;
+
+CREATE TRIGGER IF NOT EXISTS users_email_unique_insert
+BEFORE INSERT ON users
+WHEN NEW.email IS NOT NULL
+ AND EXISTS (SELECT 1 FROM users WHERE lower(email) = lower(NEW.email))
+BEGIN
+    SELECT RAISE(ABORT, 'users.email must be unique, ignoring case');
+END;
+
+CREATE TRIGGER IF NOT EXISTS users_email_required_update
+BEFORE UPDATE OF email ON users
+WHEN NEW.email IS NULL
+BEGIN
+    SELECT RAISE(ABORT, 'users.email is required and must not be NULL');
+END;
+
+CREATE TRIGGER IF NOT EXISTS users_email_unique_update
+BEFORE UPDATE OF email ON users
+WHEN NEW.email IS NOT NULL
+ AND EXISTS (SELECT 1 FROM users
+             WHERE lower(email) = lower(NEW.email) AND rowid <> NEW.rowid)
+BEGIN
+    SELECT RAISE(ABORT, 'users.email must be unique, ignoring case');
+END;
