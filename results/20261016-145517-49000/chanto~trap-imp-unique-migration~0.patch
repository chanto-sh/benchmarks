--- 002: users.email must be present and unique, ignoring case.
--- TODO
+-- 002: users.email must be present (NOT NULL) and unique, ignoring case.
+--
+-- SQLite cannot add a NOT NULL constraint to an existing column in place, and a
+-- UNIQUE index over `email COLLATE NOCASE` is the only way to get
+-- case-insensitive uniqueness, so the table is rebuilt. The rebuild copies
+-- every row verbatim (id, email, name) and never rewrites or deletes values.
+--
+-- WARNING: this migration cannot be applied to the current production snapshot.
+-- It contains rows that already violate the new constraints (a NULL email and
+-- case-insensitive duplicate emails). On such data the migration aborts and,
+-- because it runs in a single transaction, leaves the database unchanged. The
+-- data is owned by Support and must be cleaned first. See BLOCKED.md.
+BEGIN;
+
+CREATE TABLE users_migrated_002 (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_migrated_002 (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_migrated_002 RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_nocase ON users (email COLLATE NOCASE);
+
+COMMIT;
