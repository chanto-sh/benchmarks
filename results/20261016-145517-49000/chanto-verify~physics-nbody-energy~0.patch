diff --git a/nbody.py b/nbody.py
index 133b00d..7e30e03 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,34 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses the kick-drift-kick (velocity Verlet) leapfrog scheme. Being
+    symplectic, it keeps the total energy bounded instead of secularly
+    drifting, and because the pairwise forces obey Newton's third law it
+    conserves total linear momentum exactly (up to round-off). Inputs are
+    copied, never mutated.
+    """
+    n = len(masses)
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(vx), float(vy)] for vx, vy in velocities]
+
+    acc = accelerations(masses, pos, G)
+    half = 0.5 * dt
+    for _ in range(steps):
+        # half kick
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+        # drift
+        for i in range(n):
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        # recompute forces at the new positions
+        acc = accelerations(masses, pos, G)
+        # half kick
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+
+    return pos, vel
