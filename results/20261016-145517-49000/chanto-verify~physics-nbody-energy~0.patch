+    def test_energy_does_not_drift_over_long_run(self):
+        # 100k steps: a symplectic scheme keeps the error bounded, not growing.
+        m = [1.0, 1.0]
+        v = math.sqrt(1.0 / 4.0)
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 100000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_eccentric_two_body(self):
+        # e = 0.5 orbit; forces vary strongly along the ellipse.
+        mu = 2.0  # G * (m1 + m2)
+        rp, ra = 1.0, 3.0
+        a = 0.5 * (rp + ra)
+        vp = math.sqrt(mu * (2.0 / rp - 1.0 / a))
+        m = [1.0, 1.0]
+        pos = [[-rp, 0.0], [rp, 0.0]]
+        vel = [[0.0, -vp], [0.0, vp]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_figure_eight_three_body(self):
+        # Choreographed three-body solution; exercises a full 3-body interaction.
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753], [-0.97000436, 0.24308753], [0.0, 0.0]]
+        vel = [[0.46620369, 0.43236573], [0.46620369, 0.43236573],
+               [-0.93240737, -0.86473146]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_momentum_conserved(self):
+        m = [1.0, 2.0, 1.5]
+        pos = [[0.0, 0.0], [2.0, 1.0], [-1.0, 2.0]]
+        vel = [[0.0, 0.0], [0.0, 0.3], [-0.1, 0.0]]
+        p0 = momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.002, 5000)
+        p1 = momentum(m, q)
+        self.assertAlmostEqual(p0[0], p1[0], places=9)
