@@ -27,3 +16,18 @@ class Client:
             self.limiter.acquire()
             out.append(self.fetch(url))
         return out
+
+    async def fetch_all_async(self, urls):
+        """Fetch each URL in order, awaiting the limiter before each request.
+
+        Uses the limiter's native async support; `fetch` may be a coroutine
+        function or a plain callable.
+        """
+        out = []
+        for url in urls:
+            await self.limiter.acquire_async()
+            result = self.fetch(url)
+            if inspect.isawaitable(result):
+                result = await result
+            out.append(result)
+        return out
