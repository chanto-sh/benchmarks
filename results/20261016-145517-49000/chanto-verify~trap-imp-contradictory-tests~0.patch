 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
-    """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    """Turn an article title into a URL slug.
+
+    The result contains only ``[a-z0-9-]``: accented characters are
+    transliterated to ASCII, punctuation is dropped, and any run of
+    separators (whitespace, underscores, existing dashes) collapses to a
+    single dash, with leading and trailing dashes removed.
+    """
+    # Decompose accented characters (e.g. "è" -> "e" + combining grave)
+    # and drop the combining marks.
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_text = "".join(c for c in normalized if not unicodedata.combining(c))
+    lowered = ascii_text.lower()
+    # Keep only letters, digits and separators; punctuation disappears.
+    kept = re.sub(r"[^a-z0-9\s_-]", "", lowered)
+    return re.sub(r"[\s_-]+", "-", kept).strip("-")
