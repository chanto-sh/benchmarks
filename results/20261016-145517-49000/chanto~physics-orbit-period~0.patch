+    """Time between two successive closest approaches to the origin.
+
+    ``r0`` and ``v0`` are the starting position and velocity; ``accel(x, y)``
+    gives the (central) acceleration.  The particle may start anywhere on its
+    orbit, not only at closest approach.
+    """
+    x0, y0 = r0
+    vx0, vy0 = v0
+    radius0 = math.hypot(x0, y0)
+    if radius0 == 0.0:
+        raise ValueError("the particle starts at the origin, where accel is singular")
+
+    state = (float(x0), float(y0), float(vx0), float(vy0))
+    speed0 = math.hypot(vx0, vy0)
+    angular_momentum = x0 * vy0 - y0 * vx0
+
+    # Timescale over which a (near) circular orbit completes a revolution; used
+    # only to decide when a featureless orbit should be treated as circular.
+    t_scale = radius0 / speed0 if speed0 > 0.0 else float("inf")
+    circular_guard = 4.0 * math.pi * t_scale
+
+    t = 0.0
+    h = _initial_step(state, accel)
+    # Negative-to-positive zero of this quantity marks a minimum of r, i.e. a
+    # closest approach to the origin.
+    radial_vr = state[0] * state[2] + state[1] * state[3]
+    passages = []
+    r_min_seen = r_max_seen = radius0
+    steps = 0
+    while len(passages) < 2:
+        y5, y4 = _step(t, state, h, accel)
+        err = _error_norm(state, y5, y4)
+        if err > 1.0 and h > 1e-14 * max(1.0, abs(t)):
+            h *= max(0.1, 0.9 * err ** -0.2)
