                 bad.append(name)
                 continue
-            with open(path) as a:
-                digest = hashlib.sha256(a.read().encode()).hexdigest()
-            if digest != expected:
+            with open(path, "rb") as a:
+                digest = hashlib.sha256(a.read()).hexdigest()
+            if digest.lower() != expected.lower():
                 bad.append(name)
     return sorted(bad)
 
