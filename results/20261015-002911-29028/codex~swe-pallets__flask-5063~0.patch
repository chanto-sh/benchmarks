         match_order = [r.endpoint for r in app.url_map.iter_rules()]
         self.expect_order(match_order, invoke(["routes", "-s", "match"]).output)
 
+    def test_subdomain(self, app, invoke):
+        bp = Blueprint("bp", __name__)
+
+        @bp.route("/")
+        def index():
+            pass
+
+        app.register_blueprint(bp, subdomain="sub")
+
+        lines = invoke(["routes"]).output.splitlines()
+        assert lines[0].split() == ["Endpoint", "Methods", "Subdomain", "Rule"]
+        row = next(line for line in lines if line.startswith("bp.index"))
+        assert row.split() == ["bp.index", "GET", "sub", "/"]
+
+    def test_sort_domain(self, app, invoke):
+        @app.route("/a", subdomain="bbb")
+        def bbb():
+            pass
+
+        @app.route("/b", subdomain="aaa")
+        def aaa():
+            pass
+
+        lines = invoke(["routes", "-s", "domain"]).output.splitlines()[2:]
+        endpoints = [line.split()[0] for line in lines]
+        assert endpoints.index("aaa") < endpoints.index("bbb")
+
+    def test_host_matching(self, app, invoke):
+        app.url_map.host_matching = True
+
+        @app.route("/", host="example.com")
+        def index():
+            pass
+
+        lines = invoke(["routes"]).output.splitlines()
+        assert lines[0].split() == ["Endpoint", "Methods", "Host", "Rule"]
+        row = next(line for line in lines if line.startswith("index"))
+        assert "example.com" in row.split()
+
     def test_all_methods(self, invoke):
