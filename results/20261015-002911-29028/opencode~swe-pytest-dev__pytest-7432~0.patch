+def test_skip_location_on_unconditional_skip_with_runxfail(testdir):
+    testdir.makepyfile(
+        """
+        import pytest
+        @pytest.mark.skip
+        def test_skip_location() -> None:
+            assert 0
+        """
+    )
+    result = testdir.runpytest("-rs", "--runxfail")
+    result.stdout.fnmatch_lines(
+        [
+            "SKIPPED [[]1[]] test_skip_location_on_unconditional_skip_with_runxfail.py:2: unconditional skip"
+        ]
+    )
