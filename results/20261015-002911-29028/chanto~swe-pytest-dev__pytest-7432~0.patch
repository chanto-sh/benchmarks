index 0000000..c049e7a
--- /dev/null
+++ b/changelog/7432.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed reporting of the location of tests skipped with ``@pytest.mark.skip`` or
+``@pytest.mark.skipif`` when ``--runxfail`` is used: the location now points to the
+test itself rather than to pytest's internal ``skipping.py``.
diff --git a/src/_pytest/skipping.py b/src/_pytest/skipping.py
