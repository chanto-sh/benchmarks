+# Explicit forward-Euler is stable only while alpha * dt / dx**2 <= 1/2.
+# Stay comfortably below that limit so the highest grid mode cannot grow.
+_MAX_R = 0.4
+
+# Also keep the decay of the slowest mode per step small, which bounds the
+# first-order time-integration error on coarse grids.
+_MAX_DECAY_PER_STEP = 1e-3
