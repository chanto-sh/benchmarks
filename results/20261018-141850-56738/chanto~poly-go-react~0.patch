+}
+
+// propagate updates every cell whose dependencies changed, in creation order
+// (which is a valid topological order), then calls callbacks once per cell
+// whose stable value changed.
+func (r *reactor) propagate(changedInput *cell) {
+	changed := map[*cell]bool{changedInput: true}
+
+	for _, c := range r.cells {
+		if c.compute == nil {
+			continue
+		}
+		dirty := false
+		for _, dep := range c.deps {
+			if changed[dep] {
+				dirty = true
+				break
+			}
+		}
+		if !dirty {
+			continue
+		}
+		if value := c.compute(); value != c.value {
+			c.value = value
+			changed[c] = true
+		}
+	}
+
+	for _, c := range r.cells {
+		if c.compute == nil || !changed[c] {
+			continue
+		}
+		callbacks := make([]*callbackEntry, len(c.callbacks))
+		copy(callbacks, c.callbacks)
+		for _, cb := range callbacks {
+			if cb.active {
+				cb.fn(c.value)
+			}
+		}
+	}
 }
