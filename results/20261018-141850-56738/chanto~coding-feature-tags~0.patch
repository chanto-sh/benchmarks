+    def test_add_normalizes_tags(self):
+        code, out, _ = run(
+            self.db, "add", "Buy milk", "--tag", "  Home ", "--tag", "ERRANDS", "--tag", "home"
+        )
+        self.assertEqual((code, out), (0, "added #1\n"))
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags(self):
+        for bad in ["", "   ", "bad tag", "a,b", "#hash"]:
+            code, _, err = run(self.db, "add", "x", "--tag", "ok", "--tag", bad)
+            self.assertEqual(code, 2, bad)
+            self.assertIn(bad, err)
+            self.assertFalse(os.path.exists(self.db), bad)
+
+    def test_list_with_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n  3  Plain\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  Buy milk  #home #errands\n  2  Call mom  #home\n")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "Errands")[1],
+            "  1  Buy milk  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "missing")[1], "")
+
+    def test_show_with_tags(self):
+        run(self.db, "add", "Buy milk", "--body", "2%", "--tag", "home", "--tag", "errands")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Buy milk\ntags: #home #errands\n\n2%\n",
+        )
+
+    def test_tags_counts(self):
+        run(self.db, "add", "a", "--tag", "home")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "c", "--tag", "zed")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\nerrands 1\nzed 1\n")
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "Buy milk")
+        code, _, _ = run(self.db, "tag", "1", " Home ", "ERRANDS", "home")
+        self.assertEqual(code, 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        self.assertEqual(run(self.db, "tag", "1", "home")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        self.assertEqual(run(self.db, "untag", "1", "HOME", "missing")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #errands\n")
