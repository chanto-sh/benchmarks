+		return errNegative
+	}
+	if pins > 10 {
+		return errExceedsPins
+	}
+	if g.frame >= 10 {
+		return errGameOver
+	}
+
+	if g.frame < 9 {
+		if len(g.frameRolls) == 1 && g.frameRolls[0]+pins > 10 {
