+	switch len(g.frameRolls) {
+	case 0:
+		// First roll, anything up to 10 is fine.
+	case 1:
+		if g.frameRolls[0] != 10 && g.frameRolls[0]+pins > 10 {
+			return errExceedsPins
+		}
+	case 2:
