+def test_template_option_with_custom_braces(linter) -> None:
+    """Test the msg-template option with escaped braces.
+
+    Escaped braces should be rendered as literal braces and should not be
+    mistaken for an unknown message field.
+    """
+    output = StringIO()
+    linter.reporter.out = output
+    linter.config.msg_template = '{{ "Category": "{category}" }}'
+    linter.open()
+    linter.set_current_module("my_module")
+    linter.add_message("C0301", line=1, args=(1, 2))
+
+    assert (
+        output.getvalue()
+        == '************* Module my_module\n{ "Category": "convention" }\n'
+    )
+
+
