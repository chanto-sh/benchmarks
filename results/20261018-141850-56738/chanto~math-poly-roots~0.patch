 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,24 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (10^7 x - 10^7)(10^7 x - (10^7 + 1))
+        a = 10**7
+        coeffs = [a * a, -a * (2 * a + 1), a * (a + 1)]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1e-7])
+
+    def test_roots_on_interval_boundaries(self):
+        # x^2 - 4 on intervals whose endpoints are roots
+        self.assertRoots(real_roots([1, 0, -4], -2, 2), [-2, 2])
+        self.assertRoots(real_roots([1, 0, -4], 0, 2), [2])
+        self.assertRoots(
+            real_roots([2, -1], Fraction(1, 2), 1), [Fraction(1, 2)]
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
