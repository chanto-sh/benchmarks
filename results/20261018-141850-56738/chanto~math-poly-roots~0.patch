+def _trim(poly):
+    """Drop leading zero coefficients."""
+    i = 0
+    while i < len(poly) and poly[i] == 0:
+        i += 1
+    return list(poly[i:])
+
+
+def _normalize(poly):
+    """Return an integer polynomial, scaled by a positive constant.
+
+    Scaling by a positive constant does not change signs, which matters for
+    the Sturm sequence.  Keeping the coefficients primitive prevents the
+    Euclidean remainders from growing unnecessarily.
+    """
+    poly = _trim([c if isinstance(c, Fraction) else Fraction(c) for c in poly])
+    if not poly:
+        return []
+
+    denominator = 1
+    for c in poly:
+        denominator = denominator * c.denominator // gcd(denominator, c.denominator)
+
+    ints = [c.numerator * (denominator // c.denominator) for c in poly]
+    content = 0
+    for c in ints:
+        content = gcd(content, abs(c))
+    if content:
+        ints = [c // content for c in ints]
+    return ints
+
+
+def _derivative(poly):
+    """Derivative of a highest-degree-first polynomial."""
+    if len(poly) <= 1:
+        return []
+    degree = len(poly) - 1
+    return [poly[i] * (degree - i) for i in range(degree)]
+
+
+def _divmod(a, b):
+    """Polynomial division over the rationals; highest degree first."""
+    a = _trim([c if isinstance(c, Fraction) else Fraction(c) for c in a])
+    b = _trim([c if isinstance(c, Fraction) else Fraction(c) for c in b])
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = a[:]
+    a_length = len(a)
+    while True:
+        r = _trim(r)
+        if len(r) < len(b):
+            break
+        factor = r[0] / b[0]
+        q[a_length - len(r)] = factor
+        for i, c in enumerate(b):
+            r[i] -= factor * c
+
+    return _trim(q), _trim(r)
+
+
+def _gcd(a, b):
+    """Monic-up-to-positive-scale gcd over the rationals."""
+    a = _normalize(a)
+    b = _normalize(b)
+    while b:
+        _, remainder = _divmod(a, b)
+        a, b = b, _normalize(remainder)
+    return _normalize(a)
+
+
+def _exact_div(a, b):
+    quotient, remainder = _divmod(a, b)
+    if _trim(remainder):
+        raise ArithmeticError("non-exact polynomial division")
+    return _normalize(quotient)
+
+
+def _square_free_part(poly):
+    """Product of the distinct irreducible factors of poly."""
+    derivative = _derivative(poly)
+    if not derivative:
+        return _normalize(poly)
+    common = _gcd(poly, derivative)
+    return _exact_div(poly, common)
+
+
+def _sturm_sequence(poly):
+    """A Sturm sequence for the square-free polynomial poly."""
+    sequence = [poly]
+    derivative = _normalize(_derivative(poly))
+    if not derivative:
+        return sequence
+    sequence.append(derivative)
+
+    while len(sequence[-1]) > 1:
+        _, remainder = _divmod(sequence[-2], sequence[-1])
+        remainder = _normalize([-c for c in remainder])
+        if not remainder:
+            break
+        sequence.append(remainder)
+    return sequence
+
+
+def _sign(poly, x):
+    """Exact sign of poly(x), evaluating with integer arithmetic."""
+    x = x if isinstance(x, Fraction) else Fraction(x)
+    numerator, denominator = x.numerator, x.denominator
+
+    # Horner's rule while keeping the value as num/den.
+    num = 0
+    den = 1
+    for c in poly:
+        num = num * numerator + c * den * denominator
+        den *= denominator
+    return (num > 0) - (num < 0)
+
+
+def _variations_at(sequence, x, side="at"):
+    """Sign variations at x.
+
+    side is "right" or "left" when x is an endpoint that may itself be a root.
+    Only the first polynomial in a Sturm sequence can vanish at such a root;
+    its one-sided sign is the sign of the derivative, negated on the left.
+    """
+    signs = []
+    for i, poly in enumerate(sequence):
+        sign = _sign(poly, x)
+        if sign == 0:
+            if i == 0 and side != "at":
+                derivative_sign = _sign(sequence[1], x)
+                sign = derivative_sign if side == "right" else -derivative_sign
+            else:
+                continue
+        signs.append(sign)
+
+    variations = 0
+    for i in range(1, len(signs)):
+        if signs[i] != signs[i - 1]:
+            variations += 1
+    return variations
+
+
+def _count_roots(sequence, a, b):
+    """Number of roots in the open interval (a, b)."""
+    return _variations_at(sequence, a, "right") - _variations_at(sequence, b, "left")
+
+
+_TOLERANCE = Fraction(1, 10**12)
+
+
+def _refine_single_root(sequence, a, b):
+    """Locate the unique root in (a, b)."""
+    left_variations = _variations_at(sequence, a, "right")
+
+    while b - a > _TOLERANCE:
+        midpoint = (a + b) / 2
+        if _sign(sequence[0], midpoint) == 0:
+            return midpoint
+
+        middle_variations = _variations_at(sequence, midpoint)
+        if left_variations - middle_variations > 0:
+            b = midpoint
+        else:
+            a = midpoint
+            left_variations = middle_variations
+
+    return (a + b) / 2
+
+
+def _isolate_roots(sequence, lo, hi, count):
+    """Isolate count distinct roots in (lo, hi)."""
+    roots = []
+    stack = [(lo, hi, count)]
+
+    while stack:
+        a, b, remaining = stack.pop()
+        if remaining <= 0:
+            continue
+
+        if remaining == 1:
+            roots.append(_refine_single_root(sequence, a, b))
+            continue
+
+        midpoint = (a + b) / 2
+        if _sign(sequence[0], midpoint) == 0:
+            # The split point is itself a root; the open subintervals exclude
+            # it, so it is recorded once and the counts partition the rest.
+            roots.append(midpoint)
+            left_count = _count_roots(sequence, a, midpoint)
+            right_count = _count_roots(sequence, midpoint, b)
+            if right_count:
+                stack.append((midpoint, b, right_count))
+            if left_count:
+                stack.append((a, midpoint, left_count))
+        else:
+            left_count = _variations_at(sequence, a, "right") - _variations_at(
+                sequence, midpoint
+            )
+            right_count = remaining - left_count
+            if right_count:
+                stack.append((midpoint, b, right_count))
+            if left_count:
+                stack.append((a, midpoint, left_count))
+
+    return roots
+
