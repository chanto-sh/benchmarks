+"""Tests for text_utils.slugify."""
+
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyTests(unittest.TestCase):
+    def test_documented_examples(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("!!!"), "")
+
+    def test_accents_are_folded(self):
+        self.assertEqual(slugify("naïve café"), "naive-cafe")
+        self.assertEqual(slugify("Añejo über"), "anejo-uber")
+
+    def test_separators_collapse_and_are_stripped(self):
+        self.assertEqual(slugify("---Hello...World---"), "hello-world")
+        self.assertEqual(slugify("foo/bar\tbaz\nqux"), "foo-bar-baz-qux")
+
+    def test_no_letters_or_digits(self):
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify("   "), "")
+        self.assertEqual(slugify("_-_"), "")
+
+    def test_digits_are_kept(self):
+        self.assertEqual(slugify("Python 3.12!"), "python-3-12")
+
+    def test_truncation_without_hyphen(self):
+        self.assertEqual(slugify("hello", max_length=3), "hel")
+
+    def test_truncation_at_hyphen_boundary(self):
+        self.assertEqual(slugify("hello-world", max_length=8), "hello")
+        self.assertEqual(slugify("hello-world", max_length=11), "hello-world")
+
+    def test_truncation_does_not_leave_trailing_hyphen(self):
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+        self.assertEqual(slugify("a b c", max_length=2), "a")
+
+    def test_truncation_to_zero_or_negative(self):
+        self.assertEqual(slugify("hello", max_length=0), "")
+        self.assertEqual(slugify("hello", max_length=-5), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
