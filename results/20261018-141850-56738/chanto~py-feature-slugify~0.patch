     """
-    raise NotImplementedError
+    if text is None:
+        text = ""
+
+    # Split accented characters into their base letter plus combining marks,
+    # then drop the marks so the base ASCII letter remains.
+    decomposed = unicodedata.normalize("NFKD", text)
+    base = "".join(char for char in decomposed if not unicodedata.combining(char))
+
+    slug = re.sub(r"[^a-z0-9]+", "-", base.lower()).strip("-")
+
+    if max_length is not None:
+        if max_length <= 0:
+            return ""
+        if len(slug) > max_length:
+            truncated = slug[:max_length]
+            # If truncation lands in the middle of a word, fall back to the
+            # previous hyphen boundary.
+            if slug[max_length] != "-" and "-" in truncated:
+                truncated = truncated.rsplit("-", 1)[0]
+            slug = truncated.rstrip("-")
+
+    return slug
