+    def _user_object(self, name):
+        user = self.users[name]
+        owes = dict(user["owes"])
+        owed_by = dict(user["owed_by"])
+        balance = sum(owed_by.values()) - sum(owes.values())
+        return {
+            "name": name,
+            "owes": owes,
+            "owed_by": owed_by,
+            "balance": balance,
+        }
+
+    def _set_debt(self, debtor, creditor, amount):
+        debtor_user = self.users[debtor]
+        creditor_user = self.users[creditor]
+
+        if amount > 0:
+            debtor_user["owes"][creditor] = amount
+            creditor_user["owed_by"][debtor] = amount
+        else:
+            debtor_user["owes"].pop(creditor, None)
+            creditor_user["owed_by"].pop(debtor, None)
+
+    def _get_debt(self, debtor, creditor):
+        return self.users[debtor]["owes"].get(creditor, 0.0)
 
