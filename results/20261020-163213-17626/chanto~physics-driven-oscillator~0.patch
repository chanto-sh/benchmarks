 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _natural_frequency(m, k):
+    return math.sqrt(k / m)
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    if F0 == 0.0:
+        return 0.0
+
+    wn = _natural_frequency(m, k)
+    # (wn - omega) * (wn + omega) is more accurate than wn**2 - omega**2
+    # when the drive is close to resonance.
+    stiffness = m * (wn - omega) * (wn + omega)
+    damping = c * omega
+    denom = math.hypot(stiffness, damping)
+    if denom == 0.0:
+        # Undamped drive exactly at the natural frequency: no finite
+        # steady-state amplitude exists.
+        return math.inf
+    return F0 / denom
+
+
+def _homogeneous(m, c, k, x0, v0, t):
+    """Solution of m x'' + c x' + k x = 0 with x(0) = x0, x'(0) = v0."""
+    alpha = c / (2.0 * m)
+    wn = _natural_frequency(m, k)
+
+    if alpha < wn:
+        # Underdamped (this includes c == 0).
+        wd = math.sqrt((wn - alpha) * (wn + alpha))
+        z = wd * t
+        sinc = 1.0 if z == 0.0 else math.sin(z) / z
+        return math.exp(-alpha * t) * (
+            x0 * math.cos(z) + (v0 + alpha * x0) * t * sinc
+        )
+
+    if alpha == wn:
+        # Critically damped.
+        return (x0 + (v0 + alpha * x0) * t) * math.exp(-alpha * t)
+
+    # Overdamped.  Write the two exponentials through mu = sqrt(alpha^2-wn^2)
+    # and use small-argument forms for sinh to avoid cancellation near the
+    # critically damped limit.
+    mu = math.sqrt((alpha - wn) * (alpha + wn))
+    z = mu * t
+    if abs(z) < 1.0:
+        sh_over_z = 1.0 if z == 0.0 else math.sinh(z) / z
+        return math.exp(-alpha * t) * (
+            x0 * math.cosh(z) + (v0 + alpha * x0) * t * sh_over_z
+        )
+
+    # For large z, evaluate exp(-alpha*t)*cosh(mu*t) as the sum of two
+    # decaying exponentials so that cosh cannot overflow.  Computing
+    # mu - alpha this way avoids cancellation for strong damping.
+    e1 = math.exp(-wn * wn / (alpha + mu) * t)
+    e2 = math.exp(-(mu + alpha) * t)
+    return (
+        0.5 * x0 * (e1 + e2)
+        + 0.5 * (v0 + alpha * x0) / mu * (e1 - e2)
+    )
 
 
