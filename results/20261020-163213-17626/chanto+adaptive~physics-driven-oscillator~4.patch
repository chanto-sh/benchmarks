+
+    if discriminant > 0.0:
+        # Overdamped: the two real roots, with the root closer to zero
+        # computed in a cancellation-free form.
+        sqrt_disc = math.sqrt(discriminant)
+        r1 = -2.0 * k / (c + sqrt_disc)
+        r2 = (-c - sqrt_disc) / (2.0 * m)
