 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return (a_cos, a_sin, scale) for the particular solution.
+
+    The particular solution is a_cos*cos(omega*t) + a_sin*sin(omega*t),
+    and scale is sqrt((k - m*omega**2)**2 + (c*omega)**2).
+    """
+    residual = math.fsum((k, -(m * omega) * omega))
+    damping = c * omega
+    scale = math.hypot(residual, damping)
+    if scale == 0.0:
+        raise ValueError("undamped oscillator driven exactly at resonance")
+
+    # Divide in two steps so that a very small scale does not underflow
+    # when it is squared.
+    return F0 * (residual / scale) / scale, F0 * (damping / scale) / scale, scale
+
 
