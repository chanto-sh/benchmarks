 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with the removable singularity at zero handled."""
+    if abs(x) < 1e-8:
+        return 1.0 - x * x / 6.0
+    return math.sin(x) / x
+
+
+def _sinhc(x):
+    """sinh(x) / x, with the removable singularity at zero handled."""
+    if abs(x) < 1e-8:
+        return 1.0 + x * x / 6.0
+    return math.sinh(x) / x
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return P, Q for the particular solution P cos(omega t) + Q sin(omega t)."""
+    d = k - m * omega * omega
+    cw = c * omega
+    denom = d * d + cw * cw
+    return F0 * d / denom, F0 * cw / denom
+
+
+def _series_displacement(m, k, c, F0, omega, x0, v0, t):
+    """Evaluate x(t) by its Taylor series about t = 0.
+
+    This avoids cancellation between very large steady-state and transient
+    terms when the driving frequency is close to resonance and t is small.
+    """
+    a = c / (2.0 * m)
+    wn2 = k / m
+    f = F0 / m
+    order = 100
+
+    coeff = [0.0] * (order + 1)
+    coeff[0] = x0
+    coeff[1] = v0
+
+    fn, fn_next = f, 0.0
+    for n in range(order - 1):
+        coeff[n + 2] = (
+            fn - 2.0 * a * (n + 1) * coeff[n + 1] - wn2 * coeff[n]
+        ) / ((n + 2) * (n + 1))
+        fn, fn_next = fn_next, -fn * omega * omega / ((n + 1) * (n + 2))
+
+    value = coeff[order]
+    for n in range(order - 1, -1, -1):
+        value = value * t + coeff[n]
+    return value
+
 
