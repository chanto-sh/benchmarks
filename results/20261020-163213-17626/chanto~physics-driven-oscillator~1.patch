 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with the removable singularity at x = 0 handled stably."""
+    if x == 0.0:
+        return 1.0
+    ax = abs(x)
+    if ax < 1e-4:
+        x2 = x * x
+        return 1.0 - x2 / 6.0 + x2 * x2 / 120.0 - x2 * x2 * x2 / 5040.0
+    return math.sin(x) / x
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return (A, B, amplitude) for x_p = A cos(omega t) + B sin(omega t)."""
+    omega0 = math.sqrt(k / m)
+    delta = m * (omega0 - omega) * (omega0 + omega)
+    drive = c * omega
+    scale = math.hypot(delta, drive)
+    if scale == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0, 0.0
+        raise ValueError("undamped oscillator driven exactly at resonance")
+
+    cos_phi = delta / scale
+    sin_phi = drive / scale
+    amp = F0 / scale
+    return amp * cos_phi, amp * sin_phi, amp
+
 
