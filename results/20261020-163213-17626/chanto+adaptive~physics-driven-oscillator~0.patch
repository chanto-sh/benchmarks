+
+    if discriminant < 0.0:
+        # Underdamped (including the undamped case c = 0).
+        omega_d = math.sqrt(-discriminant)
+        z = omega_d * t
+        y = math.exp(-alpha * t) * (y0 * math.cos(z) + s * t * _sinc(z))
+    elif discriminant == 0.0:
