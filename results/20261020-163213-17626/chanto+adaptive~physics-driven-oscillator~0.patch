 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(z):
+    """sin(z) / z, with its continuous value at z = 0."""
+    if z == 0.0:
+        return 1.0
+    return math.sin(z) / z
+
+
+def _sinhc(z):
+    """sinh(z) / z, with its continuous value at z = 0."""
+    if z == 0.0:
+        return 1.0
+    return math.sinh(z) / z
+
+
+def _detuning(m, k, omega):
+    """k - m*omega**2, computed accurately when the two terms nearly cancel."""
+    if hasattr(math, "fma"):
+        p = m * omega
+        p_error = math.fma(m, omega, -p)
+        q = p * omega
+        q_error = math.fma(p, omega, -q)
+        return math.fsum((k, -q, -q_error, -(p_error * omega)))
+    return k - m * omega * omega
+
+
+def _steady_coefficients(m, k, c, F0, omega):
+    """Return (amplitude, A, B) for the steady state A cos(wt) + B sin(wt)."""
+    detuning = _detuning(m, k, omega)
+    damping = c * omega
+    denominator = math.hypot(detuning, damping)
+
+    amplitude = F0 / denominator
+    A = amplitude * detuning / denominator
+    B = amplitude * damping / denominator
+    return amplitude, A, B
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    amp, _, _ = _steady_coefficients(m, k, c, F0, omega)
+    return abs(amp)
 
 
 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    if t == 0.0:
