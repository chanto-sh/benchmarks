 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+_fma = getattr(math, "fma", None)
+
+
+def _detuning(m, k, omega):
+    """Return k - m*omega**2, with reduced cancellation where possible."""
+    if _fma is None:
+        return k - m * omega * omega
+
+    # form m*omega exactly as p + error, then evaluate k - (p + error)*omega
+    p = m * omega
+    error = _fma(m, omega, -p)
+    return _fma(-error, omega, _fma(-p, omega, k))
+
+
+def _steady_coefficients(m, k, c, F0, omega):
+    """Return C, S such that C*cos(omega*t) + S*sin(omega*t) is particular."""
+    d = _detuning(m, k, omega)
+    cw = c * omega
+    scale = math.hypot(d, cw)
+    if scale == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0
+        raise ValueError("undamped oscillator driven exactly at resonance")
+
+    amplitude = F0 / scale
+    return amplitude * (d / scale), amplitude * (cw / scale)
+
 
