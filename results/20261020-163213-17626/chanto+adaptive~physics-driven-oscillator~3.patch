+    h0 = x0 - particular0
+    hv0 = v0 - particular_velocity0
+
+    alpha = c / (2.0 * m)
+    # kappa = 4*m*k - c**2: positive, zero, or negative determines the
+    # underdamped, critically damped, or overdamped regime.
+    if _fma is None:
+        kappa = 4.0 * m * k - c * c
+    else:
+        product = 4.0 * m * k
+        product_error = _fma(4.0 * m, k, -product)
+        kappa = _fma(-c, c, product) + product_error
+
+    if kappa > 0.0:
+        omega_d = math.sqrt(kappa) / (2.0 * m)
+        z = omega_d * t
+        # Use sin(z)/z rather than dividing by omega_d, which is stable as the
+        # damping approaches the critically damped limit.
+        sinc = 1.0 if z == 0.0 else math.sin(z) / z
+        transient = math.exp(-alpha * t) * (
