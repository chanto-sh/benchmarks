 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _coefficients(m, k, c, omega):
+    """Return (D, alpha, beta) for k - m omega^2 + i c omega."""
+    alpha = k - m * omega * omega
+    beta = c * omega
+    return math.hypot(alpha, beta), alpha, beta
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    D, _, _ = _coefficients(m, k, c, omega)
+    return abs(F0) / D
+
+
+def _homogeneous_basis(p, w0, t):
+    """Return h1, h2 such that the free motion is x0*h1 + (v0 + p*x0)*h2."""
+    delta = (p - w0) * (p + w0)
+
+    if delta < 0.0:
+        # Underdamped: e^(-p t) cos(wd t), e^(-p t) sin(wd t) / wd
+        wd = math.sqrt(-delta)
+        z = wd * t
+        decay = math.exp(-p * t)
+        h1 = decay * math.cos(z)
+        if z == 0.0:
+            sinc = 1.0
+        elif abs(z) < 1e-4:
+            z2 = z * z
+            sinc = 1.0 - z2 / 6.0 + z2 * z2 / 120.0
+        else:
+            sinc = math.sin(z) / z
+        h2 = decay * t * sinc
+    elif delta > 0.0:
+        # Overdamped: e^(-p t) cosh(q t), e^(-p t) sinh(q t) / q
+        q = math.sqrt(delta)
+        z = q * t
+        r1 = -p + q
+        r2 = -p - q
+        e1 = math.exp(r1 * t)
+        e2 = math.exp(r2 * t)
+        h1 = 0.5 * (e1 + e2)
+
+        if z < 0.5:
+            # Stable form near q = 0, where this tends to t*exp(-p*t).
+            if z < 1e-4:
+                z2 = z * z
+                sinh_over_z = 1.0 + z2 / 6.0 + z2 * z2 / 120.0
+            else:
+                sinh_over_z = math.sinh(z) / z
+            h2 = math.exp(-p * t) * t * sinh_over_z
+        else:
+            # Stable for large q*t: avoid overflowing exp(+q*t).
+            h2 = e1 * (-math.expm1(-2.0 * z)) / (2.0 * q)
+    else:
+        # Critically damped: e^(-p t), t e^(-p t)
+        decay = math.exp(-p * t)
+        h1 = decay
+        h2 = t * decay
+
+    return h1, h2
 
 
