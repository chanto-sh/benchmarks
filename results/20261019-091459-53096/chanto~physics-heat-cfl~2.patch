+    if nx <= 2 or alpha == 0 or t_end <= 0:
+        return u
+
+    dx = length / (nx - 1)
+    if dx == 0:
+        return u
+
+    # The explicit scheme is stable only when r = alpha*dt/dx^2 <= 1/2.
+    # Use that largest stable step, then split t_end into equal steps so the
+    # final profile is at exactly t_end.
+    dt_max = 0.5 * dx * dx / alpha
+    steps = max(1, math.ceil(t_end / dt_max))
+    dt = t_end / steps
+    r = alpha * dt / (dx * dx)
+    # Guard against r creeping just above 1/2 through floating-point rounding.
+    while r > 0.5:
+        steps += 1
+        dt = t_end / steps
         r = alpha * dt / (dx * dx)
+
+    for _ in range(steps):
         u = [u[0]] + [u[i] + r * (u[i - 1] - 2 * u[i] + u[i + 1]) for i in range(1, nx - 1)] + [u[-1]]
     return u
