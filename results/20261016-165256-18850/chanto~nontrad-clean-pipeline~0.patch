+#!/usr/bin/env python3
+"""Clean a customer export.
+
+Usage:
+    python3 clean.py <input.csv> <output.csv>
+"""
+
+import csv
+import os
+import re
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+HEADER = ["customer_id", "name", "email", "signup_date", "country", "spend"]
+
+ALIASES_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "country_aliases.csv")
+
+DIGITS_RE = re.compile(r"[0-9]+")
+ISO_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+DMY_RE = re.compile(r"([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})")
+MONTH_RE = re.compile(r"([A-Za-z]{3})\s+([0-9]{1,2})\s*,\s*([0-9]{4})")
+SPEND_RE = re.compile(r"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)")
+
+MONTHS = {
+    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
+    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12,
+}
+
+
+def load_country_aliases(path):
+    aliases = {}
+    with open(path, newline="", encoding="utf-8-sig") as fh:
+        reader = csv.reader(fh)
+        rows = list(reader)
+    for i, row in enumerate(rows):
+        if not row:
+            continue
+        alias = row[0].strip().lower()
+        code = row[1].strip() if len(row) > 1 else ""
+        if i == 0 and alias == "alias":
+            continue
+        if alias:
+            aliases[alias] = code
+    return aliases
+
+
+def parse_customer_id(raw):
+    s = raw.strip()
+    if not DIGITS_RE.fullmatch(s):
+        return None
+    return int(s)
+
+
+def parse_name(raw):
+    return " ".join(raw.split())
+
+
+def parse_email(raw):
+    s = raw.strip().lower()
+    if s.count("@") != 1:
+        return None
+    local, _, domain = s.partition("@")
+    if not local:
+        return None
+    if "." not in domain or domain.startswith(".") or domain.endswith("."):
+        return None
+    return s
+
+
+def parse_date(raw):
+    s = raw.strip()
+    m = ISO_RE.fullmatch(s)
+    if m:
+        y, mo, d = (int(g) for g in m.groups())
+        return _make_date(y, mo, d)
+    m = DMY_RE.fullmatch(s)
+    if m:
+        d, mo, y = (int(g) for g in m.groups())
+        return _make_date(y, mo, d)
+    m = MONTH_RE.fullmatch(s)
+    if m:
+        mon = MONTHS.get(m.group(1).lower())
+        if mon is None:
+            return None
+        return _make_date(int(m.group(3)), mon, int(m.group(2)))
+    return None
+
+
+def _make_date(year, month, day):
+    try:
+        return date(year, month, day)
+    except ValueError:
+        return None
+
+
+def parse_country(raw, aliases):
+    return aliases.get(raw.strip().lower(), "")
+
+
+def parse_spend(raw):
+    s = raw.strip()
+    if s == "":
+        return Decimal("0.00")
+    s = s.replace("$", "").replace(",", "").strip()
+    if not SPEND_RE.fullmatch(s):
+        return None
+    try:
+        value = Decimal(s)
+    except InvalidOperation:
+        return None
+    if not value.is_finite():
+        return None
+    q = value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    if q == 0:
+        q = Decimal("0.00")
+    return q
+
+
+def clean(input_path, output_path):
+    aliases = load_country_aliases(ALIASES_PATH)
+
+    with open(input_path, newline="", encoding="utf-8-sig") as fh:
+        rows = list(csv.reader(fh))
+
+    if rows:
+        first = [c.strip().lower() for c in rows[0]]
+        if first[: len(HEADER)] == HEADER:
+            rows = rows[1:]
+
+    kept = {}
+    for row in rows:
+        if len(row) != len(HEADER):
+            continue
+        customer_id = parse_customer_id(row[0])
+        if customer_id is None:
+            continue
+        email = parse_email(row[2])
+        if email is None:
+            continue
+        signup = parse_date(row[3])
+        if signup is None:
+            continue
+        spend = parse_spend(row[5])
+        if spend is None:
+            continue
+        record = [
+            str(customer_id),
+            parse_name(row[1]),
+            email,
+            signup.isoformat(),
+            parse_country(row[4], aliases),
+            str(spend),
+        ]
+        prev = kept.get(customer_id)
+        if prev is None or signup >= prev[0]:
+            kept[customer_id] = (signup, record)
+
+    out_rows = sorted((v[1] for v in kept.values()), key=lambda r: int(r[0]))
+
+    with open(output_path, "w", newline="", encoding="utf-8") as fh:
+        writer = csv.writer(fh, lineterminator="\n")
+        writer.writerow(HEADER)
+        writer.writerows(out_rows)
+
+
+def main(argv):
+    if len(argv) != 3:
+        sys.stderr.write("usage: python3 clean.py <input.csv> <output.csv>\n")
+        return 2
+    clean(argv[1], argv[2])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
