+fn expand_codon(codon: &str) -> Result<Vec<String>, Error> {
+    let mut expanded = vec![String::new()];
+
+    for base in codon.bytes() {
+        let possibilities = match base {
+            b'A' => "A",
+            b'C' => "C",
+            b'G' => "G",
+            b'T' => "T",
+            b'R' => "AG",
+            b'Y' => "CT",
+            b'S' => "CG",
+            b'W' => "AT",
+            b'K' => "GT",
+            b'M' => "AC",
+            b'B' => "CGT",
+            b'D' => "AGT",
+            b'H' => "ACT",
+            b'V' => "ACG",
+            b'N' => "ACGT",
+            _ => return Err(Error),
+        };
+
+        let mut next = Vec::with_capacity(expanded.len() * possibilities.len());
+        for prefix in &expanded {
+            for possibility in possibilities.bytes() {
+                let mut codon = prefix.clone();
+                codon.push(possibility as char);
+                next.push(codon);
+            }
+        }
+        expanded = next;
+    }
+
+    Ok(expanded)
 }
