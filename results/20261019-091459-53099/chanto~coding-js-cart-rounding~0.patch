index 0000000..96201a5
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,101 @@
+// Exact decimal arithmetic for money. A value is a fraction { num, den } of
+// dollars, with BigInt terms, so intermediate results never pick up binary
+// floating-point error.
+
+const ZERO = { num: 0n, den: 1n };
+const ONE_HUNDRED = { num: 100n, den: 1n };
+
+function gcd(a, b) {
+  if (a < 0n) a = -a;
+  while (b !== 0n) {
+    const t = a % b;
+    a = b;
+    b = t;
+  }
+  return a;
+}
+
+function normalize(num, den) {
+  if (den === 0n) throw new RangeError("division by zero");
+  if (den < 0n) {
+    num = -num;
+    den = -den;
+  }
+  if (num === 0n) return ZERO;
+  const g = gcd(num, den);
+  return { num: num / g, den: den / g };
+}
+
+// Parse a decimal string/number (optionally with an exponent) exactly.
+function fraction(value) {
+  if (value && typeof value === "object" && "num" in value && "den" in value) {
+    return normalize(BigInt(value.num), BigInt(value.den));
+  }
+  const s = typeof value === "number" ? String(value) : String(value).trim();
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!m || (m[2] === "" && (m[3] === undefined || m[3] === ""))) {
+    throw new TypeError(`not a decimal number: ${value}`);
+  }
+  const sign = m[1] === "-" ? -1n : 1n;
+  const intPart = m[2] || "";
+  const fracPart = m[3] || "";
+  let num = BigInt((intPart + fracPart) || "0") * sign;
+  let scale = fracPart.length - (m[4] ? Number(m[4]) : 0);
+  if (scale < 0) {
+    num *= 10n ** BigInt(-scale);
+    scale = 0;
+  }
+  return normalize(num, 10n ** BigInt(scale));
+}
+
+function add(a, b) {
+  return normalize(a.num * b.den + b.num * a.den, a.den * b.den);
+}
+
+function sub(a, b) {
+  return normalize(a.num * b.den - b.num * a.den, a.den * b.den);
+}
+
+function mul(a, b) {
+  return normalize(a.num * b.num, a.den * b.den);
+}
+
+function div(a, b) {
+  return normalize(a.num * b.den, a.den * b.num);
+}
+
+// Round a dollar value to whole cents, half away from zero ("half up" for the
+// non-negative amounts a cart uses). Returns a BigInt number of cents.
+function roundHalfUpToCents(value) {
+  const scaled = value.num * 100n;
+  const negative = scaled < 0n;
+  const magnitude = negative ? -scaled : scaled;
+  let cents = magnitude / value.den;
+  if ((magnitude % value.den) * 2n >= value.den) cents += 1n;
+  return negative ? -cents : cents;
+}
+
+function fromCents(cents) {
+  return normalize(BigInt(cents), 100n);
+}
+
+function formatCents(cents) {
+  const negative = cents < 0n;
+  const magnitude = negative ? -cents : cents;
+  const dollars = magnitude / 100n;
+  const rest = magnitude % 100n;
+  return `${negative ? "-" : ""}${dollars}.${rest.toString().padStart(2, "0")}`;
+}
+
+module.exports = {
+  ZERO,
+  ONE_HUNDRED,
+  fraction,
+  add,
+  sub,
+  mul,
+  div,
+  roundHalfUpToCents,
+  fromCents,
+  formatCents,
+};
