diff --git a/changelog/7168.bugfix.rst b/changelog/7168.bugfix.rst
new file mode 100644
index 0000000..8dd405c
--- /dev/null
+++ b/changelog/7168.bugfix.rst
@@ -0,0 +1 @@
+Fix crash when an object's ``__repr__`` raises and the object's ``__getattribute__`` is also broken, by using ``type(obj)`` instead of ``obj.__class__`` when generating the failure representation.
diff --git a/src/_pytest/_io/saferepr.py b/src/_pytest/_io/saferepr.py
index 23af4d0..47a00de 100644
--- a/src/_pytest/_io/saferepr.py
+++ b/src/_pytest/_io/saferepr.py
@@ -20,7 +20,7 @@ def _format_repr_exception(exc: BaseException, obj: Any) -> str:
     except BaseException as exc:
         exc_info = "unpresentable exception ({})".format(_try_repr_or_str(exc))
     return "<[{} raised in repr()] {} object at 0x{:x}>".format(
-        exc_info, obj.__class__.__name__, id(obj)
+        exc_info, type(obj).__name__, id(obj)
     )
 
 
