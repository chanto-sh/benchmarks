diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..50a661a
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,43 @@
+// Exact decimal helpers. Money is handled as integer cents so rounding
+// happens once, explicitly, and binary floating point cannot shift a half cent.
+const DECIMAL = /^([+-]?)(\d+)(?:\.(\d+))?$/;
+
+function parseDecimal(value) {
+  const s = typeof value === "string" ? value.trim() : String(value);
+  const match = DECIMAL.exec(s);
+  if (!match) throw new RangeError(`Invalid decimal value: ${value}`);
+  const fraction = match[3] || "";
+  return {
+    negative: match[1] === "-",
+    units: BigInt(match[2] + fraction),
+    scale: fraction.length,
+  };
+}
+
+// Round num/den (den > 0) to the nearest integer, halves away from zero.
+function roundHalfUp(num, den) {
+  const negative = num < 0n;
+  const abs = negative ? -num : num;
+  const rounded = (2n * abs + den) / (2n * den);
+  return negative ? -rounded : rounded;
+}
+
+// Parse a decimal money value into integer cents. Extra precision is rounded
+// half up, since prices on a receipt are expressed in cents.
+function toCents(value) {
+  const { negative, units, scale } = parseDecimal(value);
+  const shift = scale - 2;
+  const cents = shift <= 0
+    ? units * 10n ** BigInt(-shift)
+    : roundHalfUp(units, 10n ** BigInt(shift));
+  return Number(negative ? -cents : cents);
+}
+
+// `pct` percent of `cents`, rounded half up to whole cents.
+function percentOfCents(cents, pct) {
+  const { negative, units, scale } = parseDecimal(pct);
+  const num = BigInt(cents) * (negative ? -units : units);
+  return Number(roundHalfUp(num, 100n * 10n ** BigInt(scale)));
+}
+
+module.exports = { toCents, percentOfCents };
