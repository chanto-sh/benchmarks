+// Format integer cents as a "1234.50" string.
+function fmtCents(cents) {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const whole = abs / 100n;
+  const frac = (abs % 100n).toString().padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${frac}`;
+}
+
+module.exports = { fmt, fmtCents };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..de206d0
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,46 @@
+// Exact money helpers. Amounts are integer cents (BigInt) so rounding never
+// depends on binary floating-point error.
+
+function pow10(n) {
+  return 10n ** BigInt(n);
+}
+
+// Parse a decimal value into an exact fraction { num, den }.
+function toFraction(value) {
+  const s = String(value).trim();
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!m || (m[2] === "" && !m[3])) {
+    throw new TypeError(`Invalid number: ${value}`);
+  }
+  const sign = m[1] === "-" ? -1n : 1n;
+  const intPart = m[2] || "";
+  const fracPart = m[3] || "";
+  const exponent = m[4] ? Number(m[4]) : 0;
+  const scale = fracPart.length - exponent;
+  let num = sign * BigInt((intPart + fracPart) || "0");
+  let den = 1n;
+  if (scale >= 0) den = pow10(scale);
+  else num *= pow10(-scale);
+  return { num, den };
+}
+
+// Round num / den to the nearest integer, halves away from zero.
+function roundHalfUp(num, den) {
+  if (num < 0n) return -roundHalfUp(-num, den);
+  return (2n * num + den) / (2n * den);
+}
+
+// Parse a dollar amount into integer cents, rounded half up if it has more
+// than two decimal places.
+function toCents(value) {
+  const { num, den } = toFraction(value);
+  return roundHalfUp(num * 100n, den);
+}
+
+// Round `pct` percent of an integer-cent amount to whole cents.
+function percentOf(amountCents, pct) {
+  const { num, den } = toFraction(pct);
+  return roundHalfUp(amountCents * num, den * 100n);
+}
+
+module.exports = { toFraction, roundHalfUp, toCents, percentOf };
