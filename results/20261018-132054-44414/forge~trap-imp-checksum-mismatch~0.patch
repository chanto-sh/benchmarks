--- a/verify.py
+++ b/verify.py
@@ -13,13 +13,18 @@ def verify(manifest, root):
             if not line.strip():
                 continue
             expected, name = line.split()
+            # sha256sum(1) marks binary mode with a leading '*'.
+            name = name.lstrip("*")
             path = os.path.join(root, name)
             if not os.path.exists(path):
                 bad.append(name)
                 continue
-            with open(path) as a:
-                digest = hashlib.sha256(a.read().encode()).hexdigest()
-            if digest != expected:
+            # Hash the raw bytes: text mode would decode the payload and
+            # normalise newlines, yielding the wrong digest for binaries.
+            with open(path, "rb") as a:
+                digest = hashlib.sha256(a.read()).hexdigest()
+            # Hex digests are case-insensitive; manifests often use uppercase.
+            if digest != expected.lower():
                 bad.append(name)
     return sorted(bad)
 
