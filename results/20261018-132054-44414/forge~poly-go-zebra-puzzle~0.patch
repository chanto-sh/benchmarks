+	zebra
+)
+
+var nationalities = [houseCount]string{
+	"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese",
+}
+
+// SolvePuzzle determines, from the fifteen facts of the zebra puzzle, who
+// drinks water and who owns the zebra.
+//
+// Each category (nationality, color, drink, smoke, pet) is a permutation of
+// the five houses, encoded as an array where the position is the category
+// member and the value is the house it occupies. Categories are assigned one
+// at a time, and every constraint is checked as soon as the last of the
+// categories it mentions has been fixed. This prunes the search well before
+// the full 5!^5 space is explored.
 func SolvePuzzle() Solution {
-	panic("Please implement the SolvePuzzle function")
+	var nat, col, drk, smk, pet [houseCount]int
+	var solution Solution
+
+	// Fact 10: the Norwegian lives in the first house (index 0).
+	permutations(func(p []int) bool {
+		copy(nat[:], p)
+		if nat[norwegian] != 0 {
+			return false
+		}
+
+		return permutations(func(p []int) bool {
+			copy(col[:], p)
+
+			// Fact 6: green is immediately to the right of ivory.
+			if col[green] != col[ivory]+1 {
+				return false
+			}
+			// Fact 2: the Englishman lives in the red house.
+			if nat[englishman] != col[red] {
+				return false
+			}
+			// Fact 15: the Norwegian lives next to the blue house.
+			if !adjacent(nat[norwegian], col[blue]) {
+				return false
+			}
+
+			return permutations(func(p []int) bool {
+				copy(drk[:], p)
+
+				// Fact 9: milk is drunk in the middle house.
+				if drk[milk] != 2 {
+					return false
+				}
+				// Fact 4: coffee is drunk in the green house.
+				if drk[coffee] != col[green] {
+					return false
+				}
+				// Fact 5: the Ukrainian drinks tea.
+				if nat[ukrainian] != drk[tea] {
+					return false
+				}
+
+				return permutations(func(p []int) bool {
+					copy(smk[:], p)
+
+					// Fact 8: Kools are smoked in the yellow house.
+					if smk[kools] != col[yellow] {
+						return false
+					}
+					// Fact 14: the Japanese smokes Parliaments.
+					if nat[japanese] != smk[parliaments] {
+						return false
+					}
+					// Fact 13: the Lucky Strike smoker drinks orange juice.
+					if smk[luckyStrike] != drk[orangeJuice] {
+						return false
+					}
+
+					return permutations(func(p []int) bool {
+						copy(pet[:], p)
+
+						// Fact 3: the Spaniard owns the dog.
+						if pet[dog] != nat[spaniard] {
+							return false
+						}
+						// Fact 7: the Old Gold smoker owns snails.
+						if pet[snails] != smk[oldGold] {
+							return false
+						}
+						// Fact 11: Chesterfields is next to the fox.
+						if !adjacent(smk[chesterfields], pet[fox]) {
+							return false
+						}
+						// Fact 12: Kools is next to the horse.
+						if !adjacent(smk[kools], pet[horse]) {
+							return false
+						}
+
+						solution = Solution{
+							DrinksWater: occupant(nat, drk[water]),
+							OwnsZebra:   occupant(nat, pet[zebra]),
+						}
+						return true
+					})
+				})
+			})
+		})
+	})
+
+	return solution
+}
+
+// permutations calls f with every permutation of the houses {0, 1, 2, 3, 4}.
+// It stops as soon as f reports that a solution has been found.
+func permutations(f func([]int) bool) bool {
+	p := []int{0, 1, 2, 3, 4}
+
+	var generate func(k int) bool
+	generate = func(k int) bool {
+		if k == len(p) {
+			return f(p)
+		}
+		for i := k; i < len(p); i++ {
+			p[k], p[i] = p[i], p[k]
+			if generate(k + 1) {
+				return true
+			}
+			p[k], p[i] = p[i], p[k]
+		}
+		return false
+	}
+
+	return generate(0)
+}
+
+// adjacent reports whether two houses are next to each other.
+func adjacent(a, b int) bool {
+	d := a - b
+	return d == 1 || d == -1
+}
+
+// occupant returns the nationality of the person living in the given house.
+func occupant(nat [houseCount]int, house int) string {
+	for nationality, home := range nat {
+		if home == house {
+			return nationalities[nationality]
+		}
+	}
+	return ""
 }
