+	water
+)
+
+// Indexes into the smokes slice.
+const (
+	oldGold = iota
+	kools
+	chesterfields
+	luckyStrike
+	parliaments
+)
+
+// Indexes into the pets slice.
+const (
+	dog = iota
+	snails
+	fox
