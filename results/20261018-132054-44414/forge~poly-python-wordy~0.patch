+"""Parse and evaluate simple math word problems, left-to-right."""
+
+_PREFIX = "what is"
+
+
+def _divide(x, y):
+    """Integer division truncating toward zero."""
+    quotient = abs(x) // abs(y)
+    return -quotient if (x < 0) != (y < 0) else quotient
+
+
+_BINARY_OPS = {
+    "plus": lambda x, y: x + y,
+    "minus": lambda x, y: x - y,
+    "multiplied": lambda x, y: x * y,
+    "divided": _divide,
+}
+
+
+def _tokenize(text):
+    """Split the question body into numbers and operations.
+
+    Raises ValueError("unknown operation") for words outside the vocabulary
+    and ValueError("syntax error") for malformed multi-word operations.
+    """
+    tokens = []
+    words = text.split()
+    index = 0
+    while index < len(words):
+        word = words[index]
+        if word in ("multiplied", "divided"):
+            if index + 1 >= len(words) or words[index + 1] != "by":
+                raise ValueError("syntax error")
+            tokens.append(word)
+            index += 2
+            continue
+        if word in ("plus", "minus"):
+            tokens.append(word)
+            index += 1
+            continue
+        if word == "by":
+            raise ValueError("syntax error")
+        try:
+            tokens.append(int(word))
+        except ValueError:
+            raise ValueError("unknown operation")
+        index += 1
+    return tokens
+
+
