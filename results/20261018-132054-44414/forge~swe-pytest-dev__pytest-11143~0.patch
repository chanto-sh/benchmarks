+    @pytest.mark.parametrize("literal", ["1", "1.5", "b'bytes'", "None", "True"])
+    def test_non_string_first_statement_is_not_docstring(self, literal: str) -> None:
+        """Regression test for #11143: non-string constants are not docstrings."""
+        s = f"{literal}\nassert 14"
+        m = rewrite(s)
+        # The injected imports must come before the constant expression.
+        assert isinstance(m.body[0], ast.Import)
+        assert isinstance(m.body[1], ast.Import)
+        assert isinstance(m.body[2], ast.Expr)
+        assert isinstance(m.body[2].value, ast.Constant)
