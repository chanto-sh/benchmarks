+
+// equal reports whether a and b hold the same values in the same order.
+func equal(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// contains reports whether haystack contains needle as a contiguous sub-sequence.
+// An empty needle is always contained.
+func contains(haystack, needle []int) bool {
+	if len(needle) == 0 {
+		return true
+	}
+	for i := 0; i+len(needle) <= len(haystack); i++ {
+		if equal(haystack[i:i+len(needle)], needle) {
+			return true
+		}
+	}
+	return false
 }
