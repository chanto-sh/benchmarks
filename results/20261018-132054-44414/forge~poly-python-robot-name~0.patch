+import random
+import string
+
+
 class Robot:
+    """A robot that gets a unique random name when first turned on."""
+
+    # Names currently held by existing robots, used to prevent collisions.
+    _used_names = set()
+
     def __init__(self):
-        pass
+        self._name = None
+        self._previous_name = None
+
+    @property
+    def name(self):
+        if self._name is None:
+            self._name = self._generate_name()
+        return self._name
+
+    def reset(self):
+        """Wipe the name, returning the robot to factory settings."""
+        if self._name is not None:
+            Robot._used_names.discard(self._name)
+            self._previous_name = self._name
+        self._name = None
+
+    def _generate_name(self):
+        candidate = self._random_name()
+        while candidate in Robot._used_names or candidate == self._previous_name:
+            candidate = self._random_name()
+        Robot._used_names.add(candidate)
+        return candidate
+
+    @staticmethod
+    def _random_name():
+        letters = "".join(random.choice(string.ascii_uppercase) for _ in range(2))
+        digits = "".join(random.choice(string.digits) for _ in range(3))
+        return letters + digits
