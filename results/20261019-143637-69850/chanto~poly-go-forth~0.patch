 package forth
 
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// op is a single compiled Forth operation.
+type op func(*[]int) error
+
+var (
+	errEmptyStack = errors.New("empty stack")
+	errOneValue   = errors.New("only one value on the stack")
+	errDivZero    = errors.New("divide by zero")
+)
+
+func pop(stack *[]int) (int, error) {
+	if len(*stack) == 0 {
+		return 0, errEmptyStack
+	}
+	s := *stack
+	v := s[len(s)-1]
+	*stack = s[:len(s)-1]
+	return v, nil
+}
+
+func pop2(stack *[]int) (int, int, error) {
+	if len(*stack) == 0 {
+		return 0, 0, errEmptyStack
+	}
+	if len(*stack) == 1 {
+		return 0, 0, errOneValue
+	}
+	b, _ := pop(stack)
+	a, _ := pop(stack)
+	return a, b, nil
+}
+
+func push(v int) op {
+	return func(stack *[]int) error {
+		*stack = append(*stack, v)
+		return nil
+	}
+}
+
+var builtins = map[string][]op{
+	"+": {func(stack *[]int) error {
+		a, b, err := pop2(stack)
+		if err != nil {
+			return err
+		}
+		*stack = append(*stack, a+b)
+		return nil
+	}},
+	"-": {func(stack *[]int) error {
+		a, b, err := pop2(stack)
+		if err != nil {
+			return err
+		}
+		*stack = append(*stack, a-b)
+		return nil
+	}},
+	"*": {func(stack *[]int) error {
+		a, b, err := pop2(stack)
+		if err != nil {
+			return err
+		}
+		*stack = append(*stack, a*b)
+		return nil
+	}},
+	"/": {func(stack *[]int) error {
+		a, b, err := pop2(stack)
+		if err != nil {
+			return err
+		}
+		if b == 0 {
+			return errDivZero
+		}
+		*stack = append(*stack, a/b)
+		return nil
+	}},
+	"dup": {func(stack *[]int) error {
+		if len(*stack) == 0 {
+			return errEmptyStack
+		}
+		*stack = append(*stack, (*stack)[len(*stack)-1])
+		return nil
+	}},
+	"drop": {func(stack *[]int) error {
+		_, err := pop(stack)
+		return err
+	}},
+	"swap": {func(stack *[]int) error {
+		a, b, err := pop2(stack)
+		if err != nil {
+			return err
+		}
+		*stack = append(*stack, b, a)
+		return nil
+	}},
+	"over": {func(stack *[]int) error {
+		if len(*stack) == 0 {
+			return errEmptyStack
+		}
+		if len(*stack) == 1 {
+			return errOneValue
+		}
+		*stack = append(*stack, (*stack)[len(*stack)-2])
+		return nil
+	}},
+}
+
+// isNumber reports whether token is a (possibly negative) integer.
+func isNumber(token string) (int, bool) {
+	n, err := strconv.Atoi(token)
+	return n, err == nil
+}
+
+// compile turns a single token into an operation, resolving user-defined
+// words against the dictionary as it exists right now. This makes definitions
+// capture the meaning of the words at definition time.
+func compile(token string, dict map[string][]op) (op, error) {
+	if n, ok := isNumber(token); ok {
+		return push(n), nil
+	}
+	ops, ok := dict[strings.ToLower(token)]
+	if !ok {
+		return nil, fmt.Errorf("undefined operation: %s", token)
+	}
+	// Snapshot so later redefinitions cannot alter this compiled word.
+	snapshot := append([]op(nil), ops...)
+	return func(stack *[]int) error {
+		for _, o := range snapshot {
+			if err := o(stack); err != nil {
+				return err
+			}
+		}
+		return nil
+	}, nil
+}
+
 func Forth(input []string) ([]int, error) {
-	panic("Please implement the Forth function")
+	stack := make([]int, 0)
+	dict := make(map[string][]op, len(builtins))
+	for name, ops := range builtins {
+		dict[name] = ops
+	}
+
+	defining := false
+	var name string
+	var body []op
+
+	for _, line := range input {
+		for _, token := range strings.Fields(line) {
+			if defining && name == "" {
+				// The token following ':' is the name of the new word.
+				if token == ";" || token == ":" {
+					return nil, errors.New("invalid definition")
+				}
+				if _, ok := isNumber(token); ok {
+					return nil, fmt.Errorf("illegal operation: %s", token)
+				}
+				name = strings.ToLower(token)
+				continue
+			}
+
+			if defining {
+				switch token {
+				case ";":
+					dict[name] = body
+					defining = false
+					name = ""
+					body = nil
+					continue
+				case ":":
+					return nil, errors.New("nested definition")
+				}
+				o, err := compile(token, dict)
+				if err != nil {
+					return nil, err
+				}
+				body = append(body, o)
+				continue
+			}
+
+			switch token {
+			case ":":
+				defining = true
+				name = ""
+				body = nil
+				continue
+			case ";":
+				return nil, errors.New("unexpected ;")
+			}
+
+			o, err := compile(token, dict)
+			if err != nil {
+				return nil, err
+			}
+			if err := o(&stack); err != nil {
+				return nil, err
+			}
+		}
+	}
+
+	if defining {
+		return nil, errors.New("unterminated definition")
+	}
+
+	return stack, nil
 }
