+def test_recursive_ignore_paths_for_package() -> None:
+    """A package whose init matches ignore-paths should not be checked recursively."""
+    directory = join(REGRTEST_DATA_DIR, "directory")
+    run = Run(
+        ["--recursive", "y", "--ignore-paths", ".*/package/.*", directory],
+        exit=False,
+    )
+
+    linted_file_paths = [
+        file_item.filepath
+        for file_item in run.linter._iterate_file_descrs(
+            tuple(run.linter._discover_files([directory]))
+        )
+    ]
+
+    ignored_package = os.path.abspath(join(directory, "package"))
+    assert not any(
+        path.startswith(ignored_package + os.sep) for path in linted_file_paths
+    )
+
+
