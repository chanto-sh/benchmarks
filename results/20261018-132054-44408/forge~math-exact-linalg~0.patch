 """Small linear-algebra helpers used by the answer checker for the course.
 
 Students submit integer/rational matrices; we compare their answers to these.
+
+All arithmetic is done exactly with :class:`fractions.Fraction`, so results are
+never polluted by floating-point rounding (e.g. ``det`` of a Hilbert matrix).
 """
 
+from fractions import Fraction
+
+
+def _to_fractions(A, name="A"):
+    """Copy a matrix into a list of lists of Fractions, validating its shape.
+
+    Raises ``ValueError`` for ragged (non-rectangular) input.
+    """
+    rows = [[Fraction(x) for x in row] for row in A]
+    if rows:
+        width = len(rows[0])
+        if any(len(row) != width for row in rows):
+            raise ValueError("%s must be rectangular" % name)
+    return rows
+
+
+def det(A):
+    """Determinant of a square matrix (list of rows), exactly.
+
+    Returns a :class:`fractions.Fraction`.  Uses Gaussian elimination with row
+    exchanges; no floating point is involved at any point.
+    """
+    M = _to_fractions(A)
+    n = len(M)
+    if any(len(row) != n for row in M):
+        raise ValueError("det requires a square matrix")
+    if n == 0:
+        # Determinant of the empty matrix is 1 by convention.
+        return Fraction(1)
+
+    sign = 1
+    product = Fraction(1)
+    for c in range(n):
+        # Partial pivot: pick any non-zero entry in this column.  Exact
+        # arithmetic means "non-zero" is a real test, so no tolerance needed.
+        pivot_row = None
+        for i in range(c, n):
+            if M[i][c] != 0:
+                pivot_row = i
+                break
+        if pivot_row is None:
+            return Fraction(0)
+        if pivot_row != c:
+            M[c], M[pivot_row] = M[pivot_row], M[c]
+            sign = -sign
+
+        pivot = M[c][c]
+        product *= pivot
+        for i in range(c + 1, n):
+            f = M[i][c] / pivot
+            if f:
+                row_i, row_c = M[i], M[c]
+                for j in range(c, n):
+                    row_i[j] -= f * row_c[j]
+                # Exact: the entry below the pivot is now precisely zero.
+
+    return product if sign > 0 else -product
+
+
