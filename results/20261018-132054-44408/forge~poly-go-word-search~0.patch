 package wordsearch
 
+import "fmt"
+
+// directions holds the eight possible search directions as {dx, dy} pairs.
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve finds each word in the puzzle and returns the coordinates of its first
+// and last letter as {column, row}. An error is returned if any word cannot be
+// found.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	grid := make([][]rune, len(puzzle))
+	for i, line := range puzzle {
+		grid[i] = []rune(line)
+	}
+
+	height := len(grid)
+	width := 0
+	for _, row := range grid {
+		if len(row) > width {
+			width = len(row)
+		}
+	}
+
+	result := make(map[string][2][2]int, len(words))
+	var missing []string
+
+	for _, word := range words {
+		if loc, ok := find(grid, width, height, []rune(word)); ok {
+			result[word] = loc
+		} else {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+		}
+	}
+
+	if len(missing) > 0 {
+		return result, fmt.Errorf("words not found: %v", missing)
+	}
+	return result, nil
+}
+
+// find searches the grid for word and reports the first and last letter
+// coordinates. Words must lie on a straight horizontal, vertical or diagonal
+// line and may not wrap or span rows.
+func find(grid [][]rune, width, height int, word []rune) ([2][2]int, bool) {
+	var loc [2][2]int
+	if len(word) == 0 {
+		return loc, false
+	}
+
+	for y := 0; y < height; y++ {
+		for x := 0; x < len(grid[y]); x++ {
+			if grid[y][x] != word[0] {
+				continue
+			}
+			for _, d := range directions {
+				endX := x + d[0]*(len(word)-1)
+				endY := y + d[1]*(len(word)-1)
+				if !inBounds(endX, endY, grid, width) {
+					continue
+				}
+				if matches(grid, word, x, y, d[0], d[1]) {
+					loc = [2][2]int{{x, y}, {endX, endY}}
+					return loc, true
+				}
+			}
+		}
+	}
+	return loc, false
+}
+
+// matches reports whether word occurs starting at (x, y) stepping by (dx, dy).
+func matches(grid [][]rune, word []rune, x, y, dx, dy int) bool {
+	for i, want := range word {
+		cx, cy := x+dx*i, y+dy*i
+		if cy < 0 || cy >= len(grid) || cx < 0 || cx >= len(grid[cy]) {
+			return false
+		}
+		if grid[cy][cx] != want {
+			return false
+		}
+	}
+	return true
+}
+
+// inBounds reports whether the coordinate lies inside the (ragged) grid.
+func inBounds(x, y int, grid [][]rune, width int) bool {
+	if y < 0 || y >= len(grid) || x < 0 || x >= width {
+		return false
+	}
+	return x < len(grid[y])
 }
