+//! A `hashmap!` macro for creating `HashMap`s inline, analogous to `vec![]`.
+
+/// Create a [`std::collections::HashMap`] from a list of `key => value` pairs.
+///
+/// ```
+/// use macros::hashmap;
+///
+/// let hm = hashmap!('a' => 3, 'b' => 11, 'z' => 32);
+/// assert_eq!(hm[&'a'], 3);
+/// ```
+///
+/// The macro always refers to `::std::collections::HashMap`, so it cannot be
+/// shadowed by a user-defined `std` module or `HashMap` type in scope.
 #[macro_export]
 macro_rules! hashmap {
     () => {
-        todo!()
+        ::std::collections::HashMap::new()
     };
+    ($($key:expr => $value:expr),+ $(,)?) => {{
+        let mut hm = ::std::collections::HashMap::new();
+        $(
+            hm.insert($key, $value);
+        )+
+        hm
+    }};
 }
