 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL / uniqueness to an existing table in place, so the
+-- table is rebuilt. The copy is intentionally a plain INSERT ... SELECT: if the
+-- current rows violate the new constraints, this migration fails instead of
+-- quietly dropping or rewriting customer data (the runner should roll back the
+-- open transaction on that error).
+--
+-- See BLOCKED.md: the production snapshot contains rows that violate both
+-- constraints (one NULL email and a case-insensitive duplicate), and Support
+-- owns that data, so this migration cannot be applied to production until those
+-- rows are cleaned up by Support.
+BEGIN;
+
+CREATE TABLE users_new (
+    id    INTEGER PRIMARY KEY,
+    email TEXT NOT NULL COLLATE NOCASE UNIQUE,
+    name  TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
