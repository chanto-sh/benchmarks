+"""A basic reactive system.
+
+Cells hold values.  ``InputCell`` values are set directly by the user, while
+``ComputeCell`` values are derived from a set of input cells via a compute
+function.  Changing an input cell propagates through the dependency graph to
+reach a new stable state, after which callbacks registered on compute cells
+are notified if their value differs from the previous stable value.
+"""
+
+from collections import deque
+
+
+class _Cell:
+    """Shared behaviour for reactive cells."""
+
+    def __init__(self, value):
+        self._value = value
+        self._dependents = []
+
+    @property
+    def value(self):
+        return self._value
+
+    def _register_dependent(self, cell):
+        self._dependents.append(cell)
+
+    # -- propagation ------------------------------------------------------
+
+    def _descendants(self):
+        """Return every cell reachable from this one via dependents."""
+        found = []
+        seen = {id(self)}
+        stack = [self]
+        while stack:
+            cell = stack.pop()
+            for dependent in cell._dependents:
+                if id(dependent) not in seen:
+                    seen.add(id(dependent))
+                    found.append(dependent)
+                    stack.append(dependent)
+        return found
+
+    def _topological_order(self, affected):
+        """Order ``affected`` so that cells come after their affected inputs.
+
+        ``self`` is the cell whose value has just been updated, so it is
+        already settled and never takes part in the ordering.
+        """
+        affected_ids = {id(cell) for cell in affected}
+
+        indegree = {}
+        for cell in affected:
+            indegree[id(cell)] = sum(
+                1 for parent in cell._inputs if id(parent) in affected_ids
+            )
+
+        queue = deque(cell for cell in affected if indegree[id(cell)] == 0)
+        order = []
+        while queue:
+            cell = queue.popleft()
+            order.append(cell)
+            for dependent in cell._dependents:
+                dependent_id = id(dependent)
+                if dependent_id in indegree:
+                    indegree[dependent_id] -= 1
+                    if indegree[dependent_id] == 0:
+                        queue.append(dependent)
+        return order
+
+    def _propagate(self):
+        """Bring all dependent cells to a stable state, then notify."""
+        affected = self._descendants()
+        if not affected:
+            return
+
+        order = self._topological_order(affected)
+        previous = {id(cell): cell._value for cell in order}
+
+        for cell in order:
+            cell._recompute()
+
+        for cell in order:
+            if cell._value != previous[id(cell)]:
+                cell._notify()
+
+
