+// Verses returns the lyrics from verse start down to verse stop inclusive,
+// with a blank line separating (and following) each verse.
 func Verses(start, stop int) (string, error) {
-	panic("Please implement the Verses function")
+	if start < 0 || start > 99 {
+		return "", fmt.Errorf("invalid start verse: %d", start)
