+// bottleCount describes n bottles of beer, using the singular form for one
+// bottle and the special "no more" phrasing for zero bottles.
+func bottleCount(n int) string {
+	switch n {
+	case 0:
+		return "no more bottles"
+	case 1:
+		return "1 bottle"
+	default:
+		return fmt.Sprintf("%d bottles", n)
+	}
+}
