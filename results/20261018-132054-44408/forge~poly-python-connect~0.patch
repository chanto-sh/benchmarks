+
+        last_col = self.width - 1
+        if self._connected(
+            "X",
+            ((r, 0) for r in range(self.height)),
+            lambda r, c: c == last_col,
+        ):
+            return "X"
+
+        last_row = self.height - 1
+        if self._connected(
+            "O",
+            ((0, c) for c in range(self.width)),
+            lambda r, c: r == last_row,
+        ):
+            return "O"
+
+        return ""
