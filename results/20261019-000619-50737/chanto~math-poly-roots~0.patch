+def _trim(poly):
+    """Drop leading zero coefficients, keeping at least one coefficient."""
+    i = 0
+    while i < len(poly) - 1 and poly[i] == 0:
+        i += 1
+    return list(poly[i:])
+
+
+def _is_zero(poly):
+    return all(c == 0 for c in poly)
+
+
+def _derivative(poly):
+    degree = len(poly) - 1
+    if degree <= 0:
+        return [Fraction(0)]
+    return [Fraction(poly[i]) * (degree - i) for i in range(degree)]
+
+
+def _divmod(a, b):
+    """Polynomial division over the rationals, highest degree first."""
+    a = _trim([Fraction(c) for c in a])
+    b = _trim([Fraction(c) for c in b])
+    if _is_zero(b):
+        raise ZeroDivisionError("polynomial division by zero")
+    if _is_zero(a) or len(a) < len(b):
+        return [Fraction(0)], a
+
+    quotient = [Fraction(0)] * (len(a) - len(b) + 1)
+    remainder = a[:]
+    while not _is_zero(remainder) and len(remainder) >= len(b):
+        shift = len(remainder) - len(b)
+        coeff = remainder[0] / b[0]
+        quotient[len(a) - len(remainder)] = coeff
+        for i in range(len(b)):
+            remainder[i] -= coeff * b[i]
+        remainder = _trim(remainder)
+    return _trim(quotient), remainder
+
+
+def _primitive(poly):
+    """Scale a rational polynomial to a primitive integer polynomial.
+
+    The scale factor is positive, so signs (and therefore Sturm signs) are
+    preserved.
+    """
+    poly = _trim([Fraction(c) for c in poly])
+    if _is_zero(poly):
+        return [Fraction(0)]
+
+    denominator = 1
+    for c in poly:
+        d = c.denominator
+        denominator = denominator // gcd(denominator, d) * d
+
+    integers = [c.numerator * (denominator // c.denominator) for c in poly]
+    content = 0
+    for value in integers:
+        content = gcd(content, abs(value))
+    if content:
+        integers = [value // content for value in integers]
+    return [Fraction(value) for value in integers]
+
+
+def _gcd(a, b):
+    a = _primitive(a)
+    b = _primitive(b)
+    while not _is_zero(b):
+        _, remainder = _divmod(a, b)
+        a, b = b, _primitive(remainder)
+    return _primitive(a)
+
+
+def _square_free_part(poly):
+    """Polynomial with the same roots as poly, but all roots simple."""
+    poly = _primitive(poly)
+    derivative = _derivative(poly)
+    if _is_zero(derivative):
+        return poly
+    common = _gcd(poly, derivative)
+    quotient, _ = _divmod(poly, common)
+    return _primitive(quotient)
+
+
+def _sturm_sequence(poly):
+    """Sturm sequence of a square-free polynomial."""
+    previous = _primitive(poly)
+    current = _primitive(_derivative(previous))
+    if _is_zero(current):
+        return [previous]
+
+    sequence = [previous, current]
+    while True:
+        _, remainder = _divmod(previous, current)
+        if _is_zero(remainder):
+            break
+        following = _primitive([-c for c in remainder])
+        sequence.append(following)
+        previous, current = current, following
+    return sequence
+
+
+def _variations(sequence, x):
+    """Number of sign changes in a Sturm sequence at x, ignoring zeros."""
+    changes = 0
+    last_sign = 0
+    for poly in sequence:
+        value = evaluate(poly, x)
+        if value > 0:
+            sign = 1
+        elif value < 0:
+            sign = -1
+        else:
+            continue
+        if last_sign and sign != last_sign:
+            changes += 1
+        last_sign = sign
+    return changes
+
+
+def _count_open(sequence, poly, a, b):
+    """Number of distinct roots strictly between a and b."""
+    if a >= b:
+        return 0
+    count = _variations(sequence, a) - _variations(sequence, b)
+    if evaluate(poly, b) == 0:
+        count -= 1
+    return count
+
+
+def _isolate_one(poly, sequence, a, b):
+    """Locate the single root strictly inside (a, b)."""
+    tolerance = Fraction(1, 10**12)
+    while b - a > tolerance:
+        middle = (a + b) / 2
+        if evaluate(poly, middle) == 0:
+            return middle
+        if _count_open(sequence, poly, a, middle) > 0:
+            b = middle
+        else:
+            a = middle
+    return (a + b) / 2
+
