 """Real roots of integer polynomials, used by the curve-fitting tool."""
 
+from fractions import Fraction
+
+
+def _trim(poly):
+    """Drop leading zero coefficients, keeping [0] for the zero polynomial."""
+    if not poly:
+        return [Fraction(0)]
+    i = 0
+    while i < len(poly) - 1 and poly[i] == 0:
+        i += 1
+    return poly[i:]
+
+
+def _is_zero(poly):
+    return len(poly) == 1 and poly[0] == 0
+
+
+def _derivative(poly):
+    degree = len(poly) - 1
+    if degree <= 0:
+        return [Fraction(0)]
+    return [poly[i] * (degree - i) for i in range(degree)]
+
+
+def _divmod(a, b):
+    """Exact polynomial division for Fraction coefficient lists."""
+    a = _trim(list(a))
+    b = _trim(list(b))
+    if _is_zero(b):
+        raise ZeroDivisionError("polynomial division by zero")
+    if _is_zero(a) or len(a) < len(b):
+        return [Fraction(0)], a
+
+    quotient = [Fraction(0)] * (len(a) - len(b) + 1)
+    for i in range(len(quotient)):
+        if a[i] == 0:
+            continue
+        factor = a[i] / b[0]
+        quotient[i] = factor
+        for j, coefficient in enumerate(b):
+            a[i + j] -= factor * coefficient
+    return _trim(quotient), _trim(a)
+
+
+def _gcd(a, b):
+    """Monic polynomial gcd over the rationals."""
+    a, b = _trim(list(a)), _trim(list(b))
+    while not _is_zero(b):
+        _, remainder = _divmod(a, b)
+        a, b = b, remainder
+    if _is_zero(a):
+        return a
+    leading = a[0]
+    return [coefficient / leading for coefficient in a]
+
+
+def _squarefree_part(poly):
+    """Return the monic product of the distinct irreducible factors of poly."""
+    common = _gcd(poly, _derivative(poly))
+    quotient, _ = _divmod(poly, common)
+    quotient = _trim(quotient)
+    leading = quotient[0]
+    return [coefficient / leading for coefficient in quotient]
+
+
+def _sturm_chain(poly):
+    """Sturm sequence for a square-free polynomial."""
+    derivative = _derivative(poly)
+    if _is_zero(derivative):
+        return [poly]
+
+    chain = [poly, derivative]
+    while True:
+        _, remainder = _divmod(chain[-2], chain[-1])
+        if _is_zero(remainder):
+            break
+        remainder = _trim([-coefficient for coefficient in remainder])
+        # Scaling by a positive constant leaves every sign, and hence every
+        # sign variation, unchanged; it keeps the rational coefficients small.
+        scale = abs(remainder[0])
+        chain.append([coefficient / scale for coefficient in remainder])
+    return chain
+
+
+def _variations(chain, x):
+    """Number of sign changes in the Sturm sequence at x, ignoring zeros."""
+    variations = 0
+    previous = 0
+    for poly in chain:
+        value = evaluate(poly, x)
+        sign = (value > 0) - (value < 0)
+        if sign == 0:
+            continue
+        if previous and sign != previous:
+            variations += 1
+        previous = sign
+    return variations
+
 
