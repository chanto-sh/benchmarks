 package forth
 
+import (
+	"errors"
+	"strconv"
+	"strings"
+)
+
+var (
+	errEmptyStack   = errors.New("empty stack")
+	errOneValue     = errors.New("only one value on the stack")
+	errDivideByZero = errors.New("divide by zero")
+	errIllegal      = errors.New("illegal operation")
+	errUndefined    = errors.New("undefined operation")
+)
+
+// instruction is a compiled, fully resolved step of a word definition.
+type instruction struct {
+	isNumber bool
+	number   int
+	word     string // built-in word to execute when isNumber is false
+}
+
+// Forth evaluates a small subset of the Forth language.
 func Forth(input []string) ([]int, error) {
-	panic("Please implement the Forth function")
+	tokens := strings.Fields(strings.Join(input, " "))
+	definitions := map[string][]instruction{}
+	stack := make([]int, 0)
+
+	for i := 0; i < len(tokens); i++ {
+		token := tokens[i]
+
+		if token == ":" {
+			if i+1 >= len(tokens) {
+				return nil, errIllegal
+			}
+			name := strings.ToLower(tokens[i+1])
+			if isNumber(name) {
+				return nil, errIllegal
+			}
+
+			end := i + 2
+			for end < len(tokens) && tokens[end] != ";" {
+				end++
+			}
+			if end >= len(tokens) {
+				return nil, errIllegal
+			}
+
+			body, err := compile(tokens[i+2:end], definitions)
+			if err != nil {
+				return nil, err
+			}
+			definitions[name] = body
+			i = end
+			continue
+		}
+
+		if token == ";" {
+			return nil, errIllegal
+		}
+
+		if isNumber(token) {
+			n, err := strconv.Atoi(token)
+			if err != nil {
+				return nil, err
+			}
+			stack = append(stack, n)
+			continue
+		}
+
+		if body, ok := definitions[strings.ToLower(token)]; ok {
+			if err := execute(body, &stack); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		if isBuiltin(token) {
+			if err := apply(token, &stack); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		return nil, errUndefined
+	}
+
+	return stack, nil
+}
+
+// compile resolves the tokens of a definition against the current
+// definitions, so that later redefinitions do not change its meaning.
+func compile(tokens []string, definitions map[string][]instruction) ([]instruction, error) {
+	body := make([]instruction, 0, len(tokens))
+	for _, token := range tokens {
+		if isNumber(token) {
+			n, err := strconv.Atoi(token)
+			if err != nil {
+				return nil, err
+			}
+			body = append(body, instruction{isNumber: true, number: n})
+			continue
+		}
+		if compiled, ok := definitions[strings.ToLower(token)]; ok {
+			body = append(body, compiled...)
+			continue
+		}
+		if isBuiltin(token) {
+			body = append(body, instruction{word: token})
+			continue
+		}
+		return nil, errUndefined
+	}
+	return body, nil
+}
+
+func execute(body []instruction, stack *[]int) error {
+	for _, ins := range body {
+		if ins.isNumber {
+			*stack = append(*stack, ins.number)
+			continue
+		}
+		if err := apply(ins.word, stack); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func isNumber(token string) bool {
+	if token == "" {
+		return false
+	}
+	if token[0] == '-' {
+		token = token[1:]
+		if token == "" {
+			return false
+		}
+	}
+	for i := 0; i < len(token); i++ {
+		if token[i] < '0' || token[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func isBuiltin(token string) bool {
+	switch strings.ToUpper(token) {
+	case "+", "-", "*", "/", "DUP", "DROP", "SWAP", "OVER":
+		return true
+	}
+	return false
+}
+
+func apply(word string, stack *[]int) error {
+	s := *stack
+	word = strings.ToUpper(word)
+	need := func(n int) error {
+		if len(s) == 0 {
+			return errEmptyStack
+		}
+		if len(s) < n {
+			return errOneValue
+		}
+		return nil
+	}
+
+	switch word {
+	case "+":
+		if err := need(2); err != nil {
+			return err
+		}
+		*stack = append(s[:len(s)-2], s[len(s)-2]+s[len(s)-1])
+	case "-":
+		if err := need(2); err != nil {
+			return err
+		}
+		*stack = append(s[:len(s)-2], s[len(s)-2]-s[len(s)-1])
+	case "*":
+		if err := need(2); err != nil {
+			return err
+		}
+		*stack = append(s[:len(s)-2], s[len(s)-2]*s[len(s)-1])
+	case "/":
+		if err := need(2); err != nil {
+			return err
+		}
+		if s[len(s)-1] == 0 {
+			return errDivideByZero
+		}
+		*stack = append(s[:len(s)-2], s[len(s)-2]/s[len(s)-1])
+	case "DUP":
+		if err := need(1); err != nil {
+			return err
+		}
+		*stack = append(s, s[len(s)-1])
+	case "DROP":
+		if err := need(1); err != nil {
+			return err
+		}
+		*stack = s[:len(s)-1]
+	case "SWAP":
+		if err := need(2); err != nil {
+			return err
+		}
+		s[len(s)-1], s[len(s)-2] = s[len(s)-2], s[len(s)-1]
+	case "OVER":
+		if err := need(2); err != nil {
+			return err
+		}
+		*stack = append(s, s[len(s)-2])
+	}
+	return nil
 }
