+def test_timestamp_and_hostname(testdir):
+    testdir.makepyfile(
+        """
+        def test_x():
+            pass
+    """
+    )
+    _, dom = runandparse(testdir)
+    node = dom.find_first_by_tag("testsuite")
+    node.assert_attr(hostname=socket.gethostname())
+    timestamp = node["timestamp"]
+    assert timestamp is not None
+    try:
+        datetime.datetime.strptime(timestamp, "%Y-%m-%dT%H:%M:%S.%f")
+    except ValueError:
+        datetime.datetime.strptime(timestamp, "%Y-%m-%dT%H:%M:%S")
