+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + tags_text(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {tags_text(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..effb43c 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Return a tag in canonical form, or raise InvalidTag."""
+    normalized = tag.strip().lower()
+    if not normalized or any(c.isspace() for c in normalized) or "," in normalized or "#" in normalized:
+        raise InvalidTag(tag)
+    return normalized
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        normalized = normalize_tag(tag)
+        if normalized not in out:
+            out.append(normalized)
+    return out
 
 
 @dataclass
@@ -6,10 +28,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
