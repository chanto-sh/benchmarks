+++ b/migrations/002_unique_email.sql
@@ -1,2 +1,28 @@
 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- This rebuilds the table because SQLite cannot add NOT NULL to an existing
+-- column in place. It makes no attempt to repair existing data: if any row
+-- has a NULL email or two rows share an email case-insensitively, the copy
+-- (or the index creation) fails and the transaction is rolled back.
+--
+-- The production snapshot currently violates both rules, so this migration
+-- cannot be applied there until Support cleans the data. See BLOCKED.md.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_nocase ON users (email COLLATE NOCASE);
+
+COMMIT;
