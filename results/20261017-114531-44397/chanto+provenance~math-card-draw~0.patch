 from fractions import Fraction
+from math import comb
+
+
+def _hypergeometric_at_least(r, b, k, draws):
+    """P(at least k reds when `draws` cards are taken from r red and b blue)."""
+    if k <= 0:
+        return Fraction(1)
+    if draws < 0 or draws > r + b or k > r or k > draws:
+        return Fraction(0)
+
+    total = comb(r + b, draws)
+    favourable = sum(
+        comb(r, i) * comb(b, draws - i)
+        for i in range(k, min(r, draws) + 1)
+    )
+    return Fraction(favourable, total)
 
 
