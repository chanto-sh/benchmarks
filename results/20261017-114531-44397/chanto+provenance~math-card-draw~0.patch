+        # the deck_size-t positions after it.
+        ways_to_place_greens = comb(deck_size - t, g - 1)
+        if ways_to_place_greens == 0:
+            continue
+        p_first_green_here = Fraction(ways_to_place_greens, total_green_arrangements)
+        result += p_first_green_here * _hypergeometric_at_least(r, b, k, t - 1)
+
+    # Alternatively no green appears within the first m cards; then the deal
