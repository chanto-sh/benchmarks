diff --git a/notes/model.py b/notes/model.py
index 3750b6b..50b6634 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,30 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """Raised when a tag is empty or contains forbidden characters."""
+
+    def __init__(self, tag):
+        super().__init__(tag)
+        self.tag = tag
+
+
+def normalize_tag(tag):
+    raw = tag
+    tag = tag.strip().lower()
+    if not tag or any(c.isspace() for c in tag) or "," in tag or "#" in tag:
+        raise InvalidTag(raw)
+    return tag
+
+
+def normalize_tags(tags):
+    """Lowercase and trim tags, dropping duplicates but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        tag = normalize_tag(tag)
+        if tag not in out:
+            out.append(tag)
+    return out
 
 
 @dataclass
@@ -6,10 +32,16 @@ class Note:
