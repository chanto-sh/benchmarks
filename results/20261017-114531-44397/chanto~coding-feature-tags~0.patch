@@ -38,6 +38,22 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def tag(self, note_id, tags):
+        normalized = normalize_tags(tags)
+        note = self.get(note_id)
+        existing = {t.lower() for t in note.tags}
+        for tag in normalized:
+            if tag not in existing:
+                note.tags.append(tag)
+                existing.add(tag)
+        return note
+
+    def untag(self, note_id, tags):
+        normalized = set(normalize_tags(tags))
+        note = self.get(note_id)
+        note.tags = [t for t in note.tags if t.lower() not in normalized]
+        return note
+
     def save(self):
