+    def load(self):
+        with open(self.db) as f:
+            return json.load(f)
+
+    def write(self, data):
+        with open(self.db, "w") as f:
+            json.dump(data, f)
+
+    def test_add_normalizes_and_dedupes_tags(self):
+        code, out, err = run(
+            self.db, "add", "Buy milk", "--tag", "  Home ", "--tag", "ERRANDS", "--tag", "home"
+        )
+        self.assertEqual((code, out, err), (0, "added #1\n", ""))
+        data = self.load()
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tag_exit_code_and_saves_nothing(self):
+        run(self.db, "add", "first")
+        for bad in ["", "   ", "two words", "a,b", "a#b"]:
+            code, out, err = run(self.db, "add", "nope", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertEqual(out, "")
+            self.assertIn("invalid tag", err)
+            if bad.strip():
+                self.assertIn(bad, err)
+        self.assertEqual([n["title"] for n in self.load()["notes"]], ["first"])
+
+    def test_invalid_tag_does_not_create_file(self):
+        code, _, _ = run(self.db, "add", "nope", "--tag", "bad tag")
+        self.assertEqual(code, 2)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tag_case_insensitively(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "Errands")
+        run(self.db, "add", "Call mom", "--tag", "HOME")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "Home")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "errands")[1],
+            "  1  Buy milk  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "missing")[1], "")
+
+    def test_show_tags_line(self):
