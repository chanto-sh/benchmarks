+    # Shift by one of the readings before squaring.  This keeps the variance
+    # from being computed as the difference of two huge, nearly equal sums
+    # when the data sits around a large offset (timestamps, absolute
+    # pressures, ...).  Differences of nearby doubles are exact (Sterbenz),
+    # so the shifted variance retains full precision.
+    ref = xs[0]
+    mean_shift = math.fsum(x - ref for x in xs) / n
+    var = math.fsum((x - ref - mean_shift) ** 2 for x in xs) / n
+    return ref + mean_shift, var
 
 
