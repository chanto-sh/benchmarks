@@ -38,6 +38,29 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def with_tags(self, tags):
+        """Notes carrying every one of the (normalized) tags."""
+        return [n for n in self.notes if all(t in n.tags for t in tags)]
+
+    def add_tags(self, note_id, tags):
+        note = self.get(note_id)
+        for t in tags:
+            if t not in note.tags:
+                note.tags.append(t)
+        return note
+
+    def remove_tags(self, note_id, tags):
+        note = self.get(note_id)
+        note.tags = [t for t in note.tags if t not in tags]
+        return note
+
+    def tag_counts(self):
+        counts = {}
+        for n in self.notes:
+            for t in n.tags:
+                counts[t] = counts.get(t, 0) + 1
+        return counts
+
     def save(self):
