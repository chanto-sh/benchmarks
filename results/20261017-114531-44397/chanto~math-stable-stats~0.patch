 import math
 
 
+def _scaled_mean_var(xs, n):
+    """Fallback for magnitudes where shifting by ``xs[0]`` overflows."""
+    scale = max(abs(x) for x in xs)
+    if scale == 0.0:
+        return 0.0, 0.0
+
+    ys = [x / scale for x in xs]
+    mean_scaled = math.fsum(ys) / n
+    mean = mean_scaled * scale
+
+    spread = max(abs(y - mean_scaled) for y in ys)
+    if spread == 0.0:
+        return mean, 0.0
+
+    ss = math.fsum(((y - mean_scaled) / spread) ** 2 for y in ys)
+    var = (ss / n) * spread * spread
+    var = var * scale * scale
+    return mean, var
