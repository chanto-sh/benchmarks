+    # The first green is card t (1-indexed): no green among the first t-1
+    # cards, then a green.
+    for t in range(1, m + 1):
+        s = t - 1
+        ways = red_blue_ways(s)
+        if ways:
+            total += Fraction(ways * g, comb(n, s) * (n - s))
+
+    # No green among the first m cards, so the deal stops after m cards.
+    total += Fraction(red_blue_ways(m), comb(n, m))
+
