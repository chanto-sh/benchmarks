@@ -20,6 +20,25 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 = x^2 - 4x + 4
+        self.assertRoots(real_roots([1, -4, 4], -10, 10), [2])
+
+    def test_repeated_root_with_simple_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -10, 10), [-1, 2])
+
+    def test_close_roots(self):
+        # (10^9 x - 1)(x - 1)
+        self.assertRoots(real_roots([10**9, -(10**9 + 1), 1], -1, 2),
+                         [1e-9, 1])
+
+    def test_endpoint_roots(self):
+        # x^2 - 1
+        self.assertRoots(real_roots([1, 0, -1], -1, 1), [-1, 1])
+        self.assertRoots(real_roots([1, 0, -1], 0, 1), [1])
+        self.assertRoots(real_roots([1, 0, -1], -1, 0), [-1])
+
 
