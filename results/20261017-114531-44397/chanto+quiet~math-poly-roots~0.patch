+def _trim(p):
+    """Drop leading zero coefficients."""
+    i = 0
+    while i < len(p) and p[i] == 0:
+        i += 1
+    return p[i:]
+
+
+def _divmod(a, b):
+    """Polynomial division with exact rational coefficients."""
+    a = _trim(a)
+    b = _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    r = a[:]
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    inv_lead = Fraction(1) / b[0]
+    while len(r) >= len(b):
+        shift = len(r) - len(b)
+        coef = r[0] * inv_lead
+        # q is highest-degree first, so the term of degree ``shift`` goes at
+        # the corresponding position from the end.
+        q[len(q) - 1 - shift] = coef
+        for j in range(len(b)):
+            r[j] -= coef * b[j]
+        r = _trim(r)
+    return _trim(q), r
+
+
+def _derivative(p):
+    p = _trim(p)
+    n = len(p) - 1
+    if n <= 0:
+        return []
+    return [p[i] * (n - i) for i in range(n)]
+
+
+def _primitive(p):
+    """Scale a rational polynomial by a positive constant to primitive ints."""
+    p = _trim(p)
+    if not p:
+        return []
+
+    den = 1
+    for c in p:
+        den = den * c.denominator // gcd(den, c.denominator)
+    ints = [int(c * den) for c in p]
+
+    common = 0
+    for c in ints:
+        common = gcd(common, abs(c))
+    if common > 1:
+        ints = [c // common for c in ints]
+
+    return [Fraction(c) for c in ints]
+
+
+def _gcd(a, b):
+    """Polynomial gcd over the rationals, normalized up to a nonzero factor."""
+    a = _trim(a)
+    b = _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    return _primitive(a)
+
+
+def _square_free(p):
+    """p divided by gcd(p, p'), so that every root has multiplicity one."""
+    p = _trim(p)
+    d = _derivative(p)
+    if not d:
+        return p
+    g = _gcd(p, d)
+    q, r = _divmod(p, g)
+    assert not r
+    return _primitive(q)
+
+
+def _sturm_sequence(p):
+    """Sturm sequence for the square-free polynomial p."""
+    seq = [p, _primitive(_derivative(p))]
+    while seq[-1]:
+        _, r = _divmod(seq[-2], seq[-1])
+        r = [-c for c in r]
+        r = _primitive(r)
+        if not r:
+            break
+        seq.append(r)
+    return seq
+
+
+def _variations(seq, x):
+    """Number of sign changes in the Sturm sequence at x, ignoring zeros."""
+    prev = 0
+    changes = 0
+    for p in seq:
+        y = Fraction(0)
+        for c in p:
+            y = y * x + c
+        if y > 0:
+            sign = 1
+        elif y < 0:
+            sign = -1
+        else:
+            continue
+        if prev and sign != prev:
+            changes += 1
+        prev = sign
+    return changes
+
+
+def _refine(seq, sf, va, a, b, tol):
+    """Bisect an interval known to contain exactly one root in (a, b]."""
+    if evaluate(sf, b) == 0:
+        return b
+
+    while b - a > tol:
+        m = (a + b) / 2
+        vm = _variations(seq, m)
+        if va - vm:
+            # The root is in (a, m].
+            b = m
+        else:
+            # The root is in (m, b].
+            a, va = m, vm
+    return (a + b) / 2
+
+
