+def _trim(coeffs):
+    """Remove leading zero coefficients."""
+    coeffs = list(coeffs)
+    while coeffs and coeffs[0] == 0:
+        coeffs.pop(0)
+    return coeffs
+
+
+def _derivative(coeffs):
+    """Derivative of a polynomial with highest-degree-first coefficients."""
+    degree = len(coeffs) - 1
+    return [c * (degree - i) for i, c in enumerate(coeffs[:-1])]
+
+
+def _divmod(a, b):
+    """Exact polynomial division over the rationals."""
+    a = _trim(a)
+    b = _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = list(a)
+    while len(r) >= len(b):
+        shift = len(r) - len(b)
+        factor = r[0] / b[0]
+        q[len(q) - 1 - shift] = factor
+        for i, c in enumerate(b):
+            r[i] -= factor * c
+        r = _trim(r)
+    return q, r
+
+
+def _normalize(coeffs):
+    """Trim and scale by a positive constant, keeping the leading sign."""
+    coeffs = _trim(coeffs)
+    if not coeffs:
+        return coeffs
+    scale = abs(coeffs[0])
+    if scale == 1:
+        return coeffs
+    return [c / scale for c in coeffs]
+
+
+def _gcd(a, b):
+    """Monic greatest common divisor over the rationals."""
+    a, b = _trim(a), _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, _trim(r)
+    if not a:
+        return []
+    return [c / a[0] for c in a]
+
+
+def _square_free_part(coeffs):
+    """Polynomial with the same distinct roots, each occurring once."""
+    coeffs = _trim(coeffs)
+    if len(coeffs) <= 1:
+        return coeffs
+    common = _gcd(coeffs, _derivative(coeffs))
+    quotient, remainder = _divmod(coeffs, common)
+    # The gcd divides the polynomial exactly; this assert catches bad arithmetic.
+    assert not _trim(remainder)
+    return _trim(quotient)
+
+
+def _sturm_sequence(coeffs):
+    """A Sturm sequence for a square-free polynomial."""
+    seq = [_normalize(coeffs), _normalize(_derivative(coeffs))]
+    while seq[-1]:
+        _, remainder = _divmod(seq[-2], seq[-1])
+        if not remainder:
+            break
+        seq.append(_normalize([-c for c in remainder]))
+    return seq
+
+
+def _sign(value):
+    return (value > 0) - (value < 0)
+
+
+def _integer_coefficients(coeffs):
+    """Clear denominators by a positive factor, preserving signs."""
+    denominator = 1
+    for c in coeffs:
+        denominator = denominator // gcd(denominator, c.denominator) * c.denominator
+    return [int(c * denominator) for c in coeffs]
+
+
+def _sign_at(coeffs, numerator, denominator):
+    """Sign of a rational polynomial at numerator/denominator, exactly."""
+    # Compute denominator**degree * P(numerator / denominator).
+    value = coeffs[0]
+    denominator_power = 1
+    for c in coeffs[1:]:
+        denominator_power *= denominator
+        value = value * numerator + c * denominator_power
+    return _sign(value)
+
+
+def _variations(seq, x):
+    """Number of sign changes in the Sturm sequence at x."""
+    numerator, denominator = x.numerator, x.denominator
+    changes = 0
+    previous = 0
+    for poly in seq:
+        current = _sign_at(poly, numerator, denominator)
+        if current == 0:
+            continue
+        if previous and current != previous:
+            changes += 1
+        previous = current
+    return changes
+
+
+def _isolate(seq, left, right, tolerance):
+    """Refine the single root known to lie in (left, right]."""
+    left_variations = _variations(seq, left)
+    while right - left > tolerance:
+        middle = (left + right) / 2
+        middle_variations = _variations(seq, middle)
+        if left_variations - middle_variations > 0:
+            right = middle
+        else:
+            left = middle
+            left_variations = middle_variations
+    return (left + right) / 2
+
