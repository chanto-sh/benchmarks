 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,29 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -2, 3), [-1, 2])
+
+    def test_close_roots(self):
+        # (x - 1)(10^10 x - (10^10 + 1)) has roots 1 and 1 + 1e-10.
+        scale = 10**10
+        coeffs = [scale, -(2 * scale + 1), scale + 1]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1e-10])
+
+    def test_roots_on_interval_boundaries(self):
+        # (x - 1)(x - 2), with the roots as both endpoints and as one endpoint.
+        self.assertRoots(real_roots([1, -3, 2], 1, 2), [1, 2])
+        self.assertRoots(real_roots([1, -3, 2], 1, 3), [1, 2])
+        self.assertRoots(real_roots([1, -3, 2], -1, 2), [1, 2])
+
+    def test_fraction_bounds(self):
+        # (2x - 1)(3x - 4) has roots 1/2 and 4/3.
+        self.assertRoots(
+            real_roots([6, -11, 4], Fraction(1, 2), Fraction(4, 3)),
+            [Fraction(1, 2), Fraction(4, 3)],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
