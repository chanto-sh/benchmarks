@@ -1,11 +1,20 @@
+def _hashtags(tags):
+    return " ".join("#" + t for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    row = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        row += "  " + _hashtags(note.tags)
+    return row
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append("tags: " + _hashtags(note.tags))
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..9bb75c9 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,22 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tags(tags):
+    """Trim, lowercase, validate and de-duplicate tags, preserving first-seen order."""
+    out = []
+    seen = set()
+    for raw in tags:
+        tag = raw.strip().lower()
+        if not tag or any(c.isspace() for c in tag) or "," in tag or "#" in tag:
+            raise InvalidTag(raw)
+        if tag not in seen:
+            seen.add(tag)
+            out.append(tag)
+    return out
 
 
 @dataclass
@@ -6,10 +24,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
