@@ -20,6 +20,23 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (10^7 x - 10^7)(10^7 x - (10^7 + 1)) has roots 1 and 1 + 1e-7.
+        d = 10**7
+        coeffs = [d * d, -d * (2 * d + 1), d * (d + 1)]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1e-7])
+
+    def test_roots_on_boundaries(self):
+        # x^2 - 4
+        self.assertRoots(real_roots([1, 0, -4], 2, 5), [2])
+        self.assertRoots(real_roots([1, 0, -4], -5, 2), [-2, 2])
+        self.assertRoots(real_roots([1, 0, -4], -2, 2), [-2, 2])
+        self.assertRoots(real_roots([1, 0, -4], 2, 2), [2])
+
 
