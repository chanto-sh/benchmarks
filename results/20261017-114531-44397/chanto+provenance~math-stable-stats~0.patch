 import math
 
 
+def _scaled_mean(xs, n, offset=0.0):
+    """Arithmetic mean of (x - offset), scaling only if needed for overflow."""
+    max_abs = max(abs(x - offset) for x in xs)
+    if max_abs == 0.0:
+        return 0.0
+    _, exp = math.frexp(max_abs)
+    # Scale by the least power of two that keeps n terms below the float
+    # limit.  For ordinary data shift is zero, so no precision is lost.
+    shift = max(0, exp + n.bit_length() - 1022)
+    total = math.fsum(math.ldexp(x - offset, -shift) for x in xs)
+    try:
+        return math.ldexp(total / n, shift)
+    except OverflowError:
+        return math.copysign(max_abs, total)
+
+
