+def test_tmpdir_fallback_invalid_user(pytester: Pytester, monkeypatch) -> None:
+    """Test that tmpdir works even if the user name returned by getpass.getuser()
+    contains characters which are illegal for directory names (#8365).
+
+    A path separator is used here as it is illegal on every platform, which
+    also mimics the domain-qualified user names (``DOMAIN\\user``) returned by
+    getpass.getuser() on Windows when connected through SSH.
+    """
+    monkeypatch.setattr("getpass.getuser", lambda: "foo/bar")
+    monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(pytester.path))
+    pytester.makepyfile(
+        """
+        def test_some(tmpdir):
+            assert tmpdir.isdir()
+    """
+    )
+    reprec = pytester.inline_run()
+    reprec.assertoutcome(passed=1)
+    assert pytester.path.joinpath("pytest-of-unknown").exists()
+
+
 @pytest.fixture
 def break_getuser(monkeypatch):
     monkeypatch.setattr("os.getuid", lambda: -1)
