+use std::collections::HashMap;
+
+/// Price in cents of a single book.
+const BOOK_PRICE: u32 = 800;
+
+/// Discount (in percent) applied to a set of `n` distinct books.
+fn discount_percent(set_size: u32) -> u32 {
+    match set_size {
+        2 => 5,
+        3 => 10,
+        4 => 20,
+        5 => 25,
+        _ => 0,
+    }
+}
+
+/// Total price in cents of a set of `set_size` distinct books.
+fn set_price(set_size: u32) -> u32 {
+    set_size * BOOK_PRICE * (100 - discount_percent(set_size)) / 100
+}
+
+/// Sorted (descending), non-zero multiplicities of each distinct title.
+fn multiplicities(books: &[u32]) -> Vec<u32> {
+    let mut per_title: HashMap<u32, u32> = HashMap::new();
+    for &book in books {
+        *per_title.entry(book).or_insert(0) += 1;
+    }
+    let mut counts: Vec<u32> = per_title.into_values().filter(|&c| c > 0).collect();
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+    counts
+}
+
+/// Cheapest price for the given multiplicities, memoized.
+fn lowest_price_for(counts: &[u32], memo: &mut HashMap<Vec<u32>, u32>) -> u32 {
+    if counts.is_empty() {
+        return 0;
+    }
+    if let Some(&price) = memo.get(counts) {
+        return price;
+    }
+
+    let max_set = counts.len().min(5);
+    let mut best = u32::MAX;
+    for set_size in 1..=max_set {
+        // Taking the `set_size` most plentiful titles is always optimal: any
+        // other choice can be exchanged for this one without increasing cost.
+        let mut next: Vec<u32> = counts
+            .iter()
+            .enumerate()
+            .map(|(i, &c)| if i < set_size { c - 1 } else { c })
+            .collect();
+        next.retain(|&c| c > 0);
+        next.sort_unstable_by(|a, b| b.cmp(a));
+
+        let candidate = set_price(set_size as u32) + lowest_price_for(&next, memo);
+        best = best.min(candidate);
+    }
+
+    memo.insert(counts.to_vec(), best);
+    best
+}
+
 pub fn lowest_price(books: &[u32]) -> u32 {
-    todo!("Find the lowest price of the bookbasket with books {books:?}")
+    let counts = multiplicities(books);
+    let mut memo = HashMap::new();
+    lowest_price_for(&counts, &mut memo)
 }
