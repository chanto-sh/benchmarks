index 0000000..f2f3117
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,109 @@
+// Exact decimal helpers for money.
+//
+// Prices, percentages and tax rates arrive as decimal strings (or plain
+// numbers). Binary floating point cannot represent most of them exactly (for
+// example 1.15 * 3 is 3.4499999999999997), so pricing is done with scaled
+// BigInt values and explicit half-up rounding.
+
+function pow10(exp) {
+  return 10n ** BigInt(exp);
+}
+
+// A decimal value is { n, scale }, meaning n / 10^scale. Keeping the scale
+// lets us multiply and add without losing precision.
+function parseDecimal(value) {
+  if (value !== null && typeof value === "object" && typeof value.n === "bigint" && Number.isInteger(value.scale)) {
+    return value;
+  }
+  if (typeof value === "bigint") return { n: value, scale: 0 };
+
+  const text = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?$/.exec(text);
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`invalid decimal value: ${value}`);
+  }
+
+  const fraction = match[3] || "";
+  let n = BigInt((match[2] || "0") + fraction);
+  if (match[1] === "-") n = -n;
+  return { n, scale: fraction.length };
+}
+
+function align(a, b) {
+  const scale = Math.max(a.scale, b.scale);
+  return {
+    scale,
+    x: a.n * pow10(scale - a.scale),
+    y: b.n * pow10(scale - b.scale),
+  };
+}
+
+function add(a, b) {
+  const { scale, x, y } = align(a, b);
+  return { n: x + y, scale };
+}
+
+function subtract(a, b) {
+  const { scale, x, y } = align(a, b);
+  return { n: x - y, scale };
+}
+
+function multiply(a, b) {
+  return { n: a.n * b.n, scale: a.scale + b.scale };
+}
+
+function multiplyInt(a, k) {
+  return { n: a.n * BigInt(k), scale: a.scale };
+}
+
+// `pct` percent of a decimal amount, still exact.
+function percentOf(amount, pct) {
+  const p = parseDecimal(pct);
+  return { n: amount.n * p.n, scale: amount.scale + p.scale + 2 };
+}
+
+function cents(value) {
+  return { n: BigInt(value), scale: 2 };
+}
+
+// Divide two integers and round the result half up (ties away from zero).
+function roundDivHalfUp(numerator, denominator) {
+  if (denominator <= 0n) throw new RangeError("denominator must be positive");
+
+  let quotient = numerator / denominator;
+  let remainder = numerator % denominator;
+  if (remainder < 0n) remainder = -remainder;
+
+  if (remainder * 2n >= denominator) {
+    quotient += numerator < 0n ? -1n : 1n;
+  }
+  return quotient;
+}
+
+// Round a decimal value to whole cents, half up.
+function roundToCents(value) {
+  if (value.scale <= 2) return value.n * pow10(2 - value.scale);
+  return roundDivHalfUp(value.n, pow10(value.scale - 2));
+}
+
+function formatCents(value) {
+  const c = BigInt(value);
+  const negative = c < 0n;
+  const abs = negative ? -c : c;
+  const whole = abs / 100n;
+  const fraction = abs % 100n;
+  return `${negative ? "-" : ""}${whole}.${String(fraction).padStart(2, "0")}`;
+}
+
+module.exports = {
+  parseDecimal,
+  add,
+  subtract,
+  multiply,
+  multiplyInt,
+  percentOf,
+  cents,
+  roundDivHalfUp,
+  roundToCents,
+  formatCents,
+};
