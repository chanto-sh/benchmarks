+// buildChain extends chain by placing unused dominoes so that each one's
+// first side matches the open end. It returns the completed chain and true
+// when every domino is used and the chain's two outer sides match.
+func buildChain(input []Domino, used []bool, chain []Domino, openEnd int) ([]Domino, bool) {
+	if len(chain) == len(input) {
+		return chain, chain[0][0] == openEnd
+	}
+
+	for i, d := range input {
+		if used[i] {
+			continue
+		}
+		// Try the domino in both orientations.
+		for _, placed := range [2]Domino{d, {d[1], d[0]}} {
+			if placed[0] != openEnd {
+				continue
+			}
+			used[i] = true
+			chain = append(chain, placed)
+			if full, ok := buildChain(input, used, chain, placed[1]); ok {
+				return full, true
+			}
+			chain = chain[:len(chain)-1]
+			used[i] = false
+		}
+	}
+
+	return nil, false
 }
