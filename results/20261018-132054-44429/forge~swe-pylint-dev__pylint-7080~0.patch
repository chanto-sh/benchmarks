+def test_recursive_ignore_paths_package() -> None:
+    """An ignored package directory should not be linted recursively.
+
+    ``ignore-paths`` patterns ending with a path separator (e.g.
+    ``^src/gen/.*$``) must also match the directory itself, not only its
+    contents. See https://github.com/PyCQA/pylint/issues/7080.
+    """
+    run = Run(
+        [
+            "--recursive",
+            "y",
+            "--ignore-paths",
+            ".*directory/package/.*",
+            join(REGRTEST_DATA_DIR, "directory"),
+        ],
+        exit=False,
+    )
+
+    linted_files = run.linter._iterate_file_descrs(
+        tuple(run.linter._discover_files([join(REGRTEST_DATA_DIR, "directory")]))
+    )
+    linted_file_paths = [file_item.filepath for file_item in linted_files]
+
+    ignored_package = os.path.join("directory", "package")
+    assert not any(ignored_package in path for path in linted_file_paths)
+
+
