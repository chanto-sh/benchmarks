+    """Reconstruct a tree from an unordered list of flat records.
+
+    Args:
+        records: list of Record(record_id, parent_id) instances.
+
+    Returns:
+        The root Node, or None when no records are given.
+
+    Raises:
+        ValueError: if the records do not describe a single, valid tree.
+    """
+    if not records:
+        return None
+
+    # Sorting by id makes every validity check and the child ordering trivial.
+    records.sort(key=lambda record: record.record_id)
+
+    # The ids must form exactly the range 0..len(records)-1, otherwise either the
+    # root is missing, a record is missing, or an id is duplicated/out of range.
+    for index, record in enumerate(records):
+        if record.record_id != index:
+            raise ValueError('Record id is invalid or out of order.')
+
+    nodes = {record.record_id: Node(record.record_id) for record in records}
+
+    for record in records:
+        if record.parent_id > record.record_id:
+            raise ValueError(
+                "Node parent_id should be smaller than it's record_id."
+            )
+        if record.parent_id == record.record_id:
+            if record.record_id != 0:
+                raise ValueError(
+                    'Only root should have equal record and parent id.'
+                )
+            # This is the root record; it has no parent to attach to.
+            continue
+        # parent_id < record_id and all ids 0..n-1 exist, so the parent is present.
+        nodes[record.parent_id].children.append(nodes[record.record_id])
+
+    return nodes[0]
