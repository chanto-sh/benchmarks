 class BowlingGame:
+    """Keep track of the score of a single game of bowling."""
+
     def __init__(self):
-        pass
+        self._frames = []
 
     def roll(self, pins):
-        pass
+        if not isinstance(pins, int) or isinstance(pins, bool):
+            raise ValueError("pins must be an integer")
+        if self._game_over():
+            raise IndexError("cannot roll after the game has ended")
+        if pins < 0 or pins > 10:
+            raise ValueError("pins must be between 0 and 10")
+
+        if not self._frames or self._frame_complete(len(self._frames) - 1):
+            self._frames.append([])
+
+        frame_index = len(self._frames) - 1
+        frame = self._frames[frame_index]
+
+        if frame_index < 9:
+            if frame and frame[0] + pins > 10:
+                raise ValueError(
+                    "two rolls in a frame cannot score more than 10 points"
