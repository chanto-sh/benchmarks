+++ b/changelog/8365.bugfix.rst
@@ -0,0 +1,4 @@
+The ``tmpdir``, ``tmpdir_factory`` and ``tmp_path_factory`` fixtures now
+sanitize the user name when creating the base temporary directory, avoiding
+failures when the user name contains characters which are not valid in
+directory names.
diff --git a/src/_pytest/tmpdir.py b/src/_pytest/tmpdir.py
