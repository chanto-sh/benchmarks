+def test_get_user_sanitized(monkeypatch):
+    """Test that characters which are not allowed in directory names are
+    replaced in the user name (#8365)."""
+    monkeypatch.setattr("getpass.getuser", lambda: "contoso\\john_doe")
+    assert get_user() == "contoso_john_doe"
