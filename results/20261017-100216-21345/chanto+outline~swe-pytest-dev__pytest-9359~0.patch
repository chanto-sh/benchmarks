+def test_statement_with_decorated_function_after() -> None:
+    """A decorated statement must not leak its decorator into the preceding one."""
+    source = """\
+def test():
+    assert False
+
+    @decorator
+    def inner():
+        pass
+"""
+    assert str(getstatement(1, source)) == "    assert False"
+
+
+def test_statement_with_decorated_class_after() -> None:
+    source = """\
+def test():
+    assert False
+
+    @decorator
+    class Inner:
+        pass
+"""
+    assert str(getstatement(1, source)) == "    assert False"
+
+
 def test_single_line_else() -> None:
     source = getstatement(1, "if False: 2\nelse: 3")
