     values: List[int] = []
     for x in ast.walk(node):
         if isinstance(x, (ast.stmt, ast.ExceptHandler)):
-            values.append(x.lineno - 1)
+            # Before Python 3.8, the lineno of a decorated function
+            # pointed to the decorator. After Python 3.8, it points to
+            # the def/class line, so use the first decorator's lineno
+            # when present to avoid including it in the previous
+            # statement's range.
+            stmt_lineno = x.lineno
+            decorator_list = getattr(x, "decorator_list", None)
+            if decorator_list:
+                stmt_lineno = min(stmt_lineno, *(d.lineno for d in decorator_list))
+            values.append(stmt_lineno - 1)
