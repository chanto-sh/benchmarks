+def test_skipif_with_different_globals(testdir):
+    """Conditions must be evaluated against the globals of each test module."""
+    testdir.makepyfile(
+        test_module_1="""
+        import pytest
+        skip = True
+        @pytest.mark.skipif("skip")
+        def test_should_skip():
+            assert False
+        """,
+        test_module_2="""
+        import pytest
+        skip = False
+        @pytest.mark.skipif("skip")
+        def test_should_not_skip():
+            assert False
+        """,
+    )
+    result = testdir.runpytest()
+    result.assert_outcomes(failed=1, skipped=1)
