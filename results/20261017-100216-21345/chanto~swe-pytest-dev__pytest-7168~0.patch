+def test_broken_getattribute():
+    # both __getattribute__ and __repr__ raise: saferepr() must not raise and
+    # must not rely on attribute access to determine the class name.
+    class SomeClass:
+        def __getattribute__(self, attr):
+            raise
+
+        def __repr__(self):
+            raise
+
+    s = saferepr(SomeClass())
+    assert "SomeClass" in s
+    assert "raised in repr()" in s
+
+
 def test_big_repr():
