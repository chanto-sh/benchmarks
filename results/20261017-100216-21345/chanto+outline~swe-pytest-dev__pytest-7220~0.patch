+def test_path_relative_to_invocation_dir_after_chdir(testdir):
+    testdir.makepyfile(
+        """
+        import os
+
+        import pytest
+
+        @pytest.fixture
+        def private_dir():
+            out_dir = "ddd"
+            os.mkdir(out_dir)
+            old_dir = os.getcwd()
+            os.chdir(out_dir)
+            yield out_dir
+            os.chdir(old_dir)
+
+        def test_show_wrong_path(private_dir):
+            assert False
+    """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        ["*test_path_relative_to_invocation_dir_after_chdir.py:*: AssertionError"]
+    )
+    result.stdout.no_fnmatch_line(
+        "*../test_path_relative_to_invocation_dir_after_chdir.py:*"
+    )
