+def test_hostname_in_xml(testdir):
+    testdir.makepyfile(
+        """
+        def test_x():
+            pass
+    """
+    )
+    _, dom = runandparse(testdir)
+    suite_node = dom.find_first_by_tag("testsuite")
+    assert suite_node["hostname"] == socket.gethostname()
+
+
+def test_timestamp_in_xml(testdir):
+    testdir.makepyfile(
+        """
+        def test_x():
+            pass
+    """
+    )
+    _, dom = runandparse(testdir)
+    suite_node = dom.find_first_by_tag("testsuite")
+    timestamp = suite_node["timestamp"]
+    # The timestamp is in ISO 8601 format, optionally including microseconds.
+    datetime.datetime.strptime(timestamp.split(".")[0], "%Y-%m-%dT%H:%M:%S")
+
