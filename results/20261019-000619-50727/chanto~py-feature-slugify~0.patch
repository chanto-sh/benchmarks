 """Text helpers."""
 
+import re
+import unicodedata
+
+# Latin letters that do not decompose into an ASCII letter plus a combining mark.
+_TRANSLITERATIONS = str.maketrans({
+    "æ": "ae",
+    "œ": "oe",
+    "ø": "o",
+    "ł": "l",
+    "đ": "d",
+    "ð": "d",
+    "þ": "th",
+    "ß": "ss",
+    "ħ": "h",
+    "ı": "i",
+    "ŋ": "n",
+})
+
 
 def slugify(text, max_length=None):
     """Convert text to a URL slug.
@@ -20,4 +38,24 @@ def slugify(text, max_length=None):
         slugify("The quick brown fox", max_length=13) == "the-quick"
         slugify("!!!") == ""
     """
-    raise NotImplementedError
+    text = text.lower()
+    # Decompose accented letters so their combining marks can be dropped.
+    normalized = unicodedata.normalize("NFKD", text)
+    text = "".join(
+        char for char in normalized if not unicodedata.combining(char)
+    )
+    text = text.translate(_TRANSLITERATIONS)
+    slug = re.sub(r"[^a-z0-9]+", "-", text).strip("-")
+
+    if max_length is not None and len(slug) > max_length:
+        if max_length <= 0:
+            return ""
+        slug = slug[:max_length]
+        # Prefer cutting at the last hyphen boundary, and never keep a
+        # trailing hyphen.
+        boundary = slug.rfind("-")
+        if boundary != -1:
+            slug = slug[:boundary]
+        slug = slug.rstrip("-")
+
+    return slug
