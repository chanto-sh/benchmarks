@@ -0,0 +1,56 @@
+"""Tests for text_utils."""
+
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyTests(unittest.TestCase):
+    def test_documented_examples(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("!!!"), "")
+
+    def test_lowercases(self):
+        self.assertEqual(slugify("ABC"), "abc")
+
+    def test_accents_are_ascii_folded(self):
+        self.assertEqual(slugify("ñandú über"), "nandu-uber")
+        self.assertEqual(slugify("Ça va, garçon"), "ca-va-garcon")
+
+    def test_runs_of_separators_collapse(self):
+        self.assertEqual(slugify("one...two!!!three"), "one-two-three")
+
+    def test_leading_and_trailing_separators_removed(self):
+        self.assertEqual(slugify("-- Hello --"), "hello")
+
+    def test_no_letters_or_digits(self):
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify(" \t-__! "), "")
+        self.assertEqual(slugify("日本語"), "")
+
+    def test_non_ascii_between_words_becomes_hyphen(self):
+        self.assertEqual(slugify("a☕b"), "a-b")
+
+    def test_max_length_cuts_at_hyphen_boundary(self):
+        self.assertEqual(slugify("hello wonderful world", max_length=11), "hello")
+        self.assertEqual(slugify("hello-world", max_length=6), "hello")
+        self.assertEqual(slugify("hello-world", max_length=7), "hello")
+
+    def test_max_length_without_hyphen_boundary(self):
+        self.assertEqual(slugify("abcdef", max_length=3), "abc")
+
+    def test_max_length_longer_than_slug(self):
+        self.assertEqual(slugify("hi there", max_length=100), "hi-there")
+
+    def test_max_length_zero(self):
+        self.assertEqual(slugify("hello", max_length=0), "")
+
+    def test_never_ends_with_hyphen(self):
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+
+
+if __name__ == "__main__":
+    unittest.main()
