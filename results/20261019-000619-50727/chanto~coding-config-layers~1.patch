+class EnvironmentTest(unittest.TestCase):
+    def test_nested_case_insensitive(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__POOL__SIZE": "20",
+                "SHOPD__Db__Host": "db.internal",
+            }
+        )
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_other_variables_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPDX__DB__PORT": "1"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_conversions(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "3",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__NAME": "Shop",
+                "SHOPD__FEATURES": " search , api ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.0)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["name"], "Shop")
+        self.assertEqual(cfg["features"], ["search", "api"])
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_bad_values(self):
+        for name, value in [
+            ("SHOPD__DB__PORT", "abc"),
+            ("SHOPD__DB__PORT", "5.5"),
+            ("SHOPD__DB__SSL", "maybe"),
+            ("SHOPD__DB__POOL__TIMEOUT", "soon"),
+        ]:
+            with self.subTest(name=name, value=value):
+                with self.assertRaises(ConfigError) as ctx:
+                    load(env={name: value})
+                self.assertIn(name[len("SHOPD__"):].lower().replace("__", "."), str(ctx.exception))
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(ctx.exception))
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(overrides=["db.port=6543", "features=a, b", "db.ssl=on"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_bad_overrides(self):
+        for item, needle in [
+            ("db.prot=1", "db.prot"),
+            ("db.port=abc", "db.port"),
+            ("db=anything", "db"),
+        ]:
+            with self.subTest(item=item):
+                with self.assertRaises(ConfigError) as ctx:
+                    load(overrides=[item])
+                self.assertIn(needle, str(ctx.exception))
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111, "host": "file"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222", "SHOPD__DB__HOST": "env"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["host"], "env")
+
+
+class CliTest(unittest.TestCase):
+    def _run(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            env=_clean_env(),
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_options(self):
+        proc = self._run("--set", "db.port=6543", "--set", "db.host=example")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["host"], "example")
+
+    def test_bad_set_exits_2(self):
+        proc = self._run("--set", "db.port=abc")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.port", proc.stderr)
+
