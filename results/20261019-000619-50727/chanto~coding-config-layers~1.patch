+    Raises ConfigError if the setting is unknown or `name` is a whole section.
+    """
+    node = DEFAULTS
+    for part in name.split("."):
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"{name}: unknown setting")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{name}: is a section, not a setting")
+    return node
+
+
+def _convert(name, raw, default):
+    """Convert the string `raw` to the type of `default`."""
+    if isinstance(default, bool):
+        value = raw.strip().lower()
+        if value in _TRUE:
+            return True
+        if value in _FALSE:
+            return False
+        raise ConfigError(f"{name}: cannot convert {raw!r} to bool")
+    if isinstance(default, int):
