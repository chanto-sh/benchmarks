+class EnvironmentTest(unittest.TestCase):
+    def test_nested_settings(self):
+        cfg = load(env={
+            "SHOPD__DB__POOL__SIZE": "20",
+            "SHOPD__DB__HOST": "db.env",
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "0.5",
+        })
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 0.5})
+        self.assertEqual(cfg["db"]["host"], "db.env")
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_key_names_are_case_insensitive(self):
+        cfg = load(env={"shopd__Db__PORT": "6543"})
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_booleans(self):
+        for text in ("1", "true", "TRUE", "Yes", "on"):
+            with self.subTest(text=text):
+                self.assertIs(load(env={"SHOPD__DB__SSL": text})["db"]["ssl"], True)
+        for text in ("0", "false", "False", "no", "OFF"):
+            with self.subTest(text=text):
+                self.assertIs(load(env={"SHOPD__DB__SSL": text})["db"]["ssl"], False)
+
+    def test_strings_are_not_converted(self):
+        cfg = load(env={"SHOPD__LOG__LEVEL": "DEBUG", "SHOPD__NAME": "0"})
+        self.assertEqual(cfg["log"]["level"], "DEBUG")
+        self.assertEqual(cfg["name"], "0")
+
+    def test_lists(self):
+        cfg = load(env={"SHOPD__FEATURES": " search, api "})
+        self.assertEqual(cfg["features"], ["search", "api"])
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_unrelated_variables_are_ignored(self):
+        cfg = load(env={"SHOPD_DB_PORT": "1", "PATH": "/bin", "DB__PORT": "2"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_defaults_are_not_mutated(self):
+        load(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(load(env={})["db"]["port"], 5432)
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(overrides=[
+            "db.port=6543",
+            "db.pool.size=20",
+            "db.pool.timeout=0.5",
+            "db.ssl=no",
+            "log.level=debug",
+            "features=search, api",
+        ])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 0.5})
+        self.assertIs(cfg["db"]["ssl"], False)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "api"])
+
+    def test_later_overrides_win(self):
+        cfg = load(overrides=["db.host=first", "db.host=second"])
+        self.assertEqual(cfg["db"]["host"], "second")
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 7000, "host": "file.internal"}, "log": {"level": "warn"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "8000", "SHOPD__DB__HOST": "env.internal"},
+                overrides=["db.port=9000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 9000)  # overrides beat environment and file
+        self.assertEqual(cfg["db"]["host"], "env.internal")  # environment beats file
+        self.assertEqual(cfg["log"]["level"], "warn")  # file beats defaults
+        self.assertEqual(cfg["db"]["ssl"], False)  # defaults remain
+
