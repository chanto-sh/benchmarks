 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+
+_TRUE = {"1", "true", "yes", "on"}
+_FALSE = {"0", "false", "no", "off"}
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layers, lowest precedence first: the built-in defaults, the JSON file at
+    `path` (if any), `SHOPD__...` variables in `env` (defaults to
+    ``os.environ``), and the ``"name=value"`` strings in `overrides`.
+    """
+    cfg = deep_merge(DEFAULTS, {})
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
-    cfg = DEFAULTS
     if path:
         try:
             with open(path) as f:
@@ -17,4 +29,74 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+
+    if env is None:
+        env = os.environ
+    for key, value in env.items():
+        if not key.upper().startswith(ENV_PREFIX):
+            continue
+        setting = key[len(ENV_PREFIX):].lower().replace("__", ".")
+        _apply(cfg, setting, value)
+
+    for override in overrides:
+        setting, sep, value = override.partition("=")
+        if not sep:
+            raise ConfigError(
+                f"invalid override {override!r}: expected NAME=VALUE"
+            )
+        _apply(cfg, setting.strip().lower(), value)
+
+    return cfg
+
+
+def _apply(cfg, setting, value):
+    """Set `setting` in `cfg`, converting `value` to the default's type."""
+    parts = setting.split(".")
+    node = DEFAULTS
+    for part in parts[:-1]:
+        child = node.get(part) if isinstance(node, dict) else None
+        if not isinstance(child, dict):
+            raise ConfigError(f"unknown setting {setting}")
+        node = child
+
+    leaf = parts[-1]
+    if not isinstance(node, dict) or leaf not in node:
+        raise ConfigError(f"unknown setting {setting}")
+    default = node[leaf]
+    if isinstance(default, dict):
+        raise ConfigError(f"cannot set section {setting}")
+
+    converted = _convert(setting, default, value)
+
+    target = cfg
+    for part in parts[:-1]:
+        target = target[part]
+    target[leaf] = converted
+
+
+def _convert(setting, default, value):
+    """Convert a string `value` to the type of `default`."""
+    try:
+        if isinstance(default, bool):
+            text = str(value).strip().lower()
+            if text in _TRUE:
+                return True
+            if text in _FALSE:
+                return False
+            raise ValueError
+        if isinstance(default, int):
+            return int(str(value).strip())
+        if isinstance(default, float):
+            return float(str(value).strip())
+        if isinstance(default, list):
+            text = str(value)
+            if text == "":
+                return []
+            return [item.strip() for item in text.split(",")]
+        if isinstance(default, str):
+            return value if isinstance(value, str) else str(value)
+    except (TypeError, ValueError) as e:
+        raise ConfigError(
+            f"{setting}: cannot convert {value!r} to {type(default).__name__}"
+        ) from e
+    raise ConfigError(f"{setting}: unsupported setting type")
