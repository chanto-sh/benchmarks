+++ b/testing/logging/test_default_format.py
@@ -0,0 +1,26 @@
+import logging
+
+from _pytest.logging import DEFAULT_LOG_FORMAT
+
+
+def test_default_log_format():
+    assert (
+        DEFAULT_LOG_FORMAT
+        == "%(levelname)-8s %(name)s:%(filename)s:%(lineno)d %(message)s"
+    )
+
+
+def test_default_log_format_includes_logger_name(testdir):
+    testdir.makepyfile(
+        """
+        import logging
+
+        def test_foo():
+            logging.getLogger("my.logger").warning("hello")
+            assert False
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        ["*WARNING*my.logger:test_default_log_format_includes_logger_name.py:* hello"]
+    )
