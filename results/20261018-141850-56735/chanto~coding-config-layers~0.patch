+class EnvTest(unittest.TestCase):
+    def test_nested_setting_is_converted_to_default_type(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertIsInstance(cfg["db"]["pool"]["size"], int)
+
+    def test_key_names_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__db__POOL__Size": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_each_supported_type(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "1.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__LEVEL": "debug",
+                "SHOPD__FEATURES": " search, metrics ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 1.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+
+    def test_false_booleans(self):
+        for value in ("0", "false", "No", "OFF"):
+            with self.subTest(value=value):
+                cfg = load(env={"SHOPD__DB__SSL": value})
+                self.assertIs(cfg["db"]["ssl"], False)
+
+    def test_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_string_setting(self):
+        cfg = load(env={"SHOPD__NAME": "other"})
+        self.assertEqual(cfg["name"], "other")
+
+    def test_unrelated_variables_are_ignored(self):
+        cfg = load(
+            env={
+                "OTHER__DB__PORT": "1",
+                "SHOPD_DB_PORT": "2",
+                "SHOPD__DB__PORT": "6543",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_defaults_are_not_mutated(self):
+        load(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(load(env={})["db"]["port"], 5432)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "6543"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+    def test_bad_integer(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PORT": "5.5"})
+        self.assertIn("db.port", str(cm.exception))
+
+    def test_bad_boolean(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__SSL": "maybe"})
+        self.assertIn("db.ssl", str(cm.exception))
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides_are_converted(self):
+        cfg = load(overrides=["db.port=6543", "features=a, b", "db.ssl=on"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_precedence_defaults_file_env_overrides(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 5000, "host": "file-host"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "6000"},
+                overrides=["db.port=7000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 7000)
+        self.assertEqual(cfg["db"]["host"], "file-host")
+        self.assertEqual(cfg["db"]["pool"]["size"], 5)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.prot=6543"])
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db=x"])
+        self.assertIn("db", str(cm.exception))
+
+    def test_bad_value(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.port=abc"])
+        self.assertIn("db.port", str(cm.exception))
+
