+class CliTest(unittest.TestCase):
+    def run_cli(self, *args, env=None):
+        full_env = dict(os.environ)
+        full_env.pop("SHOPD__DB__PORT", None)
+        if env:
+            full_env.update(env)
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            env=full_env,
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_option_is_repeatable(self):
+        result = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=true")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        cfg = json.loads(result.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_environment_is_read(self):
+        result = self.run_cli(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)["db"]["port"], 6543)
+
+    def test_bad_setting_exits_2(self):
+        result = self.run_cli("--set", "db.prot=6543")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.prot", result.stderr)
+        self.assertEqual(result.stdout, "")
+
+
 if __name__ == "__main__":
     unittest.main()
