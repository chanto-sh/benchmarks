+import re
+
+_NUMBER = re.compile(r"-?\d+\Z")
+
+
 class StackUnderflowError(Exception):
     pass
 
 
+def _is_number(token):
+    return bool(_NUMBER.match(token))
+
+
 def evaluate(input_data):
-    pass
+    stack = []
+    definitions = {}
+
+    def require(count):
+        if len(stack) < count:
+            raise StackUnderflowError("Insufficient number of items in stack")
+
+    def add():
+        require(2)
+        right = stack.pop()
+        left = stack.pop()
+        stack.append(left + right)
+
+    def subtract():
+        require(2)
+        right = stack.pop()
+        left = stack.pop()
+        stack.append(left - right)
+
+    def multiply():
+        require(2)
+        right = stack.pop()
+        left = stack.pop()
+        stack.append(left * right)
+
+    def divide():
+        require(2)
+        right = stack.pop()
+        left = stack.pop()
+        if right == 0:
+            raise ZeroDivisionError("divide by zero")
+        stack.append(left // right)
+
+    def dup():
+        require(1)
+        stack.append(stack[-1])
+
+    def drop():
+        require(1)
+        stack.pop()
+
+    def swap():
+        require(2)
+        stack[-2], stack[-1] = stack[-1], stack[-2]
+
+    def over():
+        require(2)
+        stack.append(stack[-2])
+
+    builtins = {
+        "+": add,
+        "-": subtract,
+        "*": multiply,
+        "/": divide,
+        "dup": dup,
+        "drop": drop,
+        "swap": swap,
+        "over": over,
+    }
+
+    def execute(tokens):
+        for token in tokens:
+            if _is_number(token):
+                stack.append(int(token))
