 package wordsearch
 
+import "errors"
+
+type direction struct {
+	dx, dy int
+}
+
+var directions = []direction{
+	{1, 0},  // left to right
+	{-1, 0}, // right to left
+	{0, 1},  // top to bottom
+	{0, -1}, // bottom to top
+	{1, 1},  // top left to bottom right
+	{-1, -1},
+	{1, -1}, // bottom left to top right
+	{-1, 1}, // top right to bottom left
+}
+
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	result := make(map[string][2][2]int, len(words))
+	missing := false
+
+	if len(puzzle) == 0 {
+		for _, word := range words {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+		}
+		return result, errors.New("empty puzzle")
+	}
+
+	height := len(puzzle)
+	for _, word := range words {
+		found := len(word) == 0
+		if found {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = true
+			continue
+		}
+		for y := 0; y < height && !found; y++ {
+			width := len(puzzle[y])
+			for x := 0; x < width && !found; x++ {
+				if puzzle[y][x] != word[0] {
+					continue
+				}
+				for _, d := range directions {
+					if matches(puzzle, word, x, y, d) {
+						result[word] = [2][2]int{
+							{x, y},
+							{x + d.dx*(len(word)-1), y + d.dy*(len(word)-1)},
+						}
+						found = true
+						break
+					}
+				}
+			}
+		}
+		if !found {
+			missing = true
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+		}
+	}
+
+	if missing {
+		return result, errors.New("word not found in puzzle")
+	}
+	return result, nil
+}
+
+func matches(puzzle []string, word string, x, y int, d direction) bool {
+	for i := 0; i < len(word); i++ {
+		cx, cy := x+d.dx*i, y+d.dy*i
+		if cy < 0 || cy >= len(puzzle) {
+			return false
+		}
+		if cx < 0 || cx >= len(puzzle[cy]) {
+			return false
+		}
+		if puzzle[cy][cx] != word[i] {
+			return false
+		}
+	}
+	return true
 }
