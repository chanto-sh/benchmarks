@@ -2,6 +2,42 @@ package sublist
 
 // Relation type is defined in relations.go file.
 
+// Sublist determines the relation between l1 and l2.
 func Sublist(l1, l2 []int) Relation {
-	panic("Please implement the Sublist function")
+	switch {
+	case equal(l1, l2):
+		return RelationEqual
+	case contains(l2, l1):
+		return RelationSublist
+	case contains(l1, l2):
+		return RelationSuperlist
+	default:
+		return RelationUnequal
+	}
+}
+
+func equal(l1, l2 []int) bool {
+	if len(l1) != len(l2) {
+		return false
+	}
+	for i := range l1 {
+		if l1[i] != l2[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// contains reports whether haystack contains needle as a contiguous
+// sub-sequence. The empty needle is contained in every haystack.
+func contains(haystack, needle []int) bool {
+	if len(needle) > len(haystack) {
+		return false
+	}
+	for i := 0; i+len(needle) <= len(haystack); i++ {
+		if equal(haystack[i:i+len(needle)], needle) {
+			return true
+		}
+	}
+	return false
 }
