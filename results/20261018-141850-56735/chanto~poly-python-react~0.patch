+def _collect_affected(dependents):
+    affected = set()
+    stack = list(dependents)
+    while stack:
+        cell = stack.pop()
+        if cell in affected:
+            continue
+        affected.add(cell)
+        stack.extend(cell._dependents)
+    return affected
+
+
+def _propagate(dependents):
+    affected = _collect_affected(dependents)
+    changed = {}
+
+    def recompute(cell):
+        if cell in changed:
+            return
+        for input_cell in cell._inputs:
+            if input_cell in affected:
+                recompute(input_cell)
+        old_value = cell._value
+        cell._value = cell._compute_function([c.value for c in cell._inputs])
+        changed[cell] = old_value != cell._value
+
+    for cell in affected:
+        recompute(cell)
+
+    for cell, did_change in changed.items():
+        if did_change:
+            for callback in list(cell._callbacks):
+                callback(cell.value)
