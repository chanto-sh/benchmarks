diff --git a/app/utils/merge.py b/app/utils/merge.py
index f548f97..dd2c022 100644
--- a/app/utils/merge.py
+++ b/app/utils/merge.py
@@ -2,5 +2,9 @@ def merge(base, override):
     """Merge `override` into a copy of `base`. Nested dicts are merged recursively."""
     out = dict(base)
     for key, value in override.items():
-        out[key] = value
+        existing = out.get(key)
+        if isinstance(existing, dict) and isinstance(value, dict):
+            out[key] = merge(existing, value)
+        else:
+            out[key] = value
     return out
