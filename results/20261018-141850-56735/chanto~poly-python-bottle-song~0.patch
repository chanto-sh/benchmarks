+NUMBERS = [
+    "no",
+    "one",
+    "two",
+    "three",
+    "four",
+    "five",
+    "six",
+    "seven",
+    "eight",
+    "nine",
+    "ten",
+]
+
+
+def _bottles(count):
+    noun = "bottle" if count == 1 else "bottles"
+    return f"{NUMBERS[count]} green {noun}"
+
+
+def _verse(count):
+    current = _bottles(count).capitalize()
+    remaining = _bottles(count - 1)
+    return [
+        f"{current} hanging on the wall,",
+        f"{current} hanging on the wall,",
+        "And if one green bottle should accidentally fall,",
+        f"There'll be {remaining} hanging on the wall.",
+    ]
+
+
 def recite(start, take=1):
-    pass
+    lines = []
+    for count in range(start, start - take, -1):
+        if lines:
+            lines.append("")
+        lines.extend(_verse(count))
+    return lines
