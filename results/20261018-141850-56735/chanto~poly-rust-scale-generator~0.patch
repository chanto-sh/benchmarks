+        } else if SHARP_MINOR.contains(&spelling) {
+            false
+        } else {
+            spelling.contains('b')
+        }
+    } else if FLAT_MAJOR.contains(&spelling) {
+        true
+    } else if SHARP_MAJOR.contains(&spelling) {
+        false
+    } else {
+        spelling.contains('b')
     }
