+/// Parse a tonic into its canonical spelling, pitch class, and mode.
+///
+/// The first letter's case determines the mode: uppercase is major,
+/// lowercase is minor. The returned spelling always capitalizes the
+/// letter (e.g. `"bb"` -> `"Bb"`).
+fn parse_tonic(tonic: &str) -> Result<(String, u8, bool), Error> {
+    let mut chars = tonic.chars();
+    let first = chars.next().ok_or(Error)?;
+    let is_minor = first.is_ascii_lowercase();
+    let letter = first.to_ascii_uppercase();
+
+    let base = match letter {
+        'C' => 0,
+        'D' => 2,
+        'E' => 4,
+        'F' => 5,
+        'G' => 7,
+        'A' => 9,
+        'B' => 11,
+        _ => return Err(Error),
+    };
+
+    let mut accidental = 0i16;
+    let mut spelling = String::from(letter);
+    if let Some(accidental_char) = chars.next() {
+        match accidental_char {
+            '#' => {
+                accidental = 1;
+                spelling.push('#');
+            }
+            'b' => {
+                accidental = -1;
+                spelling.push('b');
+            }
+            _ => return Err(Error),
+        }
+        if chars.next().is_some() {
+            return Err(Error);
+        }
+    }
+
+    let pitch = (base + accidental).rem_euclid(12) as u8;
+    Ok((spelling, pitch, is_minor))
+}
