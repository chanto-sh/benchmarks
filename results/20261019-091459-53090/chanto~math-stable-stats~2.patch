 """Summary statistics for the sensor pipeline."""
 import math
+import sys
 
 
 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+
+    # Work relative to the first value so that a large common offset does
+    # not consume the precision of the deviations, and use the two-pass
+    # formula (rather than sum(x*x) - n*mean*mean) to avoid cancellation.
+    #
+    # Near the float limits a difference of two finite values can itself
+    # overflow; scaling by a power of two is exact and keeps it finite.
+    scale = 1.0
+    if max(abs(x) for x in xs) > sys.float_info.max / 2:
+        scale = 0.5
+    shift = xs[0] * scale
+
+    try:
+        mean_shifted = math.fsum(x * scale - shift for x in xs) / n
+    except OverflowError:
+        # The sum of the deviations exceeded the float range; dividing each
+        # term first keeps the (finite) mean representable.
+        mean_shifted = math.fsum((x * scale - shift) / n for x in xs)
+
+    def squared_deviation(x):
+        d = x * scale - shift - mean_shifted
+        return d * d
+
+    m2 = math.fsum(map(squared_deviation, xs))
+    return (shift + mean_shifted) / scale, (m2 / n) / (scale * scale)
 
 
