-    return mean, s2 / n - mean * mean
+    if n == 0:
+        raise ValueError("mean_var() requires a non-empty sequence")
+
+    # Work relative to the first reading so a large common offset cancels
+    # exactly, then normalize the offsets before summing to avoid overflow.
+    origin = xs[0]
+    offsets = [x - origin for x in xs]
+
+    if all(math.isfinite(d) for d in offsets):
+        max_offset = max(abs(d) for d in offsets)
+        if max_offset == 0.0:
+            mean_offset = 0.0
+        else:
+            mean_offset = (
+                math.fsum(d / max_offset for d in offsets) / n
+            ) * max_offset
+        mean = origin + mean_offset
+        return mean, _variance_from_deviations(
+            [d - mean_offset for d in offsets], n
+        )
+
+    # Subtracting the origin overflowed (values span most of the float
+    # range).  Scale first so both the mean and variance stay finite.
+    scale = max(abs(x) for x in xs)
+    if scale == 0.0:
+        return 0.0, 0.0
+    scaled = [x / scale for x in xs]
+    mean_scaled = math.fsum(scaled) / n
+    variance_scaled = _variance_from_deviations(
+        [x - mean_scaled for x in scaled], n
+    )
+    return mean_scaled * scale, variance_scaled * scale * scale
 
 
