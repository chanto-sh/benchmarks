 import math
 
 
+def _variance_from_deviations(ds, n):
+    """Population variance of deviations, scaled to avoid overflow."""
+    scale = max(abs(d) for d in ds)
+    if scale == 0.0:
+        return 0.0
+    if not math.isfinite(scale):
+        return math.inf
+    # Sum squared normalized deviations in [0, 1], then scale back one
+    # factor at a time so that a finite variance does not overflow early.
+    normalized = math.fsum((d / scale) ** 2 for d in ds)
+    return (normalized / n) * scale * scale
+
+
