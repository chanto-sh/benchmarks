 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    # Shift by a sample before summing so that a large common offset cancels
+    # exactly instead of dominating the sum (and then the variance formula).
+    shift = xs[0]
+    deviations = [x - shift for x in xs]
+    mean_deviation = math.fsum(deviations) / n
+    mean = shift + mean_deviation
+    # Two-pass variance on the shifted data; fsum keeps the accumulation exact
+    # to within one rounding of the final result.
+    var = math.fsum((d - mean_deviation) ** 2 for d in deviations) / n
+    return mean, var
 
 
