+// Verse returns the given verse of the song.
 func Verse(v int) string {
-	panic("Please implement the Verse function")
+	lines := []string{
+		fmt.Sprintf("I know an old lady who swallowed a %s.", animals[v-1]),
+		remarks[v],
+	}
+
+	if v == 8 {
+		return strings.Join(lines, "\n")
+	}
+
+	for i := v; i > 1; i-- {
+		line := fmt.Sprintf("She swallowed the %s to catch the %s", animals[i-1], animals[i-2])
+		if animals[i-2] == "spider" {
+			line += " that wriggled and jiggled and tickled inside her"
+		}
+		lines = append(lines, line+".")
+	}
+
+	if v > 1 {
+		lines = append(lines, remarks[1])
+	}
+
+	return strings.Join(lines, "\n")
 }
 
+// Verses returns the verses from start to end, inclusive.
 func Verses(start, end int) string {
-	panic("Please implement the Verses function")
+	verses := make([]string, 0, end-start+1)
+	for v := start; v <= end; v++ {
+		verses = append(verses, Verse(v))
+	}
+	return strings.Join(verses, "\n\n")
 }
 
