 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let command = command.trim().strip_suffix('?')?;
+    let command = command.strip_prefix("What is")?;
+
+    // Require a word boundary after the question prefix ("What is5?" is invalid).
+    if !command.is_empty() && !command.starts_with(char::is_whitespace) {
+        return None;
+    }
+
+    let mut tokens = command.split_whitespace();
+    let mut result = parse_number(tokens.next()?)?;
+
+    while let Some(operator) = tokens.next() {
+        match operator {
+            "plus" => {
+                let operand = parse_number(tokens.next()?)?;
+                result = result.checked_add(operand)?;
+            }
+            "minus" => {
+                let operand = parse_number(tokens.next()?)?;
+                result = result.checked_sub(operand)?;
+            }
+            "multiplied" => {
+                if tokens.next()? != "by" {
+                    return None;
+                }
+                let operand = parse_number(tokens.next()?)?;
+                result = result.checked_mul(operand)?;
+            }
+            "divided" => {
+                if tokens.next()? != "by" {
+                    return None;
+                }
+                let operand = parse_number(tokens.next()?)?;
+                result = result.checked_div(operand)?;
+            }
+            #[cfg(feature = "exponentials")]
+            "raised" => {
+                if tokens.next()? != "to" || tokens.next()? != "the" {
+                    return None;
+                }
+                let exponent = parse_ordinal(tokens.next()?)?;
+                if tokens.next()? != "power" {
+                    return None;
+                }
+                result = result.checked_pow(exponent)?;
+            }
+            _ => return None,
+        }
+    }
+
+    Some(result)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse().ok()
+}
+
+#[cfg(feature = "exponentials")]
+fn parse_ordinal(token: &str) -> Option<u32> {
+    let digits = token
+        .strip_suffix("th")
+        .or_else(|| token.strip_suffix("st"))
+        .or_else(|| token.strip_suffix("nd"))
+        .or_else(|| token.strip_suffix("rd"))?;
+    digits.parse().ok()
 }
