-    def set_value(self):
-        pass
+    def set_value(self, value):
+        focus = dict(self._focus)
+        focus["value"] = value
+        return Zipper(focus, self._context)
 
     def left(self):
-        pass
-
-    def set_left(self):
-        pass
+        return self._descend("left")
 
