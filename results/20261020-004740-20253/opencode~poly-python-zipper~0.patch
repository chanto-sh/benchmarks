 class Zipper:
+    """A purely functional zipper over a binary tree of dict nodes.
+
+    Each node is a dict with the keys ``value``, ``left`` and ``right``.
+    A zipper keeps the focused node together with the path back to the
+    root, so every operation returns a new zipper and never mutates the
+    original tree.
+    """
+
+    def __init__(self, focus, context=()):
+        self._focus = focus
+        # Each entry is (parent_value, sibling, direction) where direction
+        # says whether the focused branch is the parent's "left" or "right".
+        self._context = context
+
     @staticmethod
