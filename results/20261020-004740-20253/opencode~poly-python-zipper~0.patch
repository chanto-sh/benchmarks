+    def _descend(self, direction):
+        child = self._focus.get(direction)
+        if child is None:
+            return None
+        sibling = self._focus.get("right" if direction == "left" else "left")
+        context = self._context + ((self._focus["value"], sibling, direction),)
+        return Zipper(child, context)
+
+    def set_left(self, tree):
