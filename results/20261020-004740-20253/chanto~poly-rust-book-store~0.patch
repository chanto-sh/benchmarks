+use std::collections::HashMap;
+
+const BOOK_PRICE: u32 = 800;
+
+fn group_price(size: u32) -> u32 {
+    let discount_percent = match size {
+        2 => 5,
+        3 => 10,
+        4 => 20,
+        5 => 25,
+        _ => 0,
+    };
+    size * BOOK_PRICE * (100 - discount_percent) / 100
+}
+
+fn solve(mut counts: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+
+    if counts[0] == 0 {
+        return 0;
+    }
+    if let Some(&total) = memo.get(&counts) {
+        return total;
+    }
+
+    let mut best = u32::MAX;
+    // Try every non-empty subset of the five titles as one group.
+    for mask in 1u32..(1 << 5) {
+        if (0..5).any(|i| mask & (1 << i) != 0 && counts[i] == 0) {
+            continue;
+        }
+        let mut next = counts;
+        for i in 0..5 {
+            if mask & (1 << i) != 0 {
+                next[i] -= 1;
+            }
+        }
+        let total = group_price(mask.count_ones()) + solve(next, memo);
+        best = best.min(total);
+    }
+
+    memo.insert(counts, best);
+    best
+}
+
