+func isPalindrome(n int) bool {
+	if n < 0 {
+		n = -n
+	}
+	digits := strconv.Itoa(n)
+	for left, right := 0, len(digits)-1; left < right; left, right = left+1, right-1 {
+		if digits[left] != digits[right] {
