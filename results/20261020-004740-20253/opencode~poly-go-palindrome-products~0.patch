+
+// Product represents a palindromic product and all of its factorizations
+// within the requested range.
+type Product struct {
+	Value          int
+	Factorizations [][2]int
+}
+
+func isPalindrome(n int) bool {
+	s := strconv.Itoa(n)
+	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
+		if s[i] != s[j] {
+			return false
+		}
+	}
+	return true
+}
 
 func Products(fmin, fmax int) (Product, Product, error) {
-	panic("Please implement the Products function")
+	if fmin > fmax {
+		return Product{}, Product{}, fmt.Errorf("fmin > fmax: %d > %d", fmin, fmax)
+	}
+
+	factorizations := make(map[int][][2]int)
+	minProduct, maxProduct := 0, 0
+	found := false
+
+	for i := fmin; i <= fmax; i++ {
+		for j := i; j <= fmax; j++ {
+			p := i * j
+			if p < 0 || !isPalindrome(p) {
+				continue
+			}
+			factorizations[p] = append(factorizations[p], [2]int{i, j})
+			if !found || p < minProduct {
+				minProduct = p
+			}
+			found = true
+			if p > maxProduct {
+				maxProduct = p
+			}
+		}
+	}
+
+	if len(factorizations) == 0 {
+		return Product{}, Product{}, fmt.Errorf("no palindromes found in range [%d, %d]", fmin, fmax)
+	}
+
+	pmin := Product{minProduct, factorizations[minProduct]}
+	pmax := Product{maxProduct, factorizations[maxProduct]}
+	return pmin, pmax, nil
 }
