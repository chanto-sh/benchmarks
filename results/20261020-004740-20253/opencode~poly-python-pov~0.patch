+            raise ValueError("Tree could not be reoriented")
+
+        def orient(node, parent):
+            return Tree(
+                node,
+                [orient(child, node) for child in adjacency[node] if child != parent],
+            )
+
+        return orient(from_node, None)
 
     def path_to(self, from_node, to_node):
