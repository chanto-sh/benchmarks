+    def _neighbors(self, x, y):
+        if x > 0:
+            yield x - 1, y
+        if x < self.width - 1:
+            yield x + 1, y
+        if y > 0:
+            yield x, y - 1
+        if y < self.height - 1:
+            yield x, y + 1
+
+    def _empty_region(self, x, y):
+        """Return (empty intersections, bordering stone colors) for the region."""
+        region = set()
+        borders = set()
+        stack = [(x, y)]
+        while stack:
+            cx, cy = stack.pop()
+            if (cx, cy) in region:
+                continue
+            region.add((cx, cy))
+            for nx, ny in self._neighbors(cx, cy):
+                cell = self.board[ny][nx]
+                if cell == " ":
+                    if (nx, ny) not in region:
+                        stack.append((nx, ny))
+                else:
+                    borders.add(cell)
+        return region, borders
 
