 package transpose
 
 func Transpose(input []string) []string {
-	panic("Please implement the Transpose function")
+	if len(input) == 0 {
+		return []string{}
+	}
+
+	width := 0
+	for _, row := range input {
+		if len(row) > width {
+			width = len(row)
+		}
+	}
+
+	result := make([]string, 0, width)
+	for col := 0; col < width; col++ {
+		// Find the last row that actually contains a character in this
+		// column. Trailing padding below it is not part of the input.
+		last := -1
+		for row := len(input) - 1; row >= 0; row-- {
+			if col < len(input[row]) {
+				last = row
+				break
+			}
+		}
+		if last == -1 {
+			continue
+		}
+
+		line := make([]byte, last+1)
+		for row := 0; row <= last; row++ {
+			if col < len(input[row]) {
+				line[row] = input[row][col]
+			} else {
+				line[row] = ' '
+			}
+		}
+		result = append(result, string(line))
+	}
+
+	return result
 }
