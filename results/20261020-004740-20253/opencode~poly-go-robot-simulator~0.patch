+		}
+		for j := 0; j < i; j++ {
+			if robots[j].Pos == r.Pos {
+				log <- fmt.Sprintf("robot %q placed at the same place as %q", r.Name, robots[j].Name)
+				break
+			}
+		}
+	}
+
+	if len(robots) == 0 {
+		rep <- robots
+		return
+	}
+
+	finished := 0
+	for a := range action {
+		if a.Done {
+			finished++
+			if finished >= len(robots) {
+				rep <- robots
+				return
+			}
+			continue
+		}
+
+		i, ok := names[a.Name]
+		if !ok {
+			log <- fmt.Sprintf("action from unknown robot %q", a.Name)
+			continue
+		}
+
+		r := &robots[i]
+		switch a.Command {
+		case 'R':
+			r.Dir = (r.Dir + 1) % 4
+		case 'L':
+			r.Dir = (r.Dir + 3) % 4
+		case 'A':
+			next := advanced(r.Pos, r.Dir)
+			if !inExtent(next, extent) {
