+				continue
+			}
+			occupied := false
+			for j := range robots {
+				if j != i && robots[j].Pos == next {
+					occupied = true
+					break
+				}
+			}
+			if occupied {
+				log <- fmt.Sprintf("robot %q attempted to advance into another robot", a.Name)
+				continue
+			}
