+}
+
+func advanced(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func inExtent(p Pos, r Rect) bool {
+	return p.Easting >= r.Min.Easting && p.Easting <= r.Max.Easting &&
+		p.Northing >= r.Min.Northing && p.Northing <= r.Max.Northing
 }
 
