+
+
+def _affected_cells(root):
+    """All compute cells whose value may depend on ``root``."""
+    affected = set()
+    stack = list(root._dependents)
+    while stack:
+        cell = stack.pop()
+        if cell in affected:
+            continue
+        affected.add(cell)
+        stack.extend(cell._dependents)
+    return affected
+
+
+def _topological_order(cells):
+    """Order ``cells`` so that every cell follows its inputs."""
+    indegree = {
+        cell: sum(1 for source in cell.inputs if source in cells)
+        for cell in cells
+    }
+    ready = [(cell._seq, cell) for cell in cells if indegree[cell] == 0]
+    heapq.heapify(ready)
+
+    order = []
+    while ready:
+        _, cell = heapq.heappop(ready)
+        order.append(cell)
+        for dependent in cell._dependents:
+            if dependent in cells:
+                indegree[dependent] -= 1
+                if indegree[dependent] == 0:
+                    heapq.heappush(ready, (dependent._seq, dependent))
+
+    return order
+
+
+def _propagate(root):
+    """Recompute everything downstream of ``root`` and fire callbacks."""
+    cells = _affected_cells(root)
+    if not cells:
+        return
+
+    changed = []
+    for cell in _topological_order(cells):
+        new_value = cell.compute_function([source.value for source in cell.inputs])
+        if new_value != cell._value:
+            cell._value = new_value
+            changed.append(cell)
+
+    for cell in changed:
+        cell._fire_callbacks()
