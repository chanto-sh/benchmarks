+"""A small reactive programming system.
+
+Input cells hold a value that can be set directly. Compute cells derive
+their value from other cells. Changing an input propagates through the
+dependency graph until the system reaches a new stable state; callbacks
+registered on compute cells fire only when their value differs from the
+value in the previous stable state.
+"""
+
+import heapq
+
+
+_next_sequence = 0
+
+
+def _sequence():
+    global _next_sequence
+    _next_sequence += 1
+    return _next_sequence
+
+
