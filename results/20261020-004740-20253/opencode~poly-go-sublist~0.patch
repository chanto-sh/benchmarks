 func Sublist(l1, l2 []int) Relation {
-	panic("Please implement the Sublist function")
+	switch {
+	case equal(l1, l2):
+		return RelationEqual
+	case contains(l1, l2):
+		return RelationSuperlist
+	case contains(l2, l1):
+		return RelationSublist
+	default:
