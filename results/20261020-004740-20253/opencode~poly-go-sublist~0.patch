+
+// equal reports whether a and b contain the same values in the same order.
+func equal(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// contains reports whether outer contains inner as a contiguous subsequence.
+func contains(outer, inner []int) bool {
+	if len(inner) == 0 {
+		return true
+	}
+	if len(inner) > len(outer) {
+		return false
+	}
+	for start := 0; start <= len(outer)-len(inner); start++ {
+		if equal(outer[start:start+len(inner)], inner) {
+			return true
+		}
+	}
+	return false
 }
