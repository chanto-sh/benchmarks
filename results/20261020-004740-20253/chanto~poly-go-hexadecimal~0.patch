+import (
+	"errors"
+	"math"
+)
+
+var (
+	errSyntax = errors.New("hexadecimal syntax error")
+	errRange  = errors.New("hexadecimal value out of range")
+)
+
+// ParseHex converts a hexadecimal string to its decimal (int64) value.
+func ParseHex(in string) (int64, error) {
+	if in == "" {
+		return 0, errSyntax
+	}
+
+	var out int64
+	for _, r := range in {
+		var digit int64
+		switch {
+		case r >= '0' && r <= '9':
+			digit = int64(r - '0')
+		case r >= 'a' && r <= 'f':
+			digit = int64(r-'a') + 10
+		case r >= 'A' && r <= 'F':
+			digit = int64(r-'A') + 10
+		default:
+			return 0, errSyntax
+		}
+
+		if out > (math.MaxInt64-digit)/16 {
+			return 0, errRange
+		}
+		out = out*16 + digit
+	}
+
+	return out, nil
+}
+
+// HandleErrors parses each input and reports whether it is valid ("none"),
+// malformed ("syntax"), or too large for an int64 ("range").
+func HandleErrors(in []string) []string {
+	out := make([]string, len(in))
+	for i, s := range in {
+		_, err := ParseHex(s)
+		switch {
+		case err == nil:
+			out[i] = "none"
+		case errors.Is(err, errRange):
+			out[i] = "range"
+		default:
+			out[i] = "syntax"
+		}
+	}
+	return out
 }
