+func (g *Game) frameStart() int {
+	i := 0
+	for frame := 0; frame < frames-1 && i < len(g.rolls); frame++ {
+		if g.rolls[i] == 10 {
+			i++
+			continue
+		}
+		if i+1 >= len(g.rolls) {
+			break
+		}
+		i += 2
+	}
+	return i
