+func (g *Game) isOver() bool {
+	i := 0
+	for frame := 0; frame < frames; frame++ {
+		if i >= len(g.rolls) {
+			return false
+		}
+		if g.rolls[i] == 10 {
+			i++
+			if frame == frames-1 {
+				return len(g.rolls) >= i+2
+			}
+			continue
+		}
+		if i+1 >= len(g.rolls) {
+			return false
+		}
+		if g.rolls[i]+g.rolls[i+1] == 10 {
+			i += 2
+			if frame == frames-1 {
+				return len(g.rolls) >= i+1
+			}
+			continue
+		}
+		i += 2
+	}
