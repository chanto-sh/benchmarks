+/// Return the possible DNA bases represented by an IUPAC nucleotide code.
+fn expansions(c: char) -> Option<&'static [&'static str]> {
+    Some(match c {
+        'A' => &["A"],
+        'C' => &["C"],
+        'G' => &["G"],
+        'T' => &["T"],
+        'R' => &["A", "G"],
+        'Y' => &["C", "T"],
+        'S' => &["G", "C"],
+        'W' => &["A", "T"],
+        'K' => &["G", "T"],
+        'M' => &["A", "C"],
+        'B' => &["C", "G", "T"],
+        'D' => &["A", "G", "T"],
+        'H' => &["A", "C", "T"],
+        'V' => &["A", "C", "G"],
+        'N' => &["A", "C", "G", "T"],
+        _ => return None,
+    })
+}
