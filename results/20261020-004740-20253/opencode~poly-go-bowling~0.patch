+// validateRoll reports whether pins may be rolled after the given rolls.
+// It replays the game frame by frame to find the state of the current frame.
+func validateRoll(rolls []int, pins int) error {
+	if pins < 0 {
+		return errNegativeRoll
+	}
+	if pins > 10 {
+		return errTooManyPins
+	}
+
+	i := 0
+	for frame := 1; frame <= 10; frame++ {
+		if i >= len(rolls) {
+			// The new roll is the first (or only) ball of this frame.
+			return nil
+		}
+
+		if frame < 10 {
+			if rolls[i] == 10 {
+				i++
+				continue
+			}
+			if i+1 >= len(rolls) {
+				// The new roll is the second ball of this frame.
+				if pins > 10-rolls[i] {
+					return errTooManyPins
+				}
+				return nil
+			}
+			i += 2
+			continue
+		}
+
+		// Tenth frame.
+		first := rolls[i]
+		if first == 10 {
+			if i+1 >= len(rolls) {
+				// New roll is the first fill ball.
+				return nil
+			}
+			second := rolls[i+1]
+			if i+2 >= len(rolls) {
+				// New roll is the second fill ball.
+				if second != 10 && pins > 10-second {
+					return errTooManyPins
+				}
+				return nil
+			}
+			return errGameOver
+		}
+
+		if i+1 >= len(rolls) {
+			// New roll is the second ball of the tenth frame.
+			if pins > 10-first {
+				return errTooManyPins
+			}
+			return nil
+		}
+
+		if first+rolls[i+1] == 10 {
+			if i+2 >= len(rolls) {
+				// New roll is the fill ball after a spare.
+				return nil
+			}
+			return errGameOver
+		}
+		return errGameOver
+	}
+
+	return errGameOver
 }
