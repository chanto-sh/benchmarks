index d1be410..4ac64e8 100644
--- a/proverb.py
+++ b/proverb.py
@@ -1,2 +1,12 @@
-def proverb():
-    pass
+def proverb(*pieces, qualifier=None):
+    if not pieces:
+        return []
+
+    lines = [
+        f"For want of a {item} the {next_item} was lost."
+        for item, next_item in zip(pieces, pieces[1:])
+    ]
+
+    final = pieces[0] if qualifier is None else f"{qualifier} {pieces[0]}"
+    lines.append(f"And all for the want of a {final}.")
+    return lines
