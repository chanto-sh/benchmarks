+	for i, line := range lines {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			return nil, fmt.Errorf("row %d is empty", i)
+		}
+		if i > 0 && len(fields) != len(m[0]) {
+			return nil, fmt.Errorf("row %d has %d values, want %d", i, len(fields), len(m[0]))
