+/// Returns every concrete nucleotide represented by `nucleotide`, or `None`
+/// if it is not a valid DNA nucleotide or IUPAC ambiguity code.
+fn possibilities(nucleotide: char) -> Option<&'static [u8]> {
+    match nucleotide {
+        'A' => Some(b"A"),
+        'C' => Some(b"C"),
+        'G' => Some(b"G"),
+        'T' => Some(b"T"),
+        'R' => Some(b"AG"),
+        'Y' => Some(b"CT"),
+        'K' => Some(b"GT"),
+        'M' => Some(b"AC"),
+        'S' => Some(b"CG"),
+        'W' => Some(b"AT"),
+        'B' => Some(b"CGT"),
+        'D' => Some(b"AGT"),
+        'H' => Some(b"ACT"),
+        'V' => Some(b"ACG"),
+        'N' => Some(b"ACGT"),
+        _ => None,
+    }
 }
