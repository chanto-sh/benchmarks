+def _is_number(token):
+    return _NUMBER_PATTERN.match(token) is not None
+
+
+def _require(stack, count):
+    if len(stack) < count:
+        raise StackUnderflowError("Insufficient number of items in stack")
+
+
+def _add(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left + right)
+
+
+def _subtract(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left - right)
+
+
+def _multiply(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left * right)
+
+
+def _divide(stack):
+    _require(stack, 2)
+    divisor = stack.pop()
+    dividend = stack.pop()
+    if divisor == 0:
+        raise ZeroDivisionError("divide by zero")
+    # Integer division truncating towards zero.
+    quotient = abs(dividend) // abs(divisor)
+    if (dividend < 0) != (divisor < 0):
+        quotient = -quotient
+    stack.append(quotient)
+
+
+def _dup(stack):
+    _require(stack, 1)
+    stack.append(stack[-1])
+
+
+def _drop(stack):
+    _require(stack, 1)
+    stack.pop()
+
+
+def _swap(stack):
+    _require(stack, 2)
+    stack[-1], stack[-2] = stack[-2], stack[-1]
+
+
+def _over(stack):
+    _require(stack, 2)
+    stack.append(stack[-2])
+
