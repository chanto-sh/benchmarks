+    @lru_cache(maxsize=None)
+    def best(remaining):
+        # Remaining counts, sorted so equivalent states share a cache entry.
+        remaining = tuple(sorted((c for c in remaining if c), reverse=True))
+        if not remaining:
+            return 0
