+
+
+def _verse(count):
+    current = NUMBERS[count]
+    remaining = NUMBERS[count - 1].lower()
+    current_noun = "bottle" if count == 1 else "bottles"
+    remaining_noun = "bottle" if count - 1 == 1 else "bottles"
+    return [
+        f"{current} green {current_noun} hanging on the wall,",
+        f"{current} green {current_noun} hanging on the wall,",
+        "And if one green bottle should accidentally fall,",
+        f"There'll be {remaining} green {remaining_noun} hanging on the wall.",
+    ]
+
+
 def recite(start, take=1):
