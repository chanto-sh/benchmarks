 package wordsearch
 
+import "fmt"
+
+// Solve finds each word in the puzzle. Coordinates are returned as
+// [x, y] pairs for the first and last letters of each word.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	directions := [][2]int{
+		{1, 0},   // left to right
+		{-1, 0},  // right to left
+		{0, 1},   // top to bottom
+		{0, -1},  // bottom to top
+		{1, 1},   // top left to bottom right
+		{-1, -1}, // bottom right to top left
+		{1, -1},  // bottom left to top right
+		{-1, 1},  // top right to bottom left
+	}
+
+	result := make(map[string][2][2]int, len(words))
+	var missing []string
+
+	for _, word := range words {
+		found := false
+		for y := 0; y < len(puzzle) && !found; y++ {
+			for x := 0; x < len(puzzle[y]) && !found; x++ {
+				for _, d := range directions {
+					if matches(puzzle, word, x, y, d[0], d[1]) {
+						endX := x + d[0]*(len(word)-1)
+						endY := y + d[1]*(len(word)-1)
+						result[word] = [2][2]int{{x, y}, {endX, endY}}
+						found = true
+						break
+					}
+				}
+			}
+		}
+		if !found {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+		}
+	}
+
+	if len(missing) > 0 {
+		return result, fmt.Errorf("words not found: %v", missing)
+	}
+	return result, nil
+}
+
+func matches(puzzle []string, word string, x, y, dx, dy int) bool {
+	for i := 0; i < len(word); i++ {
+		px := x + dx*i
+		py := y + dy*i
+		if py < 0 || py >= len(puzzle) || px < 0 || px >= len(puzzle[py]) {
+			return false
+		}
+		if puzzle[py][px] != word[i] {
+			return false
+		}
+	}
+	return true
 }
