+		if len(row) > width {
+			width = len(row)
+		}
+	}
+
+	result := make([]string, 0, width)
+	for col := 0; col < width; col++ {
+		// Find the last row that actually has a character in this column.
+		last := -1
+		for row := len(input) - 1; row >= 0; row-- {
+			if col < len(input[row]) {
+				last = row
