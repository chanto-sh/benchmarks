+def _collect_affected(roots):
+    affected = set()
+    stack = list(roots)
+    while stack:
+        cell = stack.pop()
+        if cell in affected:
+            continue
+        affected.add(cell)
+        stack.extend(cell._dependents)
+    return affected
+
+
+def _propagate(roots):
+    affected = _collect_affected(roots)
+
+    # Topological order of the affected cells, dependencies first.
+    ordered = []
+    visited = set()
+
+    def visit(cell):
+        if cell in visited or cell not in affected:
+            return
+        visited.add(cell)
+        if isinstance(cell, ComputeCell):
+            for dependency in cell._inputs:
+                visit(dependency)
+        ordered.append(cell)
+
+    for cell in affected:
+        visit(cell)
+
+    # Recompute every affected compute cell once, reaching a stable state.
+    changed = []
+    for cell in ordered:
+        if isinstance(cell, ComputeCell):
+            new_value = cell._calculate()
+            if new_value != cell._value:
+                cell._value = new_value
+                changed.append(cell)
+
+    # Notify only after the system is stable.
+    for cell in changed:
+        for callback in list(cell._callbacks):
+            callback(cell.value)
