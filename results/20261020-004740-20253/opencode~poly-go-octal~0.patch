+import "fmt"
+
+// ParseOctal converts an octal number represented as a string to its
+// decimal equivalent. Invalid input returns 0 along with an error.
+func ParseOctal(input string) (int64, error) {
+	if input == "" {
+		return 0, fmt.Errorf("invalid octal number: empty input")
+	}
+
+	var result int64
+	for _, r := range input {
+		if r < '0' || r > '7' {
+			return 0, fmt.Errorf("invalid octal number: %q", input)
+		}
+		result = result*8 + int64(r-'0')
+	}
+
+	return result, nil
 }
