+/// Spell out a number from 0 to 999 in English.
+fn encode_below_thousand(n: u64) -> String {
+    let n = n as usize;
+    let mut parts: Vec<String> = Vec::new();
+
+    if n >= 100 {
+        parts.push(format!("{} hundred", ONES[n / 100]));
+    }
+
+    let rest = n % 100;
+    if rest >= 20 {
+        let tens = TENS[rest / 10];
+        let ones = rest % 10;
+        if ones == 0 {
+            parts.push(tens.to_string());
+        } else {
+            parts.push(format!("{tens}-{}", ONES[ones]));
+        }
+    } else if rest > 0 {
+        parts.push(ONES[rest].to_string());
+    }
+
