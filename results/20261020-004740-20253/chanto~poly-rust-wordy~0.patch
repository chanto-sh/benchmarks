 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let rest = command.strip_prefix("What is")?;
+    let rest = rest.strip_suffix('?').unwrap_or(rest);
+    let tokens: Vec<&str> = rest.split_whitespace().collect();
+    if tokens.is_empty() {
+        return None;
+    }
+
+    let mut i = 0;
+    let mut acc = parse_number(tokens[i])?;
+    i += 1;
+
+    while i < tokens.len() {
+        let op = tokens[i];
+        i += 1;
+
+        match op {
+            "plus" => {
+                let n = parse_number(*tokens.get(i)?)?;
+                i += 1;
+                acc = acc.checked_add(n)?;
+            }
+            "minus" => {
+                let n = parse_number(*tokens.get(i)?)?;
+                i += 1;
+                acc = acc.checked_sub(n)?;
+            }
+            "multiplied" => {
+                if *tokens.get(i)? != "by" {
+                    return None;
+                }
+                i += 1;
+                let n = parse_number(*tokens.get(i)?)?;
+                i += 1;
+                acc = acc.checked_mul(n)?;
+            }
+            "divided" => {
+                if *tokens.get(i)? != "by" {
+                    return None;
+                }
+                i += 1;
+                let n = parse_number(*tokens.get(i)?)?;
+                i += 1;
+                acc = acc.checked_div(n)?;
+            }
+            "raised" => {
+                #[cfg(feature = "exponentials")]
+                {
+                    if *tokens.get(i)? != "to" {
+                        return None;
+                    }
+                    i += 1;
+                    if *tokens.get(i)? != "the" {
+                        return None;
+                    }
+                    i += 1;
+                    let exponent = parse_ordinal(tokens.get(i)?)?;
+                    i += 1;
+                    if *tokens.get(i)? != "power" {
+                        return None;
+                    }
+                    i += 1;
+                    acc = acc.checked_pow(exponent)?;
+                }
+                #[cfg(not(feature = "exponentials"))]
+                {
+                    return None;
+                }
+            }
+            _ => return None,
+        }
+    }
+
+    Some(acc)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse().ok()
+}
+
+#[cfg(feature = "exponentials")]
+fn parse_ordinal(token: &str) -> Option<u32> {
+    for suffix in ["th", "st", "nd", "rd"] {
+        if let Some(number) = token.strip_suffix(suffix) {
+            if let Ok(value) = number.parse::<u32>() {
+                return Some(value);
+            }
+        }
+    }
+    None
 }
