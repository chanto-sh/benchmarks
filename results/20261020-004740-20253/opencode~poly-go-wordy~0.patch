 package wordy
 
+import (
+	"strconv"
+	"strings"
+)
+
+// Answer parses a simple math word problem and evaluates it from left to
+// right, ignoring the usual order of operations. The second return value is
+// false when the question is not a valid word problem.
 func Answer(question string) (int, bool) {
-	panic("Please implement the Answer function")
+	const prefix = "What is"
+
+	if !strings.HasPrefix(question, prefix) || !strings.HasSuffix(question, "?") {
+		return 0, false
+	}
+
+	body := strings.TrimSuffix(strings.TrimPrefix(question, prefix), "?")
+	tokens := strings.Fields(body)
+	if len(tokens) == 0 {
+		return 0, false
+	}
+
+	result, ok := parseNumber(tokens[0])
+	if !ok {
+		return 0, false
+	}
+
+	for i := 1; i < len(tokens); {
+		var op byte
+		switch tokens[i] {
+		case "plus":
+			op = '+'
+			i++
+		case "minus":
+			op = '-'
+			i++
+		case "multiplied":
+			if i+1 >= len(tokens) || tokens[i+1] != "by" {
+				return 0, false
+			}
+			op = '*'
+			i += 2
+		case "divided":
+			if i+1 >= len(tokens) || tokens[i+1] != "by" {
+				return 0, false
+			}
+			op = '/'
+			i += 2
+		default:
+			return 0, false
+		}
+
+		if i >= len(tokens) {
+			return 0, false
+		}
+
+		operand, ok := parseNumber(tokens[i])
+		if !ok {
+			return 0, false
+		}
+		i++
+
+		switch op {
+		case '+':
+			result += operand
+		case '-':
+			result -= operand
+		case '*':
+			result *= operand
+		case '/':
+			if operand == 0 {
+				return 0, false
+			}
+			result /= operand
+		}
+	}
+
+	return result, true
+}
+
+func parseNumber(s string) (int, bool) {
+	n, err := strconv.Atoi(s)
+	if err != nil {
+		return 0, false
+	}
+	return n, true
 }
