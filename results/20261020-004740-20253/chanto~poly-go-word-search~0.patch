 package wordsearch
 
+import "errors"
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	grid := make([][]rune, len(puzzle))
+	for i, row := range puzzle {
+		grid[i] = []rune(row)
+	}
+
+	result := make(map[string][2][2]int, len(words))
+	foundAll := true
+	for _, word := range words {
+		start, end, found := findWord(grid, []rune(word))
+		if !found {
+			foundAll = false
+			start, end = [2]int{-1, -1}, [2]int{-1, -1}
+		}
+		result[word] = [2][2]int{start, end}
+	}
+
+	if !foundAll {
+		return result, errors.New("word not found in puzzle")
+	}
+	return result, nil
+}
+
+func findWord(grid [][]rune, word []rune) ([2]int, [2]int, bool) {
+	if len(word) == 0 {
+		return [2]int{-1, -1}, [2]int{-1, -1}, true
+	}
+	for y := range grid {
+		for x := range grid[y] {
+			for _, d := range directions {
+				if matches(grid, word, x, y, d) {
+					return [2]int{x, y}, [2]int{x + d[0]*(len(word)-1), y + d[1]*(len(word)-1)}, true
+				}
+			}
+		}
+	}
+	return [2]int{-1, -1}, [2]int{-1, -1}, false
+}
+
+func matches(grid [][]rune, word []rune, x, y int, d [2]int) bool {
+	for i, r := range word {
+		cx := x + d[0]*i
+		cy := y + d[1]*i
+		if cy < 0 || cy >= len(grid) || cx < 0 || cx >= len(grid[cy]) || grid[cy][cx] != r {
+			return false
+		}
+	}
+	return true
 }
