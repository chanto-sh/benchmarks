+// pathToNode returns the sequence of nodes from the receiver down to the
+// first node whose value equals value, or nil if no such node exists.
+func (tr *Tree) pathToNode(value string) []*Tree {
+	if tr == nil {
+		return nil
+	}
+	if tr.value == value {
+		return []*Tree{tr}
+	}
+	for _, ch := range tr.children {
+		if p := ch.pathToNode(value); p != nil {
+			return append([]*Tree{tr}, p...)
+		}
+	}
+	return nil
+}
