 // POV problem-specific functions
 
 // FromPov returns the pov from the node specified in the argument.
 func (tr *Tree) FromPov(from string) *Tree {
-	panic("Please implement this function")
+	path := tr.pathToNode(from)
+	if path == nil {
+		return nil
+	}
+
+	// Start with the target node, keeping all of its children.
+	root := &Tree{value: path[len(path)-1].value}
+	root.children = append(root.children, path[len(path)-1].children...)
+
+	// Walk back up the path, re-parenting each ancestor as a child of the
+	// node below it. Each ancestor keeps all of its children except the one
+	// we came from.
+	current := root
+	for i := len(path) - 2; i >= 0; i-- {
+		ancestor := path[i]
+		child := path[i+1]
+		next := &Tree{value: ancestor.value}
+		for _, ch := range ancestor.children {
+			if ch != child {
+				next.children = append(next.children, ch)
+			}
+		}
+		current.children = append(current.children, next)
+		current = next
+	}
+
+	return root
 }
 
 // PathTo returns the shortest path between two nodes in the tree.
 func (tr *Tree) PathTo(from, to string) []string {
-	panic("Please implement this function")
+	fromPath := tr.pathToNode(from)
+	toPath := tr.pathToNode(to)
+	if fromPath == nil || toPath == nil {
+		return nil
+	}
+
+	// Find the lowest common ancestor by comparing the root paths.
+	i := 0
+	for i < len(fromPath) && i < len(toPath) && fromPath[i] == toPath[i] {
+		i++
+	}
+	// i is the index of the first differing node; the LCA is at i-1.
+	lca := i - 1
+
+	var result []string
+	// From the source up to the LCA (inclusive).
+	for j := len(fromPath) - 1; j >= lca; j-- {
+		result = append(result, fromPath[j].value)
+	}
+	// From the child of the LCA down to the destination.
+	for j := lca + 1; j < len(toPath); j++ {
+		result = append(result, toPath[j].value)
+	}
+
+	return result
 }
