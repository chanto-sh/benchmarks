+import random
+import string
+
+
 class Robot:
+    # Names handed out to every robot that currently exists, so a new name
+    # never collides with one already in use.
+    _used_names = set()
+
     def __init__(self):
-        pass
+        self.name = None
+        self.reset()
+
+    def reset(self):
+        old_name = self.name
+        new_name = self._generate_name()
+        while new_name in Robot._used_names or new_name == old_name:
+            new_name = self._generate_name()
+
+        if old_name is not None:
+            Robot._used_names.discard(old_name)
+        Robot._used_names.add(new_name)
+        self.name = new_name
+
+    @staticmethod
+    def _generate_name():
+        letters = "".join(random.choice(string.ascii_uppercase) for _ in range(2))
+        digits = "".join(random.choice(string.digits) for _ in range(3))
+        return letters + digits
