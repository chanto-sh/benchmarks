 pub fn abbreviate(phrase: &str) -> String {
-    todo!("Given the phrase '{phrase}', return its acronym");
+    let mut acronym = String::new();
+    let mut prev: Option<char> = None;
+    for c in phrase.chars() {
+        if c == ' ' || c == '-' {
+            prev = Some(c);
+        } else if c.is_alphabetic() {
+            let starts_word = prev.map_or(true, |p| p == ' ' || p == '-');
+            if starts_word || (c.is_uppercase() && prev.is_some_and(char::is_lowercase)) {
+                acronym.extend(c.to_uppercase());
+            }
+            prev = Some(c);
+        } else if c.is_numeric() {
+            prev = Some(c);
+        }
+        // other punctuation is removed without affecting word boundaries
+    }
+    acronym
 }
