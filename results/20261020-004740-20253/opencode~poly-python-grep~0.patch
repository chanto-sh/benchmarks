@@ -1,2 +1,63 @@
 def grep(pattern, flags, files):
-    pass
+    """Search files for lines containing ``pattern`` and return the matches.
+
+    ``flags`` is a string of whitespace-separated flags such as ``"-n -i"``.
+    Supported flags are ``-n`` (line numbers), ``-l`` (file names only),
+    ``-i`` (case-insensitive), ``-v`` (invert match) and ``-x`` (match the
+    entire line).
+    """
+    flag_set = set(flags.split())
+
+    case_insensitive = "-i" in flag_set
+    invert = "-v" in flag_set
+    entire_line = "-x" in flag_set
+    show_line_numbers = "-n" in flag_set
+    files_only = "-l" in flag_set
+
+    if case_insensitive:
+        needle = pattern.lower()
+    else:
+        needle = pattern
+
+    multiple_files = len(files) > 1
+    output = []
+
+    for filename in files:
+        with open(filename) as f:
+            lines = f.readlines()
+
+        matched_any = False
+
+        for line_number, raw_line in enumerate(lines, start=1):
+            line = raw_line.rstrip("\n")
+
+            if case_insensitive:
+                candidate = line.lower()
+            else:
+                candidate = line
+
+            if entire_line:
+                matched = candidate == needle
+            else:
+                matched = needle in candidate
+
+            if invert:
+                matched = not matched
+
+            if not matched:
+                continue
+
+            matched_any = True
+
+            if not files_only:
+                prefix = ""
+                if multiple_files:
+                    prefix += filename + ":"
+                if show_line_numbers:
+                    prefix += str(line_number) + ":"
+                output.append(prefix + line + "\n")
+
+        if files_only and matched_any:
+            output.append(filename + "\n")
+
+    return "".join(output)
