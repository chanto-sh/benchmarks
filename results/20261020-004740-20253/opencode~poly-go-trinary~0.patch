+import (
+	"errors"
+	"math"
+)
+
+var (
+	errInvalidDigit = errors.New("trinary: invalid digit")
+	errEmpty        = errors.New("trinary: empty string")
+	errOverflow     = errors.New("trinary: value overflows int64")
+)
+
+// ParseTrinary converts a trinary string to its decimal value.
+// Invalid input and values that do not fit in an int64 result in an error.
+func ParseTrinary(arg string) (int64, error) {
+	if len(arg) == 0 {
+		return 0, errEmpty
+	}
+
+	var value int64
+	for _, r := range arg {
+		if r < '0' || r > '2' {
+			return 0, errInvalidDigit
+		}
+		digit := int64(r - '0')
+		if value > (math.MaxInt64-digit)/3 {
+			return 0, errOverflow
+		}
+		value = value*3 + digit
+	}
+
+	return value, nil
 }
