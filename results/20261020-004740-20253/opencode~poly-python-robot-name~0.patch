+import random
+import string
+
+
 class Robot:
+    _used_names = set()
+
     def __init__(self):
-        pass
+        self.reset()
+
+    @property
+    def name(self):
+        return self._name
+
+    def reset(self):
+        previous_name = getattr(self, "_name", None)
+
+        if previous_name is not None:
+            self._used_names.discard(previous_name)
+
+        name = self._generate_name()
+        while name == previous_name or name in self._used_names:
+            name = self._generate_name()
+
+        self._used_names.add(name)
+        self._name = name
+
+    @staticmethod
+    def _generate_name():
+        letters = "".join(random.choice(string.ascii_uppercase) for _ in range(2))
+        digits = "".join(random.choice(string.digits) for _ in range(3))
+        return letters + digits
