 package piglatin
 
+import "strings"
+
+func isVowel(b byte) bool {
+	switch b {
+	case 'a', 'e', 'i', 'o', 'u':
+		return true
+	}
+	return false
+}
+
+func translate(word string) string {
+	if word == "" {
+		return word
+	}
+
+	// Rule 1: words beginning with a vowel, "xr", or "yt" simply get "ay".
+	if isVowel(word[0]) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
+		return word + "ay"
+	}
+
+	// Find the consonant cluster at the start of the word. A "y" is treated
+	// as a consonant only at the very beginning; after other consonants it
+	// acts as a vowel (rules 2 and 4). A "qu" is moved along with the
+	// preceding consonants (rule 3).
+	i := 0
+	for i < len(word) {
+		c := word[i]
+		if isVowel(c) {
+			break
+		}
+		if c == 'y' && i > 0 {
+			break
+		}
+		if c == 'q' && i+1 < len(word) && word[i+1] == 'u' {
+			i += 2
+			break
+		}
+		i++
+	}
+
+	return word[i:] + word[:i] + "ay"
+}
+
 func Sentence(sentence string) string {
-	panic("Please implement the Sentence function")
+	words := strings.Fields(sentence)
+	for i, word := range words {
+		words[i] = translate(word)
+	}
+	return strings.Join(words, " ")
 }
