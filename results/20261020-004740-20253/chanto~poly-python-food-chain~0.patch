+ANIMALS = [
+    ("fly", None),
+    ("spider", "It wriggled and jiggled and tickled inside her."),
+    ("bird", "How absurd to swallow a bird!"),
+    ("cat", "Imagine that, to swallow a cat!"),
+    ("dog", "What a hog, to swallow a dog!"),
+    ("goat", "Just opened her throat and swallowed a goat!"),
+    ("cow", "I don't know how she swallowed a cow!"),
+    ("horse", None),
+]
+
+CLOSING = "I don't know why she swallowed the fly. Perhaps she'll die."
+
+SPIDER = "spider"
+SPIDER_CLAUSE = " that wriggled and jiggled and tickled inside her"
+
+
+def _verse(index):
+    animal, remark = ANIMALS[index - 1]
+    lines = ["I know an old lady who swallowed a {}.".format(animal)]
+
+    if animal == "horse":
+        lines.append("She's dead, of course!")
+        return lines
+
+    if remark:
+        lines.append(remark)
+
+    for current in range(index - 1, 0, -1):
+        prey = ANIMALS[current - 1][0]
+        line = "She swallowed the {} to catch the {}.".format(
+            ANIMALS[current][0], prey
+        )
+        if prey == SPIDER:
+            line = line[:-1] + SPIDER_CLAUSE + "."
+        lines.append(line)
+
+    lines.append(CLOSING)
+    return lines
+
+
 def recite(start_verse, end_verse):
-    pass
+    lyrics = []
+    for index in range(start_verse, end_verse + 1):
+        if lyrics:
+            lyrics.append("")
+        lyrics.extend(_verse(index))
