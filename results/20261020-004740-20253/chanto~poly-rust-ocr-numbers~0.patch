+/// The three non-blank rows of each digit, three columns wide.
+const DIGITS: [[&str; 3]; 10] = [
+    [" _ ", "| |", "|_|"], // 0
+    ["   ", "  |", "  |"], // 1
+    [" _ ", " _|", "|_ "], // 2
+    [" _ ", " _|", " _|"], // 3
+    ["   ", "|_|", "  |"], // 4
+    [" _ ", "|_ ", " _|"], // 5
+    [" _ ", "|_ ", "|_|"], // 6
+    [" _ ", "  |", "  |"], // 7
+    [" _ ", "|_|", "|_|"], // 8
+    [" _ ", "|_|", " _|"], // 9
+];
+
 pub fn convert(input: &str) -> Result<String, Error> {
-    todo!("Convert the input '{input}' to a string");
+    let rows: Vec<Vec<char>> = input.lines().map(|line| line.chars().collect()).collect();
+
+    if rows.len() % 4 != 0 {
+        return Err(Error::InvalidRowCount(rows.len()));
+    }
+
+    let width = rows.first().map_or(0, Vec::len);
+    if width % 3 != 0 {
+        return Err(Error::InvalidColumnCount(width));
+    }
+    for row in &rows {
+        if row.len() != width {
+            return Err(Error::InvalidColumnCount(row.len()));
+        }
+    }
+
+    let mut numbers = Vec::new();
+    for block in rows.chunks(4) {
+        let mut number = String::new();
+        for column in (0..width).step_by(3) {
+            let glyph: [String; 3] = [0, 1, 2].map(|r| block[r][column..column + 3].iter().collect());
+            match DIGITS.iter().position(|digit| {
+                digit[0] == glyph[0] && digit[1] == glyph[1] && digit[2] == glyph[2]
+            }) {
+                Some(d) => number.push(char::from(b'0' + d as u8)),
+                None => number.push('?'),
+            }
+        }
+        numbers.push(number);
+    }
+
+    Ok(numbers.join(","))
 }
