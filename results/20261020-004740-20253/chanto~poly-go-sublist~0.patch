+
+// contains reports whether sub appears as a contiguous subsequence of list.
+func contains(list, sub []int) bool {
+	if len(sub) > len(list) {
+		return false
+	}
+	for i := 0; i+len(sub) <= len(list); i++ {
+		match := true
+		for j := range sub {
+			if list[i+j] != sub[j] {
+				match = false
+				break
+			}
+		}
+		if match {
+			return true
+		}
+	}
+	return false
 }
