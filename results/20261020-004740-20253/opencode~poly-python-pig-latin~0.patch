+import re
+
+
+VOWELS = "aeiou"
+
+
+def _translate_word(word):
+    # Rule 1: starts with a vowel, "xr", or "yt".
+    if word[0] in VOWELS or word.startswith(("xr", "yt")):
+        return word + "ay"
+
+    # Rule 3: zero or more consonants followed by "qu".
+    match = re.match(r"^([^aeiou]*qu)", word)
+    if match:
+        return word[match.end():] + match.group(1) + "ay"
+
+    # Rule 4: one or more consonants followed by "y".
+    match = re.match(r"^([^aeiou]+)y", word)
+    if match:
+        consonants = match.group(1)
+        return word[len(consonants):] + consonants + "ay"
+
+    # Rule 2: one or more leading consonants.
+    match = re.match(r"^([^aeiou]+)", word)
+    return word[match.end():] + match.group(1) + "ay"
+
+
 def translate(text):
-    pass
+    return " ".join(_translate_word(word) for word in text.split())
