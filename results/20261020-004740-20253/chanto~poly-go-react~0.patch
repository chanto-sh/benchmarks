+
+// propagate updates all cells reachable from start. Cells are processed in
+// topological order so each one observes the already-updated values of its
+// dependencies. A compute cell is only recomputed when one of its
+// dependencies actually changed, and callbacks fire once, after the whole
+// system has reached a new stable state, only for cells whose value changed.
+func (r *reactor) propagate(start *cell) {
+	affected := make(map[*cell]bool)
+	var gather func(*cell)
+	gather = func(c *cell) {
+		for _, d := range c.dependents {
+			if !affected[d] {
+				affected[d] = true
+				gather(d)
+			}
+		}
+	}
+	gather(start)
+
+	// Topological order of the affected subgraph.
+	var order []*cell
+	visited := make(map[*cell]bool)
+	var visit func(*cell)
+	visit = func(c *cell) {
+		if visited[c] {
+			return
+		}
+		visited[c] = true
+		for _, d := range c.deps {
+			if affected[d] {
+				visit(d)
+			}
+		}
+		order = append(order, c)
+	}
+	for c := range affected {
+		visit(c)
+	}
+
+	changed := map[*cell]bool{start: true}
+	for _, c := range order {
+		if c.compute == nil {
+			continue
+		}
+		stale := false
+		for _, d := range c.deps {
+			if changed[d] {
+				stale = true
+				break
+			}
+		}
+		if !stale {
+			continue
+		}
+		old := c.value
+		c.value = c.compute()
+		if c.value != old {
+			changed[c] = true
+		}
+	}
+
+	for _, c := range order {
+		if changed[c] {
+			c.notify(c.value)
+		}
+	}
 }
