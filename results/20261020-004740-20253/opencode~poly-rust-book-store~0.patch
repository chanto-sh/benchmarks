+use std::collections::HashMap;
+
+/// Cost in cents of a group of `n` distinct books.
+fn group_price(n: u32) -> u32 {
+    let discount = match n {
+        1 => 0,
+        2 => 5,
+        3 => 10,
+        4 => 20,
+        5 => 25,
+        _ => unreachable!("a group can contain at most 5 distinct books"),
+    };
+    n * 800 * (100 - discount) / 100
+}
+
 pub fn lowest_price(books: &[u32]) -> u32 {
-    todo!("Find the lowest price of the bookbasket with books {books:?}")
+    let mut counts = [0u32; 5];
+    for &book in books {
+        // Ignore anything outside the five known titles.
+        if let Some(slot) = counts.get_mut((book as usize).wrapping_sub(1)) {
+            *slot += 1;
+        }
+    }
+
+    let mut memo: HashMap<[u32; 5], u32> = HashMap::new();
+    solve(counts, &mut memo)
+}
+
+fn solve(mut counts: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
+    // The order of the five titles is irrelevant, so canonicalise the state.
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+
+    if counts[0] == 0 {
+        return 0;
+    }
+    if let Some(&cached) = memo.get(&counts) {
+        return cached;
+    }
+
+    // Try every non-empty subset of the available titles as the next group.
+    let mut best = u32::MAX;
+    for mask in 1u32..(1 << 5) {
+        let mut next = counts;
+        let mut size = 0;
+        let mut valid = true;
+        for (slot, count) in next.iter_mut().enumerate() {
+            if mask & (1 << slot) != 0 {
+                if *count == 0 {
+                    valid = false;
+                    break;
+                }
+                *count -= 1;
+                size += 1;
+            }
+        }
+        if valid {
+            best = best.min(group_price(size) + solve(next, memo));
+        }
+    }
+
+    memo.insert(counts, best);
+    best
 }
