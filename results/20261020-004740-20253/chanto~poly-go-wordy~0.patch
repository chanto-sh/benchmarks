 package wordy
 
+import (
+	"strconv"
+	"strings"
+)
+
+const prefix = "What is"
+
+// Answer parses a verbal math problem and evaluates it left-to-right.
+// The second return value is false if the question is not a valid problem.
 func Answer(question string) (int, bool) {
-	panic("Please implement the Answer function")
+	if !strings.HasPrefix(question, prefix) || !strings.HasSuffix(question, "?") {
+		return 0, false
+	}
+
+	fields := strings.Fields(question[len(prefix) : len(question)-1])
+	if len(fields) == 0 {
+		return 0, false
+	}
+
+	result, err := strconv.Atoi(fields[0])
+	if err != nil {
+		return 0, false
+	}
+
+	for i := 1; i < len(fields); {
+		op := fields[i]
+		i++
+
+		switch op {
+		case "plus", "minus":
+		case "multiplied", "divided":
+			if i >= len(fields) || fields[i] != "by" {
+				return 0, false
+			}
+			i++
+		default:
+			return 0, false
+		}
+
+		if i >= len(fields) {
+			return 0, false
+		}
+		operand, err := strconv.Atoi(fields[i])
+		if err != nil {
+			return 0, false
+		}
+		i++
+
+		switch op {
+		case "plus":
+			result += operand
+		case "minus":
+			result -= operand
+		case "multiplied":
+			result *= operand
+		case "divided":
+			if operand == 0 {
+				return 0, false
+			}
+			result /= operand
+		}
+	}
+
+	return result, true
 }
