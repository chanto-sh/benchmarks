+// Build reconstructs a tree from an unsorted list of records. Records have
+// IDs in the range [0, len(records)) and every non-root record has a parent
+// with a lower ID. Invalid input (missing root, duplicates, non-continuous
+// IDs, cycles or a parent that isn't lower than its child) yields an error.
 func Build(records []Record) (*Node, error) {
-	panic("Please implement the Build function")
+	if len(records) == 0 {
+		return nil, nil
+	}
+
+	n := len(records)
+	nodes := make([]*Node, n)
+	parentByID := make([]int, n)
+	for _, r := range records {
+		if r.ID < 0 || r.ID >= n || r.Parent < 0 || r.Parent >= n {
+			return nil, errInvalidID
+		}
+		if nodes[r.ID] != nil {
+			return nil, errDuplicateID
+		}
+		if r.ID == 0 {
+			if r.Parent != 0 {
+				return nil, errInvalidRoot
+			}
+		} else if r.Parent >= r.ID {
+			// Also covers cycles and parents with a higher ID.
+			return nil, errInvalidTree
+		}
+		nodes[r.ID] = &Node{ID: r.ID}
+		parentByID[r.ID] = r.Parent
+	}
+
+	if nodes[0] == nil {
+		return nil, errInvalidRoot
+	}
+
+	// Children are attached in ascending ID order, which follows from their
+	// parents always having a lower ID.
+	for id := 1; id < n; id++ {
+		parent := nodes[parentByID[id]]
+		parent.Children = append(parent.Children, nodes[id])
+	}
+
+	return nodes[0], nil
 }
