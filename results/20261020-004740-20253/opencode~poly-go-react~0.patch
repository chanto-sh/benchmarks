+// cell implements both InputCell and ComputeCell. Input cells have a nil
+// compute function; compute cells store an eagerly evaluated value.
+type cell struct {
+	reactor *reactor
+	value   int
+	compute func() int
+
+	// deps and depValues are used to detect which compute cells are affected
+	// by a change, so their compute functions run only when needed.
+	deps      []Cell
+	depValues []int
+
+	callbacks []*callback
+	nextID    int
 }
 
 func (c *cell) Value() int {
-	panic("Please implement the Value function")
