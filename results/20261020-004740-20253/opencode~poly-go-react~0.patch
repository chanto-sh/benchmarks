+		return
+	}
+	c.value = value
+	c.reactor.propagate()
+}
+
+func (c *cell) AddCallback(fn func(int)) Canceler {
+	id := c.nextID
+	c.nextID++
+	c.callbacks = append(c.callbacks, &callback{id: id, fn: fn, active: true})
+	return &canceler{cell: c, id: id}
 }
 
-func (c *cell) AddCallback(callback func(int)) Canceler {
-	panic("Please implement the AddCallback function")
+func (c *cell) removeCallback(id int) {
+	for i, cb := range c.callbacks {
+		if cb.id == id {
+			cb.active = false
+			c.callbacks = append(c.callbacks[:i], c.callbacks[i+1:]...)
+			return
+		}
+	}
+}
