+
+// propagate recomputes affected compute cells in creation order, then notifies
+// callbacks of cells whose value changed. Because compute cells are visited in
+// dependency order, each affected cell is recomputed at most once. Callbacks
+// run only after the whole system has reached a new stable state.
+func (r *reactor) propagate() {
+	var changed []*cell
+	for _, c := range r.computes {
+		dirty := false
+		for i, dep := range c.deps {
+			if v := dep.Value(); v != c.depValues[i] {
+				c.depValues[i] = v
+				dirty = true
+			}
+		}
+		if !dirty {
+			continue
+		}
+		value := c.compute()
+		if value != c.value {
+			c.value = value
+			changed = append(changed, c)
+		}
+	}
+	for _, c := range changed {
+		// Snapshot so callbacks may safely cancel themselves or others.
+		callbacks := append([]*callback(nil), c.callbacks...)
+		for _, cb := range callbacks {
+			if cb.active {
+				cb.fn(c.value)
+			}
+		}
+	}
 }
