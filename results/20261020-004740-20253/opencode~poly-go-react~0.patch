 // Define reactor, cell and canceler types here.
 // These types will implement the Reactor, Cell and Canceler interfaces, respectively.
 
+// callback is a single registered change notification handler.
+type callback struct {
+	id     int
+	fn     func(int)
+	active bool
+}
+
+// canceler removes a callback from a cell.
