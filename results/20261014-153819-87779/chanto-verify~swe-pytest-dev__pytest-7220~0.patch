@@ -161,10 +161,24 @@ def not_expr(s: Scanner) -> ast.expr:
         return ret
     ident = s.accept(TokenType.IDENT)
     if ident:
-        return ast.Name(ident.value, ast.Load())
+        return ast.Name(_mangle_ident(ident.value), ast.Load())
     s.reject((TokenType.NOT, TokenType.LPAREN, TokenType.IDENT))
 
 
+# The Python compiler refuses ``ast.Name`` nodes whose identifier is one of
+# ``None``, ``True`` or ``False``, as it interprets them as constants.  Keyword
+# expressions can contain such identifiers, so prefix them with a space, which
+# the scanner never produces as part of an identifier, and strip it again when
+# looking the identifier up.
+_CONSTANT_IDENTIFIERS = frozenset(("None", "True", "False"))
+
+
+def _mangle_ident(name: str) -> str:
+    if name in _CONSTANT_IDENTIFIERS:
+        return " " + name
+    return name
+
