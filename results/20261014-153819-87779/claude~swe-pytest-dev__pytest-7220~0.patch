+    def test_path_is_relative_to_invocation_dir_when_cwd_changed(self, testdir):
+        """The reported path should not depend on the current working
+        directory, which may be changed by a fixture (#5176).
+        """
+        testdir.makepyfile(
+            """
+            import os
+            import pytest
+
+            @pytest.fixture
+            def private_dir(tmp_path):
+                old_dir = os.getcwd()
+                os.chdir(str(tmp_path))
+                yield tmp_path
+                os.chdir(old_dir)
+
+            def test_show_wrong_path(private_dir):
+                assert False
+        """
+        )
+        result = testdir.runpytest()
+        result.stdout.fnmatch_lines(
+            ["test_path_is_relative_to_invocation_dir_when_cwd_changed.py:*: AssertionError"]
+        )
+
+    def test_path_is_relative_to_invocation_dir_when_cwd_changed_monkeypatch(
+        self, testdir
+    ):
+        """Same as above, but using ``monkeypatch.chdir`` (#5176)."""
+        testdir.makepyfile(
+            """
+            import pytest
+
+            @pytest.fixture
+            def private_dir(tmp_path, monkeypatch):
+                monkeypatch.chdir(tmp_path)
+                yield tmp_path
+
+            def test_show_wrong_path(private_dir):
+                assert False
+        """
+        )
+        result = testdir.runpytest()
+        result.stdout.fnmatch_lines(
+            [
+                "test_path_is_relative_to_invocation_dir_when_cwd_changed_monkeypatch.py:*: AssertionError"
+            ]
+        )
+
