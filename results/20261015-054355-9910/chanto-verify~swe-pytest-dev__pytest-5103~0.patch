     return node
 
 
+def _iter_target_names(target):
+    """Yield all names bound by an assignment target of a ``for`` loop."""
+    if isinstance(target, ast.Name):
+        yield target.id
+    elif isinstance(target, (ast.Tuple, ast.List)):
+        for elt in target.elts:
+            for name in _iter_target_names(elt):
+                yield name
+    elif isinstance(target, getattr(ast, "Starred", ())):
+        for name in _iter_target_names(target.value):
+            yield name
+
