+    @staticmethod
+    def _is_all_any_comprehension(call):
+        """Return True if *call* is ``all``/``any`` over a comprehension.
+
+        Only calls which pass exactly one positional argument which is a
+        generator expression or a list/set comprehension can be unrolled.
+        """
+        if not (
+            isinstance(call.func, ast.Name)
+            and call.func.id in ("all", "any")
+            and len(call.args) == 1
+            and not call.keywords
+            and isinstance(call.args[0], (ast.GeneratorExp, ast.ListComp, ast.SetComp))
+        ):
+            return False
+        # Async comprehensions cannot be unrolled into a synchronous for loop.
+        return not any(getattr(g, "is_async", False) for g in call.args[0].generators)
+
+    def _capture(self, node):
+        """Visit *node* collecting the statements it generates.
+
+        The statements are removed from ``self.statements`` and returned
+        together with the ``(res, expl)`` pair produced by the visitor.
+        """
+        saved = self.statements
+        self.statements = []
+        try:
+            res, expl = self.visit(node)
+            statements = self.statements
+        finally:
+            self.statements = saved
+        return statements, res, expl
+
+    def _unroll_generators(self, generators, body):
+        """Turn a list of ``ast.comprehension`` into nested ``for`` loops.
+
+        *body* is the innermost loop body; the returned statement list
+        evaluates the innermost iterable of each loop.
+        """
+        if not generators:
+            return body
+        gen = generators[0]
+        for condition in reversed(gen.ifs):
+            condition_statements, condition_res, _ = self._capture(condition)
+            body = condition_statements + [ast.If(condition_res, body, [])]
+        body = self._unroll_generators(generators[1:], body)
+        iter_statements, iter_res, _ = self._capture(gen.iter)
+        return iter_statements + [ast.For(gen.target, iter_res, body, [])]
+
+    @staticmethod
+    def _target_names(target):
+        """Return the names bound by a ``for`` loop *target*."""
+        if isinstance(target, ast.Name):
+            return [target.id]
+        if isinstance(target, (ast.Tuple, ast.List)):
+            names = []
+            for element in target.elts:
+                names.extend(AssertionRewriter._target_names(element))
+            return names
+        return []
+
+    def _visit_all_any(self, call):
+        """Rewrite ``all``/``any`` over a comprehension by unrolling it.
+
+        The comprehension is rewritten into an equivalent ``for`` loop which
+        stops at the first element deciding the result.  This way a failing
+        assertion reports the element for which the predicate failed, just
+        like a hand-written loop would.
+        """
+        is_all = call.func.id == "all"
+        comp = call.args[0]
+
+        variable_count = len(self.variables)
+        result = self.variable()
+        target_names = []
+        for gen in comp.generators:
+            target_names.extend(self._target_names(gen.target))
+
+        # Evaluate the element expression inside the loop; the explanation
+        # refers to the temporaries which hold the failing element.
+        element_statements, element_res, element_expl = self._capture(comp.elt)
+        if is_all:
+            break_condition = ast.UnaryOp(ast.Not(), element_res)
+        else:
+            break_condition = element_res
+        body = element_statements + [
+            ast.Assign([ast.Name(result, ast.Store())], element_res),
+            ast.If(break_condition, [ast.Break()], []),
+        ]
+        loop = self._unroll_generators(comp.generators, body)
+
+        # Make sure the loop variables and temporaries are defined even if the
+        # iterable turns out to be empty.
+        new_variables = [
+            ast.Name(name, ast.Store()) for name in self.variables[variable_count:]
+        ]
+        new_variables += [ast.Name(name, ast.Store()) for name in target_names]
+        if new_variables:
+            self.statements.append(ast.Assign(new_variables, _NameConstant(None)))
+        self.statements.append(
+            ast.Assign([ast.Name(result, ast.Store())], _NameConstant(is_all))
+        )
+        self.statements.extend(loop)
+        return ast.Name(result, ast.Load()), element_expl
+
