diff --git a/testing/test_assert_unroll.py b/testing/test_assert_unroll.py
new file mode 100644
index 0000000..7b17115
--- /dev/null
+++ b/testing/test_assert_unroll.py
@@ -0,0 +1,85 @@
+import pytest
+
+
+def test_assert_all_unrolls(testdir):
+    testdir.makepyfile(
+        """
+        def is_even(number):
+            return number % 2 == 0
+
+        def test_foo():
+            even_stevens = list(range(1, 100, 2))
+            assert all(is_even(number) for number in even_stevens)
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*assert False*", "*where False = is_even(1)*"])
+
+
+def test_assert_all_list_comprehension_unrolls(testdir):
+    testdir.makepyfile(
+        """
+        def test_foo():
+            assert all([x == 1 for x in [1, 2, 3]])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*assert 2 == 1*"])
+
+
+def test_assert_any_unrolls(testdir):
+    testdir.makepyfile(
+        """
+        def test_foo():
+            assert any(x > 5 for x in [1, 2, 3])
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*assert 3 > 5*"])
+
+
+def test_assert_all_stops_at_first_failure(testdir):
+    testdir.makepyfile(
+        """
+        import pytest
+
+        def test_foo():
+            consumed = []
+
+            def predicate(x):
+                consumed.append(x)
+                return x < 3
+
+            with pytest.raises(AssertionError):
+                assert all(predicate(x) for x in [1, 2, 3, 4])
+            assert consumed == [1, 2, 3]
+        """
+    )
+    result = testdir.runpytest()
+    assert result.ret == 0
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "assert all(x for x in range(1, 4))",
+        "assert any(x for x in range(4))",
+        "assert all(x % 2 == 0 for x in [2, 4, 6])",
+        "assert any(x > 2 for x in [1, 2, 3])",
+        "assert all(x == y for y in [1, 2] for x in [y, y])",
+        "assert all(x % 2 for x in [3, 5, 7] if x > 2)",
+        "assert all([]) is True",
+        "assert any([]) is False",
+    ],
+)
+def test_assert_all_any_result_is_correct(testdir, source):
+    testdir.makepyfile(
+        """
+        def test_foo():
+            {}
+        """.format(
+            source
+        )
+    )
+    result = testdir.runpytest()
+    assert result.ret == 0
