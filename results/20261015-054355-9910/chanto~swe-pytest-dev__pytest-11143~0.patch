+    def test_rewrite_first_expr_number_literal(self) -> None:
+        """A non-string literal as the first expression is not a docstring (#11143)."""
+        s = """123\nassert 1"""
+        m = rewrite(s)
+        assert isinstance(m.body[0], ast.Import)
+        assert isinstance(m.body[1], ast.Import)
+        assert isinstance(m.body[2], ast.Expr)
+        assert isinstance(m.body[2].value, ast.Constant)
+        assert m.body[2].value.value == 123
+
