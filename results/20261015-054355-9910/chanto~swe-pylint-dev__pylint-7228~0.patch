diff --git a/tests/config/test_regexp_error.py b/tests/config/test_regexp_error.py
new file mode 100644
index 0000000..d23442f
--- /dev/null
+++ b/tests/config/test_regexp_error.py
@@ -0,0 +1,46 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/PyCQA/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Tests for the handling of invalid regular expressions in the configuration."""
+
+from __future__ import annotations
+
+import argparse
+from os.path import abspath, dirname, join
+from pathlib import Path
+
+import pytest
+
+from pylint.config.argument import _regexp_transformer
+from pylint.testutils._run import _Run as Run
+
+HERE = abspath(dirname(__file__))
+EMPTY_MODULE = join(HERE, "..", "regrtest_data", "empty.py")
+
+
+def test_regexp_transformer_invalid_raises_clean_error() -> None:
+    """An invalid regexp raises an ``ArgumentTypeError`` instead of crashing."""
+    with pytest.raises(argparse.ArgumentTypeError):
+        _regexp_transformer("[\\p{Han}]")
+
+
+def test_regexp_transformer_valid() -> None:
+    """A valid regexp is compiled as usual."""
+    assert _regexp_transformer("foo.*").pattern == "foo.*"
+
+
+def test_invalid_regexp_on_command_line() -> None:
+    """An invalid regexp passed on the command line does not crash pylint."""
+    with pytest.raises(SystemExit) as ex:
+        Run([EMPTY_MODULE, "--function-rgx=[\\p{Han}]"])
+    assert ex.value.code == 2
+
+
+def test_invalid_regexp_in_rcfile(tmp_path: Path) -> None:
+    """An invalid regexp in a pylintrc file is reported cleanly."""
+    rcfile = tmp_path / "pylintrc"
+    rcfile.write_text("[MASTER]\nfunction-rgx=[\\p{Han}a-z_]\n")
+    with pytest.raises(SystemExit) as ex:
+        Run([EMPTY_MODULE, f"--rcfile={rcfile}"])
+    assert ex.value.code == 2
