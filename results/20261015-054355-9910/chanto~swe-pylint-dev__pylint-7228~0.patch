+def _regexp_transformer(pattern: str) -> Pattern[str]:
+    """Transforms a string into a compiled regular expression.
+
+    A clean error is raised if the pattern is invalid. The optional ``regex``
+    module is used as a fallback so that patterns that the standard library
+    ``re`` module can't handle (e.g. ``\\p{Han}``) still work when it is
+    installed.
+    """
+    try:
+        return re.compile(pattern)
+    except re.error as exc:
+        if _HAS_REGEX:
+            try:
+                return cast(Pattern[str], regex.compile(pattern))
+            except Exception as regex_exc:  # pylint: disable=broad-except
+                raise _InvalidRegexpError(
+                    f"Invalid regular expression '{pattern}': {regex_exc}"
+                ) from regex_exc
+        raise _InvalidRegexpError(
+            f"Invalid regular expression '{pattern}': {exc}"
+        ) from exc
+
