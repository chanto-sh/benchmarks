diff --git a/pylint/checkers/misc.py b/pylint/checkers/misc.py
index 69149e6..94eaf1b 100644
--- a/pylint/checkers/misc.py
+++ b/pylint/checkers/misc.py
@@ -119,11 +119,19 @@ class EncodingChecker(BaseChecker):
     def open(self):
         super().open()
 
-        notes = "|".join(re.escape(note) for note in self.config.notes)
+        # A note tag that ends with a word character must be followed by a word
+        # boundary so that it is not matched as part of a longer word (e.g.
+        # ``TODO`` should not match inside ``Todoist``). A note tag that ends
+        # with a non-word character (e.g. ``???``) cannot be followed by a word
+        # boundary, so no boundary is appended for it.
+        notes = "|".join(
+            re.escape(note) + (r"\b" if note and re.match(r"\w", note[-1]) else "")
+            for note in self.config.notes
+        )
         if self.config.notes_rgx:
-            regex_string = rf"#\s*({notes}|{self.config.notes_rgx})\b"
+            regex_string = rf"#\s*((?:{notes})|(?:{self.config.notes_rgx})\b)"
         else:
-            regex_string = rf"#\s*({notes})\b"
+            regex_string = rf"#\s*((?:{notes}))"
 
         self._fixme_pattern = re.compile(regex_string, re.I)
 
