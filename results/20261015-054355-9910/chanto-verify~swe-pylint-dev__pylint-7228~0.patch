@@ -126,3 +126,20 @@ def test_argument_separator(capsys: CaptureFixture) -> None:
     Run(["--", str(EMPTY_MODULE)], exit=False)
     output = capsys.readouterr()
     assert not output.err
+
+
+def test_invalid_regex(capsys: CaptureFixture) -> None:
+    """Check that we correctly error on an invalid regular expression.
+
+    Reported in https://github.com/PyCQA/pylint/issues/7228.
+    """
+    with pytest.raises(SystemExit):
+        Run(
+            [
+                str(EMPTY_MODULE),
+                r"--function-rgx=[\p{Han}a-z_][\p{Han}a-z0-9_]{2,30}$",
+            ],
+            exit=False,
+        )
+    output = capsys.readouterr()
+    assert "Invalid regular expression: bad escape \\p" in output.err
