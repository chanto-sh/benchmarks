+
+    @staticmethod
+    def test_regex_error() -> None:
+        """Check that we raise a proper error for an invalid regex."""
+        with pytest.raises(SystemExit) as ex:
+            Run(
+                [
+                    EMPTY_MODULE,
+                    "--function-rgx=[\\p{Han}a-z_][\\p{Han}a-z0-9_]{2,30}$",
+                ]
+            )
+        assert ex.value.code == 2
+        with pytest.raises(SystemExit) as ex:
+            Run(
+                [
+                    EMPTY_MODULE,
+                    "--ignore-patterns=[\\p{Han}a-z_][\\p{Han}a-z0-9_]{2,30}$",
+                ]
