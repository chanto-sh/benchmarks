+    def test_skipif_expression_is_evaluated_per_module(self, testdir):
+        """String conditions are evaluated against each module's globals (#7373)."""
+        testdir.makepyfile(
+            test_1="""
+            import pytest
+
+            skip_it = True
+
+            @pytest.mark.skipif("skip_it")
+            def test_skipped():
+                assert False
+            """,
+            test_2="""
+            import pytest
+
+            skip_it = False
+
+            @pytest.mark.skipif("skip_it")
+            def test_not_skipped():
+                assert False
+            """,
+        )
+        result = testdir.runpytest("-v")
+        result.stdout.fnmatch_lines(
+            [
+                "*test_1.py::test_skipped SKIPPED*",
+                "*test_2.py::test_not_skipped FAILED*",
+                "*1 failed, 1 skipped*",
+            ]
+        )
+        assert result.ret == 1
+
     @pytest.mark.parametrize(
         "marker, msg1, msg2",
         [("skipif", "SKIP", "skipped"), ("xfail", "XPASS", "xpassed")],
