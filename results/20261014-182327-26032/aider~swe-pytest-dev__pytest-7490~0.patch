diff --git a/changelog/7647.bugfix.rst b/changelog/7647.bugfix.rst
new file mode 100644
index 0000000..e5fb33f
--- /dev/null
+++ b/changelog/7647.bugfix.rst
@@ -0,0 +1,2 @@
+Fixed ``xfail`` markers added dynamically during a test through
+``request.node.add_marker`` not being honored.
diff --git a/src/_pytest/skipping.py b/src/_pytest/skipping.py
index 335e109..0b07c22 100644
--- a/src/_pytest/skipping.py
+++ b/src/_pytest/skipping.py
@@ -262,6 +262,11 @@ def pytest_runtest_makereport(item: Item, call: CallInfo[None]):
     outcome = yield
     rep = outcome.get_result()
     xfailed = item._store.get(xfailed_key, None)
+    if xfailed is None and not item.config.option.runxfail:
+        # ``xfail`` markers may have been added dynamically during the test run
+        # (for example via ``request.node.add_marker``), so re-evaluate them to
+        # make sure such markers are taken into account for the report.
+        item._store[xfailed_key] = xfailed = evaluate_xfail_marks(item)
     # unittest special case, see setting of unexpectedsuccess_key
     if unexpectedsuccess_key in item._store and rep.when == "call":
         reason = item._store[unexpectedsuccess_key]
diff --git a/testing/test_dynamic_xfail.py b/testing/test_dynamic_xfail.py
new file mode 100644
index 0000000..e37743c
--- /dev/null
+++ b/testing/test_dynamic_xfail.py
@@ -0,0 +1,55 @@
+import pytest
+
+
+def test_dynamic_xfail_marker_added_during_test(testdir):
+    """Dynamically adding an ``xfail`` marker during a test should xfail it (#7647)."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        def test_func(request):
+            mark = pytest.mark.xfail(reason="dynamic xfail")
+            request.node.add_marker(mark)
+            assert 0
+        """
+    )
+    result = testdir.runpytest("-rxX")
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(["*1 xfailed*"])
+
+
+def test_dynamic_xfail_marker_added_during_test_honors_raises(testdir):
+    """Dynamically added ``xfail`` markers should also honor ``raises`` (#7647)."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        def test_func(request):
+            mark = pytest.mark.xfail(raises=IndexError)
+            request.node.add_marker(mark)
+            raise IndexError()
+        """
+    )
+    result = testdir.runpytest("-rxX")
+    assert result.ret == 0
+    result.stdout.fnmatch_lines(["*1 xfailed*"])
+
+
+def test_dynamic_xfail_marker_added_during_test_with_unexpected_exception(testdir):
+    """A dynamically added ``xfail(raises=...)`` must not mask other failures."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+
+        def test_func(request):
+            mark = pytest.mark.xfail(raises=IndexError)
+            request.node.add_marker(mark)
+            assert 0
+        """
+    )
+    result = testdir.runpytest("-rxX")
+    assert result.ret == 1
+    result.stdout.fnmatch_lines(["*1 failed*"])
