diff --git a/src/_pytest/assertion/rewrite.py b/src/_pytest/assertion/rewrite.py
index 157903f..9bf79f1 100644
--- a/src/_pytest/assertion/rewrite.py
+++ b/src/_pytest/assertion/rewrite.py
@@ -676,6 +676,7 @@ class AssertionRewriter(ast.NodeVisitor):
                 expect_docstring
                 and isinstance(item, ast.Expr)
                 and isinstance(item.value, ast.Constant)
+                and isinstance(item.value.value, str)
             ):
                 doc = item.value.value
                 if self.is_rewrite_disabled(doc):
diff --git a/testing/test_assertrewrite.py b/testing/test_assertrewrite.py
index d018032..335fb64 100644
--- a/testing/test_assertrewrite.py
+++ b/testing/test_assertrewrite.py
@@ -2042,3 +2042,19 @@ class TestReprSizeVerbosity:
         self.create_test_file(pytester, DEFAULT_REPR_MAX_SIZE * 10)
         result = pytester.runpytest("-vv")
         result.stdout.no_fnmatch_line("*xxx...xxx*")
+
+
+def test_rewrite_first_expression_not_str(pytester: Pytester) -> None:
+    """A non-string expression as the first statement should not be mistaken
+    for a docstring (#10613)."""
+    pytester.makepyfile(
+        """
+        # The first expression is a number, not a docstring.
+        123
+
+        def test_rewritten():
+            assert "@py_builtins" in globals()
+    """
+    )
+    result = pytester.runpytest()
+    result.assert_outcomes(passed=1)
