+    """Rewrite the assertions in f, run it, and get the failure message."""
+    src = "\n".join(_pytest._code.Code.from_function(f).source().lines)
+    mod = rewrite(src)
+    code = compile(mod, "<test>", "exec")
+    ns: Dict[str, object] = {}
+    if extra_ns is not None:
+        ns.update(extra_ns)
+    exec(code, ns)
+    func = ns[f.__name__]
