@@ -0,0 +1,53 @@
+# Licensed under the GPL: https://www.gnu.org/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/PyCQA/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Regression tests for invalid regular expressions in the configuration.
+
+Reported in https://github.com/PyCQA/pylint/issues/7228.
+"""
+
+from __future__ import annotations
+
+import argparse
+
+import pytest
+from pytest import CaptureFixture
+
+from pylint.config.argument import (
+    _regexp_csv_transfomer,
+    _regexp_paths_csv_transfomer,
+    _regexp_transformer,
+)
+from pylint.testutils._run import _Run as Run
+
+EMPTY_MODULE = "tests/regrtest_data/empty.py"
+
+
+@pytest.mark.parametrize(
+    "transformer, value",
+    [
+        (_regexp_transformer, r"[\p{Han}]"),
+        (_regexp_csv_transfomer, r"[\p{Han}]"),
+        (_regexp_paths_csv_transfomer, "("),
+    ],
+)
+def test_invalid_regexp_raises_argument_error(transformer, value: str) -> None:
+    """An invalid regexp raises a clean ArgumentTypeError, not a traceback."""
+    with pytest.raises(argparse.ArgumentTypeError):
+        transformer(value)
+
+
+def test_valid_regexp_still_works() -> None:
+    """A valid regexp is still compiled as before."""
+    assert _regexp_transformer("test_.*").pattern == "test_.*"
+
+
+def test_invalid_regexp_in_config_file_does_not_crash(capsys: CaptureFixture) -> None:
+    """An invalid regexp given on the command line exits cleanly."""
+    with pytest.raises(SystemExit) as ex:
+        Run([EMPTY_MODULE, r"--function-rgx=[\p{Han}]"], exit=False)
+    assert ex.value.code == 2
+    output = capsys.readouterr()
+    assert "Invalid regexp" in output.err
+    assert "Traceback" not in output.err
