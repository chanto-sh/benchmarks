+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/PyCQA/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Tests for the argument transformers in ``pylint.config.argument``."""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+import pytest
+
+from pylint.config.argument import (
+    _regexp_transformer,
+    _TYPE_TRANSFORMERS,
+)
+from pylint.lint import PyLinter
+
+
+def test_regexp_transformer_returns_compiled_pattern() -> None:
+    """A valid regex should be compiled."""
+    pattern = _regexp_transformer(r"[a-z_][a-z0-9_]*$")
+    assert isinstance(pattern, re.Pattern)
+    assert pattern.match("valid_name")
+
+
+def test_regexp_transformer_raises_argument_type_error() -> None:
+    """An invalid regex should raise an ``argparse.ArgumentTypeError``.
+
+    This is a regression test for the crash reported when using PCRE-only
+    syntax (e.g. ``\\p{Han}``, which Python's ``re`` module does not support)
+    in a regexp option such as ``function-rgx``.
+    """
+    with pytest.raises(argparse.ArgumentTypeError):
+        _regexp_transformer(r"[\p{Han}a-z_][\p{Han}a-z0-9_]{2,30}$")
+
+
+def test_regexp_transformer_is_registered_as_regexp_type() -> None:
+    """The ``regexp`` option type must use the safe transformer."""
+    assert _TYPE_TRANSFORMERS["regexp"] is _regexp_transformer
+
+
+def test_invalid_regexp_in_config_file_exits_cleanly(tmp_path: Path) -> None:
+    """Pylint should not emit a traceback when the config contains a bad regex.
+
+    Instead, argparse should handle the ``ArgumentTypeError`` and exit via
+    ``SystemExit`` (code 2), without leaking a ``re.error``.
+    """
+    config_file = tmp_path / "pylintrc"
+    config_file.write_text(
+        "[MAIN]\nfunction-rgx=[\\p{Han}a-z_][\\p{Han}a-z0-9_]{2,30}$\n",
+        encoding="utf-8",
+    )
+
+    linter = PyLinter()
+    linter.load_default_plugins()
+
+    with pytest.raises(SystemExit) as exc_info:
+        # Simulate what ``pylint`` does after reading the configuration file:
+        # the regexp option is parsed and must fail with a clean error.
+        linter._arg_parser.parse_known_args(
+            ["--function-rgx", r"[\p{Han}a-z_][\p{Han}a-z0-9_]{2,30}$"]
+        )
+
+    assert exc_info.value.code == 2
+````
+
+## Explanation of the changes
+
+- **`pylint/config/argument.py`**
+  - Added `_regexp_transformer`, which calls `re.compile` and converts any `re.error` into an `argparse.ArgumentTypeError`. argparse catches `ArgumentTypeError` in `_get_value()` and turns it into a usage error, so the user sees something like:
+    ```
+    pylint: error: '[\p{Han}a-z_]' is not a valid regex: bad escape \p at position 1
+    ```
+    instead of a full traceback, and the process exits with code `2`.
+  - `_regexp_csv_transfomer` and `_regexp_paths_csv_transfomer` now delegate to `_regexp_transformer`, so `regexp_csv` and `regexp_paths_csv` options also fail gracefully.
+  - `_TYPE_TRANSFORMERS["regexp"]` now points to `_regexp_transformer` instead of `re.compile`.
+
+## Running the relevant tests
+
+- New regression tests: `pytest tests/config/test_argument.py`
+- Whole config test suite (make sure nothing else broke): `pytest tests/config/`
+- Manual check:
+  ```bash
+  printf '[MAIN]\nfunction-rgx=[\\p{Han}a-z_]$\n' > /tmp/pylintrc
+  pylint --rcfile=/tmp/pylintrc your_module.py
+  ```
+
+Note: `\p{Han}` is not part of Python's standard `re` syntax, so it can't be *supported* without switching regex engines. The fix makes pylint report the problem cleanly rather than crashing.
