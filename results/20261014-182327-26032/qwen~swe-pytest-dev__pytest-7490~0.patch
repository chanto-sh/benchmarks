+        p = testdir.makepyfile(
+            """
+            import pytest
+            def test_this(request):
+                request.node.add_marker(pytest.mark.xfail(reason="xfail"))
+                assert 0
+        """
+        )
+        result = testdir.runpytest(p, "-rx")
+        result.stdout.fnmatch_lines(["*XFAIL*test_this*", "*xfail*", "*1 xfailed*"])
