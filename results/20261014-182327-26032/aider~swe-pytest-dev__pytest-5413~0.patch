diff --git a/changelog/5467.bugfix.rst b/changelog/5467.bugfix.rst
new file mode 100644
index 0000000..6ca6d01
--- /dev/null
+++ b/changelog/5467.bugfix.rst
@@ -0,0 +1,4 @@
+``ExceptionInfo`` now returns the exception string when calling ``str()`` on it, matching
+the behavior of ``str()`` on regular exceptions (e.g. ``str(exception)``). In order to obtain
+the previous string representation (which included the traceback location) use
+``str(excinfo.getrepr())`` or ``excinfo.traceback`` instead.
diff --git a/src/_pytest/_code/code.py b/src/_pytest/_code/code.py
index c4ed961..977e859 100644
--- a/src/_pytest/_code/code.py
+++ b/src/_pytest/_code/code.py
@@ -537,9 +537,7 @@ class ExceptionInfo:
     def __str__(self):
         if self._excinfo is None:
             return repr(self)
-        entry = self.traceback[-1]
-        loc = ReprFileLocation(entry.path, entry.lineno + 1, self.exconly())
-        return str(loc)
+        return str(self.value)
 
     def match(self, regexp):
         """
diff --git a/testing/code/test_excinfo.py b/testing/code/test_excinfo.py
index 3eac94a..053caa2 100644
--- a/testing/code/test_excinfo.py
+++ b/testing/code/test_excinfo.py
@@ -342,9 +342,14 @@ def test_excinfo_repr():
 def test_excinfo_str():
     excinfo = pytest.raises(ValueError, h)
     s = str(excinfo)
-    assert s.startswith(__file__[:-9])  # pyc file and $py.class
-    assert s.endswith("ValueError")
-    assert len(s.split(":")) >= 3  # on windows it's 4
+    assert s == str(excinfo.value)
+    assert s == ""
+
+    with pytest.raises(ValueError) as excinfo:
+        raise ValueError("hello\nworld")
+    s = str(excinfo)
+    assert s == str(excinfo.value)
+    assert s == "hello\nworld"
 
 
 def test_excinfo_for_later():
