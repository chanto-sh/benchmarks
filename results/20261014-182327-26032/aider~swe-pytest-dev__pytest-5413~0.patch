+class ExceptionChainRepr(ExceptionRepr):
+    def __init__(self, chain):
+        super().__init__()
+        self.chain = chain
+        # reprcrash and reprtraceback of the outermost (the newest) exception
+        # in the chain
+        self.reprtraceback = chain[-1][0]
+        self.reprcrash = chain[-1][1]
