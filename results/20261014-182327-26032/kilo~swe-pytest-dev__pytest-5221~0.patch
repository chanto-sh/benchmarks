+    def test_show_fixtures_with_scope(self, testdir):
+        p = testdir.makepyfile(
+            '''
+            import pytest
+            @pytest.fixture(scope="session")
+            def arg1():
+                """hello world"""
+            @pytest.fixture(scope="module")
+            def arg2():
+                """hello world"""
+            @pytest.fixture
+            def arg3():
+                """hello world"""
+        '''
+        )
+        result = testdir.runpytest("--fixtures", p)
+        result.stdout.fnmatch_lines(
+            """
+            * fixtures defined from test_show_fixtures_with_scope *
+            *hello world*
+        """
+        )
+        stdout = result.stdout.str()
+        assert "arg1 [session scope] -- test_show_fixtures_with_scope.py:" in stdout
+        assert "arg2 [module scope] -- test_show_fixtures_with_scope.py:" in stdout
+        assert "arg3 -- test_show_fixtures_with_scope.py:" in stdout
+
