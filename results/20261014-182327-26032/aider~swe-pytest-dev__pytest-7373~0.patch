+    def test_marked_skip_with_not_string(self, testdir) -> None:
+        item = testdir.getitem(
+            """
+            import pytest
+            @pytest.mark.skipif(False)
+            def test_func():
+                pass
+        """
+        )
+        ev = MarkEvaluator(item, "skipif")
+        exc = pytest.raises(pytest.fail.Exception, ev.istrue)
