+def test_skipif_mark_uses_test_module_globals(testdir):
+    """String conditions in skipif/xfail should not be cached across modules (#5104)."""
+    testdir.makepyfile(
+        test_skipif_module_1="""
+        import pytest
+
+        skip = True
+
+        @pytest.mark.skipif("skip")
+        def test_should_skip():
+            assert False
+        """,
+        test_skipif_module_2="""
+        import pytest
+
+        skip = False
+
+        @pytest.mark.skipif("skip")
+        def test_should_not_skip():
+            assert False
+        """,
+    )
+    result = testdir.runpytest("-v")
+    result.stdout.fnmatch_lines(
