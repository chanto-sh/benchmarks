index a186174..0f42322 100644
--- a/tests/test_self.py
+++ b/tests/test_self.py
@@ -221,6 +221,17 @@ class TestRunTC:
     def test_error_missing_arguments(self) -> None:
         self._runtest([], code=32)
 
+    def test_unrecognized_option(self) -> None:
+        """Test that an unrecognized option is reported without a traceback."""
+        out = StringIO()
+        self._runtest(["--my-unrecognized-option"], out=out, code=32)
+        output = out.getvalue()
+        assert (
+            "Command line:1:0: E0015: Unrecognized option found: my-unrecognized-option"
+            in output
+        )
+        assert "Traceback" not in output
+
