+def test_repr_raising_getattribute():
+    class A:
+        def __getattribute__(self, attr):
+            raise
+
+        def __repr__(self):
+            raise
+
+    obj = A()
+    s = saferepr(obj)
+    assert "raised in repr()" in s
+    assert "A object at 0x" in s
+
