+def test_iter_content_decode_unicode_falls_back_to_apparent_encoding():
+    """Regression test: when the response has no explicit ``encoding`` (e.g.
+    an ``application/json`` response with no charset in the Content-Type),
+    ``iter_content(decode_unicode=True)`` should fall back to the apparent
+    encoding, exactly like ``Response.text`` does, and yield ``str`` objects
+    rather than raw ``bytes``.
+    """
+    r = requests.Response()
+    r.status_code = 200
+    r.headers['content-type'] = 'application/json'
+    r.encoding = None
+    r._content = b'{"key": "value"}'
+    r._content_consumed = True
+
+    # Sanity check: no explicit encoding was provided.
+    assert r.encoding is None
+
+    chunks = list(r.iter_content(chunk_size=4, decode_unicode=True))
+
+    assert chunks == ['{"ke', 'y": ', '"val', 'ue"}']
+    assert all(isinstance(chunk, str) for chunk in chunks)
+    assert ''.join(chunks) == '{"key": "value"}'
+
+
+def test_iter_content_decode_unicode_yields_bytes_when_undetectable():
+    """If neither an explicit encoding nor an apparent encoding can be
+    determined, the raw bytes are yielded unchanged (no crash)."""
+    r = requests.Response()
+    r.status_code = 200
+    r.encoding = None
+    # chardet cannot detect an encoding for empty input.
+    r._content = b''
+    r._content_consumed = True
+
+    assert r.apparent_encoding is None
+    assert list(r.iter_content(chunk_size=4, decode_unicode=True)) == []
