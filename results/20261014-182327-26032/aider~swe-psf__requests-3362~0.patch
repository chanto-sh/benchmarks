+            assert isinstance(e, Timeout)
+
+    def test_total_timeout_connect(self):
+        try:
+            requests.get(TARPIT, timeout=(0.1, 0.1))
+            pytest.fail('The connect() request should time out.')
+        except ConnectTimeout:
+            pass
