+    def test_response_decode_unicode_without_encoding(self):
+        """
+        When no encoding is set (e.g. an ``application/json`` response with no
+        charset in the Content-Type), ``decode_unicode`` should fall back to
+        the apparent encoding, just like ``Response.text`` does.
+        """
+        r = requests.Response()
+        r._content_consumed = True
+        r._content = b'the content'
+        r.encoding = None
+
+        assert r.apparent_encoding is not None
+
+        chunks = list(r.iter_content(decode_unicode=True))
+        assert all(isinstance(chunk, str) for chunk in chunks)
+        assert ''.join(chunks) == 'the content'
