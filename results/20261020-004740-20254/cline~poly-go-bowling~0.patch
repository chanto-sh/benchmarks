+// complete reports whether every roll required to score the game has been made.
+func (g *Game) complete() bool {
+	i := 0
+	for frame := 0; frame < 9; frame++ {
+		if i >= len(g.rolls) {
+			return false
+		}
+		if g.rolls[i] == 10 {
+			i++
+		} else {
+			i += 2
+		}
+	}
+
+	if i >= len(g.rolls) {
+		return false
+	}
+	tenth := g.rolls[i:]
+	if tenth[0] == 10 {
+		return len(tenth) >= 3
+	}
+	if len(tenth) < 2 {
+		return false
+	}
+	if tenth[0]+tenth[1] == 10 {
+		return len(tenth) >= 3
+	}
+	return len(tenth) == 2
