+/// The three non-blank rows of each digit, joined with newlines.
+const DIGITS: [&str; 10] = [
+    " _ \n| |\n|_|", // 0
+    "   \n  |\n  |", // 1
+    " _ \n _|\n|_ ", // 2
+    " _ \n _|\n _|", // 3
+    "   \n|_|\n  |", // 4
+    " _ \n|_ \n _|", // 5
+    " _ \n|_ \n|_|", // 6
+    " _ \n  |\n  |", // 7
+    " _ \n|_|\n|_|", // 8
+    " _ \n|_|\n _|", // 9
+];
+
 pub fn convert(input: &str) -> Result<String, Error> {
-    todo!("Convert the input '{input}' to a string");
+    let mut lines: Vec<&str> = input.split('\n').collect();
+    // A trailing newline terminates the last row rather than starting a new one.
+    if input.ends_with('\n') {
+        lines.pop();
+    }
+
+    if lines.len() % 4 != 0 {
+        return Err(Error::InvalidRowCount(lines.len()));
+    }
+
+    let rows: Vec<Vec<char>> = lines.iter().map(|line| line.chars().collect()).collect();
+    let width = rows.first().map_or(0, |row| row.len());
+
+    for row in &rows {
+        if row.len() % 3 != 0 || row.len() != width {
+            return Err(Error::InvalidColumnCount(row.len()));
+        }
+    }
+
+    let mut numbers = Vec::new();
+    for block in rows.chunks(4) {
+        let mut number = String::new();
+        for start in (0..width).step_by(3) {
+            let key: String = block[..3]
+                .iter()
+                .map(|row| row[start..start + 3].iter().collect::<String>())
+                .collect::<Vec<_>>()
+                .join("\n");
+
+            let digit = DIGITS
+                .iter()
+                .position(|pattern| *pattern == key)
+                .and_then(|index| char::from_digit(index as u32, 10))
+                .unwrap_or('?');
+            number.push(digit);
+        }
+        numbers.push(number);
+    }
+
+    Ok(numbers.join(","))
 }
