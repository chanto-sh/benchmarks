 package bottlesong
 
+import "fmt"
+
+var numberWords = []string{
+	"no", "one", "two", "three", "four", "five",
+	"six", "seven", "eight", "nine", "ten",
+}
+
+// title capitalizes the first letter of the given word.
+func title(word string) string {
+	if word == "" {
+		return word
+	}
+	return string(word[0]-'a'+'A') + word[1:]
+}
+
+// bottlesPhrase returns the phrase describing the given number of bottles,
+// e.g. "Ten green bottles" or "one green bottle".
+func bottlesPhrase(n int) string {
+	word := numberWords[n]
+	if n == 1 {
+		return word + " green bottle"
+	}
+	return word + " green bottles"
+}
+
+// verse returns the four lines of the verse starting with n bottles.
+func verse(n int) []string {
+	current := title(bottlesPhrase(n))
+	remaining := bottlesPhrase(n - 1)
+	return []string{
+		fmt.Sprintf("%s hanging on the wall,", current),
+		fmt.Sprintf("%s hanging on the wall,", current),
+		"And if one green bottle should accidentally fall,",
+		fmt.Sprintf("There'll be %s hanging on the wall.", remaining),
+	}
+}
+
