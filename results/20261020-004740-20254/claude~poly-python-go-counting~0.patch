+    def _explore(self, x, y):
+        """Flood fill the empty region containing (x, y).
+
+        Returns the region's coordinates and the set of stone colors
+        bordering it.
+        """
+        region = set()
+        borders = set()
+        stack = [(x, y)]
+
+        while stack:
+            cx, cy = stack.pop()
+            if (cx, cy) in region:
+                continue
+            region.add((cx, cy))
+
+            for nx, ny in ((cx - 1, cy), (cx + 1, cy), (cx, cy - 1), (cx, cy + 1)):
