+
+def _add(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left + right)
+
+
+def _subtract(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left - right)
+
+
+def _multiply(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    stack.append(left * right)
+
+
+def _divide(stack):
+    _require(stack, 2)
+    right = stack.pop()
+    left = stack.pop()
+    if right == 0:
+        raise ZeroDivisionError("divide by zero")
+    # Forth division truncates toward zero.
+    quotient = abs(left) // abs(right)
+    stack.append(-quotient if (left < 0) != (right < 0) else quotient)
+
+
+def _dup(stack):
+    _require(stack, 1)
+    stack.append(stack[-1])
+
+
+def _drop(stack):
+    _require(stack, 1)
+    stack.pop()
+
+
+def _swap(stack):
+    _require(stack, 2)
+    stack[-2], stack[-1] = stack[-1], stack[-2]
+
+
+def _over(stack):
+    _require(stack, 2)
+    stack.append(stack[-2])
+
+
+_BUILTINS = {
+    "+": _add,
+    "-": _subtract,
+    "*": _multiply,
+    "/": _divide,
+    "DUP": _dup,
+    "DROP": _drop,
+    "SWAP": _swap,
+    "OVER": _over,
+}
+_BUILTINS = {name.lower(): operation for name, operation in _BUILTINS.items()}
+
+
+def _compile(word, dictionary, defining=None):
+    """Compile a single token into executable operations.
+
+    User-defined words are expanded while compiling so that later
+    redefinitions do not change the behaviour of existing definitions.
+    """
+    if _NUMBER_RE.fullmatch(word):
+        return [("push", int(word))]
+
+    name = word.lower()
+    if name in dictionary:
+        return list(dictionary[name])
+    if name in _BUILTINS:
+        return [("call", _BUILTINS[name])]
+    if name == defining:
+        # A self-reference with no previous definition can never resolve.
+        raise ValueError("undefined operation")
+    return [("unknown", name)]
+
+
+def _execute(operations, stack):
+    for kind, value in operations:
+        if kind == "push":
+            stack.append(value)
+        elif kind == "call":
+            value(stack)
+        else:
+            raise ValueError("undefined operation")
 
 
