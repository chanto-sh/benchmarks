 // Define reactor, cell and canceler types here.
 // These types will implement the Reactor, Cell and Canceler interfaces, respectively.
 
+// callback holds a registered change notification function along with the
+// identifier used to remove it.
+type callback struct {
+	id int
+	fn func(int)
+}
+
+// canceler remembers which callback of which cell it belongs to.
+type canceler struct {
+	cell *cell
+	id   int
+}
+
 func (c *canceler) Cancel() {
-	panic("Please implement the Cancel function")
+	c.cell.removeCallback(c.id)
+}
+
+// cell is used for both input and compute cells. A nil recompute function
+// marks an input cell.
+type cell struct {
+	reactor   *reactor
+	value     int
+	deps      []*cell
+	recompute func() int
+	callbacks []*callback
+	nextID    int
 }
 
 func (c *cell) Value() int {
-	panic("Please implement the Value function")
+	return c.value
 }
 
 func (c *cell) SetValue(value int) {
-	panic("Please implement the SetValue function")
+	// Compute cells are not directly settable.
+	if c.recompute != nil {
+		return
+	}
+	if c.value == value {
+		return
+	}
+	c.value = value
+	c.reactor.update()
 }
 
-func (c *cell) AddCallback(callback func(int)) Canceler {
-	panic("Please implement the AddCallback function")
+func (c *cell) AddCallback(fn func(int)) Canceler {
+	id := c.nextID
+	c.nextID++
+	c.callbacks = append(c.callbacks, &callback{id: id, fn: fn})
+	return &canceler{cell: c, id: id}
+}
+
+func (c *cell) removeCallback(id int) {
+	for i, cb := range c.callbacks {
+		if cb.id == id {
+			c.callbacks = append(c.callbacks[:i], c.callbacks[i+1:]...)
+			return
+		}
+	}
+}
+
+// reactor holds all cells in creation order, which is a topological order:
+// a compute cell is always created after the cells it depends on.
+type reactor struct {
+	cells []*cell
 }
 
 func New() Reactor {
-	panic("Please implement the New function")
+	return &reactor{}
 }
 
 func (r *reactor) CreateInput(initial int) InputCell {
-	panic("Please implement the CreateInput function")
+	c := &cell{reactor: r, value: initial}
+	r.cells = append(r.cells, c)
+	return c
 }
 
 func (r *reactor) CreateCompute1(dep Cell, compute func(int) int) ComputeCell {
-	panic("Please implement the CreateCompute1 function")
+	d := dep.(*cell)
+	c := &cell{reactor: r, deps: []*cell{d}}
+	c.recompute = func() int { return compute(d.value) }
+	c.value = c.recompute()
+	r.cells = append(r.cells, c)
+	return c
 }
 
 func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
-	panic("Please implement the CreateCompute2 function")
+	d1 := dep1.(*cell)
+	d2 := dep2.(*cell)
+	c := &cell{reactor: r, deps: []*cell{d1, d2}}
+	c.recompute = func() int { return compute(d1.value, d2.value) }
+	c.value = c.recompute()
+	r.cells = append(r.cells, c)
+	return c
+}
+
+// update recomputes every compute cell in dependency order and then notifies
+// the callbacks of the cells whose value changed in the new stable state.
+func (r *reactor) update() {
+	var changed []*cell
+	for _, c := range r.cells {
+		if c.recompute == nil {
+			continue
+		}
+		value := c.recompute()
+		if value != c.value {
+			c.value = value
+			changed = append(changed, c)
+		}
+	}
+	for _, c := range changed {
+		// Snapshot so callbacks may safely cancel themselves or others.
+		callbacks := make([]*callback, len(c.callbacks))
+		copy(callbacks, c.callbacks)
+		for _, cb := range callbacks {
+			cb.fn(c.value)
+		}
+	}
 }
