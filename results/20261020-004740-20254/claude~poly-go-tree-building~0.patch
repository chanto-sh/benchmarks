+// Build reconstructs the tree described by records.
+//
+// The records are an unsorted set with IDs in [0, len(records)), so a node can
+// be indexed directly by its ID. Every non-root record must have a parent with
+// a lower ID, which both guarantees that the input is acyclic and lets the
+// children of each node be collected in ascending ID order in a single pass.
 func Build(records []Record) (*Node, error) {
-	panic("Please implement the Build function")
+	if len(records) == 0 {
+		return nil, nil
+	}
+
+	n := len(records)
+	nodes := make([]*Node, n)
+	parents := make([]int, n)
+	seen := make([]bool, n)
+
+	for _, record := range records {
+		if record.ID < 0 || record.ID >= n {
+			return nil, fmt.Errorf("record ID %d is out of range", record.ID)
+		}
+		if seen[record.ID] {
+			return nil, fmt.Errorf("duplicate record with ID %d", record.ID)
+		}
+		seen[record.ID] = true
+
+		if record.ID == 0 {
+			if record.Parent != 0 {
+				return nil, fmt.Errorf("root record has parent ID %d", record.Parent)
+			}
+		} else if record.Parent < 0 || record.Parent >= record.ID {
+			return nil, fmt.Errorf("record %d has invalid parent ID %d", record.ID, record.Parent)
+		}
+
+		nodes[record.ID] = &Node{ID: record.ID}
+		parents[record.ID] = record.Parent
+	}
+
+	// Every ID in [0, n) is present exactly once, so the input is continuous.
+	// Attaching in ascending ID order keeps each node's children sorted.
+	for id := 1; id < n; id++ {
+		parent := nodes[parents[id]]
+		parent.Children = append(parent.Children, nodes[id])
+	}
+
+	return nodes[0], nil
 }
