 package foodchain
 
+import "strings"
+
+// animals holds the creature swallowed in each verse, indexed by verse.
+var animals = []string{"", "fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"}
+
+// remarks holds the second line of each verse. The fly has none, and the
+// horse verse ends after its remark instead of building the cumulative chain.
+var remarks = []string{
+	"",
+	"",
+	"It wriggled and jiggled and tickled inside her.",
+	"How absurd to swallow a bird!",
+	"Imagine that, to swallow a cat!",
+	"What a hog, to swallow a dog!",
+	"Just opened her throat and swallowed a goat!",
+	"I don't know how she swallowed a cow!",
+	"She's dead, of course!",
+}
+
+// spiderTail completes the clause about swallowing the spider.
+const spiderTail = " that wriggled and jiggled and tickled inside her"
+
+// Verse returns the nth verse of the song, where Verse(1) is the fly verse
+// and Verse(8) is the horse verse.
 func Verse(v int) string {
-	panic("Please implement the Verse function")
+	lines := []string{"I know an old lady who swallowed a " + animals[v] + "."}
+
+	if v == 8 {
+		return strings.Join(append(lines, remarks[v]), "\n")
+	}
+
+	if remarks[v] != "" {
+		lines = append(lines, remarks[v])
+	}
+
+	// Build the cumulative chain from this verse's animal down to the fly.
+	for i := v; i > 1; i-- {
+		line := "She swallowed the " + animals[i] + " to catch the " + animals[i-1]
+		if i-1 == 2 {
+			line += spiderTail
+		}
+		lines = append(lines, line+".")
+	}
+
+	lines = append(lines, "I don't know why she swallowed the fly. Perhaps she'll die.")
+	return strings.Join(lines, "\n")
 }
 
+// Verses returns the verses from start through end inclusive, separated by a
+// blank line.
 func Verses(start, end int) string {
-	panic("Please implement the Verses function")
+	verses := make([]string, 0, end-start+1)
+	for v := start; v <= end; v++ {
+		verses = append(verses, Verse(v))
+	}
+	return strings.Join(verses, "\n\n")
 }
 
+// Song returns every verse of the song.
 func Song() string {
-	panic("Please implement the Song function")
+	return Verses(1, len(animals)-1)
 }
