+import copy
+import json
+
+
 class RestAPI:
     def __init__(self, database=None):
-        pass
+        database = copy.deepcopy(database) if database is not None else {}
+        self.users = {}
+        for user in database.get("users", []):
+            self.users[user["name"]] = {
+                "name": user["name"],
+                "owes": dict(user.get("owes", {})),
+                "owed_by": dict(user.get("owed_by", {})),
+            }
 
     def get(self, url, payload=None):
-        pass
+        if url == "/users":
+            requested = None
+            data = _decode(payload)
+            if data is not None:
+                requested = set(data.get("users", []))
+
+            names = sorted(self.users)
+            if requested is not None:
+                names = [name for name in names if name in requested]
+
+            return json.dumps({"users": [self._user_object(name) for name in names]})
+
+        raise ValueError(f"Unsupported GET url: {url}")
 
     def post(self, url, payload=None):
-        pass
+        data = _decode(payload) or {}
+
+        if url == "/add":
+            name = data["user"]
+            self.users[name] = {"name": name, "owes": {}, "owed_by": {}}
+            return json.dumps(self._user_object(name))
+
+        if url == "/iou":
+            lender = data["lender"]
+            borrower = data["borrower"]
+            amount = data["amount"]
+            self._record_iou(lender, borrower, amount)
+            names = sorted({lender, borrower})
+            return json.dumps({"users": [self._user_object(name) for name in names]})
+
+        raise ValueError(f"Unsupported POST url: {url}")
+
+    def _record_iou(self, lender, borrower, amount):
+        lender_user = self.users[lender]
+        borrower_user = self.users[borrower]
+
+        # Net amount the borrower currently owes the lender.
+        net = (
+            borrower_user["owes"].get(lender, 0.0)
+            - borrower_user["owed_by"].get(lender, 0.0)
+        )
+        net = round(net + amount, 2)
+
+        if net > 0:
+            borrower_user["owes"][lender] = net
+            lender_user["owed_by"][borrower] = net
+            borrower_user["owed_by"].pop(lender, None)
+            lender_user["owes"].pop(borrower, None)
+        elif net < 0:
+            borrower_user["owed_by"][lender] = -net
+            lender_user["owes"][borrower] = -net
+            borrower_user["owes"].pop(lender, None)
+            lender_user["owed_by"].pop(borrower, None)
+        else:
+            borrower_user["owes"].pop(lender, None)
+            lender_user["owed_by"].pop(borrower, None)
+            borrower_user["owed_by"].pop(lender, None)
+            lender_user["owes"].pop(borrower, None)
+
+    def _user_object(self, name):
+        user = self.users[name]
+        owes = {other: amount for other, amount in user["owes"].items() if amount}
+        owed_by = {
+            other: amount for other, amount in user["owed_by"].items() if amount
+        }
+        balance = round(sum(owed_by.values()) - sum(owes.values()), 2) + 0.0
+        return {
+            "name": name,
+            "owes": dict(sorted(owes.items())),
+            "owed_by": dict(sorted(owed_by.items())),
+            "balance": balance,
+        }
+
+
+def _decode(payload):
+    if payload is None:
+        return None
+    if isinstance(payload, str):
+        return json.loads(payload)
+    return payload
