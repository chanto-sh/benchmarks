 package variablelengthquantity
 
+import "errors"
+
+// ErrIncompleteSequence is returned when the input ends in the middle of a
+// variable length quantity (i.e. before a byte with the continuation bit clear).
+var ErrIncompleteSequence = errors.New("incomplete sequence")
+
 func EncodeVarint(input []uint32) []byte {
-	panic("Please implement the EncodeVarint function")
+	var output []byte
+	for _, n := range input {
+		// Collect 7-bit groups, least significant first.
+		var groups [5]byte
+		i := len(groups)
+		for {
+			i--
+			groups[i] = byte(n & 0x7f)
+			n >>= 7
+			if n == 0 {
+				break
+			}
+		}
+		// Set the continuation bit on every group except the last.
+		for j := i; j < len(groups)-1; j++ {
+			groups[j] |= 0x80
+		}
+		output = append(output, groups[i:]...)
+	}
+	return output
 }
 
 func DecodeVarint(input []byte) ([]uint32, error) {
-	panic("Please implement the DecodeVarint function")
+	var output []uint32
+	var value uint32
+	inSequence := false
+	for _, b := range input {
+		value = value<<7 | uint32(b&0x7f)
+		inSequence = b&0x80 != 0
+		if !inSequence {
+			output = append(output, value)
+			value = 0
+		}
+	}
+	if inSequence {
+		return nil, ErrIncompleteSequence
+	}
+	return output, nil
 }
