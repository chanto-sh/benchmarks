+/// Converts a tonic such as `"C"`, `"f#"` or `"bb"` to its pitch class (C = 0).
+fn parse_tonic(tonic: &str) -> Result<usize, Error> {
+    let mut chars = tonic.chars();
+    let letter = chars.next().ok_or(Error)?.to_ascii_uppercase();
+    let mut pitch: i32 = match letter {
+        'C' => 0,
+        'D' => 2,
+        'E' => 4,
+        'F' => 5,
+        'G' => 7,
+        'A' => 9,
+        'B' => 11,
+        _ => return Err(Error),
+    };
+
+    for accidental in chars {
+        match accidental {
+            '#' => pitch += 1,
+            'b' => pitch -= 1,
+            _ => return Err(Error),
+        }
     }
+
+    Ok(pitch.rem_euclid(12) as usize)
