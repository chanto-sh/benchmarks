+/// Returns the set of nucleotides a (possibly shorthand) symbol stands for,
+/// encoded as a bit mask: A = 1, C = 2, G = 4, T = 8. RNA's U is not a valid
+/// symbol here; `of_rna` translates it to T before looking up a codon.
+fn nucleotide_mask(symbol: u8) -> Option<u8> {
+    let mask = match symbol.to_ascii_uppercase() {
+        b'A' => 0b0001,
+        b'C' => 0b0010,
+        b'G' => 0b0100,
+        b'T' => 0b1000,
+        b'R' => 0b0101, // A or G
+        b'Y' => 0b1010, // C or T
+        b'S' => 0b0110, // G or C
+        b'W' => 0b1001, // A or T
+        b'K' => 0b1100, // G or T
+        b'M' => 0b0011, // A or C
+        b'B' => 0b1110, // C, G or T
+        b'D' => 0b1101, // A, G or T
+        b'H' => 0b1011, // A, C or T
+        b'V' => 0b0111, // A, C or G
+        b'N' => 0b1111, // A, C, G or T
+        _ => return None,
+    };
+    Some(mask)
+}
+
+/// Bit corresponding to a single literal nucleotide.
+fn nucleotide_bit(symbol: u8) -> Option<u8> {
+    nucleotide_mask(symbol).filter(|mask| mask.count_ones() == 1)
+}
