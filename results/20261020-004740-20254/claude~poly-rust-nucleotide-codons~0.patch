+/// Expands an IUPAC nucleotide shorthand character into the concrete bases it
+/// stands for. Returns `None` for characters that are not valid shorthand.
+fn bases_for(c: char) -> Option<&'static [char]> {
+    match c {
+        'A' => Some(&['A']),
+        'C' => Some(&['C']),
+        'G' => Some(&['G']),
+        'T' => Some(&['T']),
+        'U' => Some(&['T']), // RNA uracil behaves like DNA thymine
+        'R' => Some(&['A', 'G']),
+        'Y' => Some(&['C', 'T']),
+        'S' => Some(&['G', 'C']),
+        'W' => Some(&['A', 'T']),
+        'K' => Some(&['G', 'T']),
+        'M' => Some(&['A', 'C']),
+        'B' => Some(&['C', 'G', 'T']),
+        'D' => Some(&['A', 'G', 'T']),
+        'H' => Some(&['A', 'C', 'T']),
+        'V' => Some(&['A', 'C', 'G']),
+        'N' => Some(&['A', 'C', 'G', 'T']),
+        _ => None,
+    }
+}
