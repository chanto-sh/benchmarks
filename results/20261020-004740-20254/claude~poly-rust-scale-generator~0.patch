+/// Decides whether a scale built on `tonic` should be spelled with flats.
+fn uses_flats(tonic: &str) -> bool {
+    let mut chars = tonic.chars();
+    let Some(first) = chars.next() else {
+        return false;
+    };
+    let accidental: String = chars.collect();
+
+    match accidental.as_str() {
+        "b" => true,
+        "#" => false,
+        _ => {
+            if first.is_ascii_lowercase() {
+                // Minor keys that are conventionally written with flats.
+                matches!(first.to_ascii_uppercase(), 'D' | 'G' | 'C' | 'F')
+            } else {
+                // Of the natural major keys, only F is written with flats.
+                first.to_ascii_uppercase() == 'F'
+            }
+        }
     }
