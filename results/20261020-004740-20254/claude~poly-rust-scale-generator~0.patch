+/// Returns the pitch class (0 = C) for a note name such as `C`, `F#` or `Bb`.
+fn pitch_class(note: &str) -> Option<usize> {
+    let mut chars = note.chars();
+    let base = match chars.next()?.to_ascii_uppercase() {
+        'C' => 0,
+        'D' => 2,
+        'E' => 4,
+        'F' => 5,
+        'G' => 7,
+        'A' => 9,
+        'B' => 11,
+        _ => return None,
+    };
+
+    let mut pitch = base;
+    for accidental in chars {
+        match accidental {
+            '#' => pitch = (pitch + 1) % 12,
+            'b' => pitch = (pitch + 11) % 12,
+            _ => return None,
+        }
+    }
+    Some(pitch)
+}
