+use std::collections::BTreeMap;
+
+/// Price of a single book in cents.
+const BOOK_PRICE: u32 = 800;
+
+/// Discount percentage applied to a group of `n` distinct books.
+const DISCOUNT: [u32; 6] = [0, 0, 5, 10, 20, 25];
+
 pub fn lowest_price(books: &[u32]) -> u32 {
-    todo!("Find the lowest price of the bookbasket with books {books:?}")
+    // Tally how many copies of each title the basket contains.
+    let mut tally: BTreeMap<u32, u32> = BTreeMap::new();
+    for &book in books {
+        *tally.entry(book).or_insert(0) += 1;
+    }
+
+    // Per-title copy counts, highest first.
+    let mut counts: Vec<u32> = tally.into_values().collect();
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+
+    // The series has five titles; copies beyond the five best-selling titles
+    // cannot join a set and are charged at full price.
+    let extra: u32 = counts.iter().skip(5).sum();
+    counts.resize(5, 0);
+
+    // counts[k] is the number of groups containing at least k + 1 distinct
+    // titles in the balanced ("staircase") grouping, so the difference between
+    // consecutive counts is the number of groups of each exact size.
+    let mut groups = [0u32; 5];
+    for (size, group) in groups.iter_mut().enumerate() {
+        let next = counts.get(size + 1).copied().unwrap_or(0);
+        *group = counts[size] - next;
+    }
+
+    // A group of 5 plus a group of 3 is always beaten by two groups of 4
+    // (51.60 vs 51.20 for eight books), so trade every such pair.
+    let swaps = groups[4].min(groups[2]);
+    groups[4] -= swaps;
+    groups[2] -= swaps;
+    groups[3] += 2 * swaps;
+
+    let mut total = extra * BOOK_PRICE;
+    for (index, &group_count) in groups.iter().enumerate() {
+        let size = index as u32 + 1;
+        total += group_count * size * BOOK_PRICE * (100 - DISCOUNT[size as usize]) / 100;
+    }
+    total
 }
