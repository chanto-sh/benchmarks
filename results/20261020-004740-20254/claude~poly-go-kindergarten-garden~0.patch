 func NewGarden(diagram string, children []string) (*Garden, error) {
-	panic("Please implement the NewGarden function")
+	if !strings.HasPrefix(diagram, "\n") {
+		return nil, errors.New("diagram must start with a newline")
+	}
+
+	rows := strings.Split(diagram[1:], "\n")
+	if len(rows) != 2 {
+		return nil, fmt.Errorf("diagram must have exactly two rows, got %d", len(rows))
+	}
+	if len(rows[0]) != len(rows[1]) {
+		return nil, errors.New("diagram rows must have the same length")
+	}
+	if len(rows[0])%2 != 0 {
+		return nil, errors.New("diagram must have an even number of cups per row")
+	}
+	if len(rows[0])/2 != len(children) {
+		return nil, fmt.Errorf("diagram provides %d cups per child, but there are %d children",
+			len(rows[0])/2, len(children))
+	}
+
+	// Sort a copy so the caller's slice is left untouched.
+	sorted := append([]string(nil), children...)
+	sort.Strings(sorted)
+
+	g := &Garden{plants: make(map[string][]string, len(sorted))}
+	for i, child := range sorted {
+		if _, ok := g.plants[child]; ok {
+			return nil, fmt.Errorf("duplicate child name %q", child)
+		}
+
+		plants := make([]string, 0, 4)
+		for _, row := range rows {
+			for j := 2 * i; j < 2*i+2; j++ {
+				name, ok := plantNames[row[j]]
+				if !ok {
+					return nil, fmt.Errorf("invalid cup code %q", row[j])
+				}
+				plants = append(plants, name)
+			}
+		}
+		g.plants[child] = plants
+	}
+
+	return g, nil
 }
 
