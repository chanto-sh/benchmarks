+}
+
+fn group_price(size: u8) -> u32 {
+    match size {
+        1 => 800,
+        2 => 1520,
+        3 => 2160,
+        4 => 2560,
+        5 => 3000,
+        _ => 0,
+    }
+}
+
+fn min_price(counts: [u8; 5], memo: &mut HashMap<[u8; 5], u32>) -> u32 {
+    if counts.iter().all(|&c| c == 0) {
+        return 0;
+    }
+    if let Some(&cached) = memo.get(&counts) {
+        return cached;
+    }
+
+    let available = counts.iter().filter(|&&c| c > 0).count();
+    let mut best = u32::MAX;
+
+    // Choose how many distinct titles form the next group. Taking the
+    // currently most numerous titles is always optimal for a fixed size.
+    for size in 1..=available {
+        let mut next = counts;
+        for count in next.iter_mut().take(size) {
+            *count -= 1;
+        }
+        next.sort_unstable_by(|a, b| b.cmp(a));
+
+        let price = group_price(size as u8) + min_price(next, memo);
+        best = best.min(price);
+    }
+
+    memo.insert(counts, best);
+    best
 }
