+    let mut counts = [0u8; 5];
+    for &book in books {
+        if (1..=5).contains(&book) {
+            counts[(book - 1) as usize] += 1;
+        }
+    }
+    counts.sort_unstable_by(|a, b| b.cmp(a));
+
+    let mut memo = HashMap::new();
