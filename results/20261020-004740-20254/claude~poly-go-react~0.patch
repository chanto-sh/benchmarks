+// propagateFrom recomputes every cell reachable from start, in creation
+// order, and then fires callbacks once per cell whose value actually
+// changed. The system is stable before any callback runs.
+func (r *reactor) propagateFrom(start *cell) {
+	affected := map[*cell]bool{start: true}
+	stack := []*cell{start}
+	for len(stack) > 0 {
+		n := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		for _, o := range n.observers {
+			if !affected[o] {
+				affected[o] = true
+				stack = append(stack, o)
+			}
+		}
+	}
+
+	var changed []*cell
+	changedSet := map[*cell]bool{start: true}
+	for _, c := range r.cells {
+		if !affected[c] || c.compute == nil {
+			continue
+		}
+		// Only recompute if one of the dependencies actually changed;
+		// this keeps compute functions from running needlessly.
+		depChanged := false
+		for _, d := range c.deps {
+			if changedSet[d] {
+				depChanged = true
+				break
+			}
+		}
+		if !depChanged {
+			continue
+		}
+		old := c.value
+		c.value = c.compute()
+		if c.value != old {
+			changed = append(changed, c)
+			changedSet[c] = true
+		}
+	}
+
+	for _, c := range changed {
+		// Snapshot in case a callback adds or removes callbacks.
+		cbs := make([]*callback, len(c.callbacks))
+		copy(cbs, c.callbacks)
+		for _, cb := range cbs {
+			if !cb.canceler.canceled {
+				cb.fn(c.value)
+			}
+		}
+	}
 }
 
