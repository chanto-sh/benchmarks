+import (
+	"errors"
+	"math"
+)
+
+var (
+	ErrInvalidTrinary  = errors.New("invalid trinary number")
+	ErrTrinaryOverflow = errors.New("trinary number overflows int64")
+)
+
+// ParseTrinary converts a base-3 string to its decimal value. Strings
+// containing anything other than '0', '1' or '2' are invalid, as are values
+// that do not fit in an int64.
+func ParseTrinary(arg string) (int64, error) {
+	if arg == "" {
+		return 0, ErrInvalidTrinary
+	}
+
+	var value int64
+	for i := 0; i < len(arg); i++ {
+		c := arg[i]
+		if c < '0' || c > '2' {
+			return 0, ErrInvalidTrinary
+		}
+		digit := int64(c - '0')
+		if value > (math.MaxInt64-digit)/3 {
+			return 0, ErrTrinaryOverflow
+		}
+		value = value*3 + digit
+	}
+	return value, nil
 }
