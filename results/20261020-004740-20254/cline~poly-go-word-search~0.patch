 package wordsearch
 
+import "fmt"
+
+// Solve finds each word in the puzzle and returns the coordinates of its first
+// and last letter. Coordinates are given as {column, row}. Words may run in any
+// of the eight straight directions (horizontal, vertical and diagonal).
+//
+// If any word cannot be found, an error is returned along with a result map in
+// which the missing words are marked with {-1, -1}, {-1, -1}.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	result := make(map[string][2][2]int, len(words))
+
+	height := len(puzzle)
+	width := 0
+	if height > 0 {
+		width = len(puzzle[0])
+	}
+
+	directions := [][2]int{
+		{1, 0},   // left to right
+		{-1, 0},  // right to left
+		{0, 1},   // top to bottom
+		{0, -1},  // bottom to top
+		{1, 1},   // top left to bottom right
+		{-1, -1}, // bottom right to top left
+		{1, -1},  // bottom left to top right
+		{-1, 1},  // top right to bottom left
+	}
+
+	var missing []string
+
+	for _, word := range words {
+		found := false
+	search:
+		for y := 0; y < height; y++ {
+			for x := 0; x < width; x++ {
+				for _, d := range directions {
+					if wordFits(puzzle, word, x, y, d[0], d[1], width, height) {
+						result[word] = [2][2]int{{x, y}, {x + d[0]*(len(word)-1), y + d[1]*(len(word)-1)}}
+						found = true
+						break search
+					}
+				}
+			}
+		}
+		if !found {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+		}
+	}
+
+	if len(missing) > 0 {
+		return result, fmt.Errorf("words not found in puzzle: %v", missing)
+	}
+	return result, nil
+}
+
+// wordFits reports whether word starts at (x, y) and continues in direction
+// (dx, dy) without leaving the puzzle. Rows and columns are indexed by byte;
+// puzzle letters are expected to be single ASCII characters.
+func wordFits(puzzle []string, word string, x, y, dx, dy, width, height int) bool {
+	if len(word) == 0 {
+		return false
+	}
+	endX := x + dx*(len(word)-1)
+	endY := y + dy*(len(word)-1)
+	if endX < 0 || endX >= width || endY < 0 || endY >= height {
+		return false
+	}
+	for i := 0; i < len(word); i++ {
+		if puzzle[y+dy*i][x+dx*i] != word[i] {
+			return false
+		}
+	}
+	return true
 }
