+    def _neighbors(self, x, y):
+        for dx, dy in ((0, -1), (0, 1), (-1, 0), (1, 0)):
+            nx, ny = x + dx, y + dy
+            if self._is_on_board(nx, ny):
+                yield nx, ny
+
+    def _empty_region(self, x, y):
+        """Return the connected empty region containing (x, y).
+
+        Also returns the set of stone colors bordering that region.
+        """
+        region = set()
+        borders = set()
+        stack = [(x, y)]
+        while stack:
+            cx, cy = stack.pop()
+            if (cx, cy) in region:
+                continue
+            cell = self.board[cy][cx]
+            if cell != " ":
+                borders.add(cell)
+                continue
+            region.add((cx, cy))
+            stack.extend(self._neighbors(cx, cy))
+        return region, borders
 
