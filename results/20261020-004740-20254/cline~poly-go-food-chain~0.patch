+// Verse returns the verse starting with the given animal number.
 func Verse(v int) string {
-	panic("Please implement the Verse function")
+	if v < 1 || v > len(animals)-1 {
+		return ""
+	}
+
+	current := animals[v]
+	lines := []string{
+		"I know an old lady who swallowed a " + current.name + ".",
+	}
+	if current.remark != "" {
+		lines = append(lines, current.remark)
+	}
+
+	if v == len(animals)-1 {
+		return strings.Join(lines, "\n")
+	}
+
+	for i := v; i > 1; i-- {
+		lines = append(lines, "She swallowed the "+animals[i].name+
+			" to catch the "+animals[i-1].previous+".")
+	}
+
+	lines = append(lines,
+		"I don't know why she swallowed the fly. Perhaps she'll die.")
+
+	return strings.Join(lines, "\n")
 }
 
+// Verses returns the verses from start through end, separated by a blank line.
 func Verses(start, end int) string {
-	panic("Please implement the Verses function")
+	if start > end {
+		return ""
+	}
+	verses := make([]string, 0, end-start+1)
+	for v := start; v <= end; v++ {
+		verses = append(verses, Verse(v))
+	}
+	return strings.Join(verses, "\n\n")
 }
 
+// Song returns the entire song.
