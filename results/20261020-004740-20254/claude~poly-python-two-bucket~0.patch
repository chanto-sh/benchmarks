+from collections import deque
+
+
 def measure(bucket_one, bucket_two, goal, start_bucket):
-    pass
+    """Measure ``goal`` liters using two buckets, starting with ``start_bucket``.
+
+    Returns a tuple of (number of actions, bucket holding the goal, liters left
+    in the other bucket). Raises ``ValueError`` if the goal cannot be measured.
+    """
+    if start_bucket not in ("one", "two"):
+        raise ValueError("start_bucket must be either 'one' or 'two'.")
+
+    capacities = (bucket_one, bucket_two)
+    start = 0 if start_bucket == "one" else 1
+    other = 1 - start
+
+    if goal > max(capacities):
+        raise ValueError(
+            "The goal is larger than both buckets, so it cannot be measured."
+        )
+
+    def is_forbidden(state):
+        # After any action the starting bucket may not be empty while the
+        # other bucket is full.
+        return state[start] == 0 and state[other] == capacities[other]
+
+    def next_states(state):
+        one, two = state
+        results = []
+
+        # Fill a bucket.
+        if one < capacities[0]:
+            results.append((capacities[0], two))
+        if two < capacities[1]:
+            results.append((one, capacities[1]))
+
+        # Empty a bucket.
+        if one > 0:
+            results.append((0, two))
+        if two > 0:
+            results.append((one, 0))
+
+        # Pour one bucket into the other until the source is empty or the
+        # destination is full.
+        if one > 0 and two < capacities[1]:
+            amount = min(one, capacities[1] - two)
+            results.append((one - amount, two + amount))
+        if two > 0 and one < capacities[0]:
+            amount = min(two, capacities[0] - one)
+            results.append((one + amount, two - amount))
+
+        return results
+
+    # The first action is always filling the starting bucket.
+    initial = [0, 0]
+    initial[start] = capacities[start]
+    initial = tuple(initial)
+
+    queue = deque([(initial, 1)])
+    visited = {initial}
+
+    while queue:
+        state, actions = queue.popleft()
+
+        if goal in state:
+            bucket = "one" if state[0] == goal else "two"
+            remainder = state[1] if bucket == "one" else state[0]
+            return actions, bucket, remainder
+
+        for new_state in next_states(state):
+            if new_state in visited or is_forbidden(new_state):
+                continue
+            visited.add(new_state)
+            queue.append((new_state, actions + 1))
+
+    raise ValueError("The goal cannot be measured with these buckets.")
