+def _mmi(a, m):
+    """Return the modular multiplicative inverse of a modulo m."""
+    for x in range(1, m):
+        if (a * x) % m == 1:
+            return x
+    raise ValueError("a and m must be coprime.")
+
+
+def _check_coprime(a, m):
+    if gcd(a, m) != 1:
+        raise ValueError("a and m must be coprime.")
+
