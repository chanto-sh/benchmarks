+// Matrix is a two-dimensional grid of integers, indexed [row][col].
+type Matrix [][]int
+
+var (
+	errEmptyRow   = errors.New("matrix has an empty row")
+	errUnevenRows = errors.New("matrix rows have different lengths")
+	errNoRows     = errors.New("matrix has no rows")
+	errNotAnInt   = errors.New("matrix contains a non-integer value")
+)
+
+// New parses a string representation of a matrix. Rows are separated by
+// newlines and values within a row are separated by whitespace.
 func New(s string) (Matrix, error) {
-	panic("Please implement the New function")
+	lines := strings.Split(s, "\n")
+	m := make(Matrix, 0, len(lines))
+	width := -1
+	for _, line := range lines {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			return nil, errEmptyRow
+		}
+		if width < 0 {
+			width = len(fields)
+		} else if len(fields) != width {
+			return nil, errUnevenRows
+		}
+		row := make([]int, len(fields))
+		for i, f := range fields {
+			v, err := strconv.Atoi(f)
+			if err != nil {
+				return nil, errNotAnInt
+			}
+			row[i] = v
+		}
+		m = append(m, row)
+	}
+	if len(m) == 0 {
+		return nil, errNoRows
+	}
+	return m, nil
 }
 
