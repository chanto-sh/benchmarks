+class _Cell:
+    """Common behaviour for reactive cells.
+
+    A cell owns a value and keeps track of the cells that depend on it.
+    When an input value changes, all reachable compute cells are
+    recalculated in dependency order, and callbacks are fired only for
+    compute cells whose value actually changed.
+    """
+
+    def __init__(self, value=None):
+        self._value = value
+        self._dependents = []
+        self._depth = 0
+
+    @property
+    def value(self):
+        return self._value
+
+    def _add_dependent(self, cell):
+        if cell not in self._dependents:
+            self._dependents.append(cell)
+
+    def _reachable_dependents(self):
+        """Return every compute cell that (transitively) depends on self."""
+        seen = []
+        seen_ids = set()
+        stack = list(self._dependents)
+        while stack:
+            cell = stack.pop()
+            if id(cell) in seen_ids:
+                continue
+            seen_ids.add(id(cell))
+            seen.append(cell)
+            stack.extend(cell._dependents)
+        return seen
+
+    def _propagate(self):
+        """Recalculate all dependent cells and notify callbacks."""
+        # Sorting by depth guarantees that every cell is recalculated after
+        # all of the cells it depends on, so each cell ends up with its
+        # final value in the new stable state.
+        cells = sorted(self._reachable_dependents(), key=lambda cell: cell._depth)
+
+        changed = []
+        for cell in cells:
+            previous = cell._value
+            cell._recompute()
+            if cell._value != previous:
+                changed.append(cell)
+
+        for cell in changed:
+            cell._fire_callbacks()
+
+    def _recompute(self):
+        raise NotImplementedError
+
+    def _fire_callbacks(self):
+        raise NotImplementedError
+
