+def _propagate(source):
+    """Recompute every cell downstream of `source` and notify changed cells."""
+    # Collect the transitive dependents of the changed cell.
+    affected = []
+    affected_set = set()
+    stack = [source]
+    while stack:
+        cell = stack.pop()
+        for dependent in cell._dependents:
+            if dependent not in affected_set:
+                affected_set.add(dependent)
+                affected.append(dependent)
+                stack.append(dependent)
+
+    # Order them topologically so each cell is computed after all of its
+    # inputs that are part of this update (no glitches, one update per cell).
+    indegree = {
+        cell: sum(1 for input_cell in cell._inputs if input_cell in affected_set)
+        for cell in affected
+    }
+    ready = [cell for cell in affected if indegree[cell] == 0]
+    ordered = []
+    while ready:
+        cell = ready.pop(0)
+        ordered.append(cell)
+        for dependent in cell._dependents:
+            if dependent in indegree:
+                indegree[dependent] -= 1
+                if indegree[dependent] == 0:
+                    ready.append(dependent)
+
+    old_values = {cell: cell._value for cell in ordered}
+    for cell in ordered:
+        cell._value = cell._compute_function(
+            [input_cell.value for input_cell in cell._inputs]
+        )
+
+    # Callbacks only fire for cells whose value differs from the previous
+    # stable state, and only after the whole update has settled.
+    for cell in ordered:
+        if cell._value != old_values[cell]:
+            cell._fire_callbacks()
