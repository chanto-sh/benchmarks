+
+// contains reports whether haystack contains needle as a contiguous
+// sub-sequence. An empty needle is always contained.
+func contains(haystack, needle []int) bool {
+	if len(needle) == 0 {
+		return true
+	}
+	if len(needle) > len(haystack) {
+		return false
+	}
+	for start := 0; start <= len(haystack)-len(needle); start++ {
+		match := true
+		for i := range needle {
+			if haystack[start+i] != needle[i] {
+				match = false
+				break
+			}
+		}
+		if match {
+			return true
+		}
+	}
+	return false
 }
