+import random
+import string
+
+
 class Robot:
+    # Class-level registry guaranteeing that no two live robots share a name.
+    _used_names = set()
+
     def __init__(self):
-        pass
+        self._name = None
+
+    @property
+    def name(self):
+        if self._name is None:
+            self._name = self._generate_name()
+        return self._name
+
+    def reset(self):
+        """Wipe the name, returning the robot to factory settings."""
+        old_name = self._name
+        self._name = None
+
+        if old_name is None:
+            return
+
+        # The previous name is still registered while the new one is drawn,
+        # so a re-seeded RNG cannot hand this robot its own old name back.
+        new_name = self._generate_name()
+        self._used_names.discard(old_name)
+        self._name = new_name
+
+    @classmethod
+    def _generate_name(cls):
+        while True:
+            letters = random.choice(string.ascii_uppercase)
+            letters += random.choice(string.ascii_uppercase)
+            digits = random.randint(100, 999)
+            candidate = f"{letters}{digits}"
+            if candidate not in cls._used_names:
+                cls._used_names.add(candidate)
+                return candidate
+
