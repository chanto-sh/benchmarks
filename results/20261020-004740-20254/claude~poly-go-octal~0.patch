+import "fmt"
+
+// ParseOctal converts an octal string to its decimal value.
+// Invalid input returns 0 and a non-nil error.
+func ParseOctal(input string) (int64, error) {
+	if input == "" {
+		return 0, fmt.Errorf("invalid octal: empty input")
+	}
+
+	var result int64
+	for _, r := range input {
+		if r < '0' || r > '7' {
+			return 0, fmt.Errorf("invalid octal: %q", input)
+		}
+		result = result*8 + int64(r-'0')
+	}
+
+	return result, nil
 }
