+/// Spells out a number in the range 1..=999.
+fn encode_below_thousand(n: u64) -> String {
+    debug_assert!((1..1000).contains(&n));
+
+    let hundreds = n / 100;
+    let remainder = n % 100;
+
+    let mut parts = Vec::new();
+
+    if hundreds > 0 {
+        parts.push(format!("{} hundred", ONES[hundreds as usize]));
+    }
+
+    if remainder > 0 {
+        let rest = if remainder < 20 {
+            ONES[remainder as usize].to_string()
+        } else {
+            let tens = TENS[(remainder / 10) as usize];
+            let ones = remainder % 10;
+            if ones > 0 {
+                format!("{tens}-{}", ONES[ones as usize])
+            } else {
+                tens.to_string()
+            }
+        };
+        parts.push(rest);
+    }
+
