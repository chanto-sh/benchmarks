+use rand::Rng;
+
+const ALPHABET_LEN: u8 = 26;
+const KEY_LEN: usize = 100;
+
+/// Turns a key into per-character shift amounts (0..26), or `None` if the key
+/// is empty or contains anything other than lowercase ASCII letters.
+fn shifts(key: &str) -> Option<Vec<u8>> {
+    if key.is_empty() || !key.bytes().all(|b| b.is_ascii_lowercase()) {
+        return None;
+    }
+    Some(key.bytes().map(|b| b - b'a').collect())
+}
+
+/// Applies `f` to each plaintext byte paired with the repeating key shifts.
+fn transform(s: &str, key: &str, f: impl Fn(u8, u8) -> u8) -> Option<String> {
+    let shifts = shifts(key)?;
+    if !s.bytes().all(|b| b.is_ascii_lowercase()) {
+        return None;
+    }
+    Some(
+        s.bytes()
+            .zip(shifts.iter().cycle())
+            .map(|(b, &shift)| f(b - b'a', shift) + b'a')
+            .map(char::from)
+            .collect(),
+    )
+}
+
 pub fn encode(key: &str, s: &str) -> Option<String> {
-    todo!("Use {key} to encode {s} using shift cipher")
+    transform(s, key, |b, shift| (b + shift) % ALPHABET_LEN)
 }
 
 pub fn decode(key: &str, s: &str) -> Option<String> {
-    todo!("Use {key} to decode {s} using shift cipher")
+    transform(s, key, |b, shift| (b + ALPHABET_LEN - shift) % ALPHABET_LEN)
 }
 
 pub fn encode_random(s: &str) -> (String, String) {
-    todo!("Generate random key with only a-z chars and encode {s}. Return tuple (key, encoded s)")
+    let mut rng = rand::thread_rng();
+    let key: String = (0..KEY_LEN)
+        .map(|_| char::from(b'a' + rng.gen_range(0..ALPHABET_LEN)))
+        .collect();
+    let encoded = encode(&key, s).expect("generated key is valid and input is lowercase");
+    (key, encoded)
 }
