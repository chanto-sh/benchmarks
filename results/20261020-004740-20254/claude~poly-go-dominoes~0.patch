+
+// extendChain performs a depth-first search for a completion of chain.
+// It grows the chain through the pointer so that a successful order is
+// visible to the caller.
+func extendChain(input []Domino, used []bool, chain *[]Domino) bool {
+	if len(*chain) == len(input) {
+		return (*chain)[0][0] == (*chain)[len(*chain)-1][1]
+	}
+
+	end := (*chain)[len(*chain)-1][1]
+	for i, d := range input {
+		if used[i] {
+			continue
+		}
+		next, ok := match(d, end)
+		if !ok {
+			continue
+		}
+		used[i] = true
+		*chain = append(*chain, next)
+		if extendChain(input, used, chain) {
+			return true
+		}
+		*chain = (*chain)[:len(*chain)-1]
+		used[i] = false
+	}
+	return false
+}
+
+// match returns d oriented so that its first side equals end.
+func match(d Domino, end int) (Domino, bool) {
+	switch {
+	case d[0] == end:
+		return d, true
+	case d[1] == end:
+		return Domino{d[1], d[0]}, true
+	default:
+		return Domino{}, false
+	}
 }
