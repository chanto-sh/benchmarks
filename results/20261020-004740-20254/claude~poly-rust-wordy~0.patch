 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let body = command.strip_prefix("What is")?.trim();
+    let body = body.strip_suffix('?')?;
+    let tokens: Vec<&str> = body.split_whitespace().collect();
+
+    let mut iter = tokens.iter().copied();
+    let mut result = parse_number(iter.next()?)?;
+
+    while let Some(token) = iter.next() {
+        match token {
+            "plus" => {
+                result = result.checked_add(parse_number(iter.next()?)?)?;
+            }
+            "minus" => {
+                result = result.checked_sub(parse_number(iter.next()?)?)?;
+            }
+            "multiplied" | "divided" => {
+                if iter.next()? != "by" {
+                    return None;
+                }
+                let operand = parse_number(iter.next()?)?;
+                result = if token == "multiplied" {
+                    result.checked_mul(operand)?
+                } else {
+                    result.checked_div(operand)?
+                };
+            }
+            "raised" => {
+                if iter.next()? != "to" || iter.next()? != "the" {
+                    return None;
+                }
+                let exponent = parse_ordinal(iter.next()?)?;
+                if iter.next()? != "power" {
+                    return None;
+                }
+                let exponent = u32::try_from(exponent).ok()?;
+                result = result.checked_pow(exponent)?;
+            }
+            _ => return None,
+        }
+    }
+
+    Some(result)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse().ok()
+}
+
+fn parse_ordinal(token: &str) -> Option<i32> {
+    const SUFFIXES: [&str; 4] = ["th", "st", "nd", "rd"];
+    let digits = SUFFIXES.iter().find_map(|suffix| token.strip_suffix(suffix))?;
+    digits.parse().ok()
 }
