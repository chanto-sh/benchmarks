@@ -1,5 +1,46 @@
 package erratum
 
-func Use(opener ResourceOpener, input string) error {
-	panic("Please implement the Use function")
+// Use opens a resource via opener, frobs it with input, and closes the
+// resource exactly once, no matter what happens along the way.
+//
+// Transient errors from opener are retried; other open errors are returned.
+// A panic from Frob is recovered: FrobError panics trigger Defrob with the
+// error's defrobTag, and the panic value is returned as an error.
+func Use(opener ResourceOpener, input string) (err error) {
+	var res Resource
+	for {
+		res, err = opener()
+		if err == nil {
+			break
+		}
+		if _, ok := err.(TransientError); !ok {
+			return err
+		}
+	}
+
+	// Registered first so it runs last: Defrob (in the recover handler
+	// below) must happen before the resource is closed.
+	defer res.Close()
+
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		switch e := r.(type) {
+		case FrobError:
+			res.Defrob(e.defrobTag)
+			err = e
+		case *FrobError:
+			res.Defrob(e.defrobTag)
+			err = e
+		case error:
+			err = e
+		default:
+			panic(r)
+		}
+	}()
+
+	res.Frob(input)
+	return nil
 }
