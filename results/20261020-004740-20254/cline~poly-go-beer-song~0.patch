 }
 
+// Verses returns the lyrics from start bottles down to stop bottles,
+// separated by a blank line and ending with a newline.
 func Verses(start, stop int) (string, error) {
-	panic("Please implement the Verses function")
+	if start < stop {
+		return "", errors.New("start must not be less than stop")
+	}
+	if start > 99 {
+		return "", errors.New("start must be at most 99")
+	}
+	if stop < 0 {
+		return "", errors.New("stop must not be negative")
+	}
+
+	var verses []string
+	for n := start; n >= stop; n-- {
+		v, err := Verse(n)
+		if err != nil {
+			return "", err
+		}
+		verses = append(verses, v)
+	}
+	return strings.Join(verses, "\n") + "\n", nil
 }
 
+// Verse returns the lyrics for a single verse. Zero bottles is the final
+// verse of the song.
 func Verse(n int) (string, error) {
-	panic("Please implement the Verse function")
+	if n < 0 || n > 99 {
+		return "", fmt.Errorf("invalid verse: %d", n)
+	}
+
+	var first, second string
+	switch n {
+	case 0:
+		first = "No more bottles of beer on the wall, no more bottles of beer."
+		second = "Go to the store and buy some more, 99 bottles of beer on the wall."
+	case 1:
+		first = "1 bottle of beer on the wall, 1 bottle of beer."
+		second = "Take it down and pass it around, no more bottles of beer on the wall."
+	default:
+		first = fmt.Sprintf("%d bottles of beer on the wall, %d bottles of beer.", n, n)
+		next := n - 1
+		if next == 1 {
+			second = "Take one down and pass it around, 1 bottle of beer on the wall."
+		} else {
+			second = fmt.Sprintf("Take one down and pass it around, %d bottles of beer on the wall.", next)
+		}
+	}
+
+	return first + "\n" + second + "\n", nil
 }
