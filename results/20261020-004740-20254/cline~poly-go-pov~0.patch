+// findPath returns the nodes on the path from the receiver down to the node
+// with the given value, or nil if no such node exists.
+func (tr *Tree) findPath(value string) []*Tree {
+	if tr == nil {
+		return nil
+	}
+	if tr.value == value {
+		return []*Tree{tr}
+	}
+	for _, ch := range tr.children {
+		if sub := ch.findPath(value); sub != nil {
+			return append([]*Tree{tr}, sub...)
+		}
+	}
