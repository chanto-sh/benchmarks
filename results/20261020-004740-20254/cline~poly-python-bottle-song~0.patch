+NUMBERS = [
+    "no",
+    "one",
+    "two",
+    "three",
+    "four",
+    "five",
+    "six",
+    "seven",
+    "eight",
+    "nine",
+    "ten",
+]
+
+
+def _bottles(count, capitalized=False):
+    """Return the phrase describing ``count`` green bottles."""
+    word = NUMBERS[count]
+    if capitalized:
+        word = word.capitalize()
+    noun = "bottle" if count == 1 else "bottles"
+    return f"{word} green {noun}"
+
