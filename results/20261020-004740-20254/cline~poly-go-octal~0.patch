+import "errors"
+
+var (
+	errInvalidInput = errors.New("octal: invalid input")
+	errOverflow     = errors.New("octal: value out of range")
+)
+
+// ParseOctal converts an octal number represented as a string to its
+// decimal equivalent, without using any conversion library.
+func ParseOctal(input string) (int64, error) {
+	if input == "" {
+		return 0, errInvalidInput
+	}
+
+	var result int64
+	for i := 0; i < len(input); i++ {
+		c := input[i]
+		if c < '0' || c > '7' {
+			return 0, errInvalidInput
+		}
+		digit := int64(c - '0')
+		if result > (1<<63-1-digit)/8 {
+			return 0, errOverflow
+		}
+		result = result*8 + digit
+	}
+
+	return result, nil
 }
