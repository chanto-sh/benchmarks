+import "errors"
+
+// ErrInvalidTrinary is returned when the input is not a valid trinary number
+// or does not fit in an int64.
+var ErrInvalidTrinary = errors.New("invalid trinary")
+
+// ParseTrinary converts a trinary string to its decimal value using first
+// principles. Invalid input, including values that overflow int64, yields an
+// error.
+func ParseTrinary(arg string) (int64, error) {
+	const maxInt64 = int64(^uint64(0) >> 1)
+
+	var result int64
+	for _, r := range arg {
+		if r < '0' || r > '2' {
+			return 0, ErrInvalidTrinary
+		}
+		digit := int64(r - '0')
+		// Detect overflow before multiplying by 3 and adding the digit.
+		if result > (maxInt64-digit)/3 {
+			return 0, ErrInvalidTrinary
+		}
+		result = result*3 + digit
+	}
+	return result, nil
 }
