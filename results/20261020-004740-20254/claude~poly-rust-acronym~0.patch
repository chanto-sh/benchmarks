 pub fn abbreviate(phrase: &str) -> String {
-    todo!("Given the phrase '{phrase}', return its acronym");
+    let mut acronym = String::new();
+    // The previous significant character: letters, whitespace, and hyphens.
+    // Other punctuation is removed, so it does not affect word boundaries.
+    let mut prev: Option<char> = None;
+
+    for c in phrase.chars() {
+        if c == '-' || c.is_whitespace() {
+            prev = Some(c);
+        } else if c.is_alphabetic() {
+            let starts_word = match prev {
+                None => true,
+                Some(p) => {
+                    p == '-' || p.is_whitespace() || (p.is_lowercase() && c.is_uppercase())
+                }
+            };
+            if starts_word {
+                acronym.extend(c.to_uppercase());
+            }
+            prev = Some(c);
+        }
+    }
+
+    acronym
 }
