+import (
+	"errors"
+	"strings"
+)
+
+// Sentinel errors returned by ParseHex.
+var (
+	errSyntax = errors.New("syntax error")
+	errRange  = errors.New("range error")
+)
+
+// ParseHex converts a hexadecimal string to its decimal (int64) equivalent.
+// It returns a syntax error for invalid input and a range error when the
+// value does not fit in an int64.
+func ParseHex(in string) (int64, error) {
+	if in == "" {
+		return 0, errSyntax
+	}
+
+	var value int64
+	for _, c := range in {
+		var digit int64
+
+		switch {
+		case c >= '0' && c <= '9':
+			digit = int64(c - '0')
+		case c >= 'a' && c <= 'f':
+			digit = int64(c-'a') + 10
+		case c >= 'A' && c <= 'F':
+			digit = int64(c-'A') + 10
+		default:
+			return 0, errSyntax
+		}
+
+		// Detect overflow before multiplying and adding.
+		// MaxInt64 = 9223372036854775807, so value*16+digit must not exceed it.
+		const maxInt64 = int64(^uint64(0) >> 1)
+		if value > (maxInt64-digit)/16 {
+			return 0, errRange
+		}
+
+		value = value*16 + digit
+	}
+
+	return value, nil
+}
+
+// HandleErrors takes a list of inputs for ParseHex and returns a matching
+// list classifying each input as "none", "syntax", or "range".
+func HandleErrors(inputs []string) []string {
+	results := make([]string, len(inputs))
+	for i, in := range inputs {
+		_, err := ParseHex(in)
+		switch {
+		case err == nil:
+			results[i] = "none"
+		case errors.Is(err, errRange):
+			results[i] = "range"
+		case errors.Is(err, errSyntax):
+			results[i] = "syntax"
+		default:
+			results[i] = strings.ToLower(err.Error())
+		}
+	}
+	return results
 }
