 pub fn abbreviate(phrase: &str) -> String {
-    todo!("Given the phrase '{phrase}', return its acronym");
+    let mut acronym = String::new();
+    let mut at_word_start = true;
+    let mut previous: Option<char> = None;
+
+    for c in phrase.chars() {
+        if c.is_whitespace() || c == '-' {
+            at_word_start = true;
+        } else if c.is_alphabetic() {
+            let camel_case_boundary = c.is_uppercase()
+                && previous.map(|p| p.is_lowercase()).unwrap_or(false);
+
+            if at_word_start || camel_case_boundary {
+                acronym.extend(c.to_uppercase());
+            }
+
+            at_word_start = false;
+            previous = Some(c);
+        }
+        // All other punctuation is ignored and does not split words.
+    }
+
+    acronym
 }
