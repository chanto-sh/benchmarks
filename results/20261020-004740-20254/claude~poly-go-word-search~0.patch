 package wordsearch
 
+import "fmt"
+
+// direction pairs: x (column) and y (row) steps.
+var directions = [8][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve finds the first and last letter of each word in the puzzle.
+// Coordinates are given as {x, y}, i.e. {column, row}.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	notFound := [2][2]int{{-1, -1}, {-1, -1}}
+	result := make(map[string][2][2]int, len(words))
+	var missing []string
+
+	height := len(puzzle)
+	width := 0
+	if height > 0 {
+		width = len(puzzle[0])
+	}
+
+	for _, word := range words {
+		start, end, ok := findWord(word, puzzle, width, height)
+		if !ok {
+			result[word] = notFound
+			missing = append(missing, word)
+			continue
+		}
+		result[word] = [2][2]int{start, end}
+	}
+
+	if len(missing) > 0 {
+		return result, fmt.Errorf("words not found: %v", missing)
+	}
+	return result, nil
+}
+
+func findWord(word string, puzzle []string, width, height int) ([2]int, [2]int, bool) {
+	n := len(word)
+	if n == 0 || width == 0 || height == 0 {
+		return [2]int{}, [2]int{}, false
+	}
+
+	for y := 0; y < height; y++ {
+		for x := 0; x < len(puzzle[y]); x++ {
+			if puzzle[y][x] != word[0] {
+				continue
+			}
+			for _, d := range directions {
+				ex := x + d[0]*(n-1)
+				ey := y + d[1]*(n-1)
+				if ey < 0 || ey >= height || ex < 0 || ex >= len(puzzle[ey]) {
+					continue
+				}
+				match := true
+				for i := 0; i < n; i++ {
+					cx, cy := x+d[0]*i, y+d[1]*i
+					if cy < 0 || cy >= height || cx < 0 || cx >= len(puzzle[cy]) || puzzle[cy][cx] != word[i] {
+						match = false
+						break
+					}
+				}
+				if match {
+					return [2]int{x, y}, [2]int{ex, ey}, true
+				}
+			}
+		}
+	}
+	return [2]int{}, [2]int{}, false
 }
