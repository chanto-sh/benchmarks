-	panic("Please implement the StartRobot function")
+	for c := range command {
+		action <- Action{c}
+	}
+	close(action)
 }
 
 func Room(extent Rect, robot Step2Robot, action chan Action, report chan Step2Robot) {
-	panic("Please implement the Room function")
+	for a := range action {
+		switch a.Command {
+		case 'R':
+			robot.Dir = turnRight(robot.Dir)
+		case 'L':
+			robot.Dir = turnLeft(robot.Dir)
+		case 'A':
+			next := advance(robot.Pos, robot.Dir)
+			if within(extent, next) {
+				robot.Pos = next
+			}
+		}
+	}
+	report <- robot
+}
+
+func within(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
 }
 
