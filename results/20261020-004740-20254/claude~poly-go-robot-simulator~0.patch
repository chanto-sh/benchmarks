 }
 
 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	names := make(map[string]bool, len(robots))
+	positions := make(map[Pos]bool, len(robots))
+	for _, r := range robots {
+		if r.Name == "" {
+			log <- "robot without a name"
+		}
+		if names[r.Name] {
+			log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+		}
+		names[r.Name] = true
+		if positions[r.Pos] {
+			log <- fmt.Sprintf("robots placed at the same position %v", r.Pos)
+		}
+		positions[r.Pos] = true
+		if !inRect(extent, r.Pos) {
+			log <- fmt.Sprintf("robot %q placed outside the room", r.Name)
+		}
+	}
+
+	done := 0
+	for a := range action {
+		if a.Command == shutdown {
+			done++
+			if done >= len(robots) {
+				break
+			}
+			continue
+		}
+		i := robotIndex(robots, a.Name)
+		if i < 0 {
+			log <- fmt.Sprintf("action from unknown robot %q", a.Name)
+			continue
+		}
+		switch a.Command {
+		case 'R':
+			robots[i].Dir = (robots[i].Dir + 1) % 4
+		case 'L':
+			robots[i].Dir = (robots[i].Dir + 3) % 4
+		case 'A':
+			p := nextPos(robots[i].Pos, robots[i].Dir)
+			switch {
+			case !inRect(extent, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", a.Name)
+			case occupied(robots, i, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into another robot", a.Name)
+			default:
+				robots[i].Pos = p
+			}
+		}
+	}
+	rep <- robots
+}
+
+// nextPos returns the position one step ahead of p in direction d.
+func nextPos(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		return Pos{p.Easting, p.Northing + 1}
+	case E:
+		return Pos{p.Easting + 1, p.Northing}
+	case S:
+		return Pos{p.Easting, p.Northing - 1}
+	case W:
+		return Pos{p.Easting - 1, p.Northing}
+	}
+	return p
+}
+
+// inRect reports whether p lies within the closed extent r.
+func inRect(r Rect, p Pos) bool {
+	return p.Easting >= r.Min.Easting && p.Easting <= r.Max.Easting &&
+		p.Northing >= r.Min.Northing && p.Northing <= r.Max.Northing
+}
+
+// robotIndex returns the index of the first robot with the given name, or -1.
+func robotIndex(robots []Step3Robot, name string) int {
+	for i := range robots {
+		if robots[i].Name == name {
+			return i
+		}
+	}
+	return -1
+}
+
+// occupied reports whether any robot other than index except sits at p.
+func occupied(robots []Step3Robot, except int, p Pos) bool {
+	for i := range robots {
+		if i != except && robots[i].Pos == p {
+			return true
+		}
+	}
+	return false
 }
