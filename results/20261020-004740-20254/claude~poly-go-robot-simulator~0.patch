 // Step 3
 // Define Action3 type here.
 
+// Action3 is a command relayed from a named robot to the room. A zero
+// Command signals that the robot has finished its script and shut down.
+type Action3 struct {
+	Name string
+	Command
+}
+
+// shutdown is sent by a robot when it has no more actions to perform.
+const shutdown Command = 0
+
 func StartRobot3(name, script string, action chan Action3, log chan string) {
-	panic("Please implement the StartRobot3 function")
+	for _, c := range script {
+		switch c {
