+"""Parse and evaluate simple math word problems."""
+
+_OPERATIONS = {
+    "plus": lambda x, y: x + y,
+    "minus": lambda x, y: x - y,
+    "multiplied": lambda x, y: x * y,
+    "divided": lambda x, y: _divide(x, y),
+}
+
+# Words that may legitimately appear in a question.
+_KEYWORDS = {"plus", "minus", "multiplied", "divided", "by"}
+
+
+def _divide(x, y):
+    """Integer division truncating toward zero, as expected by the tests."""
+    quotient = abs(x) // abs(y)
+    return -quotient if (x < 0) != (y < 0) else quotient
+
+
+def _parse_int(token):
+    try:
+        return int(token)
+    except ValueError:
+        raise ValueError("syntax error") from None
+
