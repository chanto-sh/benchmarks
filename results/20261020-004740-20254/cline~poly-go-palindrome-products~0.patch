+// Product holds a palindromic product and all its factor pairs within the
+// requested range.
+type Product struct {
+	Palindromic    int
+	Factorizations [][2]int
+}
+
+// Products returns the smallest and largest palindromic products that can be
+// formed by multiplying two numbers in the inclusive range [fmin, fmax],
+// together with the factor pairs producing each of them.
 func Products(fmin, fmax int) (Product, Product, error) {
-	panic("Please implement the Products function")
+	if fmin > fmax {
+		return Product{}, Product{}, fmt.Errorf("fmin > fmax")
+	}
+
+	var pmin, pmax Product
+	found := false
+
+	for i := fmin; i <= fmax; i++ {
+		for j := i; j <= fmax; j++ {
+			product := i * j
+			if !isPalindrome(product) {
+				continue
+			}
+			pair := [2]int{i, j}
+			if !found {
+				pmin = Product{product, [][2]int{pair}}
+				pmax = Product{product, [][2]int{pair}}
+				found = true
+				continue
+			}
+			switch {
+			case product < pmin.Palindromic:
+				pmin = Product{product, [][2]int{pair}}
+			case product == pmin.Palindromic:
+				pmin.Factorizations = append(pmin.Factorizations, pair)
+			}
+			switch {
+			case product > pmax.Palindromic:
+				pmax = Product{product, [][2]int{pair}}
+			case product == pmax.Palindromic:
+				pmax.Factorizations = append(pmax.Factorizations, pair)
+			}
+		}
+	}
+
+	if !found {
+		return Product{}, Product{}, fmt.Errorf("no palindromes found in the given range")
+	}
+	return pmin, pmax, nil
+}
+
+func isPalindrome(n int) bool {
+	if n < 0 {
+		return false
+	}
+	s := strconv.Itoa(n)
+	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
+		if s[i] != s[j] {
+			return false
+		}
+	}
+	return true
 }
