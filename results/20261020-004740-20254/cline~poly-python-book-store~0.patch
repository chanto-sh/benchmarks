+from functools import lru_cache
+
+BOOK_PRICE = 800
+
+# Discount percentage for a set of 1..5 different books.
+DISCOUNTS = {1: 0, 2: 5, 3: 10, 4: 20, 5: 25}
+
+
+@lru_cache(maxsize=None)
+def _price(counts):
+    """Return the cheapest price in cents for the given book counts."""
+    counts = tuple(sorted((count for count in counts if count > 0), reverse=True))
+    if not counts:
+        return 0
+
+    best = None
+    # A group can contain at most one copy of each of the five books.
+    for size in range(1, min(len(counts), 5) + 1):
+        remaining = list(counts)
+        for i in range(size):
+            remaining[i] -= 1
+        group_cost = size * BOOK_PRICE * (100 - DISCOUNTS[size]) // 100
+        candidate = group_cost + _price(tuple(sorted(remaining, reverse=True)))
+        if best is None or candidate < best:
+            best = candidate
+    return best
+
