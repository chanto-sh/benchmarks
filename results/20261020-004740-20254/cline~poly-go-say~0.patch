+
+// Say spells out n in English. The second return value reports whether n is
+// within the supported range of 0 to 999,999,999,999 inclusive.
 func Say(n int64) (string, bool) {
-	panic("Please implement the Say function")
+	if n < 0 || n > 999999999999 {
+		return "", false
+	}
+	if n == 0 {
+		return "zero", true
+	}
+
+	var chunks []string
+	for n > 0 {
+		chunks = append(chunks, sayHundreds(int(n%1000)))
+		n /= 1000
+	}
+
+	parts := make([]string, 0, len(chunks))
+	for i := len(chunks) - 1; i >= 0; i-- {
+		if chunks[i] == "" {
+			continue
+		}
+		if i > 0 {
+			parts = append(parts, chunks[i]+" "+scales[i])
+		} else {
+			parts = append(parts, chunks[i])
+		}
+	}
+
+	return strings.Join(parts, " "), true
+}
+
+// sayHundreds spells out a number from 0 to 999.
+func sayHundreds(n int) string {
+	parts := make([]string, 0, 2)
+	if n >= 100 {
+		parts = append(parts, ones[n/100]+" hundred")
+		n %= 100
+	}
+	if n >= 20 {
+		word := tens[n/10]
+		if n%10 != 0 {
+			word += "-" + ones[n%10]
+		}
+		parts = append(parts, word)
+	} else if n > 0 {
+		parts = append(parts, ones[n])
+	}
+	return strings.Join(parts, " ")
 }
