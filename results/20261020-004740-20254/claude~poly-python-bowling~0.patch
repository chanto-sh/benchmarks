+        if not frame:
+            frame.append(pins)
+            return
+
+        if len(frame) == 1:
+            first = frame[0]
+            if first == self.MAX_PINS:
+                # First fill ball after a strike; a second one always follows.
+                frame.append(pins)
+                return
+
+            if first + pins > self.MAX_PINS:
+                raise ValueError(
+                    "the two rolls in a frame cannot knock down more than 10 pins"
+                )
+            frame.append(pins)
+
+            # A spare earns one fill ball; an open frame ends the game.
