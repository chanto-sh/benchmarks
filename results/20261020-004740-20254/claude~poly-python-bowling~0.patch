+        rolls = [pins for frame in self._frames for pins in frame]
+
+        total = 0
+        position = 0
+        for index, frame in enumerate(self._frames):
+            if index == self.TOTAL_FRAMES - 1:
+                # The tenth frame is worth the pins knocked down, fill balls
+                # included.
+                total += sum(frame)
+            elif frame[0] == self.MAX_PINS:
+                total += self.MAX_PINS + rolls[position + 1] + rolls[position + 2]
+            elif sum(frame) == self.MAX_PINS:
+                total += self.MAX_PINS + rolls[position + 2]
+            else:
+                total += sum(frame)
+            position += len(frame)
+
+        return total
+
+    def _roll_in_regular_frame(self, pins):
+        if self._current_frame and sum(self._current_frame) + pins > self.MAX_PINS:
+            raise ValueError(
+                "the two rolls in a frame cannot knock down more than 10 pins"
+            )
+
+        self._current_frame.append(pins)
+
+        # A strike ends the frame after one roll, an open frame or spare after
