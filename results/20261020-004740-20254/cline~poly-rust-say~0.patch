+    fn under_thousand(n: u64, ones: &[&str; 20], tens: &[&str; 10]) -> String {
+        let mut parts: Vec<String> = Vec::new();
+        let hundreds = n / 100;
+        let remainder = n % 100;
+
+        if hundreds > 0 {
+            parts.push(format!("{} hundred", ones[hundreds as usize]));
+        }
+
+        if remainder > 0 {
+            if remainder < 20 {
