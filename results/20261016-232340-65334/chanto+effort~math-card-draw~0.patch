 from fractions import Fraction
+from math import comb
+
+
+def _hypergeometric_tail(red, blue, draws, k):
+    """P(at least k reds in ``draws`` cards drawn from red + blue cards)."""
+    if k <= 0:
+        return Fraction(1)
+    if k > red or draws < k:
+        return Fraction(0)
+
+    draws = min(draws, red + blue)
+    upper = min(red, draws)
+    favourable = sum(
+        comb(red, x) * comb(blue, draws - x)
+        for x in range(k, upper + 1)
+        if 0 <= draws - x <= blue
+    )
+    return Fraction(favourable, comb(red + blue, draws))
 
 
