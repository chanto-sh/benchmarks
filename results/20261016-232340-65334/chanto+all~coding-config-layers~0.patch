+class EnvironmentTest(unittest.TestCase):
+    def test_env_layer_and_types(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__POOL__SIZE": "20",
+                "SHOPD__DB__POOL__TIMEOUT": "1.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__FEATURES": " search, cache ",
+                "SHOPD__NAME": "other",
+                "PATH": "/usr/bin",
+            }
+        )
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 1.5})
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["search", "cache"])
+        self.assertEqual(cfg["name"], "other")
+
+    def test_env_keys_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__db__pool__SIZE": "9"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+
+    def test_env_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_env_bools(self):
+        for raw, expected in [
+            ("1", True),
+            ("true", True),
+            ("Yes", True),
+            ("ON", True),
+            ("0", False),
+            ("false", False),
+            ("No", False),
+            ("off", False),
+        ]:
+            with self.subTest(raw=raw):
+                cfg = load(env={"SHOPD__DB__SSL": raw})
+                self.assertIs(cfg["db"]["ssl"], expected)
