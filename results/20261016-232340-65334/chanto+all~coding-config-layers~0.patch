+
+def _env_settings(env):
+    for key, raw in env.items():
+        if not key.startswith(ENV_PREFIX):
+            continue
+        name = ".".join(p.lower() for p in key[len(ENV_PREFIX):].split("__"))
+        yield name, raw
+
+
+def _parse_override(item):
+    if "=" not in item:
+        raise ConfigError(f"invalid override (expected KEY=VALUE): {item!r}")
+    name, raw = item.split("=", 1)
+    name = ".".join(p.lower() for p in name.strip().split("."))
+    if not name:
+        raise ConfigError(f"invalid override (expected KEY=VALUE): {item!r}")
+    return name, raw
+
+
+def _default_for(name):
+    """The built-in default at dotted `name`, or ConfigError if it isn't a setting."""
+    node = DEFAULTS
+    for part in name.split("."):
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {name}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"cannot set section: {name}")
+    return node
+
+
+def _convert(name, raw, default):
+    raw = str(raw)
+    if isinstance(default, bool):
+        value = raw.strip().lower()
+        if value in _TRUE:
+            return True
+        if value in _FALSE:
+            return False
+        raise ConfigError(f"invalid boolean for {name}: {raw!r}")
+    if isinstance(default, int):
+        try:
+            return int(raw.strip())
+        except ValueError:
+            raise ConfigError(f"invalid integer for {name}: {raw!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(raw.strip())
+        except ValueError:
+            raise ConfigError(f"invalid float for {name}: {raw!r}") from None
+    if isinstance(default, list):
+        if raw.strip() == "":
+            return []
+        return [item.strip() for item in raw.split(",")]
+    return raw
+
+
+def _set(cfg, name, raw):
+    value = _convert(name, raw, _default_for(name))
+    parts = name.split(".")
+    target = cfg
+    for part in parts[:-1]:
+        child = target.get(part)
+        if not isinstance(child, dict):
+            if part in target:
+                raise ConfigError(f"cannot set {name}: {part} is not an object")
+            child = {}
+            target[part] = child
+        target = child
+    target[parts[-1]] = value
