-"""Integer keys for lists of non-negative integers."""
+"""Integer keys for lists of non-negative integers.
+
+The key for a non-empty list of length ``k`` is built by bit-interleaving its
+elements into one integer ``x`` (bit ``t`` of element ``i`` goes to bit
+``t * k + i`` of ``x``) and then appending a marker bit::
+
+    key = (x << k) | (1 << (k - 1))
+
+The marker gives the key a 2-adic valuation of exactly ``k - 1``, so the key's
+length is recoverable from the key alone.  Since every positive integer has a
+unique 2-adic valuation, and bit-interleaving is itself a bijection, this covers
+every positive integer exactly once.  The empty list uses key 0.
+"""
 
 
 def encode(lst):
     """The key for a list of non-negative ints."""
-    raise NotImplementedError
+    k = len(lst)
+    if k == 0:
+        return 0
+
+    max_bits = max(a.bit_length() for a in lst)
+    if max_bits == 0:
+        x = 0
+    else:
+        # Columns run from the most significant bit to the least significant
+        # bit.  Reversing a column puts element i in bit position i.
+        columns = zip(*(format(a, f"0{max_bits}b") for a in lst))
+        x = 0
+        for column in columns:
+            x = (x << k) | int("".join(reversed(column)), 2)
+
+    return (x << k) | (1 << (k - 1))
 
 
 def decode(n):
     """The list whose key is n (n >= 0)."""
-    raise NotImplementedError
+    if n == 0:
+        return []
+
+    k = (n & -n).bit_length()  # v2(n) + 1, i.e. the list length
+    x = n >> k
+
+    if x == 0:
+        return [0] * k
+
+    bits = format(x, "b")
+    pad = (-len(bits)) % k
+    if pad:
+        bits = "0" * pad + bits
+
+    # Split into k-bit columns, least significant column first, reversing each
+    # so character i is bit t of element i.
+    columns = [bits[i:i + k][::-1] for i in range(len(bits) - k, -1, -k)]
+    return [int("".join(reversed(column)), 2) for column in zip(*columns)]
