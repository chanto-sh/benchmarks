+class CliTest(unittest.TestCase):
+    def run_cli(self, *args, env=None):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=BASE_DIR,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    def clean_env(self, **extra):
+        env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+        env.update(extra)
+        return env
+
+    def test_repeatable_set_options(self):
+        proc = self.run_cli(
+            "--set",
+            "db.port=6543",
+            "--set",
+            "db.pool.size=20",
+            env=self.clean_env(SHOPD__DB__HOST="env.internal"),
+        )
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+
+    def test_bad_set_exits_2(self):
+        proc = self.run_cli("--set", "db.prot=1", env=self.clean_env())
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.prot", proc.stderr)
+
+    def test_bad_env_exits_2(self):
