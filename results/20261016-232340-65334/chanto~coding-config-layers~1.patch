@@ -17,4 +27,77 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+
+    if env is None:
+        env = os.environ
+    env_layer = {}
+    for var in sorted(env):
+        if not var.startswith(ENV_PREFIX):
+            continue
+        parts = [p.lower() for p in var[len(ENV_PREFIX):].split("__")]
+        _set(env_layer, parts, env[var], var)
+
+    override_layer = {}
+    for item in overrides:
+        name, sep, value = item.partition("=")
+        if not sep:
+            raise ConfigError(f"{item}: expected NAME=VALUE")
+        parts = [p.strip().lower() for p in name.split(".")]
+        _set(override_layer, parts, value, item)
+
+    cfg = deep_merge(cfg, env_layer)
+    return deep_merge(cfg, override_layer)
+
+
+def _set(layer, parts, raw, source):
+    """Validate one environment/override setting and put it in `layer`."""
+    if not all(parts):
+        raise ConfigError(f"{source}: invalid setting name")
+    dotted = ".".join(parts)
+    default = _default_for(parts, dotted)
+    value = _convert(dotted, raw, default)
+    node = layer
+    for part in parts[:-1]:
+        node = node.setdefault(part, {})
+    node[parts[-1]] = value
+
+
+def _default_for(parts, dotted):
+    """The built-in default for a setting; raises for unknown names/sections."""
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"{dotted}: unknown setting")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{dotted}: is a section, not a setting")
+    return node
+
+
+def _convert(dotted, raw, default):
+    """Convert a string to the type of the setting's built-in default."""
+    value = str(raw)
+    if isinstance(default, bool):
+        low = value.strip().lower()
+        if low in _TRUE:
+            return True
+        if low in _FALSE:
+            return False
+        raise ConfigError(f"{dotted}: invalid boolean value {value!r}")
+    if isinstance(default, int):
+        try:
+            return int(value.strip())
+        except ValueError:
+            raise ConfigError(f"{dotted}: invalid integer value {value!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(value.strip())
+        except ValueError:
+            raise ConfigError(f"{dotted}: invalid number value {value!r}") from None
+    if isinstance(default, str):
+        return value
+    if isinstance(default, list):
+        if not value.strip():
+            return []
+        return [item.strip() for item in value.split(",") if item.strip()]
+    raise ConfigError(f"{dotted}: unsupported setting type")
