+class PrecedenceTest(unittest.TestCase):
+    def test_defaults_file_env_overrides(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111}}, f)
+        try:
+            path = f.name
+            self.assertEqual(load(path)["db"]["port"], 1111)
+            env = {"SHOPD__DB__PORT": "2222"}
+            self.assertEqual(load(path, env=env)["db"]["port"], 2222)
+            self.assertEqual(
+                load(path, env=env, overrides=["db.port=3333"])["db"]["port"], 3333
+            )
+        finally:
+            os.unlink(path)
+
