+class EnvLayerTest(unittest.TestCase):
+    def test_env_converts_types(self):
+        env = {
+            "SHOPD__DB__HOST": "env.internal",
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__SSL": "yes",
+            "SHOPD__DB__POOL__SIZE": "20",
+            "SHOPD__DB__POOL__TIMEOUT": "1.5",
+            "SHOPD__LOG__LEVEL": "debug",
+            "SHOPD__LOG__JSON": "off",
+            "SHOPD__FEATURES": "search, metrics",
+            "UNRELATED": "ignored",
+            "SHOPD_OTHER": "ignored",
+        }
+        cfg = load(env=env)
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 1.5})
+        self.assertEqual(cfg["log"], {"level": "debug", "json": False})
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+
+    def test_env_keys_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__Db__Pool__Size": "9"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+
+    def test_env_bool_spellings(self):
