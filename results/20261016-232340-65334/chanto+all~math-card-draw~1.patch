 from fractions import Fraction
+from math import comb, factorial
 
 
 def p_at_least(r, b, g, k, m):
@@ -6,4 +7,38 @@ def p_at_least(r, b, g, k, m):
 
     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+    if k > r:
+        return Fraction(0)
+
+    n = r + b + g
+    if m <= 0 or n == 0:
+        return Fraction(0)
+    m = min(m, n)
+
+    favorable = 0
+
+    # The first green card is at position t <= m.  Positions before it contain
+    # j reds and t-1-j blues; the remaining cards can be in any order.
+    if g:
+        for t in range(1, m + 1):
+            lo = max(k, t - 1 - b)
+            hi = min(r, t - 1)
+            if lo <= hi:
+                prefix_ways = sum(
+                    comb(r, j) * comb(b, t - 1 - j) for j in range(lo, hi + 1)
+                )
+                favorable += (
+                    prefix_ways * factorial(t - 1) * g * factorial(n - t)
+                )
+
+    # No green card is among the first m cards, so the deal stops there.
+    lo = max(k, m - b)
+    hi = min(r, m)
+    if lo <= hi:
+        prefix_ways = sum(comb(r, j) * comb(b, m - j) for j in range(lo, hi + 1))
+        favorable += prefix_ways * factorial(m) * factorial(n - m)
+
+    return Fraction(favorable, factorial(n))
+
