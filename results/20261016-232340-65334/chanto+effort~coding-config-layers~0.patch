+class EnvironmentTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_converts_to_default_types(self):
+        cfg = load(env={
+            "SHOPD__DB__HOST": "db.internal",
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "7.5",
+            "SHOPD__DB__SSL": "YeS",
+            "SHOPD__LOG__JSON": "0",
+            "SHOPD__FEATURES": " search , images ",
+        })
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 7.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "images"])
+
+    def test_bool_spellings(self):
+        for raw in ("1", "true", "TRUE", "yes", "on"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True, raw)
+        for raw in ("0", "false", "False", "no", "off"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False, raw)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_names_are_case_insensitive(self):
+        cfg = load(env={"shopd__db__pool__size": "9"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+
+    def test_other_variables_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD_DB_PORT": "1", "DB_PORT": "2"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+
