+class PrecedenceTest(unittest.TestCase):
+    def test_file_then_env_then_override(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "file", "port": 1111, "pool": {"size": 8}}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__HOST": "env", "SHOPD__DB__PORT": "2222"},
+                overrides=["db.host=override"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["host"], "override")
+        self.assertEqual(cfg["db"]["port"], 2222)
+        self.assertEqual(cfg["db"]["pool"], {"size": 8, "timeout": 2.5})
+
+    def test_does_not_mutate_defaults(self):
+        before = json.dumps(DEFAULTS, sort_keys=True)
+        load(env={"SHOPD__DB__HOST": "elsewhere", "SHOPD__FEATURES": "a,b"},
+             overrides=["db.port=1"])
+        self.assertEqual(json.dumps(DEFAULTS, sort_keys=True), before)
+        self.assertEqual(load(env={})["db"]["host"], "localhost")
+
+
