+++ b/verify.py
@@ -17,9 +17,11 @@ def verify(manifest, root):
             if not os.path.exists(path):
                 bad.append(name)
                 continue
-            with open(path) as a:
-                digest = hashlib.sha256(a.read().encode()).hexdigest()
-            if digest != expected:
+            digest = hashlib.sha256()
+            with open(path, "rb") as a:
+                for chunk in iter(lambda: a.read(1024 * 1024), b""):
+                    digest.update(chunk)
+            if digest.hexdigest() != expected.lower():
                 bad.append(name)
     return sorted(bad)
 
