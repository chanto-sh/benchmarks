+                        )
+                        favourable += counts[x] * rest
+
+        # The next card is red or blue: the prefix continues.
+        next_counts = [0] * (r + 1)
+        for x in range(min(i, r) + 1):
+            if not counts[x]:
+                continue
+            blues_used = i - x
+            if x < r:
