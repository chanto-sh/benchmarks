 from fractions import Fraction
+from math import comb
+
+
+def _multinomial(n, reds, blues, greens):
+    """Number of sequences with the given colour counts."""
+    if reds < 0 or blues < 0 or greens < 0:
+        return 0
+    return comb(n, reds) * comb(n - reds, blues)
 
 
 def p_at_least(r, b, g, k, m):
@@ -6,4 +14,55 @@ def p_at_least(r, b, g, k, m):
 
     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+    if k > r:
+        return Fraction(0)
+
+    n = r + b + g
+    m = min(m, n)
+    if m <= 0:
+        return Fraction(0)
+
+    total = _multinomial(n, r, b, g)
+
+    # counts[x] = number of length-i prefixes containing x reds, no greens.
+    counts = [0] * (r + 1)
+    counts[0] = 1
+
+    favourable = 0
+    for i in range(m):
+        # The next card is green: the deal stops here.
