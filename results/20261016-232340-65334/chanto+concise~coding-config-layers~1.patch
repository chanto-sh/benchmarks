 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -29,5 +31,107 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class LayeringTest(unittest.TestCase):
+    def test_environment_layer(self):
+        cfg = load(env={"SHOPD__DB__HOST": "env.internal", "UNRELATED": "x"})
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_environment_is_case_insensitive(self):
+        cfg = load(env={"SHOPD__Db__Pool__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "file.internal", "port": 1111}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__HOST": "env.internal"},
+                overrides=["db.host=cli.internal"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["host"], "cli.internal")
+        self.assertEqual(cfg["db"]["port"], 1111)
+
+    def test_override_values_are_typed(self):
+        cfg = load(
+            env={},
+            overrides=[
+                "db.port=6543",
+                "db.pool.size=20",
+                "db.pool.timeout=3.5",
+                "db.ssl=YES",
+                "log.json=off",
+                "features=search, billing ",
+            ],
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_boolean_spellings(self):
+        for raw in ("1", "true", "YES", "on"):
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={}, overrides=[f"db.ssl={raw}"])["db"]["ssl"], True)
+        for raw in ("0", "false", "No", "OFF"):
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={}, overrides=[f"db.ssl={raw}"])["db"]["ssl"], False)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={}, overrides=["features="])["features"], [])
+
+    def test_unknown_environment_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "6543"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_unknown_override_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={}, overrides=["db.prot=6543"])
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_values(self):
+        for override in ("db.port=abc", "db.port=5.5", "db.pool.timeout=nope", "db.ssl=maybe"):
+            with self.subTest(override=override):
+                with self.assertRaises(ConfigError) as cm:
+                    load(env={}, overrides=[override])
+                self.assertIn(override.split("=")[0], str(cm.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={}, overrides=["db={}"])
+        self.assertIn("db", str(cm.exception))
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_options(self):
+        result = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=on")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        cfg = json.loads(result.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_bad_set_exits_2(self):
+        result = self.run_cli("--set", "db.prot=6543")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.prot", result.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
