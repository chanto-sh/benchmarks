+def _convert(name, default, raw):
+    """Convert the string `raw` to the type of `default`."""
+    if isinstance(default, dict):
+        raise ConfigError(f"{name}: cannot set a whole section")
+    if isinstance(default, bool):
+        value = raw.strip().lower()
+        if value in _TRUE:
+            return True
+        if value in _FALSE:
+            return False
+        raise ConfigError(f"{name}: invalid boolean value {raw!r}")
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError:
+            raise ConfigError(f"{name}: invalid integer value {raw!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError:
+            raise ConfigError(f"{name}: invalid number value {raw!r}") from None
+    if isinstance(default, list):
+        value = raw.strip()
+        return [] if not value else [item.strip() for item in value.split(",")]
+    return raw
