+class EnvironmentTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertIsInstance(cfg["db"]["pool"]["size"], int)
+
+    def test_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "6543"}):
+            self.assertEqual(load()["db"]["port"], 6543)
+
+    def test_types_follow_the_default(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "0.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__NAME": "other",
+                "SHOPD__FEATURES": " search, billing ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["name"], "other")
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_bool_variants(self):
+        true_tokens = ["1", "true", "TRUE", "Yes", "on"]
+        false_tokens = ["0", "false", "FALSE", "No", "off"]
