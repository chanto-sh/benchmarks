+            cfg = load(env={"SHOPD__LOG__JSON": token})
+            self.assertIs(cfg["log"]["json"], True, token)
+        for token in false_tokens:
+            cfg = load(env={"SHOPD__LOG__JSON": token})
+            self.assertIs(cfg["log"]["json"], False, token)
+
