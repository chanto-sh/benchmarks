+    def test_env_names_and_nesting(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__POOL__SIZE": "20",
+                "shopd__Db__HoSt": "db.env",
+                "OTHER_VAR": "ignored",
+                "SHOPD_DB_PORT": "1",
+            }
+        )
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+        self.assertEqual(cfg["db"]["host"], "db.env")
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_env_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "7654"}):
+            self.assertEqual(load()["db"]["port"], 7654)
+
+    def test_env_conversions(self):
+        for raw in ("1", "true", "YES", "On"):
+            self.assertTrue(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], raw)
+        for raw in ("0", "false", "NO", "off"):
+            self.assertFalse(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], raw)
+
+        cfg = load(
+            env={
+                "SHOPD__DB__POOL__TIMEOUT": "3.5",
+                "SHOPD__LOG__LEVEL": "debug",
+                "SHOPD__FEATURES": " search , cache ",
+            }
+        )
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.5)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "cache"])
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_env_bad_values(self):
+        cases = [
+            ({"SHOPD__DB__PORT": "abc"}, "db.port"),
+            ({"SHOPD__DB__PORT": "5.5"}, "db.port"),
+            ({"SHOPD__DB__SSL": "maybe"}, "db.ssl"),
+        ]
+        for env, name in cases:
+            with self.assertRaises(ConfigError) as cm:
+                load(env=env)
+            self.assertIn(name, str(cm.exception))
+
+    def test_env_unknown_and_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(cm.exception))
+
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "nope"})
+        self.assertIn("db", str(cm.exception))
+
+    def test_overrides(self):
+        cfg = load(
