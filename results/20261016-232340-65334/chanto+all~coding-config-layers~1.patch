+class EnvironmentLayerTest(unittest.TestCase):
+    def test_nested_env_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_env_names_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__db__HOST": "env.internal"})
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+
+    def test_unrelated_environment_is_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD_DEBUG": "1", "SHOPD": "x"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_env_converts_to_default_types(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "7.5",
+                "SHOPD__DB__SSL": "YeS",
+                "SHOPD__LOG__LEVEL": "debug",
+                "SHOPD__FEATURES": " search, billing ,reports ",
+            }
+        )
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 7.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "billing", "reports"])
+
+    def test_boolean_values(self):
+        for raw in ("1", "true", "TRUE", "yes", "On"):
+            cfg = load(env={"SHOPD__DB__SSL": raw})
+            self.assertIs(cfg["db"]["ssl"], True, raw)
+        for raw in ("0", "false", "No", "OFF"):
+            cfg = load(env={"SHOPD__DB__SSL": raw})
+            self.assertIs(cfg["db"]["ssl"], False, raw)
+
+    def test_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_environment_does_not_mutate_defaults(self):
+        load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(load(env={})["db"]["pool"]["size"], 5)
+
