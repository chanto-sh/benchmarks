+class PrecedenceTest(unittest.TestCase):
+    def test_defaults_file_env_overrides(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111, "host": "file.internal"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={
+                    "SHOPD__DB__PORT": "2222",
+                    "SHOPD__DB__HOST": "env.internal",
+                },
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
