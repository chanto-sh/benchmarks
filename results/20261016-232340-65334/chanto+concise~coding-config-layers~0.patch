 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -29,5 +31,152 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class EnvTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_case_insensitive_and_other_vars_ignored(self):
+        cfg = load(env={
+            "shopd__db__host": "db.internal",
+            "HOME": "/root",
+            "SHOPD_DB_PORT": "1234",
+        })
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_types(self):
+        cfg = load(env={
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "0.5",
+            "SHOPD__DB__SSL": "Yes",
+            "SHOPD__LOG__JSON": "off",
+            "SHOPD__NAME": "other",
+            "SHOPD__FEATURES": " search , geo ",
+        })
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["name"], "other")
+        self.assertEqual(cfg["features"], ["search", "geo"])
+
+    def test_boolean_spellings(self):
+        for text in ("1", "true", "TRUE", "yes", "On"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": text})["db"]["ssl"], True, text)
+        for text in ("0", "false", "FALSE", "no", "Off"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": text})["db"]["ssl"], False, text)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB__PROT": "6543"})
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(ctx.exception))
+
+    def test_bad_values(self):
+        for name, value in (
+            ("SHOPD__DB__PORT", "abc"),
+            ("SHOPD__DB__PORT", "5.5"),
+            ("SHOPD__DB__SSL", "maybe"),
+            ("SHOPD__DB__POOL__TIMEOUT", "soon"),
+        ):
+            with self.assertRaises(ConfigError) as ctx:
+                load(env={name: value})
+            dotted = name[len("SHOPD__"):].lower().replace("__", ".")
+            self.assertIn(dotted, str(ctx.exception))
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(overrides=[
+            "db.port=6543",
+            "db.pool.size=20",
+            "db.ssl=on",
+            "features=search,geo",
+        ])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["search", "geo"])
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+
+    def test_env_beats_file(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111}}, f)
+        try:
+            cfg = load(f.name, env={"SHOPD__DB__PORT": "2222"})
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 2222)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db.prot=6543"])
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db=6543"])
+        self.assertIn("db", str(ctx.exception))
+
+    def test_bad_value(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db.port=abc"])
+        self.assertIn("db.port", str(ctx.exception))
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args, env=None):
+        child_env = {
+            k: v for k, v in os.environ.items()
+            if not k.upper().startswith("SHOPD__")
+        }
+        if env:
+            child_env.update(env)
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            capture_output=True,
+            text=True,
+            env=child_env,
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+        )
+
+    def test_set_options(self):
+        proc = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=on")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_environment(self):
+        proc = self.run_cli(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        self.assertEqual(json.loads(proc.stdout)["db"]["port"], 6543)
+
+    def test_error_exits_2(self):
+        proc = self.run_cli("--set", "db.port=abc")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.port", proc.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
