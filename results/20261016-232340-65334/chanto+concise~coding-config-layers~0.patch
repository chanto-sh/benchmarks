+def _default_for(dotted):
+    """The built-in default for a dotted setting name."""
+    node = DEFAULTS
+    for part in dotted.split("."):
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"{dotted} is a section, not a setting")
+    return node
+
+
+def _convert(value, default, dotted):
+    """Convert the string `value` to the type of `default`."""
+    if isinstance(default, bool):
+        text = value.strip().lower()
+        if text in _TRUE:
+            return True
+        if text in _FALSE:
+            return False
+        raise ConfigError(f"{dotted}: expected a boolean, got {value!r}")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except ValueError:
+            raise ConfigError(f"{dotted}: expected an integer, got {value!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except ValueError:
+            raise ConfigError(f"{dotted}: expected a number, got {value!r}") from None
+    if isinstance(default, list):
+        if not value.strip():
+            return []
+        return [item.strip() for item in value.split(",")]
+    return value
+
+
+def _set_path(target, dotted, value):
+    parts = dotted.split(".")
+    node = target
+    for part in parts[:-1]:
+        node = node.setdefault(part, {})
+    node[parts[-1]] = value
+
+
+def _from_env(env):
+    out = {}
+    for name, value in env.items():
+        if not name.upper().startswith(ENV_PREFIX):
+            continue
+        dotted = ".".join(p.lower() for p in name[len(ENV_PREFIX):].split("__"))
+        default = _default_for(dotted)
+        _set_path(out, dotted, _convert(value, default, dotted))
+    return out
+
+
+def _from_overrides(overrides):
+    out = {}
+    for raw in overrides:
+        if "=" not in raw:
+            raise ConfigError(f"invalid override {raw!r}: expected KEY=VALUE")
+        key, value = raw.split("=", 1)
+        dotted = key.strip().lower()
+        default = _default_for(dotted)
+        _set_path(out, dotted, _convert(value, default, dotted))
+    return out
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration: defaults, JSON file, environment, overrides."""
