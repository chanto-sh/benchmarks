@@ -38,6 +38,24 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def find(self, tags=()):
+        """Notes carrying all the given tags (matching case-insensitively)."""
+        wanted = [t.strip().lower() for t in tags]
+        return [
+            n
+            for n in self.notes
+            if all(w in {t.lower() for t in n.tags} for w in wanted)
+        ]
+
+    def tag_counts(self):
+        """(tag, count) pairs, most used first, ties alphabetical."""
+        counts = {}
+        for n in self.notes:
+            for tag in n.tags:
+                key = tag.lower()
+                counts[key] = counts.get(key, 0) + 1
+        return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+
