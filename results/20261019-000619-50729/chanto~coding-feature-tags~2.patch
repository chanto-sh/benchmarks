+
+    def test_invalid_tags_are_rejected_and_nothing_saved(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, out, err = run(self.db, "add", "Buy milk", "--tag", bad)
+            self.assertEqual(code, 2, bad)
+            self.assertEqual(out, "")
