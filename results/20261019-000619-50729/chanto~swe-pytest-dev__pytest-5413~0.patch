diff --git a/testing/code/test_excinfo_str_regression.py b/testing/code/test_excinfo_str_regression.py
new file mode 100644
index 0000000..6b365fd
--- /dev/null
+++ b/testing/code/test_excinfo_str_regression.py
@@ -0,0 +1,9 @@
+import pytest
+
+
+def test_excinfo_str_matches_exception_message():
+    with pytest.raises(LookupError) as excinfo:
+        raise LookupError("A\nB\nC")
+
+    assert str(excinfo) == "A\nB\nC"
+    assert str(excinfo) == str(excinfo.value)
