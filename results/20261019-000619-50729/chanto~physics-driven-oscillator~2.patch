+
+    xp_cos, xp_sin = _steady_state_coefficients(m, k, c, F0, omega)
+
+    # Initial conditions for the homogeneous (transient) part.
+    u0 = x0 - xp_cos
+    u1 = v0 - xp_sin * omega
+
+    alpha = c / (2.0 * m)
+    disc = 4.0 * m * k - c * c
+
+    if disc > 0.0:
+        # Underdamped: e^{-alpha t} (u0 cos(wd t) + (u1 + alpha u0) sin(wd t)/wd).
+        wd = math.sqrt(disc) / (2.0 * m)
+        x = wd * t
+        decay = math.exp(-alpha * t)
+        f = decay * math.cos(x)
+        g = decay * t * _sinc(x)
+        u = f * u0 + g * (u1 + alpha * u0)
+    elif disc < 0.0:
+        # Overdamped: u0 e^{-alpha t} cosh(beta t)
+        #             + (u1 + alpha u0) e^{-alpha t} sinh(beta t)/beta.
+        beta = math.sqrt(-disc) / (2.0 * m)
+        r1 = -alpha + beta
