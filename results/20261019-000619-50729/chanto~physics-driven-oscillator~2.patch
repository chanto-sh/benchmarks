 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with the continuous value at x = 0."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        return 1.0 - x2 / 6.0 + x2 * x2 / 120.0
+    return math.sin(x) / x
+
+
+def _expm1_over_x(x):
+    """expm1(x) / x, with the continuous value at x = 0."""
+    if abs(x) < 1e-8:
+        return 1.0 + x / 2.0 + x * x / 6.0
+    return math.expm1(x) / x
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return (A cos(phi), A sin(phi)) for x_p = A cos(omega t - phi)."""
+    d = k - m * omega * omega
+    cw = c * omega
+    den2 = d * d + cw * cw
+    if den2 == 0.0:
+        raise ValueError(
+            "steady-state amplitude is unbounded for an undamped system "
+            "driven exactly at its natural frequency"
+        )
+    return F0 * d / den2, F0 * cw / den2
+
 
