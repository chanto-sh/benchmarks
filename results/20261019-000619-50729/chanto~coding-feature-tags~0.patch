+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    row = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        row += "  " + _tags(note.tags)
+    return row
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append("tags: " + _tags(note.tags))
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..f9cd0af 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,30 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that cannot be stored as given."""
+
+    def __init__(self, tag):
+        super().__init__(tag)
+        self.tag = tag
+
+
+def normalize_tag(tag):
+    """Trim and lowercase one tag, raising InvalidTag if it is not usable."""
+    cleaned = tag.strip().lower()
+    if not cleaned or any(c.isspace() or c in ",#" for c in cleaned):
+        raise InvalidTag(tag)
+    return cleaned
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        cleaned = normalize_tag(tag)
+        if cleaned not in out:
+            out.append(cleaned)
+    return out
 
 
 @dataclass
@@ -6,10 +32,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
