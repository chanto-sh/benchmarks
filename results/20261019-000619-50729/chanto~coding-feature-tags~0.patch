@@ -41,6 +41,87 @@ class NotesTest(unittest.TestCase):
         data = json.load(open(self.db))
         self.assertEqual(data["notes"][0]["title"], "x")
 
+    def test_add_tags_normalized_deduped_and_ordered(self):
+        code, out, _ = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "ERRANDS", "--tag", "home"
+        )
+        self.assertEqual((code, out), (0, "added #1\n"))
+        with open(self.db) as f:
+            data = json.load(f)
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+
+    def test_invalid_tag_saves_nothing(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, out, err = run(self.db, "add", "x", "--tag", "ok", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertEqual(out, "")
+            self.assertEqual(err, f"invalid tag: {bad}\n")
+            self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "b", "--tag", "errands")
+        run(self.db, "add", "c")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  a  #home #errands\n")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "Errands")[1],
+            "  1  a  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+        self.assertEqual(run(self.db, "list")[1], "  1  a  #home #errands\n  2  b  #errands\n  3  c\n")
+
+    def test_show_includes_tags(self):
+        run(self.db, "add", "Call mom", "--body", "about sunday", "--tag", "home", "--tag", "family")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Call mom\ntags: #home #family\n\nabout sunday\n",
+        )
+        run(self.db, "add", "plain")
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 plain\n")
+
+    def test_tags_command_sorted_by_count_then_name(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "b", "--tag", "home")
+        run(self.db, "add", "c", "--tag", "work")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\nerrands 1\nwork 1\n")
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "x")
+        self.assertEqual(run(self.db, "tag", "1", " Home ", "ERrands", "home"), (0, "", ""))
+        self.assertEqual(run(self.db, "list")[1], "  1  x  #home #errands\n")
+        self.assertEqual(run(self.db, "tag", "1", "errands")[1], "")
+        self.assertEqual(run(self.db, "untag", "1", "HOME", "nope")[1], "")
+        self.assertEqual(run(self.db, "list")[1], "  1  x  #errands\n")
+
+    def test_tag_and_untag_unknown_note(self):
+        for cmd in ("tag", "untag"):
