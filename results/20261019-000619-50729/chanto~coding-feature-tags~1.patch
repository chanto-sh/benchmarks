+    def test_file_format_version_2(self):
+        run(self.db, "add", "x")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], [])
+
+    def test_add_normalizes_tags(self):
+        code, out, _ = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "ERRANDS",
+            "--tag", "home",
+        )
+        self.assertEqual((code, out), (0, "added #1\n"))
+        data = json.load(open(self.db))
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(
+            run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n"
+        )
+
+    def test_invalid_tag_saves_nothing(self):
+        bad_tags = ["", "   ", "two words", "a,b", "#hash"]
+        for bad in bad_tags:
+            with self.subTest(tag=bad):
+                code, _, err = run(self.db, "add", "x", "--tag", bad)
+                self.assertEqual(code, 2)
+                self.assertIn("invalid tag", err)
+                self.assertIn(bad, err)
+                self.assertFalse(os.path.exists(self.db))
+
+    def test_invalid_tag_on_existing_note_saves_nothing(self):
+        run(self.db, "add", "x", "--tag", "home")
+        before = open(self.db).read()
+        code, _, err = run(self.db, "tag", "1", "ok", "not ok")
+        self.assertEqual(code, 2)
+        self.assertIn("not ok", err)
+        self.assertEqual(open(self.db).read(), before)
+
+    def test_list_filters_by_all_tags_case_insensitively(self):
+        run(self.db, "add", "one", "--tag", "Home", "--tag", "work")
+        run(self.db, "add", "two", "--tag", "home")
+        run(self.db, "add", "three", "--tag", "work")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  one  #home #work\n  2  two  #home\n")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "WORK")[1],
+            "  1  one  #home #work\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tags_command_orders_by_count_then_name(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "work")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "zeta")
+        run(self.db, "add", "three", "--tag", "alpha")
+        self.assertEqual(
+            run(self.db, "tags")[1], "home 2\nalpha 1\nwork 1\nzeta 1\n"
+        )
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "x", "--tag", "home")
+        self.assertEqual(run(self.db, "tag", "1", "Work", "HOME")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 x\ntags: #home #work\n")
+        self.assertEqual(run(self.db, "untag", "1", "HOME", "nope")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 x\ntags: #work\n")
+        self.assertEqual(run(self.db, "tags")[1], "work 1\n")
