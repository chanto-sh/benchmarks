diff --git a/notes/store.py b/notes/store.py
index 0483c15..e4204fe 100644
--- a/notes/store.py
+++ b/notes/store.py
@@ -3,13 +3,29 @@ import os
 
 from .model import Note
 
-VERSION = 1
+VERSION = 2
 
 
 class NotFound(KeyError):
     pass
 
 
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tags(tags):
+    """Lowercase, trim, validate and de-duplicate tags, keeping first-seen order."""
+    out = []
+    for tag in tags:
+        t = tag.strip().lower()
+        if not t or any(c.isspace() for c in t) or "," in t or "#" in t:
+            raise InvalidTag(tag)
+        if t not in out:
+            out.append(t)
+    return out
+
+
 class Store:
     """Notes persisted as one JSON document: {"version": N, "notes": [...]}."""
 
@@ -24,8 +40,8 @@ class Store:
     def next_id(self):
         return max((n.id for n in self.notes), default=0) + 1
 
-    def add(self, title, body=""):
-        note = Note(self.next_id(), title, body)
+    def add(self, title, body="", tags=None):
+        note = Note(self.next_id(), title, body, list(tags or []))
         self.notes.append(note)
         return note
 
