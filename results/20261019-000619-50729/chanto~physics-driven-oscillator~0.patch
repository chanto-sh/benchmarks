+    xp = cos_coeff * math.cos(omega * t) + sin_coeff * math.sin(omega * t)
+
+    # Homogeneous solution h(t) = h(0) f(t) + h'(0) g(t), where
+    # f(0)=1, f'(0)=0, g(0)=0, g'(0)=1.
+    h0 = x0 - cos_coeff
