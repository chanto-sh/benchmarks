+        wd = math.sqrt((wn - a) * (wn + a))
+        decay = math.exp(-a * t)
+        x = wd * t
+        g = decay * t * _sinc(x)
+        f = decay * math.cos(x) + a * g
+    elif a > wn:
+        # Overdamped.
+        b = math.sqrt((a - wn) * (a + wn))
+        # The slow root is written this way to avoid cancellation when
+        # a is much larger than wn.
+        r1 = -wn * wn / (a + b)
+        r2 = -a - b
+        e1 = math.exp(r1 * t)
+        e2 = math.exp(r2 * t)
+
