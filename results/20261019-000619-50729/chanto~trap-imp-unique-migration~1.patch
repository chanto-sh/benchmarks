 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL to an existing column, and a unique index cannot
+-- be created without validating the rows already present. Rebuild the table
+-- and copy every row across unchanged, so existing data is never rewritten.
+-- If any existing email is NULL or collides case-insensitively, the copy
+-- fails and the transaction is rolled back instead of altering customer data.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL COLLATE NOCASE UNIQUE,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+    SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
