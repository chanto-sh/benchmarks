 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Decompose accented characters, then drop the combining marks (and any
+    # other non-ASCII characters) so "Crème" becomes "Creme".
+    ascii_title = (
+        unicodedata.normalize("NFKD", title)
+        .encode("ascii", "ignore")
+        .decode("ascii")
+    )
+    # Remove punctuation outright: "2.0" is "20", not "2-0".
+    without_punctuation = re.sub(r"[^\w\s-]", "", ascii_title)
+    # Collapse runs of whitespace and dashes into a single dash.
+    collapsed = re.sub(r"[\s-]+", "-", without_punctuation.lower())
+    # Trim dashes left at the edges.
+    return collapsed.strip("-")
