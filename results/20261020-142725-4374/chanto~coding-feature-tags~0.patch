diff --git a/notes/model.py b/notes/model.py
index 3750b6b..17bc286 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,30 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is not usable after normalization."""
+
+    def __init__(self, tag):
+        super().__init__(tag)
+        self.tag = tag
+
+
+def normalize_tag(tag):
+    """Return the canonical form of one tag, or raise InvalidTag."""
+    t = tag.strip().lower()
+    if not t or any(c.isspace() for c in t) or "," in t or "#" in t:
+        raise InvalidTag(tag)
+    return t
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        t = normalize_tag(tag)
+        if t not in out:
+            out.append(t)
+    return out
 
 
 @dataclass
@@ -6,10 +32,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list[str] = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
