+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\n")
+
+    def test_invalid_tags(self):
+        for bad in ["", "   ", "two words", "a,b", "#home", "a\ttab"]:
+            with self.subTest(tag=bad):
+                code, out, err = run(self.db, "add", "Buy milk", "--tag", bad)
+                self.assertEqual(code, 2)
