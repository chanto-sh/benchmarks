 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of an n-point Gauss-Legendre rule."""
+    nodes = []
+    weights = []
+    for i in range(1, (n + 1) // 2 + 1):
+        x = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p_prev = 1.0
+            p = x
+            for k in range(2, n + 1):
+                p_prev, p = p, ((2 * k - 1) * x * p - (k - 1) * p_prev) / k
+            derivative = n * (x * p - p_prev) / (x * x - 1)
+            dx = p / derivative
+            x -= dx
+            if abs(dx) <= 1e-15:
+                break
+        p_prev = 1.0
+        p = x
+        for k in range(2, n + 1):
+            p_prev, p = p, ((2 * k - 1) * x * p - (k - 1) * p_prev) / k
+        derivative = n * (x * p - p_prev) / (x * x - 1)
+        weight = 2.0 / ((1.0 - x * x) * derivative * derivative)
+        if abs(x) < 1e-15:
+            nodes.append(0.0)
+            weights.append(weight)
+        else:
+            nodes.extend((-x, x))
+            weights.extend((weight, weight))
+    return nodes, weights
+
+
+_GL_NODES, _GL_WEIGHTS = _gauss_legendre(12)
+_PHASE_STEP = math.pi / 2.0
+
+
