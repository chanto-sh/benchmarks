+    def test_eccentric_two_body_energy(self):
+        # Equal masses on an eccentric orbit (e = 0.6) with periapsis at x = 0.4.
+        m = [1.0, 1.0]
+        rp = 0.4
+        v = math.sqrt((1.0 + 0.6) / (1.0 - 0.6))  # relative speed at periapsis
+        pos = [[-rp, 0.0], [rp, 0.0]]
+        vel = [[0.0, -0.5 * v], [0.0, 0.5 * v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_three_body_figure_eight_energy(self):
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753], [-0.97000436, 0.24308753], [0.0, 0.0]]
+        vel = [
+            [0.466203685, 0.43236573],
+            [0.466203685, 0.43236573],
