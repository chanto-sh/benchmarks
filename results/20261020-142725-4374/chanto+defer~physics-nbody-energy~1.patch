+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_total_momentum_conserved(self):
+        m = [1.0, 2.0, 3.0]
+        pos = [[-1.0, 0.0], [1.0, 0.5], [0.2, -1.0]]
+        vel = [[0.1, -0.2], [-0.3, 0.1], [0.15, 0.05]]
+        p0 = total_momentum(m, vel)
+        _, q = simulate(m, pos, vel, 0.005, 5000)
+        p1 = total_momentum(m, q)
