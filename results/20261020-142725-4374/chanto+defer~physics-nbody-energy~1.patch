diff --git a/nbody.py b/nbody.py
index 133b00d..cb8e2eb 100644
--- a/nbody.py
+++ b/nbody.py
@@ -30,4 +30,32 @@ def energy(masses, positions, velocities, G=1.0):
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
     """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    n = len(masses)
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(vx), float(vy)] for vx, vy in velocities]
+    acc = accelerations(masses, pos, G)
+
+    # Fourth-order symplectic composition (Forest-Ruth/Yoshida) of
+    # velocity-Verlet substeps.  Being symplectic keeps the energy error
+    # bounded over long runs rather than drifting, and every kick conserves
+    # momentum.
+    cbrt2 = 2.0 ** (1.0 / 3.0)
+    w1 = 1.0 / (2.0 - cbrt2)
+    w0 = -cbrt2 / (2.0 - cbrt2)
+
+    for _ in range(steps):
+        for weight in (w1, w0, w1):
+            step = dt * weight
+            half_step = 0.5 * step
+            for i in range(n):
+                vel[i][0] += half_step * acc[i][0]
+                vel[i][1] += half_step * acc[i][1]
+            for i in range(n):
+                pos[i][0] += step * vel[i][0]
+                pos[i][1] += step * vel[i][1]
+            acc = accelerations(masses, pos, G)
+            for i in range(n):
+                vel[i][0] += half_step * acc[i][0]
+                vel[i][1] += half_step * acc[i][1]
+
+    return pos, vel
