 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents to their ASCII base characters (é -> e).
+    decomposed = unicodedata.normalize("NFKD", title)
+    ascii_title = "".join(c for c in decomposed if not unicodedata.combining(c))
+
+    ascii_title = ascii_title.lower()
+
+    # Spaces and dashes are word separators; everything else that is not an
+    # allowed character is dropped.
+    separated = re.sub(r"[\s-]+", "-", ascii_title)
+    stripped = re.sub(r"[^a-z0-9_-]", "", separated)
+    return stripped.strip("-")
