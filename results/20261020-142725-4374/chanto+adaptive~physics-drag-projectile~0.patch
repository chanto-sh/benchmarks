 """Point-mass projectile with quadratic air drag."""
 
+import math
+
+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0, -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0, 49.0 / 176.0,
+     -5103.0 / 18656.0),
+    (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+     -2187.0 / 6784.0, 11.0 / 84.0),
+)
+_B5 = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+       -2187.0 / 6784.0, 11.0 / 84.0, 0.0)
+_B4 = (5179.0 / 57600.0, 0.0, 7571.0 / 16695.0, 393.0 / 640.0,
+       -92097.0 / 339200.0, 187.0 / 2100.0, 1.0 / 40.0)
+
+
+def _derivative(state, k_over_m, g):
+    _, _, vx, vy = state
+    speed = math.hypot(vx, vy)
+    drag = k_over_m * speed
+    return (vx, vy, -drag * vx, -g - drag * vy)
+
+
+def _rk_step(state, h, k_over_m, g):
+    """One Dormand-Prince step; return the fifth-order state and error norm."""
+    stages = []
+    for i in range(7):
+        if i == 0:
+            stages.append(_derivative(state, k_over_m, g))
+            continue
+        stage = tuple(
+            state[j] + h * sum(a * k[j] for a, k in zip(_A[i], stages))
+            for j in range(4)
+        )
+        stages.append(_derivative(stage, k_over_m, g))
+
+    high = tuple(
+        state[j] + h * sum(b * k[j] for b, k in zip(_B5, stages))
+        for j in range(4)
+    )
+    low = tuple(
+        state[j] + h * sum(b * k[j] for b, k in zip(_B4, stages))
+        for j in range(4)
+    )
+
+    # RMS error scaled per component.  The tolerances are deliberately far
+    # tighter than the four-significant-figure accuracy the range table needs.
+    err = 0.0
+    for j in range(4):
+        scale = 1.0e-13 + 1.0e-12 * max(abs(state[j]), abs(high[j]))
+        ratio = (high[j] - low[j]) / scale
+        err += ratio * ratio
+    return high, math.sqrt(err / 4.0)
+
+
+def _event_state(state, h, k_over_m, g, index, target):
+    """Locate the first zero of state[index] - target in [0, h]."""
+    lo = 0.0
+    hi = h
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        value, _ = _rk_step(state, mid, k_over_m, g)
+        if value[index] - target > 0.0:
+            lo = mid
+        else:
+            hi = mid
+    tau = 0.5 * (lo + hi)
+    final, _ = _rk_step(state, tau, k_over_m, g)
+    return tau, final
+
 
 def flight(v0, angle_deg, mass, k, g=9.81, h0=0.0):
     """Return {"range": metres, "apex": metres, "time": seconds}."""
-    raise NotImplementedError
+    theta = math.radians(angle_deg)
+    state = (0.0, float(h0), v0 * math.cos(theta), v0 * math.sin(theta))
+
+    # Already on (or below) the ground and not moving upwards.
+    if state[1] <= 0.0 and state[3] <= 0.0:
+        return {"range": 0.0, "apex": float(h0), "time": 0.0}
+
+    k_over_m = k / mass
+    apex = float(h0)
+    apex_found = state[3] <= 0.0
+
+    t = 0.0
+    h = 1.0e-6
+    while True:
+        new_state, err = _rk_step(state, h, k_over_m, g)
+
+        if err <= 1.0:
+            # The vertical velocity changes sign at most once; find the apex
+            # before looking for the ground crossing in this same step.
+            if not apex_found and state[3] > 0.0 and new_state[3] <= 0.0:
+                _, apex_state = _event_state(
+                    state, h, k_over_m, g, 3, 0.0)
+                apex = apex_state[1]
+                apex_found = True
+
+            if state[1] > 0.0 and new_state[1] <= 0.0:
+                tau, final = _event_state(state, h, k_over_m, g, 1, 0.0)
+                if not apex_found:
+                    apex = final[1]
+                return {
+                    "range": final[0],
+                    "apex": apex,
+                    "time": t + tau,
+                }
+
+            t += h
+            state = new_state
+            factor = (5.0 if err == 0.0
+                      else min(5.0, max(0.2, 0.9 * err ** -0.2)))
+            h *= factor
+        else:
+            h *= max(0.2, 0.9 * err ** -0.2)
