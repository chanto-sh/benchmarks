@@ -38,6 +38,30 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def tag(self, note_id, tags):
+        note = self.get(note_id)
+        tags = normalize_tags(tags)
+        note.tags = note.tags + [t for t in tags if t not in note.tags]
+        return note
+
+    def untag(self, note_id, tags):
+        note = self.get(note_id)
+        drop = set(normalize_tags(tags))
+        note.tags = [t for t in note.tags if t not in drop]
+        return note
+
+    def find(self, tags=()):
+        """Notes carrying every one of `tags` (case-insensitive)."""
+        wanted = [t.strip().lower() for t in tags]
+        return [n for n in self.notes if all(w in n.tags for w in wanted)]
+
+    def tag_counts(self):
+        counts = {}
+        for n in self.notes:
+            for t in n.tags:
+                counts[t] = counts.get(t, 0) + 1
+        return counts
+
     def save(self):
         tmp = self.path + ".tmp"
         with open(tmp, "w") as f:
