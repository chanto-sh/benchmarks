         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..95bc178 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Trim and lowercase one tag, rejecting unusable ones."""
+    norm = tag.strip().lower()
+    if not norm or any(c.isspace() for c in norm) or "," in norm or "#" in norm:
+        raise InvalidTag(tag)
+    return norm
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping repeats but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        norm = normalize_tag(tag)
+        if norm not in out:
+            out.append(norm)
+    return out
 
 
 @dataclass
@@ -6,10 +28,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
