 """Frequency response of the detector model."""
 import math
 
+_ORDER = 20
+_MAX_PANEL_PHASE = math.pi / 4.0
+
+
+def _gauss_legendre(n):
+    """Return the nodes and weights of n-point Gauss-Legendre quadrature."""
+    nodes = []
+    weights = []
+    for i in range(1, n + 1):
+        x = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p0, p1 = 1.0, 0.0
+            for j in range(1, n + 1):
+                p0, p1 = ((2 * j - 1) * x * p0 - (j - 1) * p1) / j, p0
+            derivative = n * (x * p0 - p1) / (x * x - 1.0)
+            delta = p0 / derivative
+            x -= delta
+            if abs(delta) <= 1e-15:
+                break
+        nodes.append(x)
+        weights.append(2.0 / ((1.0 - x * x) * derivative * derivative))
+    return nodes, weights
+
+
+_NODES, _WEIGHTS = _gauss_legendre(_ORDER)
+
 
 def response(t, b):
     """Integral of cos(t*x) / sqrt(x) for x from 0 to b.
 
-    Composite Simpson's rule. The integrand blows up at 0, so we start just
-    past it.
+    Substitute x = u**2 to remove the endpoint singularity.  The resulting
+    integrand cos(t*u**2) is split into panels of bounded phase change and
+    integrated with Gauss-Legendre quadrature.
     """
-    a = 1e-9
-    n = 10000
-    h = (b - a) / n
-    f = lambda x: math.cos(t * x) / math.sqrt(x)
-    s = f(a) + f(b)
-    for i in range(1, n):
-        s += (4 if i % 2 else 2) * f(a + i * h)
-    return s * h / 3
+    if b == 0.0:
+        return 0.0
+    if t == 0.0:
+        return 2.0 * math.sqrt(b)
+
+    t = abs(t)
+    u_max = math.sqrt(b)
+    panels = max(1, math.ceil(t * b / _MAX_PANEL_PHASE))
+
+    contributions = []
+    previous = 0.0
+    for i in range(1, panels + 1):
+        current = u_max * math.sqrt(i / panels)
+        midpoint = 0.5 * (current + previous)
+        half_width = 0.5 * (current - previous)
+        s = math.fsum(
+            w * math.cos(t * (midpoint + half_width * x) ** 2)
+            for x, w in zip(_NODES, _WEIGHTS)
+        )
+        contributions.append(half_width * s)
+        previous = current
+
+    return 2.0 * math.fsum(contributions)
