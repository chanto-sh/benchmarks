@@ -3,4 +3,49 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # Unknowns are the expected remaining turns from squares 0..n-1.
+    # Square n is absorbing, so E[n] = 0.
+    #
+    # For each square p, averaging over the k equally likely rolls gives:
+    #   E[p] = 1 + (1/k) * sum(E[next(p, roll)])
+    # which we rearrange into k*E[p] - sum(E[next]) = k.
+    size = n
+    matrix = [[Fraction(0) for _ in range(size + 1)] for _ in range(size)]
+
+    for p in range(size):
+        matrix[p][p] += k
+        for roll in range(1, k + 1):
+            q = p + roll
+            if q > n:
+                q = 2 * n - q  # bounce back by the excess
+            if q < n:
+                matrix[p][q] -= 1
+        matrix[p][size] = Fraction(k)
+
+    # Gaussian elimination with partial pivoting.
+    for col in range(size):
+        pivot = next(row for row in range(col, size) if matrix[row][col] != 0)
+        if pivot != col:
+            matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+
+        pivot_row = matrix[col]
+        pivot_value = pivot_row[col]
+        for j in range(col, size + 1):
+            pivot_row[j] /= pivot_value
+
+        for row in range(col + 1, size):
+            factor = matrix[row][col]
+            if factor:
+                current = matrix[row]
+                for j in range(col, size + 1):
+                    current[j] -= factor * pivot_row[j]
+
+    # Back substitution.
+    values = [Fraction(0)] * size
+    for i in range(size - 1, -1, -1):
+        total = matrix[i][size]
+        for j in range(i + 1, size):
+            total -= matrix[i][j] * values[j]
+        values[i] = total
+
+    return values[0]
