+        solution, error, stages = _rk_step(state, h, drag, g)
+
+        error_norm = math.sqrt(
+            sum(
+                (error[j] / (_ATOL + _RTOL * max(abs(state[j]), abs(solution[j]))))
+                ** 2
+                for j in range(4)
+            )
+            / 4.0
+        )
+        if error_norm > 1.0:
+            h *= max(0.2, 0.9 * error_norm**-0.2)
+            continue
+
+        if phase == 1 and solution[3] <= 0.0:
+            theta = _event_time(stages, state, h, 3)
+            t += theta * h
+            state = _dense(stages, state, h, theta)
