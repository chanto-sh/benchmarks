+    def test_eccentric_binary_energy(self):
+        # Two equal masses with eccentricity 0.6, started at periapsis.
+        a, e = 1.25, 0.6
+        rp = a * (1.0 - e)
+        vp = math.sqrt((1.0 + e) / (a * (1.0 - e)))
+        m = [1.0, 1.0]
+        pos = [[-rp / 2.0, 0.0], [rp / 2.0, 0.0]]
+        vel = [[0.0, -vp / 2.0], [0.0, vp / 2.0]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_figure_eight_energy_and_momentum(self):
+        # Chenciner-Montgomery figure-eight three-body orbit.
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vx, vy = -0.93240737, -0.86473146
+        vel = [[-vx / 2.0, -vy / 2.0], [-vx / 2.0, -vy / 2.0], [vx, vy]]
+        e0 = energy(m, pos, vel)
+        p0 = momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        for got, want in zip(momentum(m, q), p0):
+            self.assertAlmostEqual(got, want, delta=1e-10)
+
+    def test_momentum_conserved_and_inputs_untouched(self):
+        # Unequal circular binary drifting through space (non-zero total P).
+        m = [3.0, 1.0]
+        pos = [[-0.5, 0.0], [1.5, 0.0]]
+        vel = [[0.0, -0.25], [0.0, 0.75]]
+        pos0, vel0 = copy.deepcopy(pos), copy.deepcopy(vel)
+        p0 = momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.005, 5000)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertLess(abs(energy(m, p, q) - energy(m, pos0, vel0)) / abs(energy(m, pos0, vel0)), 1e-6)
+        for got, want in zip(momentum(m, q), p0):
+            self.assertAlmostEqual(got, want, delta=1e-10)
+
 
 if __name__ == "__main__":
