index 133b00d..d0060f6 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,39 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick), a symplectic second-order
+    integrator.  Its energy error stays bounded instead of accumulating
+    secularly, and the pairwise forces conserve total momentum.
+    """
+    n = len(masses)
+    # Work on copies so the caller's lists are never modified.  Converting to
+    # floats also keeps all arithmetic consistent (e.g. integer inputs).
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(vx), float(vy)] for vx, vy in velocities]
+    mass = [float(m) for m in masses]
+
+    if n == 0 or steps == 0:
+        return pos, vel
+
+    acc = accelerations(mass, pos, G)
+    half_dt = 0.5 * dt
+    half_dt2 = 0.5 * dt * dt
+
+    for _ in range(steps):
+        # Drift with the current acceleration (half kick included).
+        for i in range(n):
+            pos[i][0] += vel[i][0] * dt + acc[i][0] * half_dt2
+            pos[i][1] += vel[i][1] * dt + acc[i][1] * half_dt2
+
+        new_acc = accelerations(mass, pos, G)
+
+        # Second half of the kick.
+        for i in range(n):
+            vel[i][0] += half_dt * (acc[i][0] + new_acc[i][0])
+            vel[i][1] += half_dt * (acc[i][1] + new_acc[i][1])
+
+        acc = new_acc
+
+    return pos, vel
