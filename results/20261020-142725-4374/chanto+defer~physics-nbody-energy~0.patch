+import copy
 import math
 import unittest
 
 from nbody import energy, simulate
 
 
+def momentum(masses, velocities):
+    return [sum(m * v[k] for m, v in zip(masses, velocities)) for k in range(2)]
+
+
 class TestNBody(unittest.TestCase):
