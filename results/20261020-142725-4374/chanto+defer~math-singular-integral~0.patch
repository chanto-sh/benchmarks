 def response(t, b):
     """Integral of cos(t*x) / sqrt(x) for x from 0 to b.
 
-    Composite Simpson's rule. The integrand blows up at 0, so we start just
-    past it.
+    Substituting x = s^2 removes the endpoint singularity:
+    the integral becomes 2 * integral of cos(t*s^2) from 0 to sqrt(b).
+    The smooth integrand is then integrated with composite Gauss-Legendre
+    quadrature, using enough panels to resolve its oscillations.
     """
-    a = 1e-9
-    n = 10000
-    h = (b - a) / n
-    f = lambda x: math.cos(t * x) / math.sqrt(x)
-    s = f(a) + f(b)
-    for i in range(1, n):
-        s += (4 if i % 2 else 2) * f(a + i * h)
-    return s * h / 3
+    if t == 0:
+        return 2.0 * math.sqrt(b)
+
+    r = math.sqrt(b)
+    panels = max(1, math.ceil(t * b))
+    h = r / panels
+    half = 0.5 * h
+
+    terms = []
+    for i in range(panels):
+        center = (i + 0.5) * h
+        for node, weight in zip(_NODES, _WEIGHTS):
+            s = center + half * node
+            terms.append(weight * math.cos(t * s * s))
+    return h * math.fsum(terms)
