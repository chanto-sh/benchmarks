@@ -3,4 +3,44 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    if not 1 <= k <= n:
+        raise ValueError("expected 1 <= k <= n")
+
+    # Unknowns are E[0], ..., E[n-1]; E[n] is 0 because the game is over.
+    # Multiply each equation E[i] = 1 + (1/k) * sum_r E[next(i, r)] by k:
+    #     k*E[i] - sum_r E[next(i, r)] = k
+    size = n
+    matrix = [[Fraction(0) for _ in range(size + 1)] for _ in range(size)]
+
+    for i in range(size):
+        matrix[i][i] = Fraction(k)
+        matrix[i][size] = Fraction(k)
+        for roll in range(1, k + 1):
+            j = i + roll
+            if j > n:
+                j = 2 * n - j  # bounce back by the excess
+            if j != n:
+                matrix[i][j] -= 1
+
+    # Gauss-Jordan elimination with exact Fraction arithmetic.
+    for col in range(size):
+        pivot = max(range(col, size), key=lambda row: abs(matrix[row][col]))
+        if matrix[pivot][col] == 0:
+            raise ValueError("singular system")
+        if pivot != col:
+            matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+
+        pivot_value = matrix[col][col]
+        for j in range(col, size + 1):
+            matrix[col][j] /= pivot_value
+
+        for row in range(size):
+            if row == col:
+                continue
+            factor = matrix[row][col]
+            if factor == 0:
+                continue
+            for j in range(col, size + 1):
+                matrix[row][j] -= factor * matrix[col][j]
+
+    return matrix[0][size]
