 """URL slugs for article titles."""
 import re
+import unicodedata
+
+# Drop punctuation (apostrophes, commas, periods, ...) rather than turning it
+# into a word break; "-" is kept so it can act as a separator below.
+_STRIP_PUNCTUATION = re.compile(r"[^\w\s-]", re.ASCII)
+_SEPARATOR_RUN = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_title = normalized.encode("ascii", "ignore").decode("ascii")
+    unpunctuated = _STRIP_PUNCTUATION.sub("", ascii_title).lower()
+    return _SEPARATOR_RUN.sub("-", unpunctuated).strip("-")
