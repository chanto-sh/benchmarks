diff --git a/notes/model.py b/notes/model.py
index 3750b6b..f1ecfa5 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def clean_tag(tag):
+    """Lowercase and trim *tag*, or raise InvalidTag if it is not valid."""
+    cleaned = tag.strip().lower()
+    if not cleaned or any(c.isspace() for c in cleaned) or "," in cleaned or "#" in cleaned:
+        raise InvalidTag(tag)
+    return cleaned
+
+
+def clean_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        cleaned = clean_tag(tag)
+        if cleaned not in out:
+            out.append(cleaned)
+    return out
 
 
 @dataclass
