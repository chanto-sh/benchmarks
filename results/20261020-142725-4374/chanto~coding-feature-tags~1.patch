+class TagsTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.db = os.path.join(self.dir.name, "notes.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.db) as f:
+            return json.load(f)
+
+    def test_add_normalizes_tags(self):
+        code, _, _ = run(
+            self.db, "add", "Buy milk", "--tag", "  Home ", "--tag", "Errands", "--tag", "home"
+        )
+        self.assertEqual(code, 0)
+        self.assertEqual(self.read()["notes"][0]["tags"], ["home", "errands"])
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+
+    def test_invalid_tags(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, _, err = run(self.db, "add", "x", "--tag", "home", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertIn(bad, err)
+            self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tags(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "two", "--tag", "HOME")
+        run(self.db, "add", "three", "--tag", "work")
+        self.assertEqual(run(self.db, "list", "--tag", "Home")[1], "  1  one  #home #errands\n  2  two  #home\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "ERRANDS")[1], "  1  one  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "missing")[1], "")
+
+    def test_show_tags_line(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        run(self.db, "add", "With body", "--body", "text", "--tag", "home")
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 With body\ntags: #home\n\ntext\n")
+        run(self.db, "add", "Plain")
+        self.assertEqual(run(self.db, "show", "3")[1], "#3 Plain\n")
+
+    def test_tags_summary(self):
+        self.assertEqual(run(self.db, "tags")[1], "")
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "two", "--tag", "home")
+        run(self.db, "add", "three", "--tag", "work", "--tag", "errands")
+        self.assertEqual(run(self.db, "tags")[1], "errands 2\nhome 2\nwork 1\n")
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "Buy milk", "--tag", "home")
+        self.assertEqual(run(self.db, "tag", "1", "Errands", "HOME")[0], 0)
+        self.assertEqual(self.read()["notes"][0]["tags"], ["home", "errands"])
+        self.assertEqual(run(self.db, "untag", "1", "home", "missing")[0], 0)
+        self.assertEqual(self.read()["notes"][0]["tags"], ["errands"])
+
+    def test_tag_unknown_note(self):
+        code, _, err = run(self.db, "tag", "9", "home")
+        self.assertEqual(code, 1)
+        self.assertIn("no such note", err)
+        code, _, err = run(self.db, "untag", "9", "home")
+        self.assertEqual(code, 1)
+        self.assertIn("no such note", err)
+
+    def test_tag_invalid_saves_nothing(self):
+        run(self.db, "add", "x")
+        before = self.read()
+        code, _, err = run(self.db, "tag", "1", "good", "bad tag")
+        self.assertEqual(code, 2)
+        self.assertIn("bad tag", err)
+        self.assertEqual(self.read(), before)
+
+    def test_legacy_file_loads_and_saves_v2(self):
+        with open(self.db, "w") as f:
+            json.dump({"version": 1, "notes": [{"id": 1, "title": "old", "body": ""}]}, f)
+        self.assertEqual(run(self.db, "list")[1], "  1  old\n")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 old\n")
+        run(self.db, "add", "new", "--tag", "home")
+        data = self.read()
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], [])
+        self.assertEqual(data["notes"][1]["tags"], ["home"])
+
+
 if __name__ == "__main__":
     unittest.main()
