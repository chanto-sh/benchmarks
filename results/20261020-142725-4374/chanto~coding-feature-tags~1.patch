+                note.tags.append(tag)
+        return note
+
+    def remove_tags(self, note_id, tags):
+        note = self.get(note_id)
+        note.tags = [tag for tag in note.tags if tag not in tags]
+        return note
+
+    def tag_counts(self):
+        counts = {}
+        for n in self.notes:
+            for tag in n.tags:
