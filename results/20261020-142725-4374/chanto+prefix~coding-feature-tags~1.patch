+def tags_text(tags):
+    """`#home #errands`, or "" when there are no tags."""
+    return " ".join("#" + t for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + tags_text(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {tags_text(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..83bf8ab 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,20 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty, or contains whitespace, a comma or '#'."""
+
+
+def normalize_tags(tags):
+    """Trim, lowercase and validate tags, dropping duplicates and keeping first-seen order."""
+    out = []
+    for raw in tags:
+        tag = raw.strip().lower()
+        if not tag or any(c.isspace() or c in ",#" for c in tag):
+            raise InvalidTag(raw)
+        if tag not in out:
+            out.append(tag)
+    return out
 
 
 @dataclass
@@ -6,10 +22,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
