@@ -38,6 +39,24 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def add_tags(self, note_id, tags):
+        note = self.get(note_id)
+        for tag in tags:
+            if tag not in note.tags:
+                note.tags.append(tag)
+        return note
+
+    def remove_tags(self, note_id, tags):
+        note = self.get(note_id)
+        drop = set(tags)
+        note.tags = [t for t in note.tags if t not in drop]
+        return note
+
+    def tag_counts(self):
+        """(tag, count) pairs, most used first, ties alphabetically."""
+        counts = Counter(t for n in self.notes for t in n.tags)
+        return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+
