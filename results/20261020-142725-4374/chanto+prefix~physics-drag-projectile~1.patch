+            return {
+                "range": state[0],
+                "apex": apex,
+                "time": t,
+            }
+
+        state = candidate
+        t += h
+        if apex_pending:
+            apex = max(apex, state[1])
+
+        # Standard step-size update for Dormand-Prince.
+        if err_norm == 0.0:
+            factor = 5.0
+        else:
+            factor = min(5.0, max(0.2, 0.9 * (1.0 / err_norm) ** 0.2))
+        h *= factor
