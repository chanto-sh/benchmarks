+    def test_eccentric_binary_energy_is_bounded(self):
+        # e = 0.5 orbit with semi-major axis 1 and total mass 2
+        m = [1.0, 1.0]
+        r = 0.5
+        v = math.sqrt(2.0 * 1.5 / 0.5)
+        pos = [[-r / 2, 0.0], [r / 2, 0.0]]
+        vel = [[0.0, -v / 2], [0.0, v / 2]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_figure_eight_energy_is_bounded(self):
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        vx, vy = 0.466203685, 0.43236573
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vel = [[vx, vy], [vx, vy], [-2.0 * vx, -2.0 * vy]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_momentum_is_conserved(self):
+        m = [2.0, 0.5]
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.1, -0.3], [0.1, 1.2]]
+        p0 = [sum(mi * vi[k] for mi, vi in zip(m, vel)) for k in range(2)]
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        p1 = [sum(mi * vi[k] for mi, vi in zip(m, q)) for k in range(2)]
+        self.assertAlmostEqual(p1[0], p0[0], places=10)
+        self.assertAlmostEqual(p1[1], p0[1], places=10)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[-1.0, 0.5], [2.0, -0.25]]
+        vel = [[0.0, -0.4], [0.0, 0.2]]
+        pos0 = [[x, y] for x, y in pos]
+        vel0 = [[x, y] for x, y in vel]
+        simulate(m, pos, vel, 0.01, 100)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
 
 if __name__ == "__main__":
