diff --git a/nbody.py b/nbody.py
index 133b00d..b74e16f 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,33 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses a fourth-order symplectic kick-drift-kick composition, so the energy
+    error stays bounded over long integrations instead of drifting secularly.
+    """
+    n = len(masses)
+    pos = [[p[0], p[1]] for p in positions]
+    vel = [[v[0], v[1]] for v in velocities]
+
+    cbrt2 = 2.0 ** (1.0 / 3.0)
+    w1 = 1.0 / (2.0 - cbrt2)
+    w0 = -cbrt2 * w1
+    kicks = (0.5 * w1, 0.5 * (w0 + w1), 0.5 * (w0 + w1), 0.5 * w1)
+    drifts = (w1, w0, w1)
+
+    for _ in range(steps):
+        for stage in range(4):
+            acc = accelerations(masses, pos, G)
+            h = kicks[stage] * dt
+            for i in range(n):
+                vel[i][0] += h * acc[i][0]
+                vel[i][1] += h * acc[i][1]
+
+            if stage < 3:
+                h = drifts[stage] * dt
+                for i in range(n):
+                    pos[i][0] += h * vel[i][0]
+                    pos[i][1] += h * vel[i][1]
+
+    return pos, vel
