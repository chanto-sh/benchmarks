 import math
 
 
+_GAUSS_ORDER = 24
+_MAX_PANEL_PHASE = math.pi / 4.0
+
+
+def _gauss_legendre(n):
+    """Return nodes and weights for n-point Gauss-Legendre quadrature."""
+    nodes = [0.0] * n
+    weights = [0.0] * n
+    for i in range((n + 1) // 2):
+        z = math.cos(math.pi * (i + 0.75) / (n + 0.5))
+        while True:
+            p1, p2 = 1.0, 0.0
+            for j in range(1, n + 1):
+                p3 = p2
+                p2 = p1
+                p1 = ((2 * j - 1) * z * p2 - (j - 1) * p3) / j
+            derivative = n * (z * p1 - p2) / (z * z - 1.0)
+            previous = z
+            z = previous - p1 / derivative
+            if abs(z - previous) <= 1e-15:
+                break
+        nodes[i] = -z
+        nodes[n - 1 - i] = z
+        weight = 2.0 / ((1.0 - z * z) * derivative * derivative)
+        weights[i] = weight
+        weights[n - 1 - i] = weight
+    return nodes, weights
+
+
+_GAUSS_NODES, _GAUSS_WEIGHTS = _gauss_legendre(_GAUSS_ORDER)
+
