@@ -41,6 +41,83 @@ class NotesTest(unittest.TestCase):
         data = json.load(open(self.db))
         self.assertEqual(data["notes"][0]["title"], "x")
 
+    def test_save_writes_version_2_and_tags(self):
+        run(self.db, "add", "x")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], [])
+
+    def test_add_normalizes_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "Errands", "--tag", "HOME")
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        data = json.load(open(self.db))
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_add_invalid_tags(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, out, err = run(self.db, "add", "Buy milk", "--tag", "ok", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertIn(repr(bad), err)
+            self.assertEqual(out, "")
+            self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tags(self):
+        run(self.db, "add", "one", "--tag", "Home")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "three", "--tag", "errands")
+        run(self.db, "add", "four")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1],
+                         "  1  one  #home\n  2  two  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "Errands")[1],
+                         "  2  two  #home #errands\n")
+
+    def test_show_tags_line(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands", "--body", "2%")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Buy milk\ntags: #home #errands\n\n2%\n",
+        )
+        run(self.db, "add", "plain")
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 plain\n")
+
+    def test_tags_counts(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands", "--tag", "zzz")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "beta")
+        run(self.db, "add", "three", "--tag", "home")
+        self.assertEqual(run(self.db, "tags")[1], "home 3\nbeta 1\nerrands 1\nzzz 1\n")
+
+    def test_tag_and_untag(self):
