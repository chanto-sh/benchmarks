+        self.assertEqual(run(self.db, "show", "1")[1], "#1 one\ntags: #home #errands #new\n")
+        self.assertEqual(run(self.db, "untag", "1", "HOME", "missing")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 one\ntags: #errands #new\n")
