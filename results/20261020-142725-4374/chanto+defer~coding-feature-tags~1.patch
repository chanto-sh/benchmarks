@@ -1,11 +1,20 @@
+def _hashtags(tags):
+    return " ".join(f"#{t}" for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + _hashtags(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_hashtags(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..509d726 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,20 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tags(tags):
+    """Lowercase, trim and de-duplicate tags, keeping first-seen order."""
+    out = []
+    for raw in tags:
+        tag = raw.strip().lower()
+        if not tag or any(c.isspace() for c in tag) or "," in tag or "#" in tag:
+            raise InvalidTag(raw)
+        if tag not in out:
+            out.append(tag)
+    return out
 
 
 @dataclass
@@ -6,10 +22,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
