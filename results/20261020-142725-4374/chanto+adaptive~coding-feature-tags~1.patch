@@ -41,6 +41,84 @@ class NotesTest(unittest.TestCase):
         data = json.load(open(self.db))
         self.assertEqual(data["notes"][0]["title"], "x")
 
+    def test_file_format_version_2(self):
+        run(self.db, "add", "x")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], [])
+
+    def test_add_tags_normalized(self):
+        code, _, _ = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "Errands",
+            "--tag", "home", "--tag", "ERRANDS",
+        )
+        self.assertEqual(code, 0)
+        data = json.load(open(self.db))
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags_rejected(self):
+        for bad in ["", "   ", "two words", "a,b", "#hash"]:
+            code, _, err = run(self.db, "add", "x", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertIn(repr(bad), err)
+            self.assertFalse(os.path.exists(self.db))
+        self.assertEqual(run(self.db, "list")[1], "")
+
+    def test_list_and_show_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom\n",
+        )
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 Call mom\n")
+
+    def test_list_filter(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "two", "--tag", "home")
+        run(self.db, "add", "three")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  one  #home #errands\n  2  two  #home\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "Errands")[1], "  1  one  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tags_counts(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "work")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\nerrands 1\nwork 1\n")
+        self.assertEqual(run(self.db, "tags")[0], 0)
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "one", "--tag", "home")
+        self.assertEqual(run(self.db, "tag", "1", "Errands", "HOME")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 one\ntags: #home #errands\n")
+        self.assertEqual(run(self.db, "untag", "1", "home", "absent")[0], 0)
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 one\ntags: #errands\n")
+        self.assertEqual(json.load(open(self.db))["notes"][0]["tags"], ["errands"])
+
+    def test_tag_invalid_and_unknown(self):
+        run(self.db, "add", "one", "--tag", "home")
