diff --git a/notes/model.py b/notes/model.py
index 3750b6b..d204269 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,24 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag was empty or contained whitespace, a comma or a '#'."""
+
+
+def normalize_tags(tags):
+    """Trim, lowercase and de-duplicate tags, preserving first-seen order."""
+    out = []
+    for tag in tags:
+        clean = tag.strip().lower()
+        if not clean or any(c.isspace() for c in clean) or "," in clean or "#" in clean:
+            raise InvalidTag(tag)
+        if clean not in out:
+            out.append(clean)
+    return out
+
+
+def format_tags(tags):
+    return " ".join("#" + t for t in tags)
 
 
 @dataclass
@@ -6,10 +26,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
