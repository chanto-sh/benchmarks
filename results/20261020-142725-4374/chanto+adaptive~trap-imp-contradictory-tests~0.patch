 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    ascii_title = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
