@@ -3,4 +3,31 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # E[i] is the expected remaining turns from square i, for 0 <= i < n,
+    # and E[n] = 0.  A roll from i that overshoots n reflects off n:
+    # landing square is 2*n - (i + roll).  Each state satisfies
+    #     k * E[i] - sum_{roll=1..k} E[landing] = k
+    # which we solve exactly by Gauss-Jordan elimination.
+    rows = [[Fraction(0) for _ in range(n + 1)] for _ in range(n)]
+    for i in range(n):
+        rows[i][i] += k
+        for roll in range(1, k + 1):
+            j = i + roll
+            if j > n:
+                j = 2 * n - j
+            if j < n:
+                rows[i][j] -= 1
+        rows[i][n] = k
+
+    for col in range(n):
+        pivot = next(r for r in range(col, n) if rows[r][col] != 0)
+        rows[col], rows[pivot] = rows[pivot], rows[col]
+        scale = rows[col][col]
+        rows[col] = [value / scale for value in rows[col]]
+        for r in range(n):
+            if r != col and rows[r][col] != 0:
+                factor = rows[r][col]
+                rows[r] = [value - factor * base
+                           for value, base in zip(rows[r], rows[col])]
+
+    return rows[0][n]
