@@ -3,4 +3,35 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # E[p] = 1 + (1/k) * sum(E[next(p, r)]) for p in 0..n-1, with E[n] = 0.
+    # Positions only decrease on a bounce and never go below 1, so the chain
+    # stays in 0..n-1 and the system is solvable by exact elimination.
+    size = n
+    matrix = [
+        [Fraction(1) if i == j else Fraction(0) for j in range(size)]
+        + [Fraction(1)]
+        for i in range(size)
+    ]
+
+    step = Fraction(1, k)
+    for p in range(size):
+        for r in range(1, k + 1):
+            nxt = p + r if p + r <= n else 2 * n - p - r
+            if nxt != n:
+                matrix[p][nxt] -= step
+
+    # Gauss-Jordan elimination over the rationals.
+    for col in range(size):
+        pivot = next(row for row in range(col, size) if matrix[row][col] != 0)
+        matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+        inv = 1 / matrix[col][col]
+        matrix[col] = [value * inv for value in matrix[col]]
+        for row in range(size):
+            if row != col and matrix[row][col] != 0:
+                factor = matrix[row][col]
+                matrix[row] = [
+                    value - factor * base
+                    for value, base in zip(matrix[row], matrix[col])
+                ]
+
+    return matrix[0][size]
