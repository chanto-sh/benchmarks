+    def test_figure_eight_long_run(self):
+        # Chenciner-Montgomery figure-eight: a genuinely three-body orbit
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753], [-0.97000436, 0.24308753], [0.0, 0.0]]
+        u = [0.93240737, 0.86473146]
+        vel = [[-u[0] / 2, -u[1] / 2], [-u[0] / 2, -u[1] / 2], u[:]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+        momentum0 = [sum(mi * vi[k] for mi, vi in zip(m, vel)) for k in range(2)]
+        momentum1 = [sum(mi * vi[k] for mi, vi in zip(m, q)) for k in range(2)]
+        for before, after in zip(momentum0, momentum1):
+            self.assertAlmostEqual(before, after, places=9)
+
+    def test_unequal_mass_binary_does_not_modify_inputs(self):
+        m1, m2 = 2.0, 3.0
+        total = m1 + m2
+        separation = 2.0
+        v_rel = math.sqrt(total / separation)
+        m = [m1, m2]
+        pos = [[-m2 / total * separation, 0.0], [m1 / total * separation, 0.0]]
+        vel = [[0.0, -m2 / total * v_rel], [0.0, m1 / total * v_rel]]
+        pos0 = [xy[:] for xy in pos]
+        vel0 = [xy[:] for xy in vel]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
 
