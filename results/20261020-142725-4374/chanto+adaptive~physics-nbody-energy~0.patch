 def simulate(masses, positions, velocities, dt, steps, G=1.0):
     """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    n = len(masses)
+    pos = [[p[0], p[1]] for p in positions]
+    vel = [[v[0], v[1]] for v in velocities]
+
+    # Velocity Verlet (kick-drift-kick).  Being a symplectic method, its energy
+    # error stays bounded instead of growing secularly over long integrations.
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+    return pos, vel
