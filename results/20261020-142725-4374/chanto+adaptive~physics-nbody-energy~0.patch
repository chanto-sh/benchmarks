+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[0.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, 0.0], [0.0, 1.0]]
+        pos0 = [row[:] for row in pos]
+        vel0 = [row[:] for row in vel]
+
+        p, q = simulate(m, pos, vel, 0.001, 100)
+
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertIsNot(p, pos)
+        self.assertIsNot(q, vel)
+
+    def test_eccentric_unequal_mass_orbit(self):
+        # Circular COM motion plus an eccentric relative orbit.
+        m = [2.0, 1.0]
+        separation = 1.5
+        v_rel = 1.1 * math.sqrt(sum(m) / separation)
+        vcm = [0.05, -0.03]
+        pos = [[-0.5, 0.0], [1.0, 0.0]]
+        vel = [
+            [vcm[0], vcm[1] - (1.0 / 3.0) * v_rel],
+            [vcm[0], vcm[1] + (2.0 / 3.0) * v_rel],
+        ]
+        e0 = energy(m, pos, vel)
+        p0 = total_momentum(m, vel)
+        max_energy_error = 0.0
+
+        cur_pos, cur_vel = pos, vel
+        for _ in range(20):
+            cur_pos, cur_vel = simulate(m, cur_pos, cur_vel, 0.001, 1000)
+            max_energy_error = max(
+                max_energy_error,
+                abs(energy(m, cur_pos, cur_vel) - e0) / abs(e0),
+            )
+
+        p1 = total_momentum(m, cur_vel)
+        self.assertLess(max_energy_error, 1e-6)
+        for d in range(2):
+            self.assertLess(abs(p1[d] - p0[d]), 1e-9)
+
