diff --git a/nbody.py b/nbody.py
index 133b00d..365e4a3 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,54 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses the fourth-order symplectic PEFRL scheme (Omelyan, Mryglod and Folk).
+    Being symplectic, its energy error stays bounded over long integrations
+    instead of accumulating, and the pairwise forces conserve total momentum.
+    """
+    pos = [[p[0], p[1]] for p in positions]
+    vel = [[v[0], v[1]] for v in velocities]
+    n = len(masses)
+    if n == 0:
+        return pos, vel
+
+    # PEFRL coefficients.
+    xi = 0.1786178958448091
+    lam = -0.2123418310626054
+    chi = -0.06626458266981849
+    kick_a = 0.5 * (1.0 - 2.0 * lam)
+    drift_mid = 1.0 - 2.0 * (xi + chi)
+
+    def drift(fraction):
+        h = fraction * dt
+        for i in range(n):
+            pos[i][0] += h * vel[i][0]
+            pos[i][1] += h * vel[i][1]
+
+    def kick(fraction, acc):
+        h = fraction * dt
+        for i in range(n):
+            vel[i][0] += h * acc[i][0]
+            vel[i][1] += h * acc[i][1]
+
+    for _ in range(steps):
+        drift(xi)
+        acc = accelerations(masses, pos, G)
+        kick(kick_a, acc)
+
+        drift(chi)
+        acc = accelerations(masses, pos, G)
+        kick(lam, acc)
+
+        drift(drift_mid)
+        acc = accelerations(masses, pos, G)
+        kick(lam, acc)
+
+        drift(chi)
+        acc = accelerations(masses, pos, G)
+        kick(kick_a, acc)
+
+        drift(xi)
+
+    return pos, vel
