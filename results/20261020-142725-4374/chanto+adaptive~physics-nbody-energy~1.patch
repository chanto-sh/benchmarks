@@ -17,6 +17,40 @@ class TestNBody(unittest.TestCase):
         for xy in p:
             self.assertAlmostEqual(math.hypot(*xy), 1.0, places=3)
 
+    def test_momentum_and_inputs_unchanged(self):
+        m = [2.0, 1.0, 0.5]
+        pos = [[-2.0, 0.5], [1.5, -1.0], [3.0, 2.0]]
+        vel = [[0.1, -0.2], [-0.3, 0.15], [0.05, 0.4]]
+        pos0 = [list(xy) for xy in pos]
+        vel0 = [list(xy) for xy in vel]
+
+        p, q = simulate(m, pos, vel, 0.001, 2000)
+
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        for axis in range(2):
+            before = sum(mi * vi[axis] for mi, vi in zip(m, vel))
+            after = sum(mi * vi[axis] for mi, vi in zip(m, q))
+            self.assertAlmostEqual(after, before, places=12)
+
+    def test_eccentric_binary_energy(self):
+        # Unequal masses, eccentric orbit: non-circular and long-running.
+        m1, m2 = 3.0, 1.0
+        total = m1 + m2
+        semi_major, eccentricity = 1.0, 0.7
+        periastron = semi_major * (1.0 - eccentricity)
+        v_rel = math.sqrt(total * (2.0 / periastron - 1.0 / semi_major))
+        r1 = m2 / total * periastron
+        r2 = m1 / total * periastron
+        mu = m1 * m2 / total
+        m = [m1, m2]
+        pos = [[-r1, 0.0], [r2, 0.0]]
+        vel = [[0.0, -mu / m1 * v_rel], [0.0, mu / m2 * v_rel]]
+
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
 
 if __name__ == "__main__":
     unittest.main()
