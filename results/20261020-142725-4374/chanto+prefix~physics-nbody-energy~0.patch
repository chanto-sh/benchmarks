+    def test_figure_eight_energy_and_momentum(self):
+        # Chenciner-Montgomery figure-eight three-body orbit
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        pos = [[x, y], [0.0, 0.0], [-x, -y]]
+        u, w = -0.93240737, -0.86473146
+        vel = [[-u / 2, -w / 2], [u, w], [-u / 2, -w / 2]]
+        pos0, vel0 = copy.deepcopy(pos), copy.deepcopy(vel)
+        e0 = energy(m, pos, vel)
+        p0 = momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+        p1 = momentum(m, q)
+        for k in range(2):
+            self.assertAlmostEqual(p1[k], p0[k], places=10)
+        # inputs must not be modified
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
+    def test_eccentric_binary_long_run(self):
+        # equal masses, semi-major axis 1, eccentricity 0.6, started at periapsis
+        m = [1.0, 1.0]
+        a, e = 1.0, 0.6
+        rp = a * (1.0 - e)
+        mu = m[0] * m[1] / (m[0] + m[1])
+        vrel = math.sqrt(mu * (2.0 / rp - 1.0 / a))
+        pos = [[-rp / 2, 0.0], [rp / 2, 0.0]]
+        vel = [[0.0, -vrel / 2], [0.0, vrel / 2]]
+        e0 = energy(m, pos, vel)
+        p0 = momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+        p1 = momentum(m, q)
+        for k in range(2):
+            self.assertAlmostEqual(p1[k], p0[k], places=10)
+
 
 if __name__ == "__main__":
