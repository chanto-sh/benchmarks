@@ -29,5 +29,25 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick leapfrog), which is symplectic and
+    time-reversible: its energy error is bounded rather than growing secularly,
+    and the pairwise forces conserve total momentum.
+    """
+    n = len(masses)
+    pos = [[p[0], p[1]] for p in positions]
+    vel = [[v[0], v[1]] for v in velocities]
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+    return pos, vel
