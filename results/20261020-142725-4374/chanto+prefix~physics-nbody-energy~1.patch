+    def test_eccentric_two_body_energy(self):
+        # e = 0.6 orbit, mass ratio 2:1, started at periapsis in the COM frame
+        m1, m2 = 2.0, 1.0
+        total = m1 + m2
+        a, e = 1.0, 0.6
+        r = a * (1.0 - e)
+        v = math.sqrt(total / a * (1.0 + e) / (1.0 - e))
+        m = [m1, m2]
+        pos = [[-m2 / total * r, 0.0], [m1 / total * r, 0.0]]
+        vel = [[0.0, -m2 / total * v], [0.0, m1 / total * v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_figure_eight_three_body(self):
+        # Chenciner-Montgomery figure-eight choreography
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        vx, vy = -0.93240737, -0.86473146
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vel = [[vx / 2, vy / 2], [vx / 2, vy / 2], [-vx, -vy]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+        px, py = total_momentum(m, q)
+        self.assertLess(math.hypot(px, py), 1e-12)
+
+    def test_momentum_conserved_unequal_masses(self):
+        m = [2.0, 1.0, 0.5]
+        pos = [[0.0, 0.0], [2.0, 0.0], [0.0, 2.0]]
+        vel = [[0.1, 0.0], [0.0, 0.2], [-0.3, 0.1]]
+        px0, py0 = total_momentum(m, vel)
+        _, q = simulate(m, pos, vel, 0.001, 10000)
+        px1, py1 = total_momentum(m, q)
+        self.assertLess(math.hypot(px1 - px0, py1 - py0), 1e-12)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[0.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, 0.5], [0.0, -0.25]]
+        pos0, vel0 = copy.deepcopy(pos), copy.deepcopy(vel)
+        p, q = simulate(m, pos, vel, 0.01, 100)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertIsNot(p, pos)
+        self.assertIsNot(q, vel)
+
 
