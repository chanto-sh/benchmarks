--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,25 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick), a symplectic, time-reversible
+    integrator, so the energy error stays bounded instead of drifting.
+    """
+    n = len(masses)
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(vx), float(vy)] for vx, vy in velocities]
+    half_dt = 0.5 * dt
+
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+    return pos, vel
