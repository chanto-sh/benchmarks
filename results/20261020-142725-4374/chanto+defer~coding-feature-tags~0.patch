+    def test_add_tags_normalized(self):
+        code, out, _ = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "ERRANDS", "--tag", "home"
+        )
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "added #1\n")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tag_rejected(self):
+        for bad in ["", "  ", "two words", "a,b", "#home"]:
+            code, _, err = run(self.db, "add", "x", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertIn("invalid tag", err)
+            if bad.strip():
+                self.assertIn(bad, err)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_invalid_tag_on_existing_note_saves_nothing(self):
+        run(self.db, "add", "x")
+        before = open(self.db).read()
+        code, _, err = run(self.db, "tag", "1", "ok", "bad tag")
+        self.assertEqual(code, 2)
+        self.assertIn("bad tag", err)
+        self.assertEqual(open(self.db).read(), before)
+
+    def test_list_tag_filter(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "Errands")
