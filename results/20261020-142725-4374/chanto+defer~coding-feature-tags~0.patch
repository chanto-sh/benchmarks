diff --git a/notes/model.py b/notes/model.py
index 3750b6b..ba01179 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that cannot be stored."""
+
+
+def normalize_tag(tag):
+    """Return the canonical form of one tag, or raise InvalidTag."""
+    name = tag.strip().lower()
+    if not name or any(c.isspace() for c in name) or "," in name or "#" in name:
+        raise InvalidTag(tag)
+    return name
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        name = normalize_tag(tag)
+        if name not in out:
+            out.append(name)
+    return out
 
 
 @dataclass
@@ -6,10 +28,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=normalize_tags(d.get("tags", [])),
+        )
