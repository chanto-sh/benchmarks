 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents to their ASCII base letters (e.g. "Crème" -> "Creme").
+    ascii_title = (
+        unicodedata.normalize("NFKD", title)
+        .encode("ascii", "ignore")
+        .decode("ascii")
+    )
+    # Underscores separate words; punctuation is dropped, not replaced.
+    ascii_title = ascii_title.replace("_", "-").lower()
+    ascii_title = re.sub(r"[^a-z0-9\s-]", "", ascii_title)
+    return re.sub(r"[\s-]+", "-", ascii_title).strip("-")
