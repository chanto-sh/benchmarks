 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents onto their ASCII base letters (Crème -> Creme).
+    ascii_text = (
+        unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode("ascii")
+    )
+    text = ascii_text.lower()
+    # Whitespace and hyphens are separators; collapse runs of them.
+    text = re.sub(r"[\s-]+", "-", text)
+    # Punctuation is deleted rather than turned into separators
+    # ("What's" -> "whats", "2.0" -> "20").
+    text = re.sub(r"[^a-z0-9_-]", "", text)
+    return text.strip("-")
