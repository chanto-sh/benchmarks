+    def test_add_normalizes_tags(self):
+        code, out, _ = run(
+            self.db, "add", "Buy milk",
+            "--tag", " Home ", "--tag", "errands", "--tag", "HOME",
+        )
+        self.assertEqual((code, out), (0, "added #1\n"))
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(
+            run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n"
+        )
+
+    def test_invalid_tags_save_nothing(self):
+        run(self.db, "add", "keep", "--tag", "home")
+        for bad in ("", "  ", "two words", "a,b", "#nope"):
+            code, out, err = run(self.db, "add", "x", "--tag", "ok", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertEqual(out, "")
+            self.assertIn("invalid tag", err)
+            self.assertIn(bad, err)
+        self.assertEqual(
+            run(self.db, "list")[1], "  1  keep  #home\n"
+        )
+
+    def test_list_filters_by_tags(self):
+        run(self.db, "add", "a", "--tag", "home")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "c", "--tag", "work")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "HOME")[1],
+            "  1  a  #home\n  2  b  #home #errands\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "Errands")[1],
+            "  2  b  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tags_summary(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "zeta")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "alpha")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\nalpha 1\nzeta 1\n")
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "a", "--tag", "home")
+        code, out, _ = run(self.db, "tag", "1", " Errands ", "HOME", "work")
+        self.assertEqual((code, out), (0, ""))
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
