diff --git a/notes/model.py b/notes/model.py
index 3750b6b..306db97 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Lowercase and trim one tag, rejecting the invalid forms."""
+    clean = tag.strip().lower()
+    if not clean or any(c.isspace() for c in clean) or "," in clean or "#" in clean:
+        raise InvalidTag(tag)
+    return clean
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        clean = normalize_tag(tag)
+        if clean not in out:
+            out.append(clean)
+    return out
 
 
 @dataclass
@@ -6,10 +28,16 @@ class Note:
