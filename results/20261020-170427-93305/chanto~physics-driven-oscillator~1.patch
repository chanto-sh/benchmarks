 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+try:
+    _fma = math.fma
+except AttributeError:  # pragma: no cover - for Python < 3.13
+    def _fma(x, y, z):
+        return x * y + z
+
+
+def _sinc(x):
+    """sin(x) / x, evaluated without cancellation near zero."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        return 1.0 + x2 * (-1.0 / 6.0 + x2 * (1.0 / 120.0 - x2 / 5040.0))
+    return math.sin(x) / x
+
+
+def _detuning(m, k, omega):
+    """k - m*omega**2, retaining accuracy when the two terms nearly cancel."""
+    w2 = omega * omega
+    p = m * w2
+    if not (math.isfinite(w2) and math.isfinite(p)):
+        return k - p
+    w2_err = _fma(omega, omega, -w2)
+    p_err = _fma(m, w2, -p)
+    return math.fsum((k, -p, -p_err, -m * w2_err))
+
+
+def _response(m, k, c, F0, omega):
+    """Return the forcing coefficients C, S with x_p = C cos(wt) + S sin(wt)."""
+    detuning = _detuning(m, k, omega)
+    damping = c * omega
+    den = math.hypot(detuning, damping)
+
+    if F0 == 0.0:
+        return detuning, damping, den, 0.0, 0.0
+    if den == 0.0:
+        return detuning, damping, den, None, None
+
+    scale = F0 / den
+    return detuning, damping, den, scale * (detuning / den), scale * (damping / den)
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    detuning = _detuning(m, k, omega)
+    den = math.hypot(detuning, c * omega)
+    if F0 == 0.0:
+        return 0.0
+    if den == 0.0:
+        return math.inf
+    return abs(F0) / den
 
 
 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    if t == 0.0:
+        return x0
+
+    detuning, damping, den, C, S = _response(m, k, c, F0, omega)
+
+    if den == 0.0 and F0 != 0.0:
+        # Forcing exactly at an undamped resonance, or a pure drift case.
+        if c == 0.0 and omega != 0.0:
+            w = omega
+            return (
+                x0 * math.cos(w * t)
+                + (v0 / w) * math.sin(w * t)
+                + (F0 / (2.0 * m * w)) * t * math.sin(w * t)
+            )
+        if k == 0.0 and omega == 0.0:
+            if c == 0.0:
+                return x0 + v0 * t + (F0 / (2.0 * m)) * t * t
+            v_inf = F0 / c
+            return x0 + v_inf * t + (v0 - v_inf) * (m / c) * (1.0 - math.exp(-c * t / m))
+
+    y0 = x0 - C
+    vy0 = v0 - S * omega
+
+    a = c / (2.0 * m)
+    b2 = k / m
+    u0 = vy0 + a * y0
+
+    disc = a * a - b2
+    if disc < 0.0:
+        w = math.sqrt(-disc)
+        x = w * t
+        y = math.exp(-a * t) * (y0 * math.cos(x) + u0 * t * _sinc(x))
+    elif disc > 0.0:
+        q = math.sqrt(disc)
+        r1 = -b2 / (a + q)
+        r2 = -a - q
+        e1 = math.exp(r1 * t)
+        e2 = math.exp(r2 * t)
+        x = q * t
+        f1 = 0.5 * (e1 + e2)
+        if abs(x) < 1e-8:
+            f2 = e1 * t * (1.0 - x + (2.0 / 3.0) * x * x - (1.0 / 3.0) * x * x * x)
+        else:
+            f2 = -e1 * math.expm1(-2.0 * x) / (2.0 * q)
+        y = y0 * f1 + u0 * f2
+    else:
