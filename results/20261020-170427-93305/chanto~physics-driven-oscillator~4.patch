+    if scale == 0.0:
+        if F0 == 0.0:
+            return 0.0
+        raise ValueError("steady state is undefined at undamped resonance")
+    return F0 / scale
 
 
 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    p, q = _steady_state_parts(m, k, c, F0, omega)
+
+    # Initial displacement and velocity of the homogeneous part.
+    xh0 = x0 - p
+    vh0 = v0 - q * omega
+    alpha = -c / (2.0 * m)
+    disc = c * c - 4.0 * m * k
+
+    if disc < 0.0:
+        # Underdamped: u = e^(alpha t) cos(beta t),
+        #              v = e^(alpha t) sin(beta t) / beta.
+        beta = math.sqrt(-disc) / (2.0 * m)
+        decay = math.exp(alpha * t)
+        phase = beta * t
+        ratio = 1.0 if phase == 0.0 else math.sin(phase) / phase
+        u = decay * math.cos(phase)
+        v = decay * t * ratio
+    elif disc > 0.0:
+        # Overdamped, written with the larger root r1 and gap = r1 - r2.
+        # Factoring out exp(r1 t) avoids cancellation and overflow.
+        root = math.sqrt(disc)
+        r1 = -2.0 * k / (c + root)
+        gap = root / m
+        decay = math.exp(r1 * t)
+        u = 0.5 * decay * (1.0 + math.exp(-gap * t))
+        v = -decay * math.expm1(-gap * t) / gap
+    else:
+        # Critically damped: u = e^(alpha t), v = t e^(alpha t).
+        decay = math.exp(alpha * t)
+        u = decay
+        v = t * decay
+
+    homogeneous = xh0 * u + (vh0 - alpha * xh0) * v
+    return p * math.cos(omega * t) + q * math.sin(omega * t) + homogeneous
