 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state_parts(m, k, c, F0, omega):
+    """Return P, Q such that the particular solution is P cos(wt) + Q sin(wt)."""
+    elastic = k - m * omega * omega
+    damping = c * omega
+    denom = math.hypot(elastic, damping)
+    if denom == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0
+        raise ValueError("steady state is undefined at undamped resonance")
+    scale = F0 / denom
+    return scale * (elastic / denom), scale * (damping / denom)
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
