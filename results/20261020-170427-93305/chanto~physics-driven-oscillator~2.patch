 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(z):
+    """sin(z) / z, with the continuous value at z = 0."""
+    return 1.0 if z == 0.0 else math.sin(z) / z
+
+
+def _sinhc(z):
+    """sinh(z) / z, with the continuous value at z = 0."""
+    return 1.0 if z == 0.0 else math.sinh(z) / z
+
+
+def _steady_terms(m, k, c, F0, omega):
+    """Return (A, B, amplitude) for the particular solution A cos + B sin."""
+    a = k - m * omega * omega
+    b = c * omega
+    scale = math.hypot(a, b)
+    if scale == 0.0:
+        raise ValueError(
+            "an undamped system driven exactly at its natural frequency "
+            "has no finite steady-state solution"
+        )
+    amp = F0 / scale
+    return amp * (a / scale), amp * (b / scale), amp
+
 
