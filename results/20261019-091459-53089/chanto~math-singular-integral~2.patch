 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of the n-point Gauss-Legendre rule."""
+    nodes = []
+    weights = []
+    for i in range(1, n + 1):
+        x = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p0, p1 = 1.0, x
+            for k in range(2, n + 1):
+                p0, p1 = p1, ((2 * k - 1) * x * p1 - (k - 1) * p0) / k
+            dp = n * (x * p1 - p0) / (x * x - 1.0)
+            dx = p1 / dp
+            x -= dx
+            if abs(dx) < 1e-15:
+                break
+        nodes.append(x)
+        weights.append(2.0 / ((1.0 - x * x) * dp * dp))
+    return tuple(nodes), tuple(weights)
+
+
+_GAUSS_NODES, _GAUSS_WEIGHTS = _gauss_legendre(16)
+
+
+def _integrate(func, a, b):
+    """Integrate func over [a, b] with a 16-point Gauss-Legendre rule."""
+    mid = 0.5 * (a + b)
+    half = 0.5 * (b - a)
+    return half * math.fsum(
+        w * func(mid + half * x)
+        for x, w in zip(_GAUSS_NODES, _GAUSS_WEIGHTS)
+    )
+
