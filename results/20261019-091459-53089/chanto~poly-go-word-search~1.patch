 package wordsearch
 
+import "fmt"
+
+type point struct{ x, y int }
+
+var directions = []point{
+	{1, 0},  // left to right
+	{-1, 0}, // right to left
+	{0, 1},  // top to bottom
+	{0, -1}, // bottom to top
+	{1, 1},  // top left to bottom right
+	{-1, -1},
+	{1, -1}, // bottom left to top right
+	{-1, 1},
+}
+
+// Solve locates every word in the puzzle and returns the coordinates of its
+// first and last letter. Coordinates are given as {x, y}, where x is the
+// column and y is the row. It returns an error if any word cannot be found.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	result := make(map[string][2][2]int, len(words))
+
+	var missing []string
+	for _, word := range words {
+		if start, end, ok := find(word, puzzle); ok {
+			result[word] = [2][2]int{{start.x, start.y}, {end.x, end.y}}
+		} else {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+		}
+	}
+
+	if len(missing) > 0 {
+		return result, fmt.Errorf("words not found in puzzle: %v", missing)
+	}
+	return result, nil
+}
+
+func find(word string, puzzle []string) (point, point, bool) {
+	if word == "" || len(puzzle) == 0 {
+		return point{}, point{}, false
+	}
+
+	for y, row := range puzzle {
+		for x := range row {
+			for _, d := range directions {
+				if matches(word, puzzle, x, y, d) {
+					start := point{x, y}
+					end := point{x + d.x*(len(word)-1), y + d.y*(len(word)-1)}
+					return start, end, true
+				}
+			}
+		}
+	}
+	return point{}, point{}, false
+}
+
+func matches(word string, puzzle []string, x, y int, d point) bool {
+	height := len(puzzle)
+	for i := 0; i < len(word); i++ {
+		cx := x + d.x*i
+		cy := y + d.y*i
+		if cx < 0 || cy < 0 || cy >= height || cx >= len(puzzle[cy]) {
+			return false
+		}
+		if puzzle[cy][cx] != word[i] {
+			return false
+		}
+	}
+	return true
 }
