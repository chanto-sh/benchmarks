 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of the n-point Gauss-Legendre rule."""
+    nodes = []
+    weights = []
+    for i in range(1, n + 1):
+        x = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p1, p2 = 1.0, 0.0
+            for j in range(1, n + 1):
+                p1, p2 = ((2 * j - 1) * x * p1 - (j - 1) * p2) / j, p1
+            pp = n * (x * p1 - p2) / (x * x - 1.0)
+            dx = p1 / pp
+            x -= dx
+            if abs(dx) <= 1e-16:
+                break
+        p1, p2 = 1.0, 0.0
+        for j in range(1, n + 1):
+            p1, p2 = ((2 * j - 1) * x * p1 - (j - 1) * p2) / j, p1
+        pp = n * (x * p1 - p2) / (x * x - 1.0)
+        nodes.append(x)
+        weights.append(2.0 / ((1.0 - x * x) * pp * pp))
+    return tuple(nodes), tuple(weights)
+
+
+_NODES, _WEIGHTS = _gauss_legendre(16)
+_PHASE_STEP = math.pi / 4.0
+
+
