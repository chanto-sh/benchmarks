 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of an n-point Gauss-Legendre rule."""
+    nodes = []
+    weights = []
+    for i in range(1, n + 1):
+        # Chebyshev approximation for the i-th root, refined by Newton's method.
+        x = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p_prev, p = 1.0, x
+            for k in range(2, n + 1):
+                p_prev, p = p, ((2 * k - 1) * x * p - (k - 1) * p_prev) / k
+            derivative = n * (x * p - p_prev) / (x * x - 1.0)
+            dx = p / derivative
+            x -= dx
+            if abs(dx) < 1e-15:
+                break
+
+        p_prev, p = 1.0, x
+        for k in range(2, n + 1):
+            p_prev, p = p, ((2 * k - 1) * x * p - (k - 1) * p_prev) / k
+        derivative = n * (x * p - p_prev) / (x * x - 1.0)
+
+        nodes.append(x)
+        weights.append(2.0 / ((1.0 - x * x) * derivative * derivative))
+    return tuple(nodes), tuple(weights)
+
+
+_NODES, _WEIGHTS = _gauss_legendre(24)
+
