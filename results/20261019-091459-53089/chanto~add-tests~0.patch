+import unittest
+
+from roman import to_roman
+
+
+class TestToRomanNormalValues(unittest.TestCase):
+    """Conversions for ordinary values, including multi-symbol combinations."""
+
+    def test_single_symbols(self):
+        cases = {
+            1: "I",
+            5: "V",
+            10: "X",
+            50: "L",
+            100: "C",
+            500: "D",
+            1000: "M",
+        }
+        for value, expected in cases.items():
+            with self.subTest(value=value):
+                self.assertEqual(to_roman(value), expected)
+
+    def test_repeated_symbols(self):
+        cases = {
+            2: "II",
+            3: "III",
+            6: "VI",
+            7: "VII",
+            8: "VIII",
+            20: "XX",
+            30: "XXX",
+            200: "CC",
+            300: "CCC",
+            2000: "MM",
+            3000: "MMM",
+        }
+        for value, expected in cases.items():
+            with self.subTest(value=value):
+                self.assertEqual(to_roman(value), expected)
+
+    def test_additive_combinations(self):
+        cases = {
+            11: "XI",
+            13: "XIII",
+            15: "XV",
+            18: "XVIII",
+            21: "XXI",
+            25: "XXV",
+            37: "XXXVII",
+            60: "LX",
+            75: "LXXV",
+            110: "CX",
+            123: "CXXIII",
+            250: "CCL",
+            600: "DC",
+            666: "DCLXVI",
+            1100: "MC",
+            1500: "MD",
+            2018: "MMXVIII",
+        }
+        for value, expected in cases.items():
+            with self.subTest(value=value):
+                self.assertEqual(to_roman(value), expected)
+
+    def test_complex_values(self):
+        cases = {
+            1666: "MDCLXVI",
+            1888: "MDCCCLXXXVIII",
+            2024: "MMXXIV",
+            2468: "MMCDLXVIII",
+            3888: "MMMDCCCLXXXVIII",
+        }
+        for value, expected in cases.items():
+            with self.subTest(value=value):
+                self.assertEqual(to_roman(value), expected)
+
+
