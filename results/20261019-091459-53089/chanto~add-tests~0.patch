+
+class TestToRomanBoundaries(unittest.TestCase):
+    """Smallest and largest legal inputs, and values adjacent to them."""
+
+    def test_lower_boundary(self):
+        self.assertEqual(to_roman(1), "I")
+
+    def test_lower_boundary_adjacent(self):
+        self.assertEqual(to_roman(2), "II")
+        self.assertEqual(to_roman(3), "III")
+
+    def test_upper_boundary(self):
+        self.assertEqual(to_roman(3999), "MMMCMXCIX")
+
+    def test_upper_boundary_adjacent(self):
+        self.assertEqual(to_roman(3998), "MMMCMXCVIII")
+        self.assertEqual(to_roman(3997), "MMMCMXCVII")
+
+    def test_every_value_in_range_produces_valid_numeral(self):
+        allowed = set("IVXLCDM")
+        for value in range(1, 4000):
+            with self.subTest(value=value):
+                numeral = to_roman(value)
+                self.assertTrue(numeral)
+                self.assertTrue(set(numeral) <= allowed)
+
+
+class TestToRomanInvalidInputs(unittest.TestCase):
+    """Inputs outside [1, 3999] or of the wrong type raise ValueError."""
+
+    def test_zero(self):
+        with self.assertRaises(ValueError):
+            to_roman(0)
+
+    def test_negative_values(self):
+        for value in (-1, -2, -3999, -4000, -100):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_above_upper_boundary(self):
+        for value in (4000, 4001, 10000, 10**9):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_floats(self):
+        for value in (0.0, 1.0, 1.5, 3999.0, 4000.5, -1.5):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_strings(self):
+        for value in ("", "1", "3999", "IV", "abc"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_none(self):
+        with self.assertRaises(ValueError):
+            to_roman(None)
+
+    def test_booleans(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_other_types(self):
+        for value in ([], [1], (1,), {1}, {"n": 1}, 1 + 2j, object()):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+
+if __name__ == "__main__":
+    unittest.main()
