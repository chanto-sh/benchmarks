+        # Check to see if all parameters in the template are attributes of the Message.
+        # Use string.Formatter so escaped braces (e.g. '{{' and '}}') are handled.
+        arguments = [
+            field_name
+            for _, field_name, _, _ in string.Formatter().parse(template)
+            if field_name is not None
+        ]
+        unrecognized_arguments = [
+            argument for argument in arguments if argument not in MESSAGE_FIELDS
+        ]
+        for argument in unrecognized_arguments:
+            warnings.warn(
+                f"Don't recognize the argument '{argument}' in the --msg-template. "
+                "Are you sure it is supported on the current version of pylint?"
+            )
+
+        if unrecognized_arguments:
+            # Rebuild the template without the unrecognized arguments, keeping
+            # escaped braces (and therefore the rest of the template) intact.
+            fixed_template = []
+            for (
+                literal,
+                field_name,
+                format_spec,
+                conversion,
+            ) in string.Formatter().parse(template):
+                fixed_template.append(literal.replace("{", "{{").replace("}", "}}"))
+                if field_name is None or field_name not in MESSAGE_FIELDS:
+                    continue
+                field = f"{{{field_name}"
+                if conversion:
+                    field += f"!{conversion}"
+                if format_spec:
+                    field += f":{format_spec}"
+                fixed_template.append(f"{field}}}")
+            template = "".join(fixed_template)
         self._fixed_template = template
 
     def write_message(self, msg: Message) -> None:
