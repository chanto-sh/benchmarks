+import re
+import unittest
+
+from roman import to_roman
+
+
+class TestNormalValues(unittest.TestCase):
+    def test_basic_symbols(self):
+        cases = {
+            1: "I",
+            5: "V",
+            10: "X",
+            50: "L",
+            100: "C",
+            500: "D",
+            1000: "M",
+        }
+        for n, expected in cases.items():
+            with self.subTest(n=n):
+                self.assertEqual(to_roman(n), expected)
+
+    def test_repeated_symbols(self):
+        cases = {
+            2: "II",
+            3: "III",
+            6: "VI",
+            7: "VII",
+            8: "VIII",
+            11: "XI",
+            20: "XX",
+            30: "XXX",
+            200: "CC",
+            300: "CCC",
+            2000: "MM",
+            3000: "MMM",
+        }
+        for n, expected in cases.items():
+            with self.subTest(n=n):
+                self.assertEqual(to_roman(n), expected)
+
+    def test_compound_values(self):
+        cases = {
+            13: "XIII",
+            18: "XVIII",
+            27: "XXVII",
+            42: "XLII",
+            58: "LVIII",
+            88: "LXXXVIII",
+            123: "CXXIII",
+            256: "CCLVI",
+            888: "DCCCLXXXVIII",
+            1666: "MDCLXVI",
+            2024: "MMXXIV",
+            2525: "MMDXXV",
+            3888: "MMMDCCCLXXXVIII",
+        }
+        for n, expected in cases.items():
+            with self.subTest(n=n):
+                self.assertEqual(to_roman(n), expected)
+
+    def test_known_examples(self):
+        self.assertEqual(to_roman(1977), "MCMLXXVII")
+        self.assertEqual(to_roman(1990), "MCMXC")
+        self.assertEqual(to_roman(2008), "MMVIII")
+        self.assertEqual(to_roman(2014), "MMXIV")
+        self.assertEqual(to_roman(2022), "MMXXII")
+
+    def test_result_is_str(self):
+        self.assertIsInstance(to_roman(42), str)
+
+    def test_calls_are_pure(self):
+        first = to_roman(1987)
+        second = to_roman(1987)
+        self.assertEqual(first, "MCMLXXXVII")
+        self.assertEqual(first, second)
+
+
+class TestBoundaries(unittest.TestCase):
+    def test_lower_bound(self):
+        self.assertEqual(to_roman(1), "I")
+
+    def test_upper_bound(self):
+        self.assertEqual(to_roman(3999), "MMMCMXCIX")
+
+    def test_near_lower_bound(self):
+        self.assertEqual(to_roman(2), "II")
+        self.assertEqual(to_roman(3), "III")
+        self.assertEqual(to_roman(4), "IV")
+
+    def test_near_upper_bound(self):
+        self.assertEqual(to_roman(3998), "MMMCMXCVIII")
+        self.assertEqual(to_roman(3997), "MMMCMXCVII")
+        self.assertEqual(to_roman(3990), "MMMCMXC")
+
+    def test_largest_single_symbol_values(self):
+        self.assertEqual(to_roman(1000), "M")
+        self.assertEqual(to_roman(2000), "MM")
+        self.assertEqual(to_roman(3000), "MMM")
+
+
