+class TestInvalidInputs(unittest.TestCase):
+    def test_below_range(self):
+        for n in (0, -1, -2, -100, -3999, -4000):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_above_range(self):
+        for n in (4000, 4001, 5000, 10000, 10**9):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_bool_is_rejected(self):
+        for n in (True, False):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_non_integer_numbers_are_rejected(self):
+        for n in (1.0, 4.0, 3999.0, 0.5, float("nan"), float("inf"), 2 + 0j):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_strings_and_bytes_are_rejected(self):
+        for n in ("1", "IV", "", b"1", b""):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_none_is_rejected(self):
+        with self.assertRaises(ValueError):
+            to_roman(None)
+
+    def test_other_types_are_rejected(self):
+        for n in ([], [1], (1,), {1}, {"n": 1}, object()):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    to_roman(n)
+
+    def test_error_message_mentions_out_of_range(self):
+        with self.assertRaisesRegex(ValueError, "out of range"):
+            to_roman(0)
+        with self.assertRaisesRegex(ValueError, "out of range"):
+            to_roman(4000)
+
+
+class TestAllValuesInvariants(unittest.TestCase):
+    CANONICAL = re.compile(
+        r"^M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$"
+    )
+
+    def test_every_value_produces_canonical_roman_numeral(self):
+        for n in range(1, 4000):
+            with self.subTest(n=n):
+                result = to_roman(n)
+                self.assertRegex(result, self.CANONICAL)
+                self.assertTrue(result)
+                self.assertTrue(set(result) <= set("IVXLCDM"))
+
+    def test_outputs_are_unique(self):
+        seen = {}
+        for n in range(1, 4000):
+            result = to_roman(n)
+            self.assertNotIn(result, seen, f"{n} and {seen.get(result)} collide")
+            seen[result] = n
+        self.assertEqual(len(seen), 3999)
+
+
+if __name__ == "__main__":
+    unittest.main()
