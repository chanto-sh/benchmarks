 package wordsearch
 
+import (
+	"fmt"
+	"strings"
+)
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	locations := make(map[string][2][2]int, len(words))
+	var missing []string
+
+	for _, word := range words {
+		start, end, found := find(word, puzzle)
+		if !found {
+			locations[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+			continue
+		}
+		locations[word] = [2][2]int{start, end}
+	}
+
+	if len(missing) > 0 {
+		return locations, fmt.Errorf("words not found: %s", strings.Join(missing, ", "))
+	}
+	return locations, nil
+}
+
+func find(word string, puzzle []string) ([2]int, [2]int, bool) {
+	if word == "" {
+		return [2]int{}, [2]int{}, false
+	}
+	for y := 0; y < len(puzzle); y++ {
+		for x := 0; x < len(puzzle[y]); x++ {
+			if puzzle[y][x] != word[0] {
+				continue
+			}
+			for _, d := range directions {
+				if matches(word, puzzle, x, y, d) {
+					end := [2]int{x + d[0]*(len(word)-1), y + d[1]*(len(word)-1)}
+					return [2]int{x, y}, end, true
+				}
+			}
+		}
+	}
+	return [2]int{}, [2]int{}, false
+}
+
+func matches(word string, puzzle []string, x, y int, d [2]int) bool {
+	for i := 0; i < len(word); i++ {
+		cx, cy := x+d[0]*i, y+d[1]*i
+		if cy < 0 || cy >= len(puzzle) || cx < 0 || cx >= len(puzzle[cy]) {
+			return false
+		}
+		if puzzle[cy][cx] != word[i] {
+			return false
+		}
+	}
+	return true
 }
