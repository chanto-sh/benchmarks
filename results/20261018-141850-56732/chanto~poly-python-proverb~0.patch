@@ -1,2 +1,13 @@
-def proverb():
-    pass
+def proverb(*pieces, qualifier=None):
+    if not pieces:
+        return []
+
+    verses = [
+        f"For want of a {first} the {second} was lost."
+        for first, second in zip(pieces, pieces[1:])
+    ]
+
+    final = (" ".join(filter(None, (qualifier, pieces[0]))))
+    verses.append(f"And all for the want of a {final}.")
+
+    return verses
