+ANIMALS = [
+    ("fly", None),
+    ("spider", "It wriggled and jiggled and tickled inside her."),
+    ("bird", "How absurd to swallow a bird!"),
+    ("cat", "Imagine that, to swallow a cat!"),
+    ("dog", "What a hog, to swallow a dog!"),
+    ("goat", "Just opened her throat and swallowed a goat!"),
+    ("cow", "I don't know how she swallowed a cow!"),
+    ("horse", None),
+]
+
+FLY_LINE = "I don't know why she swallowed the fly. Perhaps she'll die."
+
+
+def _verse(index):
+    animal, remark = ANIMALS[index]
+    lines = [f"I know an old lady who swallowed a {animal}."]
+    if animal == "horse":
+        lines.append("She's dead, of course!")
+        return lines
+    if remark:
+        lines.append(remark)
+    for i in range(index, 0, -1):
+        prey = ANIMALS[i - 1][0]
+        if prey == "spider":
+            lines.append(
+                f"She swallowed the {ANIMALS[i][0]} to catch the spider "
+                "that wriggled and jiggled and tickled inside her."
+            )
+        else:
+            lines.append(f"She swallowed the {ANIMALS[i][0]} to catch the {prey}.")
+    lines.append(FLY_LINE)
+    return lines
+
