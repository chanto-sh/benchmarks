 MOD = 1_000_000_007
 
+# States: (previous letter is A?, number of C's mod 3).
+# 0..2: previous letter is not A; 3..5: previous letter is A.
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        for k in range(_SIZE):
+            if a[i][k]:
+                aik = a[i][k]
+                for j in range(_SIZE):
+                    result[i][j] = (result[i][j] + aik * b[k][j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    result = [[int(i == j) for j in range(_SIZE)] for i in range(_SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n == 0:
+        return 1
+
+    # transition[to][from] = number of ways to extend a code.
+    transition = [[0] * _SIZE for _ in range(_SIZE)]
+    for c in range(3):
+        not_a = c
+        is_a = 3 + c
+        # Append B: previous letter is no longer A, C count unchanged.
+        transition[not_a][not_a] += 1
+        transition[not_a][is_a] += 1
+        # Append C: previous letter is no longer A, C count advances.
+        transition[(c + 1) % 3][not_a] += 1
+        transition[(c + 1) % 3][is_a] += 1
+        # Append A: only allowed when the previous letter is not A.
+        transition[is_a][not_a] += 1
+
+    # Codes of length 1: "A", "B", "C".
+    initial = [0] * _SIZE
+    initial[3] = 1  # A, zero C's
+    initial[0] = 1  # B, zero C's
+    initial[1] = 1  # C, one C
+
+    powered = _mat_pow(transition, n - 1)
+    final = [0] * _SIZE
+    for i in range(_SIZE):
+        for j in range(_SIZE):
+            final[i] = (final[i] + powered[i][j] * initial[j]) % MOD
+
+    # Counts with a multiple of 3 C's.
+    return (final[0] + final[3]) % MOD
