 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let mut words = command.split_whitespace();
+    if words.next()? != "What" || words.next()? != "is" {
+        return None;
+    }
+
+    let mut tokens: Vec<&str> = words.collect();
+    let last_index = tokens.len().checked_sub(1)?;
+    let without_question = tokens[last_index].strip_suffix('?')?;
+    if without_question.is_empty() {
+        tokens.pop();
+    } else {
+        tokens[last_index] = without_question;
+    }
+
+    evaluate(&tokens)
+}
+
+fn evaluate(tokens: &[&str]) -> Option<i32> {
+    let mut result = parse_number(tokens.first()?)?;
+    let mut index = 1;
+
+    while index < tokens.len() {
+        match tokens[index] {
+            "plus" => {
+                let operand = parse_number(tokens.get(index + 1)?)?;
+                result = result.checked_add(operand)?;
+                index += 2;
+            }
+            "minus" => {
+                let operand = parse_number(tokens.get(index + 1)?)?;
+                result = result.checked_sub(operand)?;
+                index += 2;
+            }
+            "multiplied" => {
+                if tokens.get(index + 1).copied() != Some("by") {
+                    return None;
+                }
+                let operand = parse_number(tokens.get(index + 2)?)?;
+                result = result.checked_mul(operand)?;
+                index += 3;
+            }
+            "divided" => {
+                if tokens.get(index + 1).copied() != Some("by") {
+                    return None;
+                }
+                let operand = parse_number(tokens.get(index + 2)?)?;
+                result = result.checked_div(operand)?;
+                index += 3;
+            }
+            #[cfg(feature = "exponentials")]
+            "raised" => {
+                if tokens.get(index + 1).copied() != Some("to")
+                    || tokens.get(index + 2).copied() != Some("the")
+                {
+                    return None;
+                }
+                let exponent = parse_ordinal(tokens.get(index + 3)?)?;
+                if tokens.get(index + 4).copied() != Some("power") {
+                    return None;
+                }
+                result = result.checked_pow(exponent)?;
+                index += 5;
+            }
+            _ => return None,
+        }
+    }
+
+    Some(result)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse().ok()
+}
+
+#[cfg(feature = "exponentials")]
+fn parse_ordinal(token: &str) -> Option<u32> {
+    let (digits, suffix) = ["st", "nd", "rd", "th"]
+        .into_iter()
+        .find_map(|suffix| token.strip_suffix(suffix).map(|digits| (digits, suffix)))?;
+
+    let number: u32 = digits.parse().ok()?;
+    let last_two = number % 100;
+    let expected_suffix = if (11..=13).contains(&last_two) {
+        "th"
+    } else {
+        match number % 10 {
+            1 => "st",
+            2 => "nd",
+            3 => "rd",
+            _ => "th",
+        }
+    };
+
+    (suffix == expected_suffix).then_some(number)
 }
