+func findPath(tr *Tree, value string) []*Tree {
+	if tr == nil {
+		return nil
+	}
+	if tr.value == value {
+		return []*Tree{tr}
+	}
+	for _, ch := range tr.children {
+		if path := findPath(ch, value); path != nil {
+			return append([]*Tree{tr}, path...)
+		}
+	}
