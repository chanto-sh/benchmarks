@@ -3,4 +3,45 @@ function fmt(amount) {
   return amount.toFixed(2);
 }
 
-module.exports = { fmt };
+// Parse a decimal number (number or string, e.g. "19.99", 7.375) exactly.
+// Returns the fraction { num, den }.
+function decimal(value) {
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(String(value).trim());
+  if (!m || (m[2] === "" && !m[3])) throw new TypeError(`not a decimal: ${value}`);
+  const sign = m[1] === "-" ? -1n : 1n;
+  const digits = (m[2] || "") + (m[3] || "");
+  const exp = (m[4] ? Number(m[4]) : 0) - (m[3] ? m[3].length : 0);
+  const num = sign * BigInt(digits || "0");
+  return exp >= 0
+    ? { num: num * 10n ** BigInt(exp), den: 1n }
+    : { num, den: 10n ** BigInt(-exp) };
+}
+
+// Round num/den to the nearest integer, halves away from zero.
+function roundHalfUp(num, den) {
+  if (den <= 0n) throw new RangeError("denominator must be positive");
+  const sign = num < 0n ? -1n : 1n;
+  const abs = num < 0n ? -num : num;
+  return sign * ((2n * abs + den) / (2n * den));
+}
+
+// Money as an integer number of cents.
+function parseCents(value) {
+  const { num, den } = decimal(value);
+  return roundHalfUp(num * 100n, den);
+}
+
+// `pct` percent of an amount in cents, rounded half up to the cent.
+function pctCents(amountCents, pct) {
+  const { num, den } = decimal(pct);
+  return roundHalfUp(amountCents * num, den * 100n);
+}
+
+// Format integer cents as a plain "1234.50" string.
+function fmtCents(cents) {
+  const sign = cents < 0n ? "-" : "";
+  const abs = cents < 0n ? -cents : cents;
+  return `${sign}${abs / 100n}.${String(abs % 100n).padStart(2, "0")}`;
+}
+
+module.exports = { fmt, parseCents, pctCents, roundHalfUp, fmtCents };
