--- a/retry.go
+++ b/retry.go
@@ -3,6 +3,7 @@ package retry
 
 import (
 	"context"
+	"errors"
 	"time"
 )
 
@@ -26,8 +27,17 @@ func (p *permanent) Unwrap() error { return p.err }
 func Permanent(err error) error { return &permanent{err} }
 
 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
 }
 
 // Do calls fn until it returns nil, returns a permanent error, the attempts
@@ -40,25 +50,47 @@ func Do(ctx context.Context, p Policy, fn func() error) error {
 	if sleep == nil {
 		sleep = defaultSleep
 	}
-	var err error
-	for n := 1; n <= p.Attempts; n++ {
-		err = fn()
+	attempts := p.Attempts
+	if attempts < 1 {
+		attempts = 1
+	}
+	for n := 1; n <= attempts; n++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		err := fn()
 		if err == nil {
 			return nil
 		}
-		if _, ok := err.(*permanent); ok {
+		var perm *permanent
+		if errors.As(err, &perm) {
 			return err
 		}
-		if n == p.Attempts {
-			break
+		if n == attempts {
+			return err
 		}
-		d := p.Base << uint(n-1)
-		if d > p.Max {
-			d = p.Max
+		if err := ctx.Err(); err != nil {
+			return err
 		}
-		if serr := sleep(ctx, d); serr != nil {
+		if serr := sleep(ctx, delay(p.Base, p.Max, n)); serr != nil {
 			return serr
 		}
 	}
-	return err
+	return nil
+}
+
+// delay returns the backoff before call n+1, Base*2^(n-1), capped at Max.
+// It caps before doubling so a large n cannot overflow time.Duration.
+func delay(base, max time.Duration, n int) time.Duration {
+	d := base
+	for i := 1; i < n; i++ {
+		if d >= max || d > max/2 {
+			return max
+		}
+		d *= 2
+	}
+	if d > max {
+		return max
+	}
+	return d
 }
