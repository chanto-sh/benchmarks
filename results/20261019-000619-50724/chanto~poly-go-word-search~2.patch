 package wordsearch
 
+import "fmt"
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve finds the location of the first and last letter of each word in the
+// puzzle. Coordinates are given as {column, row}, with {0, 0} in the top left.
+// Words that cannot be found are mapped to {{-1, -1}, {-1, -1}} and reported
+// via the returned error.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	locations := make(map[string][2][2]int, len(words))
+	missing := make([]string, 0)
+
+	for _, word := range words {
+		start, end, ok := find(word, puzzle)
+		if !ok {
+			locations[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = append(missing, word)
+			continue
+		}
+		locations[word] = [2][2]int{start, end}
+	}
+
+	if len(missing) > 0 {
+		return locations, fmt.Errorf("words not found: %v", missing)
+	}
+	return locations, nil
+}
+
+func find(word string, puzzle []string) ([2]int, [2]int, bool) {
+	if word == "" {
+		return [2]int{0, 0}, [2]int{0, 0}, true
+	}
+
+	for row := range puzzle {
+		for col := range puzzle[row] {
+			if puzzle[row][col] != word[0] {
+				continue
+			}
+			for _, d := range directions {
+				endCol := col + d[0]*(len(word)-1)
+				endRow := row + d[1]*(len(word)-1)
+				if endRow < 0 || endRow >= len(puzzle) ||
+					endCol < 0 || endCol >= len(puzzle[endRow]) {
+					continue
+				}
+				if matches(word, puzzle, col, row, d) {
+					return [2]int{col, row}, [2]int{endCol, endRow}, true
+				}
+			}
+		}
+	}
+	return [2]int{}, [2]int{}, false
+}
+
+func matches(word string, puzzle []string, col, row int, d [2]int) bool {
+	for i := 0; i < len(word); i++ {
+		r := row + d[1]*i
+		c := col + d[0]*i
+		if r < 0 || r >= len(puzzle) || c < 0 || c >= len(puzzle[r]) {
+			return false
+		}
+		if puzzle[r][c] != word[i] {
+			return false
+		}
+	}
+	return true
 }
