 import math
 
 
+def _gauss_legendre(n):
+    """Nodes and weights for n-point Gauss-Legendre quadrature on [-1, 1]."""
+    nodes = [0.0] * n
+    weights = [0.0] * n
+    for i in range((n + 1) // 2):
+        z = math.cos(math.pi * (i + 0.75) / (n + 0.5))
+        while True:
+            p1, p2 = 1.0, 0.0
+            for j in range(1, n + 1):
+                p1, p2 = ((2 * j - 1) * z * p1 - (j - 1) * p2) / j, p1
+            derivative = n * (z * p1 - p2) / (z * z - 1.0)
+            z_next = z - p1 / derivative
+            if abs(z_next - z) < 1e-15:
+                z = z_next
+                break
+            z = z_next
+        nodes[i] = -z
+        nodes[n - 1 - i] = z
+        weights[i] = 2.0 / ((1.0 - z * z) * derivative * derivative)
+        weights[n - 1 - i] = weights[i]
+    return nodes, weights
+
+
+_NODES, _WEIGHTS = _gauss_legendre(12)
+_PHASE_STEP = math.pi / 4.0
+
+
