+def test_template_option_with_escaped_braces(linter) -> None:
+    """Test that escaped braces are not interpreted as template arguments."""
+    output = StringIO()
+    linter.reporter.out = output
+    linter.config.msg_template = '{{ "Category": "{category}" }}'
+    linter.open()
+    linter.set_current_module("my_mod")
+    linter.add_message("C0301", line=1, args=(1, 2))
+    assert (
+        output.getvalue()
+        == '************* Module my_mod\n{ "Category": "convention" }\n'
+    )
+
