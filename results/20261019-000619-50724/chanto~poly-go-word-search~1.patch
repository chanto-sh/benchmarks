 package wordsearch
 
+import "errors"
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	result := make(map[string][2][2]int, len(words))
+	missing := false
+
+	for _, word := range words {
+		start, end, found := find(word, puzzle)
+		if !found {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			missing = true
+			continue
+		}
+		result[word] = [2][2]int{start, end}
+	}
+
+	if missing {
+		return result, errors.New("word not found")
+	}
+	return result, nil
+}
+
+func find(word string, puzzle []string) ([2]int, [2]int, bool) {
+	none := [2]int{-1, -1}
+	if word == "" {
+		return none, none, false
+	}
+	for y, row := range puzzle {
+		for x := range row {
+			for _, d := range directions {
+				if matches(word, puzzle, x, y, d[0], d[1]) {
+					end := [2]int{
+						x + d[0]*(len(word)-1),
+						y + d[1]*(len(word)-1),
+					}
+					return [2]int{x, y}, end, true
+				}
+			}
+		}
+	}
+	return none, none, false
+}
+
+func matches(word string, puzzle []string, x, y, dx, dy int) bool {
+	for i := 0; i < len(word); i++ {
+		cx := x + dx*i
+		cy := y + dy*i
+		if cy < 0 || cy >= len(puzzle) || cx < 0 || cx >= len(puzzle[cy]) {
+			return false
+		}
+		if puzzle[cy][cx] != word[i] {
+			return false
+		}
+	}
+	return true
 }
