 package wordsearch
 
+import "fmt"
+
+var directions = [][2]int{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve returns the locations of the first and last letter of each word in the
+// puzzle. Coordinates are {x, y} with the origin at the top left. Words that
+// cannot be found are reported as {{-1, -1}, {-1, -1}} and cause an error.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	result := make(map[string][2][2]int, len(words))
+	missing := ""
+	for _, word := range words {
+		start, end, ok := find(word, puzzle)
+		if !ok {
+			result[word] = [2][2]int{{-1, -1}, {-1, -1}}
+			if missing == "" {
+				missing = word
+			}
+			continue
+		}
+		result[word] = [2][2]int{start, end}
+	}
+	if missing != "" {
+		return result, fmt.Errorf("word %q not found", missing)
+	}
+	return result, nil
+}
+
+func find(word string, puzzle []string) ([2]int, [2]int, bool) {
+	if word == "" {
+		return [2]int{}, [2]int{}, false
+	}
+	height := len(puzzle)
+	width := 0
+	if height > 0 {
+		width = len(puzzle[0])
+	}
+
+	for y := 0; y < height; y++ {
+		for x := 0; x < width; x++ {
+			for _, d := range directions {
+				if matches(word, puzzle, x, y, d, height, width) {
+					start := [2]int{x, y}
+					end := [2]int{x + d[0]*(len(word)-1), y + d[1]*(len(word)-1)}
+					return start, end, true
+				}
+			}
+		}
+	}
+	return [2]int{}, [2]int{}, false
+}
+
+func matches(word string, puzzle []string, x, y int, d [2]int, height, width int) bool {
+	for i := 0; i < len(word); i++ {
+		cx := x + d[0]*i
+		cy := y + d[1]*i
+		if cx < 0 || cx >= width || cy < 0 || cy >= height {
+			return false
+		}
+		if puzzle[cy][cx] != word[i] {
+			return false
+		}
+	}
+	return true
 }
