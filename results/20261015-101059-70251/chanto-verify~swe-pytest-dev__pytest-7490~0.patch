index 0000000..439844e
--- /dev/null
+++ b/changelog/7490.bugfix.rst
@@ -0,0 +1 @@
+Fixed a regression where an ``xfail`` marker added dynamically during a test using ``request.node.add_marker()`` was no longer taken into account when evaluating the test result.
diff --git a/src/_pytest/skipping.py b/src/_pytest/skipping.py
