--- a/src/_pytest/skipping.py
+++ b/src/_pytest/skipping.py
@@ -262,6 +262,12 @@ def pytest_runtest_makereport(item: Item, call: CallInfo[None]):
     outcome = yield
     rep = outcome.get_result()
     xfailed = item._store.get(xfailed_key, None)
+    # The xfail marker may have been added dynamically by the test itself
+    # (via ``request.node.add_marker``), in which case it was not present
+    # when the marks were evaluated before the test ran, so evaluate them
+    # again for the call phase now that the test has finished.
+    if rep.when == "call" and xfailed is None and not item.config.option.runxfail:
+        item._store[xfailed_key] = xfailed = evaluate_xfail_marks(item)
     # unittest special case, see setting of unexpectedsuccess_key
     if unexpectedsuccess_key in item._store and rep.when == "call":
         reason = item._store[unexpectedsuccess_key]
