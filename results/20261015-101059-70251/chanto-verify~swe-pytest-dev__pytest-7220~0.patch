+# ``compile`` refuses ``ast.Name`` nodes whose id is one of these since Python
+# 3.8 (raising ``ValueError``), even though they are valid match expression
+# identifiers.  They are prefixed with ``_NAME_PREFIX`` before compiling and
+# the prefix is stripped again when matching.  ``_NAME_PREFIX`` is not a
+# character allowed in match expression identifiers so it can never clash with
+# a user provided identifier (see ``test_invalid_idents``).
+_SPECIAL_NAMES = frozenset(("None", "True", "False"))
+_NAME_PREFIX = "$"
+
 
 class TokenType(enum.Enum):
     LPAREN = "left parenthesis"
@@ -161,7 +170,10 @@ def not_expr(s: Scanner) -> ast.expr:
         return ret
     ident = s.accept(TokenType.IDENT)
     if ident:
-        return ast.Name(ident.value, ast.Load())
+        name = ident.value
+        if name in _SPECIAL_NAMES:
+            name = _NAME_PREFIX + name
+        return ast.Name(name, ast.Load())
     s.reject((TokenType.NOT, TokenType.LPAREN, TokenType.IDENT))
 
 
@@ -172,6 +184,8 @@ class MatcherAdapter(Mapping[str, bool]):
         self.matcher = matcher
 
     def __getitem__(self, key: str) -> bool:
+        if key.startswith(_NAME_PREFIX):
+            key = key[len(_NAME_PREFIX) :]
         return self.matcher(key)
 
     def __iter__(self) -> Iterator[str]:
