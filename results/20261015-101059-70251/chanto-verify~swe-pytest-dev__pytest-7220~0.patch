+def test_traceback_path_uses_invocation_dir_after_chdir(testdir):
+    """Traceback paths should be relative to the invocation directory.
+
+    Changing the current working directory inside a test or fixture should not
+    change the directory the reported paths are relative to (#6073).
+    """
+    testdir.mkdir("sub")
+    testdir.makepyfile(
+        test_path_error="""
+        import os
+
+        import pytest
+
+        @pytest.fixture
+        def change_dir():
+            old_dir = os.getcwd()
+            os.chdir(os.path.join(old_dir, "sub"))
+            yield
+            os.chdir(old_dir)
+
+        def test_show_wrong_path(change_dir):
+            assert False
+        """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*test_path_error.py:*: AssertionError"])
+    result.stdout.no_fnmatch_line("*../test_path_error.py*")
+
+
