diff --git a/changelog/8906.improvement.rst b/changelog/8906.improvement.rst
new file mode 100644
index 0000000..6aa2346
--- /dev/null
+++ b/changelog/8906.improvement.rst
@@ -0,0 +1,3 @@
+Improved the error message when ``pytest.skip`` is called at module level
+without ``allow_module_level=True``, making it clearer that passing
+``allow_module_level=True`` skips the entire module.
diff --git a/doc/en/how-to/skipping.rst b/doc/en/how-to/skipping.rst
index 1565700..44fa101 100644
--- a/doc/en/how-to/skipping.rst
+++ b/doc/en/how-to/skipping.rst
@@ -74,6 +74,12 @@ It is also possible to skip the whole module using
     if not sys.platform.startswith("win"):
         pytest.skip("skipping windows-only tests", allow_module_level=True)
 
+Calling ``pytest.skip`` at the module level without ``allow_module_level=True``
+is not allowed, because it is ambiguous whether a single test or the entire
+module should be skipped, and because the module's body has already partially
+executed. If the module cannot even be imported on the current interpreter (for
+example because it uses newer syntax), use ``allow_module_level=True`` as shown
+above to stop the module from being executed any further.
 
 **Reference**: :ref:`pytest.mark.skip ref`
 
diff --git a/src/_pytest/python.py b/src/_pytest/python.py
index 79dfb73..8e8d2f3 100644
--- a/src/_pytest/python.py
+++ b/src/_pytest/python.py
@@ -608,10 +608,10 @@ class Module(nodes.File, PyCollector):
             if e.allow_module_level:
                 raise
             raise self.CollectError(
-                "Using pytest.skip outside of a test is not allowed. "
-                "To decorate a test function, use the @pytest.mark.skip "
-                "or @pytest.mark.skipif decorators instead, and to skip a "
-                "module use `pytestmark = pytest.mark.{skip,skipif}."
+                "Using pytest.skip outside of a test will skip the entire module. "
+                "If that's your intention, pass `allow_module_level=True`. "
+                "If you want to skip a specific test or an entire class, "
+                "use the @pytest.mark.skip or @pytest.mark.skipif decorators."
             ) from e
         self.config.pluginmanager.consider_module(mod)
         return mod
