+def test_raise_in_getattribute():
+    class A:
+        def __getattribute__(self, name):
+            raise RuntimeError("broken")
+
+        def __repr__(self):
+            raise RuntimeError("broken repr")
+
+    obj = A()
+    s = saferepr(obj)
+    assert "RuntimeError" in s
+    assert "raised in repr()" in s
+    assert "A object at 0x{:x}".format(id(obj)) in s
+
