+def test_broken_getattribute():
+    # Simulate an object whose __getattribute__ raises for every attribute
+    # access, so that even the class name can't be retrieved while building
+    # the already-failed repr (#7168).
+
+    class SomeClass:
+        def __getattribute__(self, attr):
+            raise RuntimeError("broken")
+
+        def __repr__(self):
+            raise RuntimeError("broken")
+
+    s = saferepr(SomeClass())
+    assert "raised in repr()" in s
+    assert "<unknown>" in s
+
+
