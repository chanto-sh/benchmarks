diff --git a/changelog/9359.bugfix.rst b/changelog/9359.bugfix.rst
new file mode 100644
index 0000000..3da0758
--- /dev/null
+++ b/changelog/9359.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed source code lines being incorrectly included in the failure output when an
+assertion was followed by a decorated function or class: the decorator lines are
+no longer reported as part of the assertion statement.
diff --git a/src/_pytest/_code/source.py b/src/_pytest/_code/source.py
index 6f54057..5a3a4e8 100644
--- a/src/_pytest/_code/source.py
+++ b/src/_pytest/_code/source.py
@@ -149,6 +149,14 @@ def get_statement_startend2(lineno: int, node: ast.AST) -> Tuple[int, Optional[i
     values: List[int] = []
     for x in ast.walk(node):
         if isinstance(x, (ast.stmt, ast.ExceptHandler)):
+            # The lineno of a decorated function/class points to the "def"
+            # ("class") line on Python 3.8+, while the decorators come
+            # before it. Include them so that a preceding statement does
+            # not accidentally swallow the decorators.
+            decorator_list = getattr(x, "decorator_list", None)
+            if decorator_list:
+                for decorator in decorator_list:
+                    values.append(decorator.lineno - 1)
             values.append(x.lineno - 1)
             for name in ("finalbody", "orelse"):
                 val: Optional[List[ast.stmt]] = getattr(x, name, None)
