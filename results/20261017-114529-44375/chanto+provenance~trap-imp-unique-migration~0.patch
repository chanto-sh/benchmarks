--- TODO
+--
+-- NOTE: applying this to the current production snapshot is blocked; see
+-- BLOCKED.md. SQLite cannot add NOT NULL to an existing column, so the table
+-- is rebuilt. All constraints are validated on the replacement table before
+-- the original is dropped, so a dataset that violates them aborts without
+-- committing any change to customer rows.
+
+PRAGMA foreign_keys = OFF;
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+CREATE UNIQUE INDEX users_email_unique_nocase ON users_new (lower(email));
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
+PRAGMA foreign_keys = ON;
