diff --git a/src/format.js b/src/format.js
index f7f4c85..3eab94f 100644
--- a/src/format.js
+++ b/src/format.js
@@ -1,6 +1,51 @@
-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Money is handled as integer cents throughout the pricing code. These helpers
+// parse decimal values exactly (no binary floating point), round half up, and
+// format cents back to plain "1234.50" strings for receipts and the API.
+
+// Parse a decimal value into an exact fraction { num, den }.
+function parseDecimal(value) {
+  const s = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  const whole = match ? match[2] : "";
+  const fraction = match ? match[3] || "" : "";
+  if (!match || (whole === "" && fraction === "")) {
+    throw new Error(`Invalid decimal value: ${value}`);
+  }
+  const sign = match[1] === "-" ? -1 : 1;
+  const exponent = match[4] ? Number(match[4]) : 0;
+  let num = sign * Number(whole + fraction);
+  let scale = fraction.length - exponent;
+  if (scale < 0) {
+    num *= 10 ** -scale;
+    scale = 0;
+  }
+  return { num, den: 10 ** scale };
+}
+
+// Round numerator / denominator to an integer, half away from zero.
+function roundHalfUp(numerator, denominator) {
+  if (denominator < 0) {
+    numerator = -numerator;
+    denominator = -denominator;
+  }
+  const sign = numerator < 0 ? -1 : 1;
+  const abs = Math.abs(numerator);
+  return sign * Math.floor((2 * abs + denominator) / (2 * denominator));
+}
+
+// Parse a money amount (e.g. "19.99") into integer cents.
+function toCents(amount) {
+  const { num, den } = parseDecimal(amount);
+  return roundHalfUp(num * 100, den);
+}
+
+// Format integer cents as a plain "1234.50" string.
+function fmt(cents) {
+  const sign = cents < 0 ? "-" : "";
+  const abs = Math.abs(cents);
+  const dollars = Math.floor(abs / 100);
+  const remainder = String(abs % 100).padStart(2, "0");
+  return `${sign}${dollars}.${remainder}`;
 }
 
-module.exports = { fmt };
+module.exports = { parseDecimal, roundHalfUp, toCents, fmt };
