 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _stiffness(k, m, omega):
+    """Return k - m*omega^2 with extra precision when fma is available."""
+    product = m * omega
+    stiffness = k - product * omega
+
+    fma = getattr(math, "fma", None)
+    if fma is not None:
+        # Correct the rounding error in m*omega before the final subtraction.
+        product_error = fma(m, omega, -product)
+        stiffness = fma(-product, omega, k) - product_error * omega
+
+    return stiffness
+
+
+def _steady_state_terms(m, k, c, F0, omega):
+    """Return the signed amplitude and the cos/sin coefficients of x_p."""
+    if F0 == 0.0:
+        return 0.0, 0.0, 0.0
+
+    stiffness = _stiffness(k, m, omega)
+    damping = c * omega
+    impedance = math.hypot(stiffness, damping)
+    if impedance == 0.0:
+        raise ValueError("steady state is unbounded at undamped resonance")
+
+    amplitude = F0 / impedance
+    cos_phase = stiffness / impedance
+    sin_phase = damping / impedance
+    return amplitude, amplitude * cos_phase, amplitude * sin_phase
+
+
+def _sin_cos_over_x(x):
+    """Return sin(x)/x and cos(x), accurate also for very small x."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        sin_over_x = 1.0 + x2 * (
+            -1.0 / 6.0
+            + x2 * (1.0 / 120.0 + x2 * (-1.0 / 5040.0 + x2 / 362880.0))
+        )
+        cos_x = 1.0 + x2 * (
+            -1.0 / 2.0
+            + x2 * (1.0 / 24.0 + x2 * (-1.0 / 720.0 + x2 / 40320.0))
+        )
+        return sin_over_x, cos_x
+
+    return math.sin(x) / x, math.cos(x)
+
+
+def _sinh_cosh_over_x(x):
+    """Return sinh(x)/x and cosh(x), accurate also for very small x."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        sinh_over_x = 1.0 + x2 * (
+            1.0 / 6.0
+            + x2 * (1.0 / 120.0 + x2 * (1.0 / 5040.0 + x2 / 362880.0))
+        )
+        cosh_x = 1.0 + x2 * (
+            1.0 / 2.0
+            + x2 * (1.0 / 24.0 + x2 * (1.0 / 720.0 + x2 / 40320.0))
+        )
+        return sinh_over_x, cosh_x
+
+    return math.sinh(x) / x, math.cosh(x)
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    signed_amplitude, _, _ = _steady_state_terms(m, k, c, F0, omega)
+    return abs(signed_amplitude)
 
 
 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    _, particular_cos, particular_sin = _steady_state_terms(m, k, c, F0, omega)
+
+    decay_rate = c / (2.0 * m)
+    natural_frequency_sq = k / m
+    natural_frequency = math.sqrt(natural_frequency_sq)
+
+    # q = decay_rate^2 - natural_frequency^2.  Factoring it this way
+    # avoids losing precision when the system is close to critical damping.
+    q = (decay_rate - natural_frequency) * (decay_rate + natural_frequency)
+
+    decay = math.exp(-decay_rate * t)
+
+    if q <= 0.0:
+        # Underdamped, including the critically damped limit q == 0.
+        oscillation_rate = math.sqrt(-q)
+        x = oscillation_rate * t
+        sin_over_x, cos_x = _sin_cos_over_x(x)
+        phi0 = decay * (cos_x + decay_rate * t * sin_over_x)
+        phi1 = decay * t * sin_over_x
+    else:
+        # Overdamped.  Use hyperbolic functions while they are well scaled,
+        # then switch to the two decaying exponentials to avoid overflow.
+        oscillation_rate = math.sqrt(q)
+        x = oscillation_rate * t
+
+        if abs(x) < 0.5:
+            sinh_over_x, cosh_x = _sinh_cosh_over_x(x)
+            phi0 = decay * (cosh_x + decay_rate * t * sinh_over_x)
+            phi1 = decay * t * sinh_over_x
+        else:
+            slow_rate = natural_frequency_sq / (decay_rate + oscillation_rate)
+            fast_rate = decay_rate + oscillation_rate
+            slow_decay = math.exp(-slow_rate * t)
+            fast_decay = math.exp(-fast_rate * t)
+
+            sinh_term = (slow_decay - fast_decay) / (2.0 * x)
+            cosh_decay = 0.5 * (slow_decay + fast_decay)
+            phi0 = cosh_decay + decay_rate * t * sinh_term
+            phi1 = t * sinh_term
+
+    steady_cos = math.cos(omega * t)
+    steady_sin = math.sin(omega * t)
+
+    # This form avoids subtracting the (possibly large) particular solution
+    # from x0, and it satisfies the initial conditions exactly at t == 0.
+    return (
+        x0 * phi0
+        + v0 * phi1
+        + particular_cos * (steady_cos - phi0)
+        + particular_sin * (steady_sin - omega * phi1)
+    )
