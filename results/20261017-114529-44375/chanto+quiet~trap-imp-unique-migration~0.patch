 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL or UNIQUE to an existing table in place, so the
+-- table is rebuilt. The transaction makes the rebuild atomic: if the existing
+-- rows violate either rule, the migration aborts and leaves `users` unchanged.
+BEGIN;
+
+-- Fail before touching the table if existing emails already collide
+-- case-insensitively. (NULLs are handled by the NOT NULL column below.)
+CREATE UNIQUE INDEX users_email_case_unique ON users (lower(email));
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+-- DROP TABLE removed the validation index above; recreate it on the new table.
+CREATE UNIQUE INDEX users_email_case_unique ON users (lower(email));
+
+COMMIT;
