+class EnvTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_case_insensitive(self):
+        cfg = load(env={"shopd__Db__HoSt": "db.env"})
+        self.assertEqual(cfg["db"]["host"], "db.env")
+
+    def test_unrelated_variables_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD_DB_PORT": "1", "OTHER__DB__PORT": "2"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_types_follow_defaults(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "0.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__NAME": "other",
+                "SHOPD__FEATURES": " search , cache ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["name"], "other")
+        self.assertEqual(cfg["features"], ["search", "cache"])
+
+    def test_booleans(self):
+        for raw in ("1", "true", "TRUE", "Yes", "on"):
+            self.assertIs(load(env={"SHOPD__LOG__JSON": raw})["log"]["json"], True)
+        for raw in ("0", "false", "False", "NO", "off"):
+            self.assertIs(load(env={"SHOPD__LOG__JSON": raw})["log"]["json"], False)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "6543"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_int(self):
+        for raw in ("abc", "5.5"):
+            with self.assertRaises(ConfigError) as cm:
+                load(env={"SHOPD__DB__PORT": raw})
+            self.assertIn("db.port", str(cm.exception))
+
+    def test_bad_bool(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__SSL": "maybe"})
+        self.assertIn("db.ssl", str(cm.exception))
+
+    def test_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(
+            overrides=["db.port=6543", "db.pool.size=9", "features=a, b", "db.ssl=on"]
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 6000, "host": "file"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "7000", "SHOPD__DB__HOST": "env"},
+                overrides=["db.port=8000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 8000)
+        self.assertEqual(cfg["db"]["host"], "env")
+
+    def test_env_beats_file(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 6000}}, f)
+        try:
+            cfg = load(f.name, env={"SHOPD__DB__PORT": "7000"})
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 7000)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.prot=1"])
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_value(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.port=5.5"])
+        self.assertIn("db.port", str(cm.exception))
+
+    def test_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db=1"])
+        self.assertIn("db", str(cm.exception))
+
+    def test_malformed_override(self):
+        with self.assertRaises(ConfigError):
+            load(overrides=["db.port"])
+
+
+class CliTest(unittest.TestCase):
+    root = os.path.dirname(os.path.abspath(__file__))
+
+    def run_cli(self, *args, env=None):
+        clean_env = {
+            k: v for k, v in os.environ.items() if not k.upper().startswith("SHOPD__")
+        }
+        clean_env.update(env or {})
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=self.root,
+            env=clean_env,
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_is_repeatable(self):
+        result = self.run_cli("--set", "db.port=6543", "--set", "db.host=cli")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        cfg = json.loads(result.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["host"], "cli")
+
+    def test_environment_is_read(self):
+        result = self.run_cli(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)["db"]["port"], 6543)
+
+    def test_config_error_exits_2(self):
+        result = self.run_cli("--set", "db.prot=1")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.prot", result.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
