+def _default_for(path):
+    """The built-in default for a dotted setting path, or ConfigError if there is none."""
+    node = DEFAULTS
+    for part in path:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {'.'.join(path)}")
