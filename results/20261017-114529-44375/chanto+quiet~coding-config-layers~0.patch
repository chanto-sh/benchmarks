@@ -1,5 +1,7 @@
 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -29,5 +31,130 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class EnvironmentTest(unittest.TestCase):
+    def test_nested_variable(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_key_names_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__db__Port": "6543"})
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_unrelated_variables_are_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD_DB_PORT": "1", "OTHER": "x"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_converts_to_default_types(self):
+        cfg = load(env={
+            "SHOPD__NAME": "svc",
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "3",
+            "SHOPD__DB__SSL": "yes",
+            "SHOPD__FEATURES": "search, billing ",
+        })
+        self.assertEqual(cfg["name"], "svc")
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.0)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_bool_spellings(self):
+        for value in ("1", "true", "TRUE", "Yes", "on"):
+            with self.subTest(value=value):
+                self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], True)
+        for value in ("0", "false", "FALSE", "No", "off"):
+            with self.subTest(value=value):
+                self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], False)
+
+    def test_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_unknown_setting(self):
+        with self.assertRaisesRegex(ConfigError, "db.prot"):
+            load(env={"SHOPD__DB__PROT": "1"})
+
+    def test_invalid_int(self):
+        for value in ("abc", "5.5"):
+            with self.subTest(value=value):
+                with self.assertRaisesRegex(ConfigError, "db.port"):
+                    load(env={"SHOPD__DB__PORT": value})
+
+    def test_invalid_bool(self):
+        with self.assertRaisesRegex(ConfigError, "db.ssl"):
+            load(env={"SHOPD__DB__SSL": "maybe"})
+
+    def test_cannot_set_section(self):
+        for name in ("SHOPD__DB", "SHOPD__DB__POOL"):
+            with self.subTest(name=name):
+                setting = name[len("SHOPD__"):].lower().replace("__", ".")
+                with self.assertRaisesRegex(ConfigError, setting):
+                    load(env={name: "1"})
+
+
+class OverridesTest(unittest.TestCase):
+    def test_override_string(self):
+        cfg = load(env={}, overrides=["db.pool.size=20"])
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "filehost", "port": 6000}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "7000"},
+                overrides=["db.port=8000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 8000)
+        self.assertEqual(cfg["db"]["host"], "filehost")
+
+    def test_unknown_setting(self):
+        with self.assertRaisesRegex(ConfigError, "db.prot"):
+            load(env={}, overrides=["db.prot=1"])
+
+    def test_invalid_value(self):
+        with self.assertRaisesRegex(ConfigError, "db.port"):
+            load(env={}, overrides=["db.port=5.5"])
+
+    def test_cannot_set_section(self):
+        with self.assertRaisesRegex(ConfigError, "db.pool"):
+            load(env={}, overrides=["db.pool=1"])
+
+    def test_missing_equals(self):
+        with self.assertRaises(ConfigError):
+            load(env={}, overrides=["db.port"])
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        root = os.path.dirname(os.path.abspath(__file__))
+        env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+        env["PYTHONPATH"] = root
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=root,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    def test_repeatable_set_options(self):
+        proc = self.run_cli("--set", "db.port=6543", "--set", "db.pool.size=20")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        cfg = json.loads(proc.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_bad_override_exits_2(self):
+        proc = self.run_cli("--set", "db.prot=1")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("db.prot", proc.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
