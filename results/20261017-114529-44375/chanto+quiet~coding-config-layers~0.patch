@@ -1,13 +1,24 @@
 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
-    cfg = DEFAULTS
+_BOOL_TRUE = {"1", "true", "yes", "on"}
+_BOOL_FALSE = {"0", "false", "no", "off"}
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layers, lowest precedence first: the built-in defaults, the JSON file at
+    `path` (if any), the mapping `env` (defaults to ``os.environ``), and the
+    ``NAME=VALUE`` strings in `overrides`.
+    """
+    cfg = deep_merge(DEFAULTS, {})
     if path:
         try:
             with open(path) as f:
@@ -17,4 +28,67 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
-    return deep_merge(cfg, {})
+
+    if env is None:
+        env = os.environ
+
+    env_patch = {}
+    for name, value in env.items():
+        if not name.upper().startswith(ENV_PREFIX):
+            continue
+        parts = [part.lower() for part in name[len(ENV_PREFIX):].split("__")]
+        _apply(env_patch, parts, value)
+    cfg = deep_merge(cfg, env_patch)
+
+    override_patch = {}
+    for item in overrides:
+        name, sep, value = item.partition("=")
+        if not sep:
+            raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+        parts = [part.strip().lower() for part in name.split(".")]
+        _apply(override_patch, parts, value)
+
+    return deep_merge(cfg, override_patch)
+
+
+def _apply(patch, parts, raw):
+    """Validate `parts` against the built-in defaults and set the converted value in `patch`."""
+    name = ".".join(parts)
+    current = DEFAULTS
+    for part in parts:
+        if not part or not isinstance(current, dict) or part not in current:
+            raise ConfigError(f"unknown setting: {name}")
+        current = current[part]
+    if isinstance(current, dict):
+        raise ConfigError(f"{name}: cannot set a whole section, choose a setting inside it")
+
+    value = _convert(name, current, raw)
+    node = patch
+    for part in parts[:-1]:
+        node = node.setdefault(part, {})
+    node[parts[-1]] = value
+
+
+def _convert(name, default, raw):
+    if isinstance(default, bool):
+        text = raw.strip().lower()
+        if text in _BOOL_TRUE:
+            return True
+        if text in _BOOL_FALSE:
+            return False
+        raise ConfigError(f"{name}: invalid bool value {raw!r}")
+    if isinstance(default, int):
+        try:
+            return int(raw.strip())
+        except ValueError:
+            raise ConfigError(f"{name}: invalid int value {raw!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(raw.strip())
+        except ValueError:
+            raise ConfigError(f"{name}: invalid float value {raw!r}") from None
+    if isinstance(default, list):
+        if not raw.strip():
+            return []
+        return [item.strip() for item in raw.split(",")]
+    return raw
