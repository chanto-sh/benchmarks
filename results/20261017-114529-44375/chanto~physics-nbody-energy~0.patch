+import copy
 import math
 import unittest
 
@@ -17,6 +18,45 @@ class TestNBody(unittest.TestCase):
         for xy in p:
             self.assertAlmostEqual(math.hypot(*xy), 1.0, places=3)
 
+    def test_long_run_eccentric_orbit(self):
+        # Equal masses on an eccentric orbit; energy error must stay bounded.
+        m = [1.0, 1.0]
+        a, e = 1.0, 0.6
+        r_peri = a * (1.0 - e)
+        v_peri = math.sqrt(2.0 * (2.0 / r_peri - 1.0 / a))
+        pos = [[-0.5 * r_peri, 0.0], [0.5 * r_peri, 0.0]]
+        vel = [[0.0, -0.5 * v_peri], [0.0, 0.5 * v_peri]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+
+    def test_three_body_energy_and_momentum(self):
+        # Figure-eight choreography.
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753],
+               [-0.97000436, 0.24308753],
+               [0.0, 0.0]]
+        vel = [[0.4662036850, 0.4323657300],
+               [0.4662036850, 0.4323657300],
+               [-0.93240737, -0.86473146]]
+        e0 = energy(m, pos, vel)
+        p0 = [sum(mi * vi[k] for mi, vi in zip(m, vel)) for k in range(2)]
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-9)
+        p1 = [sum(mi * vi[k] for mi, vi in zip(m, q)) for k in range(2)]
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-9)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[-0.5, 0.0], [1.0, 0.0]]
+        vel = [[0.0, -0.3], [0.0, 0.1]]
+        pos0, vel0 = copy.deepcopy(pos), copy.deepcopy(vel)
+        p, q = simulate(m, pos, vel, 0.01, 100)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertIsNot(p, pos)
+        self.assertIsNot(q, vel)
+
 
 if __name__ == "__main__":
     unittest.main()
