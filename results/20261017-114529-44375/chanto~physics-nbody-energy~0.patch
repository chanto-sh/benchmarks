diff --git a/nbody.py b/nbody.py
index 133b00d..99879ac 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,36 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses the fourth-order Yoshida composition of symplectic leapfrog steps.
+    Being symplectic and time-reversible, it keeps the energy error bounded
+    over long integrations instead of accumulating a secular drift.
+    """
+    pos = [list(p) for p in positions]
+    vel = [list(v) for v in velocities]
+    if steps <= 0:
+        return pos, vel
+
+    # Yoshida's fourth-order coefficients: three leapfrog steps of lengths
+    # w1*dt, w0*dt, w1*dt.
+    cbrt2 = 2.0 ** (1.0 / 3.0)
+    w1 = 1.0 / (2.0 - cbrt2)
+    w0 = -cbrt2 * w1
+    substeps = (w1 * dt, w0 * dt, w1 * dt)
+
+    n = len(masses)
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        for h in substeps:
+            half_h = 0.5 * h
+            for i in range(n):
+                vel[i][0] += half_h * acc[i][0]
+                vel[i][1] += half_h * acc[i][1]
+                pos[i][0] += h * vel[i][0]
+                pos[i][1] += h * vel[i][1]
+            acc = accelerations(masses, pos, G)
+            for i in range(n):
+                vel[i][0] += half_h * acc[i][0]
+                vel[i][1] += half_h * acc[i][1]
+    return pos, vel
