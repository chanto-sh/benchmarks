+    def test_inputs_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[0.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, 0.1], [0.0, -0.1]]
+        pos0, vel0 = copy.deepcopy(pos), copy.deepcopy(vel)
+        simulate(m, pos, vel, 0.001, 100)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
+    def test_momentum_conserved(self):
+        # unequal masses, circular orbit plus a common drift velocity
+        m = [1.0, 2.5]
+        r = 1.0
+        total = sum(m)
+        v_rel = math.sqrt(total / r)
+        pos = [[-m[1] / total * r, 0.0], [m[0] / total * r, 0.0]]
+        vel = [
+            [0.3, -m[1] / total * v_rel - 0.2],
+            [0.3, m[0] / total * v_rel - 0.2],
+        ]
+        p0 = momentum(m, vel)
+        _, q = simulate(m, pos, vel, 0.01, 20000)
+        p1 = momentum(m, q)
+        for a, b in zip(p0, p1):
+            self.assertLess(abs(a - b), 1e-10)
+
+    def test_eccentric_orbit_energy_stays_bounded(self):
+        # e = 0.5 two-body orbit; sample the energy over many orbits
+        m = [0.5, 0.5]
+        a, e = 1.0, 0.5
+        rp = a * (1.0 - e)
+        vp = math.sqrt((1.0 + e) / (a * (1.0 - e)))
+        pos = [[-rp, 0.0], [rp, 0.0]]
+        vel = [[0.0, -vp / 2.0], [0.0, vp / 2.0]]
+        e0 = energy(m, pos, vel)
