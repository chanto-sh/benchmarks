--- a/nbody.py
+++ b/nbody.py
@@ -28,6 +28,49 @@ def energy(masses, positions, velocities, G=1.0):
     return ke + pe
 
 
+_CBRT2 = 2.0 ** (1.0 / 3.0)
+_YOSHIDA_W1 = 1.0 / (2.0 - _CBRT2)
+_YOSHIDA_W0 = -_CBRT2 * _YOSHIDA_W1
+
+
+def _verlet_step(masses, positions, velocities, acc, dt, G):
+    """One velocity Verlet step; returns the acceleration at the new positions."""
+    n = len(masses)
+    half_dt = 0.5 * dt
+    for i in range(n):
+        velocities[i][0] += half_dt * acc[i][0]
+        velocities[i][1] += half_dt * acc[i][1]
+        positions[i][0] += dt * velocities[i][0]
+        positions[i][1] += dt * velocities[i][1]
+    acc = accelerations(masses, positions, G)
+    for i in range(n):
+        velocities[i][0] += half_dt * acc[i][0]
+        velocities[i][1] += half_dt * acc[i][1]
+    return acc
+
+
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses a fourth-order symplectic integrator: Yoshida's three-substep
+    composition of velocity Verlet (kick-drift-kick leapfrog).  Being symplectic
+    and time-reversible, its energy error oscillates within a bound instead of
+    drifting secularly, even over very long runs.  Each substep is symmetric, so
+    total momentum is conserved.  The input lists are not modified.
+    """
+    if steps < 0:
+        raise ValueError("steps must be non-negative")
+
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+    n = len(masses)
+
+    if steps == 0 or n == 0:
+        return pos, vel
+
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        for weight in (_YOSHIDA_W1, _YOSHIDA_W0, _YOSHIDA_W1):
+            acc = _verlet_step(masses, pos, vel, acc, weight * dt, G)
+
+    return pos, vel
