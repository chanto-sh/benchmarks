diff --git a/nbody.py b/nbody.py
index 133b00d..4a63563 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,43 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses a fourth-order symplectic composition of kick-drift-kick
+    (velocity Verlet) substeps (Yoshida / Forest-Ruth).  Symplectic
+    integrators have bounded energy error over long integrations instead of
+    secular drift, and the pairwise forces conserve total momentum.
+    """
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+    if steps <= 0:
+        return pos, vel
+
+    # Composition weights: w1 + w0 + w1 = 1, giving a net advance of dt.
+    w1 = 1.0 / (2.0 - 2.0 ** (1.0 / 3.0))
+    w0 = 1.0 - 2.0 * w1
+    substeps = (w1 * dt, w0 * dt, w1 * dt)
+
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        for h in substeps:
+            half_h = 0.5 * h
+
+            # Half kick with the acceleration at the current positions.
+            for i in range(n):
+                vel[i][0] += half_h * acc[i][0]
+                vel[i][1] += half_h * acc[i][1]
+
+            # Full drift.
+            for i in range(n):
+                pos[i][0] += h * vel[i][0]
+                pos[i][1] += h * vel[i][1]
+
+            # Re-evaluate forces and apply the second half kick.
+            acc = accelerations(masses, pos, G)
+            for i in range(n):
+                vel[i][0] += half_h * acc[i][0]
+                vel[i][1] += half_h * acc[i][1]
+
+    return pos, vel
