diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..ec714c8
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,61 @@
+// Money helpers. Amounts are integer cents; percentages are exact decimal fractions.
+
+// Parse a decimal amount ("19.99") into integer cents, rounding half up if it
+// carries more than two decimal places.
+function parseCents(value) {
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?$/.exec(String(value).trim());
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`invalid amount: ${value}`);
+  }
+  const sign = match[1] === "-" ? -1 : 1;
+  const whole = match[2] || "0";
+  let fraction = match[3] || "";
+  let carry = 0;
+  if (fraction.length > 2) {
+    carry = fraction[2] >= "5" ? 1 : 0;
+    fraction = fraction.slice(0, 2);
+  }
+  return sign * (Number(whole) * 100 + Number(fraction.padEnd(2, "0") || "0") + carry);
+}
+
+// Divide integers rounding halves away from zero.
+function roundHalfUp(numerator, denominator) {
+  if (denominator < 0) {
+    numerator = -numerator;
+    denominator = -denominator;
+  }
+  const sign = numerator < 0 ? -1 : 1;
+  const magnitude = Math.abs(numerator);
+  const quotient = Math.floor(magnitude / denominator);
+  const remainder = magnitude % denominator;
+  return sign * (quotient + (remainder * 2 >= denominator ? 1 : 0));
+}
+
+// Convert a percentage to an exact [numerator, denominator] pair.
+function percentFraction(pct) {
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?$/.exec(String(pct).trim());
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`invalid percentage: ${pct}`);
+  }
+  const sign = match[1] === "-" ? -1 : 1;
+  const whole = match[2] || "0";
+  const fraction = match[3] || "";
+  const denominator = 10 ** fraction.length;
+  const numerator = sign * Number(whole + fraction);
+  return [numerator, denominator];
+}
+
+// pct percent of an integer-cent amount, rounded half up to the cent.
+function percentCents(cents, pct) {
+  const [numerator, denominator] = percentFraction(pct);
+  return roundHalfUp(cents * numerator, denominator * 100);
+}
+
+// Format integer cents as a receipt string ("55.18").
+function fmt(cents) {
+  const sign = cents < 0 ? "-" : "";
+  const magnitude = Math.abs(cents);
+  return `${sign}${Math.floor(magnitude / 100)}.${String(magnitude % 100).padStart(2, "0")}`;
+}
+
+module.exports = { parseCents, roundHalfUp, percentCents, fmt };
