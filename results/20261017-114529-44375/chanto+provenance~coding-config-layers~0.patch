 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -28,6 +30,142 @@ class ConfigTest(unittest.TestCase):
         with self.assertRaises(ConfigError):
             load("/nonexistent/config.json")
 
+    def test_env_layer(self):
+        cfg = load(env={"SHOPD__DB__HOST": "db.env", "SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["host"], "db.env")
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_env_is_case_insensitive_and_ignores_other_variables(self):
+        cfg = load(
+            env={
+                "SHOPD__Db__PoRt": "6543",
+                "SHOPD__LOG__LEVEL": "debug",
+                "DB_PORT": "1111",
+                "HOME": "/home/x",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_env_types(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "20",
+                "SHOPD__DB__POOL__TIMEOUT": "0.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__FEATURES": " search, ads ,, ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["features"], ["search", "ads"])
+
+    def test_bool_spellings(self):
+        for value in ("1", "true", "TRUE", "Yes", "on"):
+            with self.subTest(value=value):
+                self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], True)
+        for value in ("0", "false", "False", "no", "OFF"):
+            with self.subTest(value=value):
+                self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], False)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_overrides(self):
+        cfg = load(overrides=["db.port=6543", "db.pool.size=20", "features=a,b"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["features"], ["a", "b"])
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111, "host": "file"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222", "SHOPD__DB__HOST": "env"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["db"]["host"], "env")
+
+    def test_defaults_are_not_mutated(self):
+        load(env={"SHOPD__DB__HOST": "other", "SHOPD__FEATURES": "a"})
+        cfg = load()
+        self.assertEqual(cfg["db"]["host"], "localhost")
+        self.assertEqual(cfg["features"], ["search"])
+
+    def test_unknown_env_setting_names_it(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "5432"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_unknown_override_setting_names_it(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(overrides=["db.prot=5432"])
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_section_is_not_a_setting(self):
