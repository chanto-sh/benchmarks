+            {"env": {"SHOPD__DB": "x"}},
+            {"overrides": ["db=x"]},
+            {"overrides": ["db.pool=x"]},
+        ):
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ConfigError) as cm:
+                    load(**kwargs)
+                self.assertIn("db", str(cm.exception))
+
+    def test_bad_conversions_name_the_setting(self):
+        cases = [
+            {"SHOPD__DB__PORT": "abc"},
+            {"SHOPD__DB__PORT": "5.5"},
+            {"SHOPD__DB__POOL__TIMEOUT": "fast"},
+            {"SHOPD__DB__SSL": "maybe"},
+        ]
+        for env in cases:
+            name = next(iter(env))[len("SHOPD__"):].lower().replace("__", ".")
+            with self.subTest(env=env):
