 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+from fractions import Fraction
+
+
+def _detuning(m, k, omega):
+    """Return k - m*omega**2 without catastrophic cancellation.
+
+    Near resonance the two terms can be almost equal.  Recomputing the
+    difference from the exact values of the input floats preserves the small
+    detuning (including the case where ordinary floating-point arithmetic
+    rounds it to zero).
+    """
+    m_w2 = m * omega * omega
+    d = k - m_w2
+    scale = max(abs(k), abs(m_w2))
+    if scale and abs(d) <= 1e-6 * scale:
+        d = float(Fraction(k) - Fraction(m) * Fraction(omega) ** 2)
+    return d
+
+
+def _steady_coefficients(m, k, c, F0, omega):
+    """Coefficients A, B of the steady-state solution A cos(wt) + B sin(wt)."""
+    real = _detuning(m, k, omega)
+    imag = c * omega
+    size = math.hypot(real, imag)
+    if size == 0.0:
+        raise ZeroDivisionError(
+            "no finite steady state at exact resonance with zero damping"
+        )
+    amplitude = F0 / size
+    return amplitude * (real / size), amplitude * (imag / size)
+
+
+def _sinc(x):
+    """sin(x) / x, with the removable singularity handled accurately."""
+    if x == 0.0:
+        return 1.0
+    if abs(x) < 1e-4:
+        x2 = x * x
+        return 1.0 - x2 / 6.0 + x2 * x2 / 120.0
+    return math.sin(x) / x
+
+
+def _phi(z):
+    """(1 - exp(-2z)) / (2z), the smooth part of sinh(z) / z."""
+    if z == 0.0:
+        return 1.0
+    if abs(z) < 1e-4:
+        return 1.0 - z + (2.0 / 3.0) * z * z - (1.0 / 3.0) * z * z * z
+    return -math.expm1(-2.0 * z) / (2.0 * z)
+
 
