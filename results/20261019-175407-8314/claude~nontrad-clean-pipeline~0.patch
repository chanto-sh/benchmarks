+#!/usr/bin/env python3
+"""Clean a raw customer export.
+
+Usage: python3 clean.py <input.csv> <output.csv>
+"""
+
+import csv
+import re
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext
+from pathlib import Path
+
+COLUMNS = ["customer_id", "name", "email", "signup_date", "country", "spend"]
+ALIASES_PATH = Path(__file__).resolve().parent / "country_aliases.csv"
+
+MONTHS = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+WHITESPACE_RE = re.compile(r"\s+")
+ID_RE = re.compile(r"^[0-9]+$")
+ISO_DATE_RE = re.compile(r"^([0-9]{4})-([0-9]{2})-([0-9]{2})$")
+DMY_DATE_RE = re.compile(r"^([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})$")
+TEXT_DATE_RE = re.compile(r"^([A-Za-z]{3})\s+([0-9]{1,2}),\s*([0-9]{4})$")
+SPEND_RE = re.compile(r"^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)$")
+
+
+def load_aliases(path):
+    aliases = {}
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for row in csv.DictReader(f):
+            alias = (row.get("alias") or "").strip().lower()
+            if alias:
+                aliases[alias] = (row.get("code") or "").strip()
+    return aliases
+
+
+def clean_customer_id(raw):
+    value = raw.strip()
+    if not ID_RE.fullmatch(value):
+        return None
+    return int(value)
+
+
+def clean_name(raw):
+    return WHITESPACE_RE.sub(" ", raw.strip())
+
+
+def clean_email(raw):
+    email = raw.strip().lower()
+    if email.count("@") != 1:
+        return None
+    local, _, domain = email.partition("@")
+    if not local or "." not in domain:
+        return None
+    if domain.startswith(".") or domain.endswith("."):
+        return None
+    return email
+
+
+def clean_signup_date(raw):
+    value = raw.strip()
+
+    match = ISO_DATE_RE.fullmatch(value)
+    if match:
+        year, month, day = (int(part) for part in match.groups())
+    else:
+        match = DMY_DATE_RE.fullmatch(value)
+        if match:
+            day, month, year = (int(part) for part in match.groups())
+        else:
+            match = TEXT_DATE_RE.fullmatch(value)
+            if not match:
+                return None
+            month = MONTHS.get(match.group(1).lower())
+            if month is None:
+                return None
+            day, year = int(match.group(2)), int(match.group(3))
+
+    try:
+        return date(year, month, day)
+    except ValueError:
+        return None
+
+
+def clean_country(raw, aliases):
+    return aliases.get(raw.strip().lower(), "")
+
+
+def clean_spend(raw):
+    value = raw.strip().replace("$", "").replace(",", "").strip()
+    if not value:
+        return Decimal("0.00")
+    if not SPEND_RE.fullmatch(value):
+        return None
+
+    try:
+        amount = Decimal(value)
+    except InvalidOperation:
+        return None
+
+    with localcontext() as ctx:
+        ctx.prec = max(28, len(value) + 5)
+        amount = amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+    # Avoid emitting "-0.00".
+    return abs(amount) if amount == 0 else amount
+
+
+def clean(input_path, output_path):
+    aliases = load_aliases(ALIASES_PATH)
+
+    best = {}
+    with open(input_path, newline="", encoding="utf-8-sig") as f:
+        reader = csv.reader(f)
+
+        try:
+            header = next(reader)
+        except StopIteration:
+            raise SystemExit(f"error: {input_path} is empty")
+
+        positions = {}
+        for index, name in enumerate(header):
+            positions.setdefault(name.strip(), index)
+
+        missing = [name for name in COLUMNS if name not in positions]
+        if missing:
+            raise SystemExit(
+                f"error: {input_path} is missing column(s): {', '.join(missing)}"
+            )
+
+        offsets = [positions[name] for name in COLUMNS]
+
+        for raw_row in reader:
+            row = [
+                raw_row[i] if i < len(raw_row) else ""
+                for i in offsets
+            ]
+
+            customer_id = clean_customer_id(row[0])
+            if customer_id is None:
+                continue
+
+            email = clean_email(row[2])
+            if email is None:
+                continue
+
+            signup_date = clean_signup_date(row[3])
+            if signup_date is None:
+                continue
+
+            spend = clean_spend(row[5])
+            if spend is None:
+                continue
+
+            record = (
+                clean_name(row[1]),
+                email,
+                signup_date,
+                clean_country(row[4], aliases),
+                spend,
+            )
+
+            current = best.get(customer_id)
+            # Rows are visited in file order, so ">=" makes the later row win ties.
+            if current is None or signup_date >= current[2]:
+                best[customer_id] = record
+
+    with open(output_path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, quoting=csv.QUOTE_MINIMAL, lineterminator="\n")
+        writer.writerow(COLUMNS)
+        for customer_id in sorted(best):
+            name, email, signup_date, country, spend = best[customer_id]
+            writer.writerow(
+                [
+                    str(customer_id),
+                    name,
+                    email,
+                    signup_date.isoformat(),
+                    country,
+                    f"{spend:.2f}",
+                ]
+            )
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: python3 {Path(argv[0]).name} <input.csv> <output.csv>",
+              file=sys.stderr)
+        return 2
+    try:
+        clean(argv[1], argv[2])
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
