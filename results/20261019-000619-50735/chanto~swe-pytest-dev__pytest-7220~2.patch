+def test_tb_path_relative_to_invocation_dir(testdir):
+    """Paths in the traceback should be relative to the invocation directory,
+    even if a fixture changes the current working directory (#7220)."""
+    p = testdir.makepyfile(
+        """
+        import os
+
+        import pytest
+
+
+        @pytest.fixture
+        def private_dir():
+            out_dir = "ddd"
+            os.mkdir(out_dir)
+            old_dir = os.getcwd()
+            os.chdir(out_dir)
+            yield out_dir
+            os.chdir(old_dir)
+
+
+        def test_show_wrong_path(private_dir):
+            assert False
+    """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["*%s:17: AssertionError" % p.basename])
+    assert "../%s" % p.basename not in result.stdout.str()
+
+
 def test_traceconfig(testdir):
     result = testdir.runpytest("--traceconfig")
     result.stdout.fnmatch_lines(["*active plugins*"])
