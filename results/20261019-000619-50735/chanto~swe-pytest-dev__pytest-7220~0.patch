+def test_traceback_path_after_cwd_change(testdir):
+    p = testdir.makepyfile(
+        """
+        import os
+
+        import pytest
+
+        @pytest.fixture
+        def change_cwd(tmpdir):
+            old_dir = os.getcwd()
+            os.chdir(str(tmpdir))
+            yield
+            os.chdir(old_dir)
+
+        def test_relative_path(change_cwd):
+            assert False
+    """
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(["{}:13: AssertionError".format(p.basename)])
+
+
 def test_traceconfig(testdir):
     result = testdir.runpytest("--traceconfig")
     result.stdout.fnmatch_lines(["*active plugins*"])
