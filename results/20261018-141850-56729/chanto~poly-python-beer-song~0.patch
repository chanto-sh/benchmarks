+def _bottles(count):
+    if count == 0:
+        return "no more bottles"
+    if count == 1:
+        return "1 bottle"
+    return f"{count} bottles"
+
+
+def _verse(number):
+    if number == 0:
+        return [
+            "No more bottles of beer on the wall, no more bottles of beer.",
+            "Go to the store and buy some more, 99 bottles of beer on the wall.",
+        ]
+
+    current = _bottles(number)
+    action = "Take it down" if number == 1 else "Take one down"
+    return [
+        f"{current} of beer on the wall, {current} of beer.",
+        f"{action} and pass it around, {_bottles(number - 1)} of beer on the wall.",
+    ]
+
