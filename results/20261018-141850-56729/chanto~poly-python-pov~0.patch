@@ -18,8 +18,46 @@ class Tree:
     def __eq__(self, other):
         return self.__dict__() == other.__dict__()
 
+    def _find_path(self, label):
+        """Return the list of nodes from this node down to `label`, or None."""
+        if self.label == label:
+            return [self]
+        for child in self.children:
+            path = child._find_path(label)
+            if path is not None:
+                return [self] + path
+        return None
+
     def from_pov(self, from_node):
-        pass
+        path = self._find_path(from_node)
+        if path is None:
+            raise ValueError("Tree could not be reoriented")
+
+        def build(index):
+            node = path[index]
+            excluded = path[index + 1] if index + 1 < len(path) else None
+            children = [child for child in node.children if child is not excluded]
+            if index > 0:
+                children.append(build(index - 1))
+            return Tree(node.label, children)
+
+        return build(len(path) - 1)
 
     def path_to(self, from_node, to_node):
-        pass
+        from_path = self._find_path(from_node)
+        if from_path is None:
+            raise ValueError("Tree could not be reoriented")
+        to_path = self._find_path(to_node)
+        if to_path is None:
+            raise ValueError("No path found")
+
+        from_labels = [node.label for node in from_path]
+        to_labels = [node.label for node in to_path]
+        common = 0
+        while (
+            common < len(from_labels)
+            and common < len(to_labels)
+            and from_labels[common] == to_labels[common]
+        ):
+            common += 1
+        return from_labels[common - 1 :][::-1] + to_labels[common:]
