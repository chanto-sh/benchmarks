 func NewGarden(diagram string, children []string) (*Garden, error) {
-	panic("Please implement the NewGarden function")
+	if !strings.HasPrefix(diagram, "\n") {
+		return nil, errors.New("diagram must start with a newline")
+	}
+
+	rows := strings.Split(diagram[1:], "\n")
+	if len(rows) != 2 {
+		return nil, errors.New("diagram must have exactly two rows")
+	}
+	if len(rows[0]) == 0 || len(rows[0]) != len(rows[1]) {
+		return nil, errors.New("diagram rows must be non-empty and of equal length")
+	}
+	if len(rows[0])%2 != 0 {
+		return nil, errors.New("diagram must have an even number of cups per row")
+	}
+	if len(children) != len(rows[0])/2 {
+		return nil, errors.New("number of children does not match number of cup pairs")
+	}
+
+	for _, row := range rows {
+		for _, cup := range row {
+			if _, ok := plantNames[cup]; !ok {
+				return nil, errors.New("invalid cup code")
+			}
+		}
+	}
+
+	names := append([]string(nil), children...)
+	sort.Strings(names)
+	for i := 1; i < len(names); i++ {
+		if names[i] == names[i-1] {
+			return nil, errors.New("duplicate child name")
+		}
+	}
+
+	garden := &Garden{plants: make(map[string][]string, len(names))}
+	for i, name := range names {
+		garden.plants[name] = []string{
+			plantNames[rune(rows[0][i*2])],
+			plantNames[rune(rows[0][i*2+1])],
+			plantNames[rune(rows[1][i*2])],
+			plantNames[rune(rows[1][i*2+1])],
+		}
+	}
+	return garden, nil
 }
 
