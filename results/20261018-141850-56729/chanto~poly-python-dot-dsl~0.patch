 class Graph:
     def __init__(self, data=None):
-        pass
+        self.nodes = []
+        self.edges = []
+        self.attrs = {}
+
+        if data is None:
+            return
+
+        if not isinstance(data, list):
+            raise TypeError("Graph data malformed")
+
+        for item in data:
+            if not isinstance(item, tuple) or len(item) < 3:
+                raise TypeError("Graph item incomplete")
+
+            tag = item[0]
+
+            if tag == ATTR:
+                if len(item) != 3 or not isinstance(item[1], str) or not isinstance(item[2], str):
+                    raise ValueError("Attribute is malformed")
+                self.attrs[item[1]] = item[2]
+            elif tag == NODE:
+                if len(item) != 3 or not isinstance(item[1], str) or not isinstance(item[2], dict):
+                    raise ValueError("Node is malformed")
+                self.nodes.append(Node(item[1], item[2]))
+            elif tag == EDGE:
+                if (len(item) != 4 or not isinstance(item[1], str) or
+                        not isinstance(item[2], str) or not isinstance(item[3], dict)):
+                    raise ValueError("Edge is malformed")
+                self.edges.append(Edge(item[1], item[2], item[3]))
+            else:
+                raise ValueError("Unknown item")
