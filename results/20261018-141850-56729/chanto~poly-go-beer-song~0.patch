 }
 
+// Verses returns the lyrics from start down to stop, inclusive. Verses are
+// separated by a blank line and the result ends with a newline.
 func Verses(start, stop int) (string, error) {
-	panic("Please implement the Verses function")
+	if start < stop {
+		return "", fmt.Errorf("start %d is less than stop %d", start, stop)
+	}
+	if start > 99 || stop < 0 {
+		return "", fmt.Errorf("invalid verse range %d-%d", start, stop)
+	}
+
+	var verses []string
+	for n := start; n >= stop; n-- {
+		v, err := Verse(n)
+		if err != nil {
+			return "", err
+		}
+		verses = append(verses, v)
+	}
+	return strings.Join(verses, "\n") + "\n", nil
 }
 
+// Verse returns the lyrics for the verse with n bottles.
 func Verse(n int) (string, error) {
-	panic("Please implement the Verse function")
+	if n < 0 || n > 99 {
+		return "", fmt.Errorf("invalid verse %d", n)
+	}
+
+	switch n {
+	case 0:
+		return "No more bottles of beer on the wall, no more bottles of beer.\n" +
+			"Go to the store and buy some more, 99 bottles of beer on the wall.\n", nil
+	case 1:
+		return "1 bottle of beer on the wall, 1 bottle of beer.\n" +
+			"Take it down and pass it around, no more bottles of beer on the wall.\n", nil
+	}
+
+	return fmt.Sprintf("%d bottles of beer on the wall, %d bottles of beer.\n", n, n) +
+		fmt.Sprintf("Take one down and pass it around, %s.\n", bottles(n-1)), nil
+}
+
+// bottles renders a bottle count for use in the lyrics.
+func bottles(n int) string {
+	switch n {
+	case 0:
+		return "no more bottles of beer on the wall"
+	case 1:
+		return "1 bottle of beer on the wall"
+	default:
+		return fmt.Sprintf("%d bottles of beer on the wall", n)
+	}
 }
