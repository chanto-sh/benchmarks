 """Word frequencies for the search team's "trending terms" box."""
-import re
+from collections import Counter
+
+# After lowercasing and ASCII-encoding, turn every byte that is not an ASCII
+# letter or apostrophe into a space. Splitting then yields exactly the runs
+# that the documented [a-z']+ word rule describes.
+_WORD_BYTES = bytes(
+    byte if byte == ord("'") or ord("a") <= byte <= ord("z") else ord(" ")
+    for byte in range(256)
+)
 
 
 def top_words(text, n=10):
@@ -8,15 +16,8 @@ def top_words(text, n=10):
     Words are runs of letters and apostrophes, compared case-insensitively;
     ties go alphabetically.
     """
-    words = re.findall(r"[a-z']+", text.lower())
-    seen = []
-    counts = []
-    for w in words:
-        if w in seen:
-            counts[seen.index(w)] += 1
-        else:
-            seen.append(w)
-            counts.append(1)
-    pairs = list(zip(seen, counts))
+    data = text.lower().encode("ascii", "replace").translate(_WORD_BYTES)
+    counts = Counter(data.split())
+    pairs = [(word.decode("ascii"), count) for word, count in counts.items()]
     pairs.sort(key=lambda p: (-p[1], p[0]))
     return pairs[:n]
