+class EnvLayerTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_values_take_the_default_type(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "0.5",
+                "SHOPD__DB__SSL": "yes",
+                "SHOPD__LOG__LEVEL": "debug",
+                "SHOPD__LOG__JSON": "0",
+                "SHOPD__FEATURES": "search, billing",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"], {"level": "debug", "json": False})
+        self.assertEqual(cfg["features"], ["search", "billing"])
+
+    def test_bool_words(self):
+        for raw, expected in [
+            ("1", True),
+            ("true", True),
+            ("TRUE", True),
+            ("Yes", True),
+            ("on", True),
+            ("0", False),
+            ("false", False),
+            ("FALSE", False),
+            ("No", False),
+            ("off", False),
+        ]:
+            with self.subTest(raw=raw):
+                cfg = load(env={"SHOPD__DB__SSL": raw})
+                self.assertIs(cfg["db"]["ssl"], expected)
+
+    def test_list_values(self):
