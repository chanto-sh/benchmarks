+
+def _env_layer(env):
+    """The settings named by `SHOPD__<KEY>__<SUBKEY>...`; other variables are ignored."""
+    pairs = []
+    for key, raw in env.items():
+        if key[: len(ENV_PREFIX)].upper() != ENV_PREFIX:
+            continue
+        path = [part.lower() for part in key[len(ENV_PREFIX):].split("__")]
+        pairs.append((path, str(raw)))
+    return _layer(pairs)
+
+
+def _override_layer(overrides):
+    """The settings named by `"db.pool.size=20"` strings, later ones winning."""
+    pairs = []
+    for override in overrides:
+        key, sep, raw = override.partition("=")
+        if not sep:
+            raise ConfigError(f"{override}: expected a KEY=VALUE setting")
+        pairs.append(([part.strip() for part in key.split(".")], raw))
+    return _layer(pairs)
+
+
+def _layer(pairs):
+    """A nested dict for (path, raw value) pairs, each converted to its default's type."""
+    out = {}
+    for path, raw in pairs:
+        name = ".".join(path)
+        default = _default_for(path, name)
+        if isinstance(default, dict):
+            raise ConfigError(f"{name}: a section, not a single setting")
+        node = out
+        for part in path[:-1]:
+            node = node.setdefault(part, {})
+        node[path[-1]] = _convert(name, raw, default)
+    return out
+
+
+def _default_for(path, name):
+    node = DEFAULTS
+    for part in path:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"{name}: unknown setting")
+        node = node[part]
+    return node
+
+
+def _convert(name, raw, default):
+    """`raw` (always a string) as the type of the built-in `default`."""
+    if isinstance(default, bool):
+        try:
+            return _BOOL_WORDS[raw.strip().lower()]
+        except KeyError:
+            raise ConfigError(f"{name}: {raw!r} is not a boolean") from None
+    if isinstance(default, int):
+        try:
+            return int(raw.strip())
+        except ValueError:
+            raise ConfigError(f"{name}: {raw!r} is not an integer") from None
+    if isinstance(default, float):
+        try:
+            return float(raw.strip())
+        except ValueError:
+            raise ConfigError(f"{name}: {raw!r} is not a number") from None
+    if isinstance(default, list):
+        return [item.strip() for item in raw.split(",") if item.strip()]
+    return raw
