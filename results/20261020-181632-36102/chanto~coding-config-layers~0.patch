+def clean_env(**extra):
+    """`os.environ` without any SHOPD__ variables, plus `extra`."""
+    env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+    env.update(extra)
+    return env
+
+
+def run_cli(*args, **kwargs):
+    return subprocess.run(
+        [sys.executable, "-m", "app.config", *args],
+        cwd=HERE,
+        env=clean_env(**kwargs),
+        capture_output=True,
+        text=True,
+    )
