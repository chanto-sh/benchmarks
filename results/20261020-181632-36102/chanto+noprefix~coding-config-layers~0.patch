 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+TRUE_VALUES = frozenset(("1", "true", "yes", "on"))
+FALSE_VALUES = frozenset(("0", "false", "no", "off"))
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration: defaults, file, environment, then overrides."""
+    if env is None:
+        env = os.environ
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
     cfg = DEFAULTS
     if path:
         try:
@@ -17,4 +25,82 @@ def load(path=None):
         if not isinstance(data, dict):
             raise ConfigError(f"{path}: top level must be an object")
         cfg = deep_merge(cfg, data)
+    cfg = deep_merge(cfg, _env_settings(env))
+    cfg = deep_merge(cfg, _override_settings(overrides))
     return deep_merge(cfg, {})
+
+
+def _default_for(parts):
+    """The built-in default at the dotted path `parts`, or ConfigError."""
+    dotted = ".".join(parts)
+    node = DEFAULTS
+    for part in parts:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    return node
+
+
+def _convert(dotted, value, default):
+    if isinstance(default, bool):
+        text = str(value).strip().lower()
+        if text in TRUE_VALUES:
+            return True
+        if text in FALSE_VALUES:
+            return False
+        raise ConfigError(f"{dotted}: invalid boolean value {value!r}")
+    if isinstance(default, int):
+        try:
+            return int(value)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{dotted}: invalid integer value {value!r}") from None
+    if isinstance(default, float):
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            raise ConfigError(f"{dotted}: invalid number value {value!r}") from None
+    if isinstance(default, str):
+        return value
+    if isinstance(default, list):
+        text = str(value)
+        if not text.strip():
+            return []
+        return [item.strip() for item in text.split(",")]
+    raise ConfigError(f"{dotted}: unsupported setting type")
+
+
+def _assign(target, name, value):
+    parts = [part.lower() for part in name.split(".")]
+    dotted = ".".join(parts)
+    default = _default_for(parts)
+    if isinstance(default, dict):
+        raise ConfigError(f"{dotted}: cannot set a whole section")
+    converted = _convert(dotted, value, default)
+    node = target
+    for part in parts[:-1]:
+        node = node.setdefault(part, {})
+    node[parts[-1]] = converted
+
+
+def _env_settings(env):
+    settings = {}
+    for raw_name, value in env.items():
+        name = str(raw_name)
+        if not name.lower().startswith(ENV_PREFIX.lower()):
+            continue
+        name = name[len(ENV_PREFIX):].replace("__", ".")
+        if not name:
+            continue
+        _assign(settings, name, value)
+    return settings
+
+
+def _override_settings(overrides):
+    settings = {}
+    for override in overrides:
+        name, sep, value = override.partition("=")
+        name = name.strip()
+        if not sep or not name:
+            raise ConfigError(f"invalid override {override!r}: expected NAME=VALUE")
+        _assign(settings, name, value)
+    return settings
