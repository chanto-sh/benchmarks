 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -29,5 +31,126 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class EnvironmentLayerTest(unittest.TestCase):
+    def test_sets_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_key_names_are_case_insensitive(self):
+        cfg = load(env={"shopd__Db__PoRt": "6543"})
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_other_variables_are_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOPD_DB_PORT": "6543", "OTHER": "x"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_values_take_the_default_type(self):
+        cfg = load(env={
+            "SHOPD__DB__PORT": "6543",
+            "SHOPD__DB__POOL__TIMEOUT": "0.25",
+            "SHOPD__DB__SSL": "YES",
+            "SHOPD__LOG__LEVEL": "debug",
+            "SHOPD__FEATURES": "search, admin",
+        })
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.25)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["log"]["level"], "debug")
+        self.assertEqual(cfg["features"], ["search", "admin"])
+
+    def test_boolean_spellings(self):
+        for value in ("1", "true", "TRUE", "yes", "On"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], True)
+        for value in ("0", "false", "FALSE", "no", "Off"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": value})["db"]["ssl"], False)
+
+    def test_empty_string_is_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+
+class OverrideTest(unittest.TestCase):
+    def test_overrides_are_applied(self):
+        cfg = load(overrides=["db.pool.size=20", "features=search,admin"])
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["features"], ["search", "admin"])
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 6000, "host": "db.internal"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "7000"},
+                overrides=["db.port=8000"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 8000)
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_env_beats_file(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 6000}}, f)
+        try:
+            cfg = load(f.name, env={"SHOPD__DB__PORT": "7000"})
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 7000)
+
+
+class ConfigErrorTest(unittest.TestCase):
+    def assert_bad(self, setting, **kwargs):
+        with self.assertRaises(ConfigError) as ctx:
+            load(**kwargs)
+        self.assertIn(setting, str(ctx.exception))
+
+    def test_unknown_env_setting(self):
+        self.assert_bad("db.prot", env={"SHOPD__DB__PROT": "1"})
+
+    def test_unknown_override_setting(self):
+        self.assert_bad("db.prot", overrides=["db.prot=1"])
+
+    def test_bad_integer(self):
+        for value in ("abc", "5.5"):
+            self.assert_bad("db.port", env={"SHOPD__DB__PORT": value})
+
+    def test_bad_float(self):
+        self.assert_bad("db.pool.timeout", overrides=["db.pool.timeout=soon"])
+
+    def test_bad_boolean(self):
+        self.assert_bad("db.ssl", env={"SHOPD__DB__SSL": "maybe"})
+
+    def test_whole_section_from_env(self):
+        self.assert_bad("db", env={"SHOPD__DB": "x"})
+
+    def test_whole_section_from_override(self):
+        self.assert_bad("db", overrides=["db=x"])
+
+    def test_override_without_value(self):
+        self.assert_bad("db.port", overrides=["db.port"])
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            capture_output=True,
+            text=True,
+        )
+
+    def test_set_options_are_repeatable(self):
+        result = self.run_cli("--set", "db.port=6543", "--set", "db.ssl=yes")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        cfg = json.loads(result.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+
+    def test_bad_setting_exits_2(self):
+        result = self.run_cli("--set", "db.prot=1")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("db.prot", result.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
