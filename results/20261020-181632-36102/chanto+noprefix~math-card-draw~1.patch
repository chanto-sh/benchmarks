 from fractions import Fraction
+from math import comb, factorial
+
+
+def _perm(n, i):
+    """Number of ways to pick i distinguishable items from n in order."""
+    if i < 0 or i > n:
+        return 0
+    return factorial(n) // factorial(n - i)
 
 
