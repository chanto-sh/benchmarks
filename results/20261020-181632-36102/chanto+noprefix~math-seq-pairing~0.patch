 """Integer keys for lists of non-negative integers."""
 
+import math
+
+
+# Decode ternary in chunks so converting a large key to digits takes
+# O(bits / _CHUNK) big-integer divisions instead of one per digit.
+_CHUNK = 27
+_CHUNK_BASE = 3 ** _CHUNK
+
+
+def _ternary_digits(value, length):
+    """The base-3 digits of ``value``, padded on the left to ``length``."""
+    chunks = []
+    while value:
+        value, remainder = divmod(value, _CHUNK_BASE)
+        chunks.append(remainder)
+
+    digits = []
+    for remainder in reversed(chunks):
+        chunk = [0] * _CHUNK
+        for i in range(_CHUNK - 1, -1, -1):
+            chunk[i] = remainder % 3
+            remainder //= 3
+        digits.extend(chunk)
+
+    if len(digits) > length:
+        return digits[-length:]
+    if len(digits) < length:
+        return [0] * (length - len(digits)) + digits
+    return digits
+
 
 def encode(lst):
     """The key for a list of non-negative ints."""
-    raise NotImplementedError
+    if not lst:
+        return 0
+
+    # For each value a, use the bit length of a + 1 as its cost.  If the
+    # cost is c, its lower c - 1 bits identify it among the 2 ** (c - 1)
+    # values of that cost.  Turn those bits into base-3 digits and append
+    # a separator digit 2.  The resulting ternary string ends in 2.
+    key = 0
+    length = 0
+    powers = {}
+    for a in lst:
+        x = a + 1
+        c = x.bit_length()
+        lower = x - (1 << (c - 1))
+
+        block = 0
+        for shift in range(c - 2, -1, -1):
+            block = block * 3 + ((lower >> shift) & 1)
+
+        power = powers.get(c)
+        if power is None:
+            power = 3 ** c
+            powers[c] = power
+        key = key * power + (block * 3 + 2)
+        length += c
+
+    # Strings of length L ending in 2 are numbered after all shorter such
+    # strings, with the final 2 removed from the rank within length L.
+    prefix = (key - 2) // 3
+    return (3 ** (length - 1) + 1) // 2 + prefix
 
 
