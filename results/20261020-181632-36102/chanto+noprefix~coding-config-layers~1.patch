+        raise ConfigError(f"unknown setting: {name}")
+    if isinstance(default[leaf], dict):
+        raise ConfigError(f"{name}: cannot set a whole section, set one of its keys")
+    node[leaf] = _convert(name, raw, default[leaf])
+
+
+def _convert(name, raw, default):
+    """`raw` as the same type as the built-in `default` for setting `name`."""
