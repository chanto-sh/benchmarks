 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+TRUE_VALUES = {"1", "true", "yes", "on"}
+FALSE_VALUES = {"0", "false", "no", "off"}
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration: defaults, then the JSON file at `path` (if any),
+    then `SHOPD__...` environment variables, then `NAME=VALUE` overrides."""
     cfg = DEFAULTS
     if path:
+        cfg = deep_merge(cfg, _read_file(path))
+    cfg = deep_merge(cfg, _from_env(env))
+    return deep_merge(cfg, _from_overrides(overrides))
+
+
+def _read_file(path):
+    try:
+        with open(path) as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        raise ConfigError(f"cannot read {path}: {e}") from e
+    if not isinstance(data, dict):
+        raise ConfigError(f"{path}: top level must be an object")
+    return data
+
+
+def _from_env(env):
+    if env is None:
+        env = os.environ
+    out = {}
+    for name, raw in env.items():
+        if not name.upper().startswith(ENV_PREFIX):
+            continue
+        parts = name[len(ENV_PREFIX):].split("__")
+        if not all(parts):
+            continue
+        _assign(out, [part.lower() for part in parts], raw)
+    return out
+
+
+def _from_overrides(overrides):
+    out = {}
+    for item in overrides:
+        key, sep, raw = item.partition("=")
+        path = [part.strip().lower() for part in key.split(".")]
+        if not sep or not all(path):
+            raise ConfigError(
+                f"invalid override {item!r}: expected <setting>=<value>"
+            )
+        _assign(out, path, raw)
+    return out
+
+
+def _assign(out, path, raw):
+    """Put the converted `raw` value for the dotted `path` into `out`."""
+    name = ".".join(path)
+    default = DEFAULTS
+    node = out
+    for part in path[:-1]:
+        if not isinstance(default, dict) or part not in default:
+            raise ConfigError(f"unknown setting: {name}")
+        default = default[part]
+        node = node.setdefault(part, {})
+    leaf = path[-1]
