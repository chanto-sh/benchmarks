+class EnvTest(unittest.TestCase):
+    def test_nested_settings(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 2.5})
+
+    def test_keys_are_case_insensitive(self):
+        cfg = load(env={"shopd__DB__Host": "db.internal"})
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_other_variables_are_ignored(self):
+        cfg = load(env={"PATH": "/bin", "DB__PORT": "1", "SHOPDX__DB__PORT": "1"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_default_is_os_environ(self):
+        key = "SHOPD__LOG__LEVEL"
+        old = os.environ.get(key)
+        os.environ[key] = "debug"
+        try:
+            self.assertEqual(load()["log"]["level"], "debug")
+        finally:
+            if old is None:
+                del os.environ[key]
+            else:
+                os.environ[key] = old
+
+    def test_type_conversion(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__TIMEOUT": "0.5",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__LOG__LEVEL": "debug",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 0.5)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_bool_variants(self):
+        for raw in ("1", "true", "TRUE", "Yes", "on"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True)
+        for raw in ("0", "false", "FALSE", "No", "off"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False)
+
+    def test_list_settings(self):
+        cfg = load(env={"SHOPD__FEATURES": " search , metrics "})
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "6543"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_value(self):
+        for key, raw in (
+            ("SHOPD__DB__PORT", "abc"),
+            ("SHOPD__DB__PORT", "5.5"),
+            ("SHOPD__DB__SSL", "maybe"),
+        ):
+            with self.assertRaises(ConfigError) as cm:
+                load(env={key: raw})
+            self.assertIn(key[len("SHOPD__"):].lower().replace("__", "."), str(cm.exception))
+
+    def test_whole_section(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(cm.exception))
+
+
+class OverrideTest(unittest.TestCase):
+    def test_override(self):
+        cfg = load(env={}, overrides=["db.pool.size=20", "db.port=6543"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111}, "log": {"level": "file"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222", "SHOPD__LOG__LEVEL": "env"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 3333)
+        self.assertEqual(cfg["log"]["level"], "env")
+        self.assertEqual(cfg["db"]["host"], "localhost")
