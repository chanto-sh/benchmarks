+class CliTest(unittest.TestCase):
+    def run_cli(self, *args, env=None):
+        environ = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+        environ.update(env or {})
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            capture_output=True,
+            text=True,
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            env=environ,
+        )
+
+    def test_set_is_repeatable(self):
+        p = self.run_cli("--set", "db.port=6543", "--set", "db.pool.size=7")
+        self.assertEqual(p.returncode, 0, p.stderr)
+        cfg = json.loads(p.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 7)
+
+    def test_env_and_set(self):
+        p = self.run_cli("--set", "db.port=6543", env={"SHOPD__DB__HOST": "env", "SHOPD__DB__PORT": "1234"})
+        self.assertEqual(p.returncode, 0, p.stderr)
+        cfg = json.loads(p.stdout)
+        self.assertEqual(cfg["db"]["host"], "env")
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_error_exits_2(self):
+        for args, name in [
+            (("--set", "db.prot=1"), "db.prot"),
+            (("--set", "db.port=abc"), "db.port"),
+            (("--set", "db=x"), "db"),
+            (("--file", "/nonexistent/config.json"), "/nonexistent/config.json"),
+        ]:
+            with self.subTest(args=args):
+                p = self.run_cli(*args)
+                self.assertEqual(p.returncode, 2)
+                self.assertIn(name, p.stderr)
+
+    def test_error_from_env_exits_2(self):
+        p = self.run_cli(env={"SHOPD__DB__SSL": "maybe"})
+        self.assertEqual(p.returncode, 2)
+        self.assertIn("db.ssl", p.stderr)
+
+
 if __name__ == "__main__":
     unittest.main()
