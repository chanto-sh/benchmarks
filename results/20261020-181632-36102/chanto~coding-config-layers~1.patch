+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError as e:
+            raise ConfigError(f"{dotted}: {raw!r} is not an int") from e
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError as e:
+            raise ConfigError(f"{dotted}: {raw!r} is not a float") from e
+    if isinstance(default, str):
