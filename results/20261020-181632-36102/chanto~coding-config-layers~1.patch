 import json
 import os
+import subprocess
+import sys
 import tempfile
 import unittest
 
@@ -29,5 +31,178 @@ class ConfigTest(unittest.TestCase):
             load("/nonexistent/config.json")
 
 
+class EnvironmentTest(unittest.TestCase):
+    def test_nested_setting(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_keys_are_case_insensitive(self):
+        cfg = load(env={"SHOPD__Db__Host": "db.internal", "shopd__db__port": "6000"})
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+        self.assertEqual(cfg["db"]["port"], 6000)
+
+    def test_other_variables_are_ignored(self):
+        cfg = load(env={"HOME": "/root", "SHOPD": "x", "DB__PORT": "1", "db.port": "1"})
+        self.assertEqual(cfg, load(env={}))
+
+    def test_types_follow_the_defaults(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__PORT": "6000",
+                "SHOPD__DB__POOL__TIMEOUT": "3",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__LOG__LEVEL": "DEBUG",
+                "SHOPD__FEATURES": " search , metrics ",
+            }
+        )
+        self.assertEqual(cfg["db"]["port"], 6000)
+        self.assertIsInstance(cfg["db"]["port"], int)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.0)
+        self.assertIsInstance(cfg["db"]["pool"]["timeout"], float)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["log"]["level"], "DEBUG")
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+
+    def test_bool_spellings(self):
+        for raw, expected in [
+            ("1", True), ("true", True), ("TRUE", True), ("Yes", True), ("on", True),
+            ("0", False), ("false", False), ("FALSE", False), ("No", False), ("off", False),
+        ]:
+            with self.subTest(raw=raw):
+                self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], expected)
+
+    def test_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_environment_is_the_default(self):
+        old = os.environ.get("SHOPD__DB__HOST")
+        os.environ["SHOPD__DB__HOST"] = "from-environ"
+        try:
+            self.assertEqual(load(env={})["db"]["host"], "localhost")
+            self.assertEqual(load()["db"]["host"], "from-environ")
+        finally:
+            if old is None:
+                del os.environ["SHOPD__DB__HOST"]
+            else:
+                os.environ["SHOPD__DB__HOST"] = old
+
+
+class OverridesTest(unittest.TestCase):
+    def test_override(self):
+        cfg = load(env={}, overrides=["db.port=6543"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_override_types(self):
+        cfg = load(env={}, overrides=["db.pool.size=9", "db.ssl=on", "features=a,b"])
+        self.assertEqual(cfg["db"]["pool"]["size"], 9)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["a", "b"])
+
+    def test_value_may_contain_equals(self):
+        self.assertEqual(load(env={}, overrides=["name=a=b"])["name"], "a=b")
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"host": "file", "port": 1111}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__HOST": "env", "SHOPD__DB__PORT": "2222"},
+                overrides=["db.port=3333"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["host"], "env")
+        self.assertEqual(cfg["db"]["port"], 3333)
+
+    def test_bad_override_syntax(self):
+        with self.assertRaises(ConfigError):
+            load(env={}, overrides=["db.port"])
+
+
+class ErrorTest(unittest.TestCase):
+    def assert_config_error(self, name, **kwargs):
+        with self.assertRaises(ConfigError) as ctx:
+            load(**kwargs)
+        self.assertIn(name, str(ctx.exception))
+
+    def test_unknown_setting_from_env(self):
+        self.assert_config_error("db.prot", env={"SHOPD__DB__PROT": "1234"})
+
+    def test_unknown_setting_from_override(self):
+        self.assert_config_error("db.prot", env={}, overrides=["db.prot=1234"])
+
+    def test_unknown_top_level_setting(self):
+        self.assert_config_error("nope", env={}, overrides=["nope=1"])
+
+    def test_bad_int(self):
+        self.assert_config_error("db.port", env={"SHOPD__DB__PORT": "abc"})
+
+    def test_float_for_int(self):
+        self.assert_config_error("db.port", env={"SHOPD__DB__PORT": "5.5"})
+
+    def test_bad_float(self):
+        self.assert_config_error("db.pool.timeout", env={"SHOPD__DB__POOL__TIMEOUT": "soon"})
+
+    def test_bad_bool(self):
+        self.assert_config_error("db.ssl", env={"SHOPD__DB__SSL": "maybe"})
+
+    def test_section(self):
+        self.assert_config_error("db", env={"SHOPD__DB": "x"})
+
+    def test_section_override(self):
+        self.assert_config_error("db", env={}, overrides=["db=x"])
+
+    def test_leaf_is_not_a_section(self):
+        self.assert_config_error("db.port", env={"SHOPD__DB__PORT__X": "1"})
+
