 from fractions import Fraction
+from math import comb
 
 
 def p_at_least(r, b, g, k, m):
@@ -6,4 +7,33 @@ def p_at_least(r, b, g, k, m):
 
     The deal stops at the first green card or after m cards, whichever is first.
     """
-    raise NotImplementedError
+    if k <= 0:
+        return Fraction(1)
+
+    n = r + b + g
+    if k > r or m <= 0 or n == 0:
+        return Fraction(0)
+
+    m = min(m, n)
+    total = Fraction(0)
+
+    # The dealer stops on a green card at position t = j + i + 1 <= m,
+    # after seeing exactly j reds and i blues.
+    for j in range(k, r + 1):
+        if j >= m:
+            break
+        prefix_orderings = comb(r, j)
+        for i in range(b + 1):
+            t = j + i + 1
+            if t > m:
+                break
+            p_prefix = Fraction(prefix_orderings * comb(b, i), comb(n, t - 1))
+            total += p_prefix * Fraction(g, n - (t - 1))
+
+    # No green card in the first m positions: all m cards are red or blue.
+    for j in range(k, min(r, m) + 1):
+        i = m - j
+        if 0 <= i <= b:
+            total += Fraction(comb(r, j) * comb(b, i), comb(n, m))
+
+    return total
