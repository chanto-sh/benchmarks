 // Ability uses randomness to generate the score for an ability
 func Ability() int {
-	panic("Please implement the Ability() function")
+	// Roll four six-sided dice and sum the highest three.
+	total := 0
+	lowest := 7
+
+	rngMu.Lock()
+	for i := 0; i < 4; i++ {
+		roll := rng.Intn(6) + 1
+		total += roll
+		if roll < lowest {
+			lowest = roll
+		}
+	}
+	rngMu.Unlock()
+
+	return total - lowest
 }
 
