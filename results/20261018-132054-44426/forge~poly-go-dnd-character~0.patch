 // Modifier calculates the ability modifier for a given ability score
 func Modifier(score int) int {
-	panic("Please implement the Modifier() function")
+	difference := score - 10
+
+	// Go's integer division truncates towards zero, but the rules require
+	// rounding down, so negative odd differences need to be adjusted.
+	if difference < 0 && difference%2 != 0 {
+		return difference/2 - 1
+	}
+
+	return difference / 2
