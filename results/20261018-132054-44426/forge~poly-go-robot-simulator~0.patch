+}
+
 func StartRobot3(name, script string, action chan Action3, log chan string) {
-	panic("Please implement the StartRobot3 function")
+	// Always announce shutdown, even when the robot stops early.
+	defer func() { action <- Action3{Name: name} }()
+
+	if name == "" {
+		// The room is responsible for reporting unnamed robots.
+		return
+	}
+	for i := 0; i < len(script); i++ {
+		c := script[i]
+		switch c {
+		case 'R', 'L', 'A':
+			action <- Action3{Name: name, Command: Command(c)}
+		default:
+			log <- fmt.Sprintf("robot %q: undefined command %q", name, c)
+			return
+		}
+	}
 }
 
 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	// index maps every robot name seen at setup to its slot in robots,
+	// including names that were rejected.  valid marks the robots that
+	// actually take part in the simulation.
+	index := make(map[string]int, len(robots))
+	valid := make([]bool, len(robots))
+	occupied := make(map[Pos]string, len(robots))
+
+	for i, r := range robots {
+		if r.Name == "" {
+			log <- "robot without a name"
+			continue
+		}
+		if _, dup := index[r.Name]; dup {
+			log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+			continue
