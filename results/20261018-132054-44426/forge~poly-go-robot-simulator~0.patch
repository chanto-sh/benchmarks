 func (d Dir) String() string {
-	panic("Please implement the String function")
+	switch d {
+	case N:
+		return "north"
+	case E:
+		return "east"
+	case S:
+		return "south"
+	case W:
+		return "west"
+	}
+	return fmt.Sprintf("Dir(%d)", int(d))
+}
+
+// turnRight and turnLeft are shared by the room implementations.
+func turnRight(d Dir) Dir { return (d + 1) % 4 }
+func turnLeft(d Dir) Dir  { return (d + 3) % 4 }
+
+// advance returns the position one step in direction d and whether that
+// position is still inside extent.
+func advance(p Pos, d Dir, extent Rect) (Pos, bool) {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	if p.Easting < extent.Min.Easting || p.Easting > extent.Max.Easting ||
+		p.Northing < extent.Min.Northing || p.Northing > extent.Max.Northing {
+		return p, false
+	}
+	return p, true
 }
 
