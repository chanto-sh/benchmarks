+		case 'L':
+			r.Dir = turnLeft(r.Dir)
+		case 'A':
+			p, ok := advance(r.Pos, r.Dir, extent)
+			if !ok {
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", r.Name)
+				continue
