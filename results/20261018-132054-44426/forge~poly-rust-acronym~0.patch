 pub fn abbreviate(phrase: &str) -> String {
-    todo!("Given the phrase '{phrase}', return its acronym");
+    // Hyphens act as word separators; all other non-alphanumeric characters
+    // (apostrophes, underscores, commas, ...) are simply dropped.
+    let cleaned: Vec<char> = phrase
+        .chars()
+        .map(|c| if c == '-' { ' ' } else { c })
+        .filter(|c| c.is_alphanumeric() || c.is_whitespace())
+        .collect();
+
+    let mut acronym = String::new();
+    let mut previous: Option<char> = None;
+
+    for &current in &cleaned {
+        if current.is_alphanumeric() {
+            let starts_word = match previous {
+                // Beginning of the phrase.
+                None => true,
+                // Previous character was a separator (whitespace), or this is a
+                // camelCase hump following a lowercase letter.
+                Some(prev) => !prev.is_alphanumeric() || (current.is_uppercase() && prev.is_lowercase()),
+            };
+
+            if starts_word {
+                acronym.extend(current.to_uppercase());
+            }
+        }
+
+        previous = Some(current);
+    }
+
+    acronym
 }
