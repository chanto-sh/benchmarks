 func Permanent(err error) error { return &permanent{err} }
 
+// maxDelay is the largest representable time.Duration, used in place of Max
+// when no cap was configured.
+const maxDelay = time.Duration(1<<63 - 1)
+
 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if d <= 0 {
+		return nil
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
+
+// delayBefore reports the delay that precedes call n+1: Base*2^(n-1), capped
+// at Max. n must be at least 1. The doubling saturates rather than overflowing.
+func delayBefore(base, max time.Duration, n int) time.Duration {
+	if base <= 0 {
+		return 0
+	}
+	if max <= 0 {
+		max = maxDelay
+	}
+	d := base
+	if d >= max {
+		return max
+	}
+	for i := 1; i < n; i++ {
+		if d > max/2 {
+			return max
+		}
+		d *= 2
+	}
+	return d
 }
 
