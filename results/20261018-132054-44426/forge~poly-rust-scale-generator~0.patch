+/// Convert a note name into its pitch class (0 = C).
+fn note_pitch(note: &str) -> Option<usize> {
+    let mut chars = note.chars();
+    let mut semitone = match chars.next()?.to_ascii_uppercase() {
+        'C' => 0,
+        'D' => 2,
+        'E' => 4,
+        'F' => 5,
+        'G' => 7,
+        'A' => 9,
+        'B' => 11,
+        _ => return None,
+    };
+
+    for accidental in chars {
+        match accidental {
+            '#' | '\u{266F}' => semitone += 1,
+            'b' | '\u{266D}' => semitone += 11,
+            _ => return None,
+        }
+    }
+
+    Some(semitone % 12)
+}
