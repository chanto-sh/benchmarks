+/// Decide whether a tonic is notated with flats.
+///
+/// An upper-case tonic is treated as a major key, a lower-case tonic as a
+/// minor key.
+fn uses_flats(tonic: &str) -> bool {
+    let trimmed = tonic.trim();
+    let is_minor = trimmed
+        .chars()
+        .next()
+        .map(|c| c.is_lowercase())
+        .unwrap_or(false);
+
+    let flat_set: &[&str] = if is_minor {
+        &FLAT_MINOR_TONICS
+    } else {
+        &FLAT_MAJOR_TONICS
+    };
+
+    let tonic = canonical(trimmed);
+    flat_set
+        .iter()
+        .any(|candidate| canonical(candidate) == tonic)
+}
