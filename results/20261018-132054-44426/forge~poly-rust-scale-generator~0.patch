+/// Split a tonic such as `"f#"`, `"bb"` or `"C"` into its pitch class and
+/// its properly capitalised spelling.
+fn parse_tonic(tonic: &str) -> Result<(usize, String), Error> {
+    let trimmed = tonic.trim();
+    if trimmed.is_empty() {
+        return Err(Error::new("tonic must not be empty"));
+    }
+
+    let pitch =
+        note_pitch(trimmed).ok_or_else(|| Error::new(format!("invalid tonic note: {trimmed}")))?;
+
+    let mut chars = trimmed.chars();
+    let letter = chars.next().expect("tonic is non-empty");
+    let name = format!("{}{}", letter.to_ascii_uppercase(), chars.as_str());
+
+    Ok((pitch, name))
+}
