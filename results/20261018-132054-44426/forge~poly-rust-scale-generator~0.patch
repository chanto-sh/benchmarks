+/// Capitalise the first letter of a tonic while keeping its accidentals.
+fn canonical(tonic: &str) -> String {
+    let mut chars = tonic.chars();
+    match chars.next() {
+        Some(letter) => format!("{}{}", letter.to_ascii_uppercase(), chars.as_str()),
+        None => String::new(),
+    }
+}
