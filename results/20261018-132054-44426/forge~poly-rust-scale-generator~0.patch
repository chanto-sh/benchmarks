+/// Translate an interval pattern into a list of half-step increments.
+fn parse_intervals(intervals: &str) -> Result<Vec<usize>, Error> {
+    if intervals.is_empty() {
+        return Err(Error::new("interval pattern must not be empty"));
+    }
+
+    intervals
+        .chars()
+        .map(|interval| match interval {
+            'm' => Ok(1),
+            'M' => Ok(2),
+            'A' => Ok(3),
+            other => Err(Error::new(format!("invalid interval: {other}"))),
+        })
+        .collect()
+}
