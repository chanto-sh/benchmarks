 """Word frequencies for the search team's "trending terms" box."""
+import heapq
 import re
+from collections import Counter
+
+# Compiled once: recompiling the pattern on every call is pure overhead.
+_WORD_RE = re.compile(r"[a-z']+")
 
 
 def top_words(text, n=10):
@@ -8,15 +13,8 @@ def top_words(text, n=10):
     Words are runs of letters and apostrophes, compared case-insensitively;
     ties go alphabetically.
     """
-    words = re.findall(r"[a-z']+", text.lower())
-    seen = []
-    counts = []
-    for w in words:
-        if w in seen:
-            counts[seen.index(w)] += 1
-        else:
-            seen.append(w)
-            counts.append(1)
-    pairs = list(zip(seen, counts))
-    pairs.sort(key=lambda p: (-p[1], p[0]))
-    return pairs[:n]
+    # A single hash-based pass: the previous version scanned a list of every
+    # distinct word for each token, making it O(tokens * vocabulary).
+    counts = Counter(_WORD_RE.findall(text.lower()))
+    # nsmallest is O(vocabulary * log n) instead of sorting the whole table.
+    return heapq.nsmallest(n, counts.items(), key=lambda p: (-p[1], p[0]))
