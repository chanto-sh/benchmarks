+    def test_rejects_non_positive_amounts(self):
+        for amount in (0, -5):
+            with self.subTest(amount=amount):
+                b = Book({"a": 10, "b": 0})
+                with self.assertRaises(InvalidAmount):
+                    b.transfer("a", "b", amount)
+                self.assertEqual((b.balance("a"), b.balance("b")), (10, 0))
+
+    def test_rejects_self_transfer(self):
+        b = Book({"a": 10})
+        with self.assertRaises(SelfTransfer):
+            b.transfer("a", "a", 5)
+        self.assertEqual(b.balance("a"), 10)
+
+    def test_rejections_are_ledger_errors(self):
+        self.assertTrue(issubclass(InvalidAmount, LedgerError))
+        self.assertTrue(issubclass(SelfTransfer, LedgerError))
+
 
 if __name__ == "__main__":
     unittest.main()
