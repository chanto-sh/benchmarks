+#[derive(Clone, Copy)]
+enum Op {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Pow(u32),
+}
+
 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let command = command.trim();
+    let body = command.strip_suffix('?')?.strip_prefix("What is")?.trim();
+    let tokens: Vec<&str> = body.split_whitespace().collect();
+
+    let mut index = 0;
+    let mut result = parse_number(tokens.get(index)?)?;
+    index += 1;
+
+    while index < tokens.len() {
+        let op = parse_operator(&tokens, &mut index)?;
+
+        // The exponent is part of the operator itself ("raised to the Nth power"),
+        // so it applies directly to the accumulated result and takes no operand.
+        if let Op::Pow(exp) = op {
+            result = result.checked_pow(exp)?;
+            continue;
+        }
+
+        let rhs = parse_number(tokens.get(index)?)?;
+        index += 1;
+
+        result = match op {
+            Op::Add => result.checked_add(rhs)?,
+            Op::Sub => result.checked_sub(rhs)?,
+            Op::Mul => result.checked_mul(rhs)?,
+            Op::Div => result.checked_div(rhs)?,
+            Op::Pow(_) => unreachable!(),
+        };
+    }
+
+    Some(result)
+}
+
+fn parse_number(token: &str) -> Option<i32> {
+    token.parse().ok()
+}
+
+fn parse_operator(tokens: &[&str], index: &mut usize) -> Option<Op> {
+    let word = *tokens.get(*index)?;
+
+    let op = match word {
+        "plus" => {
+            *index += 1;
+            Op::Add
+        }
+        "minus" => {
+            *index += 1;
+            Op::Sub
+        }
+        "multiplied" => {
+            if *tokens.get(*index + 1)? != "by" {
+                return None;
+            }
+            *index += 2;
+            Op::Mul
+        }
+        "divided" => {
+            if *tokens.get(*index + 1)? != "by" {
+                return None;
+            }
+            *index += 2;
+            Op::Div
+        }
+        "raised" => {
+            #[cfg(feature = "exponentials")]
+            {
+                if *tokens.get(*index + 1)? != "to" || *tokens.get(*index + 2)? != "the" {
+                    return None;
+                }
+                let exp = parse_ordinal(tokens.get(*index + 3)?)?;
+                if *tokens.get(*index + 4)? != "power" {
+                    return None;
+                }
+                *index += 5;
+                Op::Pow(exp)
+            }
+            #[cfg(not(feature = "exponentials"))]
+            {
+                return None;
+            }
+        }
+        _ => return None,
+    };
+
+    Some(op)
+}
+
+#[cfg(feature = "exponentials")]
+fn parse_ordinal(token: &str) -> Option<u32> {
+    let digits = ["th", "st", "nd", "rd"]
+        .iter()
+        .find_map(|suffix| token.strip_suffix(suffix))
+        .unwrap_or(token);
+
+    let value: i32 = digits.parse().ok()?;
+    u32::try_from(value).ok()
 }
