+	// Hierholzer's algorithm, producing the vertex circuit in reverse order.
+	start := input[0][0]
+	stack := []int{start}
+	reversed := make([]int, 0, len(input)+1)
+	for len(stack) > 0 {
+		v := stack[len(stack)-1]
+		advanced := false
+
+		for next[v] < len(adj[v]) {
+			e := adj[v][next[v]]
+			next[v]++
+			if used[e.id] {
+				continue
+			}
+			used[e.id] = true
+			stack = append(stack, e.to)
+			advanced = true
+			break
+		}
