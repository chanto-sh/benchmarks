@@ -1,6 +1,61 @@
 MOD = 1_000_000_007
 
+# State (a, c) is stored at index 3 * a + c, where:
+#   a = 1 if the last letter is A, else 0
+#   c = number of C's so far, modulo 3
+_STATE_COUNT = 6
+
+
+def _build_transition():
+    matrix = [[0] * _STATE_COUNT for _ in range(_STATE_COUNT)]
+    for c in range(3):
+        next_c = (c + 1) % 3
+
+        # Last letter is not A: append B, C or A.
+        not_a = c
+        matrix[not_a][not_a] += 1          # B
+        matrix[not_a][next_c] += 1         # C
+        matrix[not_a][3 + c] += 1          # A
+
+        # Last letter is A: appending another A is forbidden.
+        is_a = 3 + c
+        matrix[is_a][not_a] += 1           # B
+        matrix[is_a][next_c] += 1          # C
+    return matrix
+
+
+def _mat_mul(left, right):
+    size = len(left)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        result_row = result[i]
+        for k in range(size):
+            value = left[i][k]
+            if value:
+                right_row = right[k]
+                for j in range(size):
+                    result_row[j] = (
+                        result_row[j] + value * right_row[j]
+                    ) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    size = len(matrix)
+    result = [[int(i == j) for j in range(size)] for i in range(size)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("code length must be non-negative")
+
+    powered = _mat_pow(_build_transition(), n)
+    # Start in state (a=0, c=0); accept states with c == 0.
+    return (powered[0][0] + powered[0][3]) % MOD
