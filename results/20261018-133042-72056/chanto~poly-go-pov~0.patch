 // POV problem-specific functions
 
+// pathToNode returns the nodes on the path from the receiver down to the node
+// with the given value, including both endpoints, or nil if no such node
+// exists in the tree.
+func (tr *Tree) pathToNode(target string) []*Tree {
+	if tr == nil {
+		return nil
+	}
+	if tr.value == target {
+		return []*Tree{tr}
+	}
+	for _, ch := range tr.children {
+		if path := ch.pathToNode(target); path != nil {
+			return append([]*Tree{tr}, path...)
+		}
+	}
+	return nil
+}
+
 // FromPov returns the pov from the node specified in the argument.
 func (tr *Tree) FromPov(from string) *Tree {
-	panic("Please implement this function")
+	path := tr.pathToNode(from)
+	if path == nil {
+		return nil
+	}
+
+	// The target keeps all of its children and gains its former parent as a
+	// child. Working back up the path, every ancestor keeps its off-path
+	// children and is attached below the node that was its child.
+	root := path[len(path)-1]
+	rerooted := &Tree{value: root.value, children: append([]*Tree(nil), root.children...)}
+	current := rerooted
+	for i := len(path) - 2; i >= 0; i-- {
+		node := path[i]
+		children := make([]*Tree, 0, len(node.children))
+		for _, ch := range node.children {
+			if ch == path[i+1] {
+				continue
+			}
+			children = append(children, ch)
+		}
+		ancestor := &Tree{value: node.value, children: children}
+		current.children = append(current.children, ancestor)
+		current = ancestor
+	}
+	return rerooted
 }
 
 // PathTo returns the shortest path between two nodes in the tree.
 func (tr *Tree) PathTo(from, to string) []string {
-	panic("Please implement this function")
+	fromPath := tr.pathToNode(from)
+	toPath := tr.pathToNode(to)
+	if fromPath == nil || toPath == nil {
+		return nil
+	}
+
+	// Skip the common prefix; the last common node is the lowest common
+	// ancestor, so the path goes up to it and then down to the target.
+	common := 0
+	for common < len(fromPath) && common < len(toPath) && fromPath[common] == toPath[common] {
+		common++
+	}
+
+	path := make([]string, 0, len(fromPath)-common+1+len(toPath)-common)
+	for i := len(fromPath) - 1; i >= common-1; i-- {
+		path = append(path, fromPath[i].value)
+	}
+	for i := common; i < len(toPath); i++ {
+		path = append(path, toPath[i].value)
+	}
+	return path
