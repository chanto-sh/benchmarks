@@ -1,2 +1,11 @@
-def proverb():
-    pass
+def proverb(*pieces, qualifier=None):
+    if not pieces:
+        return []
+
+    verses = [
+        f"For want of a {first} the {second} was lost."
+        for first, second in zip(pieces, pieces[1:])
+    ]
+    qualifier = f"{qualifier} " if qualifier else ""
+    verses.append(f"And all for the want of a {qualifier}{pieces[0]}.")
+    return verses
