+def _is_ignored_path_re(
+    element: str, ignore_list_paths_re: list[Pattern[str]]
+) -> bool:
+    """Determines if the path is matched in a regex path ignore-list.
+
+    The path is matched both as provided (normalized), relative to the current
+    working directory, and with Posix or Windows separators. This makes patterns
+    such as ``^src/gen/.*$`` work regardless of the separators used by the
+    operating system or of whether an absolute path was passed on the command
+    line.
+    """
+    element = os.path.normpath(element)
+    candidates = {
+        element,
+        element.replace(os.sep, "/"),
+        element.replace("/", "\\"),
+    }
+    if os.path.isabs(element):
+        try:
+            relative_element = os.path.relpath(
+                os.path.realpath(element), os.path.realpath(os.getcwd())
+            )
+        except ValueError:
+            # The path is on a different drive than the current directory.
+            pass
+        else:
+            candidates.update(
+                {
+                    relative_element,
+                    relative_element.replace(os.sep, "/"),
+                    relative_element.replace("/", "\\"),
+                }
+            )
+    return any(
+        file_pattern.match(candidate)
+        for file_pattern in ignore_list_paths_re
+        for candidate in candidates
+    )
+
+
 def _is_ignored_file(
     element: str,
     ignore_list: list[str],
     ignore_list_re: list[Pattern[str]],
     ignore_list_paths_re: list[Pattern[str]],
 ) -> bool:
+    element = os.path.normpath(element)
     basename = os.path.basename(element)
     return (
         basename in ignore_list
         or _is_in_ignore_list_re(basename, ignore_list_re)
-        or _is_in_ignore_list_re(element, ignore_list_paths_re)
+        or _is_ignored_path_re(element, ignore_list_paths_re)
     )
 
 
