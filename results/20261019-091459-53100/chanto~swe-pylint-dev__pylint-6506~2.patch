diff --git a/pylint/config/exceptions.py b/pylint/config/exceptions.py
index 74a001c..0974ee2 100644
--- a/pylint/config/exceptions.py
+++ b/pylint/config/exceptions.py
@@ -11,8 +11,12 @@ class UnrecognizedArgumentAction(Exception):
     """
 
 
-class _UnrecognizedOptionError(Exception):
-    """Raised if an ArgumentManager instance tries to parse an option that is unknown."""
+class _UnrecognizedOptionError(SystemExit):
+    """Raised if an ArgumentManager instance tries to parse an option that is unknown.
+
+    Inherits from SystemExit so that an unrecognized command line option results in
+    a graceful exit with a usage message instead of an unhandled traceback.
+    """
 
     def __init__(self, options: list[str], *args: object) -> None:
         self.options = options
