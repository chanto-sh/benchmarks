 }
 
 func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
-	panic("Please implement the CreateCompute2 function")
+	c := &cell{
+		deps:    []Cell{dep1, dep2},
+		compute: func() int { return compute(dep1.Value(), dep2.Value()) },
+	}
+	c.value = c.compute()
+	link(dep1, c)
+	link(dep2, c)
+	return c
+}
+
+// link registers dependent as a dependent of dep when dep is managed by this
+// package's cell implementation.
+func link(dep Cell, dependent *cell) {
+	if d, ok := dep.(*cell); ok {
+		d.dependents = append(d.dependents, dependent)
+	}
+}
+
+// propagate recomputes every cell reachable from c in dependency order and
+// then fires callbacks for compute cells whose values actually changed.
+func (c *cell) propagate() {
+	// Collect all cells reachable through dependents (c itself included).
+	affected := make(map[*cell]bool)
+	var order []*cell
+	var collect func(x *cell)
+	collect = func(x *cell) {
+		if affected[x] {
+			return
+		}
+		affected[x] = true
+		order = append(order, x)
+		for _, d := range x.dependents {
+			collect(d)
+		}
+	}
+	collect(c)
+
+	// Kahn's algorithm over the subgraph of affected cells: a cell may be
+	// processed once all of its affected dependencies have been processed.
+	indegree := make(map[*cell]int, len(order))
+	for _, x := range order {
+		n := 0
+		for _, dep := range x.deps {
+			if d, ok := dep.(*cell); ok && affected[d] {
+				n++
+			}
+		}
+		indegree[x] = n
+	}
+
+	changed := map[*cell]bool{c: true}
+	queue := make([]*cell, 0, len(order))
+	for _, x := range order {
+		if indegree[x] == 0 {
+			queue = append(queue, x)
+		}
+	}
+
+	var toNotify []*cell
+	for len(queue) > 0 {
+		x := queue[0]
+		queue = queue[1:]
+
+		if x != c {
+			// Only recompute when at least one dependency changed, so the
+			// compute function is not called needlessly.
+			depChanged := false
+			for _, dep := range x.deps {
+				if d, ok := dep.(*cell); ok && changed[d] {
+					depChanged = true
+					break
+				}
+			}
+			if depChanged {
+				if v := x.compute(); v != x.value {
+					x.value = v
+					changed[x] = true
+				}
+			}
+		}
+
+		if changed[x] && len(x.callbacks) > 0 {
+			toNotify = append(toNotify, x)
+		}
+
+		for _, d := range x.dependents {
+			if !affected[d] {
+				continue
+			}
+			indegree[d]--
+			if indegree[d] == 0 {
+				queue = append(queue, d)
+			}
+		}
+	}
+
+	// The system is now stable; notify observers.
+	for _, x := range toNotify {
+		value := x.value
+		entries := make([]*callbackEntry, len(x.callbacks))
+		copy(entries, x.callbacks)
+		for _, e := range entries {
+			if !e.removed {
+				e.fn(value)
+			}
+		}
+	}
 }
