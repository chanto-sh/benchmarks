 // Define reactor, cell and canceler types here.
 // These types will implement the Reactor, Cell and Canceler interfaces, respectively.
 
+// reactor is the owner of a set of linked cells.
+type reactor struct{}
+
+// cell is used for both input cells and compute cells. An input cell has a
+// nil compute function; a compute cell derives its value from its
+// dependencies.
+type cell struct {
+	value      int
+	deps       []Cell
+	compute    func() int
+	dependents []*cell
+	callbacks  []*callbackEntry
+}
+
+// callbackEntry tracks a registered callback so that it can be canceled.
+type callbackEntry struct {
+	fn      func(int)
+	removed bool
+	owner   *cell
+}
+
+// canceler removes a previously registered callback.
+type canceler struct {
+	entry *callbackEntry
+}
+
 func (c *canceler) Cancel() {
-	panic("Please implement the Cancel function")
+	if c.entry == nil || c.entry.removed {
+		return
+	}
+	c.entry.removed = true
+	owner := c.entry.owner
+	for i, e := range owner.callbacks {
+		if e == c.entry {
+			owner.callbacks = append(owner.callbacks[:i], owner.callbacks[i+1:]...)
+			break
+		}
+	}
 }
 
 func (c *cell) Value() int {
-	panic("Please implement the Value function")
+	return c.value
 }
 
 func (c *cell) SetValue(value int) {
-	panic("Please implement the SetValue function")
+	if c.value == value {
+		return
+	}
+	c.value = value
+	c.propagate()
 }
 
 func (c *cell) AddCallback(callback func(int)) Canceler {
-	panic("Please implement the AddCallback function")
+	entry := &callbackEntry{fn: callback, owner: c}
+	c.callbacks = append(c.callbacks, entry)
+	return &canceler{entry: entry}
 }
 
