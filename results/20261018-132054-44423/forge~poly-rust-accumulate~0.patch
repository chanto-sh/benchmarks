+/// Apply `function` to every element of `input`, returning the results in a
+/// new collection.
+///
+/// The implementation is deliberately hand-rolled instead of delegating to
+/// `Iterator::map` and `collect`, as required by the exercise restrictions.
+pub fn map<T, U, F>(input: Vec<T>, mut function: F) -> Vec<U>
+where
+    F: FnMut(T) -> U,
+{
+    let mut output = Vec::with_capacity(input.len());
+    for item in input {
+        output.push(function(item));
+    }
+    output
 }
