+"""Tests for text_utils.slugify."""
+
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyDocstringExamplesTest(unittest.TestCase):
+    def test_basic_sentence(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+
+    def test_accents_are_folded_to_ascii(self):
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+
+    def test_runs_of_separators_collapse(self):
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+
+    def test_truncates_on_hyphen_boundary(self):
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+
+    def test_no_alphanumeric_returns_empty(self):
+        self.assertEqual(slugify("!!!"), "")
+
+
+class SlugifyEdgeCaseTest(unittest.TestCase):
+    def test_empty_string(self):
+        self.assertEqual(slugify(""), "")
+
+    def test_whitespace_only(self):
+        self.assertEqual(slugify("   \t\n "), "")
+
+    def test_already_a_slug(self):
+        self.assertEqual(slugify("already-a-slug"), "already-a-slug")
+
+    def test_uppercase_and_digits(self):
+        self.assertEqual(slugify("Python 3.12 Release"), "python-3-12-release")
+
+    def test_leading_and_trailing_punctuation(self):
+        self.assertEqual(slugify("--Hello!!"), "hello")
+
+    def test_multiple_accented_characters(self):
+        self.assertEqual(slugify("ÁÉÍÓÚ ñ ü"), "aeiou-n-u")
+
+    def test_underscores_and_slashes_are_separators(self):
+        self.assertEqual(slugify("path/to_file"), "path-to-file")
+
+    def test_no_max_length_keeps_full_slug(self):
+        slug = "the-quick-brown-fox-jumps-over-the-lazy-dog"
+        self.assertEqual(slugify("The quick brown fox jumps over the lazy dog"), slug)
+
+    def test_max_length_zero_returns_empty(self):
+        self.assertEqual(slugify("Hello World", max_length=0), "")
+
+    def test_negative_max_length_returns_empty(self):
+        self.assertEqual(slugify("Hello World", max_length=-5), "")
+
+    def test_max_length_longer_than_slug_is_noop(self):
+        self.assertEqual(slugify("Hello World", max_length=99), "hello-world")
+
+    def test_max_length_exactly_at_hyphen_boundary(self):
+        self.assertEqual(slugify("the quick brown", max_length=9), "the-quick")
+
+    def test_max_length_without_hyphen_boundary_hard_truncates(self):
+        self.assertEqual(slugify("abcdefghij", max_length=4), "abcd")
+
+    def test_max_length_never_leaves_trailing_hyphen(self):
+        # "hello world" -> "hello-world": a cut at 6 would land on the hyphen.
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+
+    def test_max_length_one(self):
+        self.assertEqual(slugify("Hello World", max_length=1), "h")
+
+    def test_result_never_exceeds_max_length(self):
+        text = "The quick brown fox jumps over the lazy dog"
+        slug = slugify(text, max_length=20)
+        self.assertLessEqual(len(slug), 20)
+        self.assertFalse(slug.endswith("-"))
+        self.assertFalse(slug.startswith("-"))
+
+    def test_non_latin_runs_become_separators(self):
+        self.assertEqual(slugify("a日本語b"), "a-b")
+
+    def test_repeated_calls_are_stable(self):
+        text = "  Crème Brûlée -- 2024!! "
+        self.assertEqual(slugify(text), slugify(text))
+
+
+if __name__ == "__main__":
+    unittest.main()
