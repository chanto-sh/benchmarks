 """Text helpers."""
 
+import re
+import unicodedata
+
+_SEPARATOR_RE = re.compile(r"[^a-z0-9]+")
+
+
+def _strip_accents(text):
+    """Return `text` with combining marks removed (é -> e, ñ -> n, ü -> u)."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(char for char in decomposed if not unicodedata.combining(char))
+
 
 def slugify(text, max_length=None):
     """Convert text to a URL slug.
@@ -20,4 +31,19 @@ def slugify(text, max_length=None):
         slugify("The quick brown fox", max_length=13) == "the-quick"
         slugify("!!!") == ""
     """
-    raise NotImplementedError
+    text = _strip_accents(text).lower()
+    slug = _SEPARATOR_RE.sub("-", text).strip("-")
+
+    if max_length is not None:
+        if max_length <= 0:
+            return ""
+        if len(slug) > max_length:
+            truncated = slug[:max_length]
+            # A hyphen right at the cut point already marks a word boundary.
+            if slug[max_length] != "-":
+                boundary = truncated.rfind("-")
+                if boundary > 0:
+                    truncated = truncated[:boundary]
+            slug = truncated
+
+    return slug
