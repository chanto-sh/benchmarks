+
+    def _neighbors(self, x, y):
+        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nx, ny = x + dx, y + dy
+            if 0 <= nx < self.width and 0 <= ny < self.height:
+                yield nx, ny
+
+    def _region(self, start):
+        """Flood fill the empty region containing ``start``.
+
+        Returns:
+            (set, set): the empty intersections of the region and the
+                        set of stone colours bordering it.
+        """
+        empty = {start}
+        stack = [start]
+        borders = set()
+        while stack:
+            x, y = stack.pop()
+            for nx, ny in self._neighbors(x, y):
+                value = self.board[ny][nx]
+                if value == " ":
+                    if (nx, ny) not in empty:
+                        empty.add((nx, ny))
+                        stack.append((nx, ny))
+                else:
+                    borders.add(value)
+        return empty, borders
 
