diff --git a/notes/model.py b/notes/model.py
index 3750b6b..970e3fe 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,31 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+FORBIDDEN_CHARS = ",#"
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty, or contains whitespace, a comma or a '#'."""
+
+
+def normalize_tags(raw_tags):
+    """Normalize tags: trim, lowercase, drop duplicates, keep first-seen order.
+
+    Raises InvalidTag for the first tag that is empty after trimming or that
+    contains whitespace, a comma or a '#'.
+    """
+    tags = []
+    for raw in raw_tags:
+        tag = (raw or "").strip().lower()
+        if not tag or any(c.isspace() or c in FORBIDDEN_CHARS for c in tag):
+            raise InvalidTag(raw)
+        if tag not in tags:
+            tags.append(tag)
+    return tags
+
+
+def normalize_filter_tags(raw_tags):
+    """Tags used for matching: case-insensitive and whitespace tolerant."""
+    return [(raw or "").strip().lower() for raw in raw_tags]
 
 
 @dataclass
@@ -6,10 +33,34 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
+
+    def has_tags(self, tags):
+        """True when every tag in `tags` is on this note (case-insensitive)."""
+        have = {t.lower() for t in self.tags}
+        return all(t.lower() in have for t in tags)
+
+    def add_tags(self, tags):
+        """Add tags that are not already present; ignores existing ones."""
+        have = {t.lower() for t in self.tags}
+        for tag in tags:
+            if tag not in have:
+                self.tags.append(tag)
+                have.add(tag)
+
+    def remove_tags(self, tags):
+        """Remove tags; tags the note does not have are ignored."""
+        gone = {t.lower() for t in tags}
+        self.tags = [t for t in self.tags if t.lower() not in gone]
