+pub fn encode(mut n: u64) -> String {
+    if n == 0 {
+        return "zero".to_string();
+    }
+
+    // Break the number into groups of three digits, least significant first.
+    let mut groups: Vec<u64> = Vec::new();
+    while n > 0 {
+        groups.push(n % 1_000);
+        n /= 1_000;
+    }
+
+    let mut parts: Vec<String> = Vec::new();
+    for (index, &group) in groups.iter().enumerate().rev() {
+        if group == 0 {
+            continue;
+        }
+        let words = encode_below_thousand(group);
+        let scale = SCALES[index];
+        if scale.is_empty() {
+            parts.push(words);
+        } else {
+            parts.push(format!("{} {}", words, scale));
+        }
+    }
+
+    parts.join(" ")
