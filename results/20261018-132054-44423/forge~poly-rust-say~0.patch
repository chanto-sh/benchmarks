+/// Converts a number in the range 1..=999 into English words.
+fn encode_below_thousand(n: u64) -> String {
+    let mut parts: Vec<String> = Vec::new();
+    let hundreds = n / 100;
+    let remainder = n % 100;
+
+    if hundreds > 0 {
+        parts.push(format!("{} hundred", ONES[hundreds as usize]));
+    }
+
+    if remainder > 0 {
+        if remainder < 20 {
+            parts.push(ONES[remainder as usize].to_string());
+        } else {
+            let tens = (remainder / 10) as usize;
+            let ones = (remainder % 10) as usize;
+            if ones == 0 {
+                parts.push(TENS[tens].to_string());
+            } else {
+                parts.push(format!("{}-{}", TENS[tens], ONES[ones]));
+            }
+        }
+    }
+
+    parts.join(" ")
+}
