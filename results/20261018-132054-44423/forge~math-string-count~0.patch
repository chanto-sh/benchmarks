@@ -1,6 +1,65 @@
 MOD = 1_000_000_007
 
+# States: (number of C's so far mod 3, whether the last letter is 'A').
+# Encoded as 2 * (c mod 3) + last_is_A, giving 6 states.
+_STATES = 6
+_START = 0  # length 0: zero C's, last letter is not 'A'
+
+
+def _transition_matrix():
+    """Build the 6x6 transition matrix for appending one letter.
+
+    Appending 'A' is only legal when the previous letter was not 'A'.
+    Appending 'B' leaves the C-count unchanged; appending 'C' advances it.
+    """
+    m = [[0] * _STATES for _ in range(_STATES)]
+    for c in range(3):
+        for last_a in (0, 1):
+            src = 2 * c + last_a
+            if not last_a:
+                m[2 * c + 1][src] += 1  # append 'A'
+            m[2 * c][src] += 1          # append 'B'
+            m[2 * ((c + 1) % 3)][src] += 1  # append 'C'
+    return m
+
+
+def _mat_mul(a, b):
+    n = len(a)
+    out = [[0] * n for _ in range(n)]
+    for i in range(n):
+        row = out[i]
+        ai = a[i]
+        for k in range(n):
+            aik = ai[k]
+            if aik:
+                bk = b[k]
+                for j in range(n):
+                    row[j] = (row[j] + aik * bk[j]) % MOD
+    return out
+
+
+def _mat_pow(mat, exp):
+    n = len(mat)
+    result = [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+    base = mat
+    while exp:
+        if exp & 1:
+            result = _mat_mul(result, base)
+        base = _mat_mul(base, base)
+        exp >>= 1
+    return result
+
 
 def count_codes(n):
-    """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    """Number of valid voucher codes of length n, modulo MOD.
+
+    A code is valid when it has no two adjacent 'A's and the number of 'C's
+    is a multiple of 3. Runs in O(log n) time via matrix exponentiation.
+    """
+    if n < 0:
+        return 0
+
+    power = _mat_pow(_transition_matrix(), n)
+    counts = [power[s][_START] for s in range(_STATES)]
+    # Valid codes end in either letter; only the C-count must be 0 mod 3.
+    return (counts[0] + counts[1]) % MOD
