+    def test_response_decode_unicode_without_encoding(self):
+        """
+        When no encoding is set, decode_unicode should fall back to the
+        apparent encoding, just like Response.text.
+        """
+        r = requests.Response()
+        r._content_consumed = True
+        r._content = b'the content'
+
+        chunks = r.iter_content(decode_unicode=True)
+        assert all(isinstance(chunk, str) for chunk in chunks)
+
