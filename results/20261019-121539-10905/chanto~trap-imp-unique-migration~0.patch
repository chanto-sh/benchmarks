+--
+-- NOTE: this migration cannot be applied to the production snapshot as-is.
+-- See BLOCKED.md. It is written to fail atomically rather than alter or
+-- discard existing customer rows.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL COLLATE NOCASE,
+    name TEXT,
+    UNIQUE (email)
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
