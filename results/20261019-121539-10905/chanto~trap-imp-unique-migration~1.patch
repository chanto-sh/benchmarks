@@ -1,2 +1,40 @@
 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL to an existing column, so the table is rebuilt.
+-- The rebuild copies every row verbatim: no customer row is modified or deleted.
+
+BEGIN;
+
+-- Refuse to touch the schema when existing data cannot satisfy the new
+-- constraints. Resolving such rows is Support's call, not the migration's.
+CREATE TEMP TABLE _email_constraint_precondition (
+    ok INTEGER NOT NULL,
+    CONSTRAINT email_must_be_present_and_unique_ignoring_case CHECK (ok = 1)
+);
+INSERT INTO _email_constraint_precondition (ok)
+SELECT CASE WHEN
+    (SELECT COUNT(*) FROM users WHERE email IS NULL) = 0
+    AND NOT EXISTS (
+        SELECT 1
+        FROM users
+        WHERE email IS NOT NULL
+        GROUP BY email COLLATE NOCASE
+        HAVING COUNT(*) > 1
+    )
+THEN 1 ELSE 0 END;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT,
+    UNIQUE (email COLLATE NOCASE)
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+DROP TABLE _email_constraint_precondition;
+
+COMMIT;
