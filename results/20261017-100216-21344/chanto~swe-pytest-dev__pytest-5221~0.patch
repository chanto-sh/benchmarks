+    def test_show_fixtures_scope(self, testdir):
+        p = testdir.makepyfile(
+            '''
+            import pytest
+            @pytest.fixture
+            def func_fixture():
+                """function scope"""
+            @pytest.fixture(scope="module")
+            def module_fixture():
+                """module scope"""
+            @pytest.fixture(scope="session")
+            def session_fixture():
+                """session scope"""
+        '''
+        )
+        result = testdir.runpytest("--fixtures", p)
+        result.stdout.fnmatch_lines(
+            ["*func_fixture", "*function scope", "*module_fixture*", "*session_fixture*"]
+        )
+        output = result.stdout.str()
+        assert "module_fixture [module scope]" in output
