+        # Check to see if all parameters in the template are attributes of the Message.
+        # Use string.Formatter to parse the template so that escaped braces (e.g. '{{')
+        # are treated as literal text instead of replacement fields.
+        arguments = Formatter().parse(template)
+        fixed_template = []
+        for literal_text, field_name, format_spec, conversion in arguments:
+            # Re-escape literal braces so the template stays valid for str.format
+            fixed_template.append(literal_text.replace("{", "{{").replace("}", "}}"))
+            if field_name is None:
+                continue
+            if field_name in MESSAGE_FIELDS:
+                field = f"{{{field_name}"
+                if conversion:
+                    field += f"!{conversion}"
+                if format_spec:
+                    field += f":{format_spec}"
+                fixed_template.append(f"{field}}}")
+            else:
                 warnings.warn(
-                    f"Don't recognize the argument '{argument[0]}' in the --msg-template. "
