+def test_template_option_with_custom_braces(linter) -> None:
+    """Test the msg-template option with escaped custom braces."""
+    output = StringIO()
+    linter.reporter.out = output
+    linter.config.msg_template = '{{ "Category": "{category}" }}'
+    linter.open()
+    linter.set_current_module("my_module")
+    linter.add_message("C0301", line=1, args=(1, 2))
+
+    out_lines = output.getvalue().split("\n")
+    assert out_lines[1] == '{ "Category": "convention" }'
+
+
+def test_template_option_with_custom_braces_and_unknown(linter) -> None:
+    """Test that escape custom braces are kept when an unknown argument is removed."""
+    output = StringIO()
+    linter.reporter.out = output
+    linter.config.msg_template = (
+        '{{ "Category": "{category}", "Unknown": "{unknown}" }}'
+    )
+    linter.open()
+    with pytest.warns(UserWarning) as records:
+        linter.set_current_module("my_module")
+        assert len(records) == 1
+        assert "Don't recognize the argument 'unknown'" in records[0].message.args[0]
+    linter.add_message("C0301", line=1, args=(1, 2))
+
+    out_lines = output.getvalue().split("\n")
+    assert out_lines[1] == '{ "Category": "convention", "Unknown": "" }'
+
+
