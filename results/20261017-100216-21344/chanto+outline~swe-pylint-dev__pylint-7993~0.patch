+        fixed_template = []
+        for (
+            literal_text,
+            field_name,
+            format_spec,
+            conversion,
+        ) in formatter.parse(template):
+            # ``Formatter.parse()`` unescapes braces in the literal text, so
+            # escape them again to keep them literal in the resulting template.
+            fixed_template.append(literal_text.replace("{", "{{").replace("}", "}}"))
