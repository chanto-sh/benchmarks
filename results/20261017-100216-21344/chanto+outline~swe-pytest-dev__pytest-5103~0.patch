+    def test_assertion_unrolls_generator(self):
+        """#5103"""
+
+        def f():
+            assert all(x < 2 for x in range(3))
+
+        assert (
+            getmsg(f)
+            == """assert False
+ +  where False = all([True, True, False])"""
+        )
+
+        def f():
+            assert any(x > 2 for x in range(3))
+
+        assert (
+            getmsg(f)
+            == """assert False
+ +  where False = any([False, False, False])"""
+        )
+
     def test_attribute(self):
