+
+/// Minimum price for the remaining basket described by `counts`.
+///
+/// Any optimal grouping contains a group that includes the lowest-indexed
+/// remaining book, so we only enumerate subsets of the other four titles.
+fn solve(counts: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
+    let first = match counts.iter().position(|&count| count > 0) {
+        Some(index) => index,
+        None => return 0,
+    };
+
+    if let Some(&price) = memo.get(&counts) {
+        return price;
+    }
+
+    let others: Vec<usize> = (first + 1..5).filter(|&i| counts[i] > 0).collect();
+
+    let mut best = u32::MAX;
+    for mask in 0..(1u32 << others.len()) {
+        let mut remaining = counts;
+        remaining[first] -= 1;
+        let mut size = 1;
+
+        for (bit, &index) in others.iter().enumerate() {
+            if mask & (1 << bit) != 0 {
+                remaining[index] -= 1;
+                size += 1;
+            }
+        }
+
+        best = best.min(GROUP_PRICE[size] + solve(remaining, memo));
+    }
+
+    memo.insert(counts, best);
+    best
 }
