+    def _visit_call_all_any(self, call):
+        """Unroll an ``all``/``any`` call over a comprehension.
+
+        The comprehension is rewritten into an equivalent for loop so that
+        the failure report can show the value which made the assertion fail,
+        just like the equivalent explicit for loop would.
+        """
+        is_all = call.func.id == "all"
+        comp = call.args[0]
+        gen = comp.generators[0]
+        result_var = self.variable()
+        explanation_var = self.variable()
+        has_values_var = self.variable()
+
+        # Visit the element expression while collecting its statements (and
+        # the statements needed to format its explanation) separately, so the
+        # evaluation ends up inside the loop body.  The explanation itself is
+        # only formatted when the assertion actually fails.
+        self.push_format_context()
+        saved_statements = self.statements
+        saved_on_failure = self.on_failure
+        self.statements = []
+        self.on_failure = []
+        res, expl = self.visit(comp.elt)
+        body = self.statements
+        format_body = self.on_failure
+        current = self.stack.pop()
+        if self.stack:
+            self.explanation_specifiers = self.stack[-1]
+        keys = [ast.Str(key) for key in current.keys()]
+        format_dict = ast.Dict(keys, list(current.values()))
+        self.statements = saved_statements
+        self.on_failure = saved_on_failure
+
+        body.append(ast.Assign([ast.Name(result_var, ast.Store())], res))
+        body.append(
+            ast.Assign([ast.Name(has_values_var, ast.Store())], _NameConstant(True))
+        )
+        result = ast.Name(result_var, ast.Load())
+        if is_all:
+            break_cond = ast.UnaryOp(ast.Not(), result)
+        else:
+            break_cond = result
+        body.append(ast.If(break_cond, [ast.Break()], []))
+
+        format_expl = ast.BinOp(ast.Str(expl), ast.Mod(), format_dict)
+        format_body.append(
+            ast.Assign([ast.Name(explanation_var, ast.Store())], format_expl)
+        )
+        self.on_failure.append(
+            ast.If(ast.Name(has_values_var, ast.Load()), format_body, [])
+        )
+
+        # If the iterable is empty the element expression is never visited, so
+        # fall back to the value of the (empty) all/any result.
+        self.statements.append(
+            ast.Assign([ast.Name(has_values_var, ast.Store())], _NameConstant(False))
+        )
+        self.statements.append(
+            ast.Assign(
+                [ast.Name(explanation_var, ast.Store())],
+                ast.Str("True" if is_all else "False"),
+            )
+        )
+        self.statements.append(
+            ast.Assign([ast.Name(result_var, ast.Store())], _NameConstant(is_all))
+        )
+        self.statements.append(ast.For(gen.target, gen.iter, body, []))
+        explanation = self.explanation_param(ast.Name(explanation_var, ast.Load()))
+        return ast.Name(result_var, ast.Load()), explanation
+
