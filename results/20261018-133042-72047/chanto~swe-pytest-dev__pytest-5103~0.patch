+def _should_unroll(call, variables):
+    """Return True if the call can be unrolled into a for loop.
+
+    Only simple ``all``/``any`` calls over a generator expression or a list
+    comprehension are unrolled.  Anything else is left untouched to avoid
+    changing the semantics of the expression being rewritten.
+    """
+    if not isinstance(call.func, ast.Name):
+        return False
+    if call.func.id not in ("all", "any"):
+        return False
+    if len(call.args) != 1 or call.keywords:
+        return False
+    arg = call.args[0]
+    if not isinstance(arg, (ast.GeneratorExp, ast.ListComp)):
+        return False
+    if len(arg.generators) != 1:
+        return False
+    gen = arg.generators[0]
+    if gen.ifs or getattr(gen, "is_async", 0):
+        return False
+    if not isinstance(gen.target, ast.Name):
+        return False
+    if gen.target.id in variables:
+        return False
+    return True
+
