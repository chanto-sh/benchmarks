diff --git a/src/format.js b/src/format.js
index f7f4c85..d723bc6 100644
--- a/src/format.js
+++ b/src/format.js
@@ -1,6 +1,51 @@
+// Exact money helpers. Amounts are integer cents (BigInt) until formatted.
+
+// Parse a decimal ("19.99", 19.99) into an exact scaled integer.
+function parseDecimal(amount) {
+  const s = String(amount).trim();
+  const match = /^([+-]?)(\d+)(?:\.(\d*))?$/.exec(s);
+  if (!match) throw new TypeError(`invalid decimal: ${amount}`);
+  const sign = match[1] === "-" ? -1n : 1n;
+  const fraction = match[3] || "";
+  return {
+    value: sign * BigInt(match[2] + fraction),
+    scale: BigInt(fraction.length),
+  };
+}
+
+// Integer division, rounding halves away from zero.
+function divRoundHalfUp(numerator, denominator) {
+  const negative = numerator < 0n;
+  const n = negative ? -numerator : numerator;
+  const rounded = (2n * n + denominator) / (2n * denominator);
+  return negative ? -rounded : rounded;
+}
+
+// Convert a decimal amount into integer cents, rounding half up.
+function toCents(amount) {
+  const { value, scale } = parseDecimal(amount);
+  return divRoundHalfUp(value * 100n, 10n ** scale);
+}
+
+// `amount x qty` in integer cents, rounded half up once for the line.
+function multiplyToCents(amount, qty) {
+  const { value, scale } = parseDecimal(amount);
+  return divRoundHalfUp(value * BigInt(qty) * 100n, 10n ** scale);
+}
+
+// `pct` percent of an integer-cents amount, rounded half up to the cent.
+function percentOfCents(cents, pct) {
+  const { value, scale } = parseDecimal(pct);
+  return divRoundHalfUp(cents * value, 100n * 10n ** scale);
+}
+
 // Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+function fmt(cents) {
+  const negative = cents < 0n;
+  const amount = negative ? -cents : cents;
+  const whole = amount / 100n;
+  const fraction = String(amount % 100n).padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${fraction}`;
 }
 
-module.exports = { fmt };
+module.exports = { toCents, multiplyToCents, percentOfCents, fmt };
