 package say
 
+import "strings"
+
+var ones = []string{
+	"zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
+	"ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
+	"seventeen", "eighteen", "nineteen",
+}
+
+var tens = []string{
+	"", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety",
+}
+
+var scales = []string{"", "thousand", "million", "billion"}
+
+// Say spells out n in plain English. The second return value is false when n
+// is outside the range 0 to 999,999,999,999.
 func Say(n int64) (string, bool) {
-	panic("Please implement the Say function")
+	if n < 0 || n > 999999999999 {
+		return "", false
+	}
+	if n == 0 {
+		return "zero", true
+	}
+
+	var parts []string
+	for i := 0; n > 0; i++ {
+		chunk := n % 1000
+		n /= 1000
+		if chunk == 0 {
+			continue
+		}
+		s := sayHundreds(int(chunk))
+		if scales[i] != "" {
+			s += " " + scales[i]
+		}
+		parts = append([]string{s}, parts...)
+	}
+
+	return strings.Join(parts, " "), true
+}
+
+func sayHundreds(n int) string {
+	var s string
+	if n >= 100 {
+		s = ones[n/100] + " hundred"
+		n %= 100
+		if n > 0 {
+			s += " "
+		}
+	}
+	if n >= 20 {
+		s += tens[n/10]
+		if n%10 > 0 {
+			s += "-" + ones[n%10]
+		}
+	} else if n > 0 {
+		s += ones[n]
+	}
+	return s
 }
