 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	nameIndex := make(map[string]int, len(robots))
+	occupied := make(map[Pos]struct{}, len(robots))
+
+	for i, robot := range robots {
+		if robot.Name == "" {
+			log <- "robot without a name"
+		} else if _, exists := nameIndex[robot.Name]; exists {
+			log <- fmt.Sprintf("duplicate robot name %q", robot.Name)
+		} else {
+			nameIndex[robot.Name] = i
+		}
+
+		if _, exists := occupied[robot.Pos]; exists {
+			log <- fmt.Sprintf("multiple robots placed at %v", robot.Pos)
+		} else {
+			occupied[robot.Pos] = struct{}{}
+		}
+
+		if !inside(extent, robot.Pos) {
+			log <- fmt.Sprintf("robot %q placed outside of the room", robot.Name)
+		}
+	}
+
+	for finished := 0; finished < len(robots); {
+		act := <-action
+		if act.Done {
+			finished++
+			continue
+		}
+
+		i, known := nameIndex[act.Name]
+		if !known {
+			log <- fmt.Sprintf("action from unknown robot %q", act.Name)
+			continue
+		}
+
+		robot := &robots[i]
+		switch act.Command {
+		case 'R':
+			robot.Dir = turnRight(robot.Dir)
+		case 'L':
+			robot.Dir = turnLeft(robot.Dir)
+		case 'A':
+			next := advancePos(robot.Pos, robot.Dir)
+			if !inside(extent, next) {
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", act.Name)
+				continue
+			}
+			blocked := false
+			for j := range robots {
+				if j != i && robots[j].Pos == next {
+					log <- fmt.Sprintf("robot %q attempted to advance into another robot", act.Name)
+					blocked = true
+					break
+				}
+			}
+			if !blocked {
+				robot.Pos = next
+			}
+		}
+	}
+
+	rep <- robots
+}
+
+func turnRight(d Dir) Dir {
+	return (d + 1) % 4
+}
+
+func turnLeft(d Dir) Dir {
+	return (d + 3) % 4
+}
+
+func advancePos(pos Pos, d Dir) Pos {
+	switch d {
+	case N:
+		pos.Northing++
+	case E:
+		pos.Easting++
+	case S:
+		pos.Northing--
+	case W:
+		pos.Easting--
+	}
+	return pos
+}
+
+func inside(extent Rect, pos Pos) bool {
+	return pos.Easting >= extent.Min.Easting &&
+		pos.Easting <= extent.Max.Easting &&
+		pos.Northing >= extent.Min.Northing &&
+		pos.Northing <= extent.Max.Northing
 }
