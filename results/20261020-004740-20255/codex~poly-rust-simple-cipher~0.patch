+
+fn transform(key: &str, s: &str, decode: bool) -> Option<String> {
+    if key.is_empty() || !key.bytes().all(|byte| byte.is_ascii_lowercase()) {
+        return None;
+    }
+
+    let mut shifts = key.bytes().cycle();
+    let result = s
+        .chars()
+        .map(|character| {
+            let shift = (shifts.next().expect("the key is not empty") - b'a') as i32;
+
+            if character.is_ascii_lowercase() {
+                let offset = if decode { -shift } else { shift };
+                shift_letter(character, b'a', offset)
+            } else if character.is_ascii_uppercase() {
+                let offset = if decode { -shift } else { shift };
+                shift_letter(character, b'A', offset)
+            } else {
+                character
+            }
+        })
+        .collect();
+
+    Some(result)
+}
+
+fn shift_letter(character: char, base: u8, shift: i32) -> char {
+    let position = (character as u8 - base) as i32;
+    let shifted = (position + shift).rem_euclid(26);
+    (base + shifted as u8) as char
 }
