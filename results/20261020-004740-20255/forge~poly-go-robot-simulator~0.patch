+
+// turn returns the direction resulting from the robot turning as directed
+// by cmd.
+func turn(d Dir, cmd Command) Dir {
+	switch cmd {
+	case 'R':
+		return (d + 1) % 4
+	case 'L':
+		return (d + 3) % 4
+	}
+	return d
+}
+
+// nextPos returns the position one step from p in direction d.
+func nextPos(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+// inside reports whether p is within the room of the given extent.
+func inside(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
+}
+
+// occupied reports whether any robot stands at p.
+func occupied(robots []Step3Robot, p Pos) bool {
+	for _, r := range robots {
+		if r.Pos == p {
+			return true
+		}
+	}
+	return false
 }
