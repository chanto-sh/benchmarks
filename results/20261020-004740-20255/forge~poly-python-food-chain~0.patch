+"""Generate the lyrics of 'I Know an Old Lady Who Swallowed a Fly'."""
+
+# Each animal in the order it is swallowed, together with the line that
+# comments on the old lady swallowing it (None when there is no such line).
+ANIMALS = [
+    ("fly", None),
+    ("spider", "It wriggled and jiggled and tickled inside her."),
+    ("bird", "How absurd to swallow a bird!"),
+    ("cat", "Imagine that, to swallow a cat!"),
+    ("dog", "What a hog, to swallow a dog!"),
+    ("goat", "Just opened her throat and swallowed a goat!"),
+    ("cow", "I don't know how she swallowed a cow!"),
+    ("horse", "She's dead, of course!"),
+]
+
+# The spider is the only animal that carries a descriptive clause along with
+# it into every verse that follows.
+CATCH_PHRASES = {
+    "spider": "the spider that wriggled and jiggled and tickled inside her",
+}
+
+FINAL_LINE = "I don't know why she swallowed the fly. Perhaps she'll die."
+
+
+def _catch_phrase(animal):
+    """Return the object phrase for the animal being caught."""
+    return CATCH_PHRASES.get(animal, "the " + animal)
+
+
+def _verse(number):
+    """Build the lines of the verse for the 1-based animal `number`."""
+    animal, comment = ANIMALS[number - 1]
+
+    lines = ["I know an old lady who swallowed a {}.".format(animal)]
+    if comment is not None:
+        lines.append(comment)
+
+    # The horse verse ends abruptly: no chain of swallowing and no final line.
+    if animal == "horse":
+        return lines
+
+    # Walk back down the food chain, each animal swallowed to catch the one
+    # before it. `number` is 1-based, so the chain runs from `number` down to
+    # 2 (nothing is swallowed to catch the fly).
+    for current in range(number, 1, -1):
+        prey = ANIMALS[current - 2][0]
+        lines.append(
+            "She swallowed the {} to catch {}.".format(
+                ANIMALS[current - 1][0], _catch_phrase(prey)
+            )
+        )
+
+    lines.append(FINAL_LINE)
+    return lines
+
+
 def recite(start_verse, end_verse):
-    pass
+    """Return the lyrics from `start_verse` through `end_verse` inclusive."""
+    lines = []
+    for number in range(start_verse, end_verse + 1):
+        if lines:
+            lines.append("")
+        lines.extend(_verse(number))
+    return lines
