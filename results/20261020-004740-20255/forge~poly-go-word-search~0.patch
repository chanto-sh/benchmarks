 package wordsearch
 
+import "fmt"
+
+// direction describes a step through the grid as (dx, dy).
+type direction struct {
+	dx, dy int
+}
+
+var directions = []direction{
+	{1, 0},   // left to right
+	{-1, 0},  // right to left
+	{0, 1},   // top to bottom
+	{0, -1},  // bottom to top
+	{1, 1},   // top left to bottom right
+	{-1, -1}, // bottom right to top left
+	{1, -1},  // bottom left to top right
+	{-1, 1},  // top right to bottom left
+}
+
+// Solve returns the start and end positions of each word in the puzzle.
+// Positions are given as {column, row}. An error is returned if any word
+// cannot be found.
 func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
-	panic("Please implement the Solve function")
+	grid := make([][]byte, len(puzzle))
+	for i, line := range puzzle {
+		grid[i] = []byte(line)
+	}
+
+	height := len(grid)
+	width := 0
+	for _, row := range grid {
+		if len(row) > width {
+			width = len(row)
+		}
+	}
+
+	result := make(map[string][2][2]int, len(words))
+	for _, word := range words {
+		found := false
+		for y := 0; y < height && !found; y++ {
+			for x := 0; x < width && !found; x++ {
+				for _, d := range directions {
+					endX, endY, ok := match(grid, width, height, word, x, y, d)
+					if ok {
+						result[word] = [2][2]int{{x, y}, {endX, endY}}
+						found = true
+						break
+					}
+				}
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("word %q not found in puzzle", word)
+		}
+	}
+
+	return result, nil
+}
+
+// match reports whether word occurs starting at (x, y) stepping along d, and
+// returns the position of its last letter.
+func match(grid [][]byte, width, height int, word string, x, y int, d direction) (int, int, bool) {
+	if len(word) == 0 {
+		return 0, 0, false
+	}
+	for i := 0; i < len(word); i++ {
+		col := x + i*d.dx
+		row := y + i*d.dy
+		if col < 0 || col >= width || row < 0 || row >= height {
+			return 0, 0, false
+		}
+		if col >= len(grid[row]) || grid[row][col] != word[i] {
+			return 0, 0, false
+		}
+	}
+	return x + (len(word)-1)*d.dx, y + (len(word)-1)*d.dy, true
 }
