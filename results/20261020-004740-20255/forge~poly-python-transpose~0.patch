@@ -1,2 +1,21 @@
 def transpose(text):
-    pass
+    if not text:
+        return ""
+
+    rows = text.split("\n")
+    max_length = max(len(row) for row in rows)
+
+    transposed = []
+    for column in range(max_length):
+        # Shorter rows contribute a space, but only up to the last row that
+        # actually has a character in this column: padding is never added to
+        # the right of the output, while real spaces are preserved.
+        last = max(index for index, row in enumerate(rows) if column < len(row))
+        transposed.append(
+            "".join(
+                row[column] if column < len(row) else " "
+                for row in rows[: last + 1]
+            )
+        )
+
+    return "\n".join(transposed)
