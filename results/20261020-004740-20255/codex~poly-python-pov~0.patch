+
+    def _adjacency(self):
+        child_labels = {}
+        nodes = [self]
+        while nodes:
+            node = nodes.pop()
+            child_labels[node.label] = [child.label for child in node.children]
+            nodes.extend(node.children)
+
+        adjacency = {
+            label: list(children) for label, children in child_labels.items()
+        }
+        for label, children in child_labels.items():
+            for child in children:
