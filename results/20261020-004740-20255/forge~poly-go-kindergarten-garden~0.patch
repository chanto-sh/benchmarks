 func NewGarden(diagram string, children []string) (*Garden, error) {
-	panic("Please implement the NewGarden function")
+	if !strings.HasPrefix(diagram, "\n") {
+		return nil, errors.New("diagram must start with a newline")
+	}
+
+	rows := strings.Split(diagram[1:], "\n")
+	if len(rows) != 2 {
+		return nil, fmt.Errorf("diagram must have exactly two rows, got %d", len(rows))
+	}
+
+	width := len(rows[0])
+	if len(rows[1]) != width {
+		return nil, errors.New("diagram rows have different lengths")
+	}
+	if width%2 != 0 {
+		return nil, errors.New("diagram has an odd number of cups")
+	}
+	if width != 2*len(children) {
+		return nil, fmt.Errorf("diagram has %d cups per row, which does not fit %d children", width/2, len(children))
+	}
+
+	// Assign cups alphabetically without modifying the caller's slice.
+	names := make([]string, len(children))
+	copy(names, children)
+	sort.Strings(names)
+	for i := 1; i < len(names); i++ {
+		if names[i] == names[i-1] {
+			return nil, fmt.Errorf("duplicate child %q", names[i])
+		}
+	}
+
+	g := &Garden{plants: make(map[string][]string, len(names))}
+	for i, name := range names {
+		cups := []byte{
+			rows[0][2*i], rows[0][2*i+1],
+			rows[1][2*i], rows[1][2*i+1],
+		}
+		plants := make([]string, len(cups))
+		for j, cup := range cups {
+			plant, ok := cupPlants[cup]
+			if !ok {
+				return nil, fmt.Errorf("invalid cup code %q for child %q", cup, name)
+			}
+			plants[j] = plant
+		}
+		g.plants[name] = plants
+	}
+
+	return g, nil
 }
 
