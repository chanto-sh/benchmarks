+// rng is a package-level, concurrency-safe source of randomness.
+var (
+	rngMu sync.Mutex
+	rng   = rand.New(rand.NewSource(time.Now().UnixNano()))
+)
+
+// rollD6 returns a pseudo-random value in the range [1, 6].
+func rollD6() int {
+	rngMu.Lock()
+	defer rngMu.Unlock()
+	return rng.Intn(6) + 1
+}
