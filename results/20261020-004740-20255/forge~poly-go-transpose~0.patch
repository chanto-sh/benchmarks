 package transpose
 
+// Transpose returns the transpose of the given input text.
+//
+// Rows become columns and columns become rows. Since the input may have rows
+// of different lengths, missing characters are conceptually padded to the left
+// with spaces and never padded to the right. This means that a transposed row
+// only extends as far as its bottom-most character, while spaces that come
+// from genuinely present characters are preserved.
 func Transpose(input []string) []string {
-	panic("Please implement the Transpose function")
+	// Work on runes so multi-byte characters are handled correctly.
+	rows := make([][]rune, len(input))
+	maxWidth := 0
+	for i, line := range input {
+		rows[i] = []rune(line)
+		if len(rows[i]) > maxWidth {
+			maxWidth = len(rows[i])
+		}
+	}
+
+	var result []string
+	for col := 0; col < maxWidth; col++ {
+		// Find the last row that actually has a character in this column.
+		last := -1
+		for r := len(rows) - 1; r >= 0; r-- {
+			if len(rows[r]) > col {
+				last = r
+				break
+			}
+		}
+		// No row reaches this column: it contributes nothing to the output.
+		if last < 0 {
+			break
+		}
+
+		out := make([]rune, last+1)
+		for r := 0; r <= last; r++ {
+			if len(rows[r]) > col {
+				out[r] = rows[r][col]
+			} else {
+				out[r] = ' '
+			}
+		}
+		result = append(result, string(out))
+	}
+
+	return result
 }
