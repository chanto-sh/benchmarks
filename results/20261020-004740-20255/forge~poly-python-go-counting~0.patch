+
+    def _is_stone(self, x, y):
+        return self.board[y][x] in (BLACK, WHITE)
+
+    def _neighbors(self, x, y):
+        if x > 0:
+            yield x - 1, y
+        if x + 1 < self.width:
+            yield x + 1, y
+        if y > 0:
+            yield x, y - 1
+        if y + 1 < self.height:
+            yield x, y + 1
+
+    def _region(self, x, y):
+        """Flood fill the empty region containing (x, y).
+
+        Returns:
+            (set, set): the empty intersections of the region and the
+                        stones bordering it.
+        """
+        area = set()
+        borders = set()
+        stack = [(x, y)]
+        area.add((x, y))
+
+        while stack:
+            cx, cy = stack.pop()
+            for nx, ny in self._neighbors(cx, cy):
+                if self._is_stone(nx, ny):
+                    borders.add((nx, ny))
+                elif (nx, ny) not in area:
+                    area.add((nx, ny))
+                    stack.append((nx, ny))
+
+        return area, borders
+
+    def _owner(self, borders):
+        colors = {self.board[y][x] for x, y in borders}
+        if len(colors) == 1:
+            return colors.pop()
+        return NONE
 
