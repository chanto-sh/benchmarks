+def _affected_compute_cells(start):
+    affected = set()
+    stack = list(start._dependents)
+
+    while stack:
+        cell = stack.pop()
+        if cell in affected:
+            continue
+        affected.add(cell)
+        stack.extend(cell._dependents)
+
+    return affected
+
+
+def _topological_order(cells):
+    ordered = []
+    visited = set()
+    visiting = set()
+
+    def visit(cell):
+        if cell in visited:
+            return
+        if cell in visiting:
+            raise ValueError("cyclic dependency detected")
+
+        visiting.add(cell)
+        for dependency in cell._inputs:
+            if dependency in cells:
+                visit(dependency)
+        visiting.remove(cell)
+        visited.add(cell)
+        ordered.append(cell)
+
+    for cell in cells:
+        visit(cell)
+
+    return ordered
+
+
+def _propagate_from(source):
+    affected = _affected_compute_cells(source)
+    changed = []
+
+    for cell in _topological_order(affected):
+        new_value = cell._compute_function([item.value for item in cell._inputs])
+        if new_value != cell._value:
+            cell._value = new_value
+            changed.append(cell)
+
+    for cell in changed:
+        for callback in list(cell._callbacks):
+            callback(cell.value)
