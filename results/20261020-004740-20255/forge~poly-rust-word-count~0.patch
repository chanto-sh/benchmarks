 /// Count occurrences of words.
 pub fn word_count(words: &str) -> HashMap<String, u32> {
-    todo!("Count of occurrences of words in {words:?}");
+    let mut counts = HashMap::new();
+
+    for token in words.split(|c: char| !c.is_alphanumeric() && c != '\'') {
+        // Apostrophes only matter inside a word (contractions), so strip any
+        // that ended up at the edges of the token, e.g. quoted words.
+        let word = token.trim_matches('\'');
+        if word.is_empty() {
+            continue;
+        }
+        let word = word.to_ascii_lowercase();
+        *counts.entry(word).or_insert(0) += 1;
+    }
+
+    counts
 }
