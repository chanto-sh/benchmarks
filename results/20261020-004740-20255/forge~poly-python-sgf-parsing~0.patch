+def _parse_tree(input_string, index):
+    """Parse a single game tree starting at ``index`` (which holds '(')."""
+    index += 1  # Skip '('.
+
+    node_properties = []
+    while index < len(input_string) and input_string[index] == ";":
+        properties, index = _parse_node(input_string, index + 1)
+        node_properties.append(properties)
+
+    children = []
+    while index < len(input_string) and input_string[index] == "(":
+        child, index = _parse_tree(input_string, index)
+        children.append(child)
+
+    if index >= len(input_string) or input_string[index] != ")":
+        raise ValueError("tree missing")
+    index += 1  # Skip ')'.
+
+    if not node_properties:
+        raise ValueError("tree with no nodes")
+
+    # The first node is the root; each following node is the sole child of the
+    # previous one, and any sub-trees belong to the last node.
+    tree = SgfTree(node_properties[-1], children)
+    for properties in reversed(node_properties[:-1]):
+        tree = SgfTree(properties, [tree])
+    return tree, index
+
+
+def _parse_node(input_string, index):
+    """Parse the property list of a node, starting just after its ';'."""
+    properties = {}
+
+    while index < len(input_string) and input_string[index] not in ";()":
+        start = index
+        while index < len(input_string) and input_string[index] not in ";()[]":
+            index += 1
+        identifier = input_string[start:index]
+
+        if not _PROPERTY_IDENTIFIER.fullmatch(identifier):
+            raise ValueError("property must be in uppercase")
+
+        if index >= len(input_string) or input_string[index] != "[":
+            raise ValueError("properties without delimiter")
+
+        values = []
+        while index < len(input_string) and input_string[index] == "[":
+            value, index = _parse_value(input_string, index + 1)
+            values.append(value)
+
+        properties[identifier] = values
+
+    return properties, index
+
+
+def _parse_value(input_string, index):
+    """Parse a property value, starting just after its opening '['."""
+    characters = []
+
+    while index < len(input_string):
+        character = input_string[index]
+
+        if character == "\\":
+            index += 1
+            if index >= len(input_string):
+                raise ValueError("tree missing")
+            escaped = input_string[index]
+            if escaped == "\n":
+                pass  # A newline right after a backslash is removed.
+            elif escaped in _WHITESPACE:
+                characters.append(" ")
+            else:
+                characters.append(escaped)
+            index += 1
+        elif character == "]":
+            return "".join(characters), index + 1
+        elif character == "\n":
+            characters.append(character)
+            index += 1
+        elif character in _WHITESPACE:
+            characters.append(" ")
+            index += 1
+        else:
+            characters.append(character)
+            index += 1
+
+    raise ValueError("tree missing")
