+    fn drop(&mut self) {
+        let mut current = self.front;
+        while let Some(node) = current {
+            // SAFETY: `node` is a live node owned by this list. Its `back` link
+            // is a valid (non-owning) pointer to another live node, so reading
+            // it before freeing the current node is fine. Every node is visited
+            // exactly once, so each is freed exactly once.
