 pub fn convert(input: &str) -> Result<String, Error> {
-    todo!("Convert the input '{input}' to a string");
+    let lines: Vec<Vec<char>> = input.lines().map(|line| line.chars().collect()).collect();
+
+    if lines.len() % 4 != 0 {
+        return Err(Error::InvalidRowCount(lines.len()));
+    }
+
+    let width = lines.first().map_or(0, Vec::len);
+    for line in &lines {
+        if line.len() % 3 != 0 {
+            return Err(Error::InvalidColumnCount(line.len()));
+        }
+        if line.len() != width {
+            return Err(Error::InvalidColumnCount(line.len()));
+        }
+    }
+
+    let mut numbers = Vec::new();
+    for rows in lines.chunks(4) {
+        let mut number = String::new();
+        for column in (0..width).step_by(3) {
+            number.push(recognize_digit(
+                &rows[0][column..column + 3],
+                &rows[1][column..column + 3],
+                &rows[2][column..column + 3],
+            ));
+        }
+        numbers.push(number);
+    }
+
+    Ok(numbers.join(","))
+}
+
+fn recognize_digit(top: &[char], middle: &[char], bottom: &[char]) -> char {
+    match (top, middle, bottom) {
+        ([' ', '_', ' '], ['|', ' ', '|'], ['|', '_', '|']) => '0',
+        ([' ', ' ', ' '], [' ', ' ', '|'], [' ', ' ', '|']) => '1',
+        ([' ', '_', ' '], [' ', '_', '|'], ['|', '_', ' ']) => '2',
+        ([' ', '_', ' '], [' ', '_', '|'], [' ', '_', '|']) => '3',
+        ([' ', ' ', ' '], ['|', '_', '|'], [' ', ' ', '|']) => '4',
+        ([' ', '_', ' '], ['|', '_', ' '], [' ', '_', '|']) => '5',
+        ([' ', '_', ' '], ['|', '_', ' '], ['|', '_', '|']) => '6',
+        ([' ', '_', ' '], [' ', ' ', '|'], [' ', ' ', '|']) => '7',
+        ([' ', '_', ' '], ['|', '_', '|'], ['|', '_', '|']) => '8',
+        ([' ', '_', ' '], ['|', '_', '|'], [' ', '_', '|']) => '9',
+        _ => '?',
+    }
 }
