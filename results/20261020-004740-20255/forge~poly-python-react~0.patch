+def _topological_descendants(source):
+    """Return every cell reachable from ``source`` in dependency order.
+
+    The source cell itself is excluded. The result is a topological ordering of
+    the affected subgraph, so recomputing the cells in this order guarantees
+    that a cell is recalculated only after all of its inputs are up to date.
+    """
+    order = []
+    state = {}  # id(cell) -> 1 while on the current DFS path, 2 when finished
+
+    def visit(cell):
+        cell_id = id(cell)
+        status = state.get(cell_id)
+        if status == 2:
+            return
+        if status == 1:
+            raise ValueError("Cyclic dependency detected between cells")
+        state[cell_id] = 1
+        for dependent in cell.dependents:
+            visit(dependent)
+        state[cell_id] = 2
+        if cell is not source:
+            order.append(cell)
+
+    visit(source)
+    # ``order`` is a post-order traversal; reversing it yields a topological
+    # ordering with dependencies before dependents.
+    order.reverse()
+    return order
+
+
+def _propagate(source):
+    """Recompute all cells downstream of ``source`` and fire change callbacks."""
+    affected = _topological_descendants(source)
+    if not affected:
+        return
+
+    previous = {id(cell): cell.value for cell in affected}
+
+    for cell in affected:
+        cell._recompute()
+
+    # Fire callbacks only after the whole graph has reached a stable state, and
+    # only for cells whose stable value actually changed. Each affected cell is
+    # visited once, so a callback can never fire twice for a single update.
+    for cell in affected:
+        if cell.value != previous[id(cell)]:
+            cell._notify()
