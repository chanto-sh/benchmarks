+
+func equal(l1, l2 []int) bool {
+	if len(l1) != len(l2) {
+		return false
+	}
+	for i := range l1 {
+		if l1[i] != l2[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func contains(list, sublist []int) bool {
+	if len(sublist) > len(list) {
+		return false
+	}
+	for start := 0; start <= len(list)-len(sublist); start++ {
+		match := true
+		for i := range sublist {
+			if list[start+i] != sublist[i] {
+				match = false
+				break
+			}
+		}
+		if match {
+			return true
+		}
+	}
+	return false
 }
