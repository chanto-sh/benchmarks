-	panic("Please implement the ParseHex function")
+import "errors"
+
+var (
+	errSyntax = errors.New("syntax error: invalid hexadecimal string")
+	errRange  = errors.New("range error: hexadecimal value overflows int64")
+)
+
+// ParseHex converts a hexadecimal string to an int64.
+func ParseHex(in string) (int64, error) {
+	if in == "" {
+		return 0, errSyntax
+	}
+
+	const maxInt64 = int64(1<<63 - 1)
+
+	var out int64
+	for i := 0; i < len(in); i++ {
+		var digit int64
+		switch c := in[i]; {
+		case c >= '0' && c <= '9':
+			digit = int64(c - '0')
+		case c >= 'a' && c <= 'f':
+			digit = int64(c-'a') + 10
+		case c >= 'A' && c <= 'F':
+			digit = int64(c-'A') + 10
+		default:
+			return 0, errSyntax
+		}
+
+		if out > (maxInt64-digit)/16 {
+			return 0, errRange
+		}
+		out = out*16 + digit
+	}
+
+	return out, nil
+}
+
+// HandleErrors reports the error category returned for each input.
+func HandleErrors(inputs []string) []string {
+	results := make([]string, len(inputs))
+	for i, input := range inputs {
+		_, err := ParseHex(input)
+		switch {
+		case err == nil:
+			results[i] = "none"
+		case errors.Is(err, errSyntax):
+			results[i] = "syntax"
+		case errors.Is(err, errRange):
+			results[i] = "range"
+		}
+	}
+	return results
 }
