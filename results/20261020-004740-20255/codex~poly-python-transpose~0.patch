 def transpose(text):
-    pass
+    rows = text.splitlines()
+    if not rows:
+        return ""
+
+    width = max(len(row) for row in rows)
+    transposed = []
+
+    for column in range(width):
+        last_row = max(
+            index for index, row in enumerate(rows) if column < len(row)
+        )
+        transposed.append(
+            "".join(
+                row[column] if column < len(row) else " "
+                for row in rows[: last_row + 1]
+            )
+        )
+
+    return "\n".join(transposed)
