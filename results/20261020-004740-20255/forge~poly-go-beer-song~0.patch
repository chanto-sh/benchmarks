+// bottleCount renders a bottle count for use in the lyrics, handling the
+// zero and singular cases.
+func bottleCount(n int) string {
+	switch n {
+	case 0:
+		return "no more bottles"
+	case 1:
+		return "1 bottle"
+	default:
+		return fmt.Sprintf("%d bottles", n)
+	}
