+    def _empty_region(self, x, y):
+        """Return an empty region and the stones bordering it."""
+        region = set()
+        borders = set()
+        pending = [(x, y)]
+
+        while pending:
+            current_x, current_y = pending.pop()
+            if (current_x, current_y) in region:
+                continue
+
+            region.add((current_x, current_y))
+            for neighbor_x, neighbor_y in (
+                (current_x - 1, current_y),
+                (current_x + 1, current_y),
+                (current_x, current_y - 1),
+                (current_x, current_y + 1),
+            ):
+                if not (
+                    0 <= neighbor_y < len(self.board)
+                    and 0 <= neighbor_x < len(self.board[neighbor_y])
+                ):
+                    continue
+
+                point = self.board[neighbor_y][neighbor_x]
+                if point == " ":
+                    pending.append((neighbor_x, neighbor_y))
+                else:
+                    borders.add(point)
+
+        return region, borders
+
+    @staticmethod
+    def _owner(borders):
+        if len(borders) == 1:
+            return borders.pop()
+        return NONE
 
