+func (r *reactor) add(c *cell) {
+	c.order = r.nextOrder
+	r.nextOrder++
+	r.cells = append(r.cells, c)
+}
+
+func (r *reactor) propagate(source *cell) {
+	affected := make(map[*cell]bool)
+	queue := []*cell{source}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, dependent := range current.dependents {
+			if affected[dependent] {
+				continue
+			}
+			affected[dependent] = true
+			queue = append(queue, dependent)
+		}
+	}
+
+	ordered := make([]*cell, 0, len(affected))
+	for c := range affected {
+		ordered = append(ordered, c)
+	}
+	sort.Slice(ordered, func(i, j int) bool {
+		return ordered[i].order < ordered[j].order
+	})
+
+	changed := map[*cell]bool{source: true}
+	for _, c := range ordered {
+		dependencyChanged := false
+		for _, dep := range c.deps {
+			if changed[dep] {
+				dependencyChanged = true
+				break
+			}
+		}
+		if !dependencyChanged {
+			continue
+		}
+
+		oldValue := c.value
+		c.value = c.compute()
+		changed[c] = c.value != oldValue
+	}
+
+	for _, c := range ordered {
+		if changed[c] {
+			c.notify()
+		}
+	}
+}
+
+func (c *cell) notify() {
+	callbacks := append([]*callback(nil), c.callbacks...)
+	value := c.value
+	for _, cb := range callbacks {
+		if cb.active {
+			cb.fn(value)
+		}
+	}
 }
