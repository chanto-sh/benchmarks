 func NewGarden(diagram string, children []string) (*Garden, error) {
-	panic("Please implement the NewGarden function")
+	if !strings.HasPrefix(diagram, "\n") {
+		return nil, errors.New("diagram must start with a newline")
+	}
+
+	rows := strings.Split(diagram[1:], "\n")
+	if len(rows) != 2 {
+		return nil, errors.New("diagram must contain exactly two rows")
+	}
+	if len(rows[0]) != len(rows[1]) {
+		return nil, errors.New("diagram rows must be the same length")
+	}
+	if len(rows[0])%2 != 0 {
+		return nil, errors.New("diagram must contain an even number of cups")
+	}
+	if len(children)*2 != len(rows[0]) {
+		return nil, errors.New("number of children must match number of cups")
+	}
+
+	names := append([]string(nil), children...)
+	sort.Strings(names)
+
+	plantNames := map[byte]string{
+		'G': "grass",
+		'C': "clover",
+		'R': "radishes",
+		'V': "violets",
+	}
+
+	garden := &Garden{plants: make(map[string][]string, len(names))}
+	for i, name := range names {
+		if _, exists := garden.plants[name]; exists {
+			return nil, errors.New("duplicate child name")
+		}
+
+		index := i * 2
+		plants := make([]string, 0, 4)
+		for _, row := range rows {
+			for _, cup := range []byte{row[index], row[index+1]} {
+				plant, ok := plantNames[cup]
+				if !ok {
+					return nil, errors.New("invalid plant code")
+				}
+				plants = append(plants, plant)
+			}
+		}
+		garden.plants[name] = plants
+	}
+
+	return garden, nil
 }
 
