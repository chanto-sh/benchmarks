 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub struct Error;
 
+/// Returns every concrete nucleotide that a (possibly shorthand) nucleotide
+/// stands for, following the IUPAC notation, or `Err` if the letter is not
+/// part of that notation.
+fn nucleotides(codon_letter: u8) -> Result<&'static [u8], Error> {
+    Ok(match codon_letter {
+        b'A' => b"A",
+        b'C' => b"C",
+        b'G' => b"G",
+        b'T' => b"T",
+        // Two-way ambiguity.
+        b'R' => b"AG",
+        b'Y' => b"CT",
+        b'M' => b"AC",
+        b'K' => b"GT",
+        b'S' => b"CG",
+        b'W' => b"AT",
+        // Three-way ambiguity.
+        b'H' => b"ACT",
+        b'B' => b"CGT",
+        b'V' => b"ACG",
+        b'D' => b"AGT",
+        // Four-way ambiguity.
+        b'N' => b"ACGT",
+        _ => return Err(Error),
+    })
+}
