@@ -1,2 +1,12 @@
-def proverb():
-    pass
+def proverb(*pieces, qualifier=None):
+    if not pieces:
+        return []
+
+    result = [
+        f"For want of a {piece} the {next_piece} was lost."
+        for piece, next_piece in zip(pieces, pieces[1:])
+    ]
+
+    qualifier = f"{qualifier} " if qualifier else ""
+    result.append(f"And all for the want of a {qualifier}{pieces[0]}.")
+    return result
