-// Define readCounter and writeCounter types here.
+// readCounter wraps an io.Reader and keeps track of how many bytes and how
+// many read operations have been successfully performed.
+//
+// The mutex protects both fields and is also held while the underlying Read
+// executes, which guarantees that ReadCount always observes a consistent
+// (bytes, ops) pair even when Read is called concurrently.
+type readCounter struct {
+	mu      sync.Mutex
+	reader  io.Reader
+	bytes   int64
+	readOps int
+}
+
+// writeCounter wraps an io.Writer and keeps track of how many bytes and how
+// many write operations have been successfully performed.
+type writeCounter struct {
+	mu       sync.Mutex
+	writer   io.Writer
+	bytes    int64
+	writeOps int
+}
 
-// For the return of the function NewReadWriteCounter, you must also define a type that satisfies the ReadWriteCounter interface.
