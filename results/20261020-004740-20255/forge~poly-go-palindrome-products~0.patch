+type Product struct {
+	Value          int
+	Factorizations [][2]int
+}
+
+// isPalindrome reports whether n reads the same forwards and backwards.
+// A negative number is treated as a palindrome when its magnitude is one,
+// keeping the minus sign in place (e.g. -121).
+func isPalindrome(n int) bool {
+	if n < 0 {
+		n = -n
+	}
+	reversed := 0
+	for m := n; m > 0; m /= 10 {
+		reversed = reversed*10 + m%10
+	}
+	return reversed == n
+}
+
+// Products returns the smallest and largest palindromic products of two
+// factors within the inclusive range [fmin, fmax], together with all of
+// their factorizations within that range.
 func Products(fmin, fmax int) (Product, Product, error) {
-	panic("Please implement the Products function")
+	if fmin > fmax {
+		return Product{}, Product{}, errors.New("fmin > fmax")
+	}
+
+	pairs := make(map[int][][2]int)
+	smallest, largest := 0, 0
+	found := false
+
+	for i := fmin; i <= fmax; i++ {
+		for j := i; j <= fmax; j++ {
+			p := i * j
+			if !isPalindrome(p) {
+				continue
+			}
+			pairs[p] = append(pairs[p], [2]int{i, j})
+			if !found {
+				smallest, largest = p, p
+				found = true
+				continue
+			}
+			if p < smallest {
+				smallest = p
+			}
+			if p > largest {
+				largest = p
+			}
+		}
+	}
+
+	if !found {
+		return Product{}, Product{}, errors.New("no palindromes")
+	}
+
+	return Product{smallest, pairs[smallest]}, Product{largest, pairs[largest]}, nil
 }
