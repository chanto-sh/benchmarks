+use std::collections::HashMap;
+
+const BOOK_PRICE: u32 = 800;
+
+fn bundle_price(size: u32) -> u32 {
+    match size {
+        1 => BOOK_PRICE,
+        2 => 1_520,
+        3 => 2_160,
+        4 => 2_560,
+        5 => 3_000,
+        _ => unreachable!("a bundle contains between one and five books"),
+    }
+}
+
 pub fn lowest_price(books: &[u32]) -> u32 {
-    todo!("Find the lowest price of the bookbasket with books {books:?}")
+    let mut counts = [0u32; 5];
+    for &book in books {
+        if let Some(count) = counts.get_mut((book as usize).wrapping_sub(1)) {
+            *count += 1;
+        }
+    }
+
+    let mut memo = HashMap::new();
+    lowest_price_for_counts(counts, &mut memo)
+}
+
+fn lowest_price_for_counts(counts: [u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
+    if counts.iter().all(|&count| count == 0) {
+        return 0;
+    }
+
+    if let Some(&price) = memo.get(&counts) {
+        return price;
+    }
+
+    let mut best = u32::MAX;
+    for bundle in 1u8..(1 << 5) {
+        if (0..5).any(|i| bundle & (1 << i) != 0 && counts[i] == 0) {
+            continue;
+        }
+
+        let mut remaining = counts;
+        let mut size = 0;
+        for i in 0..5 {
+            if bundle & (1 << i) != 0 {
+                remaining[i] -= 1;
+                size += 1;
+            }
+        }
+
+        best = best.min(bundle_price(size) + lowest_price_for_counts(remaining, memo));
+    }
+
+    memo.insert(counts, best);
+    best
 }
