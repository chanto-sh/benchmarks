+/// Parses a simple math word problem and evaluates it left-to-right.
+///
+/// Returns `None` when the command is not a valid math question, uses an
+/// unsupported operation, or has malformed syntax.
 pub fn answer(command: &str) -> Option<i32> {
-    todo!("Return the result of the command '{command}' or None, if the command is invalid.");
+    let tokens: Vec<&str> = command.split_whitespace().collect();
+
+    // A minimal valid command is: "What is <operand>?"
+    if tokens.len() < 3 {
+        return None;
+    }
+    if !tokens[0].eq_ignore_ascii_case("what") || !tokens[1].eq_ignore_ascii_case("is") {
+        return None;
+    }
+
+    // The question must terminate with a single '?' on the final token.
+    let last = tokens[tokens.len() - 1].strip_suffix('?')?;
+    if last.is_empty() || last.contains('?') {
+        return None;
+    }
+
+    // Operation tokens live between "What is" and the terminating '?'.
+    let mut body: Vec<&str> = Vec::with_capacity(tokens.len() - 2);
+    body.extend_from_slice(&tokens[2..tokens.len() - 1]);
+    body.push(last);
+
+    let mut iter = body.into_iter();
+
+    let mut result = parse_number(iter.next()?)?;
+
+    while let Some(operator) = iter.next() {
+        match operator {
+            "plus" => {
+                let operand = parse_number(iter.next()?)?;
+                result = result.checked_add(operand)?;
+            }
+            "minus" => {
+                let operand = parse_number(iter.next()?)?;
+                result = result.checked_sub(operand)?;
+            }
+            "multiplied" => {
+                if iter.next()? != "by" {
+                    return None;
+                }
+                let operand = parse_number(iter.next()?)?;
+                result = result.checked_mul(operand)?;
+            }
+            "divided" => {
+                if iter.next()? != "by" {
+                    return None;
+                }
+                let operand = parse_number(iter.next()?)?;
+                if operand == 0 {
+                    return None;
+                }
+                result = result.checked_div(operand)?;
+            }
+            #[cfg(feature = "exponentials")]
+            "raised" => {
+                // "<base> raised to the <n>th power"
+                if iter.next()? != "to" || iter.next()? != "the" {
+                    return None;
+                }
+                let exponent = parse_ordinal(iter.next()?)?;
+                if iter.next()? != "power" {
+                    return None;
+                }
+                result = result.checked_pow(exponent)?;
+            }
+            _ => return None,
+        }
+    }
+
+    Some(result)
+}
+
+/// Parses a signed integer operand, rejecting anything that is not one.
+fn parse_number(token: &str) -> Option<i32> {
+    if token.is_empty() || token == "-" || token == "+" {
+        return None;
+    }
+    token.parse::<i32>().ok()
+}
+
+/// Parses an exponent written as an ordinal number, e.g. "5th" or "2nd".
+#[cfg(feature = "exponentials")]
+fn parse_ordinal(token: &str) -> Option<u32> {
+    let digits: &str = token.trim_end_matches(|c: char| c.is_ascii_alphabetic());
+    if digits.is_empty() {
+        return None;
+    }
+    digits.parse::<u32>().ok()
 }
