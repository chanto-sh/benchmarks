+import "fmt"
+
+// ParseOctal converts an octal string to its decimal value, computing the
+// conversion from first principles (no library parsing). Invalid input yields
+// an error and a value of 0.
+func ParseOctal(input string) (int64, error) {
+	var result int64
+
+	for _, digit := range input {
+		if digit < '0' || digit > '7' {
+			return 0, fmt.Errorf("invalid octal digit %q in %q", digit, input)
+		}
+		result = result*8 + int64(digit-'0')
+	}
+
+	return result, nil
 }
