+	for r, line := range lines {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			return nil, fmt.Errorf("row %d is empty", r)
+		}
+		if r > 0 && len(fields) != len(m[0]) {
+			return nil, fmt.Errorf("row %d has %d columns, want %d", r, len(fields), len(m[0]))
