+import (
+	"fmt"
+	"math"
+)
+
+func ParseTrinary(arg string) (int64, error) {
+	if arg == "" {
+		return 0, fmt.Errorf("invalid trinary number: empty string")
+	}
+
+	var value int64
+	for _, digit := range arg {
+		if digit < '0' || digit > '2' {
+			return 0, fmt.Errorf("invalid trinary digit: %q", digit)
+		}
+
+		n := int64(digit - '0')
+		if value > (math.MaxInt64-n)/3 {
+			return 0, fmt.Errorf("trinary number overflows int64")
+		}
+		value = value*3 + n
+	}
+
+	return value, nil
 }
