+// findNode locates value in the tree.
+func findNode(node *Tree, value string) (*Tree, bool) {
+	if node == nil {
+		return nil, false
+	}
+	if node.value == value {
+		return node, true
+	}
+	for _, child := range node.children {
+		if found, ok := findNode(child, value); ok {
+			return found, true
+		}
+	}
+	return nil, false
+}
+
+// parentMap records each node's parent in the original tree.
+func parentMap(root *Tree) map[*Tree]*Tree {
+	parents := make(map[*Tree]*Tree)
+	var visit func(*Tree)
+	visit = func(node *Tree) {
+		for _, child := range node.children {
+			parents[child] = node
+			visit(child)
+		}
+	}
+	visit(root)
+	return parents
+}
+
+// orient builds a tree rooted at node, treating previous as the neighbour
+// that must not be traversed again.
+func orient(node, previous *Tree, parents map[*Tree]*Tree) *Tree {
+	result := New(node.value)
+	for _, child := range node.children {
+		if child != previous {
+			result.children = append(result.children, orient(child, node, parents))
+		}
+	}
+	if parent := parents[node]; parent != nil && parent != previous {
+		result.children = append(result.children, orient(parent, node, parents))
+	}
+	return result
+}
+
+// findPath returns the path from root to value, or nil if value is absent.
+func findPath(root *Tree, value string) []string {
+	if root == nil {
+		return nil
+	}
+	if root.value == value {
+		return []string{root.value}
+	}
+	for _, child := range root.children {
+		if path := findPath(child, value); path != nil {
+			return append([]string{root.value}, path...)
+		}
+	}
+	return nil
 }
