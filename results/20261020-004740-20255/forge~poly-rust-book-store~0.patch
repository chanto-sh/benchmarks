+use std::collections::HashMap;
+
+/// Price in cents of a single book.
+const BOOK_PRICE: u32 = 800;
+
+/// Number of distinct titles in the series.
+const TITLES: usize = 5;
+
+/// Price in cents of a group of `size` distinct books, after its discount.
+fn group_price(size: u32) -> u32 {
+    let discount_percent = match size {
+        0 => 0,
+        1 => 0,
+        2 => 5,
+        3 => 10,
+        4 => 20,
+        5 => 25,
+        _ => unreachable!("a group cannot contain more than {TITLES} distinct books"),
+    };
+    size * BOOK_PRICE * (100 - discount_percent) / 100
+}
+
 pub fn lowest_price(books: &[u32]) -> u32 {
-    todo!("Find the lowest price of the bookbasket with books {books:?}")
+    let mut counts = [0u32; TITLES];
+    for &book in books {
+        if (1..=TITLES as u32).contains(&book) {
+            counts[book as usize - 1] += 1;
+        }
+    }
+    // Books of the same series are interchangeable, so a state is fully
+    // described by its counts sorted in non-decreasing order.
+    counts.sort_unstable();
+    best_price(counts, &mut HashMap::new())
+}
+
+/// Minimum price of the remaining basket, exploring every possible grouping.
+fn best_price(counts: [u32; TITLES], memo: &mut HashMap<[u32; TITLES], u32>) -> u32 {
+    if counts.iter().all(|&count| count == 0) {
+        return 0;
+    }
+    if let Some(&cached) = memo.get(&counts) {
+        return cached;
+    }
+
+    let mut best = u32::MAX;
+    // Each mask selects which of the (up to) five titles form the next group.
+    for mask in 1u32..(1 << TITLES) {
+        let mut remaining = counts;
+        let mut size = 0;
+        let mut usable = true;
+        for (index, count) in remaining.iter_mut().enumerate() {
+            if mask & (1 << index) != 0 {
+                if *count == 0 {
+                    usable = false;
+                    break;
+                }
+                *count -= 1;
+                size += 1;
+            }
+        }
+        if !usable {
+            continue;
+        }
+        remaining.sort_unstable();
+        let candidate = group_price(size) + best_price(remaining, memo);
+        if candidate < best {
+            best = candidate;
+        }
+    }
+
+    memo.insert(counts, best);
+    best
 }
