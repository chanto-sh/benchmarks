 package erratum
 
-func Use(opener ResourceOpener, input string) error {
-	panic("Please implement the Use function")
+// Use opens a resource via opener, frobs it with input and always closes the
+// resource exactly once if it was opened successfully.
+//
+// A TransientError from the opener is retried; any other error is returned
+// immediately. If Frob panics, the resource is defrobbed (when the panic value
+// is a FrobError) and the panic value is returned as an error.
+func Use(opener ResourceOpener, input string) (err error) {
+	var res Resource
+	for {
+		res, err = opener()
+		if err == nil {
+			break
+		}
+		if _, ok := err.(TransientError); !ok {
+			return err
+		}
+	}
+
+	// Registered first, so it runs last: Close must happen after any Defrob.
+	defer res.Close()
+
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+
+		switch e := r.(type) {
+		case FrobError:
+			res.Defrob(e.defrobTag)
+			err = e
+		case *FrobError:
+			res.Defrob(e.defrobTag)
+			err = e
+		case error:
+			err = e
+		default:
+			panic(r)
+		}
+	}()
+
+	res.Frob(input)
+	return nil
 }
