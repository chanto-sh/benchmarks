+fn parse_row_of_digits(rows: &[&str]) -> String {
+    let width = rows[0].len();
+    let mut digits = String::new();
+
+    let mut col = 0;
+    while col < width {
+        let mut matched = '?';
+        for (digit, glyph) in GLYPHS.iter().enumerate() {
+            let same = glyph.iter().enumerate().all(|(r, expected)| {
+                rows[r]
+                    .get(col..col + 3)
+                    .map_or(false, |cell| cell == *expected)
+            });
+            if same {
+                matched = char::from(b'0' + digit as u8);
+                break;
+            }
+        }
+        digits.push(matched);
+        col += 3;
+    }
+
+    digits
+}
