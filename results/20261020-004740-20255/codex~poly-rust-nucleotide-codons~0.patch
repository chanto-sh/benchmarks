+fn expand_codon(codon: &str) -> Option<Vec<[u8; 3]>> {
+    if codon.len() != 3 {
+        return None;
+    }
+
+    let bases = codon.as_bytes();
+    let first = possible_bases(bases[0])?;
+    let second = possible_bases(bases[1])?;
+    let third = possible_bases(bases[2])?;
+    let mut expanded = Vec::with_capacity(first.len() * second.len() * third.len());
+
+    for &a in first {
+        for &b in second {
+            for &c in third {
+                expanded.push([a, b, c]);
+            }
+        }
+    }
