+
+// contains reports whether the whole of needle appears as a contiguous
+// sub-sequence of haystack. An empty needle is contained in any haystack.
+func contains(haystack, needle []int) bool {
+	if len(needle) > len(haystack) {
+		return false
+	}
+	for start := 0; start <= len(haystack)-len(needle); start++ {
+		match := true
+		for i, v := range needle {
+			if haystack[start+i] != v {
+				match = false
+				break
+			}
+		}
+		if match {
+			return true
+		}
+	}
+	return false
 }
