 package beer
 
+import (
+	"fmt"
+	"strings"
+)
+
 func Song() string {
-	panic("Please implement the Song function")
+	song, _ := Verses(99, 0)
+	return song
 }
 
 func Verses(start, stop int) (string, error) {
-	panic("Please implement the Verses function")
+	if start < stop {
+		return "", fmt.Errorf("start verse %d is less than stop verse %d", start, stop)
+	}
+	if start > 99 || stop < 0 {
+		return "", fmt.Errorf("verses must be between 0 and 99")
+	}
+
+	var verses strings.Builder
+	for n := start; n >= stop; n-- {
+		verse, err := Verse(n)
+		if err != nil {
+			return "", err
+		}
+		verses.WriteString(verse)
+		verses.WriteByte('\n')
+	}
+
+	return verses.String(), nil
 }
 
 func Verse(n int) (string, error) {
-	panic("Please implement the Verse function")
+	if n < 0 || n > 99 {
+		return "", fmt.Errorf("verse %d is outside the range 0-99", n)
+	}
+
+	if n == 0 {
+		return "No more bottles of beer on the wall, no more bottles of beer.\n" +
+			"Go to the store and buy some more, 99 bottles of beer on the wall.\n", nil
+	}
+
+	action := "Take one down and pass it around"
+	if n == 1 {
+		action = "Take it down and pass it around"
+	}
+
+	bottles := quantity(n)
+	nextBottles := quantity(n - 1)
+	return fmt.Sprintf("%s of beer on the wall, %s of beer.\n%s, %s of beer on the wall.\n",
+		bottles, bottles, action, nextBottles), nil
+}
+
+func quantity(n int) string {
+	switch n {
+	case 0:
+		return "no more bottles"
+	case 1:
+		return "1 bottle"
+	default:
+		return fmt.Sprintf("%d bottles", n)
+	}
 }
