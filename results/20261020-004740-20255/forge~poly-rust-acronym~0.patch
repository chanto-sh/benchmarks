 pub fn abbreviate(phrase: &str) -> String {
-    todo!("Given the phrase '{phrase}', return its acronym");
+    let mut acronym = String::new();
+    let mut previous: Option<char> = None;
+
+    for character in phrase.chars() {
+        if character.is_whitespace() || character == '-' {
+            previous = None;
+            continue;
+        }
+
+        if !character.is_alphabetic() {
+            continue;
+        }
+
+        let starts_new_word = match previous {
+            None => true,
+            Some(previous) => previous.is_lowercase() && character.is_uppercase(),
+        };
+
+        if starts_new_word {
+            acronym.extend(character.to_uppercase());
+        }
+
+        previous = Some(character);
+    }
+
+    acronym
 }
