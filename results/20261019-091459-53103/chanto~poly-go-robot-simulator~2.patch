 }
 
 func Left() {
-	panic("Please implement the Left function")
+	Step1Robot.Dir = turnLeft(Step1Robot.Dir)
 }
 
 func Advance() {
-	panic("Please implement the Advance function")
+	switch Step1Robot.Dir {
+	case N:
+		Step1Robot.Y++
+	case E:
+		Step1Robot.X++
+	case S:
+		Step1Robot.Y--
+	case W:
+		Step1Robot.X--
+	}
 }
 
 func (d Dir) String() string {
-	panic("Please implement the String function")
+	switch d {
+	case N:
+		return "north"
+	case E:
+		return "east"
+	case S:
+		return "south"
+	case W:
+		return "west"
+	}
+	return fmt.Sprintf("Dir(%d)", int(d))
+}
+
+func turnRight(d Dir) Dir {
+	return (d + 1) % 4
+}
+
+func turnLeft(d Dir) Dir {
+	return (d + 3) % 4
+}
+
+func advancePos(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func inRoom(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
 }
 
