 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	index := make(map[string]int, len(robots))
+	for i := range robots {
+		r := &robots[i]
+		if r.Name == "" {
+			log <- "robot without a name"
+		} else if _, ok := index[r.Name]; ok {
+			log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+		} else {
+			index[r.Name] = i
+		}
+		if !inRoom(extent, r.Pos) {
+			log <- fmt.Sprintf("robot %q placed outside of the room", r.Name)
+		}
+		for j := 0; j < i; j++ {
+			if robots[j].Pos == r.Pos {
+				log <- fmt.Sprintf("robots %q and %q placed at the same place",
+					robots[j].Name, r.Name)
+				break
+			}
+		}
+	}
+
+	if len(robots) == 0 {
+		rep <- robots
+		return
+	}
+
+	done := 0
+	for a := range action {
+		if a.Done {
+			done++
+			if done == len(robots) {
+				break
+			}
+			continue
+		}
+		i, ok := index[a.Name]
+		if !ok {
+			log <- fmt.Sprintf("action from unknown robot %q", a.Name)
+			continue
+		}
+		r := &robots[i]
+		switch a.Command {
+		case 'R':
+			r.Dir = turnRight(r.Dir)
+		case 'L':
+			r.Dir = turnLeft(r.Dir)
+		case 'A':
+			p := advancePos(r.Pos, r.Dir)
+			switch {
+			case !inRoom(extent, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", r.Name)
+			case occupied(robots, i, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into another robot", r.Name)
+			default:
