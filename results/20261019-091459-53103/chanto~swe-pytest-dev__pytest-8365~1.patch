+++ b/testing/test_tmpdir.py
@@ -246,6 +246,48 @@ def test_get_user(monkeypatch):
     assert get_user() is None
 
 
+@pytest.mark.parametrize(
+    "user, expected",
+    [
+        ("regular_user", "regular_user"),
+        ("contoso\\john_doe", "contoso_john_doe"),
+        ("os/\\*?<>|agnostic", "os_______agnostic"),
+    ],
+)
+def test_get_user_sanitizes_illegal_characters(monkeypatch, user, expected):
+    """Test that get_user() replaces characters which are not valid in
+    directory names (#8365).
+    """
+    import getpass
+
+    monkeypatch.setattr(getpass, "getuser", lambda: user)
+    assert get_user() == expected
+
+
+def test_tmpdir_username_with_illegal_characters(
+    pytester: Pytester, monkeypatch
+) -> None:
+    """Test that tmpdir works when the user name contains characters which
+    are not valid in directory names (#8365).
+    """
+    import getpass
+
+    monkeypatch.setattr(getpass, "getuser", lambda: "contoso\\john_doe")
+    temproot = pytester.path / "temproot"
+    temproot.mkdir()
+    monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(temproot))
+    pytester.makepyfile(
+        """
+        def test_some(tmpdir, tmp_path):
+            assert tmpdir.isdir()
+            assert tmp_path.is_dir()
+    """
+    )
+    reprec = pytester.inline_run()
+    reprec.assertoutcome(passed=1)
+    assert (temproot / "pytest-of-contoso_john_doe").is_dir()
+
+
