diff --git a/testing/test_tmpdir.py b/testing/test_tmpdir.py
index d123287..0278062 100644
--- a/testing/test_tmpdir.py
+++ b/testing/test_tmpdir.py
@@ -246,6 +246,24 @@ def test_get_user(monkeypatch):
     assert get_user() is None
 
 
+def test_get_user_sanitizes_illegal_characters(monkeypatch):
+    """Characters not allowed in directory names are replaced."""
+    monkeypatch.setattr("getpass.getuser", lambda: "contoso\\john_doe")
+    assert get_user() == "contoso_john_doe"
+
+
+def test_getbasetemp_sanitizes_illegal_user_characters(monkeypatch, tmp_path):
+    """The basetemp directory can be created when the user name contains
+    characters not allowed in directory names.
+    """
+    monkeypatch.setattr("getpass.getuser", lambda: "contoso/john_doe")
+    monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(tmp_path))
+    factory = TempPathFactory(None, lambda *args: None, _ispytest=True)
+    basetemp = factory.getbasetemp()
+    assert basetemp.exists()
+    assert basetemp.parent.name == "pytest-of-contoso_john_doe"
+
+
