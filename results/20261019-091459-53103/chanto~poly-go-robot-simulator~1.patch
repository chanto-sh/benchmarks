+			log <- fmt.Sprintf("robot %q placed outside of the room", r.Name)
+		}
+	}
+
+	done := 0
+	for done < len(robots) {
+		a := <-action
+		if a.Done {
+			done++
+			continue
+		}
+		i, ok := byName[a.Name]
+		if !ok {
+			log <- fmt.Sprintf("action from unknown robot %q", a.Name)
+			continue
+		}
+		r := &robots[i]
+		switch a.Command {
+		case 'R':
+			r.Dir = (r.Dir + 1) % 4
+		case 'L':
+			r.Dir = (r.Dir + 3) % 4
+		case 'A':
+			p := ahead(r.Dir, r.Pos)
+			switch {
+			case !inRoom(extent, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into a wall", r.Name)
+			case occupied(robots, i, p):
+				log <- fmt.Sprintf("robot %q attempted to advance into another robot", r.Name)
+			default:
+				r.Pos = p
+			}
+		default:
+			log <- fmt.Sprintf("robot %q: undefined command", r.Name)
+		}
+	}
+	rep <- robots
+}
+
+// apply returns the robot state resulting from executing command c in the room.
+func apply(extent Rect, r Step2Robot, c Command) Step2Robot {
+	switch c {
+	case 'R':
+		r.Dir = (r.Dir + 1) % 4
+	case 'L':
+		r.Dir = (r.Dir + 3) % 4
+	case 'A':
+		if p := ahead(r.Dir, r.Pos); inRoom(extent, p) {
+			r.Pos = p
+		}
+	}
+	return r
+}
+
+// ahead returns the position one step in direction d from p.
+func ahead(d Dir, p Pos) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+// inRoom reports whether p lies within the room's extent.
+func inRoom(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
+}
+
+// occupied reports whether a robot other than the one at index self is at p.
+func occupied(robots []Step3Robot, self int, p Pos) bool {
+	for i := range robots {
+		if i != self && robots[i].Pos == p {
+			return true
+		}
+	}
+	return false
 }
