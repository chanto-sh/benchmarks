 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	byName := make(map[string]int)
+	seenPos := make(map[Pos]bool)
+	for i := range robots {
+		r := robots[i]
+		switch {
+		case r.Name == "":
+			log <- "robot without a name"
+		default:
+			if _, ok := byName[r.Name]; ok {
+				log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+			} else {
+				byName[r.Name] = i
+			}
+		}
+		if seenPos[r.Pos] {
+			log <- fmt.Sprintf("robots placed at the same position %v", r.Pos)
+		}
+		seenPos[r.Pos] = true
