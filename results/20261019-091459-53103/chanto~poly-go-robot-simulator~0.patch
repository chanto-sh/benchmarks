+// otherAt reports whether a robot other than the one at index self occupies p.
+func otherAt(robots []Step3Robot, self int, p Pos) bool {
+	for i := range robots {
+		if i != self && robots[i].Pos == p {
+			return true
+		}
+	}
+	return false
