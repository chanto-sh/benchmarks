+    # separated by zero bytes.  Each block is a value in bijective base 255.
+    data = b"\x00".join(_encode_value(a) for a in lst)
+
+    # Shift by one so that the empty list can own key 0, while every
+    # non-empty list owns a positive key.
+    return _bytes_to_int(data) + 1
 
 
