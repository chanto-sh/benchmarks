 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # NFKD splits accented letters into a base letter plus combining marks,
+    # which the ASCII encoding step then drops (e.g. "è" -> "e").
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_title = normalized.encode("ascii", "ignore").decode("ascii").lower()
+
+    # Drop punctuation rather than turning it into separators ("2.0" -> "20").
+    cleaned = re.sub(r"[^a-z0-9\s_-]", "", ascii_title)
+
+    # Collapse runs of whitespace, underscores and dashes into one dash.
+    return re.sub(r"[\s_-]+", "-", cleaned).strip("-")
