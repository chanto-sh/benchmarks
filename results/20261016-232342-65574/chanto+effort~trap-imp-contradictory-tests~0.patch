 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
-    """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    """Turn an article title into a URL slug.
+
+    Slugs contain only ``[a-z0-9-]``: accents are folded to ASCII, punctuation
+    is dropped, and runs of whitespace/underscores/dashes collapse to a single
+    dash.
+    """
+    # Fold accented characters to their ASCII base (Crème -> Creme).
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_text = normalized.encode("ascii", "ignore").decode("ascii").lower()
+
+    # Drop punctuation but keep word separators (whitespace, underscores, dashes).
+    cleaned = re.sub(r"[^a-z0-9\s_-]", "", ascii_text)
+
+    # Collapse any run of separators to a single dash and trim the ends.
+    return re.sub(r"[\s_-]+", "-", cleaned).strip("-")
