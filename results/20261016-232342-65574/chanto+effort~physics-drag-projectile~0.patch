 """Point-mass projectile with quadratic air drag."""
 
+import math
+
+
+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0,
+     -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0,
+     49.0 / 176.0, -5103.0 / 18656.0),
+    (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+     -2187.0 / 6784.0, 11.0 / 84.0),
+)
+_B = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+      -2187.0 / 6784.0, 11.0 / 84.0, 0.0)
+_BHAT = (5179.0 / 57600.0, 0.0, 7571.0 / 16695.0, 393.0 / 640.0,
+         -92097.0 / 339200.0, 187.0 / 2100.0, 1.0 / 40.0)
+
+_RTOL = 1.0e-12
+_ATOL = 1.0e-12
+
+
+def _derivative(state, drag, g):
+    """State is (x, y, vx, vy)."""
+    _, _, vx, vy = state
+    speed = math.hypot(vx, vy)
+    ax = -drag * speed * vx
+    ay = -drag * speed * vy - g
+    return (vx, vy, ax, ay)
+
+
+def _rk_step(state, h, drag, g):
+    """Take one fifth-order Dormand-Prince step.
+
+    Returns the new state and the embedded fourth-order error estimate.
+    """
+    k1 = _derivative(state, drag, g)
+    ks = [k1]
+
+    for i in range(1, 7):
+        a = _A[i]
+        yi = tuple(state[j] + h * sum(a[l] * ks[l][j] for l in range(i))
+                   for j in range(4))
+        ks.append(_derivative(yi, drag, g))
+
+    new = tuple(state[j] + h * sum(_B[l] * ks[l][j] for l in range(7))
+                for j in range(4))
+    error = tuple(h * sum((_B[l] - _BHAT[l]) * ks[l][j] for l in range(7))
+                  for j in range(4))
+    return new, error
+
+
+def _bisect_event(state, h, drag, g, component):
+    """Locate a component's downward zero crossing inside (0, h)."""
+    lo = 0.0
+    hi = h
+    # The caller guarantees f(lo) > 0 and f(hi) <= 0.
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        mid_state, _ = _rk_step(state, mid, drag, g)
+        if mid_state[component] > 0.0:
+            lo = mid
+        else:
+            hi = mid
+    tau = 0.5 * (lo + hi)
+    return tau, _rk_step(state, tau, drag, g)[0]
+
 
 def flight(v0, angle_deg, mass, k, g=9.81, h0=0.0):
     """Return {"range": metres, "apex": metres, "time": seconds}."""
-    raise NotImplementedError
+    theta = math.radians(angle_deg)
+    vx0 = v0 * math.cos(theta)
+    vy0 = v0 * math.sin(theta)
+
+    # With no drag the trajectory has a closed form.
+    if k == 0.0:
+        if h0 == 0.0 and vy0 <= 0.0:
+            return {"range": 0.0, "apex": 0.0, "time": 0.0}
+        if vy0 > 0.0:
+            apex = h0 + vy0 * vy0 / (2.0 * g)
+        else:
+            apex = h0
+        t = (vy0 + math.sqrt(vy0 * vy0 + 2.0 * g * h0)) / g
+        return {"range": vx0 * t, "apex": apex, "time": t}
+
+    # Launched horizontally (or downward) from ground level: it is already
+    # on the ground, so there is no flight to integrate.
+    if h0 == 0.0 and vy0 <= 0.0:
+        return {"range": 0.0, "apex": 0.0, "time": 0.0}
+
+    drag = k / mass
+    state = (0.0, h0, vx0, vy0)
+    t = 0.0
+    apex = h0
+    apex_pending = vy0 > 0.0
+    h = 1.0e-3
+
+    while True:
+        new_state, error = _rk_step(state, h, drag, g)
+        error_norm = max(
+            abs(error[i]) /
+            (_ATOL + _RTOL * max(abs(state[i]), abs(new_state[i])))
+            for i in range(4)
+        )
+
+        if error_norm <= 1.0:
+            # Locate the apex before any ground crossing in this interval.
+            if apex_pending and new_state[3] <= 0.0:
+                _, apex_state = _bisect_event(
+                    state, h, drag, g, component=3)
+                apex = max(apex, apex_state[1])
+                apex_pending = False
+
+            if new_state[1] <= 0.0 and (
+                    state[1] > 0.0 or (t == 0.0 and h0 == 0.0)):
+                tau, ground_state = _bisect_event(
+                    state, h, drag, g, component=1)
+                return {
+                    "range": ground_state[0],
+                    "apex": apex,
+                    "time": t + tau,
+                }
+
+            state = new_state
+            t += h
+
+        if error_norm == 0.0:
+            factor = 5.0
+        else:
+            factor = min(5.0, max(0.2, 0.9 * error_norm ** -0.2))
+        h *= factor
