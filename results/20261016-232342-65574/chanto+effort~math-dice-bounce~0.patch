 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # E[i] is the expected number of further turns from square i (0 <= i < n).
+    # For each i: E[i] = 1 + (1/k) * sum(E[land(i, d)] for d in 1..k),
+    # with E[n] = 0.  Build the linear system A * E = b and solve it exactly.
+    size = n
+    a = [[Fraction(0) for _ in range(size)] for _ in range(size)]
+    b = [Fraction(1) for _ in range(size)]
+
+    for i in range(size):
+        a[i][i] = Fraction(1)
+        for d in range(1, k + 1):
+            j = i + d
+            if j > n:
+                j = 2 * n - j
+            if j < n:
+                a[i][j] -= Fraction(1, k)
+
+    # Gaussian elimination with exact arithmetic.
+    for col in range(size):
+        pivot = next(row for row in range(col, size) if a[row][col] != 0)
+        if pivot != col:
+            a[col], a[pivot] = a[pivot], a[col]
+            b[col], b[pivot] = b[pivot], b[col]
+
+        inv = Fraction(1) / a[col][col]
+        for j in range(col, size):
+            a[col][j] *= inv
+        b[col] *= inv
+
+        for row in range(size):
+            if row == col or a[row][col] == 0:
+                continue
+            factor = a[row][col]
+            for j in range(col, size):
+                a[row][j] -= factor * a[col][j]
+            b[row] -= factor * b[col]
+
+    return b[0]
