+    def test_eccentric_orbit_long_term_energy(self):
+        # e = 0.6 orbit; perihelion passage exercises the integrator
+        m = [1.0, 1.0]
+        e = 0.6
+        r = 1.0 + e
+        v = math.sqrt(2.0 * (1.0 - e) / (1.0 + e))
+        pos = [[-r / 2.0, 0.0], [r / 2.0, 0.0]]
+        vel = [[0.0, -v / 2.0], [0.0, v / 2.0]]
+        e0 = energy(m, pos, vel)
+        p0 = total_momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        for actual, expected in zip(total_momentum(m, q), p0):
+            self.assertAlmostEqual(actual, expected, places=12)
+
+    def test_figure_eight_three_body_energy(self):
+        # Chenciner-Montgomery figure-eight orbit
+        m = [1.0, 1.0, 1.0]
+        x, y = 0.97000436, -0.24308753
+        vx, vy = 0.466203685, 0.43236573
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vel = [[vx, vy], [vx, vy], [-2.0 * vx, -2.0 * vy]]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-9)
+
+    def test_momentum_conserved_for_nonzero_boost(self):
+        # A uniform boost leaves the relative orbit unchanged but gives
+        # the system a nonzero total momentum to track.
+        m = [1.0, 1.0]
+        v = math.sqrt(1.0 / 4.0)
+        boost = [0.3, -0.7]
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[boost[0], -v + boost[1]], [boost[0], v + boost[1]]]
+        p0 = total_momentum(m, vel)
+
+        _, q = simulate(m, pos, vel, 0.01, 5000)
+
+        for actual, expected in zip(total_momentum(m, q), p0):
+            self.assertAlmostEqual(actual, expected, places=12)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[-1.0, 0.5], [1.0, -0.5]]
+        vel = [[0.0, -0.2], [0.0, 0.1]]
+        pos_before = [xy[:] for xy in pos]
+        vel_before = [vx[:] for vx in vel]
+
+        simulate(m, pos, vel, 0.01, 100)
+
+        self.assertEqual(pos, pos_before)
+        self.assertEqual(vel, vel_before)
+
+    def test_zero_steps_returns_copies(self):
+        m = [1.0]
+        pos = [[1.0, 2.0]]
+        vel = [[3.0, 4.0]]
+
+        p, q = simulate(m, pos, vel, 0.01, 0)
+
+        self.assertEqual(p, pos)
+        self.assertEqual(q, vel)
+        self.assertIsNot(p, pos)
