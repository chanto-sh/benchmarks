 """Small 2D gravitational N-body integrator."""
 import math
 
+# Coefficients for the 4th-order Yoshida composition of leapfrog steps.
+_CBRT2 = 2.0 ** (1.0 / 3.0)
+_YOSHIDA_WEIGHTS = (
+    1.0 / (2.0 - _CBRT2),
+    -_CBRT2 / (2.0 - _CBRT2),
+    1.0 / (2.0 - _CBRT2),
+)
+
 
 def accelerations(masses, positions, G=1.0):
     n = len(masses)
     acc = [[0.0, 0.0] for _ in range(n)]
     for i in range(n):
-        for j in range(n):
-            if i == j:
-                continue
-            dx = positions[j][0] - positions[i][0]
-            dy = positions[j][1] - positions[i][1]
-            r3 = (dx * dx + dy * dy) ** 1.5
-            acc[i][0] += G * masses[j] * dx / r3
-            acc[i][1] += G * masses[j] * dy / r3
+        xi, yi = positions[i]
+        mi = masses[i]
+        for j in range(i + 1, n):
+            dx = positions[j][0] - xi
+            dy = positions[j][1] - yi
+            r2 = dx * dx + dy * dy
+            inv_r3 = 1.0 / (r2 * math.sqrt(r2))
+            # Accumulate each pair from a single force so the two
+            # contributions are equal and opposite (momentum conservation).
+            si = G * masses[j] * inv_r3
+            sj = G * mi * inv_r3
+            acc[i][0] += si * dx
+            acc[i][1] += si * dy
+            acc[j][0] -= sj * dx
+            acc[j][1] -= sj * dy
     return acc
 
 
@@ -29,5 +44,41 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses a 4th-order Yoshida composition of kick-drift-kick leapfrog
+    steps.  Each leapfrog substep is symplectic and time-reversible, so
+    energy stays bounded over long runs, while the composition reduces
+    the energy error to O(dt**4).
+    """
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    if n == 0 or steps == 0:
+        return pos, vel
+
+    acc = accelerations(masses, pos, G)
+
+    for _ in range(steps):
+        for weight in _YOSHIDA_WEIGHTS:
+            h = weight * dt
+            half_h = 0.5 * h
+
+            # Half kick, then drift.
+            for i in range(n):
+                vx = vel[i][0] + half_h * acc[i][0]
+                vy = vel[i][1] + half_h * acc[i][1]
+                vel[i][0] = vx
+                vel[i][1] = vy
+                pos[i][0] += vx * h
+                pos[i][1] += vy * h
+
+            acc = accelerations(masses, pos, G)
+
+            # Second half kick with the new forces.
+            for i in range(n):
+                vel[i][0] += half_h * acc[i][0]
+                vel[i][1] += half_h * acc[i][1]
+
+    return pos, vel
