+    def test_eccentric_binary_energy_is_bounded(self):
+        # a = 1, e = 0.6, total mass 2; exercise a close pericentre passage
+        m = [1.0, 1.0]
+        a, e = 1.0, 0.6
+        r = a * (1.0 - e)
+        v = math.sqrt((1.0 + e) / (a * (1.0 - e)))
+        pos = [[-r, 0.0], [r, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 50000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 2e-4)
+
+    def test_unequal_masses_conserve_momentum(self):
+        # circular orbit of a 1:3 binary, started with zero total momentum
+        m = [1.0, 3.0]
+        vrel = 2.0
+        pos = [[-0.75, 0.0], [0.25, 0.0]]
+        vel = [[0.0, -0.75 * vrel], [0.0, 0.25 * vrel]]
+        p0 = total_momentum(m, vel)
+        pos_copy = [list(xy) for xy in pos]
+        vel_copy = [list(xy) for xy in vel]
+
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+
+        self.assertEqual(pos, pos_copy)
+        self.assertEqual(vel, vel_copy)
+        p1 = total_momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-10)
+
+    def test_three_body_figure_eight(self):
