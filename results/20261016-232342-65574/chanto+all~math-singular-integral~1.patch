 """Frequency response of the detector model."""
 import math
+from decimal import Decimal, localcontext
+
+_PI = math.pi
+_PI_DECIMAL = Decimal(
+    "3.141592653589793238462643383279502884197169399375105820974944592307816406286"
+)
+
+
+def _fresnel_c_series(z):
+    """Fresnel C(z) for z < 5 using its alternating power series.
+
+    The terms can be much larger than the result, so use Decimal to avoid
+    catastrophic cancellation.
+    """
+    with localcontext() as ctx:
+        ctx.prec = 50
+        z = Decimal(z)
+        y = _PI_DECIMAL * z * z / 2
+        y2 = y * y
+        term = Decimal(1)
+        total = term
+        n = 0
+        while True:
+            term *= -y2 * (4 * n + 1) / (
+                Decimal(2 * n + 1) * Decimal(2 * n + 2) * Decimal(4 * n + 5)
+            )
+            total += term
+            n += 1
+            if abs(term) < Decimal("1e-45"):
+                break
+        return float(z * total)
+
+
+def _fresnel_c_asymptotic(z):
+    """Fresnel C(z) for z >= 5 via its asymptotic expansion."""
+    z2 = z * z
+    z4 = z2 * z2
+    phase = _PI * z2 / 2
+    sin_phase = math.sin(phase)
+    cos_phase = math.cos(phase)
+
+    # C(z) = 1/2 + A(z) sin(phase) - B(z) cos(phase)
+    a = 1.0 / (_PI * z)
+    a_sum = a
+    prev = abs(a)
+    k = 0
+    while True:
+        a *= -((4 * k + 1) * (4 * k + 3)) / (_PI * _PI * z4)
+        if abs(a) >= prev:
+            break
+        a_sum += a
+        prev = abs(a)
+        k += 1
+        if prev < 1e-20:
+            break
+
+    b = 1.0 / (_PI * _PI * z2 * z)
+    b_sum = b
+    prev = abs(b)
+    k = 0
+    while True:
+        b *= -((4 * k + 3) * (4 * k + 5)) / (_PI * _PI * z4)
+        if abs(b) >= prev:
+            break
+        b_sum += b
+        prev = abs(b)
+        k += 1
+        if prev < 1e-20:
+            break
+
+    return 0.5 + a_sum * sin_phase - b_sum * cos_phase
 
 
