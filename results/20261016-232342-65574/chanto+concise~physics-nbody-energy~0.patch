 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick), a symplectic second-order scheme.
+    Its energy error stays bounded over long integrations instead of drifting.
+    Inputs are copied and left unchanged.
+    """
+    n = len(masses)
+    pos = [[float(positions[i][0]), float(positions[i][1])] for i in range(n)]
+    vel = [[float(velocities[i][0]), float(velocities[i][1])] for i in range(n)]
+    if steps <= 0 or n == 0:
+        return pos, vel
+
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        # Half kick with the current accelerations, then a full drift.
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        # Recompute forces at the new positions, then finish the kick.
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+    return pos, vel
