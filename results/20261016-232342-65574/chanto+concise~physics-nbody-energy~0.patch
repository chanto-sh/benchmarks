+    def test_figure_eight_long_term_energy_and_momentum(self):
+        # Periodic three-body figure-eight solution (masses and G equal to 1).
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753],
+               [-0.97000436, 0.24308753],
+               [0.0, 0.0]]
+        vx, vy = 0.4662036850, 0.4323657300
+        vel = [[vx, vy], [vx, vy], [-2.0 * vx, -2.0 * vy]]
+        e0 = energy(m, pos, vel)
+        p0 = momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+        for got, expected in zip(momentum(m, q), p0):
+            self.assertAlmostEqual(got, expected, delta=1e-10)
+
+    def test_eccentric_binary_energy(self):
+        # Equal-mass binary with a = 1, e = 0.6, started at periapsis.
+        m = [1.0, 1.0]
+        r_peri = 0.4
+        v = math.sqrt(2.0 * (2.0 / r_peri - 1.0)) / 2.0
+        pos = [[-r_peri / 2.0, 0.0], [r_peri / 2.0, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.001, 50000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_momentum_and_inputs_unchanged(self):
+        # Large mass ratio, with nonzero total momentum.
+        m = [1000.0, 1.0, 1.0]
+        pos = [[0.0, 0.0], [10.0, 0.0], [-20.0, 0.0]]
+        vel = [[0.0, 0.0], [0.0, math.sqrt(1000.0 / 10.0)],
+               [0.0, -math.sqrt(1000.0 / 20.0)]]
+        pos_before = copy.deepcopy(pos)
+        vel_before = copy.deepcopy(vel)
+        p0 = momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 10000)
+        self.assertEqual(pos, pos_before)
+        self.assertEqual(vel, vel_before)
+        for got, expected in zip(momentum(m, q), p0):
+            self.assertAlmostEqual(got, expected, delta=1e-9)
+
+    def test_zero_steps_returns_unchanged_copies(self):
+        m = [1.0, 2.0]
+        pos = [[0.0, 1.0], [2.0, -1.0]]
+        vel = [[0.3, 0.4], [-0.2, 0.1]]
+        p, q = simulate(m, pos, vel, 0.1, 0)
+        self.assertEqual(p, pos)
+        self.assertEqual(q, vel)
+        self.assertIsNot(p, pos)
