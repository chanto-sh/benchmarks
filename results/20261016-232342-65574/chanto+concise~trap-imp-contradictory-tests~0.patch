 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents to their ASCII base letters (Crème -> Creme).
+    title = unicodedata.normalize("NFKD", title)
+    title = title.encode("ascii", "ignore").decode("ascii").lower()
+    # Underscores and hyphens are word separators.
+    title = title.replace("_", " ")
+    # Drop all remaining punctuation without leaving a separator,
+    # so "2.0" -> "20" and "What's" -> "whats".
+    title = re.sub(r"[^a-z0-9\s-]", "", title)
+    # Collapse whitespace/hyphen runs into single dashes and trim.
+    title = re.sub(r"[\s-]+", "-", title)
+    return title.strip("-")
