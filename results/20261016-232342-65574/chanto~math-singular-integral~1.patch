 import math
 
 
+# 16-point Gauss-Legendre nodes and weights on [-1, 1].  Only the positive
+# half is listed; the rule is symmetric.
+_GL_NODES = (
+    0.09501250983763744,
+    0.2816035507792589,
+    0.4580167776572274,
