@@ -30,4 +30,41 @@ def energy(masses, positions, velocities, G=1.0):
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
     """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+    if steps <= 0:
+        return pos, vel
+
+    total_mass = sum(masses)
+    p0x = sum(m * v[0] for m, v in zip(masses, vel))
+    p0y = sum(m * v[1] for m, v in zip(masses, vel))
+
+    # Velocity Verlet (kick-drift-kick): symplectic and time-reversible, so
+    # energy oscillates around its initial value instead of drifting.
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    half_dt2 = 0.5 * dt * dt
+    for _ in range(steps):
+        for i in range(n):
+            pos[i][0] += vel[i][0] * dt + acc[i][0] * half_dt2
+            pos[i][1] += vel[i][1] * dt + acc[i][1] * half_dt2
+
+        new_acc = accelerations(masses, pos, G)
+
+        for i in range(n):
+            vel[i][0] += half_dt * (acc[i][0] + new_acc[i][0])
+            vel[i][1] += half_dt * (acc[i][1] + new_acc[i][1])
+
+        acc = new_acc
+
+    # Remove the tiny centre-of-mass drift caused by floating-point roundoff
+    # while preserving any initial net momentum.
+    if total_mass:
+        dvx = (p0x - sum(m * v[0] for m, v in zip(masses, vel))) / total_mass
+        dvy = (p0y - sum(m * v[1] for m, v in zip(masses, vel))) / total_mass
+        for v in vel:
+            v[0] += dvx
+            v[1] += dvy
+
+    return pos, vel
