+    def test_long_run_unequal_masses_and_momentum(self):
+        # Circular binary with unequal masses and a common drift velocity.
+        m1, m2 = 2.0, 1.0
+        total = m1 + m2
+        r1, r2 = m2 / total, m1 / total
+        omega = math.sqrt(total)
+        drift = (0.1, -0.05)
+        m = [m1, m2]
+        pos = [[-r1, 0.0], [r2, 0.0]]
+        vel = [[drift[0], drift[1] - omega * r1],
+               [drift[0], drift[1] + omega * r2]]
+
+        p0 = [sum(mi * v[0] for mi, v in zip(m, vel)),
+              sum(mi * v[1] for mi, v in zip(m, vel))]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+        p1 = [sum(mi * v[0] for mi, v in zip(m, q)),
+              sum(mi * v[1] for mi, v in zip(m, q))]
+        self.assertAlmostEqual(p1[0], p0[0], places=14)
+        self.assertAlmostEqual(p1[1], p0[1], places=14)
+
+    def test_eccentric_orbit_energy_is_bounded(self):
+        # Equal masses with an eccentric (a=1.5, r_peri=1) orbit.
+        m = [1.0, 1.0]
+        v = 0.5 * math.sqrt(2.0 * (2.0 - 1.0 / 1.5))
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+
+    def test_figure_eight_three_body(self):
+        # Classic stable three-body figure-eight orbit.
+        x, y = 0.97000436, -0.24308753
+        vx, vy = 0.4662036850, 0.4323657300
+        m = [1.0, 1.0, 1.0]
+        pos = [[x, y], [-x, -y], [0.0, 0.0]]
+        vel = [[vx, vy], [vx, vy], [-2.0 * vx, -2.0 * vy]]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        self.assertAlmostEqual(sum(v[0] for v in q), 0.0, places=13)
+        self.assertAlmostEqual(sum(v[1] for v in q), 0.0, places=13)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0, 0.5]
+        pos = [[-2.0, 0.0], [1.0, 0.5], [0.0, -1.0]]
+        vel = [[0.1, 0.2], [-0.1, 0.0], [0.0, -0.1]]
+        original = copy.deepcopy((m, pos, vel))
+
+        simulate(m, pos, vel, 0.001, 10)
+
+        self.assertEqual((m, pos, vel), original)
+
 
 if __name__ == "__main__":
     unittest.main()
