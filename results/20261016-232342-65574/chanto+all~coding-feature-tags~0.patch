diff --git a/notes/tags.py b/notes/tags.py
new file mode 100644
index 0000000..a3ccaf2
--- /dev/null
+++ b/notes/tags.py
@@ -0,0 +1,26 @@
+class InvalidTag(ValueError):
+    """A tag is empty or contains a forbidden character."""
+
+
+def normalize_tag(raw):
+    tag = raw.strip().lower()
+    if not tag or any(c.isspace() or c in ",#" for c in tag):
+        raise InvalidTag(raw)
+    return tag
+
+
+def normalize_tags(raw_tags):
+    """Lowercase/trim tags, dropping repeats and keeping first-seen order."""
+    seen = set()
+    tags = []
+    for raw in raw_tags:
+        tag = normalize_tag(raw)
+        if tag not in seen:
+            seen.add(tag)
+            tags.append(tag)
+    return tags
+
+
+def query_tags(raw_tags):
+    """Tags used for filtering: matching is case-insensitive."""
+    return [t.strip().lower() for t in raw_tags]
