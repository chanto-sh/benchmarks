diff --git a/notes/fmt.py b/notes/fmt.py
index 13fbf61..dc1d717 100644
--- a/notes/fmt.py
+++ b/notes/fmt.py
@@ -1,11 +1,29 @@
+def _tags(tags):
+    return " ".join(f"#{t}" for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + _tags(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_tags(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
+
+
+def tag_lines(notes):
+    """Rows of `notes tags`: most used first, ties alphabetically."""
+    counts = {}
+    for note in notes:
+        for tag in note.tags:
+            counts[tag] = counts.get(tag, 0) + 1
+    return [f"{name} {count}" for name, count in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]
