 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of the n-point Gauss-Legendre rule."""
+    roots = []
+    root_weights = []
+    half = (n + 1) // 2
+    for i in range(1, half + 1):
+        # Initial approximation to the i-th root of P_n.
+        z = math.cos(math.pi * (i - 0.25) / (n + 0.5))
+        for _ in range(100):
+            p0, p1 = 1.0, z
+            for j in range(2, n + 1):
+                p0, p1 = p1, ((2 * j - 1) * z * p1 - (j - 1) * p0) / j
+            derivative = n * (z * p1 - p0) / (z * z - 1.0)
+            step = p1 / derivative
+            z -= step
+            if abs(step) < 1e-15:
+                break
+
+        # Re-evaluate the derivative at the converged node.
+        p0, p1 = 1.0, z
+        for j in range(2, n + 1):
+            p0, p1 = p1, ((2 * j - 1) * z * p1 - (j - 1) * p0) / j
+        derivative = n * (z * p1 - p0) / (z * z - 1.0)
+        weight = 2.0 / ((1.0 - z * z) * derivative * derivative)
+
+        roots.append(z)
+        root_weights.append(weight)
+
+    nodes = [-z for z in roots] + list(reversed(roots))
+    weights = root_weights + list(reversed(root_weights))
+
+    # Make the rule exact for a constant integrand to rounding precision.
+    scale = 2.0 / math.fsum(weights)
+    weights = [weight * scale for weight in weights]
+    return tuple(nodes), tuple(weights)
+
+
+_GL_NODES, _GL_WEIGHTS = _gauss_legendre(32)
+_PHASE_STEP = math.pi / 2.0
+
