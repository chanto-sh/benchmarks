 from fractions import Fraction
 
 
+def _solve(matrix, rhs):
+    """Solve a square linear system exactly with Gauss-Jordan elimination."""
+    size = len(matrix)
+    for col in range(size):
+        pivot = next(row for row in range(col, size) if matrix[row][col] != 0)
+        if pivot != col:
+            matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+            rhs[col], rhs[pivot] = rhs[pivot], rhs[col]
+
+        divisor = matrix[col][col]
+        for j in range(col, size):
+            matrix[col][j] /= divisor
+        rhs[col] /= divisor
+
+        for row in range(size):
+            if row == col:
+                continue
+            factor = matrix[row][col]
+            if factor == 0:
+                continue
+            for j in range(col, size):
+                matrix[row][j] -= factor * matrix[col][j]
+            rhs[row] -= factor * rhs[col]
+
+    return rhs
+
+
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # E[i] is the expected number of turns from square i. Scaling the
+    # equation "k * E[i] = k + sum(E[next])" keeps the coefficients integral.
+    matrix = [[Fraction(0) for _ in range(n)] for _ in range(n)]
+    rhs = [Fraction(k) for _ in range(n)]
+
+    for i in range(n):
+        matrix[i][i] += k
+        for roll in range(1, k + 1):
+            target = i + roll
+            if target > n:
+                target = 2 * n - target
+            if target < n:  # landing on n ends the game (E[n] = 0)
+                matrix[i][target] -= 1
+
+    return _solve(matrix, rhs)[0]
