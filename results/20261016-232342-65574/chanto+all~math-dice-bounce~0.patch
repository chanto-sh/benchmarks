@@ -3,4 +3,15 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # Measure positions by their distance d = n - i from the goal.  A roll r
+    # changes d to |d - r| (bouncing is simply the reflection past n).
+    # For 1 <= d <= k the solution is E[d] = k; beyond that only the previous
+    # k distances are reachable.
+    expected = [Fraction(0)] * (n + 1)
+    for d in range(1, min(k, n) + 1):
+        expected[d] = Fraction(k)
+
+    for d in range(k + 1, n + 1):
+        expected[d] = 1 + sum(expected[d - k:d]) / k
+
+    return expected[n]
