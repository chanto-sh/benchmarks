 """Point-mass projectile with quadratic air drag."""
 
+from math import cos, hypot, radians, sin
+
+# The table is printed to four significant figures, so integrate well beyond
+# that precision.  Dormand-Prince 5(4) with these tolerances is comfortably
+# accurate for ordinary launch parameters.
+_RTOL = 1e-12
+_ATOL = 1e-12
+
+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0, -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0, 49.0 / 176.0,
+     -5103.0 / 18656.0),
+)
+_B5 = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+       -2187.0 / 6784.0, 11.0 / 84.0)
+_B4 = (5179.0 / 57600.0, 0.0, 7571.0 / 16695.0, 393.0 / 640.0,
+       -92097.0 / 339200.0, 187.0 / 2100.0, 1.0 / 40.0)
+
+
+def _deriv(state, g, drag):
+    """Derivative of (x, y, vx, vy) for quadratic drag."""
+    _, _, vx, vy = state
+    speed = hypot(vx, vy)
+    return (vx, vy, -drag * speed * vx, -g - drag * speed * vy)
+
+
+def _step(state, h, g, drag):
+    """Return a Dormand-Prince step and its embedded error norm."""
+    stages = [_deriv(state, g, drag)]
+
+    for i in range(1, 6):
+        a = _A[i]
+        y_stage = tuple(
+            state[j] + h * sum(a[l] * stages[l][j] for l in range(i))
+            for j in range(4)
+        )
+        stages.append(_deriv(y_stage, g, drag))
+
+    y5 = tuple(
+        state[j] + h * sum(_B5[l] * stages[l][j] for l in range(6))
+        for j in range(4)
+    )
+    stages.append(_deriv(y5, g, drag))
+    y4 = tuple(
+        state[j] + h * sum(_B4[l] * stages[l][j] for l in range(7))
+        for j in range(4)
+    )
+
+    error = 0.0
+    for j in range(4):
+        scale = _ATOL + _RTOL * max(abs(state[j]), abs(y5[j]))
+        error = max(error, abs(y5[j] - y4[j]) / scale)
+    return y5, error
+
+
+def _initial_step(state, g, drag):
+    """Choose a conservative first step size."""
+    h = 0.01
+    speed = hypot(state[2], state[3])
+    if drag > 0.0 and speed > 0.0:
+        # Do not try to jump over the drag time scale.
+        h = min(h, 0.1 / (drag * speed))
+    return h
+
+
+def _integrate(state, duration, g, drag):
+    """Integrate from state for exactly duration seconds."""
+    if duration <= 0.0:
+        return state
+
+    t = 0.0
+    h = min(_initial_step(state, g, drag), duration)
+    time_tol = 1e-14 * max(1.0, duration)
+
+    while t < duration:
+        remaining = duration - t
+        if h > remaining:
+            h = remaining
+
+        new_state, error = _step(state, h, g, drag)
+
+        if error <= 1.0 or h <= time_tol:
+            t_new = t + h
+            if t_new >= duration or duration - t_new <= time_tol:
+                return new_state
+
+            state = new_state
+            t = t_new
+            if error == 0.0:
+                factor = 5.0
+            else:
+                factor = min(5.0, max(0.2, 0.9 * error ** -0.2))
+            h = min(h * factor, duration - t)
+        else:
+            h *= max(0.1, 0.9 * error ** -0.2)
+
+    return state
+
+
+def _event_time(state, h, event, g, drag):
+    """Locate the first zero of event(state) in (0, h] by bisection."""
+    lo = 0.0
+    hi = h
+
+    # event(state) is positive at lo and non-positive at hi by construction.
+    for _ in range(80):
+        mid = 0.5 * (lo + hi)
+        if mid == lo or mid == hi:
+            break
+        value = event(_integrate(state, mid, g, drag))
+        if value > 0.0:
+            lo = mid
+        else:
+            hi = mid
+
+    return 0.5 * (lo + hi)
+
 
 def flight(v0, angle_deg, mass, k, g=9.81, h0=0.0):
     """Return {"range": metres, "apex": metres, "time": seconds}."""
-    raise NotImplementedError
+    if mass <= 0.0:
+        raise ValueError("mass must be positive")
+    if k < 0.0:
+        raise ValueError("k must be non-negative")
+    if h0 < 0.0:
+        raise ValueError("h0 must be non-negative")
+
+    drag = k / mass
+    theta = radians(angle_deg)
+    vx = v0 * cos(theta)
+    vy = v0 * sin(theta)
+    state = (0.0, float(h0), vx, vy)
+
+    # With no upward motion and no height to fall from, the flight is over
+    # at the instant of launch.
+    if h0 == 0.0 and vy <= 0.0:
+        return {"range": 0.0, "apex": float(h0), "time": 0.0}
+
+    apex = float(h0)
+    apex_found = vy <= 0.0
+    t = 0.0
+    h = _initial_step(state, g, drag)
+    time_tol = 1e-14 * max(1.0, h)
+
+    for _ in range(10_000_000):
+        new_state, error = _step(state, h, g, drag)
+
+        if error > 1.0 and h > time_tol:
+            h *= max(0.1, 0.9 * error ** -0.2)
+            continue
+
+        # The apex is the first point where the vertical velocity changes
+        # from upward to downward.
+        if not apex_found and state[3] > 0.0 and new_state[3] <= 0.0:
+            dt = _event_time(state, h, lambda s: s[3], g, drag)
+            state = _integrate(state, dt, g, drag)
+            t += dt
+            apex = state[1]
+            apex_found = True
+            time_tol = 1e-14 * max(1.0, t)
+            h = _initial_step(state, g, drag)
+            continue
+
+        # Landing is the first crossing of y = 0.
+        if state[1] > 0.0 and new_state[1] <= 0.0:
+            dt = _event_time(state, h, lambda s: s[1], g, drag)
+            state = _integrate(state, dt, g, drag)
+            return {"range": state[0], "apex": apex, "time": t + dt}
+
+        state = new_state
+        t += h
+        time_tol = 1e-14 * max(1.0, t)
+
+        if error == 0.0:
+            factor = 5.0
+        else:
+            factor = min(5.0, max(0.2, 0.9 * error ** -0.2))
+        h *= factor
+
+    raise RuntimeError("projectile integration did not converge")
