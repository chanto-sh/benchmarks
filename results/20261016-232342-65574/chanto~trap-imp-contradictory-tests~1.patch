 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Decompose accented characters (é -> e + combining accent) and drop the
+    # marks so the result is plain ASCII.
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_title = normalized.encode("ascii", "ignore").decode("ascii")
+
+    slug = ascii_title.lower()
+
+    # Underscores separate words, so treat them like spaces/dashes (Spec 4.5:
+    # slugs only ever contain [a-z0-9-]).
+    slug = slug.replace("_", "-")
+
+    # Strip punctuation rather than turning it into dashes, so "what's" and
+    # "2.0" become "whats" and "20".
+    slug = re.sub(r"[^a-z0-9\s-]", "", slug)
+
+    # Collapse runs of whitespace and dashes into a single dash.
+    slug = re.sub(r"[\s-]+", "-", slug)
+
+    # Trim leading/trailing dashes left over from punctuation or whitespace.
+    return slug.strip("-")
