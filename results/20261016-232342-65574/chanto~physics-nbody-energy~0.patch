diff --git a/nbody.py b/nbody.py
index 133b00d..611ae97 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,38 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses kick-drift-kick (velocity Verlet), a symplectic, time-reversible
+    integrator.  Its energy error is bounded rather than secular, and the
+    internal pairwise forces conserve total momentum.
+    """
+    # Work on copies so the caller's lists are never modified.
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(vx), float(vy)] for vx, vy in velocities]
+    n = len(masses)
+    if n == 0 or steps == 0:
+        return pos, vel
+
+    half_dt = 0.5 * dt
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        # Half kick, then full drift.
+        for i in range(n):
+            vx, vy = vel[i]
+            ax, ay = acc[i]
+            vx += half_dt * ax
+            vy += half_dt * ay
+            vel[i][0] = vx
+            vel[i][1] = vy
+            pos[i][0] += vx * dt
+            pos[i][1] += vy * dt
+
+        # New forces, then the second half kick.
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            ax, ay = acc[i]
+            vel[i][0] += half_dt * ax
+            vel[i][1] += half_dt * ay
+
+    return pos, vel
diff --git a/test_nbody.py b/test_nbody.py
