+    def test_eccentric_two_body_long_run(self):
+        m = [1.0, 0.5]
+        pos = [[-1.0, 0.0], [2.0, 0.0]]
+        vel = [[0.0, -0.8], [0.0, 0.8]]
+        e0 = energy(m, pos, vel)
+        p0 = momentum(m, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        p1 = momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-10)
+
+    def test_figure_eight_three_body(self):
