+++ b/test_nbody.py
@@ -4,6 +4,13 @@ import unittest
 from nbody import energy, simulate
 
 
+def momentum(masses, velocities):
+    return [
+        sum(m * v[0] for m, v in zip(masses, velocities)),
+        sum(m * v[1] for m, v in zip(masses, velocities)),
+    ]
+
+
 class TestNBody(unittest.TestCase):
