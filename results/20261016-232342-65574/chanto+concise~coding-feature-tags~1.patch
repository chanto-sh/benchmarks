+    def test_add_tags_normalized(self):
+        code, out, err = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "ERRANDS", "--tag", "home"
+        )
+        self.assertEqual((code, out, err), (0, "added #1\n", ""))
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        data = json.load(open(self.db))
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            with self.subTest(tag=bad):
+                code, out, err = run(self.db, "add", "x", "--tag", "ok", "--tag", bad)
+                self.assertEqual(code, 2)
+                self.assertEqual(out, "")
+                self.assertIn(repr(bad), err)
+                self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "one", "--tag", "home")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "three", "--tag", "work")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  one  #home\n  2  two  #home #errands\n")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "Home", "--tag", "ERRANDS")[1],
