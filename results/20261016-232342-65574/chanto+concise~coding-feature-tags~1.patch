diff --git a/notes/fmt.py b/notes/fmt.py
index 13fbf61..a50f0c5 100644
--- a/notes/fmt.py
+++ b/notes/fmt.py
@@ -1,11 +1,29 @@
+from collections import Counter
+
+
+def tag_text(note):
+    return " ".join(f"#{t}" for t in note.tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + tag_text(note)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {tag_text(note)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
+
+
+def tag_counts(notes):
+    """(name, count) pairs, most used first, ties alphabetical."""
+    counts = Counter(t for n in notes for t in n.tags)
+    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..dc150bd 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,36 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tags(raw):
+    """Lowercase, trim and de-duplicate tags, preserving first-seen order.
+
+    Raises InvalidTag for a tag that is empty after trimming or contains
+    whitespace, a comma or a '#'.
+    """
+    tags = []
+    for tag in raw:
+        name = tag.strip().lower()
+        if not name or any(c.isspace() for c in name) or "," in name or "#" in name:
+            raise InvalidTag(tag)
+        if name not in tags:
+            tags.append(name)
+    return tags
+
+
+def _loaded_tags(raw):
+    """Best-effort normalization for tags read from disk."""
+    tags = []
+    for tag in raw or []:
+        if not isinstance(tag, str):
+            continue
+        name = tag.strip().lower()
+        if name and name not in tags:
+            tags.append(name)
+    return tags
 
 
 @dataclass
@@ -6,10 +38,24 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=_loaded_tags(d.get("tags")),
+        )
+
+    def add_tags(self, tags):
+        for tag in tags:
+            if tag not in self.tags:
+                self.tags.append(tag)
+
+    def remove_tags(self, tags):
+        self.tags = [t for t in self.tags if t not in tags]
