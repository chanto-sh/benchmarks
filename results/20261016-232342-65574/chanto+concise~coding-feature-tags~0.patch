+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    tags = f"  {_tag_words(note)}" if note.tags else ""
+    return f"{note.id:>3}  {note.title}{tags}"
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_tag_words(note)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..c177a89 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,15 +1,41 @@
 from dataclasses import asdict, dataclass
 
 
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tags(tags):
+    """Lowercase, trim, and de-duplicate tags, keeping first-seen order."""
+    out = []
+    for tag in tags:
+        name = tag.strip().lower()
+        if not name or any(c.isspace() for c in name) or "," in name or "#" in name:
+            raise InvalidTag(tag)
+        if name not in out:
+            out.append(name)
+    return out
+
+
 @dataclass
 class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = None
+
+    def __post_init__(self):
+        if self.tags is None:
+            self.tags = []
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
