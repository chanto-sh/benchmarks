diff --git a/nbody.py b/nbody.py
index 133b00d..ece684f 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,35 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    The step is a fourth-order symplectic composition of velocity Verlet
+    (kick-drift-kick leapfrog) substeps.  Symplectic integrators keep the
+    energy error bounded and oscillatory instead of secularly growing, which
+    matters for long integrations.  The composition uses a negative middle
+    substep (Yoshida/Forest-Ruth coefficients).
+    """
+    n = len(masses)
+    pos = [[float(positions[i][0]), float(positions[i][1])] for i in range(n)]
+    vel = [[float(velocities[i][0]), float(velocities[i][1])] for i in range(n)]
+    if steps <= 0 or dt == 0.0:
+        return pos, vel
+
+    c = 1.0 / (2.0 - 2.0 ** (1.0 / 3.0))
+    substeps = (c * dt, (1.0 - 2.0 * c) * dt, c * dt)
+    acc = accelerations(masses, pos, G)
+
+    for _ in range(steps):
+        for h in substeps:
+            h2 = h * h
+            for i in range(n):
+                pos[i][0] += vel[i][0] * h + 0.5 * acc[i][0] * h2
+                pos[i][1] += vel[i][1] * h + 0.5 * acc[i][1] * h2
+
+            new_acc = accelerations(masses, pos, G)
+            for i in range(n):
+                vel[i][0] += 0.5 * (acc[i][0] + new_acc[i][0]) * h
+                vel[i][1] += 0.5 * (acc[i][1] + new_acc[i][1]) * h
+            acc = new_acc
+
+    return pos, vel
