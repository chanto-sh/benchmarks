+    def test_eccentric_orbit_energy_is_bounded(self):
+        # a = 1, e = 0.6 for the relative orbit; start at apoapsis
+        e = 0.6
+        r_apo = 1.0 + e
+        v_rel = math.sqrt(2.0 * (1.0 - e) / r_apo)
+        m = [1.0, 1.0]
+        pos = [[-r_apo / 2.0, 0.0], [r_apo / 2.0, 0.0]]
+        vel = [[0.0, -v_rel / 2.0], [0.0, v_rel / 2.0]]
+        self.assert_energy_bounded(m, pos, vel, 0.01, 20000, 2e-5)
+
+    def test_figure_eight_energy_and_momentum(self):
+        # Chenciner-Montgomery figure-eight initial conditions
+        m = [1.0, 1.0, 1.0]
+        pos = [
+            [-0.97000436, 0.24308753],
+            [0.97000436, -0.24308753],
+            [0.0, 0.0],
+        ]
+        vel = [
+            [0.4662036850, 0.4323657300],
+            [0.4662036850, 0.4323657300],
+            [-0.93240737, -0.86473146],
+        ]
+        p0 = total_momentum(m, vel)
+        self.assert_energy_bounded(m, pos, vel, 0.01, 20000, 1e-7)
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        p1 = total_momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-11)
+
+    def test_nonzero_net_momentum_is_conserved(self):
+        # unequal masses on a circular orbit, boosted by a common velocity
+        m = [2.0, 3.0]
+        separation = 2.0
+        total_mass = sum(m)
+        v_rel = math.sqrt(total_mass / separation)
+        r1 = separation * m[1] / total_mass
+        r2 = separation * m[0] / total_mass
+        boost = [0.25, -0.1]
+        pos = [[-r1, 0.0], [r2, 0.0]]
+        vel = [
+            [boost[0], boost[1] - v_rel * m[1] / total_mass],
+            [boost[0], boost[1] + v_rel * m[0] / total_mass],
+        ]
+        p0 = total_momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        p1 = total_momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-11)
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, -0.4], [0.0, 0.2]]
+        m_copy, pos_copy, vel_copy = m[:], [xy[:] for xy in pos], [xy[:] for xy in vel]
+
+        p0, q0 = simulate(m, pos, vel, 0.01, 0)
+        self.assertEqual(p0, pos)
+        self.assertEqual(q0, vel)
+
+        simulate(m, pos, vel, 0.01, 100)
+        self.assertEqual(m, m_copy)
+        self.assertEqual(pos, pos_copy)
