@@ -4,7 +4,28 @@ import unittest
 from nbody import energy, simulate
 
 
+def total_momentum(masses, velocities):
+    return (
+        sum(m * v[0] for m, v in zip(masses, velocities)),
+        sum(m * v[1] for m, v in zip(masses, velocities)),
+    )
+
+
 class TestNBody(unittest.TestCase):
+    def assert_energy_bounded(self, masses, positions, velocities, dt, steps, rtol):
+        """Check the energy at many points, so a lucky final phase cannot hide drift."""
+        e0 = energy(masses, positions, velocities)
+        pos = [xy[:] for xy in positions]
+        vel = [xy[:] for xy in velocities]
+        chunk = max(1, steps // 20)
+        done = 0
+        while done < steps:
+            n = min(chunk, steps - done)
+            pos, vel = simulate(masses, pos, vel, dt, n)
+            done += n
+            rel_err = abs(energy(masses, pos, vel) - e0) / abs(e0)
+            self.assertLess(rel_err, rtol)
+
