 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_text = normalized.encode("ascii", "ignore").decode("ascii").lower()
+    # Punctuation is dropped rather than replaced, so "What's" -> "whats"
+    # and "2.0" -> "20". Spaces, dashes and underscores separate words.
+    stripped = re.sub(r"[^a-z0-9\s_-]", "", ascii_text)
+    return re.sub(r"[\s_-]+", "-", stripped).strip("-")
