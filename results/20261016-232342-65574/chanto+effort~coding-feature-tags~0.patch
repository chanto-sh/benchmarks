+    def test_add_tags_are_normalized(self):
+        code, out, err = run(
+            self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "Errands", "--tag", "home"
+        )
+        self.assertEqual((code, out, err), (0, "added #1\n", ""))
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+
+    def test_invalid_tags_save_nothing(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, out, err = run(self.db, "add", "Buy milk", "--tag", "home", "--tag", bad)
