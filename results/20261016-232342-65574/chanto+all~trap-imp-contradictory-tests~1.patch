 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents down to their ASCII equivalents (Crème -> Creme).
+    decomposed = unicodedata.normalize("NFKD", title)
+    ascii_text = decomposed.encode("ascii", "ignore").decode("ascii")
+
+    # Lowercase, then drop punctuation outright: apostrophes and periods
+    # disappear ("what's" -> "whats", "2.0" -> "20") rather than splitting
+    # words. Whitespace, hyphens and underscores are kept as separators.
+    ascii_text = ascii_text.lower()
+    cleaned = "".join(
+        char if char.isalnum() or char in " -_" else "" for char in ascii_text
+    )
+
+    # Collapse every run of separators into a single dash and trim the ends.
+    return re.sub(r"[\s_-]+", "-", cleaned).strip("-")
