diff --git a/notes/fmt.py b/notes/fmt.py
index 13fbf61..6e1cee0 100644
--- a/notes/fmt.py
+++ b/notes/fmt.py
@@ -1,11 +1,30 @@
+def _tags(tags):
+    return " ".join(f"#{t}" for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += f"  {_tags(note.tags)}"
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_tags(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
+
+
+def tag_counts(notes):
+    """`notes tags` output rows: most used first, ties alphabetical."""
+    counts = {}
+    for note in notes:
+        for tag in note.tags:
+            counts[tag] = counts.get(tag, 0) + 1
+    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    return [f"{tag} {count}" for tag, count in ordered]
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..147dda3 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Return the canonical form of one tag, or raise InvalidTag."""
+    t = tag.strip().lower()
+    if not t or any(c.isspace() for c in t) or "," in t or "#" in t:
+        raise InvalidTag(tag)
+    return t
+
+
+def normalize_tags(tags):
+    """Canonicalize tags, dropping duplicates but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        t = normalize_tag(tag)
+        if t not in out:
+            out.append(t)
+    return out
 
 
 @dataclass
