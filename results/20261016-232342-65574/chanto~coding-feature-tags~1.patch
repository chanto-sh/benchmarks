+    def test_add_with_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "Errands", "--tag", "home")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Plain\n",
