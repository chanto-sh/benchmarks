+++ b/nbody.py
@@ -30,4 +30,33 @@ def energy(masses, positions, velocities, G=1.0):
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
     """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    pos = [[p[0], p[1]] for p in positions]
+    vel = [[v[0], v[1]] for v in velocities]
+    if steps <= 0 or not masses:
+        return pos, vel
+
+    def leapfrog_step(h):
+        acc = accelerations(masses, pos, G)
+        half = 0.5 * h
+        for i in range(len(masses)):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+        for i in range(len(masses)):
+            pos[i][0] += h * vel[i][0]
+            pos[i][1] += h * vel[i][1]
+        acc = accelerations(masses, pos, G)
+        for i in range(len(masses)):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+
+    # Fourth-order Yoshida composition of the second-order leapfrog step.
+    # Being symplectic and time-reversible, it keeps the energy error bounded
+    # instead of letting it drift over long integrations.
+    cbrt2 = 2.0 ** (1.0 / 3.0)
+    w1 = 1.0 / (2.0 - cbrt2)
+    w0 = -cbrt2 * w1
+    for _ in range(steps):
+        leapfrog_step(w1 * dt)
+        leapfrog_step(w0 * dt)
+        leapfrog_step(w1 * dt)
+    return pos, vel
