+    def test_eccentric_two_body_long_run(self):
+        # Perihelion of an equal-mass e=0.6 orbit with semi-major axis 1.
+        m = [1.0, 1.0]
+        r = 0.4
+        v = math.sqrt((1.0 + 0.6) / r) / 2.0
+        pos = [[-r, 0.0], [r, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-8)
+
+    def test_figure_eight_three_body(self):
+        m = [1.0, 1.0, 1.0]
+        r = [0.97000436, -0.24308753]
+        v = [0.4662036850, 0.4323657300]
+        pos = [r[:], [-r[0], -r[1]], [0.0, 0.0]]
+        vel = [v[:], v[:], [-2.0 * v[0], -2.0 * v[1]]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 10000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-9)
+
+    def test_momentum_and_inputs_are_preserved(self):
+        m = [3.0, 1.0, 0.5]
+        pos = [[0.0, 0.0], [2.0, 0.3], [-1.3, 1.7]]
+        vel = [[0.0, 0.0], [0.0, 0.65], [0.4, -0.2]]
+        pos_before = [xy[:] for xy in pos]
+        vel_before = [xy[:] for xy in vel]
