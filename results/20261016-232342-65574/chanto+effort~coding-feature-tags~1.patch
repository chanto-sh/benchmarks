diff --git a/notes/model.py b/notes/model.py
index 3750b6b..d5bcf6d 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,31 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty or contains whitespace, a comma or a '#'."""
+
+
+def normalize_tag(tag):
+    """Trim and lowercase one tag, raising InvalidTag if it is not usable."""
+    normalized = tag.strip().lower()
+    if (
+        not normalized
+        or any(c.isspace() for c in normalized)
+        or "," in normalized
+        or "#" in normalized
+    ):
+        raise InvalidTag(tag)
+    return normalized
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        normalized = normalize_tag(tag)
+        if normalized not in out:
+            out.append(normalized)
+    return out
 
 
 @dataclass
@@ -6,10 +33,16 @@ class Note:
