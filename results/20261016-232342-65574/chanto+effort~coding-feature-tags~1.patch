@@ -38,6 +39,37 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def add_tags(self, note_id, tags):
+        tags = normalize_tags(tags)
+        note = self.get(note_id)
+        for tag in tags:
+            if tag not in note.tags:
+                note.tags.append(tag)
+        return note
+
+    def remove_tags(self, note_id, tags):
+        tags = normalize_tags(tags)
+        note = self.get(note_id)
+        for tag in tags:
+            if tag in note.tags:
+                note.tags.remove(tag)
+        return note
+
+    def filter_by_tags(self, tags):
+        """Notes carrying every tag, matching case-insensitively."""
+        wanted = normalize_tags(tags)
+        result = []
+        for note in self.notes:
+            have = [t.lower() for t in note.tags]
+            if all(tag in have for tag in wanted):
+                result.append(note)
+        return result
+
+    def tag_counts(self):
+        """(tag, count) pairs, most used first, ties alphabetically."""
+        counts = Counter(t.lower() for n in self.notes for t in n.tags)
+        return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+
