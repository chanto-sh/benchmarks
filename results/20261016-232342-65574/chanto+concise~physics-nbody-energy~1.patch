diff --git a/nbody.py b/nbody.py
index 133b00d..a43b24a 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,24 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick leapfrog), which is symplectic and
+    time-reversible, so energy error stays bounded instead of drifting
+    secularly over long integrations.
+    """
+    pos = [[float(x), float(y)] for x, y in positions]
+    vel = [[float(x), float(y)] for x, y in velocities]
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        for i in range(len(masses)):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        acc = accelerations(masses, pos, G)
+        for i in range(len(masses)):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+    return pos, vel
