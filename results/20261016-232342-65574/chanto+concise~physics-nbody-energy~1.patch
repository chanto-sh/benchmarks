+    def test_eccentric_binary_energy(self):
+        # e = 0.5 equal-mass binary, integrated for many orbits
+        m = [1.0, 1.0]
+        v = math.sqrt(0.5) / 2.0
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, -v], [0.0, v]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-4)
+
+    def test_figure_eight_three_body(self):
+        # periodic three-body choreography
+        m = [1.0, 1.0, 1.0]
+        pos = [[-0.97000436, 0.24308753], [0.97000436, -0.24308753], [0.0, 0.0]]
+        vel = [[0.466203685, 0.43236573], [0.466203685, 0.43236573],
+               [-0.93240737, -0.86473146]]
+        e0 = energy(m, pos, vel)
+        momentum0 = [sum(mi * vi[k] for mi, vi in zip(m, vel)) for k in (0, 1)]
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        momentum = [sum(mi * vi[k] for mi, vi in zip(m, q)) for k in (0, 1)]
+        for a, b in zip(momentum, momentum0):
+            self.assertAlmostEqual(a, b, places=10)
+
+    def test_does_not_modify_inputs(self):
+        m = [1.0, 3.0]
+        pos = [[-0.75, 0.0], [0.25, 0.0]]
+        vel = [[0.3, -1.7], [-0.2, 0.7]]
+        pos0 = [xy[:] for xy in pos]
+        vel0 = [xy[:] for xy in vel]
+        p, q = simulate(m, pos, vel, 0.005, 100)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertIsInstance(p[0], list)
+        self.assertIsInstance(q[0], list)
+
 
