@@ -3,4 +3,44 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # E[i] for i in 0..n-1 is the expected number of remaining turns from i;
+    # E[n] = 0.  From i, a roll d moves to i + d, or bounces back to
+    # n - ((i + d) - n) when i + d exceeds n.
+    size = n
+    a = [[Fraction(0) for _ in range(size)] for _ in range(size)]
+    b = [Fraction(0) for _ in range(size)]
+
+    for i in range(size):
+        a[i][i] += k
+        b[i] = Fraction(k)
+        for d in range(1, k + 1):
+            target = i + d
+            if target > n:
+                target = 2 * n - target
+            if target != n:
+                a[i][target] -= 1
+
+    # Gaussian elimination with exact rational arithmetic.
+    for col in range(size):
+        pivot = next(r for r in range(col, size) if a[r][col] != 0)
+        if pivot != col:
+            a[col], a[pivot] = a[pivot], a[col]
+            b[col], b[pivot] = b[pivot], b[col]
+
+        pivot_value = a[col][col]
+        for r in range(col + 1, size):
+            if a[r][col] == 0:
+                continue
+            factor = a[r][col] / pivot_value
+            for c in range(col, size):
+                a[r][c] -= factor * a[col][c]
+            b[r] -= factor * b[col]
+
+    solution = [Fraction(0) for _ in range(size)]
+    for r in range(size - 1, -1, -1):
+        total = b[r]
+        for c in range(r + 1, size):
+            total -= a[r][c] * solution[c]
+        solution[r] = total / a[r][r]
+
+    return solution[0]
