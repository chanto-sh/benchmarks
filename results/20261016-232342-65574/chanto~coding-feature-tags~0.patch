diff --git a/notes/model.py b/notes/model.py
index 3750b6b..f169a3b 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Return the canonical form of one tag or raise InvalidTag."""
+    t = tag.strip()
+    if not t or any(c.isspace() for c in t) or "," in t or "#" in t:
+        raise InvalidTag(tag)
+    return t.lower()
+
+
+def normalize_tags(tags):
+    """Normalize, lower-case and de-duplicate tags, keeping first-seen order."""
+    out = []
+    for tag in tags:
+        t = normalize_tag(tag)
+        if t not in out:
+            out.append(t)
+    return out
 
 
 @dataclass
@@ -6,10 +28,16 @@ class Note:
