 import math
 
 
+def _gauss_legendre(n):
+    """Return the nodes and weights of an n-point Gauss-Legendre rule."""
+    nodes = [0.0] * n
+    weights = [0.0] * n
+    for i in range((n + 1) // 2):
+        z = math.cos(math.pi * (i + 0.75) / (n + 0.5))
+        for _ in range(100):
+            p1, p2 = 1.0, 0.0
+            for j in range(1, n + 1):
+                p1, p2 = ((2 * j - 1) * z * p1 - (j - 1) * p2) / j, p1
+            derivative = n * (z * p1 - p2) / (z * z - 1.0)
+            z, previous = z - p1 / derivative, z
+            if abs(z - previous) <= 1e-15:
+                break
+        nodes[i], nodes[n - 1 - i] = -z, z
+        weight = 2.0 / ((1.0 - z * z) * derivative * derivative)
+        weights[i] = weights[n - 1 - i] = weight
+    return nodes, weights
+
+
+_NODES, _WEIGHTS = _gauss_legendre(16)
+_QUARTER_TURN = math.pi / 2.0
+
+
