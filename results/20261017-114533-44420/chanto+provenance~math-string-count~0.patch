 MOD = 1_000_000_007
 
+# States are indexed by prev_is_a * 3 + c_mod_3, where prev_is_a says
+# whether the last letter was A and c_mod_3 is the number of C's mod 3.
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        a_i = a[i]
+        r_i = result[i]
+        for k in range(_SIZE):
+            a_ik = a_i[k]
+            if a_ik:
+                b_k = b[k]
+                for j in range(_SIZE):
+                    r_i[j] = (r_i[j] + a_ik * b_k[j]) % MOD
+    return result
+
+
+def _mat_pow(mat, exponent):
+    result = [[int(i == j) for j in range(_SIZE)] for i in range(_SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, mat)
+        mat = _mat_mul(mat, mat)
+        exponent >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    # transition[new][old] counts the ways to append one letter.
+    transition = [[0] * _SIZE for _ in range(_SIZE)]
+    for c in range(3):
+        # Last letter was not A: may append A, B, or C.
+        transition[3 + c][c] += 1       # A -> (prev_is_a=1, c)
+        transition[c][c] += 1           # B -> (prev_is_a=0, c)
+        transition[(c + 1) % 3][c] += 1  # C -> (prev_is_a=0, c+1)
+        # Last letter was A: may append B or C.
+        transition[c][3 + c] += 1               # B -> (prev_is_a=0, c)
+        transition[(c + 1) % 3][3 + c] += 1     # C -> (prev_is_a=0, c+1)
+
+    powered = _mat_pow(transition, n)
+    # Start empty: not ending in A, zero C's.
+    # Sum over both prev_is_a values with c_mod_3 == 0.
+    return (powered[0][0] + powered[3][0]) % MOD
