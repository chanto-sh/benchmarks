@@ -3,4 +3,49 @@ from fractions import Fraction
 
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    if not 1 <= k <= n:
+        raise ValueError("expected 1 <= k <= n")
+
+    # Unknowns E[0], ..., E[n-1]; E[n] = 0 because n is absorbing.
+    # First-step analysis:
+    #   E[i] = 1 + (1/k) * sum_{r=1..k} E[land(i, r)]
+    # which, multiplied by k, is
+    #   k*E[i] - sum_{r=1..k} E[land(i, r)] = k
+    # omitting terms whose destination is n.
+    size = n
+    matrix = [[Fraction(0) for _ in range(size + 1)] for _ in range(size)]
+
+    for i in range(size):
+        matrix[i][i] = Fraction(k)
+        matrix[i][size] = Fraction(k)
+        for roll in range(1, k + 1):
+            if i + roll <= n:
+                landing = i + roll
+            else:
+                landing = 2 * n - i - roll
+            if landing < n:
+                matrix[i][landing] -= 1
+
+    return _solve(matrix, size)
+
+
+def _solve(matrix, size):
+    """Solve a square linear system over Fraction, with row pivoting."""
+    for col in range(size):
+        pivot = next((row for row in range(col, size) if matrix[row][col] != 0), None)
+        if pivot is None:
+            raise ValueError("singular system")
+        if pivot != col:
+            matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+
+        pivot_value = matrix[col][col]
+        for j in range(col, size + 1):
+            matrix[col][j] /= pivot_value
+
+        for row in range(size):
+            if row != col and matrix[row][col] != 0:
+                factor = matrix[row][col]
+                for j in range(col, size + 1):
+                    matrix[row][j] -= factor * matrix[col][j]
+
+    return matrix[0][size]
