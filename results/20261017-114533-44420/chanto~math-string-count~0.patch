 MOD = 1_000_000_007
+SIZE = 6  # state = (last letter is A, number of C's mod 3)
+
+
+def _mat_mul(a, b):
+    """Multiply two SIZE x SIZE matrices modulo MOD."""
+    result = [[0] * SIZE for _ in range(SIZE)]
+    for i in range(SIZE):
+        for k in range(SIZE):
+            if a[i][k]:
+                for j in range(SIZE):
+                    result[i][j] = (result[i][j] + a[i][k] * b[k][j]) % MOD
+    return result
+
+
+def _vec_mul(vec, mat):
+    """Multiply a row vector by a matrix modulo MOD."""
+    result = [0] * SIZE
+    for i in range(SIZE):
+        if vec[i]:
+            for j in range(SIZE):
+                result[j] = (result[j] + vec[i] * mat[i][j]) % MOD
+    return result
 
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    # States are indexed by 3 * has_previous_A + (number_of_Cs % 3).
+    transitions = [[0] * SIZE for _ in range(SIZE)]
+    for has_a in range(2):
+        for c_mod in range(3):
+            src = 3 * has_a + c_mod
+            transitions[src][c_mod] += 1                    # append B
+            transitions[src][(c_mod + 1) % 3] += 1          # append C
+            if not has_a:
+                transitions[src][3 + c_mod] += 1            # append A
+
+    # Start with the empty prefix: no previous A, zero C's.
+    vec = [1, 0, 0, 0, 0, 0]
+
+    # Compute vec * transitions**n by binary exponentiation.
+    while n:
+        if n & 1:
+            vec = _vec_mul(vec, transitions)
+        n >>= 1
+        if n:
+            transitions = _mat_mul(transitions, transitions)
+
+    return (vec[0] + vec[3]) % MOD
