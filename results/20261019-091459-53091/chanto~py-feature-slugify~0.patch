@@ -0,0 +1,64 @@
+"""Tests for text_utils.slugify."""
+
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyTests(unittest.TestCase):
+    def test_basic(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+
+    def test_accents(self):
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+
+    def test_accented_uppercase(self):
+        self.assertEqual(slugify("ÁÉÍÓÚ ÑÜ"), "aeiou-nu")
+
+    def test_separator_runs_become_one_hyphen(self):
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+
+    def test_leading_and_trailing_separators_removed(self):
+        self.assertEqual(slugify("---Hello!!!World---"), "hello-world")
+
+    def test_no_letters_or_digits(self):
+        self.assertEqual(slugify("!!!"), "")
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify(" \t\n-_- "), "")
+
+    def test_digits_are_kept(self):
+        self.assertEqual(slugify("Version 2.0 (beta)"), "version-2-0-beta")
+
+    def test_non_latin_letters_are_separators(self):
+        self.assertEqual(slugify("Привет мир"), "")
+
+    def test_max_length_cuts_at_hyphen(self):
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+
+    def test_max_length_without_hyphen(self):
+        self.assertEqual(slugify("abcdefgh", max_length=4), "abcd")
+
+    def test_max_length_equal_to_slug_length(self):
+        self.assertEqual(slugify("Hello World", max_length=11), "hello-world")
+
+    def test_max_length_landing_on_hyphen(self):
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+
+    def test_max_length_one(self):
+        self.assertEqual(slugify("hello world", max_length=1), "h")
+
+    def test_max_length_non_positive(self):
+        self.assertEqual(slugify("hello world", max_length=0), "")
+        self.assertEqual(slugify("hello world", max_length=-3), "")
+
+    def test_max_length_never_leaves_trailing_hyphen(self):
+        text = "The quick brown fox jumps"
+        for max_length in range(1, len("the-quick-brown-fox-jumps") + 1):
+            result = slugify(text, max_length=max_length)
+            self.assertLessEqual(len(result), max_length)
+            self.assertFalse(result.startswith("-"))
+            self.assertFalse(result.endswith("-"))
+
+
+if __name__ == "__main__":
+    unittest.main()
