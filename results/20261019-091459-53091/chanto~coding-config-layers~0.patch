diff --git a/test_config_layers.py b/test_config_layers.py
new file mode 100644
index 0000000..00d465b
--- /dev/null
+++ b/test_config_layers.py
@@ -0,0 +1,125 @@
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+from app.config.errors import ConfigError
+from app.config.loader import load
+
+
+class ConfigLayersTest(unittest.TestCase):
+    def test_environment_layer(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__HOST": "db.internal",
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__DB__POOL__SIZE": "20",
+                "SHOPD__DB__POOL__TIMEOUT": "3.5",
+                "SHOPD__FEATURES": "search, metrics",
+                "OTHER__DB__PORT": "1",
+            }
+        )
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["db"]["pool"], {"size": 20, "timeout": 3.5})
+        self.assertEqual(cfg["features"], ["search", "metrics"])
+
+    def test_environment_names_are_case_insensitive(self):
+        cfg = load(env={"Shopd__Db__PoRt": "5433"})
+        self.assertEqual(cfg["db"]["port"], 5433)
+
+    def test_environment_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__LOG__LEVEL": "debug"}):
+            cfg = load()
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_override_layer(self):
+        cfg = load(overrides=["db.port=6543", "features=a, b", "log.json=on"])
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["features"], ["a", "b"])
+        self.assertIs(cfg["log"]["json"], True)
+
+    def test_empty_list_override(self):
+        cfg = load(overrides=["features="])
+        self.assertEqual(cfg["features"], [])
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 1111, "host": "file-host"}}, f)
+        try:
+            cfg = load(
+                f.name,
+                env={"SHOPD__DB__PORT": "2222", "SHOPD__DB__HOST": "env-host"},
+                overrides=["db.host=override-host"],
+            )
+        finally:
+            os.unlink(f.name)
+        self.assertEqual(cfg["db"]["port"], 2222)
+        self.assertEqual(cfg["db"]["host"], "override-host")
+
+    def test_unknown_setting(self):
+        for kwargs in (
+            {"env": {"SHOPD__DB__PROT": "1"}},
+            {"overrides": ["db.prot=1"]},
+        ):
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ConfigError) as cm:
+                    load(**kwargs)
+                self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_values(self):
+        cases = [
+            ({"SHOPD__DB__PORT": "abc"}, "db.port"),
+            ({"SHOPD__DB__PORT": "5.5"}, "db.port"),
+            ({"SHOPD__DB__SSL": "maybe"}, "db.ssl"),
+            ({"SHOPD__DB__POOL__TIMEOUT": "fast"}, "db.pool.timeout"),
+        ]
+        for env, name in cases:
+            with self.subTest(env=env):
+                with self.assertRaises(ConfigError) as cm:
+                    load(env=env)
+                self.assertIn(name, str(cm.exception))
+
+    def test_section_cannot_be_set(self):
+        for kwargs in (
+            {"env": {"SHOPD__DB": "x"}},
+            {"env": {"SHOPD__DB__POOL": "x"}},
+            {"overrides": ["db=x"]},
+        ):
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ConfigError) as cm:
+                    load(**kwargs)
+                self.assertIn("db", str(cm.exception))
+
+    def test_cli_set_and_error_exit(self):
+        base = [sys.executable, "-m", "app.config"]
+        clean_env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+
+        ok = subprocess.run(
+            base + ["--set", "db.port=6543"],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            env=clean_env,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(ok.returncode, 0, ok.stderr)
+        self.assertEqual(json.loads(ok.stdout)["db"]["port"], 6543)
+
+        bad = subprocess.run(
+            base + ["--set", "db.prot=1"],
+            cwd=os.path.dirname(os.path.abspath(__file__)),
+            env=clean_env,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(bad.returncode, 2)
+        self.assertIn("db.prot", bad.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
