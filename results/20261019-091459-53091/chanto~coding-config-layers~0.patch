 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD"
+_TRUE = {"1", "true", "yes", "on"}
+_FALSE = {"0", "false", "no", "off"}
+
+
+def _lookup(parts):
+    """The built-in default for a dotted setting path."""
+    value = DEFAULTS
+    for part in parts:
+        if not isinstance(value, dict) or part not in value:
+            raise ConfigError(f"unknown setting: {'.'.join(parts)}")
+        value = value[part]
+    return value
+
+
+def _convert(parts, raw):
+    """Convert a string from the environment or a command-line override."""
+    default = _lookup(parts)
+    dotted = ".".join(parts)
+
+    if isinstance(default, dict):
+        raise ConfigError(f"cannot set section: {dotted}")
+
+    if isinstance(default, bool):
+        token = raw.strip().lower()
+        if token in _TRUE:
+            return True
+        if token in _FALSE:
+            return False
+        raise ConfigError(f"invalid value for {dotted}: {raw!r} is not a boolean")
+
+    if isinstance(default, int):
+        try:
+            return int(raw.strip())
+        except (TypeError, ValueError):
+            raise ConfigError(f"invalid value for {dotted}: {raw!r} is not an integer")
+
+    if isinstance(default, float):
+        try:
+            return float(raw.strip())
+        except (TypeError, ValueError):
+            raise ConfigError(f"invalid value for {dotted}: {raw!r} is not a number")
+
+    if isinstance(default, str):
+        return raw
+
+    if isinstance(default, list):
+        if raw.strip() == "":
+            return []
+        return [item.strip() for item in raw.split(",")]
+
+    raise ConfigError(f"unsupported setting: {dotted}")
+
+
+def _patch(parts, raw):
+    """A nested dict assigning `raw` (converted) to the dotted setting `parts`."""
+    value = _convert(parts, raw)
+    for part in reversed(parts):
+        value = {part: value}
+    return value
+
+
+def _override_patch(item):
+    if "=" not in item:
+        raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+    name, raw = item.split("=", 1)
+    parts = [part.lower() for part in name.split(".")]
+    if not name or any(part == "" for part in parts):
+        raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+    return _patch(parts, raw)
+
+
+def _env_patches(env):
+    for name, raw in sorted(env.items()):
+        parts = name.split("__")
+        if len(parts) < 2 or parts[0].upper() != ENV_PREFIX:
+            continue
+        yield _patch([part.lower() for part in parts[1:]], raw)
+
+
