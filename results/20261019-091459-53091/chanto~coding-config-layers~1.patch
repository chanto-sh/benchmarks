+class OverrideTest(unittest.TestCase):
+    def test_overrides(self):
+        cfg = load(
+            overrides=[
+                "db.pool.size=20",
+                "db.port=6543",
+                "db.ssl=on",
+                "features=a, b",
+            ]
+        )
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["features"], ["a", "b"])
+
+    def test_precedence(self):
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
+            json.dump({"db": {"port": 5500}}, f)
+        try:
+            env = {"SHOPD__DB__PORT": "6000"}
+            self.assertEqual(load(f.name, env=env)["db"]["port"], 6000)
+            self.assertEqual(
+                load(f.name, env=env, overrides=["db.port=7000"])["db"]["port"], 7000
+            )
+        finally:
+            os.unlink(f.name)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db.prot=1234"])
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_bad_value(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db.port=abc"])
+        self.assertIn("db.port", str(ctx.exception))
+
+    def test_section(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db.size=1"])
+        self.assertIn("db.size", str(ctx.exception))
+
+    def test_section_itself(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(overrides=["db=x"])
+        self.assertIn("db", str(ctx.exception))
+        self.assertIn("section", str(ctx.exception))
+
