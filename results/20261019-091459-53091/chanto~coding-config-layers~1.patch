+class EnvironmentTest(unittest.TestCase):
+    def test_nested_settings(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__HOST": "env.internal",
+                "SHOPD__DB__PORT": "6543",
+                "SHOPD__DB__POOL__SIZE": "20",
+                "PATH": "/usr/bin",
+                "OTHER__DB__PORT": "1",
+                "SHOPD_DB_PORT": "1",
+            }
+        )
+        self.assertEqual(cfg["db"]["host"], "env.internal")
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_case_insensitive(self):
+        cfg = load(env={"shopd__DB__PoRt": "6543"})
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_converts_to_default_types(self):
+        cfg = load(
+            env={
+                "SHOPD__DB__SSL": "YES",
+                "SHOPD__DB__POOL__TIMEOUT": "3.5",
+                "SHOPD__LOG__JSON": "off",
+                "SHOPD__NAME": "other",
+                "SHOPD__FEATURES": " search , cache ",
+            }
+        )
+        self.assertIs(cfg["db"]["ssl"], True)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 3.5)
+        self.assertIs(cfg["log"]["json"], False)
+        self.assertEqual(cfg["name"], "other")
+        self.assertEqual(cfg["features"], ["search", "cache"])
+
+    def test_empty_string_is_empty_list(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_boolean_tokens(self):
+        for value in ("1", "true", "TRUE", "yes", "On"):
+            with self.subTest(value=value):
+                cfg = load(env={"SHOPD__DB__SSL": value})
+                self.assertIs(cfg["db"]["ssl"], True)
+        for value in ("0", "false", "FALSE", "no", "Off"):
+            with self.subTest(value=value):
+                cfg = load(env={"SHOPD__DB__SSL": value})
+                self.assertIs(cfg["db"]["ssl"], False)
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB__PROT": "1234"})
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_bad_value(self):
+        cases = (
+            ("SHOPD__DB__PORT", "abc", "db.port"),
+            ("SHOPD__DB__PORT", "5.5", "db.port"),
+            ("SHOPD__DB__SSL", "maybe", "db.ssl"),
+            ("SHOPD__DB__POOL__TIMEOUT", "slow", "db.pool.timeout"),
+        )
+        for name, value, setting in cases:
+            with self.subTest(name=name, value=value):
+                with self.assertRaises(ConfigError) as ctx:
+                    load(env={name: value})
+                self.assertIn(setting, str(ctx.exception))
+
+    def test_section(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB": "x"})
+        self.assertIn("db", str(ctx.exception))
+        self.assertIn("section", str(ctx.exception))
+
+    def test_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__DB__PORT": "6543"}):
+            cfg = load()
+        self.assertEqual(cfg["db"]["port"], 6543)
+
