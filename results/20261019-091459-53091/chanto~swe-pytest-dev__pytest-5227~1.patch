+
+
+def test_default_log_format_includes_logger_name():
+    record = logging.LogRecord(
+        name="dummy.module",
+        level=logging.INFO,
+        pathname="dummypath",
+        lineno=10,
+        msg="Test Message",
+        args=(),
+        exc_info=False,
+    )
+
+    tw = py.io.TerminalWriter()
+    tw.hasmarkup = False
+    formatter = ColoredLevelFormatter(tw, DEFAULT_LOG_FORMAT)
+    output = formatter.format(record)
+    assert output == "INFO     dummy.module:dummypath:10 Test Message"
