+ENV_PREFIX = "SHOPD__"
+_TRUE = {"1", "true", "yes", "on"}
+_FALSE = {"0", "false", "no", "off"}
+
+
+def _default_for(path):
+    """The built-in default at a dotted path; also validates the setting."""
+    name = ".".join(path)
+    node = DEFAULTS
+    for part in path:
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {name}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"cannot set {name}: it is a section, not a setting")
+    return node
+
+
+def _convert(path, default, raw):
+    name = ".".join(path)
+    if isinstance(default, bool):
+        lowered = raw.strip().lower()
+        if lowered in _TRUE:
+            return True
+        if lowered in _FALSE:
+            return False
+        raise ConfigError(
+            f"invalid value for {name}: {raw!r} (expected a boolean)"
+        )
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError:
+            raise ConfigError(
+                f"invalid value for {name}: {raw!r} (expected an integer)"
+            ) from None
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError:
+            raise ConfigError(
+                f"invalid value for {name}: {raw!r} (expected a number)"
+            ) from None
+    if isinstance(default, list):
+        if not raw.strip():
+            return []
+        return [item.strip() for item in raw.split(",")]
+    return raw
+
+
+def _set(cfg, path, raw):
+    value = _convert(path, _default_for(path), raw)
+    name = ".".join(path)
+    node = cfg
+    for part in path[:-1]:
+        child = node.get(part) if isinstance(node, dict) else None
+        if not isinstance(child, dict):
+            raise ConfigError(f"cannot set {name}: {part} is not a section")
+        node = child
+    node[path[-1]] = value
+
+
+def _env_paths(env):
+    for key, value in env.items():
+        if not key.upper().startswith(ENV_PREFIX):
+            continue
+        path = [part.lower() for part in key[len(ENV_PREFIX):].split("__")]
+        yield path, value
+
+
+def _override(item):
+    if "=" not in item:
+        raise ConfigError(f"invalid override {item!r}: expected NAME=VALUE")
+    name, value = item.split("=", 1)
+    return [part.lower() for part in name.strip().split(".")], value
+
+
