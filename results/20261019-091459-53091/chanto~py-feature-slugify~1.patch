+"""Tests for text_utils.slugify."""
+
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyTests(unittest.TestCase):
+    def test_docstring_examples(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("!!!"), "")
+
+    def test_lowercases(self):
+        self.assertEqual(slugify("MiXeD CaSe"), "mixed-case")
+
+    def test_accented_letters_become_ascii(self):
+        self.assertEqual(slugify("Éàñ Ünïcode"), "ean-unicode")
+        self.assertEqual(slugify("naïve café"), "naive-cafe")
+
+    def test_runs_of_separators_collapse(self):
+        self.assertEqual(slugify("a  --  b"), "a-b")
+        self.assertEqual(slugify("a/b\\c.d"), "a-b-c-d")
+
+    def test_no_leading_or_trailing_hyphens(self):
+        self.assertEqual(slugify("---hello---"), "hello")
+        self.assertEqual(slugify("  ...hello...  "), "hello")
+
+    def test_digits_are_kept(self):
+        self.assertEqual(slugify("Version 2.0 (beta)"), "version-2-0-beta")
+
+    def test_empty_and_punctuation_only(self):
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify("   "), "")
+        self.assertEqual(slugify("?!@#$%^&*()"), "")
+
+    def test_max_length_cuts_at_hyphen_boundary(self):
+        self.assertEqual(slugify("the quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("the quick brown fox", max_length=12), "the-quick")
+        self.assertEqual(slugify("the quick brown fox", max_length=10), "the-quick")
+
+    def test_max_length_never_leaves_trailing_hyphen(self):
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+        self.assertEqual(slugify("hello world", max_length=5), "hello")
+
+    def test_max_length_cuts_mid_word_when_no_boundary(self):
+        self.assertEqual(slugify("helloworld", max_length=5), "hello")
+
+    def test_max_length_zero_or_negative_returns_empty(self):
+        self.assertEqual(slugify("hello world", max_length=0), "")
+        self.assertEqual(slugify("hello world", max_length=-3), "")
+
+    def test_max_length_longer_than_slug_keeps_full_slug(self):
+        self.assertEqual(slugify("hello world", max_length=100), "hello-world")
+
+
+if __name__ == "__main__":
+    unittest.main()
