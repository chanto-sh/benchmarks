@@ -20,4 +22,36 @@ def slugify(text, max_length=None):
         slugify("The quick brown fox", max_length=13) == "the-quick"
         slugify("!!!") == ""
     """
-    raise NotImplementedError
+    # Decompose accented letters, then drop the combining marks so that
+    # "é" becomes "e", "ñ" becomes "n", and so on.
+    decomposed = unicodedata.normalize("NFKD", text)
+    ascii_text = "".join(
+        char for char in decomposed if not unicodedata.combining(char)
+    ).lower()
+
+    # Collapse every run of non-alphanumeric characters into one hyphen.
+    parts = []
+    in_separator = False
+    for char in ascii_text:
+        if char.isascii() and char.isalnum():
+            parts.append(char)
+            in_separator = False
+        elif not in_separator:
+            parts.append("-")
+            in_separator = True
+
+    slug = "".join(parts).strip("-")
+
+    if max_length is not None and len(slug) > max_length:
+        if max_length <= 0:
+            return ""
+        truncated = slug[:max_length]
+        if truncated.endswith("-"):
+            truncated = truncated[:-1]
+        else:
+            boundary = truncated.rfind("-")
+            if boundary > 0:
+                truncated = truncated[:boundary]
+        slug = truncated.strip("-")
+
+    return slug
