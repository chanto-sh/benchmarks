+    if n == 0:
+        raise ValueError("mean_var() arg is an empty sequence")
+
+    # Work with deviations from the first reading.  This keeps the variance
+    # computation well-conditioned when all readings share a large offset.
+    origin = xs[0]
+    diffs = [x - origin for x in xs]
+
+    if not all(math.isfinite(d) for d in diffs):
+        # The spread is too large for a finite variance.  The mean can still
+        # be computed from scaled readings without overflowing.
+        scale = max(abs(x) for x in xs)
+        mean = scale * (math.fsum(x / scale for x in xs) / n)
+        return mean, math.inf
+
+    try:
+        shift = math.fsum(diffs) / n
+    except OverflowError:
+        # The mean deviation is finite even though the sum overflows.
+        scale = max(abs(d) for d in diffs)
+        shift = scale * (math.fsum(d / scale for d in diffs) / n)
+
+    mean = origin + shift
+
+    # Divide by sqrt(n) before squaring so the intermediate sum of squared
+    # deviations cannot overflow when the final variance is representable.
+    root_n = math.sqrt(n)
+    try:
+        variance = math.fsum(((d - shift) / root_n) ** 2 for d in diffs)
+    except OverflowError:
+        variance = math.inf
+    return mean, variance
 
 
