+    """Time between two successive closest approaches to the origin.
+
+    ``r0`` and ``v0`` are the initial position and velocity, and
+    ``accel(x, y)`` returns the acceleration of the test particle.  The
+    force is assumed to be central, but the law may be any central force.
+    """
+    x0, y0 = r0
+    vx0, vy0 = v0
+    radius = math.hypot(x0, y0)
+    if radius == 0.0:
+        raise ValueError("r0 must not be the origin")
+    angular_momentum = x0 * vy0 - y0 * vx0
+    if angular_momentum == 0.0:
+        raise ValueError("orbit has zero angular momentum")
+
+    def rhs(t, state):
+        x, y, vx, vy = state
+        ax, ay = accel(x, y)
+        return vx, vy, ax, ay
+
+    def radial_velocity(state):
+        x, y, vx, vy = state
+        return x * vx + y * vy
+
+    state = (x0, y0, vx0, vy0)
+    t = 0.0
+    speed = math.hypot(vx0, vy0)
+    ax0, ay0 = accel(x0, y0)
+    accel0 = math.hypot(ax0, ay0)
+
+    # A circular orbit has no unique closest approach; use its revolution
+    # period as the natural limiting answer.
+    radial_speed = (x0 * vx0 + y0 * vy0) / radius
+    radial_force = (x0 * ax0 + y0 * ay0) / radius
+    centrifugal = angular_momentum * angular_momentum / radius ** 3
+    if (abs(radial_speed) <= 1e-14 * max(speed, 1e-300)
+            and abs(radial_force + centrifugal)
+            <= 1e-13 * max(abs(radial_force), centrifugal, 1e-300)):
+        return 2 * math.pi * radius * radius / abs(angular_momentum)
+
+    # Start with a small fraction of the shortest local timescale.
+    timescales = []
+    if speed:
+        timescales.append(radius / speed)
+    if accel0:
+        timescales.append(math.sqrt(radius / accel0))
+    h = 0.01 * min(timescales) if timescales else 1e-3
+
+    rtol = 1e-12
+    atol = 1e-14
+    radial_now = radial_velocity(state)
+    event_times = []
+    steps = 0
+
+    while len(event_times) < 2:
+        steps += 1
+        if steps > 100_000:
+            raise RuntimeError("could not find two successive closest approaches")
+
+        # Do not let one step encompass more than a fraction of a radian.
+        max_h = 0.5 * math.hypot(state[0], state[1]) / max(
+            math.hypot(state[2], state[3]), 1e-300
+        )
+        if h > max_h:
+            h = max_h
+
+        trial, lower_order, k = _rk_step(rhs, t, state, h)
+        radial_next = radial_velocity(trial)
+
+        error = 0.0
+        for i in range(4):
+            scale = atol + rtol * max(abs(state[i]), abs(trial[i]))
+            error += ((trial[i] - lower_order[i]) / scale) ** 2
+        error = math.sqrt(error / 4)
+
+        if error <= 1.0:
+            # A closest approach is an upward zero crossing of r . v.
+            if radial_now < 0.0 <= radial_next:
+                f0 = k[0]
+                f1 = k[6]
+
+                def radial_at(theta):
+                    return radial_velocity(
+                        _hermite_state(state, trial, f0, f1, h, theta)
+                    )
+
+                lo, hi = 0.0, 1.0
+                for _ in range(60):
+                    mid = 0.5 * (lo + hi)
+                    if radial_at(mid) < 0.0:
+                        lo = mid
+                    else:
+                        hi = mid
+                event_times.append(t + 0.5 * (lo + hi) * h)
+                if len(event_times) == 2:
+                    return event_times[1] - event_times[0]
+
+            state = trial
+            t += h
+            radial_now = radial_next
+            factor = 5.0 if error == 0.0 else min(
+                5.0, max(0.2, 0.9 * error ** -0.2)
+            )
+            h *= factor
+        else:
+            h *= max(0.1, 0.9 * error ** -0.2)
+            if h < 1e-15:
+                raise RuntimeError("step size underflow while integrating orbit")
