+def _rk_step(rhs, t, y, h):
+    """One Dormand-Prince 5(4) step; returns the 5th/4th order states."""
+    k = [None] * 7
+    k[0] = rhs(t, y)
+    for s in range(1, 7):
+        ys = tuple(
+            y[i] + h * sum(_A[s][j] * k[j][i] for j in range(s))
+            for i in range(4)
+        )
+        k[s] = rhs(t + _C[s] * h, ys)
+
+    y5 = tuple(
+        y[i] + h * sum(_B[j] * k[j][i] for j in range(7))
+        for i in range(4)
+    )
+    y4 = tuple(
+        y[i] + h * sum(_BHAT[j] * k[j][i] for j in range(7))
+        for i in range(4)
+    )
+    return y5, y4, k
+
+
+def _hermite_state(y0, y1, f0, f1, h, theta):
+    """Cubic Hermite interpolation of the state inside one accepted step."""
+    t2 = theta * theta
+    t3 = t2 * theta
+    h00 = 2 * t3 - 3 * t2 + 1
+    h10 = t3 - 2 * t2 + theta
+    h01 = -2 * t3 + 3 * t2
+    h11 = t3 - t2
+    return tuple(
+        h00 * y0[i] + h10 * h * f0[i] + h01 * y1[i] + h11 * h * f1[i]
+        for i in range(4)
+    )
+
