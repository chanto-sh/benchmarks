 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with the continuous value at x = 0."""
+    return 1.0 if x == 0.0 else math.sin(x) / x
+
+
+def _small_time_solution(m, k, c, F0, omega, x0, v0, t, scale):
+    """Taylor series for x(t), used when |scale * t| is small."""
+    order = 20
+    r = omega / scale
+    force_coefficient = F0 / (m * scale * scale)
+    damping_coefficient = c / (m * scale)
+    stiffness_coefficient = k / (m * scale * scale)
+
+    # Normalized derivatives y_n = x^(n)(0) / scale^n.
+    y = [x0, v0 / scale]
+    r_power = 1.0
+    for n in range(order - 1):
+        if n % 2 == 0:
+            sign = 1.0 if (n // 2) % 2 == 0 else -1.0
+            forcing = sign * force_coefficient * r_power
+        else:
+            forcing = 0.0
+        y.append(
+            forcing
+            - damping_coefficient * y[n + 1]
+            - stiffness_coefficient * y[n]
+        )
+        r_power *= r
+
+    s = scale * t
+    result = 0.0
+    for n in range(order, -1, -1):
+        result = result * s + y[n] / math.factorial(n)
+    return result
+
 
