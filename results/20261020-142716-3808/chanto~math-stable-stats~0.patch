 import math
 
 
+def _scaled_mean(xs, n):
+    """Mean of finite floats, scaling to avoid intermediate overflow."""
+    scale = max(abs(x) for x in xs)
+    if scale == 0.0:
+        return 0.0
+    return scale * (math.fsum(x / scale for x in xs) / n)
+
