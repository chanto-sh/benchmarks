 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    try:
+        mean = math.fsum(xs) / n
+    except OverflowError:
+        # The total overflowed even though the mean itself is representable.
+        mean = math.fsum(x / n for x in xs)
+
+    # Work relative to the first value so that a large common offset cancels
+    # before it can swamp the spread, then use compensated summation.
+    offset = xs[0]
+    shifted = [x - offset for x in xs]
+    if all(math.isfinite(d) for d in shifted):
+        shifted_mean = math.fsum(d / n for d in shifted)
+        var = math.fsum((d - shifted_mean) * (d - shifted_mean)
+                        for d in shifted) / n
+    else:
+        # The offset shift overflowed; fall back to deviations from the mean.
+        var = math.fsum((x - mean) * (x - mean) for x in xs) / n
+    return mean, var
 
 
