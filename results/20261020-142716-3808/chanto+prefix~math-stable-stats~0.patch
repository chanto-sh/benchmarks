 import math
 
 
+def _scaled_mean(xs):
+    """Mean of a non-empty sequence of finite floats without overflow."""
+    n = len(xs)
+    scale = max(abs(x) for x in xs)
+    if scale == 0.0:
+        return 0.0
+    total = math.fsum(x / scale for x in xs)
+    return scale * (total / n)
+
