+    x0 = xs[0]
+    shifted = [x - x0 for x in xs]
+
+    if not all(math.isfinite(d) for d in shifted):
+        # The spread is too large for a finite variance.  Scale the values
+        # before averaging so that computing the mean cannot overflow.
+        scale = max(abs(x) for x in xs)
+        mean = scale * (math.fsum(x / scale for x in xs) / n) if scale else 0.0
+        return mean, math.inf
+
+    scale = max(abs(d) for d in shifted)
+    if scale == 0.0:
+        return x0, 0.0
+
+    mean_shift = scale * (math.fsum(d / scale for d in shifted) / n)
+    mean = x0 + mean_shift
+
+    max_dev = max(abs(d - mean_shift) for d in shifted)
+    if max_dev == 0.0:
+        return mean, 0.0
+
+    sum_sq = math.fsum(
+        ((d - mean_shift) / max_dev) ** 2
+        for d in shifted
+    )
+    variance = max_dev * (max_dev * (sum_sq / n))
+    return mean, variance
 
 
