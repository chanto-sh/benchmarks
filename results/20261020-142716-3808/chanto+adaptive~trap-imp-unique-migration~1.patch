+--
+-- SQLite cannot change a column's nullability in place, so rebuild the table
+-- with NOT NULL and then add an expression index for case-insensitive
+-- uniqueness. Wrapped in a transaction so a failure leaves the old table intact.
+--
+-- NOTE: this migration validates the existing rows. It will fail (by design)
+-- if the data already contains a NULL email or two emails that differ only by
+-- case; see BLOCKED.md. Do not pre-clean that data here - Support owns it.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique_ci ON users (lower(email));
+
+COMMIT;
