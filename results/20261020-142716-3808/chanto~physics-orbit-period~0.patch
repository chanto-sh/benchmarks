     return accel
 
 
+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1 / 5,),
+    (3 / 40, 9 / 40),
+    (44 / 45, -56 / 15, 32 / 9),
+    (19372 / 6561, -25360 / 2187, 64448 / 6561, -212 / 729),
+    (9017 / 3168, -355 / 33, 46732 / 5247, 49 / 176, -5103 / 18656),
+    (35 / 384, 0.0, 500 / 1113, 125 / 192, -2187 / 6784, 11 / 84),
+)
+_B5 = (35 / 384, 0.0, 500 / 1113, 125 / 192, -2187 / 6784, 11 / 84, 0.0)
+_B4 = (
+    5179 / 57600, 0.0, 7571 / 16695, 393 / 640,
+    -92097 / 339200, 187 / 2100, 1 / 40,
+)
+_E = tuple(b5 - b4 for b5, b4 in zip(_B5, _B4))
+
+
+def _derivs(state, accel):
+    x, y, vx, vy = state
+    ax, ay = accel(x, y)
+    return (vx, vy, ax, ay)
+
+
+def _dopri5_step(state, t, h, accel, f0):
+    """One Dormand-Prince step; return (new_state, error, f0, f_new)."""
+    n = len(state)
+    k = [f0]
+    for stage in range(1, 7):
+        a = _A[stage]
+        ys = [state[i] + h * sum(a[j] * k[j][i] for j in range(stage))
+              for i in range(n)]
+        k.append(_derivs(ys, accel))
+
+    new = [state[i] + h * sum(_B5[j] * k[j][i] for j in range(7))
+           for i in range(n)]
+    err = [h * sum(_E[j] * k[j][i] for j in range(7)) for i in range(n)]
+    return new, err, k[0], k[-1]
+
+
+def _hermite_position_velocity(s, h, state0, state1, deriv0, deriv1):
+    """Quintic Hermite interpolation on one integration step."""
+    s2 = s * s
+    s3 = s2 * s
+    s4 = s3 * s
+    s5 = s4 * s
+    h00 = 1 - 10 * s3 + 15 * s4 - 6 * s5
+    h10 = s - 6 * s3 + 8 * s4 - 3 * s5
+    h20 = 0.5 * (s2 - 3 * s3 + 3 * s4 - s5)
+    h01 = 10 * s3 - 15 * s4 + 6 * s5
+    h11 = -4 * s3 + 7 * s4 - 3 * s5
+    h21 = 0.5 * (s3 - 2 * s4 + s5)
+
+    d00 = -30 * s2 + 60 * s3 - 30 * s4
+    d10 = 1 - 18 * s2 + 32 * s3 - 15 * s4
+    d20 = s - 4.5 * s2 + 6 * s3 - 2.5 * s4
+    d01 = 30 * s2 - 60 * s3 + 30 * s4
+    d11 = -12 * s2 + 28 * s3 - 15 * s4
+    d21 = 1.5 * s2 - 4 * s3 + 2.5 * s4
+
+    pos = []
+    vel = []
+    for i in range(2):
+        p0, p1 = state0[i], state1[i]
+        v0, v1 = state0[i + 2], state1[i + 2]
+        a0, a1 = deriv0[i + 2], deriv1[i + 2]
+        pos.append(h00 * p0 + h10 * h * v0 + h20 * h * h * a0
+                   + h01 * p1 + h11 * h * v1 + h21 * h * h * a1)
+        vel.append((d00 * p0 + d10 * h * v0 + d20 * h * h * a0
+                    + d01 * p1 + d11 * h * v1 + d21 * h * h * a1) / h)
+    return pos, vel
+
+
+def _radial_dot(pos, vel):
+    return pos[0] * vel[0] + pos[1] * vel[1]
+
+
+def _find_periapsis(state0, state1, h, deriv0, deriv1):
+    """Locate the negative-to-positive zero of r.v on a step."""
+    lo, hi = 0.0, 1.0
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        pos, vel = _hermite_position_velocity(
+            mid, h, state0, state1, deriv0, deriv1)
+        if _radial_dot(pos, vel) < 0.0:
+            lo = mid
+        else:
+            hi = mid
+    s = 0.5 * (lo + hi)
+    pos, vel = _hermite_position_velocity(
+        s, h, state0, state1, deriv0, deriv1)
+    return s, pos + vel
+
+
+def _circular_period(state, accel):
+    """Return the orbital period for an exactly circular orbit, or None."""
+    x, y, vx, vy = state
+    r2 = x * x + y * y
+    if r2 == 0.0:
+        return None
+    r = math.sqrt(r2)
+    h = x * vy - y * vx
+    if h == 0.0:
+        return None
+
+    speed = math.hypot(vx, vy)
+    radial_speed = (x * vx + y * vy) / r
+    ax, ay = accel(x, y)
+    radial_accel = (x * ax + y * ay) / r
+    centrifugal = h * h / (r2 * r)
+
+    # A circular orbit has no radial motion and the inward force exactly
+    # balances the centrifugal term.  The tolerances also safely absorb
+    # round-off in velocities constructed as sqrt(gm/r).
+    if (abs(radial_speed) <= 1e-12 * max(speed, 1e-300)
+            and radial_accel < 0.0
+            and abs(radial_accel + centrifugal)
+            <= 1e-12 * abs(radial_accel)):
+        return 2.0 * math.pi * r2 / abs(h)
+    return None
+
+
 def radial_period(r0, v0, accel):
-    """Time between two successive closest approaches to the origin."""
-    raise NotImplementedError
+    """Time between two successive closest approaches to the origin.
+
+    The orbit may start anywhere.  ``accel(x, y)`` is evaluated in Cartesian
+    coordinates, so any central force law can be used.
+    """
+    state = [float(r0[0]), float(r0[1]), float(v0[0]), float(v0[1])]
+
+    circular = _circular_period(state, accel)
+    if circular is not None:
+        return circular
+
+    r = math.hypot(state[0], state[1])
+    speed = math.hypot(state[2], state[3])
+    ax, ay = accel(state[0], state[1])
+    accel_mag = math.hypot(ax, ay)
+
+    # Start with a small fraction of the shortest local dynamical timescale.
+    scales = []
+    if speed > 0.0:
+        scales.append(r / speed)
+    if accel_mag > 0.0:
+        scales.append(math.sqrt(r / accel_mag))
+    h = 0.01 * min(scales) if scales else 1e-3
+
+    t = 0.0
+    event_times = []
+    was_negative = _radial_dot(state[:2], state[2:]) < 0.0
+    await_positive = False
+    f0 = _derivs(state, accel)
+    rtol = 1e-12
+    atol = 1e-14
+
+    max_steps = 1_000_000
+    for _ in range(max_steps):
+        new, err, f_start, f_end = _dopri5_step(state, t, h, accel, f0)
+
+        scale = [atol + rtol * max(abs(state[i]), abs(new[i]))
+                 for i in range(4)]
+        err_norm = math.sqrt(sum((err[i] / scale[i]) ** 2
+                                 for i in range(4)) / 4.0)
+
+        if err_norm <= 1.0:
+            g_new = _radial_dot(new[:2], new[2:])
+            if was_negative and g_new >= 0.0:
+                s, event_state = _find_periapsis(
+                    state, new, h, f_start, f_end)
+                t += s * h
+                state = event_state
+                event_times.append(t)
+                if len(event_times) == 2:
+                    return event_times[1] - event_times[0]
+                # After a periapsis the next one is only reached after the
+                # radial velocity has passed through positive, then negative.
+                was_negative = False
+                await_positive = True
+                f0 = _derivs(state, accel)
+                r_event = math.hypot(state[0], state[1])
+                v_event = math.hypot(state[2], state[3])
+                h = min(h, 0.01 * r_event / max(v_event, 1e-300))
+                continue
+            if await_positive:
+                if g_new > 0.0:
+                    await_positive = False
+            elif g_new < 0.0:
+                was_negative = True
+            t += h
+            state = new
+            f0 = f_end
+            factor = 5.0 if err_norm == 0.0 else min(
+                5.0, max(0.2, 0.9 * err_norm ** -0.2))
+            h *= factor
+        else:
+            factor = max(0.2, 0.9 * err_norm ** -0.2)
+            h *= factor
+
+    raise RuntimeError("radial_period: orbit did not complete two periapses")
