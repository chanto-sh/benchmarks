 func Permanent(err error) error { return &permanent{err} }
 
 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-t.C:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// backoff returns Base*2^(n-1) capped at max without overflowing.
+func backoff(base, max time.Duration, n int) time.Duration {
+	d := base
+	for i := 1; i < n; i++ {
+		if d >= max || d > math.MaxInt64/2 {
+			d = max
+			break
+		}
+		d *= 2
+	}
+	if d > max {
+		d = max
+	}
+	return d
 }
 
