 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL to an existing column, so the table is rebuilt.
+-- Every row is copied through unchanged; this migration never rewrites,
+-- merges or deletes customer data.
+--
+-- Applying this to the 2026-10-01 production snapshot fails by design, because
+-- that data does not satisfy the new constraints yet. See BLOCKED.md: Support
+-- must backfill the NULL email on id 17 and resolve the duplicate
+-- ana.silva@example.com rows (ids 1, 4, 23) before this can ship.
+
+BEGIN;
+
+-- Fail fast, and with a readable reason, rather than half-way through the
+-- rebuild with a bare constraint error.
+CREATE TEMP TABLE email_null_precheck (
+    null_emails INTEGER NOT NULL
+        CONSTRAINT "users.email has NULL values - Support must backfill them first"
+        CHECK (null_emails = 0)
+);
+INSERT INTO email_null_precheck
+SELECT count(*) FROM users WHERE email IS NULL;
+
+CREATE TEMP TABLE email_case_precheck (
+    duplicate_groups INTEGER NOT NULL
+        CONSTRAINT "users.email has case-insensitive duplicates - Support must resolve them first"
+        CHECK (duplicate_groups = 0)
+);
+INSERT INTO email_case_precheck
+SELECT count(*) FROM (
+    SELECT lower(email)
+    FROM users
+    WHERE email IS NOT NULL
+    GROUP BY lower(email)
+    HAVING count(*) > 1
+);
+
+DROP TABLE email_null_precheck;
+DROP TABLE email_case_precheck;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique ON users (lower(email));
+
+COMMIT;
