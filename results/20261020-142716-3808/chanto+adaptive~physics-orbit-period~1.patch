 """Orbit measurements for a test particle in a central force field."""
 
+import math
+
+
+def _deriv(state, accel):
+    x, y, vx, vy = state
+    ax, ay = accel(x, y)
+    return (vx, vy, ax, ay)
+
+
+def _combine(state, h, terms):
+    """Return state + h * sum(coefficient * stage)."""
+    return tuple(
+        state[i] + h * sum(coefficient * stage[i] for coefficient, stage in terms)
+        for i in range(4)
+    )
+
+
+def _rk_step(state, h, accel):
+    """One Dormand-Prince 5(4) step; return the fifth-order state and error."""
+    k1 = _deriv(state, accel)
+    k2 = _deriv(_combine(state, h, ((1 / 5, k1),)), accel)
+    k3 = _deriv(
+        _combine(state, h, ((3 / 40, k1), (9 / 40, k2))),
+        accel,
+    )
+    k4 = _deriv(
+        _combine(
+            state,
+            h,
+            ((44 / 45, k1), (-56 / 15, k2), (32 / 9, k3)),
+        ),
+        accel,
+    )
+    k5 = _deriv(
+        _combine(
+            state,
+            h,
+            (
+                (19372 / 6561, k1),
+                (-25360 / 2187, k2),
+                (64448 / 6561, k3),
+                (-212 / 729, k4),
+            ),
+        ),
+        accel,
+    )
+    k6 = _deriv(
+        _combine(
+            state,
+            h,
+            (
+                (9017 / 3168, k1),
+                (-355 / 33, k2),
+                (46732 / 5247, k3),
+                (49 / 176, k4),
+                (-5103 / 18656, k5),
+            ),
+        ),
+        accel,
+    )
+    new_state = _combine(
+        state,
+        h,
+        (
+            (35 / 384, k1),
+            (500 / 1113, k3),
+            (125 / 192, k4),
+            (-2187 / 6784, k5),
+            (11 / 84, k6),
+        ),
+    )
+    k7 = _deriv(new_state, accel)
+
+    error = tuple(
+        h
+        * (
+            71 / 57600 * k1[i]
+            - 71 / 16695 * k3[i]
+            + 71 / 1920 * k4[i]
+            - 17253 / 339200 * k5[i]
+            + 22 / 525 * k6[i]
+            - 1 / 40 * k7[i]
+        )
+        for i in range(4)
+    )
+    return new_state, error
+
+
+def _error_norm(error, state, new_state, rtol, atol):
+    total = 0.0
+    for i in range(4):
+        scale = atol[i] + rtol * max(abs(state[i]), abs(new_state[i]))
+        total += (error[i] / scale) ** 2
+    return math.sqrt(total / 4)
+
+
+def _initial_step(state, accel):
+    x, y, vx, vy = state
+    r = math.hypot(x, y)
+    speed = math.hypot(vx, vy)
+    ax, ay = accel(x, y)
+    acceleration = math.hypot(ax, ay)
+
+    timescales = []
+    if speed > 0.0:
+        timescales.append(r / speed)
+    if acceleration > 0.0:
+        timescales.append(math.sqrt(r / acceleration))
+    if not timescales:
+        return 1e-2
+    return 1e-2 * min(timescales)
+
+
+def _closest_measure(state):
+    x, y, vx, vy = state
+    return x * vx + y * vy
+
+
+def _angle_between(old_state, new_state):
+    x0, y0 = old_state[0], old_state[1]
+    x1, y1 = new_state[0], new_state[1]
+    return math.atan2(x0 * y1 - y0 * x1, x0 * x1 + y0 * y1)
+
+
+def _locate_event(state, h, accel):
+    """Locate an upward zero of r dot v in [0, h]."""
+    lo, hi = 0.0, h
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        trial, _ = _rk_step(state, mid, accel)
+        if _closest_measure(trial) >= 0.0:
+            hi = mid
+        else:
+            lo = mid
+    dt = 0.5 * (lo + hi)
+    event_state, _ = _rk_step(state, dt, accel)
+    return dt, event_state
+
+
+def _circular_period(r, accel, epicyclic=True):
+    """Period at a circular orbit: radial epicyclic or angular."""
+    f0 = accel(r, 0.0)[0]
+
+    if not epicyclic:
+        omega_squared = -f0 / r
+        if omega_squared > 0.0:
+            return 2.0 * math.pi / math.sqrt(omega_squared)
+        raise ValueError("no circular orbit at the starting radius")
+
+    dr = 1e-5 * r
+    f_plus = accel(r + dr, 0.0)[0]
+    f_minus = accel(r - dr, 0.0)[0]
+    f_prime = (f_plus - f_minus) / (2.0 * dr)
+
+    kappa_squared = -3.0 * f0 / r - f_prime
+    if kappa_squared > 0.0:
+        return 2.0 * math.pi / math.sqrt(kappa_squared)
+
+    omega_squared = -f0 / r
+    if omega_squared > 0.0:
+        return 2.0 * math.pi / math.sqrt(omega_squared)
+    raise ValueError("no circular orbit at the starting radius")
+
 
 def newtonian(gm):
     """Inverse-square attraction toward the origin."""
