+    if abs(beta - omega0) <= 1e-14 * (abs(beta) + omega0):
+        C = y0
+        D = yv0 + beta * y0
+        transient = math.exp(-beta * t) * (C + D * t)
+    elif beta < omega0:
+        omega_d = math.sqrt((omega0 - beta) * (omega0 + beta))
+        C = y0
+        D = (yv0 + beta * y0) / omega_d
+        transient = math.exp(-beta * t) * (
+            C * math.cos(omega_d * t) + D * math.sin(omega_d * t)
