 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return P, Q such that x_p(t) = P cos(omega t) + Q sin(omega t)."""
+    detuning = k - m * omega * omega
+    den = detuning * detuning + (c * omega) ** 2
+    if den == 0.0:
+        raise ValueError(
+            "an undamped oscillator has no finite steady state at resonance"
+        )
+    return F0 * detuning / den, F0 * c * omega / den
+
 
