 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- This migration only recreates the table; it does not rewrite, delete or
+-- backfill any customer row.  It therefore fails (and rolls back) if the
+-- existing data already violates the constraint.
+--
+-- The current production snapshot does violate it: users.id = 17 has a NULL
+-- email and users.id 1, 4 and 23 share lower(email) = 'ana.silva@example.com'.
+-- Support owns that data; see BLOCKED.md.
+--
+-- Wrapped in a transaction so a failed run leaves the database untouched.
+
+BEGIN IMMEDIATE;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+-- Copy rows verbatim: no trimming, case-folding or deduplication.
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+-- lower() makes the uniqueness case-insensitive.
+CREATE UNIQUE INDEX users_email_ci_unique ON users_new (lower(email));
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
