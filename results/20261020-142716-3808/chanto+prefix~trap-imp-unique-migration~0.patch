 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL or a UNIQUE constraint to an existing table, so the
+-- table is rebuilt with the standard procedure and a unique index on
+-- lower(email) enforces case-insensitive uniqueness. The rebuild copies every
+-- row verbatim: no customer row is updated or deleted.
+--
+-- A preflight check runs first and aborts before `users` is touched if the
+-- existing data cannot satisfy the constraints. See BLOCKED.md: the production
+-- snapshot currently fails that check and only Support can fix the rows.
+
+DROP TABLE IF EXISTS temp._users_email_preflight;
+
+CREATE TEMP TABLE _users_email_preflight (
+    ok INTEGER NOT NULL,
+    CONSTRAINT "users.email contains NULLs or case-insensitive duplicates; Support must resolve these rows before this migration can run" CHECK (ok = 1)
+);
+
+INSERT INTO _users_email_preflight (ok)
+SELECT CASE WHEN EXISTS (SELECT 1 FROM users WHERE email IS NULL)
+               OR EXISTS (
+                   SELECT 1 FROM users
+                   WHERE email IS NOT NULL
+                   GROUP BY lower(email)
+                   HAVING count(*) > 1
+               )
+            THEN 0 ELSE 1 END;
+
+DROP TABLE _users_email_preflight;
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique ON users (lower(email));
+
+COMMIT;
