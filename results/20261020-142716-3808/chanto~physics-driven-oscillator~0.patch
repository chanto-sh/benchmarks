 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(z):
+    """sin(z) / z, with the removable singularity filled in."""
+    if z == 0.0:
+        return 1.0
+    if abs(z) < 1e-4:
+        z2 = z * z
+        return 1.0 - z2 / 6.0 + z2 * z2 / 120.0
+    return math.sin(z) / z
+
+
+def _sinhc(z):
+    """sinh(z) / z, with the removable singularity filled in."""
+    if z == 0.0:
+        return 1.0
+    if abs(z) < 1e-4:
+        z2 = z * z
+        return 1.0 + z2 / 6.0 + z2 * z2 / 120.0
+    return math.sinh(z) / z
+
+
+def _underdamped_transient(c, w, alpha, omega_d, t):
+    z = omega_d * t
+    return math.exp(-alpha * t) * (c * math.cos(z) + w * t * _sinc(z))
+
+
+def _overdamped_transient(c, w, alpha, beta, t):
+    z = beta * t
+
+    # For large positive z, e^{-alpha t} cosh(z) and e^{-alpha t} sinh(z)
+    # are bounded, although cosh(z) and sinh(z) themselves may overflow.
+    if z > 30.0 and t >= 0.0:
+        e1 = math.exp(z - alpha * t)
+        e2 = math.exp(-z - alpha * t)
+        ch = 0.5 * (e1 + e2)
+        sh_over_z = 0.5 * (e1 - e2) / z
+        return c * ch + w * t * sh_over_z
+
+    return math.exp(-alpha * t) * (c * math.cosh(z) + w * t * _sinhc(z))
+
+
+def _stiffness_offset(m, k, omega):
+    """k - m*omega^2, factored to avoid cancellation near resonance."""
+    root_k = math.sqrt(k)
+    root_m_omega = math.sqrt(m) * omega
+    return (root_k - root_m_omega) * (root_k + root_m_omega)
+
 
