 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    # Subtract a nearby value first so a large common offset cancels before
+    # anything is squared.  For sensor data the differences are usually exact.
+    shift = xs[0]
+    ys = [x - shift for x in xs]
+    if all(math.isfinite(y) for y in ys):
+        try:
+            mean = math.fsum(ys) / n
+        except OverflowError:
+            mean = math.fsum(y / n for y in ys)
+        try:
+            var = math.fsum((y - mean) * (y - mean) for y in ys) / n
+        except OverflowError:
+            # The sum of squared deviations exceeds the float range.
+            var = math.inf
+        return shift + mean, var
+
+    # The range itself overflows when shifted.  Scale the data to compute the
+    # mean; the variance is necessarily beyond the float range in this case.
+    scale = max(abs(x) for x in xs)
+    mean = scale * (math.fsum(x / scale for x in xs) / n)
+    try:
+        var = math.fsum((x - mean) * (x - mean) for x in xs) / n
+    except OverflowError:
+        var = math.inf
+    return mean, var
 
 
