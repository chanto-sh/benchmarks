+    magnitude = math.hypot(k - m * omega * omega, c * omega)
+    if magnitude == 0.0:
+        raise ValueError("undamped driving exactly at resonance has no finite amplitude")
+    return abs(F0) / magnitude
 
 
 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    if t == 0.0:
