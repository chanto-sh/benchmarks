 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(u):
+    """sin(u) / u, with its limit 1 at u = 0."""
+    if abs(u) < 1e-4:
+        u2 = u * u
+        return 1.0 + u2 * (-1.0 / 6.0 + u2 * (1.0 / 120.0 - u2 / 5040.0))
+    return math.sin(u) / u
+
+
+def _expm1_over_x(x):
+    """exp(x) - 1 over x, with its limit 1 at x = 0."""
+    if abs(x) < 1e-4:
+        return 1.0 + x * (0.5 + x * (1.0 / 6.0 + x / 24.0))
+    return math.expm1(x) / x
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Coefficients P, Q of the particular solution P cos(omega t) + Q sin(omega t)."""
+    if F0 == 0.0:
+        return 0.0, 0.0
+    stiffness = k - m * omega * omega
+    damping = c * omega
+    magnitude = math.hypot(stiffness, damping)
+    if magnitude == 0.0:
+        raise ValueError("undamped driving exactly at resonance has no steady state")
+    return (
+        F0 * (stiffness / magnitude) / magnitude,
+        F0 * (damping / magnitude) / magnitude,
+    )
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
+    if F0 == 0.0:
