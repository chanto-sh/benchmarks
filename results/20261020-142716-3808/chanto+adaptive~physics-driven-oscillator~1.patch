+
+    P, Q = _steady_state_coefficients(m, k, c, F0, omega)
+
+    # Initial conditions for the homogeneous (transient) part.
+    xh0 = x0 - P
+    vh0 = v0 - Q * omega
+
+    alpha = c / (2.0 * m)
+    frequency_sq = k / m
+    delta = frequency_sq - alpha * alpha
+
+    if delta > 0.0:
+        # Underdamped (including c = 0): roots -alpha +/- i*beta.
+        beta = math.sqrt(delta)
+        xh = math.exp(-alpha * t) * (
+            xh0 * math.cos(beta * t) + (vh0 + alpha * xh0) * t * _sinc(beta * t)
+        )
+    else:
+        # Critically or overdamped: roots -alpha +/- lambda.
+        lam = math.sqrt(-delta)
+        e1 = math.exp((-alpha + lam) * t)
+        e2 = math.exp((-alpha - lam) * t)
+        cosh_part = 0.5 * (e1 + e2)
+
+        u = 2.0 * lam * t
+        if u < 1.0:
+            sinh_over_lambda = t * e2 * _expm1_over_x(u)
+        else:
+            sinh_over_lambda = (e1 - e2) / (2.0 * lam)
+
+        xh = xh0 * cosh_part + (vh0 + alpha * xh0) * sinh_over_lambda
