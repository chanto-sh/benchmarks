new file mode 100644
index 0000000..88d64be
--- /dev/null
+++ b/reports/common.py
@@ -0,0 +1,42 @@
+"""Shared helpers for ledger exports."""
+import json
+from datetime import datetime, timezone
+
+
+def load_rows(path):
+    """Ledger rows from a JSON-lines file; blank lines and # comments are skipped."""
+    rows = []
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            rows.append(json.loads(line))
+    return rows
+
+
+def parse_ts(s):
+    """ISO date or datetime -> aware UTC datetime (naive values are taken as UTC)."""
+    s = s.strip()
+    if s.endswith("Z"):
+        s = s[:-1] + "+00:00"
+    if len(s) == 10:
+        dt = datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc)
+    else:
+        dt = datetime.fromisoformat(s)
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+    return dt.astimezone(timezone.utc)
+
+
+def in_range(row, start, end):
+    """start <= ts < end; either bound may be None."""
+    ts = parse_ts(row["ts"])
+    return (start is None or ts >= start) and (end is None or ts < end)
+
+
+def fmt_money(cents):
+    """Integer cents -> '1,234.56' (with a leading '-' when negative)."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100:,}.{cents % 100:02d}"
