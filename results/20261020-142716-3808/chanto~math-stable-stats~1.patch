 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    try:
+        mean = math.fsum(xs) / n
+    except OverflowError:
+        mean = math.inf
+    if not math.isfinite(mean):
+        # The exact sum is outside the float range, but the mean itself is
+        # representable.  Work in units of the largest magnitude.
+        scale = max(abs(x) for x in xs)
+        mean = scale * (math.fsum(x / scale for x in xs) / n)
+
+    # Work with deviations from a data value.  For readings around a large
+    # offset these differences are exact, so squaring them cannot produce a
+    # negative (or spuriously infinite) variance.
+    shift = xs[0]
+    diffs = [x - shift for x in xs]
+
+    if not all(math.isfinite(d) for d in diffs):
+        # The spread is wider than the float range, so the variance is not
+        # representable.
+        return mean, math.inf
+
+    max_diff = max(abs(d) for d in diffs)
+    if max_diff == 0.0:
+        return shift, 0.0
+
+    mean_diff = max_diff * (math.fsum(d / max_diff for d in diffs) / n)
+
+    size = max(abs(d - mean_diff) for d in diffs)
+    if math.isinf(size):
+        return mean, math.inf
+    if size == 0.0:
+        return mean, 0.0
+
+    # Scale the deviations before squaring so that summing them cannot
+    # overflow when the variance itself is representable.
+    scaled_ss = math.fsum(
+        ((d - mean_diff) / size) * ((d - mean_diff) / size) for d in diffs
+    )
+    mantissa, exponent = math.frexp(size)
+    try:
+        var = math.ldexp(scaled_ss * mantissa * mantissa / n, 2 * exponent)
+    except OverflowError:
+        var = math.inf
+    return mean, var
 
 
