 """Orbit measurements for a test particle in a central force field."""
 
+import math
+
+
+def _deriv(state, accel):
+    x, y, vx, vy = state
+    ax, ay = accel(x, y)
+    return vx, vy, ax, ay
+
+
+def _add_scaled(state, h, *terms):
+    """Return state + h * sum(coefficient * derivative)."""
+    out = list(state)
+    for coefficient, derivative in terms:
+        for i in range(4):
+            out[i] += h * coefficient * derivative[i]
+    return tuple(out)
+
+
+def _dopri_step(state, h, accel):
+    """One Dormand-Prince 5(4) step; returns the 5th-order state and error."""
+    k1 = _deriv(state, accel)
+    k2 = _deriv(_add_scaled(state, h, (1 / 5, k1)), accel)
+    k3 = _deriv(_add_scaled(state, h, (3 / 40, k1), (9 / 40, k2)), accel)
+    k4 = _deriv(
+        _add_scaled(state, h, (44 / 45, k1), (-56 / 15, k2), (32 / 9, k3)),
+        accel,
+    )
+    k5 = _deriv(
+        _add_scaled(
+            state,
+            h,
+            (19372 / 6561, k1),
+            (-25360 / 2187, k2),
+            (64448 / 6561, k3),
+            (-212 / 729, k4),
+        ),
+        accel,
+    )
+    k6 = _deriv(
+        _add_scaled(
+            state,
+            h,
+            (9017 / 3168, k1),
+            (-355 / 33, k2),
+            (46732 / 5247, k3),
+            (49 / 176, k4),
+            (-5103 / 18656, k5),
+        ),
+        accel,
+    )
+    y5 = _add_scaled(
+        state,
+        h,
+        (35 / 384, k1),
+        (500 / 1113, k3),
+        (125 / 192, k4),
+        (-2187 / 6784, k5),
+        (11 / 84, k6),
+    )
+    k7 = _deriv(y5, accel)
+    y4 = _add_scaled(
+        state,
+        h,
+        (5179 / 57600, k1),
+        (7571 / 16695, k3),
+        (393 / 640, k4),
+        (-92097 / 339200, k5),
+        (187 / 2100, k6),
+        (1 / 40, k7),
+    )
+    return y5, tuple(y5[i] - y4[i] for i in range(4))
+
+
+def _radial_velocity(state):
+    x, y, vx, vy = state
+    return x * vx + y * vy
+
 
