+def _circular_period(state, accel):
+    """Return the orbital period if the initial state is circular, else None."""
+    x, y, vx, vy = state
+    r = math.hypot(x, y)
+    speed = math.hypot(vx, vy)
+    if r == 0.0 or speed == 0.0:
+        return None
+
+    angular_momentum = x * vy - y * vx
+    v_tangential = abs(angular_momentum) / r
+    if v_tangential == 0.0:
+        return None
+
+    radial_speed = (x * vx + y * vy) / r
+    ax, ay = accel(x, y)
+    radial_acceleration = (x * ax + y * ay) / r
+    required = v_tangential * v_tangential / r + radial_acceleration
+    scale = v_tangential * v_tangential / r + abs(radial_acceleration)
+
+    if abs(radial_speed) <= 1e-11 * speed and abs(required) <= 1e-11 * scale:
+        return 2.0 * math.pi * r / v_tangential
+    return None
+
+
+def _max_step(state, accel):
+    """Cap a step so an orbit cannot jump over a periapsis unnoticed."""
+    x, y, vx, vy = state
+    r = math.hypot(x, y)
+    speed = math.hypot(vx, vy)
+    ax, ay = accel(x, y)
+    acceleration = math.hypot(ax, ay)
+
+    caps = []
+    if speed > 0.0:
+        caps.append(0.2 * r / speed)
+    if acceleration > 0.0:
+        caps.append(0.2 * math.sqrt(r / acceleration))
+    return min(caps) if caps else math.inf
+
+
