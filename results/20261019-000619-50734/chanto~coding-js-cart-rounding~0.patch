diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..e7efefd
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,58 @@
+// Exact decimal helpers. An amount is `n / 10^scale`, where `n` is a BigInt.
+
+function pow10(exp) {
+  return 10n ** BigInt(exp);
+}
+
+function parseDecimal(value) {
+  const str = String(value).trim();
+  const match = /^([+-]?)(?:(\d+)(?:\.(\d*))?|\.(\d+))(?:[eE]([+-]?\d+))?$/.exec(str);
+  if (!match) {
+    throw new TypeError(`Invalid decimal: ${value}`);
+  }
+  const sign = match[1] === "-" ? -1n : 1n;
+  const whole = match[2] || "0";
+  const fraction = match[3] !== undefined ? match[3] : match[4] || "";
+  let n = sign * BigInt(whole + fraction);
+  let scale = fraction.length - Number(match[5] || 0);
+  if (scale < 0) {
+    n *= pow10(-scale);
+    scale = 0;
+  }
+  return { n, scale };
+}
+
+// Divide `numerator` by `denominator`, rounding half up (away from zero).
+function roundHalfUpDiv(numerator, denominator) {
+  if (denominator === 0n) {
+    throw new RangeError("Division by zero");
+  }
+  if (denominator < 0n) {
+    numerator = -numerator;
+    denominator = -denominator;
+  }
+  if (numerator < 0n) {
+    return -roundHalfUpDiv(-numerator, denominator);
+  }
+  return (2n * numerator + denominator) / (2n * denominator);
+}
+
+// A percentage of an amount given in units of `10^-scale`, returned in cents.
+function percentageCents(amountUnits, scale, pct) {
+  const percentage = parseDecimal(pct);
+  return roundHalfUpDiv(
+    amountUnits * percentage.n,
+    pow10(scale + percentage.scale),
+  );
+}
+
+// Format an integer number of cents as a "0.00" string.
+function formatCents(cents) {
+  const negative = cents < 0n;
+  const absolute = negative ? -cents : cents;
+  const whole = absolute / 100n;
+  const fraction = (absolute % 100n).toString().padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${fraction}`;
+}
+
+module.exports = { pow10, parseDecimal, roundHalfUpDiv, percentageCents, formatCents };
