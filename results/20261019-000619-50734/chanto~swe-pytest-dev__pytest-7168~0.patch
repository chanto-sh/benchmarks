+def test_broken_getattribute():
+    # See issue #7168: accessing __class__ in _format_repr_exception raises
+    # when __getattribute__ is broken, causing an INTERNALERROR.
+    class SomeClass:
+        def __getattribute__(self, attr):
+            raise AttributeError("broken")
+
+        def __repr__(self):
+            raise ValueError("broken")
+
+    obj = SomeClass()
+    assert saferepr(obj) == (
+        "<[ValueError('broken') raised in repr()] SomeClass object at 0x{:x}>".format(
+            id(obj)
+        )
+    )
+
+
 def test_unicode():
