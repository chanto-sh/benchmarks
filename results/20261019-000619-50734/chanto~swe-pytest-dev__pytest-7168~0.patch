diff --git a/changelog/7168.bugfix.rst b/changelog/7168.bugfix.rst
new file mode 100644
index 0000000..ac8ba13
--- /dev/null
+++ b/changelog/7168.bugfix.rst
@@ -0,0 +1,2 @@
+Fixed an ``INTERNALERROR`` when an object with a broken ``__getattribute__`` raised in
+its ``__repr__``, by no longer accessing ``__class__`` on it while formatting the error.
diff --git a/src/_pytest/_io/saferepr.py b/src/_pytest/_io/saferepr.py
