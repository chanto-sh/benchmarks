-// Sales tax on the taxable part of a cart. `rate` is a percentage, e.g. 8.25.
-function taxFor(amount, rate) {
-  return (amount * rate) / 100;
+const { parseDecimal, roundHalfUp } = require("./money");
+
+// Sales tax in cents on a taxable amount in cents. `rate` is a percentage,
+// e.g. 8.25, and is rounded half up to the cent once for the whole cart.
+function taxFor(amountCents, rate) {
+  const percent = parseDecimal(rate);
+  return roundHalfUp(amountCents * percent.n, 100n * percent.d);
 }
 
 module.exports = { taxFor };
