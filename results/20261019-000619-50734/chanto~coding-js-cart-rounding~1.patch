-  return (lineTotal * pct) / 100;
+const { parseDecimal, roundHalfUp } = require("./money");
+
+// Discount in cents for a line amount in cents: pct percent of the amount,
+// rounded half up to the cent on its own.
+function discountFor(lineCents, pct) {
+  const percent = parseDecimal(pct);
+  return roundHalfUp(lineCents * percent.n, 100n * percent.d);
