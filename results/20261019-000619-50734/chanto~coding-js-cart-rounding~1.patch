+function fmtCents(cents) {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const dollars = abs / 100n;
+  const remainder = abs % 100n;
+  return `${negative ? "-" : ""}${dollars}.${remainder.toString().padStart(2, "0")}`;
