diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..990513d
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,46 @@
+// Exact decimal helpers. A decimal is represented as the rational { n, d }.
+// Keeping the arithmetic in BigInt avoids binary floating point errors.
+
+function parseDecimal(value) {
+  const s = String(value).trim();
+  const m = /^([+-]?)(\d+)(?:\.(\d+))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!m) throw new Error(`Invalid decimal: ${value}`);
+
+  const negative = m[1] === "-";
+  const fraction = m[3] || "";
+  let n = BigInt(m[2] + fraction);
+  if (negative) n = -n;
+
+  let scale = fraction.length - Number(m[4] || 0);
+  let d = 1n;
+  if (scale > 0) {
+    d = 10n ** BigInt(scale);
+  } else if (scale < 0) {
+    n *= 10n ** BigInt(-scale);
+  }
+  return { n, d };
+}
+
+function multiply(a, b) {
+  return { n: a.n * b.n, d: a.d * b.d };
+}
+
+// Round a rational to an integer, halves away from zero.
+function roundHalfUp(n, d) {
+  if (d < 0n) {
+    n = -n;
+    d = -d;
+  }
+  const negative = n < 0n;
+  const abs = negative ? -n : n;
+  let q = abs / d;
+  if ((abs % d) * 2n >= d) q += 1n;
+  return negative ? -q : q;
+}
+
+// Convert a dollar amount to whole cents, rounded half up.
+function toCents(amount) {
+  return roundHalfUp(amount.n * 100n, amount.d);
+}
+
+module.exports = { parseDecimal, multiply, roundHalfUp, toCents };
