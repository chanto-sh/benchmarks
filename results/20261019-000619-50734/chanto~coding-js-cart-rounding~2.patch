diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..e95d547
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,106 @@
+// Exact arithmetic for money. Amounts are kept as fractions { n, d } of
+// BigInts (value = n / d) so decimal prices and percentages never go through
+// binary floating point.
+
+const ONE = 1n;
+const HUNDRED = 100n;
+
+function gcd(a, b) {
+  while (b !== 0n) {
+    const t = a % b;
+    a = b;
+    b = t;
+  }
+  return a < 0n ? -a : a;
+}
+
+function make(n, d) {
+  if (d === 0n) throw new RangeError("division by zero");
+  if (d < 0n) {
+    n = -n;
+    d = -d;
+  }
+  const g = gcd(n, d) || 1n;
+  return { n: n / g, d: d / g };
+}
+
+// Parse a number or decimal string into an exact fraction.
+function parseDecimal(value) {
+  if (typeof value === "bigint") return make(value, ONE);
+
+  const s = String(value).trim();
+  const match = /^([+-]?)(?:(\d+)(?:\.(\d*))?|\.(\d+))(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!match) throw new TypeError(`not a decimal number: ${String(value)}`);
+
+  const sign = match[1] === "-" ? -1n : 1n;
+  const intPart = match[2] || "0";
+  const fracPart = match[3] !== undefined ? match[3] : (match[4] || "");
+  const exp = match[5] === undefined ? 0 : Number(match[5]);
+
+  let n = BigInt(intPart + fracPart) * sign;
+  let scale = fracPart.length - exp;
+  let d = ONE;
+  if (scale >= 0) {
+    d = 10n ** BigInt(scale);
+  } else {
+    n *= 10n ** BigInt(-scale);
+  }
+  return make(n, d);
+}
+
+function add(a, b) {
+  return make(a.n * b.d + b.n * a.d, a.d * b.d);
+}
+
+function sub(a, b) {
+  return make(a.n * b.d - b.n * a.d, a.d * b.d);
+}
+
+function mul(a, b) {
+  return make(a.n * b.n, a.d * b.d);
+}
+
+// Nearest integer, ties away from zero (half up).
+function roundHalfUpInt(value) {
+  const negative = value.n < 0n;
+  const n = negative ? -value.n : value.n;
+  let q = n / value.d;
+  const r = n % value.d;
+  if (2n * r >= value.d) q += 1n;
+  return negative ? -q : q;
+}
+
+// Round a fraction of a currency unit to whole cents.
+function roundToCents(value) {
+  return roundHalfUpInt(mul(value, make(HUNDRED, ONE)));
+}
+
+// `pct` percent of `amount`, rounded once to the nearest cent (half up).
+function percentOf(amount, pct) {
+  const p = parseDecimal(pct);
+  const cents = roundToCents(mul(amount, make(p.n, p.d * HUNDRED)));
+  return make(cents, HUNDRED);
+}
+
+// Render a fraction as a "0.00" string, rounding to cents (half up).
+function formatMoney(value) {
+  const cents = roundToCents(value);
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const whole = abs / HUNDRED;
+  const frac = (abs % HUNDRED).toString().padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${frac}`;
+}
+
+const ZERO = make(0n, ONE);
+
+module.exports = {
+  ZERO,
+  add,
+  sub,
+  mul,
+  percentOf,
+  roundToCents,
+  formatMoney,
+  parseDecimal,
+};
