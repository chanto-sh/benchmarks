 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- The constraint is enforced by rebuilding the table (SQLite cannot add
+-- NOT NULL to an existing column) and adding a unique index on lower(email).
+--
+-- Rebuilding the table leaves every customer row byte-for-byte unchanged, but
+-- it cannot succeed while existing rows violate the new rules. This migration
+-- therefore checks the existing data first and aborts before any schema change
+-- if it finds a NULL email or a case-insensitive duplicate. Support owns that
+-- data; see BLOCKED.md.
+
+CREATE TEMP TABLE _002_email_precheck (
+    ok INTEGER NOT NULL CHECK (ok = 1)
+);
+
+INSERT INTO _002_email_precheck (ok)
+SELECT CASE
+    WHEN EXISTS (SELECT 1 FROM users WHERE email IS NULL) THEN 0
+    WHEN EXISTS (
+        SELECT 1 FROM users GROUP BY lower(email) HAVING COUNT(*) > 1
+    ) THEN 0
+    ELSE 1
+END;
+
+DROP TABLE _002_email_precheck;
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_nocase ON users (lower(email));
+
+COMMIT;
