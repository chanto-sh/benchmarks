 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state_coeffs(m, k, c, F0, omega):
+    """Return a, b, omega*b for x_p = a cos(omega t) + b sin(omega t)."""
+    detuning = math.fsum((k, -m * omega * omega))
+    damping = c * omega
+    scale = math.hypot(detuning, damping)
+
+    if scale == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0, 0.0
+        raise ValueError("steady state is unbounded at resonance with no damping")
+
+    size = F0 / scale
+    a = size * (detuning / scale)
+    b = size * (damping / scale)
+    return a, b, omega * b
+
+
+def _sinc(x):
+    """sin(x) / x, with the limiting value at zero."""
+    if x == 0.0:
+        return 1.0
+    return math.sin(x) / x
+
+
+def _sinhc(x):
+    """sinh(x) / x, with the limiting value at zero."""
+    if x == 0.0:
+        return 1.0
+    return math.sinh(x) / x
+
 
