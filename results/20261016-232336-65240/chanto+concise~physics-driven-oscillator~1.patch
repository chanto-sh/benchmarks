 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with a series near zero."""
+    if abs(x) < 1e-8:
+        x2 = x * x
+        return 1.0 - x2 / 6.0 + x2 * x2 / 120.0
+    return math.sin(x) / x
+
+
+def _sinhc(x):
+    """sinh(x) / x, with a series near zero."""
+    if abs(x) < 1e-8:
+        x2 = x * x
+        return 1.0 + x2 / 6.0 + x2 * x2 / 120.0
+    return math.sinh(x) / x
+
 
