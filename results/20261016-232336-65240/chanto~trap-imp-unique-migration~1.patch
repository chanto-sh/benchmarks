 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL to an existing column, so the table is rebuilt
+-- (rows are copied verbatim; no UPDATE or DELETE is performed). Uniqueness is
+-- enforced with an expression index on lower(email).
+--
+-- Refuse to touch anything if existing data cannot satisfy the constraints.
+-- That data is owned by Support, not by this migration.
+
+DROP TABLE IF EXISTS _002_email_guard;
+CREATE TEMP TABLE _002_email_guard (ok INTEGER);
+
+CREATE TEMP TRIGGER _002_email_guard_abort
+BEFORE INSERT ON _002_email_guard
+WHEN EXISTS (SELECT 1 FROM users WHERE email IS NULL)
+   OR EXISTS (
+        SELECT 1 FROM users
+        GROUP BY lower(email)
+        HAVING COUNT(*) > 1
+   )
+BEGIN
+    SELECT RAISE(ABORT, '002_unique_email: users.email contains NULLs or case-insensitive duplicates; Support must clean the data before this migration can run');
+END;
+
+INSERT INTO _002_email_guard VALUES (1);
+DROP TABLE _002_email_guard;
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_nocase_unique ON users (lower(email));
+
+COMMIT;
