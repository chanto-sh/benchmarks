--- TODO
+-- 002: users.email is required and unique, compared case-insensitively.
+--
+-- SQLite cannot add NOT NULL to an existing column, so the table is rebuilt and
+-- every row is copied across unchanged (id, email, name).
+--
+-- Existing rows must already satisfy the new invariant; this migration never
+-- rewrites or deletes customer data. The preflight below aborts before any
+-- table is touched when they do not. See BLOCKED.md.
+
+BEGIN;
+
+CREATE TEMP TABLE migration_002_needs_support_cleanup (
+    ok INTEGER NOT NULL CHECK (ok = 1)
+);
+
+INSERT INTO migration_002_needs_support_cleanup (ok)
+SELECT 0
+WHERE EXISTS (SELECT 1 FROM users WHERE email IS NULL)
+   OR EXISTS (
+       SELECT 1 FROM users
+       GROUP BY lower(email)
+       HAVING count(*) > 1
+   );
+
+DROP TABLE migration_002_needs_support_cleanup;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique_nocase ON users (lower(email));
+
+COMMIT;
