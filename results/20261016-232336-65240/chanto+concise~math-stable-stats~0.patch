 import math
 
 
+def _mean(xs):
+    """Mean of a non-empty sequence, avoiding overflow in the sum."""
+    n = len(xs)
+    try:
+        return math.fsum(xs) / n
+    except OverflowError:
+        scale = max(abs(x) for x in xs)
+        if scale == 0.0:
+            return 0.0
+        return scale * (math.fsum(x / scale for x in xs) / n)
+
+
