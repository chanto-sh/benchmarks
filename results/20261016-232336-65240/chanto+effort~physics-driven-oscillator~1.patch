+    # solution contains a secular t*sin(omega*t) term.
+    if F0 != 0.0 and c == 0.0 and restoring == 0.0 and omega != 0.0:
+        k_over_m = k / m
+        w0 = math.sqrt(k_over_m) if k_over_m > 0.0 else abs(omega)
+        secular = F0 / (2.0 * m * omega)
