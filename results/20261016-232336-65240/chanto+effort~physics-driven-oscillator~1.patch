 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+_SPLITTER = 134217729.0  # 2**27 + 1, for error-free floating-point products
+
+
+def _split(a):
+    c = _SPLITTER * a
+    if not math.isfinite(c):
+        return a, 0.0
+    hi = c - (c - a)
+    return hi, a - hi
+
+
+def _two_sum(a, b):
+    s = a + b
+    b_virtual = s - a
+    return s, (a - (s - b_virtual)) + (b - b_virtual)
+
+
+def _two_prod(a, b):
+    p = a * b
+    if p == 0.0 or not math.isfinite(p):
+        return p, 0.0
+    a_hi, a_lo = _split(a)
+    b_hi, b_lo = _split(b)
+    err = ((a_hi * b_hi - p) + a_hi * b_lo + a_lo * b_hi) + a_lo * b_lo
+    return p, err
+
+
+def _restoring_force(m, k, omega):
+    """Compute k - m*omega**2 without losing relative accuracy near resonance."""
+    omega_sq, omega_sq_err = _two_prod(omega, omega)
+    product, product_err = _two_prod(m, omega_sq)
+    product_err += m * omega_sq_err
+
+    partial, partial_err = _two_sum(k, -product)
+    result, result_err = _two_sum(partial, -product_err)
+    return result + (result_err + partial_err)
+
+
+def _steady_state_coefficients(m, k, c, F0, omega):
+    """Return P, Q such that the steady-state motion is P cos(wt) + Q sin(wt)."""
+    restoring = _restoring_force(m, k, omega)
+    damping = c * omega
+    denom = math.hypot(restoring, damping)
+    if denom == 0.0:
+        return 0.0, 0.0
+
+    scale = F0 / denom
+    return scale * (restoring / denom), scale * (damping / denom)
+
+
+def _sin_over_omega(omega, t):
+    """Compute sin(omega*t) / omega accurately, including omega -> 0."""
+    theta = omega * t
+    if abs(theta) < 1.0e-4:
+        theta2 = theta * theta
+        # t * sin(theta)/theta
+        return t * (1.0 - theta2 / 6.0 + theta2 * theta2 / 120.0)
+    return math.sin(theta) / omega
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
