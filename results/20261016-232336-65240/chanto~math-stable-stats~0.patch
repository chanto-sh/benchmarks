 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    if n == 0:
+        raise ValueError("mean_var() requires a non-empty sequence")
+
+    # Rescale by the largest magnitude so that summing cannot overflow.
+    scale = max(abs(x) for x in xs)
+    if scale == 0.0:
+        return 0.0, 0.0
+    mean = scale * (math.fsum(x / scale for x in xs) / n)
+
+    # Compute the variance from readings shifted by one of them.  The shifted
+    # values are on the scale of the spread, so the result is not polluted by
+    # the rounding of a large offset (the sum(x*x)/n - mean*mean cancellation
+    # and the bias from centring on a rounded large mean both disappear).
+    origin = xs[0]
+    shifted = [x - origin for x in xs]
+    if not all(math.isfinite(y) for y in shifted):
+        # The spread exceeds the largest representable float.
+        return mean, math.inf
+    shift_scale = max(abs(y) for y in shifted)
+    if shift_scale == 0.0:
+        return mean, 0.0
+    mean_shifted = shift_scale * (math.fsum(y / shift_scale for y in shifted) / n)
+
+    dev_scale = 0.0
+    for y in shifted:
+        dev = abs(y - mean_shifted)
+        if dev > dev_scale:
+            dev_scale = dev
+    if dev_scale == 0.0:
+        return mean, 0.0
+    if math.isinf(dev_scale):
+        return mean, math.inf
+
+    # Normalising the deviations keeps their squares finite; the final
+    # scaling reproduces the variance, overflowing only if it truly is
+    # larger than the largest representable float.
+    total = math.fsum(((y - mean_shifted) / dev_scale) ** 2 for y in shifted)
+    root = dev_scale / math.sqrt(n)
+    return mean, (root * total) * root
 
 
