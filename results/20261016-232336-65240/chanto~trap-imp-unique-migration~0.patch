 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL to an existing column, so rebuild the table and
+-- copy every row through unchanged. The unique expression index enforces
+-- case-insensitive uniqueness for future writes.
+--
+-- NOTE: this migration copies existing rows verbatim. It can therefore only
+-- be applied once every customer row already has a non-NULL email and no two
+-- rows collide case-insensitively. See BLOCKED.md: the current production
+-- snapshot still contains such rows and Support owns their correction.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_unique_ci ON users (lower(email));
+
+COMMIT;
