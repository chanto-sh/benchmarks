@@ -3,6 +3,7 @@ package retry
 
 import (
 	"context"
+	"errors"
 	"time"
 )
 
@@ -26,8 +27,37 @@ func (p *permanent) Unwrap() error { return p.err }
 func Permanent(err error) error { return &permanent{err} }
 
 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
+
+func isPermanent(err error) bool {
+	var p *permanent
+	return errors.As(err, &p)
+}
+
+// capped returns d capped at max without overflowing.
+func capped(d, max time.Duration) time.Duration {
+	if d >= max {
+		return max
+	}
+	if d > (1<<63-1)/2 {
+		return max
+	}
+	d *= 2
+	if d > max {
+		return max
+	}
+	return d
 }
 
