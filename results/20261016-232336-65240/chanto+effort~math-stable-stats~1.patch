 """Summary statistics for the sensor pipeline."""
 import math
+import sys
+
+_MAX_FLOAT = sys.float_info.max
+_SQRT_MAX_FLOAT = math.sqrt(_MAX_FLOAT)
+_LOG_MAX_FLOAT = math.log(_MAX_FLOAT)
 
 
 def mean_var(xs):
     """(mean, population variance) of a non-empty sequence of floats."""
     n = len(xs)
-    s = sum(xs)
-    s2 = sum(x * x for x in xs)
-    mean = s / n
-    return mean, s2 / n - mean * mean
+    shift = xs[0]
+
+    # Center on the first reading before summing.  This keeps a large common
+    # offset from destroying the variance through cancellation.
+    deviations = [x - shift for x in xs]
+    if not all(math.isfinite(d) for d in deviations):
+        # A difference overflowed, so the variance is necessarily infinite.
+        scale = max(abs(x) for x in xs)
+        if scale == 0.0:
+            mean = 0.0
+        else:
+            mean = scale * (math.fsum(x / scale for x in xs) / n)
+        return mean, math.inf
+
+    try:
+        total = math.fsum(deviations)
+    except OverflowError:
+        # The sum can overflow even when its average is representable.
+        mean_shift = math.fsum(d / n for d in deviations)
+    else:
+        mean_shift = total / n
+
+    mean = shift + mean_shift
+
+    # Second pass, again centered on the shift.  Scaling by the largest
+    # deviation prevents overflow of the squared terms when the final
+    # variance itself is representable.
+    max_dev = 0.0
+    for d in deviations:
+        dev = abs(d - mean_shift)
+        if not math.isfinite(dev):
+            return mean, math.inf
+        if dev > max_dev:
+            max_dev = dev
+
+    if max_dev == 0.0:
+        return mean, 0.0
+
+    sum_sq = math.fsum(((d - mean_shift) / max_dev) ** 2 for d in deviations)
+
+    if max_dev <= _SQRT_MAX_FLOAT:
+        variance = (sum_sq / n) * max_dev * max_dev
+    else:
+        scaled = max_dev / math.sqrt(n)
+        variance = scaled * scaled * sum_sq
+
+    return mean, variance
 
 
