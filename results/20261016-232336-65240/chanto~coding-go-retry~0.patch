 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
+
+// nextDelay returns the delay that follows d, capped at max. It saturates
+// instead of overflowing, so large attempt counts cannot produce absurd or
+// negative delays.
+func nextDelay(d, max time.Duration) time.Duration {
+	const maxDuration = time.Duration(1<<63 - 1)
+	if d >= max {
+		return max
+	}
+	if d > maxDuration/2 {
+		d = maxDuration
+	} else {
+		d *= 2
+	}
+	if d > max {
+		d = max
+	}
+	return d
 }
 
