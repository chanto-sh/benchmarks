+    def test_skipif_conditional_expression_not_cached(self, testdir):
+        # The evaluation of a string condition must take the item's globals
+        # into account, so results must not be cached across items/modules.
+        testdir.makepyfile(
+            test_module_1="""
+            import pytest
+            skip = True
+            @pytest.mark.skipif("skip")
+            def test_should_skip():
+                assert False
+            """,
+            test_module_2="""
+            import pytest
+            skip = False
+            @pytest.mark.skipif("skip")
+            def test_should_not_skip():
+                assert False
+            """,
+        )
+        result = testdir.runpytest("-rs")
+        result.stdout.fnmatch_lines(
+            [
+                "*SKIPPED*test_module_1.py*condition: skip*",
+                "*1 failed, 1 skipped*",
+            ]
+        )
+        assert result.ret == 1
+
     @pytest.mark.parametrize(
         "params", ["\"hasattr(sys, 'platform')\"", 'True, reason="invalid platform"']
     )
