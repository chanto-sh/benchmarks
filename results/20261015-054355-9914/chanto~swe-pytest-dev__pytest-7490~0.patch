+def test_xfail_marker_added_dynamically(testdir):
+    """An xfail mark added dynamically during the test run is respected (#7490)."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+        def test_xfail_dynamic(request):
+            request.node.add_marker(pytest.mark.xfail(reason="dynamic"))
+            assert 0
+        """
+    )
+    result = testdir.runpytest("-rx")
+    result.stdout.fnmatch_lines(
+        [
+            "XFAIL*test_xfail_dynamic",
+            "  dynamic",
+            "*1 xfailed*",
+        ]
+    )
+
+
+def test_xpass_marker_added_dynamically(testdir):
+    """An xfail mark added dynamically to a passing test is reported as xpassed."""
+    testdir.makepyfile(
+        """
+        import pytest
+
+        def test_xpass_dynamic(request):
+            request.node.add_marker(pytest.mark.xfail(reason="dynamic"))
+            assert 1
+        """
+    )
+    result = testdir.runpytest("-rx")
+    result.stdout.fnmatch_lines(["*1 xpassed*"])
+
+
