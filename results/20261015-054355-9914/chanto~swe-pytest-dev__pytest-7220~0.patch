+    def test_changed_cwd_in_fixture_keeps_relative_path(self, testdir):
+        """A failing test keeps being reported relative to the invocation
+        directory even when a fixture changed the current working directory
+        (see #7220)."""
+        testdir.makepyfile(
+            test_foo=textwrap.dedent(
+                """\
+                import os
+
+                import pytest
+
+
+                @pytest.fixture
+                def change_cwd(tmp_path):
+                    old = os.getcwd()
+                    os.chdir(str(tmp_path))
+                    yield
+                    os.chdir(old)
+
+
+                def test_fails(change_cwd):
+                    assert False
+                """
+            )
+        )
+        result = testdir.runpytest()
+        assert result.ret == ExitCode.TESTS_FAILED
+        result.stdout.fnmatch_lines(["test_foo.py:15: AssertionError"])
+        result.stdout.no_fnmatch_line("*../test_foo.py*")
+
     def test_issue109_sibling_conftests_not_loaded(self, testdir):
