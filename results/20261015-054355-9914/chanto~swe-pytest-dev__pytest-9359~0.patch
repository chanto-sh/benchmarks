+    def test_getstatementrange_decorated_function(self) -> None:
+        # A statement preceding a decorated function/class must not include
+        # the decorator lines of the following statement (issue #9359).
+        source = Source(
+            """\
+def test_right_statement():
+    assert 1 == 2
+
+    @decorator
+    def inner():
+        pass
+"""
+        )
+        assert source.getstatementrange(1) == (1, 2)
+        assert str(source.getstatement(1)) == "    assert 1 == 2"
+
     def test_getstatementrange_with_syntaxerror_issue7(self) -> None:
