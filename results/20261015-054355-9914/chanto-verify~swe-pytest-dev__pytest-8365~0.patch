+def _sanitize_user(user: str) -> str:
+    """Return a version of the user name that can be used as a directory name.
+
+    On some systems ``getpass.getuser()`` returns a name containing characters
+    that are not allowed in directory names (for example the backslash in a
+    Windows domain user name such as ``contoso\\john_doe``), which makes
+    creating the base temporary directory fail.  Such characters are replaced
+    by underscores.
+    """
+    return re.sub(r"[^\w]", "_", user)
+
+
 def get_user() -> Optional[str]:
     """Return the current user name, or None if getuser() does not work
     in the current environment (see #1010)."""
     import getpass
 
     try:
-        return getpass.getuser()
+        return _sanitize_user(getpass.getuser())
     except (ImportError, KeyError):
         return None
 
