diff --git a/changelog/7469.bugfix.rst b/changelog/7469.bugfix.rst
new file mode 100644
index 0000000..974870c
--- /dev/null
+++ b/changelog/7469.bugfix.rst
@@ -0,0 +1,4 @@
+Fixed a regression in pytest 6.0.0 where an ``xfail`` marker added dynamically
+during a test (for example using ``request.node.add_marker``) was no longer
+honored, causing the test to be reported as a regular failure instead of an
+expected failure.
diff --git a/src/_pytest/skipping.py b/src/_pytest/skipping.py
index 335e109..32420f0 100644
--- a/src/_pytest/skipping.py
+++ b/src/_pytest/skipping.py
@@ -262,6 +262,11 @@ def pytest_runtest_makereport(item: Item, call: CallInfo[None]):
     outcome = yield
     rep = outcome.get_result()
     xfailed = item._store.get(xfailed_key, None)
+    # The xfail mark can be added dynamically during the test itself (for
+    # example using ``request.node.add_marker``), so evaluate the marks again
+    # for the call report if none was found during setup or before the call.
+    if xfailed is None and call.when == "call" and not item.config.option.runxfail:
+        item._store[xfailed_key] = xfailed = evaluate_xfail_marks(item)
     # unittest special case, see setting of unexpectedsuccess_key
     if unexpectedsuccess_key in item._store and rep.when == "call":
         reason = item._store[unexpectedsuccess_key]
