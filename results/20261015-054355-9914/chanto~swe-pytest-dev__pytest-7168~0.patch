+def test_buggy_getattribute():
+    # Simulate a case where __getattribute__ raises, so even accessing
+    # obj.__class__ in the error message formatting would raise again.
+    class SomeClass:
+        def __getattribute__(self, attr):
+            raise
+
+        def __repr__(self):
+            raise
+
+    assert "SomeClass" in saferepr(SomeClass())
+
+
