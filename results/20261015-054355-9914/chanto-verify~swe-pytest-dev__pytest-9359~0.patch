+def test_getstatementrange_with_decorator() -> None:
+    # The statement range of an assertion must not include the decorators of
+    # the following statement (see #9359).
+    source = (
+        "def f():\n"
+        "    assert True\n"
+        "\n"
+        "    @decorator\n"
+        "    def g():\n"
+        "        pass\n"
+        "\n"
+        "    assert False\n"
+    )
+    assert str(getstatement(1, source)) == "    assert True"
+    assert str(getstatement(7, source)) == "    assert False"
+
