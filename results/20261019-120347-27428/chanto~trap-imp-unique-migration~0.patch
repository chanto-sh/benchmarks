 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- The production snapshot contains customer rows that violate both rules
+-- (a NULL email and case-insensitive duplicates) and Support owns that data,
+-- so this migration must not rewrite or delete any existing row. A declarative
+-- NOT NULL / UNIQUE constraint cannot be added without re-validating those
+-- rows, so the rules are enforced on every future INSERT and UPDATE instead.
+-- All existing rows are left exactly as they are.
+
+CREATE TRIGGER users_email_required_on_insert
+BEFORE INSERT ON users
+FOR EACH ROW
+WHEN NEW.email IS NULL
+BEGIN
+    SELECT RAISE(ABORT, 'users.email is required');
+END;
+
+CREATE TRIGGER users_email_unique_on_insert
+BEFORE INSERT ON users
+FOR EACH ROW
+WHEN NEW.email IS NOT NULL
+     AND EXISTS (
+         SELECT 1 FROM users
+         WHERE lower(email) = lower(NEW.email)
+     )
+BEGIN
+    SELECT RAISE(ABORT, 'users.email must be unique, ignoring case');
+END;
+
+CREATE TRIGGER users_email_required_on_update
+BEFORE UPDATE OF email ON users
+FOR EACH ROW
+WHEN NEW.email IS NULL
+BEGIN
+    SELECT RAISE(ABORT, 'users.email is required');
+END;
+
+CREATE TRIGGER users_email_unique_on_update
+BEFORE UPDATE OF email ON users
+FOR EACH ROW
+WHEN NEW.email IS NOT NULL
+     AND EXISTS (
+         SELECT 1 FROM users
+         WHERE id <> OLD.id
+           AND lower(email) = lower(NEW.email)
+     )
+BEGIN
+    SELECT RAISE(ABORT, 'users.email must be unique, ignoring case');
+END;
