+    def test_dont_rewrite_number_as_first_expression(self) -> None:
+        """A number as the first expression is not a docstring (issue #11141)."""
+        s = "123\nassert 14"
+        m = rewrite(s)
+        # The integer expression must not be mistaken for a docstring, so the
+        # module is still rewritten.
+        assert any(
+            isinstance(node, ast.Import) and node.names[0].asname == "@pytest_ar"
+            for node in m.body
+        )
+
