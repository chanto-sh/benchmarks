diff --git a/doc/whatsnew/fragments/5611.bugfix b/doc/whatsnew/fragments/5611.bugfix
new file mode 100644
index 0000000..ebfc2a6
--- /dev/null
+++ b/doc/whatsnew/fragments/5611.bugfix
@@ -0,0 +1,4 @@
+Fix a false positive where escaped braces (``{{`` and ``}}``) in ``--msg-template``
+were mistaken for message fields and stripped from the output.
+
+Closes #5611
diff --git a/pylint/reporters/text.py b/pylint/reporters/text.py
