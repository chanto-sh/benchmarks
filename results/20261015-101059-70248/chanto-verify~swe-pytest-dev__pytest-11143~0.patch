+    def test_dont_rewrite_first_statement_is_not_a_string(
+        self, pytester: Pytester
+    ) -> None:
+        # A non-string first statement (e.g. a number) must not be mistaken for a
+        # docstring. Regression test for #11143.
+        pytester.makepyfile(
+            """
+            1
+            def test_foo():
+                assert 1 == 1
+            """
+        )
+        result = pytester.runpytest()
+        result.assert_outcomes(passed=1)
+
