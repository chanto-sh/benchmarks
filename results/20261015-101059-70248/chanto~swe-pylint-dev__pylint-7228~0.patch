+def test__regex_transformer_valid() -> None:
+    result = config.argument._regex_transformer("test_.*")
+    assert isinstance(result, re.Pattern)
+    assert result.pattern == "test_.*"
+
+
+def test__regex_transformer_invalid() -> None:
+    with pytest.raises(argparse.ArgumentTypeError):
+        config.argument._regex_transformer("test_)")
+
+
+def test__regexp_csv_transfomer_invalid() -> None:
+    pattern_strings = ["test_.*", "foo\\.bar", "^baz)$"]
+    with pytest.raises(argparse.ArgumentTypeError):
+        config.argument._regexp_csv_transfomer(",".join(pattern_strings))
