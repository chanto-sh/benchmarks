+        comp = call.args[0]
+        # Unrolling hoists the comprehension targets into the enclosing scope,
+        # so rename them to fresh names to avoid clobbering (or making local)
+        # variables which are used elsewhere in the function.
+        mapping = {}
+        generators = []
+        for comp_for in comp.generators:
+            target = copy.deepcopy(comp_for.target)
+            iterable = copy.deepcopy(comp_for.iter)
