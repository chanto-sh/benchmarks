+    def test_unroll_all_generator(self):
+        def f():
+            assert all(x < 3 for x in [1, 2, 3, 4])
+
+        assert getmsg(f) == "assert 3 < 3"
+
+    def test_unroll_any_generator(self):
+        def f():
+            assert any(x > 5 for x in [1, 2, 3])
+
+        assert getmsg(f) == "assert 3 > 5"
+
+    def test_unroll_all_list_comprehension(self):
+        def f():
+            assert all([x < 3 for x in [1, 2, 3, 4]])
+
+        assert getmsg(f) == "assert 3 < 3"
+
+    def test_unroll_all_with_function_call(self):
+        def is_even(number):
+            return number % 2 == 0
+
+        def f():
+            assert all(is_even(number) for number in [1, 3, 5])
+
+        assert getmsg(f, {"is_even": is_even}) == (
+            "assert False\n +  where False = is_even(1)"
+        )
+
+    def test_unroll_all_with_filter(self):
+        def f():
+            assert all(x < 3 for x in [1, 2, 3, 4] if x != 4)
+
+        assert getmsg(f) == "assert 3 < 3"
+
+    def test_unroll_all_nested_generators(self):
+        def f():
+            assert all(i + j < 5 for i in [0, 1, 2] for j in [0, 1, 2, 3])
+
+        assert getmsg(f) == "assert (2 + 3) < 5"
+
+    def test_unroll_all_short_circuits(self):
+        calls = []
+
+        def g(x):
+            calls.append(x)
+            return x < 2
+
+        def f():
+            assert all(g(x) for x in [1, 2, 3])
+
+        getmsg(f, {"g": g})
+        assert calls == [1, 2]
+
+    def test_unroll_all_passing(self):
+        def f():
+            assert all(x < 3 for x in [1, 2])
+
+        getmsg(f, must_pass=True)
+
+    def test_unroll_simple_name_element(self):
+        def f():
+            assert all(x for x in [True, False])
+
+        assert getmsg(f) == "assert False"
+
+    def test_unroll_does_not_clobber_variable(self):
+        def f():
+            x = 5
+            try:
+                assert all(x < 3 for x in [1, 2, 3])
+            except AssertionError:
