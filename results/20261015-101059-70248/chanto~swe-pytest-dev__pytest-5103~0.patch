+        """Return True if *call* is an ``all``/``any`` call we can unroll.
+
+        We only unroll calls to the builtins with a single comprehension
+        argument, since for those we can produce a report pointing at the
+        element which made the assertion fail (issue #5103).
+        """
+        if not (isinstance(call.func, ast.Name) and call.func.id in ("all", "any")):
+            return False
+        if len(call.args) != 1:
+            return False
+        # ``keywords``/``kwargs``/``starargs`` are only valid on some Python
+        # versions; ``all``/``any`` don't accept them anyway.
+        if (
+            getattr(call, "keywords", None)
+            or getattr(call, "kwargs", None)
+            or getattr(call, "starargs", None)
+        ):
+            return False
+        arg = call.args[0]
+        if not isinstance(arg, (ast.GeneratorExp, ast.ListComp, ast.SetComp)):
+            return False
+        return not any(getattr(gen, "is_async", False) for gen in arg.generators)
