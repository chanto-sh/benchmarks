+def _comprehension_target_names(node):
+    """Return the names bound by a comprehension ``for`` target."""
+    if isinstance(node, ast.Name):
+        return [node.id]
+    names = []
+    for child in ast.iter_child_nodes(node):
+        names.extend(_comprehension_target_names(child))
+    return names
+
+
+def _rename_comprehension_target(node, mapping):
+    """Rename the names bound by a comprehension ``for`` target in place."""
+    if isinstance(node, ast.Name):
+        if node.id in mapping:
+            node.id = mapping[node.id]
+        return node
+    for child in ast.iter_child_nodes(node):
+        _rename_comprehension_target(child, mapping)
+    return node
+
+
+def _rename_comprehension_loads(node, mapping):
+    """Rename loads of the names in *mapping* inside *node*."""
+
+    class Renamer(ast.NodeTransformer):
+        def visit_Name(self, name):
+            if name.id in mapping and isinstance(name.ctx, ast.Load):
+                new = ast.Name(mapping[name.id], ast.Load())
+                return ast.copy_location(new, name)
+            return name
+
+    return Renamer().visit(node)
+
