+def test_recursive_ignore_paths_directory() -> None:
+    """An ignored directory should be skipped entirely when recursive.
+
+    This is a regression test for https://github.com/PyCQA/pylint/issues/7080.
+    A pattern such as ``.*directory/package/.*`` should also ignore the
+    ``__init__.py`` of the package it targets.
+    """
+    directory = join(REGRTEST_DATA_DIR, "directory")
+    run = Run(
+        [
+            "--recursive",
+            "y",
+            "--ignore-paths",
+            ".*directory/package/.*",
+            directory,
+        ],
+        exit=False,
+    )
+    linted_files = run.linter._iterate_file_descrs(
+        tuple(run.linter._discover_files([directory]))
+    )
+    linted_file_paths = [file_item.filepath for file_item in linted_files]
+
+    for ignored_module in (
+        ("directory", "package", "__init__.py"),
+        ("directory", "package", "module.py"),
+        ("directory", "package", "subpackage", "__init__.py"),
+        ("directory", "package", "subpackage", "module.py"),
+    ):
+        ignored_file = os.path.abspath(join(REGRTEST_DATA_DIR, *ignored_module))
+        assert ignored_file not in linted_file_paths
+
+    assert (
+        os.path.abspath(
+            join(REGRTEST_DATA_DIR, "directory", "subdirectory", "module.py")
+        )
+        in linted_file_paths
+    )
+
+
