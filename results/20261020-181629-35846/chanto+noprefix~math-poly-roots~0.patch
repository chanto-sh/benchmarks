+def _trim(p):
+    i = 0
+    while i < len(p) and p[i] == 0:
+        i += 1
+    return p[i:]
+
+
+def _derivative(p):
+    degree = len(p) - 1
+    if degree <= 0:
+        return []
+    return [p[i] * (degree - i) for i in range(degree)]
+
+
+def _primitive_integer(p):
+    """Scale a rational polynomial to primitive integer coefficients."""
+    p = _trim([Fraction(c) for c in p])
+    if not p:
+        return []
+
+    denominator = 1
+    for c in p:
+        denominator = denominator * c.denominator // gcd(denominator, c.denominator)
+    coefficients = [int(c * denominator) for c in p]
+
+    content = 0
+    for c in coefficients:
+        content = gcd(content, abs(c))
+    if content > 1:
+        coefficients = [c // content for c in coefficients]
+    return coefficients
+
+
+def _divmod(a, b):
+    """Polynomial division, highest degree first, with exact coefficients."""
+    a = _trim([Fraction(c) for c in a])
+    b = _trim([Fraction(c) for c in b])
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    degree = len(a) - len(b)
+    quotient = [Fraction(0)] * (degree + 1)
+    while len(a) >= len(b):
+        shift = len(a) - len(b)
+        factor = a[0] / b[0]
+        quotient[degree - shift] += factor
+        for i in range(len(b)):
+            a[i] -= factor * b[i]
+        a = _trim(a)
+    return _trim(quotient), a
+
+
+def _gcd(a, b):
+    a, b = _primitive_integer(a), _primitive_integer(b)
+    while b:
+        _, remainder = _divmod(a, b)
+        a, b = b, _primitive_integer(remainder)
+    return a
+
+
+def _squarefree_part(p):
+    """Polynomial with the same roots as p, but all roots simple."""
+    p = _primitive_integer(p)
+    derivative = _derivative(p)
+    if not derivative:
+        return p
+    common = _gcd(p, derivative)
+    squarefree, _ = _divmod(p, common)
+    return _primitive_integer(squarefree)
+
+
+def _sturm_sequence(p):
+    p = _primitive_integer(p)
+    derivative = _primitive_integer(_derivative(p))
+    sequence = [p, derivative]
+    if not sequence[1]:
+        return sequence[:1]
+    while True:
+        _, remainder = _divmod(sequence[-2], sequence[-1])
+        if not remainder:
+            return sequence
+        remainder = _primitive_integer(remainder)
+        sequence.append([-c for c in remainder])
+
+
+def _sign_changes(sequence, x):
+    changes = 0
+    previous = 0
+    for polynomial in sequence:
+        value = evaluate(polynomial, x)
+        sign = (value > 0) - (value < 0)
+        if sign:
+            if previous and sign != previous:
+                changes += 1
+            previous = sign
+    return changes
+
+
+def _deflate_linear(p, root):
+    quotient, _ = _divmod(p, [Fraction(1), -root])
+    return quotient
+
+
+def _isolate(p, sequence, a, b, count, roots):
+    if count <= 0:
+        return
+
+    if count == 1:
+        fa, fb = evaluate(p, a), evaluate(p, b)
+        while b - a > _TOLERANCE:
+            midpoint = (a + b) / 2
+            fm = evaluate(p, midpoint)
+            if fm == 0:
+                a = b = midpoint
+                break
+            if (fa > 0) == (fm > 0):
+                a, fa = midpoint, fm
+            else:
+                b, fb = midpoint, fm
+        roots.append((a + b) / 2)
+        return
+
+    # Pick an interior split point that is not itself a root.
+    degree = len(p) - 1
+    midpoint = (a + b) / 2
+    if evaluate(p, midpoint) == 0:
+        midpoint = None
+        for k in range(1, degree + 2):
+            candidate = a + (b - a) * Fraction(k, degree + 2)
+            if evaluate(p, candidate) != 0:
+                midpoint = candidate
+                break
+
+    left_count = _sign_changes(sequence, a) - _sign_changes(sequence, midpoint)
+    _isolate(p, sequence, a, midpoint, left_count, roots)
+    _isolate(p, sequence, midpoint, b, count - left_count, roots)
+
