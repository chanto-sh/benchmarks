 MOD = 1_000_000_007
+SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * SIZE for _ in range(SIZE)]
+    for i in range(SIZE):
+        row = result[i]
+        for k in range(SIZE):
+            if a[i][k]:
+                factor = a[i][k]
+                for j in range(SIZE):
+                    row[j] = (row[j] + factor * b[k][j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    result = [[int(i == j) for j in range(SIZE)] for i in range(SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
 
 
