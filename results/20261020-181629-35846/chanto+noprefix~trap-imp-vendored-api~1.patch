+    async def fetch_all_async(self, urls):
+        """Fetch each URL in order asynchronously, waiting for the limiter before each request."""
+        out = []
+        for url in urls:
+            await self.limiter.acquire_async()
+            out.append(await self.fetch(url))
+        return out
