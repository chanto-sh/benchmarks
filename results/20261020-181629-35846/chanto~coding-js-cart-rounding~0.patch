+const { toFraction, roundHalfUp } = require("./money");
+
+// Sales tax on the taxable part of a cart. `amountCents` is the taxable amount
+// in whole cents, `rate` a percentage (e.g. 8.25); returns whole cents, rounded
+// half up once for the whole amount.
+function taxFor(amountCents, rate) {
+  const { num, den } = toFraction(rate);
+  return roundHalfUp(amountCents * num, den * 100n);
 }
 
