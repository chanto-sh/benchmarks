@@ -1,6 +1,10 @@
-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Whole cents as a plain "1234.50" string for receipts and the API.
+function fmt(cents) {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const whole = abs / 100n;
+  const fraction = String(abs % 100n).padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${fraction}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..5f4ab55
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,38 @@
+// Exact money arithmetic. Amounts are whole cents (BigInt) so binary floats
+// never enter the pricing, and percentages are exact fractions.
+
+const DECIMAL = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/;
+
+// Parse a decimal number ("19.99", 8.25, "7.375") into an exact fraction { num, den }.
+function toFraction(value) {
+  const text = typeof value === "number" ? String(value) : String(value).trim();
+  const m = DECIMAL.exec(text);
+  if (!m || (m[2] === "" && !m[3])) {
+    throw new TypeError(`not a decimal number: ${value}`);
+  }
+  const frac = m[3] || "";
+  const sign = m[1] === "-" ? -1n : 1n;
+  let num = BigInt((m[2] || "0") + frac) * sign;
+  let den = 10n ** BigInt(frac.length);
+  const exp = m[4] ? Number(m[4]) : 0;
+  if (exp > 0) num *= 10n ** BigInt(exp);
+  else if (exp < 0) den *= 10n ** BigInt(-exp);
+  return { num, den };
+}
+
+// Round num / den to a whole number, halves away from zero, exactly.
+function roundHalfUp(num, den) {
+  if (den <= 0n) throw new RangeError("denominator must be positive");
+  const negative = num < 0n;
+  const n = negative ? -num : num;
+  const rounded = (2n * n + den) / (2n * den);
+  return negative ? -rounded : rounded;
+}
+
+// A money amount in whole cents, rounded half up (prices are normally exact cents already).
+function toCents(amount) {
+  const { num, den } = toFraction(amount);
+  return roundHalfUp(num * 100n, den);
+}
+
+module.exports = { toFraction, roundHalfUp, toCents };
