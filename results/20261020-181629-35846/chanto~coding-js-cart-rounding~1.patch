diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..7a29d0e
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,57 @@
+// Exact money helpers. Amounts are BigInt millionths of a dollar so nothing is
+// lost to binary floating point before the rounding steps in the README.
+const MICRO_PER_DOLLAR = 1000000n;
+const MICRO_PER_CENT = 10000n;
+
+// Parse a decimal string or number ("19.99", 8.25) into an exact fraction.
+function parseDecimal(value) {
+  const text = typeof value === "string" ? value.trim() : String(value);
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(text);
+  const whole = match ? match[2] : "";
+  const fraction = match && match[3] !== undefined ? match[3] : "";
+  if (!match || (whole === "" && fraction === "")) {
+    throw new TypeError(`not a decimal amount: ${value}`);
+  }
+  let digits = BigInt(`${whole}${fraction}` || "0");
+  if (match[1] === "-") digits = -digits;
+  const exponent = match[4] === undefined ? 0 : Number(match[4]);
+  const scale = exponent - fraction.length;
+  return scale >= 0
+    ? { n: digits * 10n ** BigInt(scale), d: 1n }
+    : { n: digits, d: 10n ** BigInt(-scale) };
+}
+
+function floorDiv(n, d) {
+  const q = n / d;
+  return n % d !== 0n && n < 0n ? q - 1n : q;
+}
+
+// Round n / d to the nearest integer, halves upward. d must be positive.
+function roundHalfUpDiv(n, d) {
+  return floorDiv(2n * n + d, 2n * d);
+}
+
+// A decimal amount in millionths of a dollar.
+function toMicro(value) {
+  const { n, d } = parseDecimal(value);
+  return roundHalfUpDiv(n * MICRO_PER_DOLLAR, d);
+}
+
+// An amount in millionths of a dollar multiplied by a quantity.
+function timesQty(micro, qty) {
+  const { n, d } = parseDecimal(qty);
+  return roundHalfUpDiv(micro * n, d);
+}
+
+// Round the fraction numerator / denominator (millionths of a dollar) to the
+// nearest cent, halves upward, still in millionths.
+function roundFractionToCents(numerator, denominator) {
+  return roundHalfUpDiv(numerator, denominator * MICRO_PER_CENT) * MICRO_PER_CENT;
+}
+
+// An amount in millionths of a dollar as a whole number of cents.
+function toCents(micro) {
+  return roundHalfUpDiv(micro, MICRO_PER_CENT);
+}
+
+module.exports = { parseDecimal, toMicro, timesQty, roundFractionToCents, toCents };
