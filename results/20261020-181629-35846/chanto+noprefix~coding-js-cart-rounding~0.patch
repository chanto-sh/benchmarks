diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..183dd52
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,40 @@
+// Exact money arithmetic. Amounts are integer cents represented as BigInt.
+
+// Parse a decimal number (number or string) as an exact fraction num/den.
+function parseDecimal(value) {
+  const s = String(value).trim();
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!m || (m[2] === "" && (m[3] === undefined || m[3] === ""))) {
+    throw new TypeError(`invalid number: ${value}`);
+  }
+  const sign = m[1] === "-" ? -1n : 1n;
+  const intPart = m[2] || "";
+  const fracPart = m[3] || "";
+  let digits = BigInt((intPart + fracPart) || "0");
+  let scale = fracPart.length - Number(m[4] || 0);
+  if (scale < 0) {
+    digits *= 10n ** BigInt(-scale);
+    scale = 0;
+  }
+  return { num: sign * digits, den: 10n ** BigInt(scale) };
+}
+
+// Round num/den to the nearest integer, halves away from zero ("half up").
+function roundHalfUp(num, den) {
+  if (num < 0n) return -roundHalfUp(-num, den);
+  return (2n * num + den) / (2n * den);
+}
+
+// Money amount in cents.
+function toCents(value) {
+  const { num, den } = parseDecimal(value);
+  return roundHalfUp(num * 100n, den);
+}
+
+// `pct` percent of `cents`, rounded half up to the cent.
+function percentOfCents(cents, pct) {
+  const { num, den } = parseDecimal(pct);
+  return roundHalfUp(cents * num, den * 100n);
+}
+
+module.exports = { toCents, percentOfCents };
