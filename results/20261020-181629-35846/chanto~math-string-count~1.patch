@@ -1,6 +1,55 @@
 MOD = 1_000_000_007
 
+# State vector is [x0, x1, x2, t0, t1, t2], where:
+#   xr = codes ending in A with r C's modulo 3
+#   tr = codes not ending in A with r C's modulo 3
+# Appending A is only allowed to the t states, and appending C advances
+# the residue.  This gives x'_r = t_r and
+# t'_r = (x_r + t_r) + (x_(r-1) + t_(r-1)).
+
+
+def _mat_mul(a, b):
+    size = len(a)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        row = result[i]
+        for k in range(size):
+            aik = a[i][k]
+            if aik:
+                b_row = b[k]
+                for j in range(size):
+                    row[j] = (row[j] + aik * b_row[j]) % MOD
+    return result
+
+
+def _mat_vec_mul(a, v):
+    return [
+        sum(a[i][j] * v[j] for j in range(len(v))) % MOD
+        for i in range(len(a))
+    ]
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    transition = [[0] * 6 for _ in range(6)]
+    for r in range(3):
+        prev = (r - 1) % 3
+        transition[r][3 + r] = 1
+        transition[3 + r][r] = 1
+        transition[3 + r][3 + r] = 1
+        transition[3 + r][prev] = 1
+        transition[3 + r][3 + prev] = 1
+
+    # The empty code counts as not ending in A, with zero C's.
+    vector = [0, 0, 0, 1, 0, 0]
+
+    while n:
+        if n & 1:
+            vector = _mat_vec_mul(transition, vector)
+        transition = _mat_mul(transition, transition)
+        n >>= 1
+
+    return (vector[0] + vector[3]) % MOD
