diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..9b1ddcc
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,56 @@
+// Exact money arithmetic in integer cents.
+
+function pow10(n) {
+  return 10n ** BigInt(n);
+}
+
+// Parse a decimal number or string into { value, scale }, meaning value / 10^scale.
+function parseDecimal(input) {
+  const match = /^([+-]?)(\d+)(?:\.(\d+))?(?:[eE]([+-]?\d+))?$/.exec(String(input).trim());
+  if (!match) throw new TypeError(`not a decimal number: ${input}`);
+  const sign = match[1] === "-" ? -1n : 1n;
+  const fraction = match[3] || "";
+  const exponent = match[4] ? Number(match[4]) : 0;
+  let value = BigInt(match[2] + fraction) * sign;
+  let scale = fraction.length - exponent;
+  if (scale < 0) {
+    value *= pow10(-scale);
+    scale = 0;
+  }
+  return { value, scale };
+}
+
+// Round num / den to the nearest integer, halves away from zero.
+function divideRoundHalfUp(num, den) {
+  if (num < 0n) return -divideRoundHalfUp(-num, den);
+  return (2n * num + den) / (2n * den);
+}
+
+// A decimal dollar amount as integer cents, rounding half up.
+function toCents(amount) {
+  const { value, scale } = parseDecimal(amount);
+  if (scale <= 2) return value * pow10(2 - scale);
+  return divideRoundHalfUp(value, pow10(scale - 2));
+}
+
+// `pct` percent of an integer-cent amount, rounded half up to the cent.
+function pctOfCents(amount, pct) {
+  const { value, scale } = parseDecimal(pct);
+  return divideRoundHalfUp(amount * value, 100n * pow10(scale));
+}
+
+// price x qty in integer cents, rounding half up.
+function lineCents(price, qty) {
+  const { value, scale } = parseDecimal(qty);
+  return divideRoundHalfUp(toCents(price) * value, pow10(scale));
+}
+
+function fromCents(cents) {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const whole = abs / 100n;
+  const fraction = (abs % 100n).toString().padStart(2, "0");
+  return `${negative ? "-" : ""}${whole}.${fraction}`;
+}
+
+module.exports = { toCents, pctOfCents, lineCents, fromCents };
