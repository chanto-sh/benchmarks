@@ -1,6 +1,57 @@
 MOD = 1_000_000_007
 
+# States are (last letter is A?, number of C's modulo 3).
+# Index of state (last_is_a, c_mod) is last_is_a * 3 + c_mod.
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        row_a = a[i]
+        row_result = result[i]
+        for k in range(_SIZE):
+            if row_a[k]:
+                factor = row_a[k]
+                row_b = b[k]
+                for j in range(_SIZE):
+                    row_result[j] = (
+                        row_result[j] + factor * row_b[j]
+                    ) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    result = [[int(i == j) for j in range(_SIZE)] for i in range(_SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
+
+def _transition_matrix():
+    matrix = [[0] * _SIZE for _ in range(_SIZE)]
+    for last_is_a in range(2):
+        for c_mod in range(3):
+            source = last_is_a * 3 + c_mod
+            # Append B: last letter is no longer A, C count unchanged.
+            matrix[c_mod][source] += 1
+            # Append C: last letter is no longer A, C count increases.
+            matrix[(c_mod + 1) % 3][source] += 1
+            # Append A: only allowed when the previous letter is not A.
+            if not last_is_a:
+                matrix[3 + c_mod][source] += 1
+    return matrix
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n == 0:
+        return 1
+
+    matrix = _mat_pow(_transition_matrix(), n)
+    # Start from the empty code: last letter is not A and there are no C's.
+    # Accept states have a C count divisible by 3, regardless of last letter.
+    return (matrix[0][0] + matrix[3][0]) % MOD
