 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state(m, k, c, F0, omega):
+    """Return (a, b, amplitude) for a cos(omega t) + b sin(omega t)."""
+    detuning = k - m * omega * omega
+    denom = math.hypot(detuning, c * omega)
+    if denom == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0, 0.0
+        raise ValueError("undamped system driven exactly at resonance has no steady state")
+
+    scale = F0 / denom
+    a = scale * (detuning / denom)
+    b = scale * (c * omega / denom)
+    return a, b, scale
+
 
