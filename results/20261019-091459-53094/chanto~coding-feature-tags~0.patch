@@ -41,6 +41,93 @@ class NotesTest(unittest.TestCase):
         data = json.load(open(self.db))
         self.assertEqual(data["notes"][0]["title"], "x")
 
+    def test_add_tags_normalized(self):
+        run(self.db, "add", "Buy milk", "--tag", " home ", "--tag", "Errands", "--tag", "HOME")
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(
+            run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n"
+        )
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags(self):
+        for bad in ["", "   ", "two words", "a,b", "#home"]:
+            code, _, err = run(self.db, "add", "x", "--tag", bad)
+            self.assertEqual(code, 2)
+            self.assertIn("invalid tag", err)
+            self.assertFalse(os.path.exists(self.db))
+
+        code, _, err = run(self.db, "add", "x", "--tag", "Bad Tag")
+        self.assertEqual(code, 2)
+        self.assertIn("bad tag", err)
+
+    def test_invalid_tag_saves_nothing(self):
+        run(self.db, "add", "x")
+        code, _, _ = run(self.db, "add", "y", "--tag", "ok", "--tag", "not ok")
+        self.assertEqual(code, 2)
+        self.assertEqual(run(self.db, "list")[1], "  1  x\n")
+
+    def test_list_filter(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "b", "--tag", "home")
+        run(self.db, "add", "c")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "HOME")[1],
+            "  1  a  #home #errands\n  2  b  #home\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "errands")[1],
+            "  1  a  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tag_counts(self):
+        run(self.db, "add", "a", "--tag", "zeta", "--tag", "home")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "alpha")
+        run(self.db, "add", "c", "--tag", "beta")
+        self.assertEqual(
+            run(self.db, "tags")[1], "home 2\nalpha 1\nbeta 1\nzeta 1\n"
+        )
+
+    def test_tag_untag(self):
+        run(self.db, "add", "x", "--tag", "home")
+        run(self.db, "tag", "1", " Errands ", "HOME", "new")
+        self.assertEqual(
+            run(self.db, "show", "1")[1], "#1 x\ntags: #home #errands #new\n"
+        )
+        run(self.db, "untag", "1", "HOME", "missing", "new")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 x\ntags: #errands\n")
+
+    def test_tag_invalid_saves_nothing(self):
+        run(self.db, "add", "x")
