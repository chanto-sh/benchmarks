@@ -1,11 +1,21 @@
+def tag_text(tags):
+    """Tags rendered as `#one #two`."""
+    return " ".join("#" + tag for tag in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + tag_text(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {tag_text(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..8030978 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,28 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    def __init__(self, tag):
+        super().__init__(tag)
+        self.tag = tag
+
+
+def normalize_tag(tag):
+    """Lowercase and trim one tag, rejecting anything unusable."""
+    tag = tag.strip().lower()
+    if not tag or any(c.isspace() for c in tag) or "," in tag or "#" in tag:
+        raise InvalidTag(tag)
+    return tag
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates but keeping first-seen order."""
+    out = []
+    for tag in tags:
+        tag = normalize_tag(tag)
+        if tag not in out:
+            out.append(tag)
+    return out
 
 
 @dataclass
@@ -6,10 +30,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
