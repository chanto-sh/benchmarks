 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot change nullability or collation in place, so the table is
+-- rebuilt and its rows are copied unchanged. The whole rebuild runs in one
+-- transaction: if the existing data already violates the constraint, nothing
+-- is kept (no rows are edited or deleted).
+--
+-- Applying this to the 2026-10-01 production snapshot is currently blocked:
+-- it contains a NULL email and case-insensitive duplicates. See BLOCKED.md.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL COLLATE NOCASE UNIQUE,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
