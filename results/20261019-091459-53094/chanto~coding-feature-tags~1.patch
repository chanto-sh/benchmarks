+        run(self.db, "add", "b", "--tag", "home")
+        run(self.db, "add", "c", "--tag", "zeta")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\nerrands 1\nzeta 1\n")
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "Buy milk")
