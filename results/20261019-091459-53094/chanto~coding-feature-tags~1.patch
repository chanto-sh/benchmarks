+    def test_add_tags_normalized(self):
+        run(self.db, "add", "Buy milk", "--tag", " home ", "--tag", "Errands", "--tag", "HOME")
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        with open(self.db) as f:
+            data = json.load(f)
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags_save_nothing(self):
+        for bad in ["", "   ", "two words", "a,b", "a#b"]:
+            with self.subTest(bad=bad):
+                code, out, err = run(self.db, "add", "n", "--tag", bad)
+                self.assertEqual(code, 2)
+                self.assertIn("invalid tag", err)
+                self.assertEqual(out, "")
+                self.assertFalse(os.path.exists(self.db))
+
+        run(self.db, "add", "keep")
+        code, _, err = run(self.db, "add", "bad", "--tag", "a,b")
+        self.assertEqual(code, 2)
+        self.assertIn("a,b", err)
+        self.assertEqual(run(self.db, "list")[1], "  1  keep\n")
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        run(self.db, "add", "Read book", "--tag", "errands")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "HOME")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "Errands")[1],
+            "  1  Buy milk  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tags_command(self):
