+def tag_words(tags):
+    """Tags rendered as `#tag` words separated by single spaces."""
+    return " ".join("#" + t for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + tag_words(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {tag_words(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..ca5dda8 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    pass
+
+
+def normalize_tag(tag):
+    """Lowercase and trim one tag, rejecting tags that cannot be written."""
+    clean = tag.strip().lower()
+    if not clean or any(c.isspace() for c in clean) or "," in clean or "#" in clean:
+        raise InvalidTag(tag)
+    return clean
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates while keeping first-seen order."""
+    out = []
+    for tag in tags:
+        clean = normalize_tag(tag)
+        if clean not in out:
+            out.append(clean)
+    return out
 
 
 @dataclass
