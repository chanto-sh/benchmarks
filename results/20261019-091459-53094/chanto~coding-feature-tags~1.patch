@@ -38,6 +38,31 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def tag(self, note_id, tags):
+        note = self.get(note_id)
+        for tag in tags:
+            if tag not in note.tags:
+                note.tags.append(tag)
+        return note
+
+    def untag(self, note_id, tags):
+        note = self.get(note_id)
+        note.tags = [t for t in note.tags if t not in tags]
+        return note
+
+    def with_tags(self, tags):
+        """Notes carrying every one of ``tags`` (compared case-insensitively)."""
+        wanted = {t.strip().lower() for t in tags}
+        return [n for n in self.notes if wanted <= set(n.tags)]
+
+    def tag_counts(self):
+        """(tag, count) pairs, most used first, ties alphabetical."""
+        counts = {}
+        for note in self.notes:
+            for tag in note.tags:
+                counts[tag] = counts.get(tag, 0) + 1
+        return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+
     def save(self):
         tmp = self.path + ".tmp"
         with open(tmp, "w") as f:
