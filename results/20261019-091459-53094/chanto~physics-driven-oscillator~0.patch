 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _steady_state(m, k, c, F0, omega):
+    """Return the driving frequency response and its cosine/sine coefficients.
+
+    The particular solution is written as
+
+        x_p(t) = X cos(omega t) + Y sin(omega t).
+
+    ``a * a + b * b`` is the squared denominator of the response.  Factoring
+    ``a = k - m omega**2`` avoids cancellation when the drive is close to the
+    natural frequency.
+    """
+    if m > 0.0 and k >= 0.0:
+        root_k = math.sqrt(k)
+        root_m_omega = math.sqrt(m) * omega
+        a = (root_k - root_m_omega) * (root_k + root_m_omega)
+    else:
+        a = k - m * omega * omega
+
+    b = c * omega
+    denominator = math.hypot(a, b)
+    if denominator == 0.0:
+        raise ValueError("undamped resonance has no finite steady-state amplitude")
+
+    response = F0 / denominator
+    return response, response * (a / denominator), response * (b / denominator)
+
 
