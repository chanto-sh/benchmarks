+def test_config_from_file_binary(tmp_path):
+    tomllib = pytest.importorskip("tomllib")
+    path = tmp_path / "config.toml"
+    path.write_text('TEST_KEY = "foo"\nSECRET_KEY = "config"\n')
+
+    app = flask.Flask(__name__)
+    app.config.from_file(str(path), tomllib.load, text=False)
+    common_object_test(app)
+
