@@ -1,2 +1,27 @@
 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL or a case-insensitive UNIQUE constraint to an
+-- existing table, so rebuild it. Every row is copied unchanged; if the
+-- existing data violates the new constraints the INSERT fails atomically and
+-- the whole migration rolls back, leaving users untouched.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+-- Create the index before copying so a case-insensitive duplicate makes the
+-- INSERT fail while the original users table is still in place.
+CREATE UNIQUE INDEX users_email_nocase ON users_new (lower(email));
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
