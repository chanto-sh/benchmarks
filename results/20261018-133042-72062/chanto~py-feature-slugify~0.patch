@@ -0,0 +1,56 @@
+import unittest
+
+from text_utils import slugify
+
+
+class SlugifyTests(unittest.TestCase):
+    def test_docstring_examples(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+        self.assertEqual(slugify("  Crème Brûlée  "), "creme-brulee")
+        self.assertEqual(slugify("a--b__c"), "a-b-c")
+        self.assertEqual(slugify("The quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("!!!"), "")
+
+    def test_lowercases_and_collapses_separators(self):
+        self.assertEqual(slugify("  Hello...   WORLD  "), "hello-world")
+        self.assertEqual(slugify("one\ttwo\nthree"), "one-two-three")
+
+    def test_keeps_letters_and_digits(self):
+        self.assertEqual(slugify("Python 3.12"), "python-3-12")
+        self.assertEqual(slugify("abc123"), "abc123")
+
+    def test_accented_latin_letters(self):
+        self.assertEqual(slugify("jalapeño"), "jalapeno")
+        self.assertEqual(slugify("über"), "uber")
+        self.assertEqual(slugify("Crème Brûlée"), "creme-brulee")
+        self.assertEqual(slugify("Æther"), "aether")
+
+    def test_empty_inputs(self):
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify("   "), "")
+        self.assertEqual(slugify("---___!!!"), "")
+
+    def test_no_leading_or_trailing_hyphens(self):
+        self.assertEqual(slugify("---hello---world---"), "hello-world")
+
+    def test_max_length_keeps_whole_slug(self):
+        self.assertEqual(slugify("hello world", max_length=11), "hello-world")
+        self.assertEqual(slugify("hello world", max_length=50), "hello-world")
+
+    def test_max_length_cuts_at_hyphen_boundary(self):
+        self.assertEqual(slugify("the quick brown fox", max_length=13), "the-quick")
+        self.assertEqual(slugify("one two three", max_length=8), "one-two")
+
+    def test_max_length_never_leaves_trailing_hyphen(self):
+        self.assertEqual(slugify("abc def", max_length=4), "abc")
+        self.assertEqual(slugify("hello world", max_length=6), "hello")
+
+    def test_max_length_cuts_mid_word_when_no_boundary(self):
+        self.assertEqual(slugify("hello world", max_length=5), "hello")
+
+    def test_zero_max_length(self):
+        self.assertEqual(slugify("hello", max_length=0), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
