 """Text helpers."""
 
+import re
+import unicodedata
+
+# Letters that do not decompose into an ASCII base letter plus combining marks.
+_SPECIAL_CHARS = str.maketrans(
+    {
+        "æ": "ae",
+        "Æ": "ae",
+        "œ": "oe",
+        "Œ": "oe",
+        "ø": "o",
+        "Ø": "o",
+        "ß": "ss",
+        "đ": "d",
+        "Đ": "d",
+        "ð": "d",
+        "Ð": "d",
+        "ł": "l",
+        "Ł": "l",
+        "þ": "th",
+        "Þ": "th",
+        "ħ": "h",
+        "Ħ": "h",
+        "ŧ": "t",
+        "Ŧ": "t",
+        "ŋ": "n",
+        "Ŋ": "n",
+        "ı": "i",
+    }
+)
+
 
 def slugify(text, max_length=None):
     """Convert text to a URL slug.
@@ -20,4 +51,19 @@ def slugify(text, max_length=None):
         slugify("The quick brown fox", max_length=13) == "the-quick"
         slugify("!!!") == ""
     """
-    raise NotImplementedError
+    text = text.lower().translate(_SPECIAL_CHARS)
+    # NFKD splits accented letters into a base letter plus combining marks.
+    text = unicodedata.normalize("NFKD", text)
+    text = "".join(char for char in text if not unicodedata.combining(char))
+    slug = re.sub(r"[^a-z0-9]+", "-", text).strip("-")
+
+    if max_length is not None and len(slug) > max_length:
+        if max_length <= 0:
+            return ""
+        slug = slug[:max_length]
+        if slug.endswith("-"):
+            slug = slug[:-1]
+        elif "-" in slug:
+            slug = slug[: slug.rfind("-")]
+
+    return slug
