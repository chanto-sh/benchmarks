+    def _create_iou(self, lender, borrower, amount):
+        lender_user = self.users[lender]
+        borrower_user = self.users[borrower]
+
+        # Amount the lender already owes the borrower.
+        existing = lender_user["owes"].get(borrower, 0.0)
+        if existing:
+            if amount >= existing:
+                del lender_user["owes"][borrower]
+                del borrower_user["owed_by"][lender]
+                remaining = amount - existing
+                if remaining:
+                    borrower_user["owes"][lender] = remaining
+                    lender_user["owed_by"][borrower] = remaining
+            else:
+                left = existing - amount
+                lender_user["owes"][borrower] = left
+                borrower_user["owed_by"][lender] = left
+        else:
+            borrower_user["owes"][lender] = (
+                borrower_user["owes"].get(lender, 0.0) + amount
+            )
+            lender_user["owed_by"][borrower] = (
+                lender_user["owed_by"].get(borrower, 0.0) + amount
+            )
+
+        for user in (lender_user, borrower_user):
+            user["balance"] = round(
+                sum(user["owed_by"].values()) - sum(user["owes"].values()), 2
+            )
+
+        names = sorted([lender, borrower])
+        return json.dumps({"users": [self.users[name] for name in names]})
