+// rollState reports the maximum number of pins the next roll may knock down,
+// and whether the game is already over.
+func (g *Game) rollState() (max int, over bool) {
+	frame := 0
+	i := 0
+
+	// Consume the first nine frames.
+	for frame < 9 {
+		if i >= len(g.rolls) {
+			return 10, false
+		}
+		if g.rolls[i] == 10 {
+			frame++
+			i++
+			continue
+		}
+		if i+1 >= len(g.rolls) {
+			// First roll of the current frame: one pin per standing pin left.
+			return 10 - g.rolls[i], false
+		}
+		frame++
+		i += 2
+	}
+
+	// Handle the tenth frame, including its bonus rolls.
+	remaining := g.rolls[i:]
+	switch len(remaining) {
+	case 0:
+		return 10, false
+	case 1:
+		if remaining[0] == 10 {
+			return 10, false
+		}
+		return 10 - remaining[0], false
+	case 2:
+		if remaining[0] == 10 {
+			if remaining[1] == 10 {
+				return 10, false
+			}
+			return 10 - remaining[1], false
+		}
+		if remaining[0]+remaining[1] == 10 {
+			return 10, false
+		}
+		return 0, true
+	default:
+		return 0, true
+	}
