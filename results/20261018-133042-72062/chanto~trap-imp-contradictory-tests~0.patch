 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Decompose accented characters so their combining marks can be dropped.
+    text = unicodedata.normalize("NFKD", title)
+    text = "".join(ch for ch in text if not unicodedata.combining(ch))
+    text = text.lower()
+    # Apostrophes and periods join words rather than separate them
+    # ("What's" -> "whats", "2.0" -> "20").
+    text = re.sub(r"['\u2019.]", "", text)
+    # Spec 4.5: slugs only ever contain [a-z0-9-].
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+    return text.strip("-")
