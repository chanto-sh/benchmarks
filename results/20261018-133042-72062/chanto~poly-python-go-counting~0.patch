+            region.add((cx, cy))
+            for nx, ny in self._neighbors(cx, cy):
+                value = self.board[ny][nx]
+                if value == " ":
+                    stack.append((nx, ny))
+                else:
+                    borders.add(value)
+        return region, borders
 
