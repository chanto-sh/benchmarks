diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..7b7d518 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -20,6 +20,41 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (x - 1)(1000000x - 1000001), roots 1 and 1.000001
+        self.assertRoots(
+            real_roots([1000000, -2000001, 1000001], 0, 2), [1, 1.000001]
+        )
+
+    def test_roots_on_boundaries(self):
+        # x^2 - 1 with both roots exactly on the interval endpoints
+        self.assertRoots(real_roots([1, 0, -1], -1, 1), [-1, 1])
+        self.assertRoots(real_roots([1, 0, -1], 1, 2), [1])
+        self.assertRoots(real_roots([1, 0, -1], -2, -1), [-1])
+        self.assertRoots(real_roots([1, 0, -1], 1, 1), [1])
+
+    def test_large_coefficients(self):
+        # 10^12 (x - 3)(x + 1)
+        coeffs = [10**12, -2 * 10**12, -3 * 10**12]
+        self.assertRoots(real_roots(coeffs, -5, 5), [-1, 3])
+
+    def test_high_degree_with_repeated_roots(self):
+        # 10^8 (x - 1)^2 (x - 2)^2 ... (x - 7)^2, degree 14
+        coeffs = [1]
+        for r in range(1, 8):
+            for _ in range(2):
+                new = [0] * (len(coeffs) + 1)
+                for i, a in enumerate(coeffs):
+                    new[i] += a
+                    new[i + 1] -= r * a
+                coeffs = new
+        coeffs = [10**8 * c for c in coeffs]
+        self.assertRoots(real_roots(coeffs, 0, 8), [float(r) for r in range(1, 8)])
+
 
 if __name__ == "__main__":
     unittest.main()
