 """Real roots of integer polynomials, used by the curve-fitting tool."""
 
+from fractions import Fraction
+from math import gcd as _gcd
+
+# Bisection stops once the isolating interval is this narrow.  The returned
+# midpoint is then within _TOL / 2 of the root.
+_TOL = Fraction(1, 10**12)
