+def _trim(p):
+    """Drop leading zero coefficients and make every coefficient a Fraction."""
+    i = 0
+    while i < len(p) and p[i] == 0:
+        i += 1
+    return [Fraction(c) for c in p[i:]]
+
+
+def _derivative(p):
+    n = len(p) - 1
+    return _trim([p[i] * (n - i) for i in range(n)])
+
+
+def _primitive(p, positive_leading=False):
+    """Clear denominators and common integer factors.
+
+    Scaling a polynomial by a positive constant does not change any signs, so
+    this is safe inside a Sturm sequence.  `positive_leading` is only used
+    where an arbitrary nonzero scaling is allowed (gcds and square-free
+    parts).
+    """
+    p = _trim(p)
+    if not p:
+        return []
+    den = 1
+    for c in p:
+        den = den * c.denominator // _gcd(den, c.denominator)
+    ints = [int(c * den) for c in p]
+    g = 0
+    for v in ints:
+        g = _gcd(g, abs(v))
+    if g:
+        ints = [v // g for v in ints]
+    if positive_leading and ints[0] < 0:
+        ints = [-v for v in ints]
+    return [Fraction(v) for v in ints]
+
+
+def _divmod(a, b):
+    """Polynomial division, highest degree first."""
+    a, b = _trim(a), _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = a[:]
+    while r and len(r) >= len(b):
+        factor = r[0] / b[0]
+        q[len(a) - len(r)] = factor
+        for i in range(len(b)):
+            r[i] -= factor * b[i]
+        r = _trim(r)
+    return q, r
+
+
+def _gcd_poly(a, b):
+    a, b = _trim(a), _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    return _primitive(a, positive_leading=True)
+
+
+def _square_free(p):
+    """Product of the distinct irreducible factors of p."""
+    p = _primitive(p, positive_leading=True)
+    if len(p) <= 1:
+        return p
+    g = _gcd_poly(p, _derivative(p))
+    q, _ = _divmod(p, g)
+    return _primitive(q, positive_leading=True)
+
+
+def _sturm(p):
+    """Sturm sequence for a square-free polynomial p."""
+    p = _primitive(p, positive_leading=True)
+    seq = [p, _derivative(p)]
+    while seq[-1]:
+        _, r = _divmod(seq[-2], seq[-1])
+        if not r:
+            break
+        # Exact recurrence requires -remainder.  _primitive must not flip the
+        # sign here, only scale by a positive constant.
+        seq.append(_primitive([-c for c in r]))
+    return seq
+
+
+def _sign(x):
+    return (x > 0) - (x < 0)
+
+
+def _variations(seq, x):
+    """Number of sign changes in the Sturm sequence evaluated at x."""
+    changes = 0
+    previous = 0
+    for poly in seq:
+        s = _sign(evaluate(poly, x))
+        if s:
+            if previous and s != previous:
+                changes += 1
+            previous = s
+    return changes
+
+
+def _refine(p, seq, a, b):
+    """Narrow an interval known to contain exactly one root in (a, b]."""
+    while True:
+        if evaluate(p, b) == 0:
+            return b
+        if b - a <= _TOL:
+            return (a + b) / 2
+        m = (a + b) / 2
+        fm = evaluate(p, m)
+        if fm == 0:
+            return m
+        fa = evaluate(p, a)
+        if fa != 0:
+            # No root at either endpoint, so the signs differ and ordinary
+            # bisection is valid.
+            if _sign(fa) != _sign(fm):
+                b = m
+            else:
+                a = m
+        else:
+            # a itself is a root (the interval is open at a).  Use the
+            # Sturm count to decide which half holds the wanted root.
+            if _variations(seq, a) - _variations(seq, m) > 0:
+                b = m
+            else:
+                a = m
+
