+fn expand(codon: &str) -> Result<Vec<String>, Error> {
+    let bases: Vec<char> = codon.chars().collect();
+    if bases.len() != 3 {
+        return Err(Error);
+    }
+
+    let mut expansions = vec![String::new()];
+    for base in bases {
+        let possibilities = possibilities(base).ok_or(Error)?;
+        let mut next = Vec::with_capacity(expansions.len() * possibilities.len());
+
+        for prefix in &expansions {
+            for &possible in possibilities {
+                let mut expansion = prefix.clone();
+                expansion.push(possible as char);
+                next.push(expansion);
+            }
+        }
+
+        expansions = next;
+    }
+
+    Ok(expansions)
+}
