 """Orbit measurements for a test particle in a central force field."""
 
+import math
+
 
 def newtonian(gm):
     """Inverse-square attraction toward the origin."""
@@ -9,6 +11,169 @@ def newtonian(gm):
     return accel
 
 
+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0, -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0, 49.0 / 176.0,
+     -5103.0 / 18656.0),
+)
+_B5 = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+       -2187.0 / 6784.0, 11.0 / 84.0)
+_BERR = (-71.0 / 57600.0, 0.0, 71.0 / 16695.0, -71.0 / 1920.0,
+         17253.0 / 339200.0, -22.0 / 525.0, 1.0 / 40.0)
+
+
+def _rk45_step(state, h, k1, func):
+    """Take one Dormand-Prince step.
+
+    Returns the fifth-order solution, its derivative (used as the first
+    stage of the next step), and the stages used for the error estimate.
+    """
+    k = [k1]
+    for row in _A[1:]:
+        y = [state[i] + h * sum(row[j] * k[j][i] for j in range(len(row)))
+             for i in range(4)]
+        k.append(func(y))
+
+    y_new = [state[i] + h * sum(_B5[j] * k[j][i] for j in range(6))
+             for i in range(4)]
+    k_new = func(y_new)
+    k.append(k_new)
+
+    return y_new, k_new, k
+
+
+def _event_fraction(state, k1, h, func):
+    """Locate the (negative-to-positive) zero of q inside one RK step."""
+    lo, hi = 0.0, 1.0
+    for _ in range(60):
+        u = 0.5 * (lo + hi)
+        y, _, _ = _rk45_step(state, u * h, k1, func)
+        q = y[0] * y[2] + y[1] * y[3]
+        if q < 0.0:
+            lo = u
+        else:
+            hi = u
+    return 0.5 * (lo + hi)
+
+
 def radial_period(r0, v0, accel):
     """Time between two successive closest approaches to the origin."""
-    raise NotImplementedError
+    x0, y0 = r0
+    vx0, vy0 = v0
+    r = math.hypot(x0, y0)
+    if r == 0.0:
+        raise ValueError("the particle starts at the force centre")
+    if not all(math.isfinite(c) for c in (x0, y0, vx0, vy0)):
+        raise ValueError("initial conditions must be finite")
+
+    v2 = vx0 * vx0 + vy0 * vy0
+    q = x0 * vx0 + y0 * vy0
+    ax0, ay0 = accel(x0, y0)
+    a_rad = (x0 * ax0 + y0 * ay0) / r
+    rddot = (v2 + x0 * ax0 + y0 * ay0) / r - q * q / (r * r * r)
+
+    # A circular orbit has no distinguished closest approach.  Treat one
+    # complete revolution as its (degenerate) radial period.
+    if (abs(q) <= 1e-14 * r * math.sqrt(v2)
+            and abs(rddot) <= 1e-12 * (v2 / r + abs(a_rad))):
+        speed = math.sqrt(v2)
+        if speed > 0.0:
+            return 2.0 * math.pi * r / speed
+
+    def func(y):
+        x, ypos, vx, vy = y
+        ax, ay = accel(x, ypos)
+        return (vx, vy, ax, ay)
+
+    state = [x0, y0, vx0, vy0]
+    k1 = func(state)
+
+    # Start with a small fraction of the shortest local dynamical time.
+    a_mag = math.hypot(ax0, ay0)
+    v_mag = math.sqrt(v2)
+    times = []
+    if v_mag > 0.0:
+        times.append(r / v_mag)
+    if a_mag > 0.0:
+        times.append(math.sqrt(r / a_mag))
+    if times:
+        h = 0.005 * min(times)
+    else:
+        h = 1e-3 * r
+
+    # Tolerance is relative to the scale of the initial state.  The required
+    # 1e-6 accuracy is far less demanding than these settings.
+    v_scale = max(v_mag, math.sqrt(a_mag * r), 1e-300)
+    atol = (1e-14 * r, 1e-14 * r, 1e-14 * v_scale, 1e-14 * v_scale)
+    rtol = 1e-12
+
+    t = 0.0
+    q_prev = q
+    crossings = 0
+    first_crossing = None
+
+    # If we start exactly at a pericentre, that instant is the first one.
+    if q == 0.0 and rddot > 0.0:
+        crossings = 1
+        first_crossing = 0.0
+
+    max_steps = 200000
+    for _ in range(max_steps):
+        # Take an accepted adaptive step.
+        while True:
+            y_new, k_new, k = _rk45_step(state, h, k1, func)
+            err = 0.0
+            for i in range(4):
+                sci = atol[i] + rtol * max(abs(state[i]), abs(y_new[i]))
+                err = max(err, abs(h * sum(
+                    _BERR[j] * k[j][i] for j in range(7))) / sci)
+            if err <= 1.0:
+                break
+            factor = max(0.2, 0.9 * err ** (-0.2))
+            h *= factor
+
+        h_used = h
+        x, y, vx, vy = y_new
+        ax, ay = k_new[2], k_new[3]
+        q_new = x * vx + y * vy
+
+        # The radial velocity changes from inward to outward at a pericentre.
+        if q_prev < 0.0 <= q_new:
+            u = _event_fraction(state, k1, h_used, func)
+            event_time = t + u * h_used
+            crossings += 1
+            if crossings == 1:
+                first_crossing = event_time
+            else:
+                return event_time - first_crossing
+
+        # Advance and choose the next step size.
+        t += h_used
+        state = y_new
+        k1 = k_new
+        q_prev = q_new
+
+        if err == 0.0:
+            factor = 5.0
+        else:
+            factor = min(5.0, max(0.2, 0.9 * err ** (-0.2)))
+        h = h_used * factor
+
+        # Do not let an adaptive step jump over a narrow pericentre passage.
+        r_now = math.hypot(state[0], state[1])
+        v_now = math.hypot(state[2], state[3])
+        a_now = math.hypot(k1[2], k1[3])
+        caps = []
+        if v_now > 0.0:
+            caps.append(r_now / v_now)
+        if a_now > 0.0:
+            caps.append(math.sqrt(r_now / a_now))
+        if caps:
+            h = min(h, 0.05 * min(caps))
+
+    raise RuntimeError("no second closest approach found")
