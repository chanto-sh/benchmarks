+import unittest
+
+from roman import to_roman
+
+
+VALID_SYMBOLS = set("IVXLCDM")
+
+
+def from_roman(s):
+    """Independent reference parser used to check round trips."""
+    values = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
+    total = 0
+    for i, ch in enumerate(s):
+        value = values[ch]
+        if i + 1 < len(s) and values[s[i + 1]] > value:
+            total -= value
+        else:
+            total += value
+    return total
+
+
+class TestNormalValues(unittest.TestCase):
+    def test_known_values(self):
+        cases = {
+            1: "I",
+            2: "II",
+            3: "III",
+            5: "V",
+            6: "VI",
+            7: "VII",
+            8: "VIII",
+            10: "X",
+            11: "XI",
+            13: "XIII",
+            15: "XV",
+            20: "XX",
+            30: "XXX",
+            50: "L",
+            60: "LX",
+            80: "LXXX",
+            100: "C",
+            200: "CC",
+            300: "CCC",
+            500: "D",
+            600: "DC",
+            800: "DCCC",
+            1000: "M",
+            2000: "MM",
+            3000: "MMM",
+        }
+        for number, expected in cases.items():
+            with self.subTest(number=number):
+                self.assertEqual(to_roman(number), expected)
+
+    def test_compound_values(self):
+        cases = {
+            14: "XIV",
+            16: "XVI",
+            19: "XIX",
+            28: "XXVIII",
+            39: "XXXIX",
+            44: "XLIV",
+            49: "XLIX",
+            68: "LXVIII",
+            88: "LXXXVIII",
+            99: "XCIX",
+            111: "CXI",
+            444: "CDXLIV",
+            666: "DCLXVI",
+            999: "CMXCIX",
+            1234: "MCCXXXIV",
+            1666: "MDCLXVI",
+            1987: "MCMLXXXVII",
+            2024: "MMXXIV",
+            2421: "MMCDXXI",
+            3888: "MMMDCCCLXXXVIII",
+        }
+        for number, expected in cases.items():
+            with self.subTest(number=number):
+                self.assertEqual(to_roman(number), expected)
+
+    def test_returns_a_string(self):
+        self.assertIsInstance(to_roman(42), str)
+
+
+class TestBoundaries(unittest.TestCase):
+    def test_lower_boundary(self):
+        self.assertEqual(to_roman(1), "I")
+
+    def test_upper_boundary(self):
+        self.assertEqual(to_roman(3999), "MMMCMXCIX")
+
+    def test_values_just_inside_boundaries(self):
+        self.assertEqual(to_roman(2), "II")
+        self.assertEqual(to_roman(3998), "MMMCMXCVIII")
+
+    def test_every_value_in_range_round_trips(self):
+        for number in range(1, 4000):
+            with self.subTest(number=number):
+                numeral = to_roman(number)
+                self.assertEqual(from_roman(numeral), number)
+
+    def test_every_value_in_range_produces_canonical_numeral(self):
+        # Canonical Roman numerals only use IVXLCDM and never repeat the
+        # five/ten-based symbols (V, L, D) or any symbol more than three times.
+        forbidden = ("IIII", "XXXX", "CCCC", "MMMM", "VV", "LL", "DD")
+        for number in range(1, 4000):
+            numeral = to_roman(number)
+            with self.subTest(number=number):
+                self.assertTrue(set(numeral) <= VALID_SYMBOLS)
+                self.assertTrue(numeral)
+                for pattern in forbidden:
+                    self.assertNotIn(pattern, numeral)
+
+
+class TestSubtractiveForms(unittest.TestCase):
+    def test_single_subtractive_pairs(self):
+        cases = {
+            4: "IV",
+            9: "IX",
+            40: "XL",
+            90: "XC",
+            400: "CD",
+            900: "CM",
+        }
+        for number, expected in cases.items():
+            with self.subTest(number=number):
+                self.assertEqual(to_roman(number), expected)
+
+    def test_subtractive_forms_combined(self):
+        cases = {
+            49: "XLIX",
+            94: "XCIV",
+            99: "XCIX",
+            444: "CDXLIV",
+            449: "CDXLIX",
+            499: "CDXCIX",
+            949: "CMXLIX",
+            994: "CMXCIV",
+            999: "CMXCIX",
+            1994: "MCMXCIV",
+            3994: "MMMCMXCIV",
+        }
+        for number, expected in cases.items():
+            with self.subTest(number=number):
+                self.assertEqual(to_roman(number), expected)
+
+    def test_subtractive_symbol_appears_before_larger_symbol(self):
+        self.assertLess(to_roman(4).index("I"), to_roman(4).index("V"))
+        self.assertLess(to_roman(400).index("C"), to_roman(400).index("D"))
+        self.assertLess(to_roman(900).index("C"), to_roman(900).index("M"))
+
+
+class TestInvalidInputs(unittest.TestCase):
+    def test_zero(self):
+        with self.assertRaises(ValueError):
+            to_roman(0)
+
+    def test_negative_values(self):
+        for number in (-1, -4, -3999, -4000):
+            with self.subTest(number=number):
+                with self.assertRaises(ValueError):
+                    to_roman(number)
+
+    def test_above_upper_boundary(self):
+        for number in (4000, 4001, 5000, 10000):
+            with self.subTest(number=number):
+                with self.assertRaises(ValueError):
+                    to_roman(number)
+
+    def test_booleans_are_rejected(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_floats_are_rejected(self):
+        for value in (1.0, 4.0, 3999.0, 1.5, 0.0, -1.0, 4000.0):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_strings_are_rejected(self):
+        for value in ("1", "IV", "", "3999", " 1 "):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_other_types_are_rejected(self):
+        for value in (None, [], [1], (1,), {1: "I"}, 1 + 0j, object()):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    to_roman(value)
+
+    def test_error_is_value_error_not_type_error(self):
+        with self.assertRaises(ValueError) as ctx:
+            to_roman(4000)
+        self.assertNotIsInstance(ctx.exception, TypeError)
+
+
+if __name__ == "__main__":
+    unittest.main()
