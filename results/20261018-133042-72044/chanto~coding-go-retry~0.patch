 func defaultSleep(ctx context.Context, d time.Duration) error {
-	time.Sleep(d)
-	return nil
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
+
+// backoff returns Base*2^(n-1), saturating instead of overflowing.
+func backoff(base time.Duration, n int) time.Duration {
+	if n <= 1 || base == 0 {
+		return base
+	}
+	const maxDuration = time.Duration(1<<63 - 1)
+	shift := uint(n - 1)
+	if base > 0 && (shift >= 63 || base > maxDuration>>shift) {
+		return maxDuration
+	}
+	return base << shift
 }
 
