 package forth
 
+import (
+	"errors"
+	"strconv"
+	"strings"
+)
+
+type instruction struct {
+	op  int
+	arg int
+}
+
+const (
+	opPush = iota
+	opAdd
+	opSub
+	opMul
+	opDiv
+	opDup
+	opDrop
+	opSwap
+	opOver
+)
+
+var builtins = map[string]int{
+	"+":    opAdd,
+	"-":    opSub,
+	"*":    opMul,
+	"/":    opDiv,
+	"dup":  opDup,
+	"drop": opDrop,
+	"swap": opSwap,
+	"over": opOver,
+}
+
 func Forth(input []string) ([]int, error) {
-	panic("Please implement the Forth function")
+	stack := []int{}
+	defs := map[string][]instruction{}
+
+	for _, line := range input {
+		fields := strings.Fields(line)
+		for i := 0; i < len(fields); {
+			token := strings.ToLower(fields[i])
+
+			if token == ":" {
+				if i+1 >= len(fields) {
+					return nil, errors.New("missing word name")
+				}
+				name := strings.ToLower(fields[i+1])
+				if _, err := strconv.Atoi(name); err == nil {
+					return nil, errors.New("illegal operation")
+				}
+				i += 2
+
+				body := []instruction{}
+				terminated := false
+				for ; i < len(fields); i++ {
+					t := strings.ToLower(fields[i])
+					if t == ";" {
+						terminated = true
+						i++
+						break
+					}
+					if t == ":" {
+						return nil, errors.New("illegal operation")
+					}
+					if n, err := strconv.Atoi(t); err == nil {
+						body = append(body, instruction{opPush, n})
+						continue
+					}
+					if d, ok := defs[t]; ok {
+						body = append(body, d...)
+						continue
+					}
+					if b, ok := builtins[t]; ok {
+						body = append(body, instruction{b, 0})
+						continue
+					}
+					return nil, errors.New("undefined operation")
+				}
+				if !terminated {
+					return nil, errors.New("missing ;")
+				}
+				defs[name] = body
+				continue
+			}
+
+			if n, err := strconv.Atoi(token); err == nil {
+				stack = append(stack, n)
+				i++
+				continue
+			}
+
+			var body []instruction
+			if d, ok := defs[token]; ok {
+				body = d
+			} else if b, ok := builtins[token]; ok {
+				body = []instruction{{b, 0}}
+			} else {
+				return nil, errors.New("undefined operation")
+			}
+
+			var err error
+			stack, err = execute(body, stack)
+			if err != nil {
+				return nil, err
+			}
+			i++
+		}
+	}
+
+	return stack, nil
+}
+
+func execute(body []instruction, stack []int) ([]int, error) {
+	for _, in := range body {
+		switch in.op {
+		case opPush:
+			stack = append(stack, in.arg)
+
+		case opAdd, opSub, opMul, opDiv:
+			if len(stack) == 0 {
+				return nil, errors.New("empty stack")
+			}
+			if len(stack) == 1 {
+				return nil, errors.New("only one value on the stack")
+			}
+			b := stack[len(stack)-1]
+			a := stack[len(stack)-2]
+			var result int
+			switch in.op {
+			case opAdd:
+				result = a + b
+			case opSub:
+				result = a - b
+			case opMul:
+				result = a * b
+			case opDiv:
+				if b == 0 {
+					return nil, errors.New("divide by zero")
+				}
+				result = a / b
+			}
+			stack = append(stack[:len(stack)-2], result)
+
+		case opDup:
+			if len(stack) == 0 {
+				return nil, errors.New("empty stack")
+			}
+			stack = append(stack, stack[len(stack)-1])
+
+		case opDrop:
+			if len(stack) == 0 {
+				return nil, errors.New("empty stack")
+			}
+			stack = stack[:len(stack)-1]
+
+		case opSwap:
+			if len(stack) == 0 {
+				return nil, errors.New("empty stack")
+			}
+			if len(stack) == 1 {
+				return nil, errors.New("only one value on the stack")
+			}
+			stack[len(stack)-1], stack[len(stack)-2] = stack[len(stack)-2], stack[len(stack)-1]
+
+		case opOver:
+			if len(stack) == 0 {
+				return nil, errors.New("empty stack")
+			}
+			if len(stack) == 1 {
+				return nil, errors.New("only one value on the stack")
+			}
+			stack = append(stack, stack[len(stack)-2])
+		}
+	}
+	return stack, nil
 }
