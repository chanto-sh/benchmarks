+from collections import deque
+
+
 def measure(bucket_one, bucket_two, goal, start_bucket):
-    pass
+    if start_bucket not in ("one", "two"):
+        raise ValueError("start_bucket must be either 'one' or 'two'.")
+
+    caps = (bucket_one, bucket_two)
+    start = 0 if start_bucket == "one" else 1
+
+    if goal > max(caps):
+        raise ValueError("Goal is larger than both buckets, so it is impossible.")
+
+    def forbidden(state):
+        other = 1 - start
+        return state[start] == 0 and state[other] == caps[other]
+
+    def next_states(state):
+        a, b = state
+        candidates = []
+
+        # Fill either bucket.
+        if a < caps[0]:
+            candidates.append((caps[0], b))
+        if b < caps[1]:
+            candidates.append((a, caps[1]))
+
+        # Empty either bucket.
+        if a > 0:
+            candidates.append((0, b))
+        if b > 0:
+            candidates.append((a, 0))
+
+        # Pour one bucket into the other.
+        pour = min(a, caps[1] - b)
+        if pour > 0:
+            candidates.append((a - pour, b + pour))
+        pour = min(b, caps[0] - a)
+        if pour > 0:
+            candidates.append((a + pour, b - pour))
+
+        return [
+            state
+            for state in candidates
+            if state != (a, b) and not forbidden(state)
+        ]
+
+    initial = [0, 0]
+    initial[start] = caps[start]
+    initial = tuple(initial)
+
+    queue = deque([(initial, 1)])
+    seen = {initial}
+
+    while queue:
+        state, steps = queue.popleft()
+
+        if state[0] == goal:
+            return (steps, "one", state[1])
+        if state[1] == goal:
+            return (steps, "two", state[0])
+
+        for candidate in next_states(state):
+            if candidate not in seen:
+                seen.add(candidate)
+                queue.append((candidate, steps + 1))
+
+    raise ValueError("No solution is possible for the given buckets and goal.")
