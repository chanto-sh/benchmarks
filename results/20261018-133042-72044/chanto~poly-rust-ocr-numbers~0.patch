 pub fn convert(input: &str) -> Result<String, Error> {
-    todo!("Convert the input '{input}' to a string");
+    let lines: Vec<&str> = input.lines().collect();
+
+    if lines.len() % 4 != 0 {
+        return Err(Error::InvalidRowCount(lines.len()));
+    }
+
+    let mut width = None;
+    for line in &lines {
+        let count = line.chars().count();
+        if count % 3 != 0 {
+            return Err(Error::InvalidColumnCount(count));
+        }
+        match width {
+            None => width = Some(count),
+            Some(w) if w != count => return Err(Error::InvalidColumnCount(count)),
+            _ => {}
+        }
+    }
+
+    let width = width.unwrap_or(0);
+    let mut numbers = Vec::new();
+
+    for group in lines.chunks(4) {
+        let mut digits = String::new();
+        for start in (0..width).step_by(3) {
+            let mut pattern = String::new();
+            for row in group.iter().take(3) {
+                pattern.extend(row.chars().skip(start).take(3));
+            }
+            let digit = DIGITS
+                .iter()
+                .find(|(p, _)| *p == pattern)
+                .map(|(_, d)| *d)
+                .unwrap_or('?');
+            digits.push(digit);
+        }
+        numbers.push(digits);
+    }
+
+    Ok(numbers.join(","))
