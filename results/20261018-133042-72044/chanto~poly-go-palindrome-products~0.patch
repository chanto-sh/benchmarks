 package palindrome
 
-// Define Product type here.
+import "errors"
 
+// Product describes a palindromic product and all the factor pairs within
+// the requested range that produce it.
+type Product struct {
+	Value          int
+	Factorizations [][2]int
+}
+
+// Products returns the smallest and largest palindromic products that are the
+// product of two factors in [fmin, fmax], along with all their factorizations.
 func Products(fmin, fmax int) (Product, Product, error) {
-	panic("Please implement the Products function")
+	if fmin > fmax {
+		return Product{}, Product{}, errors.New("fmin > fmax")
+	}
+
+	var pmin, pmax Product
+	found := false
+
+	for a := fmin; a <= fmax; a++ {
+		for b := a; b <= fmax; b++ {
+			p := a * b
+			if !isPalindrome(p) {
+				continue
+			}
+
+			if !found {
+				pmin = Product{p, [][2]int{{a, b}}}
+				pmax = Product{p, [][2]int{{a, b}}}
+				found = true
+				continue
+			}
+
+			switch {
+			case p < pmin.Value:
+				pmin = Product{p, [][2]int{{a, b}}}
+			case p == pmin.Value:
+				pmin.Factorizations = append(pmin.Factorizations, [2]int{a, b})
+			}
+
+			switch {
+			case p > pmax.Value:
+				pmax = Product{p, [][2]int{{a, b}}}
+			case p == pmax.Value:
+				pmax.Factorizations = append(pmax.Factorizations, [2]int{a, b})
+			}
+		}
+	}
+
+	if !found {
+		return Product{}, Product{}, errors.New("no palindromes")
+	}
+
+	return pmin, pmax, nil
+}
+
+func isPalindrome(n int) bool {
+	if n < 0 {
+		return false
+	}
+
+	reversed, original := 0, n
+	for original > 0 {
+		reversed = reversed*10 + original%10
+		original /= 10
+	}
+	return reversed == n
 }
