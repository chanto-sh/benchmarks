+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (x - 1)(1000000x - 1000001)
+        self.assertRoots(
+            real_roots([1000000, -2000001, 1000001], 0, 2), [1, 1.000001]
+        )
+
+    def test_roots_on_boundaries(self):
+        # (x - 1)(x - 2)
+        self.assertRoots(real_roots([1, -3, 2], 1, 2), [1, 2])
