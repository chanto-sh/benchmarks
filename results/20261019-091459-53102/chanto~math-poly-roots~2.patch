+def _primitive(coeffs, positive_leading=False):
+    """Scale a rational polynomial by a positive number to primitive integers."""
+    coeffs = _trim(coeffs)
+    if not coeffs:
+        return []
+    coeffs = [Fraction(c) for c in coeffs]
