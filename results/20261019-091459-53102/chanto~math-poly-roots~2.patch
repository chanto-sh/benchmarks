+    g = _gcd(p, _derivative(p))
+    if len(g) <= 1:
+        return p
+    q, _ = _divmod(p, g)
+    return _primitive(q, positive_leading=True)
+
+
+def _root_bound(p):
+    """Cauchy bound: every root has absolute value at most this."""
+    lead = abs(p[0])
+    largest = max((abs(c) for c in p[1:]), default=0)
+    return 1 + (largest + lead - 1) // lead
+
