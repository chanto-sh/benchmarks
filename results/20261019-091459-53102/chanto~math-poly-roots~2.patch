+def _rem(a, b):
+    """Remainder of a divided by b, highest degree first."""
+    r = [Fraction(c) for c in a]
+    db = len(b) - 1
+    lead = Fraction(b[0])
+    while len(r) - 1 >= db:
+        factor = r[0] / lead
+        for i, c in enumerate(b):
+            r[i] -= factor * c
+        while r and r[0] == 0:
+            r.pop(0)
+    return r
+
+
+def _divmod(a, b):
+    """Quotient and remainder of a divided by b, highest degree first."""
+    a = [Fraction(c) for c in a]
+    b = [Fraction(c) for c in b]
+    max_shift = len(a) - len(b)
+    q = [Fraction(0)] * (max_shift + 1)
+    r = a
+    lead = b[0]
+    while len(r) >= len(b):
+        shift = len(r) - len(b)
+        factor = r[0] / lead
+        q[max_shift - shift] = factor
+        for i, c in enumerate(b):
+            r[i] -= factor * c
+        while r and r[0] == 0:
+            r.pop(0)
+    return q, r
+
+
+def _gcd(a, b):
+    a = _primitive(a, positive_leading=True)
