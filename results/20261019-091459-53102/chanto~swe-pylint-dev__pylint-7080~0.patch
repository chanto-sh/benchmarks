     assert module in linted_file_paths
 
 
+def test_recursive_ignore_paths_directory_contents(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """An ignore-paths pattern matching a directory's contents ignores the directory.
+
+    Regression test for https://github.com/PyCQA/pylint/issues/7080.
+    """
+    src = tmp_path / "src"
+    generated = src / "gen"
+    generated.mkdir(parents=True)
+    (src / "region_selection.py").write_text("", encoding="utf-8")
+    (generated / "__init__.py").write_text("", encoding="utf-8")
+    (generated / "about.py").write_text("", encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+
+    run = Run(["--recursive=y", "--ignore-paths=^src/gen/.*$", "src/"], exit=False)
+    discovered = list(run.linter._discover_files(["src/"]))
+
+    assert not any("gen" in path for path in discovered)
+    assert any("region_selection.py" in path for path in discovered)
+
+
 def test_import_sibling_module_from_namespace(initialized_linter: PyLinter) -> None:
