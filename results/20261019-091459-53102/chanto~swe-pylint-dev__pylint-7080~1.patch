+def test_recursive_ignore_with_relative_path() -> None:
+    """Test ignore-paths is applied to paths that are not normalized.
+
+    When recursing from a relative path such as ``.``, discovered paths are
+    prefixed with ``./`` (and use mixed separators on Windows). They should
+    still be matched against the ``ignore-paths`` patterns.
+    """
+    current_dir = getcwd()
+    try:
+        chdir(join(REGRTEST_DATA_DIR, "directory"))
+        run = Run(
+            [
+                "--recursive",
+                "y",
+                "--ignore-paths",
+                r"^ignored_subdirectory/.*$",
+                ".",
+            ],
+            exit=False,
+        )
+        linted_file_paths = [
+            file_item.filepath
+            for file_item in run.linter._iterate_file_descrs(
+                tuple(run.linter._discover_files(["."]))
+            )
+        ]
+    finally:
+        chdir(current_dir)
+
+    assert "ignored_subdirectory/failing.py" not in linted_file_paths
+    assert "subdirectory/module.py" in linted_file_paths
+
+
