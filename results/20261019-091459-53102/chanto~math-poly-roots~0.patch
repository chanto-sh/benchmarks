+# Internally polynomials are lists of Fraction coefficients in ascending
+# degree order, with no trailing (high-degree) zeros.
+
+def _trim(p):
+    while p and p[-1] == 0:
+        p.pop()
+    return p
+
+
+def _from_desc(coeffs):
+    return _trim([Fraction(c) for c in reversed(coeffs)])
+
+
+def _eval(p, x):
+    y = Fraction(0)
+    for c in reversed(p):
+        y = y * x + c
+    return y
+
+
+def _derivative(p):
+    return _trim([i * p[i] for i in range(1, len(p))])
+
+
+def _divmod(a, b):
+    """Exact polynomial division, returning (quotient, remainder)."""
+    a = list(a)
+    b = _trim(list(b))
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    _trim(a)
+    if len(a) < len(b):
+        return [], a
+
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    while len(a) >= len(b):
+        shift = len(a) - len(b)
+        coeff = a[-1] / b[-1]
+        q[shift] = coeff
+        for i, c in enumerate(b):
+            a[shift + i] -= coeff * c
+        _trim(a)
+    return _trim(q), a
+
+
+def _monic(p):
+    p = _trim(list(p))
+    if not p:
+        return []
+    lead = p[-1]
+    return [c / lead for c in p]
+
+
+def _gcd(a, b):
+    a = _trim(list(a))
+    b = _trim(list(b))
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    return _monic(a)
+
+
+def _square_free_part(p):
+    """Product of the distinct irreducible factors of p, made monic."""
+    p = _trim(list(p))
+    if len(p) <= 1:
+        return p
+    g = _gcd(p, _derivative(p))
+    q, _ = _divmod(p, g)
+    return _monic(q)
+
+
+def _sturm_sequence(p):
+    """Sturm sequence for a square-free polynomial p."""
+    seq = [_monic(p)]
+    d = _derivative(seq[0])
+    if not d:
+        return seq
+    seq.append(d)
+    while True:
+        _, r = _divmod(seq[-2], seq[-1])
+        if not r:
+            break
+        seq.append([-c for c in r])
+    return seq
+
+
+def _variations(seq, x):
+    """Number of sign changes in the Sturm sequence at x, ignoring zeros."""
+    prev = 0
+    count = 0
+    for p in seq:
+        y = _eval(p, x)
+        if y == 0:
+            continue
+        sign = 1 if y > 0 else -1
+        if prev and sign != prev:
+            count += 1
+        prev = sign
+    return count
+
+
+_ROOT_TOL = Fraction(1, 10 ** 12)
+
+
+def _count_open(seq, p, a, b):
+    """Number of distinct roots strictly between a and b."""
+    if a == b:
+        return 0
+    count = _variations(seq, a) - _variations(seq, b)
+    # V(a) - V(b) counts roots in (a, b]; exclude b if it is a root.
+    if _eval(p, b) == 0:
+        count -= 1
+    return count
+
+
+def _refine(seq, p, a, b):
+    """Refine an interval known to contain exactly one root in (a, b)."""
+    va = _variations(seq, a)
+    while b - a > _ROOT_TOL:
+        mid = (a + b) / 2
+        if _eval(p, mid) == 0:
+            return mid
+        vm = _variations(seq, mid)
+        # There is no root at mid, so this is the count in (a, mid).
+        if va - vm > 0:
+            b = mid
+        else:
+            a, va = mid, vm
+    return (a + b) / 2
+
+
+def _roots_in_interval(p, lo, hi):
+    """All distinct roots of square-free p in [lo, hi], exactly."""
+    if hi < lo:
+        return []
+    if hi == lo:
+        return [lo] if _eval(p, lo) == 0 else []
+
+    seq = _sturm_sequence(p)
+    roots = []
+    if _eval(p, lo) == 0:
+        roots.append(lo)
+    if _eval(p, hi) == 0:
+        roots.append(hi)
+
+    # Isolate the roots strictly inside the interval.  Exact rational
+    # bisection separates even very close roots; no sampling grid is used.
+    stack = [(lo, hi, _count_open(seq, p, lo, hi))]
+    while stack:
+        a, b, count = stack.pop()
+        if count == 0:
+            continue
+        if count == 1:
+            roots.append(_refine(seq, p, a, b))
+            continue
+
+        mid = (a + b) / 2
+        if _eval(p, mid) == 0:
+            roots.append(mid)
+            left = _count_open(seq, p, a, mid)
+            right = _count_open(seq, p, mid, b)
+            stack.append((mid, b, right))
+            stack.append((a, mid, left))
+        else:
+            left = _count_open(seq, p, a, mid)
+            stack.append((mid, b, count - left))
+            stack.append((a, mid, left))
+
+    roots.sort()
+    return roots
+
