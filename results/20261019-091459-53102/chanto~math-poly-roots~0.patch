@@ -1,5 +1,6 @@
 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,30 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+        # (x - 1)^2 = x^2 - 2x + 1 has a repeated root but only one distinct root.
+        self.assertRoots(real_roots([1, -2, 1], -5, 5), [1])
+
+    def test_close_roots(self):
+        # (x - 1)(100000000x - 100000001): roots are 1 and 1.00000001.
+        self.assertRoots(
+            real_roots([100000000, -200000001, 100000001], 0, 2),
+            [1, 1.00000001],
+        )
+
+    def test_boundary_roots(self):
+        # x(x - 2) = x^2 - 2x.
+        self.assertRoots(real_roots([1, -2, 0], 0, 2), [0, 2])
+        self.assertRoots(real_roots([1, -2, 0], 0, 1), [0])
+        self.assertRoots(real_roots([1, -2, 0], 1, 2), [2])
+        # (x - 1/2)(x - 3/2) = 4x^2 - 8x + 3.
+        self.assertRoots(
+            real_roots([4, -8, 3], Fraction(1, 2), Fraction(3, 2)),
+            [0.5, 1.5],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
