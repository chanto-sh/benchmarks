+# Width of the final isolating interval.  The returned midpoint is therefore
+# within 5e-13 of the exact root, comfortably inside the required 1e-9.
+_TOL = Fraction(1, 10**12)
+
+
+def _trim(poly):
+    """Drop leading zero coefficients."""
+    i = 0
+    while i < len(poly) and poly[i] == 0:
+        i += 1
+    return list(poly[i:])
+
+
+def _derivative(poly):
+    n = len(poly) - 1
+    return [c * (n - i) for i, c in enumerate(poly[:-1])]
+
+
+def _primitive(poly):
+    """Clear denominators and content, using only positive scaling factors."""
+    poly = _trim([Fraction(c) for c in poly])
+    if not poly:
+        return []
+
+    denominator = 1
+    for c in poly:
+        denominator = lcm(denominator, c.denominator)
+
+    integers = [c.numerator * (denominator // c.denominator) for c in poly]
+    content = 0
+    for c in integers:
+        content = gcd(content, abs(c))
+    if content > 1:
+        integers = [c // content for c in integers]
+    return integers
+
+
+def _divmod_poly(dividend, divisor):
+    """Polynomial division over Q; coefficients are highest degree first."""
+    dividend = [Fraction(c) for c in dividend]
+    divisor = [Fraction(c) for c in divisor]
+    if not divisor:
+        raise ZeroDivisionError("polynomial division by zero")
+
+    quotient = [Fraction(0)] * (len(dividend) - len(divisor) + 1)
+    remainder = dividend[:]
+
+    while len(remainder) >= len(divisor):
+        coefficient = remainder[0] / divisor[0]
+        shift = len(remainder) - len(divisor)
+        quotient[len(quotient) - 1 - shift] = coefficient
+        for i in range(len(divisor)):
+            remainder[i] -= coefficient * divisor[i]
+        while remainder and remainder[0] == 0:
+            remainder.pop(0)
+
+    return _trim(quotient), _trim(remainder)
+
+
+def _gcd_poly(a, b):
+    """Primitive polynomial gcd over Q."""
+    a, b = _primitive(a), _primitive(b)
+    while b:
+        _, remainder = _divmod_poly(a, b)
+        a, b = b, _primitive(remainder)
+    return _primitive(a)
+
+
+def _square_free_part(poly):
+    """Remove repeated factors from a polynomial, keeping every distinct root."""
+    poly = _primitive(poly)
+    if len(poly) <= 1:
+        return poly
+
+    derivative = _primitive(_derivative(poly))
+    common = _gcd_poly(poly, derivative)
+    quotient, _ = _divmod_poly(poly, common)
+    return _primitive(quotient)
+
+
+def _sturm_sequence(poly):
+    """Sturm sequence for a square-free polynomial."""
+    poly = _primitive(poly)
+    sequence = [poly]
+    if len(poly) <= 1:
+        return sequence
+
+    sequence.append(_primitive(_derivative(poly)))
+    while True:
+        _, remainder = _divmod_poly(sequence[-2], sequence[-1])
+        if not remainder:
+            break
+        # Positive scaling does not change the signs used by Sturm's theorem.
+        sequence.append(_primitive([-c for c in remainder]))
+    return sequence
+
+
+def _sign_at(poly, x):
+    """Exact sign of an integer polynomial at a rational point."""
+    if not isinstance(x, Fraction):
+        x = Fraction(x)
+
+    numerator, denominator = x.numerator, x.denominator
+    value = 0
+    denominator_power = 1
+    for coefficient in poly:
+        value = value * numerator + coefficient * denominator_power
+        denominator_power *= denominator
+
+    return (value > 0) - (value < 0)
+
+
+def _variations(sequence, x):
+    """Number of sign changes in a Sturm sequence at x, ignoring zeros."""
+    changes = 0
+    previous = 0
+    for poly in sequence:
+        sign = _sign_at(poly, x)
+        if sign == 0:
+            continue
+        if previous and sign != previous:
+            changes += 1
+        previous = sign
+    return changes
+
+
+def _root_count(sequence, a, b):
+    """Number of distinct roots in (a, b]."""
+    return _variations(sequence, a) - _variations(sequence, b)
+
+
+def _refine_root(sequence, a, b):
+    """Refine an interval known to contain exactly one root in (a, b]."""
+    if _sign_at(sequence[0], b) == 0:
+        return b
+    while b - a > _TOL:
+        middle = (a + b) / 2
+        if _root_count(sequence, a, middle):
+            b = middle
+        else:
+            a = middle
+    if _sign_at(sequence[0], b) == 0:
+        return b
+    return (a + b) / 2
+
