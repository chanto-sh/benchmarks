 MOD = 1_000_000_007
 
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        result_row = result[i]
+        a_row = a[i]
+        for k in range(_SIZE):
+            a_ik = a_row[k]
+            if a_ik:
+                b_row = b[k]
+                for j in range(_SIZE):
+                    result_row[j] = (result_row[j] + a_ik * b_row[j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    result = [[int(i == j) for j in range(_SIZE)] for i in range(_SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # State indices 0..2: codes ending in A with 0, 1 or 2 C's modulo 3.
+    # State indices 3..5: codes ending in B or C with the same residues.
+    transition = [[0] * _SIZE for _ in range(_SIZE)]
+    for residue in range(3):
+        transition[residue][3 + residue] = 1  # Append A after a non-A.
+        previous = (residue - 1) % 3
+        for source in (residue, 3 + residue, previous, 3 + previous):
+            transition[3 + residue][source] = 1  # Append B or C.
+
+    # The empty code ends in no letter, treated as a non-A with no C's.
+    initial = [0, 0, 0, 1, 0, 0]
+    powered = _mat_pow(transition, n)
+    final = [
+        sum(powered[i][j] * initial[j] for j in range(_SIZE)) % MOD
+        for i in range(_SIZE)
+    ]
+    return (final[0] + final[3]) % MOD
