diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..a1c21c7
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,44 @@
+// Money is handled as integer cents so totals are exact and the receipt adds up.
+// Percentages arrive as JS numbers, so they are converted to exact decimal
+// fractions before multiplying (8.25 is 825/100, not the nearest binary double).
+
+// A price such as "19.99" as an integer number of cents.
+function toCents(price) {
+  const [num, den] = decimalFraction(price);
+  return Number(divRoundHalfUp(num * 100n, den));
+}
+
+// `pct` percent of `cents`, rounded to the cent (half up).
+function percentOf(cents, pct) {
+  const [num, den] = decimalFraction(pct);
+  return Number(divRoundHalfUp(BigInt(cents) * num, 100n * den));
+}
+
+// Exact num/den representation of a finite number's decimal form.
+function decimalFraction(value) {
+  const match = /^([+-]?)(\d+)(?:\.(\d+))?(?:e([+-]?\d+))?$/i.exec(String(value));
+  if (!match) throw new Error(`invalid decimal: ${value}`);
+  const whole = match[2];
+  const fraction = match[3] || "";
+  const exponent = Number(match[4] || 0) - fraction.length;
+  let num = BigInt(whole + fraction);
+  if (match[1] === "-") num = -num;
+  let den = 1n;
+  if (exponent >= 0) num *= 10n ** BigInt(exponent);
+  else den = 10n ** BigInt(-exponent);
+  return [num, den];
+}
+
+// Round num / den to the nearest integer, ties toward +infinity.
+function divRoundHalfUp(num, den) {
+  if (den < 0n) {
+    num = -num;
+    den = -den;
+  }
+  const q = num / den;
+  const r = num % den;
+  if (r >= 0n) return 2n * r >= den ? q + 1n : q;
+  return -2n * r > den ? q - 1n : q;
+}
+
+module.exports = { toCents, percentOf };
