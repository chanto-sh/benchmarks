 MOD = 1_000_000_007
+SIZE = 6
+
+
+def _mat_mul(a, b):
+    return [
+        [
+            sum(a[i][k] * b[k][j] for k in range(SIZE)) % MOD
+            for j in range(SIZE)
+        ]
+        for i in range(SIZE)
+    ]
+
+
+def _mat_pow(mat, exp):
+    result = [[int(i == j) for j in range(SIZE)] for i in range(SIZE)]
+    while exp:
+        if exp & 1:
+            result = _mat_mul(result, mat)
+        mat = _mat_mul(mat, mat)
+        exp >>= 1
+    return result
 
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # States 0..2: last letter is not A, C count is 0/1/2 mod 3.
+    # States 3..5: last letter is A, C count is 0/1/2 mod 3.
+    transitions = [[0] * SIZE for _ in range(SIZE)]
+    for c in range(3):
+        transitions[c][c] += 1        # append B
+        transitions[c][3 + c] += 1    # append A
+        transitions[c][(c + 1) % 3] += 1  # append C
+
+        transitions[3 + c][c] += 1    # append B
+        transitions[3 + c][(c + 1) % 3] += 1  # append C
+
+    vector = [1, 0, 0, 0, 0, 0]
+    powered = _mat_pow(transitions, n)
+    return sum(
+        vector[i] * powered[i][j]
+        for i in range(SIZE)
+        for j in (0, 3)  # C count is a multiple of 3
+    ) % MOD
