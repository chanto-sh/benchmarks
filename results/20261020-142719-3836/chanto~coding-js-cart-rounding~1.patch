-function fmt(amount) {
-  return amount.toFixed(2);
+// Money as a plain "1234.50" string for receipts and the API. `cents` is an integer.
+function fmt(cents) {
+  const sign = cents < 0 ? "-" : "";
+  const abs = Math.abs(cents);
+  return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..4af2731
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,30 @@
+// Money helpers. Amounts are integer cents; prices and percentages are parsed
+// as exact decimal fractions so rounding is not affected by binary floating point.
+
+function parseDecimal(value) {
+  const match = /^(\d+)(?:\.(\d+))?$/.exec(String(value).trim());
+  if (!match) throw new TypeError(`Invalid decimal: ${value}`);
+  const fraction = match[2] || "";
+  return {
+    numerator: BigInt(match[1] + fraction),
+    denominator: 10n ** BigInt(fraction.length),
+  };
+}
+
+// Round a non-negative fraction to the nearest integer, halves up.
+function divRoundHalfUp(numerator, denominator) {
+  return (2n * numerator + denominator) / (2n * denominator);
+}
+
+function priceToCents(price) {
+  const { numerator, denominator } = parseDecimal(price);
+  return Number(divRoundHalfUp(numerator * 100n, denominator));
+}
+
+// `pct` percent of `cents`, rounded to the cent (half up).
+function percentOfCents(cents, pct) {
+  const { numerator, denominator } = parseDecimal(pct);
+  return Number(divRoundHalfUp(BigInt(cents) * numerator, denominator * 100n));
+}
+
+module.exports = { priceToCents, percentOfCents };
