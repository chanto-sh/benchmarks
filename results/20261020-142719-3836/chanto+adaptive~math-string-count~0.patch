 MOD = 1_000_000_007
 
+# State: last letter is A? (0/1), number of C's modulo 3 (0/1/2).
+# Index = last_is_a * 3 + c_count.
+_STATES = 6
+
+
+def _mat_mul(a, b):
+    """Multiply two square matrices modulo MOD."""
+    size = len(a)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        row_a = a[i]
+        row_r = result[i]
+        for k in range(size):
+            if row_a[k]:
+                factor = row_a[k]
+                row_b = b[k]
+                for j in range(size):
+                    row_r[j] = (row_r[j] + factor * row_b[j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    """Raise a square matrix to a power modulo MOD."""
+    size = len(matrix)
+    result = [[int(i == j) for j in range(size)] for i in range(size)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        exponent >>= 1
+        if exponent:
+            matrix = _mat_mul(matrix, matrix)
+    return result
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # Transition matrix: a row-vector of state counts is multiplied by it.
+    transition = [[0] * _STATES for _ in range(_STATES)]
+    for last_a in (0, 1):
