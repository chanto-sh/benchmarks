+            state = last_a * 3 + c_count
+            # Append B (last letter is no longer A).
+            transition[state][c_count] += 1
+            # Append C.
+            transition[state][(c_count + 1) % 3] += 1
+            # Append A, allowed only when the previous letter was not A.
+            if not last_a:
+                transition[state][3 + c_count] += 1
+
+    powered = _mat_pow(transition, n)
+
+    # Start in the empty state: no previous A, zero C's.
+    counts = [0] * _STATES
+    counts[0] = 1
