-function fmt(amount) {
-  return amount.toFixed(2);
+// Integer cents as a plain "1234.50" string for receipts and the API.
+function fmt(cents) {
+  const sign = cents < 0n ? "-" : "";
+  const abs = cents < 0n ? -cents : cents;
+  return `${sign}${abs / 100n}.${String(abs % 100n).padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..8bee837
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,31 @@
+// Money is kept as integer cents so sums are exact. Percentages are parsed as
+// exact decimal fractions so rounding happens only where the README says.
+
+// Parse a non-negative decimal (e.g. "19.99" or 8.25) as { num, scale },
+// meaning num / 10^scale.
+function decimal(value) {
+  const match = /^(\d+)(?:\.(\d+))?$/.exec(String(value).trim());
+  if (!match) throw new TypeError(`invalid decimal: ${value}`);
+  const [, whole, frac = ""] = match;
+  return { num: BigInt(whole + frac), scale: frac.length };
+}
+
+// Round the non-negative fraction num / den to an integer, half up.
+function roundHalfUp(num, den) {
+  return (2n * num + den) / (2n * den);
+}
+
+// Parse a price into integer cents, rounding half up if it has sub-cent digits.
+function toCents(price) {
+  const { num, scale } = decimal(price);
+  if (scale <= 2) return num * 10n ** BigInt(2 - scale);
+  return roundHalfUp(num, 10n ** BigInt(scale - 2));
+}
+
+// `pct` percent of `cents`, rounded half up to the cent.
+function percentOf(cents, pct) {
+  const { num, scale } = decimal(pct);
+  return roundHalfUp(cents * num, 100n * 10n ** BigInt(scale));
+}
+
+module.exports = { toCents, roundHalfUp, percentOf };
