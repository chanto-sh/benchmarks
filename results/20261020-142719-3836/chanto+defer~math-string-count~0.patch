 MOD = 1_000_000_007
+_STATES = 6
+
+
+def _mat_mul(a, b):
+    """Multiply two square matrices modulo MOD."""
+    size = len(a)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        row = result[i]
+        for k in range(size):
+            if a[i][k]:
+                aik = a[i][k]
+                for j in range(size):
+                    row[j] = (row[j] + aik * b[k][j]) % MOD
+    return result
+
+
+def _mat_pow(mat, exponent):
+    """Raise a square matrix to a non-negative integer power."""
+    size = len(mat)
+    result = [[int(i == j) for j in range(size)] for i in range(size)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, mat)
+        mat = _mat_mul(mat, mat)
+        exponent >>= 1
+    return result
 
 
