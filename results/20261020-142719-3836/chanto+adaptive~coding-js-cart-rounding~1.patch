index 0000000..55ec96d
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,41 @@
+// Exact decimal helpers. Amounts are represented in integer cents (BigInt)
+// so percentage calculations and half-up rounding never pass through floats.
+
+// Parse a decimal string or number into an exact fraction { n, d }.
+function parseDecimal(value) {
+  const s = typeof value === "string" ? value.trim() : String(value);
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!m || (m[2] === "" && (m[3] === undefined || m[3] === ""))) {
+    throw new TypeError(`invalid decimal: ${value}`);
+  }
+  const negative = m[1] === "-";
+  const fraction = m[3] || "";
+  let n = BigInt((m[2] || "0") + fraction);
+  let digits = fraction.length - (m[4] ? Number(m[4]) : 0);
+  let d = 1n;
+  if (digits >= 0) {
+    d = 10n ** BigInt(digits);
+  } else {
+    n *= 10n ** BigInt(-digits);
+  }
+  return { n: negative ? -n : n, d };
+}
+
+// Round n / d to the nearest integer, with halves rounded up (away from zero).
+function roundHalfUp(n, d) {
+  if (d < 0n) {
+    n = -n;
+    d = -d;
+  }
+  const negative = n < 0n;
+  const abs = negative ? -n : n;
+  const rounded = (2n * abs + d) / (2n * d);
+  return negative ? -rounded : rounded;
+}
+
+// Dollars (as a fraction) to whole cents, rounded half up.
+function toCents(fraction) {
+  return roundHalfUp(fraction.n * 100n, fraction.d);
+}
+
+module.exports = { parseDecimal, roundHalfUp, toCents };
