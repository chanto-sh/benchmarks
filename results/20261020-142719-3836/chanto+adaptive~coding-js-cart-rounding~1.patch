+const { parseDecimal, roundHalfUp } = require("./money");
+
+// Sales tax in cents on `amountCents` cents. `rate` is a percentage, e.g. 8.25,
+// rounded half up to the cent once for the whole amount.
+function taxFor(amountCents, rate) {
+  if (!rate) return 0n;
+  const { n, d } = parseDecimal(rate);
