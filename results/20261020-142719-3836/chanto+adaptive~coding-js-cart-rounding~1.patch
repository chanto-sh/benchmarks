+const { parseDecimal, roundHalfUp } = require("./money");
+
+// Discount in cents for a line whose amount is `lineCents` cents.
+// `pct` is a percentage (e.g. 15 for 15%), rounded half up to the cent.
+function discountFor(lineCents, pct) {
