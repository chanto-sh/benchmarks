diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..a2ea142
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,43 @@
+// Money is handled as integer cents so rounding follows decimal rules
+// instead of binary floating point.
+
+// Express a decimal number/string as { units, scale } where value = units / scale.
+function decimalRatio(value) {
+  const s = String(value).trim();
+  const m = /^([+-]?)(\d*)(?:\.(\d*))?(?:e([+-]?\d+))?$/i.exec(s);
+  if (!m) return null;
+  const intPart = m[2] || "";
+  const frac = m[3] || "";
+  if (intPart === "" && frac === "") return null;
+
+  const exp = Number(m[4] || 0);
+  const decimalPlaces = frac.length - exp;
+  const digits = Number(intPart + frac);
+  const magnitude = decimalPlaces >= 0 ? { units: digits, scale: 10 ** decimalPlaces }
+    : { units: digits * 10 ** -decimalPlaces, scale: 1 };
+  if (m[1] === "-") magnitude.units = -magnitude.units;
+  return magnitude;
+}
+
+// Round numerator / denominator to an integer, halves away from zero.
+function roundHalfUp(numerator, denominator) {
+  const sign = numerator < 0 ? -1 : 1;
+  const n = Math.abs(numerator);
+  return sign * Math.floor((2 * n + denominator) / (2 * denominator));
+}
+
+// Decimal amount (e.g. "19.99") to integer cents.
+function toCents(value) {
+  const r = decimalRatio(value);
+  if (!r) return Math.round(Number(value) * 100);
+  return roundHalfUp(r.units * 100, r.scale);
+}
+
+// `pct` percent of an integer-cent amount, rounded to the cent (half up).
+function percentOfCents(cents, pct) {
+  const r = decimalRatio(pct);
+  if (!r) return Math.round((cents * Number(pct)) / 100);
+  return roundHalfUp(cents * r.units, 100 * r.scale);
+}
+
+module.exports = { toCents, percentOfCents };
