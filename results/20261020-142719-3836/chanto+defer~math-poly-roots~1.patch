@@ -20,6 +20,20 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (10^6 x - 10^6)(10^6 x - (10^6 + 1)) has roots 1 and 1 + 1e-6.
+        n = 10**6
+        coeffs = [n * n, -n * (2 * n + 1), n * (n + 1)]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1 / n])
+
+    def test_roots_on_interval_boundaries(self):
+        # (x - 1)(x - 2) = x^2 - 3x + 2
+        self.assertRoots(real_roots([1, -3, 2], 1, 2), [1, 2])
+
 
