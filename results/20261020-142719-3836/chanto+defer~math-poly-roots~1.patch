+def _trim(p):
+    """Drop zero coefficients above the leading term; zero is []."""
+    p = list(p)
+    while p and p[-1] == 0:
+        p.pop()
+    return p
+
+
+def _from_high_first(coeffs):
+    return _trim(reversed(list(coeffs)))
+
+
+def _derivative(p):
+    return _trim([p[i] * i for i in range(1, len(p))])
+
+
+def _poly_eval(p, x):
+    """Horner evaluation for a lowest-degree-first polynomial."""
+    y = 0
+    for c in reversed(p):
+        y = y * x + c
+    return y
+
+
+def _divmod(a, b):
+    """Exact polynomial division for lowest-degree-first polynomials."""
+    a = _trim(a)
+    b = _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    quotient = [Fraction(0)] * (len(a) - len(b) + 1)
+    while a and len(a) >= len(b):
+        shift = len(a) - len(b)
+        factor = Fraction(a[-1]) / Fraction(b[-1])
+        quotient[shift] = factor
+        for i, coeff in enumerate(b):
+            a[shift + i] -= factor * coeff
+        a = _trim(a)
+    return _trim(quotient), a
+
+
+def _gcd(a, b):
+    a, b = _trim(a), _trim(b)
+    while b:
+        _, remainder = _divmod(a, b)
+        a, b = b, remainder
+    if not a:
+        return []
+    leading = Fraction(a[-1])
+    return [Fraction(coeff) / leading for coeff in a]
+
+
+def _squarefree_part(p):
+    """The product of the distinct irreducible factors of p."""
+    if len(p) <= 1:
+        return p
+    common = _gcd(p, _derivative(p))
+    quotient, _ = _divmod(p, common)
+    return _trim(quotient)
+
+
+def _positive_normalize(p):
+    """Scale a rational polynomial by a positive constant to an integer one."""
+    p = _trim(p)
+    if not p:
+        return []
+    multiplier = 1
+    for coeff in p:
+        multiplier = multiplier * Fraction(coeff).denominator // gcd(
+            multiplier, Fraction(coeff).denominator
+        )
+    ints = [int(Fraction(coeff) * multiplier) for coeff in p]
+    common = 0
+    for coeff in ints:
+        common = gcd(common, abs(coeff))
+    if common > 1:
+        ints = [coeff // common for coeff in ints]
+    return _trim(ints)
+
+
+def _sturm_sequence(p):
+    """Sturm sequence for a squarefree polynomial."""
+    p = _positive_normalize(p)
+    if len(p) <= 1:
+        return [p]
+
+    sequence = [p, _positive_normalize(_derivative(p))]
+    while True:
+        _, remainder = _divmod(sequence[-2], sequence[-1])
+        if not remainder:
+            break
+        sequence.append(_positive_normalize([-coeff for coeff in remainder]))
+    return sequence
+
+
+def _sign_variations(sequence, x):
+    variations = 0
+    previous = 0
+    for p in sequence:
+        value = _poly_eval(p, x)
+        if value == 0:
+            continue
+        sign = 1 if value > 0 else -1
+        if previous and sign != previous:
+            variations += 1
+        previous = sign
+    return variations
+
+
+def _refine_root(sequence, a, b, variations_at_a):
+    """Refine the single root in (a, b] to the requested tolerance."""
+    while b - a > _TOLERANCE:
+        midpoint = (a + b) / 2
+        variations_at_midpoint = _sign_variations(sequence, midpoint)
+        if variations_at_a - variations_at_midpoint:
+            # The root is in (a, midpoint].
+            b = midpoint
+        else:
+            # The root is in (midpoint, b].
+            a = midpoint
+            variations_at_a = variations_at_midpoint
+    return (a + b) / 2
+
