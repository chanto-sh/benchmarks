@@ -1,6 +1,59 @@
 MOD = 1_000_000_007
 
+# States are (last letter is A, number of C's modulo 3), indexed as
+# 3 * last_is_a + c_count.
+_STATES = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _STATES for _ in range(_STATES)]
+    for i in range(_STATES):
+        row = result[i]
+        for k in range(_STATES):
+            aik = a[i][k]
+            if aik:
+                brow = b[k]
+                for j in range(_STATES):
+                    row[j] = (row[j] + aik * brow[j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    result = [[int(i == j) for j in range(_STATES)] for i in range(_STATES)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
+
+def _transition_matrix():
+    # transition[to][from] counts ways to go from `from` to `to`.
+    transition = [[0] * _STATES for _ in range(_STATES)]
+
+    def add(to_a, to_c, from_a, from_c):
+        transition[3 * to_a + to_c][3 * from_a + from_c] += 1
+
+    for from_a in (0, 1):
+        for from_c in range(3):
+            # Append B: last letter is no longer A, C count unchanged.
+            add(0, from_c, from_a, from_c)
+            # Append C: last letter is no longer A, C count increases.
+            add(0, (from_c + 1) % 3, from_a, from_c)
+            # Append A: only allowed when the last letter was not A.
+            if from_a == 0:
+                add(1, from_c, 0, from_c)
+
+    return transition
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    powered = _mat_pow(_transition_matrix(), n)
+    # The empty prefix starts in state (not A, zero C's).
+    # Valid codes end in either state whose C count is 0 modulo 3.
+    return (powered[0][0] + powered[3][0]) % MOD
