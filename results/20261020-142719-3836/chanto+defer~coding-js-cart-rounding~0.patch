+const { decimalToFraction, roundHalfUp } = require("./money");
+
+// Sales tax on the taxable part of a cart. `amountCents` is in cents and
+// `rate` is a percentage, e.g. 8.25; rounded to the cent (half up) once.
+function taxFor(amountCents, rate) {
+  if (!rate) return 0n;
+  const { num, den } = decimalToFraction(rate);
+  return roundHalfUp(amountCents * num, den * 100n);
 }
 
