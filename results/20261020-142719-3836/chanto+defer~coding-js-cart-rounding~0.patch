diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..3e9f07d
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,36 @@
+// Exact money arithmetic. Amounts are integer cents (BigInt); percentages are
+// parsed as exact decimal fractions so no rounding happens in binary floats.
+
+// Parse a decimal number/string into an exact { num, den } fraction.
+function decimalToFraction(value) {
+  const s = typeof value === "string" ? value.trim() : String(value);
+  const match = /^([+-]?)(\d+)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!match) throw new TypeError(`Invalid decimal value: ${value}`);
+  const [, sign, intPart, fracPart = "", expPart = "0"] = match;
+  let num = BigInt(intPart + fracPart);
+  if (sign === "-") num = -num;
+  const exp = Number(expPart) - fracPart.length;
+  return exp >= 0
+    ? { num: num * 10n ** BigInt(exp), den: 1n }
+    : { num, den: 10n ** BigInt(-exp) };
+}
+
+// Round num / den to the nearest integer, halves away from zero.
+function roundHalfUp(num, den) {
+  if (den === 0n) throw new RangeError("Cannot divide by zero");
+  if (den < 0n) {
+    num = -num;
+    den = -den;
+  }
+  const sign = num < 0n ? -1n : 1n;
+  const abs = num < 0n ? -num : num;
+  return sign * ((2n * abs + den) / (2n * den));
+}
+
+// Parse a price like "19.99" into an exact number of cents.
+function toCents(amount) {
+  const { num, den } = decimalToFraction(amount);
+  return roundHalfUp(num * 100n, den);
+}
+
+module.exports = { decimalToFraction, roundHalfUp, toCents };
