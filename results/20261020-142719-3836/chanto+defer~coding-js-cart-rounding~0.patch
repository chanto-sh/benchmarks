+// `cents` is an integer number of cents.
+function fmt(cents) {
+  const n = BigInt(cents);
+  const sign = n < 0n ? "-" : "";
+  const abs = n < 0n ? -n : n;
+  return `${sign}${abs / 100n}.${String(abs % 100n).padStart(2, "0")}`;
