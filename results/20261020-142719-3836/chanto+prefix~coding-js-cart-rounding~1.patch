-  return amount.toFixed(2);
+// Money (integer cents) as a plain "1234.50" string for receipts and the API.
+function fmt(cents) {
+  const n = BigInt(cents);
+  const abs = n < 0n ? -n : n;
+  const sign = n < 0n ? "-" : "";
+  return `${sign}${abs / 100n}.${String(abs % 100n).padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..da1d5af
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,30 @@
+// Money is handled as integer cents so the README's half-up rounding is exact.
+// BigInt keeps products (amount x percentage) exact for any cart.
+
+// Parse a decimal amount (e.g. "19.99") into whole cents, rounding half up.
+function toCents(amount) {
+  const match = /^(\d+)(?:\.(\d+))?$/.exec(String(amount).trim());
+  if (!match) throw new RangeError(`invalid money amount: ${amount}`);
+  const [, whole, frac = ""] = match;
+  const cents = BigInt(whole) * 100n + BigInt((frac + "00").slice(0, 2));
+  return frac.length > 2 && frac[2] >= "5" ? cents + 1n : cents;
+}
+
+// A percentage (e.g. 8.25) as an exact fraction: numerator / denominator.
+function pctFraction(pct) {
+  const match = /^(\d+)(?:\.(\d+))?$/.exec(String(pct).trim());
+  if (!match) throw new RangeError(`invalid percentage: ${pct}`);
+  const [, whole, frac = ""] = match;
+  return [BigInt(whole + frac), 10n ** BigInt(frac.length)];
+}
+
+// `pct` percent of `cents`, rounded half up to the cent.
+function pctOfCents(cents, pct) {
+  const [num, den] = pctFraction(pct);
+  const numerator = BigInt(cents) * num;
+  const denominator = den * 100n;
+  // round half up: floor((2n + d) / 2d)
+  return (2n * numerator + denominator) / (2n * denominator);
+}
+
+module.exports = { toCents, pctOfCents };
