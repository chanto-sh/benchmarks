@@ -1,6 +1,64 @@
 MOD = 1_000_000_007
 
+# State vector: [x0, x1, x2, y0, y1, y2]
+# x_m = codes ending in A with m C's modulo 3
+# y_m = codes ending in B or C with m C's modulo 3
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        row = result[i]
+        for k in range(_SIZE):
+            if a[i][k]:
+                aik = a[i][k]
+                brow = b[k]
+                for j in range(_SIZE):
+                    row[j] = (row[j] + aik * brow[j]) % MOD
+    return result
+
+
+def _mat_pow(mat, exponent):
+    result = [[int(i == j) for j in range(_SIZE)] for i in range(_SIZE)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, mat)
+        mat = _mat_mul(mat, mat)
+        exponent >>= 1
+    return result
+
+
+def _transition_matrix():
+    mat = [[0] * _SIZE for _ in range(_SIZE)]
+
+    for m in range(3):
+        # Appending B to a code ending in A does not change the C-count.
+        # (The other x_m -> y_m transition, appending C, is below.)
+        mat[m][3 + m] = 1
+
+        prev = (m - 1) % 3
+        # Appending B to a non-A code.
+        mat[3 + m][m] = 1
+        mat[3 + m][3 + m] = 1
+        # Appending C to either kind of code.
+        mat[3 + m][prev] = 1
+        mat[3 + m][3 + prev] = 1
+
+    return mat
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n < 0:
+        raise ValueError("code length cannot be negative")
+    if n == 0:
+        return 1
+
+    mat = _mat_pow(_transition_matrix(), n - 1)
+    # Length-1 codes: "A" (x0), "B" (y0), and "C" (y1).
+    initial = [1, 0, 0, 1, 1, 0]
+
+    final = [sum(mat[i][j] * initial[j] for j in range(_SIZE)) % MOD
+             for i in range(_SIZE)]
+    return (final[0] + final[3]) % MOD
