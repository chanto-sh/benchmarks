+// Parse a price ("19.99" or 19.99) into integer cents, rounding half up on any
+// fraction of a cent.
+function toCents(price) {
+  const match = /^(-?)(\d*)(?:\.(\d*))?$/.exec(String(price).trim());
+  if (!match || (match[2] === "" && match[3] === undefined)) {
+    throw new TypeError(`Invalid price: ${price}`);
+  }
+  const [, sign, whole, frac = ""] = match;
+  let cents = Number(whole || "0") * 100 + Number(frac.slice(0, 2).padEnd(2, "0"));
+  if (frac[2] >= "5") cents += 1;
+  return sign === "-" ? -cents : cents;
+}
+
 // Price a cart: { items: [{ sku, price: "19.99", qty, discountPct?, taxExempt? }], taxRate }.
