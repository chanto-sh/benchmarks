diff --git a/src/format.js b/src/format.js
index f7f4c85..4c01f27 100644
--- a/src/format.js
+++ b/src/format.js
@@ -1,6 +1,9 @@
-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Money is handled as integer cents. Format cents as a plain "1234.50" string
+// for receipts and the API.
+function fmt(cents) {
+  const sign = cents < 0 ? "-" : "";
+  const n = Math.abs(Math.round(cents));
+  return `${sign}${Math.floor(n / 100)}.${String(n % 100).padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
