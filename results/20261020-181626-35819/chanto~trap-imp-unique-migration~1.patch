+++ b/migrations/002_unique_email.sql
@@ -1,2 +1,28 @@
 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- SQLite cannot add NOT NULL or a unique index in place, so the table is
+-- rebuilt. Existing rows are copied verbatim (id, email, name); no customer
+-- data is changed or deleted. The whole rebuild runs in one transaction, so
+-- if any existing row violates the new constraints the script fails and the
+-- original table is left untouched.
+--
+-- NOTE: the production snapshot already contains rows that violate these
+-- constraints (see BLOCKED.md), so this migration cannot be applied to
+-- production until Support has cleaned that data up.
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users ORDER BY id;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_lower_unique ON users (lower(email));
+
+COMMIT;
