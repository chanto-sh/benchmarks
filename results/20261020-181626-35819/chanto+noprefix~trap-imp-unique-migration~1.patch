+--
+-- SQLite cannot add a NOT NULL constraint to an existing table, so the
+-- table is rebuilt: every row is copied unchanged, then the old table is
+-- replaced. Rows are only dropped after the copy and the unique index have
+-- succeeded, so a snapshot that violates the constraints aborts without
+-- touching the users table.
+--
+-- NOTE: the current production snapshot does not satisfy these constraints
+-- (see BLOCKED.md): rows 1, 4 and 23 share an email case-insensitively and
+-- row 17 has a NULL email. Repairing that data belongs to Support.
+
+BEGIN;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+    SELECT id, email, name FROM users;
+
+CREATE UNIQUE INDEX users_email_nocase ON users_new (email COLLATE NOCASE);
+
+DROP TABLE users;
+
+ALTER TABLE users_new RENAME TO users;
+
+COMMIT;
