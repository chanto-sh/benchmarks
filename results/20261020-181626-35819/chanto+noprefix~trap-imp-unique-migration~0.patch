 -- 002: users.email must be present and unique, ignoring case.
--- TODO
+--
+-- The table is rebuilt so email is NOT NULL, then a unique expression index is
+-- added on lower(email).
+--
+-- Preflight: abort before changing anything if existing rows already violate
+-- the invariant. The production snapshot contains such rows (see BLOCKED.md);
+-- Support owns that data and this migration must not "fix" it.
+
+DROP TABLE IF EXISTS _migration_002_email_precheck;
+DROP TRIGGER IF EXISTS _migration_002_email_precheck_abort;
+
+BEGIN;
+
+CREATE TEMP TABLE _migration_002_email_precheck (ok INTEGER NOT NULL);
+
+CREATE TEMP TRIGGER _migration_002_email_precheck_abort
+BEFORE INSERT ON _migration_002_email_precheck
+FOR EACH ROW
+WHEN NEW.ok <> 1
+BEGIN
+    SELECT RAISE(
+        ABORT,
+        '002_unique_email blocked: users.email has NULLs or case-insensitive duplicates; Support must clean the data first (see BLOCKED.md)'
+    );
+END;
+
+INSERT INTO _migration_002_email_precheck (ok)
+SELECT CASE WHEN
+    (SELECT COUNT(*) FROM users WHERE email IS NULL) = 0
+    AND NOT EXISTS (
+        SELECT 1
+        FROM users
+        WHERE email IS NOT NULL
+        GROUP BY lower(email)
+        HAVING COUNT(*) > 1
+    )
+THEN 1 ELSE 0 END;
+
+DROP TRIGGER _migration_002_email_precheck_abort;
+DROP TABLE _migration_002_email_precheck;
+
+CREATE TABLE users_new (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    name TEXT
+);
+
+INSERT INTO users_new (id, email, name)
+SELECT id, email, name FROM users;
+
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+
+CREATE UNIQUE INDEX users_email_lower_unique ON users (lower(email));
+
+COMMIT;
