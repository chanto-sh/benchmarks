 def displacement(m, k, c, F0, omega, x0, v0, t):
     """x(t) with x(0) = x0, x'(0) = v0."""
-    raise NotImplementedError
+    A, B, vp0 = _steady_state(m, k, c, F0, omega)
+
+    # Solve for the homogeneous part with zero initial conditions after
+    # subtracting the particular solution.
+    xh0 = x0 - A
+    vh0 = v0 - vp0
+
+    alpha = c / (2.0 * m)
+    w0sq = k / m
+    delta = alpha * alpha - w0sq
+    C = xh0
