 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _fma(a, b, c):
+    fma = getattr(math, "fma", None)
+    return fma(a, b, c) if fma is not None else a * b + c
+
+
+def _detuning(m, k, omega):
+    """k - m*omega**2, retaining accuracy near resonance."""
+    w2 = omega * omega
+    w2_error = _fma(omega, omega, -w2)
+    return _fma(-m, w2, k) - m * w2_error
+
+
+def _sinc(z):
+    """sin(z) / z, continuous at z = 0."""
+    if z == 0.0:
+        return 1.0
+    z2 = z * z
+    if abs(z) < 1e-4:
+        return 1.0 - z2 / 6.0 + z2 * z2 / 120.0
+    return math.sin(z) / z
+
+
+def _sinhc(z):
+    """sinh(z) / z, continuous at z = 0."""
+    if z == 0.0:
+        return 1.0
+    z2 = z * z
+    if abs(z) < 1e-4:
+        return 1.0 + z2 / 6.0 + z2 * z2 / 120.0 + z2 * z2 * z2 / 5040.0
+    return math.sinh(z) / z
+
+
+def _steady_state(m, k, c, F0, omega):
+    """Return (A, B, xp'(0)) for xp = A cos(omega t) + B sin(omega t)."""
+    d = _detuning(m, k, omega)
+    e = c * omega
+    den = math.hypot(d, e)
+    if den == 0.0:
+        if F0 == 0.0:
+            return 0.0, 0.0, 0.0
+        raise ValueError("no finite steady state at exact resonance without damping")
+    scale = F0 / den
+    A = scale * (d / den)
+    B = scale * (e / den)
+    return A, B, B * omega
+
 
 def amplitude(m, k, c, F0, omega):
     """Steady-state amplitude."""
-    raise NotImplementedError
