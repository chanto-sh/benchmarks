+# Dormand-Prince 5(4) coefficients.
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0, -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0, 49.0 / 176.0,
+     -5103.0 / 18656.0),
+)
+_B5 = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+       -2187.0 / 6784.0, 11.0 / 84.0, 0.0)
+_B4 = (5179.0 / 57600.0, 0.0, 7571.0 / 16695.0, 393.0 / 640.0,
+       -92097.0 / 339200.0, 187.0 / 2100.0, 1.0 / 40.0)
+
+
+def _step(rhs, y, h):
+    """One Dormand-Prince 5(4) step; returns the 5th and 4th order results."""
+    n = len(y)
+    k = [rhs(y)]
+    for s in range(1, 6):
+        row = _A[s]
+        ys = [y[j] + h * sum(row[m] * k[m][j] for m in range(s))
+              for j in range(n)]
+        k.append(rhs(ys))
+    y5 = [y[j] + h * sum(_B5[m] * k[m][j] for m in range(6))
+          for j in range(n)]
+    k.append(rhs(y5))
+    y4 = [y[j] + h * sum(_B4[m] * k[m][j] for m in range(7))
+          for j in range(n)]
+    return y5, y4, k
+
+
+def _quintic(p0, m0, q0, p1, m1, q1, s):
+    """Quintic Hermite value and derivative (w.r.t. s) on [0, 1]."""
+    s2 = s * s
+    s3 = s2 * s
+    s4 = s3 * s
+    s5 = s4 * s
+    value = (p0 * (1.0 - 10.0 * s3 + 15.0 * s4 - 6.0 * s5)
+             + m0 * (s - 6.0 * s3 + 8.0 * s4 - 3.0 * s5)
+             + q0 * (0.5 * s2 - 1.5 * s3 + 1.5 * s4 - 0.5 * s5)
+             + p1 * (10.0 * s3 - 15.0 * s4 + 6.0 * s5)
+             + m1 * (-4.0 * s3 + 7.0 * s4 - 3.0 * s5)
+             + q1 * (0.5 * s3 - s4 + 0.5 * s5))
+    deriv = (p0 * (-30.0 * s2 + 60.0 * s3 - 30.0 * s4)
+             + m0 * (1.0 - 18.0 * s2 + 32.0 * s3 - 15.0 * s4)
+             + q0 * (s - 4.5 * s2 + 6.0 * s3 - 2.5 * s4)
+             + p1 * (30.0 * s2 - 60.0 * s3 + 30.0 * s4)
+             + m1 * (-12.0 * s2 + 28.0 * s3 - 15.0 * s4)
+             + q1 * (1.5 * s2 - 4.0 * s3 + 2.5 * s4))
+    return value, deriv
+
+
+def _event_fraction(y0, y1, k, h):
+    """Fraction of a step at which the radial velocity changes sign."""
+    # Endpoint data: positions, velocities and accelerations.
+    x0, y0_, vx0, vy0 = y0
+    x1, y1_, vx1, vy1 = y1
+    ax0, ay0 = k[0][2], k[0][3]
+    ax1, ay1 = k[6][2], k[6][3]
+
+    def radial_velocity(s):
+        x, dx = _quintic(x0, h * vx0, h * h * ax0,
+                         x1, h * vx1, h * h * ax1, s)
+        y, dy = _quintic(y0_, h * vy0, h * h * ay0,
+                         y1_, h * vy1, h * h * ay1, s)
+        xd, yd = dx / h, dy / h
+        r = math.hypot(x, y)
+        return (x * xd + y * yd) / r
+
+    lo, hi = 0.0, 1.0
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        if radial_velocity(mid) < 0.0:
+            lo = mid
+        else:
+            hi = mid
+    return 0.5 * (lo + hi)
+
