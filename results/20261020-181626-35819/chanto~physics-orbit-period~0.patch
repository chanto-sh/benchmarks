+    if r == 0.0:
+        raise ValueError("initial position is at the origin")
+
+    def rhs(state):
+        ax, ay = accel(state[0], state[1])
+        return (state[2], state[3], ax, ay)
+
+    def radial_velocity(state):
+        rr = math.hypot(state[0], state[1])
+        if rr == 0.0:
+            raise ValueError("particle reaches the origin")
+        return (state[0] * state[2] + state[1] * state[3]) / rr
+
+    # Initial step from the shortest local dynamical timescale.
+    ax0, ay0 = accel(x, yy)
+    speed = math.hypot(vx, vy)
+    acc = math.hypot(ax0, ay0)
+    scales = []
+    if speed > 0.0:
+        scales.append(r / speed)
+    if acc > 0.0:
+        scales.append(math.sqrt(r / acc))
+    h = 0.01 * min(scales) if scales else 0.01 * r
+
+    # A circular orbit has no closest approach; its radial period equals the
+    # orbital period, so return that rather than waiting for a turning point.
+    angular_momentum = x * vy - yy * vx
+    if angular_momentum != 0.0:
+        radial_acc = (x * ax0 + yy * ay0) / r
+        centripetal = angular_momentum ** 2 / r ** 3
+        radial_vel0 = (x * vx + yy * vy) / r
+        scale = abs(radial_acc) + centripetal
+        if (abs(radial_vel0) <= 1e-12 * speed
+                and abs(radial_acc + centripetal) <= 1e-12 * scale):
+            return 2.0 * math.pi * r * r / abs(angular_momentum)
+
+    rtol = 1e-12
