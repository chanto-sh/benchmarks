 """Driven damped harmonic oscillator: m x'' + c x' + k x = F0 cos(omega t)."""
 
+import math
+
+
+def _sinc(x):
+    """sin(x) / x, with the removable singularity at x = 0."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        return 1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0))
+    return math.sin(x) / x
+
+
+def _sinhc(x):
+    """sinh(x) / x, with the removable singularity at x = 0."""
+    if abs(x) < 1e-4:
+        x2 = x * x
+        return 1.0 + x2 / 6.0 * (1.0 + x2 / 20.0 * (1.0 + x2 / 42.0))
+    return math.sinh(x) / x
+
+
+def _steady_state(m, k, c, F0, omega):
+    """Return (signed amplitude, cos(phase), sin(phase))."""
+    a = k - m * omega * omega
+    b = c * omega
+    scale = math.hypot(a, b)
+    if scale == 0.0:
+        raise ValueError("no finite steady state at undamped resonance")
+    return F0 / scale, a / scale, b / scale
+
 
