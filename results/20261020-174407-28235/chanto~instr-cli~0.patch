diff --git a/test_cli.py b/test_cli.py
index d4749b9..8e58f16 100644
--- a/test_cli.py
+++ b/test_cli.py
@@ -15,6 +15,28 @@ class CliTest(unittest.TestCase):
         r = run("nope")
         self.assertEqual((r.returncode, r.stderr.strip()), (2, "error: unknown command"))
 
+    def test_limit(self):
+        r = run("list", "--limit", "2")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stdout.splitlines(), ["1. write report", "2. buy milk"])
+
+    def test_limit_beyond_end(self):
+        r = run("list", "--limit", "99")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(len(r.stdout.splitlines()), 5)
+
+    def test_limit_below_one(self):
+        r = run("list", "--limit", "0")
+        self.assertEqual((r.returncode, r.stdout, r.stderr.strip()), (2, "", "error: limit must be at least 1"))
+
+    def test_limit_not_a_number(self):
+        r = run("list", "--limit", "two")
+        self.assertEqual((r.returncode, r.stdout, r.stderr.strip()), (2, "", "error: invalid limit"))
+
+    def test_limit_missing_value(self):
+        r = run("list", "--limit")
+        self.assertEqual((r.returncode, r.stdout, r.stderr.strip()), (2, "", "error: --limit requires a value"))
+
 
 if __name__ == "__main__":
     unittest.main()
