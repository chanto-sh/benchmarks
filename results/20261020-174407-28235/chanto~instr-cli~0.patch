-def main(argv=None):
+def parse_limit(args) -> Tuple[Optional[int], Optional[str]]:
+    """Parse the optional --limit option.
+
+    Returns (limit, error): limit is None when the option is absent, error is a
+    "error: ..." message when the input is invalid.
+    """
+    if not args:
+        return None, None
+    if args[0] != "--limit" or len(args) > 2:
+        return None, "error: unknown argument"
+    if len(args) < 2:
+        return None, "error: --limit requires a value"
+    try:
+        limit = int(args[1])
+    except ValueError:
+        return None, "error: invalid limit"
+    if limit < 1:
+        return None, "error: limit must be at least 1"
+    return limit, None
+
+
+def main(argv=None) -> int:
     args = list(sys.argv[1:] if argv is None else argv)
