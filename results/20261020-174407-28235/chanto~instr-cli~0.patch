         return 2
-    for i, item in enumerate(ITEMS, 1):
+    limit, error = parse_limit(args[1:])
+    if error is not None:
+        print(error, file=sys.stderr)
+        return 2
+    items = ITEMS if limit is None else ITEMS[:limit]
+    for i, item in enumerate(items, 1):
         print(f"{i}. {item}")
