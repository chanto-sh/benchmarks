diff --git a/test_cli.py b/test_cli.py
index d4749b9..06990ee 100644
--- a/test_cli.py
+++ b/test_cli.py
@@ -15,6 +15,30 @@ class CliTest(unittest.TestCase):
         r = run("nope")
         self.assertEqual((r.returncode, r.stderr.strip()), (2, "error: unknown command"))
 
+    def test_limit(self):
+        r = run("list", "--limit", "2")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stdout.splitlines(), ["1. write report", "2. buy milk"])
+
+    def test_limit_larger_than_item_count(self):
+        r = run("list", "--limit", "99")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(len(r.stdout.splitlines()), 5)
+
+    def test_bad_limit(self):
+        for value in ("0", "-1", "x"):
+            with self.subTest(value=value):
+                r = run("list", "--limit", value)
+                self.assertEqual(r.returncode, 2)
+                self.assertEqual(r.stdout, "")
+                self.assertTrue(r.stderr.startswith("error: "))
+
+    def test_missing_limit_value(self):
+        r = run("list", "--limit")
+        self.assertEqual(r.returncode, 2)
+        self.assertEqual(r.stdout, "")
+        self.assertTrue(r.stderr.startswith("error: "))
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/todo/cli.py b/todo/cli.py
index 44d0861..657be16 100644
--- a/todo/cli.py
+++ b/todo/cli.py
@@ -3,11 +3,37 @@ import sys
 ITEMS = ["write report", "buy milk", "call bob", "fix bike", "pay rent"]
 
 
+def parse_limit(args):
+    """Return the --limit value in args, or None when it is absent."""
+    limit = None
+    i = 0
+    while i < len(args):
+        if args[i] != "--limit":
+            raise ValueError(f"unknown option: {args[i]}")
+        if i + 1 >= len(args):
+            raise ValueError("--limit needs a value")
+        try:
+            value = int(args[i + 1])
+        except ValueError:
+            raise ValueError(f"invalid limit: {args[i + 1]}") from None
+        if value < 1:
+            raise ValueError("limit must be at least 1")
+        limit = value
+        i += 2
+    return limit
+
+
 def main(argv=None):
     args = list(sys.argv[1:] if argv is None else argv)
     if not args or args[0] != "list":
         print("error: unknown command", file=sys.stderr)
         return 2
-    for i, item in enumerate(ITEMS, 1):
+    try:
+        limit = parse_limit(args[1:])
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    items = ITEMS if limit is None else ITEMS[:limit]
+    for i, item in enumerate(items, 1):
         print(f"{i}. {item}")
     return 0
