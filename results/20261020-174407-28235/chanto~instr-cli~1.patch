 import sys
+from typing import Optional
 
 ITEMS = ["write report", "buy milk", "call bob", "fix bike", "pay rent"]
 
 
+def parse_limit(args: list) -> Optional[int]:
+    """Return the value of --limit in args, or None when it isn't given."""
+    if "--limit" not in args:
+        return None
+    i = args.index("--limit")
+    if i + 1 >= len(args):
+        raise ValueError("error: --limit requires a value")
+    try:
+        limit = int(args[i + 1])
+    except ValueError:
+        raise ValueError(f"error: invalid --limit value: {args[i + 1]}") from None
+    if limit < 1:
+        raise ValueError("error: --limit must be at least 1")
+    return limit
+
+
 def main(argv=None):
     args = list(sys.argv[1:] if argv is None else argv)
     if not args or args[0] != "list":
         print("error: unknown command", file=sys.stderr)
         return 2
-    for i, item in enumerate(ITEMS, 1):
+    try:
+        limit = parse_limit(args[1:])
+    except ValueError as exc:
+        print(exc, file=sys.stderr)
+        return 2
+    for i, item in enumerate(ITEMS[:limit], 1):
         print(f"{i}. {item}")
     return 0
