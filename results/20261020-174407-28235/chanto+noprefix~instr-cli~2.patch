 import sys
+from typing import List, Optional
 
 ITEMS = ["write report", "buy milk", "call bob", "fix bike", "pay rent"]
 
 
-def main(argv=None):
+def parse_limit(args: List[str]) -> Optional[int]:
+    """Return the --limit value from the arguments after ``list``.
+
+    Returns None when no limit was given. Raises ValueError with a message
+    suitable for the user when the option is malformed.
+    """
+    limit = None
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg != "--limit":
+            raise ValueError(f"unknown option: {arg}")
+        if i + 1 >= len(args):
+            raise ValueError("--limit requires a value")
+        try:
+            value = int(args[i + 1])
+        except ValueError:
+            raise ValueError(f"invalid limit: {args[i + 1]}") from None
+        if value < 1:
+            raise ValueError("--limit must be at least 1")
+        limit = value
+        i += 2
+    return limit
+
+
+def main(argv: Optional[List[str]] = None) -> int:
     args = list(sys.argv[1:] if argv is None else argv)
     if not args or args[0] != "list":
         print("error: unknown command", file=sys.stderr)
         return 2
-    for i, item in enumerate(ITEMS, 1):
+    try:
+        limit = parse_limit(args[1:])
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    items = ITEMS if limit is None else ITEMS[:limit]
+    for i, item in enumerate(items, 1):
         print(f"{i}. {item}")
     return 0
