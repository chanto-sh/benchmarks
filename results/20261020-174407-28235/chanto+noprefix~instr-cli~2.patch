+    def test_list_limit(self):
+        r = run("list", "--limit", "2")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stdout.splitlines(), ["1. write report", "2. buy milk"])
+
+    def test_list_limit_beyond_size(self):
+        r = run("list", "--limit", "99")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(len(r.stdout.splitlines()), 5)
+
+    def test_list_limit_invalid(self):
+        for value in ("0", "-1", "many"):
+            r = run("list", "--limit", value)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            self.assertTrue(r.stderr.startswith("error: "))
+            self.assertEqual(len(r.stderr.splitlines()), 1)
+
+    def test_list_limit_missing_value(self):
+        r = run("list", "--limit")
+        self.assertEqual(r.returncode, 2)
+        self.assertEqual(r.stdout, "")
+        self.assertTrue(r.stderr.startswith("error: "))
+
     def test_unknown(self):
         r = run("nope")
         self.assertEqual((r.returncode, r.stderr.strip()), (2, "error: unknown command"))
