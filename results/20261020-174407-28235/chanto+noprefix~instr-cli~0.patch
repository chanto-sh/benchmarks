+def parse_limit(args: List[str]) -> Optional[int]:
+    """Return the number of items requested by ``args``, or None for all of them."""
+    limit = None
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg != "--limit":
+            raise ValueError("unknown argument")
+        if i + 1 >= len(args):
+            raise ValueError("--limit requires a value")
+        try:
+            limit = int(args[i + 1])
+        except ValueError:
+            raise ValueError("--limit must be an integer") from None
+        if limit < 1:
+            raise ValueError("--limit must be at least 1")
+        i += 2
+    return limit
+
+
