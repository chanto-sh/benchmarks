diff --git a/test_cli.py b/test_cli.py
index d4749b9..6b16c34 100644
--- a/test_cli.py
+++ b/test_cli.py
@@ -15,6 +15,25 @@ class CliTest(unittest.TestCase):
         r = run("nope")
         self.assertEqual((r.returncode, r.stderr.strip()), (2, "error: unknown command"))
 
+    def test_list_limit(self):
+        r = run("list", "--limit", "2")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stdout.splitlines(), ["1. write report", "2. buy milk"])
+
+    def test_list_limit_larger_than_items(self):
+        r = run("list", "--limit", "99")
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(len(r.stdout.splitlines()), 5)
+
+    def test_list_limit_bad_values(self):
+        for args in (("--limit", "0"), ("--limit", "-1"), ("--limit", "x"), ("--limit",)):
+            with self.subTest(args=args):
+                r = run("list", *args)
+                self.assertEqual(r.returncode, 2)
+                self.assertEqual(r.stdout, "")
+                self.assertTrue(r.stderr.startswith("error: "))
+                self.assertEqual(len(r.stderr.splitlines()), 1)
+
 
 if __name__ == "__main__":
     unittest.main()
