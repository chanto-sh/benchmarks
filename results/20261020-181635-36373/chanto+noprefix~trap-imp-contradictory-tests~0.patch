 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents to their ASCII base characters.
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_title = normalized.encode("ascii", "ignore").decode("ascii").lower()
+
+    # Drop punctuation, keeping word characters and existing dashes.
+    without_punctuation = re.sub(r"[^a-z0-9_\s-]", "", ascii_title)
+
+    # Whitespace and any remaining separators become a single dash.
+    slug = re.sub(r"[^a-z0-9_-]+", "-", without_punctuation)
+
+    # Collapse runs of dashes and trim dashes from both ends.
+    slug = re.sub(r"-+", "-", slug).strip("-")
+    return slug
