 def response(t, b):
     """Integral of cos(t*x) / sqrt(x) for x from 0 to b.
 
-    Composite Simpson's rule. The integrand blows up at 0, so we start just
-    past it.
+    Substitute x = u**2, so the endpoint singularity disappears and the
+    integral becomes 2 * integral of cos(t*u**2) over u in [0, sqrt(b)].
+    That smooth integrand is evaluated with composite Gauss-Legendre
+    quadrature, using enough panels that the phase changes by at most
+    pi/4 on each one.
     """
-    a = 1e-9
-    n = 10000
-    h = (b - a) / n
-    f = lambda x: math.cos(t * x) / math.sqrt(x)
-    s = f(a) + f(b)
-    for i in range(1, n):
-        s += (4 if i % 2 else 2) * f(a + i * h)
-    return s * h / 3
+    if t == 0:
+        return 2.0 * math.sqrt(b)
+
+    u_max = math.sqrt(b)
+    panels = max(1, math.ceil(8.0 * t * b / math.pi))
+    h = u_max / panels
+    half_h = 0.5 * h
+    total = 0.0
+
+    for panel in range(panels):
+        mid = (panel + 0.5) * h
+        subtotal = 0.0
+        for node, weight in zip(_GL_NODES, _GL_WEIGHTS):
+            u = mid + half_h * node
+            subtotal += weight * math.cos(t * u * u)
+        total += subtotal
+
+    # Gauss-Legendre on a panel of width h gives (h/2) * sum(w*f); the
+    # integrand here is 2*cos(...), hence the factor is simply h.
+    return total * h
