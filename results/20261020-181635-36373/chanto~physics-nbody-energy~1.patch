+        ]
+
+        p, q = simulate(m, pos, vel, 0.01, 5000)
+
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        for k in (0, 1):
+            momentum = sum(m[i] * q[i][k] for i in range(len(m)))
+            self.assertAlmostEqual(momentum, momentum0[k], places=10)
+
+    def test_figure_eight_energy(self):
+        # Chenciner-Montgomery figure-eight orbit, three equal masses.
+        m = [1.0, 1.0, 1.0]
+        pos = [
+            [0.97000436, -0.24308753],
+            [-0.97000436, 0.24308753],
+            [0.0, 0.0],
+        ]
+        vx, vy = -0.93240737, -0.86473146
+        vel = [[-vx / 2, -vy / 2], [-vx / 2, -vy / 2], [vx, vy]]
+        e0 = energy(m, pos, vel)
+
+        p, q = simulate(m, pos, vel, 0.005, 20000)
+
