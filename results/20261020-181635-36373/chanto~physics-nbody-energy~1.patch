--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,35 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick leapfrog), a second-order symplectic
+    integrator.  Its energy error oscillates instead of growing secularly, and
+    each kick is a symmetric pairwise interaction, so total momentum is
+    conserved.
+    """
+    n = len(masses)
+    pos = [list(xy) for xy in positions]
+    vel = [list(xy) for xy in velocities]
+    if steps <= 0:
+        return pos, vel
+
+    dt2_half = 0.5 * dt * dt
+    dt_half = 0.5 * dt
+    acc = accelerations(masses, pos, G)
+
+    for _ in range(steps):
+        # Drift using the current acceleration (half kick, drift, half kick).
+        for i in range(n):
+            pos[i][0] += vel[i][0] * dt + acc[i][0] * dt2_half
+            pos[i][1] += vel[i][1] * dt + acc[i][1] * dt2_half
+
+        new_acc = accelerations(masses, pos, G)
+
+        for i in range(n):
+            vel[i][0] += (acc[i][0] + new_acc[i][0]) * dt_half
+            vel[i][1] += (acc[i][1] + new_acc[i][1]) * dt_half
+
+        acc = new_acc
+
+    return pos, vel
