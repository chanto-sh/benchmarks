 """URL slugs for article titles."""
 import re
+import unicodedata
+
+# Characters that must never survive into a slug (apostrophes, punctuation, ...).
+_NON_SLUG = re.compile(r"[^a-z0-9\s_-]")
+
+# Runs of whitespace, hyphens and underscores become a single hyphen.
+_SEPARATORS = re.compile(r"[\s_-]+")
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_text = normalized.encode("ascii", "ignore").decode("ascii").lower()
+    ascii_text = _NON_SLUG.sub("", ascii_text)
+    return _SEPARATORS.sub("-", ascii_text).strip("-")
