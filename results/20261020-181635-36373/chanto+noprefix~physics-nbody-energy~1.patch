 def simulate(masses, positions, velocities, dt, steps, G=1.0):
     """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    pos = [list(xy) for xy in positions]
+    vel = [list(xy) for xy in velocities]
+    n = len(masses)
+    if n == 0 or steps <= 0:
+        return pos, vel
+
+    # Fourth-order symplectic composition of velocity Verlet steps
+    # (Yoshida's triple jump).  Being symplectic, it keeps the energy
+    # error bounded instead of letting it drift over long integrations.
+    cbrt2 = 2.0 ** (1.0 / 3.0)
+    w1 = 1.0 / (2.0 - cbrt2)
+    w0 = -cbrt2 / (2.0 - cbrt2)
+    h1 = 0.5 * w1 * dt
+    h0 = 0.5 * (w1 + w0) * dt
+
+    acc = accelerations(masses, pos, G)
+    for _ in range(steps):
+        for i in range(n):
+            vel[i][0] += h1 * acc[i][0]
+            vel[i][1] += h1 * acc[i][1]
+            pos[i][0] += w1 * dt * vel[i][0]
+            pos[i][1] += w1 * dt * vel[i][1]
+        acc = accelerations(masses, pos, G)
+
+        for i in range(n):
+            vel[i][0] += h0 * acc[i][0]
+            vel[i][1] += h0 * acc[i][1]
+            pos[i][0] += w0 * dt * vel[i][0]
+            pos[i][1] += w0 * dt * vel[i][1]
+        acc = accelerations(masses, pos, G)
+
+        for i in range(n):
+            vel[i][0] += h0 * acc[i][0]
+            vel[i][1] += h0 * acc[i][1]
