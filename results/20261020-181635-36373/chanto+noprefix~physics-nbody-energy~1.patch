+    def test_eccentric_orbit_long_run(self):
+        # Eccentric Kepler orbit with a long integration: energy error must
+        # stay bounded and momentum must be unaffected.
+        m = [1.0, 1.0]
+        a, e = 1.0, 0.5
+        rp = a * (1.0 - e)
+        vp = math.sqrt(2.0 / rp - 1.0 / a)
+        pos = [[-rp / 2.0, 0.0], [rp / 2.0, 0.0]]
+        vel = [[0.0, -vp / 2.0], [0.0, vp / 2.0]]
+        pos0 = [xy[:] for xy in pos]
+        vel0 = [xy[:] for xy in vel]
+        e0 = energy(m, pos, vel)
+        p0 = [sum(m[i] * vel[i][k] for i in range(2)) for k in (0, 1)]
+
+        p, q = simulate(m, pos, vel, 0.01, 100000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+        for k in (0, 1):
+            self.assertAlmostEqual(
+                sum(m[i] * q[i][k] for i in range(2)), p0[k], places=10
+            )
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+
+    def test_figure_eight_three_body(self):
+        # A well-known stable three-body orbit exercises non-collinear motion.
+        m = [1.0, 1.0, 1.0]
+        pos = [
+            [0.97000436, -0.24308753],
+            [-0.97000436, 0.24308753],
+            [0.0, 0.0],
+        ]
+        v3 = [-0.93240737, -0.86473146]
+        vel = [[-v3[0] / 2.0, -v3[1] / 2.0], [-v3[0] / 2.0, -v3[1] / 2.0], v3]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.002, 50000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
+    def test_nonzero_total_momentum(self):
+        # A common drift velocity must be preserved exactly in aggregate.
+        m = [2.0, 1.0]
+        r = 3.0
+        vrel = math.sqrt(3.0 / r)
+        pos = [[-r / 3.0, 0.0], [2.0 * r / 3.0, 0.0]]
+        vel = [
+            [0.3, -0.2 - vrel / 3.0],
+            [0.3, -0.2 + 2.0 * vrel / 3.0],
+        ]
+        p0 = [sum(m[i] * vel[i][k] for i in range(2)) for k in (0, 1)]
+        p, q = simulate(m, pos, vel, 0.01, 20000)
+        for k in (0, 1):
+            self.assertAlmostEqual(
+                sum(m[i] * q[i][k] for i in range(2)), p0[k], places=10
+            )
+
 
