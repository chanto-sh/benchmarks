 from fractions import Fraction
 
 
+def _destination(i, roll, n):
+    """Square reached from i with roll, bouncing back off n by the excess."""
+    target = i + roll
+    if target > n:
+        target = 2 * n - target
+    return target
+
+
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # Unknowns E[0]..E[n-1]; E[n] = 0 since the game ends there.
+    # For every transient square i:
+    #     E[i] - (1/k) * sum_r E[next(i, r)] = 1
+    # with rolls that finish excluded from the sum.
+    width = n + 1
+    matrix = [[Fraction(0) for _ in range(width)] for _ in range(n)]
+    for i in range(n):
+        matrix[i][i] += 1
+        matrix[i][n] = 1
+        for roll in range(1, k + 1):
+            j = _destination(i, roll, n)
+            if j != n:
+                matrix[i][j] -= Fraction(1, k)
+
+    # Gauss-Jordan elimination over the rationals.
+    for col in range(n):
+        pivot = col
+        while pivot < n and matrix[pivot][col] == 0:
+            pivot += 1
+        matrix[col], matrix[pivot] = matrix[pivot], matrix[col]
+        pivot_value = matrix[col][col]
+        for c in range(col, width):
+            matrix[col][c] /= pivot_value
+        for row in range(n):
+            if row == col:
+                continue
+            factor = matrix[row][col]
+            if factor == 0:
+                continue
+            for c in range(col, width):
+                matrix[row][c] -= factor * matrix[col][c]
+
+    # After full reduction, matrix[i][n] is E[i].
+    return matrix[0][n]
