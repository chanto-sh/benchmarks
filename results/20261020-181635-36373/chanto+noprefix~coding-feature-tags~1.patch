@@ -1,11 +1,20 @@
+def _tag_words(tags):
+    return " ".join("#" + t for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    row = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        row += "  " + _tag_words(note.tags)
+    return row
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append("tags: " + _tag_words(note.tags))
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..9cb36e1 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,25 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty or contains whitespace, a comma or a '#'."""
+
+
+def normalize_tag(tag):
+    text = tag.strip()
+    if not text or any(c.isspace() or c in ",#" for c in text):
+        raise InvalidTag(tag)
+    return text.lower()
+
+
+def normalize_tags(tags):
+    """Lowercase, trim, validate and de-duplicate tags, keeping first-seen order."""
+    out = []
+    for tag in tags:
+        text = normalize_tag(tag)
+        if text not in out:
+            out.append(text)
+    return out
 
 
 @dataclass
@@ -6,10 +27,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
