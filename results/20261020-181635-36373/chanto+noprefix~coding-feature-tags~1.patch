+    def test_add_tags_normalized(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", " Errands ", "--tag", "HOME")
+        self.assertEqual(run(self.db, "list")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "A", "--tag", "home")
+        run(self.db, "add", "B", "--tag", "home", "--tag", "work")
+        run(self.db, "add", "C", "--tag", "errands")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  A  #home\n  2  B  #home #work\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "Work")[1], "  2  B  #home #work\n")
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_show_tags_before_body(self):
+        run(self.db, "add", "A", "--body", "hello", "--tag", "x")
