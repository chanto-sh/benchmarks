+        integral = 2 * integral(cos(t*u^2), u=0..sqrt(b))
+                 = 2*sqrt(pi/(2*t)) * C(sqrt(2*t*b/pi)),
+
+    where C is the Fresnel cosine integral.
     """
-    a = 1e-9
-    n = 10000
-    h = (b - a) / n
-    f = lambda x: math.cos(t * x) / math.sqrt(x)
-    s = f(a) + f(b)
-    for i in range(1, n):
-        s += (4 if i % 2 else 2) * f(a + i * h)
-    return s * h / 3
+    if t == 0.0:
+        return 2.0 * math.sqrt(b)
+
+    x = math.sqrt(t) * math.sqrt(b) * _SQRT_TWO_OVER_PI
+    return _TWO_SQRT_HALF_PI / math.sqrt(t) * _fresnel_c(x)
