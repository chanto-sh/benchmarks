 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Split accented characters into base + combining mark, then drop the marks.
+    text = unicodedata.normalize("NFKD", title)
+    text = "".join(ch for ch in text if not unicodedata.combining(ch))
+    text = text.lower()
+    # Punctuation is dropped rather than replaced, so "What's" -> "whats".
+    text = re.sub(r"[^a-z0-9_\s]", "", text)
+    # Spec 4.5: slugs only ever contain [a-z0-9-].
+    text = text.replace("_", "-")
+    text = re.sub(r"[\s-]+", "-", text)
+    return text.strip("-")
