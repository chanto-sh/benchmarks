 """Point-mass projectile with quadratic air drag."""
 
+import math
+
+# Dormand-Prince 5(4) coefficients.
+_C = (0.0, 1.0 / 5.0, 3.0 / 10.0, 4.0 / 5.0, 8.0 / 9.0, 1.0, 1.0)
+_A = (
+    (),
+    (1.0 / 5.0,),
+    (3.0 / 40.0, 9.0 / 40.0),
+    (44.0 / 45.0, -56.0 / 15.0, 32.0 / 9.0),
+    (19372.0 / 6561.0, -25360.0 / 2187.0, 64448.0 / 6561.0, -212.0 / 729.0),
+    (9017.0 / 3168.0, -355.0 / 33.0, 46732.0 / 5247.0, 49.0 / 176.0,
+     -5103.0 / 18656.0),
+)
+_B = (35.0 / 384.0, 0.0, 500.0 / 1113.0, 125.0 / 192.0,
+      -2187.0 / 6784.0, 11.0 / 84.0, 0.0)
+# Difference between the fifth- and fourth-order solutions.
+_E = (71.0 / 57600.0, 0.0, -71.0 / 16695.0, 71.0 / 1920.0,
+      -17253.0 / 339200.0, 22.0 / 525.0, -1.0 / 40.0)
+
+_RTOL = 1.0e-12
+_ATOL = 1.0e-12
+
+
+def _rhs(mass, k, g):
+    drag = k / mass
+
+    def f(_t, state):
+        _x, _y, vx, vy = state
+        speed = math.hypot(vx, vy)
+        return (
+            vx,
+            vy,
+            -drag * speed * vx,
+            -g - drag * speed * vy,
+        )
+
+    return f
+
+
+def _dopri_step(t, state, h, k1, f):
+    """Take one Dormand-Prince 5(4) step, returning state, error, and k7."""
+    ks = [k1]
+    for stage in range(1, 6):
+        row = _A[stage]
+        trial = [
+            state[d] + h * sum(row[j] * ks[j][d] for j in range(stage))
+            for d in range(4)
+        ]
+        ks.append(f(t + _C[stage] * h, trial))
+
+    new_state = [
+        state[d] + h * sum(_B[j] * ks[j][d] for j in range(6))
+        for d in range(4)
+    ]
+    k7 = f(t + h, new_state)
+    ks.append(k7)
+    error = [
+        h * sum(_E[j] * ks[j][d] for j in range(7))
+        for d in range(4)
+    ]
+
+    return new_state, error, k7
+
+
+def _error_norm(state, new_state, error):
+    total = 0.0
+    for i in range(4):
+        scale = _ATOL + _RTOL * max(abs(state[i]), abs(new_state[i]))
+        ratio = error[i] / scale
+        total += ratio * ratio
+    return math.sqrt(total / 4.0)
+
+
+def _integrate_to(t, state, t_end, f, h_start):
+    """Adaptively integrate from *t* to *t_end*."""
+    if t == t_end:
+        return state, h_start
+
+    direction = 1.0 if t_end > t else -1.0
+    h = abs(h_start)
+    if h == 0.0:
+        h = abs(t_end - t)
+
+    k1 = f(t, state)
+
+    while True:
+        remaining = (t_end - t) * direction
+        if remaining <= 0.0:
+            return state, h
+
+        h = min(h, remaining)
+        new_state, error, k7 = _dopri_step(t, state, direction * h, k1, f)
+        err = _error_norm(state, new_state, error)
+
+        if err <= 1.0:
+            t += direction * h
+            state = new_state
+            k1 = k7
+
+            # Avoid a final round-off-sized step.
+            if abs(t_end - t) <= 1.0e-15 * max(1.0, abs(t_end)):
+                t = t_end
+
+            if err == 0.0:
+                factor = 5.0
+            else:
+                factor = min(5.0, max(0.2, 0.9 * err ** -0.2))
+            next_h = h * factor
+
+            if t == t_end:
+                return state, next_h
+            h = next_h
+        else:
+            h *= max(0.1, 0.9 * err ** -0.2)
+
+
+def _bisect_event(t0, state0, t1, state1, f, index):
+    """Locate the zero of state[index] between two known opposite signs."""
+    low = t0
+    high = t1
+    h_start = t1 - t0
+
+    for _ in range(80):
+        if high - low <= 1.0e-12 * max(1.0, abs(high)):
+            break
+        mid = 0.5 * (low + high)
+        state_mid, _ = _integrate_to(t0, state0, mid, f, h_start)
+        if state_mid[index] > 0.0:
+            low = mid
+        else:
+            high = mid
+        h_start = mid - t0
+
+    t_event = 0.5 * (low + high)
+    state_event, _ = _integrate_to(t0, state0, t_event, f, t_event - t0)
+    return t_event, state_event
+
 
 def flight(v0, angle_deg, mass, k, g=9.81, h0=0.0):
     """Return {"range": metres, "apex": metres, "time": seconds}."""
-    raise NotImplementedError
+    if mass <= 0.0:
+        raise ValueError("mass must be positive")
+    if h0 < 0.0:
+        raise ValueError("h0 must be non-negative")
+
+    angle = math.radians(angle_deg)
+    state = [
+        0.0,
+        float(h0),
+        v0 * math.cos(angle),
+        v0 * math.sin(angle),
+    ]
+    f = _rhs(mass, k, g)
+
+    # A projectile starting on the ground but not moving upwards is already
+    # at the end of its (zero-length) flight.
+    if h0 == 0.0 and state[3] <= 0.0:
+        return {"range": 0.0, "apex": float(h0), "time": 0.0}
+
+    t = 0.0
+    h = 1.0e-3
+    apex = float(h0)
+    apex_found = state[3] <= 0.0
+
+    while True:
+        t_next = t + h
+        next_state, h_next = _integrate_to(t, state, t_next, f, h)
+
+        ground_event = (
+            next_state[1] <= 0.0
+            and (state[1] > 0.0 or next_state[1] < 0.0)
+        )
+        apex_event = (
+            not apex_found
+            and state[3] > 0.0
+            and next_state[3] <= 0.0
+        )
+
+        if not (ground_event or apex_event):
+            if next_state[1] > apex:
+                apex = next_state[1]
+            t, state = t_next, next_state
+            h = h_next
+            continue
+
+        t_apex = None
+        if apex_event:
+            t_apex, apex_state = _bisect_event(
+                t, state, t_next, next_state, f, 3
+            )
+
+        if ground_event:
+            t_ground, ground_state = _bisect_event(
+                t, state, t_next, next_state, f, 1
+            )
+
+        if apex_event and (not ground_event or t_apex <= t_ground):
+            if apex_state[1] > apex:
+                apex = apex_state[1]
+            apex_found = True
+            t, state = t_apex, apex_state
+            h = max(h_next, 1.0e-9)
+            continue
+
+        if ground_state[1] > apex:
+            apex = ground_state[1]
+        return {
+            "range": ground_state[0],
+            "apex": apex,
+            "time": t_ground,
+        }
