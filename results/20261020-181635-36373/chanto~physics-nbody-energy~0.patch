diff --git a/nbody.py b/nbody.py
index 133b00d..ffe8fac 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,35 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses velocity Verlet (kick-drift-kick leapfrog).  It is symplectic and
+    time-reversible, so the energy error stays bounded instead of growing
+    linearly with the number of steps.
+    """
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    if n == 0 or steps <= 0:
+        return pos, vel
+
+    acc = accelerations(masses, pos, G)
+    half_dt = 0.5 * dt
+
+    for _ in range(steps):
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+        for i in range(n):
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+
+        acc = accelerations(masses, pos, G)
+
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+    return pos, vel
diff --git a/test_nbody.py b/test_nbody.py
index 2a0b4a1..14bc7ad 100644
--- a/test_nbody.py
+++ b/test_nbody.py
@@ -17,6 +17,53 @@ class TestNBody(unittest.TestCase):
         for xy in p:
             self.assertAlmostEqual(math.hypot(*xy), 1.0, places=3)
 
+    def test_long_run_momentum_and_inputs(self):
+        # unequal masses on a circular orbit, with a common boost
+        m = [3.0, 1.0]
+        separation = 2.0
+        total_mass = sum(m)
+        v_rel = math.sqrt(total_mass / separation)
+        r1 = separation * m[1] / total_mass
+        r2 = separation * m[0] / total_mass
+        boost = [0.3, -0.2]
+        pos = [[-r1, 0.0], [r2, 0.0]]
+        vel = [
+            [boost[0], boost[1] - v_rel * m[1] / total_mass],
+            [boost[0], boost[1] + v_rel * m[0] / total_mass],
+        ]
+        pos0 = [xy[:] for xy in pos]
+        vel0 = [xy[:] for xy in vel]
+        m0 = m[:]
+
+        e0 = energy(m, pos, vel)
+        px0 = sum(mi * vi[0] for mi, vi in zip(m, vel))
+        py0 = sum(mi * vi[1] for mi, vi in zip(m, vel))
+
+        p, q = simulate(m, pos, vel, 0.005, 50000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-8)
+        self.assertAlmostEqual(sum(mi * vi[0] for mi, vi in zip(m, q)), px0, places=10)
+        self.assertAlmostEqual(sum(mi * vi[1] for mi, vi in zip(m, q)), py0, places=10)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertEqual(m, m0)
+
+    def test_figure_eight_energy(self):
+        # Chenciner-Montgomery three-body choreography
+        m = [1.0, 1.0, 1.0]
+        pos = [
+            [0.97000436, -0.24308753],
+            [-0.97000436, 0.24308753],
+            [0.0, 0.0],
+        ]
+        vx, vy = 0.93240737, 0.86473146
+        vel = [[vx / 2.0, vy / 2.0], [vx / 2.0, vy / 2.0], [-vx, -vy]]
+
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-6)
+
 
 if __name__ == "__main__":
     unittest.main()
