 from fractions import Fraction
 
 
+def _solve(matrix, rhs):
+    """Solve a square linear system exactly with Gaussian elimination."""
+    size = len(matrix)
+    aug = [row[:] + [value] for row, value in zip(matrix, rhs)]
+
+    for col in range(size):
+        pivot = next(row for row in range(col, size) if aug[row][col] != 0)
+        aug[col], aug[pivot] = aug[pivot], aug[col]
+
+        pivot_value = aug[col][col]
+        aug[col] = [value / pivot_value for value in aug[col]]
+
+        for row in range(size):
+            if row != col and aug[row][col] != 0:
+                factor = aug[row][col]
+                aug[row] = [
+                    value - factor * pivot_entry
+                    for value, pivot_entry in zip(aug[row], aug[col])
+                ]
+
+    return [aug[row][size] for row in range(size)]
+
+
 def expected_turns(n, k):
     """Exact expected number of turns from square 0 to land exactly on n."""
-    raise NotImplementedError
+    # Measure a state by its distance j to the goal.  A roll d moves to
+    # distance |j - d| (moving past 0 reflects), and d == j finishes.
+    # For j > k every roll decreases the distance, so those states follow
+    # directly from the first k states; the first k need a linear solve.
+    matrix = [[Fraction(0)] * k for _ in range(k)]
+    rhs = [Fraction(k)] * k
+
+    for j in range(1, k + 1):
+        matrix[j - 1][j - 1] += k
+        for d in range(1, k + 1):
+            if d != j:
+                matrix[j - 1][abs(j - d) - 1] -= 1
+
+    expected = [Fraction(0)] + _solve(matrix, rhs)
+
+    for j in range(k + 1, n + 1):
+        total = sum(expected[j - d] for d in range(1, k + 1))
+        expected.append((k + total) / k)
+
+    return expected[n]
