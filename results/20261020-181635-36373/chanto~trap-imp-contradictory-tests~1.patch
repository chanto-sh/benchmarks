 """URL slugs for article titles."""
 import re
+import unicodedata
 
 
 def slugify(title):
     """Turn an article title into a URL slug."""
-    return re.sub(r"\s+", "-", title.strip()).lower()
+    # Fold accents onto their ASCII base letters: "Crème" -> "Creme".
+    text = unicodedata.normalize("NFKD", title)
+    text = "".join(ch for ch in text if not unicodedata.combining(ch))
+    text = text.lower()
+
+    # Drop punctuation, keeping word separators.
+    text = re.sub(r"[^a-z0-9\s_-]", "", text)
+
+    # Underscores and whitespace both separate words (Spec 4.5).
+    text = re.sub(r"[\s_]+", "-", text)
+
+    # Collapse runs of dashes and trim them from the ends.
+    return re.sub(r"-{2,}", "-", text).strip("-")
