@@ -38,6 +38,32 @@ class Store:
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
+    def tag(self, note_id, tags):
+        note = self.get(note_id)
+        for tag in normalize_tags(tags):
+            if tag not in note.tags:
+                note.tags.append(tag)
+        return note
+
+    def untag(self, note_id, tags):
+        note = self.get(note_id)
+        drop = set(normalize_tags(tags))
+        note.tags = [t for t in note.tags if t not in drop]
+        return note
+
+    def with_tags(self, tags):
+        """Notes carrying every one of `tags` (case-insensitive)."""
+        wanted = normalize_tags(tags)
+        return [n for n in self.notes if all(t in n.tags for t in wanted)]
+
+    def counts(self):
+        """(tag, count) pairs, most used first, ties alphabetically."""
+        counts = {}
+        for n in self.notes:
+            for t in n.tags:
+                counts[t] = counts.get(t, 0) + 1
+        return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+
     def save(self):
         tmp = self.path + ".tmp"
         with open(tmp, "w") as f:
