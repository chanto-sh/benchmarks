@@ -24,8 +24,8 @@ class Store:
     def next_id(self):
         return max((n.id for n in self.notes), default=0) + 1
 
-    def add(self, title, body=""):
-        note = Note(self.next_id(), title, body)
+    def add(self, title, body="", tags=()):
