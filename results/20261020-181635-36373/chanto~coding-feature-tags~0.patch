+class TagTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.db = os.path.join(self.dir.name, "notes.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def saved(self):
+        with open(self.db) as f:
+            return json.load(f)
+
+    def test_tags_are_normalized_deduplicated_and_ordered(self):
+        code, out, err = run(
+            self.db, "add", "Buy milk", "--tag", " home ", "--tag", "Errands",
+            "--tag", "HOME", "--tag", "errands",
+        )
+        self.assertEqual((code, out, err), (0, "added #1\n", ""))
+        self.assertEqual(self.saved()["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags_save_nothing(self):
+        cases = ["", "   ", "two words", "a,b", "#home", "ho#me"]
+        for bad in cases:
+            code, out, err = run(self.db, "add", "x", "--tag", bad)
+            self.assertEqual(code, 2, bad)
+            self.assertEqual(out, "")
+            self.assertIn(bad, err)
+            self.assertFalse(os.path.exists(self.db), bad)
+
+    def test_valid_tag_alongside_invalid_tag_saves_nothing(self):
+        code, _, err = run(self.db, "add", "x", "--tag", "home", "--tag", "bad tag")
+        self.assertEqual(code, 2)
+        self.assertIn("bad tag", err)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_list_shows_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom\n",
+        )
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        run(self.db, "add", "Read book")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  Buy milk  #home #errands\n  2  Call mom  #home\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "errands")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "nope")[1], "")
+
+    def test_show_prints_tags_under_title(self):
+        run(self.db, "add", "Buy milk", "--body", "2%", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Buy milk\ntags: #home #errands\n\n2%\n",
+        )
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 Call mom\n")
+
+    def test_tags_lists_counts_most_used_first_then_alphabetical(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "zzz")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "alpha")
+        run(self.db, "add", "c", "--tag", "alpha")
+        self.assertEqual(run(self.db, "tags")[1], "alpha 2\nhome 2\nzzz 1\n")
+        run(self.db, "tag", "3", "home")
+        self.assertEqual(run(self.db, "tags")[1], "home 3\nalpha 2\nzzz 1\n")
+
+    def test_tag_and_untag_existing_note(self):
+        run(self.db, "add", "x", "--tag", "home")
+        code, out, err = run(self.db, "tag", "1", " Errands ", "HOME", "new")
+        self.assertEqual((code, out, err), (0, "", ""))
+        self.assertEqual(self.saved()["notes"][0]["tags"], ["home", "errands", "new"])
+        run(self.db, "add", "y")
+
+        code, out, err = run(self.db, "untag", "1", "HOME", "missing")
+        self.assertEqual((code, out, err), (0, "", ""))
+        self.assertEqual(self.saved()["notes"][0]["tags"], ["errands", "new"])
+        self.assertEqual(self.saved()["notes"][1]["tags"], [])
+
+    def test_tag_and_untag_reject_invalid_tags(self):
+        run(self.db, "add", "x")
+        code, _, err = run(self.db, "tag", "1", "ok", "bad tag")
+        self.assertEqual(code, 2)
+        self.assertIn("bad tag", err)
+        self.assertEqual(self.saved()["notes"][0]["tags"], [])
+        code, _, err = run(self.db, "untag", "1", "a,b")
+        self.assertEqual(code, 2)
+        self.assertIn("a,b", err)
+
+    def test_tag_commands_unknown_note(self):
+        for argv in [("tag", "9", "home"), ("untag", "9", "home")]:
+            code, _, err = run(self.db, *argv)
+            self.assertEqual(code, 1)
+            self.assertIn("no such note", err)
+
+    def test_legacy_file_loads_and_saves_version_2(self):
+        with open(self.db, "w") as f:
+            json.dump({"version": 1, "notes": [{"id": 1, "title": "old", "body": "b"}]}, f)
+        self.assertEqual(run(self.db, "list")[1], "  1  old\n")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 old\n\nb\n")
+        run(self.db, "tag", "1", "kept")
+        data = self.saved()
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["kept"])
+
+    def test_save_gives_every_note_a_tags_list(self):
+        with open(self.db, "w") as f:
+            json.dump({"version": 1, "notes": [{"id": 1, "title": "old"}]}, f)
+        run(self.db, "add", "new", "--tag", "home")
+        data = self.saved()
+        self.assertEqual([n["tags"] for n in data["notes"]], [[], ["home"]])
+
+
 if __name__ == "__main__":
     unittest.main()
