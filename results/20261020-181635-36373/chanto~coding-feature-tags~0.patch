diff --git a/notes/model.py b/notes/model.py
index 3750b6b..a41d26f 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,36 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that cannot be stored."""
+
+
+def normalize_tag(tag):
+    """Lowercase and trim one tag, rejecting tags that cannot be used."""
+    name = tag.strip().lower()
+    if not name or any(c.isspace() for c in name) or "," in name or "#" in name:
+        raise InvalidTag(tag)
+    return name
+
+
+def normalize_tags(tags):
+    """Normalize tags, dropping duplicates but keeping the order first given."""
+    out = []
+    for tag in tags:
+        name = normalize_tag(tag)
+        if name not in out:
+            out.append(name)
+    return out
+
+
+def canonical_tags(tags):
+    """Best-effort normalization for tags read from disk."""
+    out = []
+    for tag in tags:
+        name = tag.strip().lower()
+        if name and name not in out:
+            out.append(name)
+    return out
 
 
 @dataclass
@@ -6,10 +38,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list[str] = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=canonical_tags(d.get("tags", [])),
+        )
