diff --git a/notes/model.py b/notes/model.py
index 3750b6b..033cc13 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,26 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """A tag that is empty or contains whitespace, a comma or a '#'."""
+
+    def __init__(self, tag):
+        super().__init__(tag)
+        self.tag = tag
+
+
+def normalize_tags(tags):
+    """Trim and lowercase tags, drop repeats, keep first-seen order."""
+    out = []
+    seen = set()
+    for tag in tags:
+        t = tag.strip().lower()
+        if not t or "," in t or "#" in t or any(c.isspace() for c in t):
+            raise InvalidTag(tag)
+        if t not in seen:
+            seen.add(t)
+            out.append(t)
+    return out
 
 
 @dataclass
@@ -6,10 +28,27 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(id=d["id"], title=d["title"], body=d.get("body", ""), tags=list(d.get("tags") or []))
+
+    def has_tags(self, tags):
+        """True if every tag in `tags` is on this note (case-insensitive)."""
+        have = {t.lower() for t in self.tags}
+        return all(t.lower() in have for t in tags)
+
+    def add_tags(self, tags):
+        have = {t.lower() for t in self.tags}
+        for tag in tags:
+            if tag.lower() not in have:
+                have.add(tag.lower())
+                self.tags.append(tag)
+
+    def remove_tags(self, tags):
+        drop = {t.lower() for t in tags}
+        self.tags = [t for t in self.tags if t.lower() not in drop]
