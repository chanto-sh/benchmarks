+class TagsTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.db = os.path.join(self.dir.name, "notes.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_add_tags_are_normalized(self):
+        code, out, err = run(
+            self.db, "add", "Buy milk", "--tag", " home ", "--tag", "Errands", "--tag", "HOME"
+        )
+        self.assertEqual((code, out, err), (0, "added #1\n", ""))
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+        self.assertEqual(json.load(open(self.db))["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tags_save_nothing(self):
+        run(self.db, "add", "kept")
+        before = open(self.db).read()
+        for bad in ["", "   ", "home work", "a,b", "#hash"]:
+            code, out, err = run(self.db, "add", "x", "--tag", "ok", "--tag", bad)
+            self.assertEqual(code, 2, bad)
+            self.assertEqual(out, "", bad)
+            self.assertIn("invalid tag", err)
+            if bad:
+                self.assertIn(bad, err)
+            self.assertEqual(open(self.db).read(), before)
+
+    def test_invalid_tag_on_missing_db_creates_nothing(self):
+        code, _, err = run(self.db, "add", "x", "--tag", "a b")
+        self.assertEqual(code, 2)
+        self.assertIn("a b", err)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_list_renders_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n  3  Plain\n",
+        )
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        self.assertEqual(run(self.db, "list", "--tag", "HOME")[1], "  1  Buy milk  #home #errands\n  2  Call mom  #home\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "errands")[1], "  1  Buy milk  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_show_puts_tags_under_title(self):
+        run(self.db, "add", "Call mom", "--body", "about sunday", "--tag", "family")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Call mom\ntags: #family\n\nabout sunday\n")
+
+    def test_tags_lists_counts(self):
+        run(self.db, "add", "one", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "two", "--tag", "home", "--tag", "apple")
+        self.assertEqual(run(self.db, "tags")[1], "home 2\napple 1\nerrands 1\n")
+        self.assertEqual(run(self.db, "tags")[0], 0)
+
+    def test_tag_and_untag(self):
+        run(self.db, "add", "Buy milk")
+        self.assertEqual(run(self.db, "tag", "1", " Home ", "Errands")[:2], (0, ""))
+        self.assertEqual(run(self.db, "tag", "1", "home", "new")[:2], (0, ""))
+        self.assertEqual(
+            run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands #new\n"
+        )
+        self.assertEqual(run(self.db, "untag", "1", "ERRANDS", "missing")[:2], (0, ""))
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #new\n")
+
+    def test_tag_and_untag_unknown_id(self):
+        for cmd in ("tag", "untag"):
+            code, out, err = run(self.db, cmd, "9", "home")
+            self.assertEqual(code, 1)
+            self.assertEqual(out, "")
+            self.assertIn("no such note", err)
+
+    def test_tag_and_untag_validate_before_saving(self):
+        run(self.db, "add", "Buy milk")
+        before = open(self.db).read()
+        code, _, err = run(self.db, "tag", "1", "ok", "bad,one")
+        self.assertEqual(code, 2)
+        self.assertIn("bad,one", err)
+        self.assertEqual(open(self.db).read(), before)
+
+    def test_legacy_file_loads_and_upgrades(self):
+        with open(self.db, "w") as f:
+            json.dump({"version": 1, "notes": [{"id": 1, "title": "old", "body": "body"}]}, f)
+        self.assertEqual(run(self.db, "list")[1], "  1  old\n")
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 old\n\nbody\n")
+        run(self.db, "tag", "1", "archive")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["archive"])
+        run(self.db, "add", "new")
+        data = json.load(open(self.db))
+        self.assertEqual([n["tags"] for n in data["notes"]], [["archive"], []])
+
+
 if __name__ == "__main__":
     unittest.main()
