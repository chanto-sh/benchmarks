+# -*- coding: utf-8 -*-
+"""Tests for unrolling ``all``/``any`` calls over comprehensions (#5103)."""
+from __future__ import absolute_import
+from __future__ import division
+from __future__ import print_function
+
+import ast
+import sys
+
+import _pytest._code
+from _pytest.assertion.rewrite import rewrite_asserts
+
+
+def run_and_getmsg(f, extra_ns=None):
+    """Rewrite the assertions in *f*, run it and return the failure message.
+
+    Returns ``None`` if no assertion error is raised.
+    """
+    src = "\n".join(_pytest._code.Code(f).source().lines)
+    tree = ast.parse(src)
+    rewrite_asserts(tree)
+    code = compile(tree, "<test>", "exec")
+    ns = {}
+    if extra_ns is not None:
+        ns.update(extra_ns)
+    exec(code, ns)
+    func = ns[f.__name__]
+    try:
+        func()
+    except AssertionError:
+        return str(sys.exc_info()[1])
+    return None
+
+
+def is_even(number):
+    return number % 2 == 0
+
+
+def test_all_with_generator():
+    def f():
+        assert all(is_even(number) for number in [1, 2, 3])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) == (
+        "assert False\n +  where False = is_even(1)"
+    )
+
+
+def test_all_with_list_comprehension():
+    def f():
+        assert all([is_even(number) for number in [1, 2, 3]])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) == (
+        "assert False\n +  where False = is_even(1)"
+    )
+
+
+def test_all_with_condition():
+    def f():
+        assert all(is_even(number) for number in range(10) if number > 3)
+
+    assert run_and_getmsg(f, {"is_even": is_even}) == (
+        "assert False\n +  where False = is_even(5)"
+    )
+
+
+def test_all_short_circuits():
+    calls = []
+
+    def predicate(number):
+        calls.append(number)
+        return False
+
+    def f():
+        assert all(predicate(number) for number in [1, 2, 3])
+
+    run_and_getmsg(f, {"predicate": predicate})
+    assert calls == [1]
+
+
+def test_all_passing():
+    def f():
+        assert all(is_even(number) for number in [2, 4, 6])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) is None
+
+
+def test_all_empty():
+    def f():
+        assert all(is_even(number) for number in [])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) is None
+
+
+def test_any_with_generator():
+    def f():
+        assert any(is_even(number) for number in [1, 3, 5])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) == (
+        "assert (False or False or False)\n"
+        " +  where False = is_even(1)\n"
+        " +  and   False = is_even(3)\n"
+        " +  and   False = is_even(5)"
+    )
+
+
+def test_any_passing():
+    def f():
+        assert any(is_even(number) for number in [1, 2, 3])
+
+    assert run_and_getmsg(f, {"is_even": is_even}) is None
+
+
+def test_any_short_circuits():
+    calls = []
+
+    def predicate(number):
+        calls.append(number)
+        return number == 2
+
+    def f():
+        assert any(predicate(number) for number in [1, 2, 3])
+
+    assert run_and_getmsg(f, {"predicate": predicate}) is None
+    assert calls == [1, 2]
