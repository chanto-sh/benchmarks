+def _is_all_any_call(node):
+    """Return True if *node* is an ``all``/``any`` call over a comprehension.
+
+    Such calls can be unrolled by the assertion rewriter so that the failing
+    element is reported instead of the opaque generator/comprehension object.
+    """
+    return (
+        isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id in ("all", "any")
+        and len(node.args) == 1
+        and not node.keywords
+        and isinstance(node.args[0], (ast.GeneratorExp, ast.ListComp, ast.SetComp))
+        and not any(
+            getattr(generator, "is_async", 0) for generator in node.args[0].generators
+        )
+    )
+
