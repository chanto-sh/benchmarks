+    def _visit_all_any_assert(self, assert_):
+        """Rewrite ``assert all(...)``/``assert any(...)`` over a comprehension.
+
+        The comprehension is unrolled into the equivalent nested ``for``/``if``
+        statements so that the individual elements (and their reports) are
+        visible, instead of the opaque generator/comprehension object.
+        """
+        call = assert_.test
+        comp = call.args[0]
+
+        if call.func.id == "any":
+            return self._visit_any_assert(assert_)
+
+        inner = ast.Assert(comp.elt, assert_.msg)
+        inner.lineno = assert_.lineno
+        inner.col_offset = assert_.col_offset
+        body = self._visit_assert(inner)
+
+        for generator in reversed(comp.generators):
+            for cond in reversed(generator.ifs):
+                body = [ast.If(cond, body, [])]
+            body = [ast.For(generator.target, generator.iter, body, [])]
+        for stmt in body:
+            set_location(stmt, assert_.lineno, assert_.col_offset)
+        return body
+
+    def _visit_any_assert(self, assert_):
+        """Rewrite ``assert any(...)`` over a comprehension.
+
+        The comprehension is unrolled into nested ``for``/``if`` statements.
+        Each element is evaluated (short-circuiting on the first truthy one)
+        and its explanation collected, so that the failing ``any`` call can
+        report all the elements that were falsy.
+        """
+        comp = assert_.test.args[0]
+
+        self.statements = []
+        self.variables = []
+        self.variable_counter = itertools.count()
+        self.stack = []
+        self.on_failure = []
+        self.push_format_context()
+
+        expl_list = self.assign(ast.List([], ast.Load()))
+        app = ast.Attribute(expl_list, "append", ast.Load())
+        found = self.variable()
+        self.statements.append(
+            ast.Assign([ast.Name(found, ast.Store())], _NameConstant(False))
+        )
+
+        outer_statements = self.statements
+        outer_failure = self.on_failure
+        self.statements = elem_statements = []
+        self.on_failure = elem_failure = []
+        self.push_format_context()
+        res, expl = self.visit(comp.elt)
+        expl_name = self.pop_format_context(ast.Str(expl))
+        self.statements = outer_statements
+        self.on_failure = outer_failure
+        body = elem_statements + elem_failure + [
+            ast.Assign([ast.Name(found, ast.Store())], res),
+            ast.Expr(ast_Call(app, [expl_name], [])),
+            ast.If(ast.Name(found, ast.Load()), [ast.Break()], []),
+        ]
+        for generator in reversed(comp.generators):
+            for cond in reversed(generator.ifs):
+                body = [ast.If(cond, body, [])]
+            body = [
+                ast.If(ast.UnaryOp(ast.Not(), ast.Name(found, ast.Load())), body, [])
+            ]
+            body = [ast.For(generator.target, generator.iter, body, [])]
+        self.statements.extend(body)
+
+        self.statements.append(
+            ast.If(
+                ast.UnaryOp(ast.Not(), ast.Name(found, ast.Load())),
+                self._build_any_failure(expl_list),
+                [],
+            )
+        )
+        if self.variables:
+            variables = [ast.Name(name, ast.Store()) for name in self.variables]
+            self.statements.append(ast.Assign(variables, _NameConstant(None)))
+        for stmt in self.statements:
+            set_location(stmt, assert_.lineno, assert_.col_offset)
+        return self.statements
+
+    def _build_any_failure(self, expl_list):
+        self.on_failure = []
+        self.push_format_context()
+        expl_expr = self.pop_format_context(
+            ast.IfExp(
+                expl_list,
+                self.helper("_format_boolop", expl_list, ast.Num(1)),
+                ast.Str("False"),
+            )
+        )
+        explanation = self.explanation_param(expl_expr)
+        template = ast.BinOp(ast.Str(""), ast.Add(), ast.Str("assert " + explanation))
+        msg = self.pop_format_context(template)
+        fmt = self.helper("_format_explanation", msg)
+        exc = ast_Call(ast.Name("AssertionError", ast.Load()), [fmt], [])
+        body = self.on_failure
+        if sys.version_info[0] >= 3:
+            body.append(ast.Raise(exc, None))
+        else:
+            body.append(ast.Raise(exc, None, None))
+        return body
+
