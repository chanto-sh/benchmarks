diff --git a/changelog/8365.bugfix.rst b/changelog/8365.bugfix.rst
new file mode 100644
index 0000000..5ec6cec
--- /dev/null
+++ b/changelog/8365.bugfix.rst
@@ -0,0 +1,4 @@
+Fixed a crash in ``tmpdir`` when the current user name contains characters
+which are not valid in directory names (for example a Windows domain user
+returned as ``contoso\john_doe``). In this case pytest now falls back to a
+``pytest-of-unknown`` base directory.
diff --git a/src/_pytest/tmpdir.py b/src/_pytest/tmpdir.py
index 29c7e19..6f8ac6a 100644
--- a/src/_pytest/tmpdir.py
+++ b/src/_pytest/tmpdir.py
@@ -115,7 +115,13 @@ class TempPathFactory:
             # use a sub-directory in the temproot to speed-up
             # make_numbered_dir() call
             rootdir = temproot.joinpath(f"pytest-of-{user}")
-            rootdir.mkdir(exist_ok=True)
+            try:
+                rootdir.mkdir(exist_ok=True)
+            except OSError:
+                # getuser() likely returned illegal characters for the
+                # platform, use $TEMP/pytest-of-unknown instead
+                rootdir = temproot.joinpath("pytest-of-unknown")
+                rootdir.mkdir(exist_ok=True)
             basetemp = make_numbered_dir_with_cleanup(
                 prefix="pytest-", root=rootdir, keep=3, lock_timeout=LOCK_TIMEOUT
             )
