@@ -148,13 +152,23 @@ class TempdirFactory:
         return py.path.local(self._tmppath_factory.getbasetemp().resolve())
 
 
+def _sanitize_user(user: str) -> str:
+    """Replace characters which are illegal in directory names with ``_``.
+
+    ``getpass.getuser()`` may return a name containing characters which are
+    not allowed in directory names, for example the backslash in the domain
+    account name ``contoso\\john_doe`` returned on Windows (#8365).
+    """
+    return re.sub(r"[\W]", "_", user)
+
+
 def get_user() -> Optional[str]:
     """Return the current user name, or None if getuser() does not work
     in the current environment (see #1010)."""
