+def _pretty_fixture_name(fixturedef):
+    """Produce a pretty name for a fixturedef, with its scope.
+
+    This is used both for the fixture's name and for its docstring.
+    """
+    scope = fixturedef.scope
+    if scope == "function":
+        return fixturedef.argname
+    return "{} [{}]".format(fixturedef.argname, scope)
+
+
