+    def _maybe_visit_all_any(self, call):
+        """Unroll ``all``/``any`` calls over a comprehension, if possible.
+
+        Returns the result of visiting *call* if it is an ``all``/``any``
+        call taking a single comprehension, otherwise ``None`` so that the
+        caller falls back to the normal handling.
+        """
+        if not (
+            isinstance(call.func, ast.Name)
+            and call.func.id in ("all", "any")
+            and len(call.args) == 1
+            and not call.keywords
+        ):
+            return None
+        comp = call.args[0]
+        if not isinstance(comp, (ast.GeneratorExp, ast.ListComp, ast.SetComp)):
+            return None
+        # Unrolling is only implemented for a single ``for`` clause; more
+        # complex comprehensions are left to the default handling.
+        if len(comp.generators) != 1:
+            return None
+        if getattr(comp.generators[0], "is_async", 0):
+            return None
+        return self._unroll_all_any(call.func.id == "all", comp)
+
+    def _unroll_all_any(self, is_all, comp):
+        """Rewrite ``all``/``any`` over a comprehension into a loop.
+
+        This allows the failure report to point at the element which made
+        the call fail (``all``) or at the last examined element (``any``),
+        reusing the explanation of the element expression itself.
+        """
+        gen = comp.generators[0]
+        res_var = self.variable()
+        iter_var = self.variable()
+        seen_var = self.variable()
+        # Evaluate the iterable before initializing the target below, so that
+        # ``all(x for x in x)`` still iterates over the outer ``x``.
+        self.statements.append(ast.Assign([ast.Name(iter_var, ast.Store())], gen.iter))
+        self.statements.append(
+            ast.Assign([ast.Name(res_var, ast.Store())], _NameConstant(is_all))
+        )
+        self.statements.append(
+            ast.Assign([ast.Name(seen_var, ast.Store())], _NameConstant(False))
+        )
+
+        # Visit the element expression into a fresh statement list so that the
+        # generated assignments become part of the loop body.  A nested format
+        # context is used so that the element explanation can be selected at
+        # failure time (only when an element was actually examined).
+        outer_statements = self.statements
+        body = []
+        self.statements = body
+        before_variables = list(self.variables)
+        self.push_format_context()
+        elt_res, elt_expl = self.visit(comp.elt)
+        elt_format = self.pop_format_context(ast.Str(elt_expl))
+        new_variables = [n for n in self.variables if n not in before_variables]
+        self.statements = outer_statements
+
+        body.insert(
+            0, ast.Assign([ast.Name(seen_var, ast.Store())], _NameConstant(True))
+        )
+        decision = ast.UnaryOp(ast.Not(), elt_res) if is_all else elt_res
+        body.append(
+            ast.If(
+                decision,
+                [
+                    ast.Assign(
+                        [ast.Name(res_var, ast.Store())], _NameConstant(not is_all)
+                    ),
+                    ast.Break(),
+                ],
+                [],
+            )
+        )
+
+        # Initialize the temporary variables and the loop target so that the
+        # failure explanation can still be built for an empty iterable.
+        for name in new_variables:
+            self.statements.append(
+                ast.Assign([ast.Name(name, ast.Store())], _NameConstant(None))
+            )
+        for name in _target_names(gen.target):
+            self.statements.append(
+                ast.Assign([ast.Name(name, ast.Store())], _NameConstant(None))
+            )
+
+        loop_body = list(body)
+        for cond in reversed(gen.ifs):
+            loop_body = [ast.If(cond, loop_body, [])]
+        self.statements.append(
+            ast.For(gen.target, ast.Name(iter_var, ast.Load()), loop_body, [])
+        )
+        explanation = self.explanation_param(
+            ast.IfExp(ast.Name(seen_var, ast.Load()), elt_format, ast.Str("False"))
+        )
+        return ast.Name(res_var, ast.Load()), explanation
+
