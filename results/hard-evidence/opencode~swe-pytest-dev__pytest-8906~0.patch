diff --git a/doc/en/how-to/skipping.rst b/doc/en/how-to/skipping.rst
index 1565700..092eef7 100644
--- a/doc/en/how-to/skipping.rst
+++ b/doc/en/how-to/skipping.rst
@@ -74,6 +74,27 @@ It is also possible to skip the whole module using
     if not sys.platform.startswith("win"):
         pytest.skip("skipping windows-only tests", allow_module_level=True)
 
+This is also the recommended way to skip a test module which cannot even be
+imported on the current interpreter, for example because it uses syntax only
+available in newer Python versions:
+
+.. code-block:: python
+
+    import sys
+    import pytest
+
+    if sys.version_info < (3, 8):
+        pytest.skip("Requires Python >= 3.8", allow_module_level=True)
+
+    # The module is not imported on older Python versions,
+    # so the rest of the file may use newer syntax.
+    from pos_only import foo
+
+Note that the ``pytestmark = pytest.mark.skip(...)`` and
+``pytestmark = pytest.mark.skipif(...)`` alternatives are not suitable in this
+case, because the module is still imported (and thus must be parseable) before
+the marker is evaluated.
+
 
 **Reference**: :ref:`pytest.mark.skip ref`
 
