+class EnvTest(unittest.TestCase):
+    def test_nested_and_case_insensitive(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 2.5)
+
+    def test_key_names_lowercased(self):
+        cfg = load(env={"SHOPD__Db__Host": "db.internal"})
+        self.assertEqual(cfg["db"]["host"], "db.internal")
+
+    def test_other_variables_ignored(self):
+        cfg = load(env={"PATH": "/bin", "SHOP": "x"})
+        self.assertEqual(cfg, load(env={}))
+
+    def test_strings(self):
+        cfg = load(env={"SHOPD__NAME": "api", "SHOPD__LOG__LEVEL": "debug"})
+        self.assertEqual(cfg["name"], "api")
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_int(self):
+        cfg = load(env={"SHOPD__DB__PORT": "6543"})
+        self.assertEqual(cfg["db"]["port"], 6543)
+
+    def test_float(self):
+        cfg = load(env={"SHOPD__DB__POOL__TIMEOUT": "9.5"})
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 9.5)
+
+    def test_bool_true_values(self):
+        for raw in ["1", "true", "TRUE", "Yes", "on"]:
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True, raw)
+
+    def test_bool_false_values(self):
+        for raw in ["0", "false", "No", "OFF"]:
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False, raw)
+
+    def test_list(self):
+        cfg = load(env={"SHOPD__FEATURES": "search, cache ,metrics"})
+        self.assertEqual(cfg["features"], ["search", "cache", "metrics"])
+
+    def test_list_empty_string(self):
+        cfg = load(env={"SHOPD__FEATURES": ""})
+        self.assertEqual(cfg["features"], [])
+
+    def test_unknown_setting(self):
+        with self.assertRaises(ConfigError) as cm:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(cm.exception))
+
+    def test_bad_int(self):
