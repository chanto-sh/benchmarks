+class CliTest(unittest.TestCase):
+    def _env(self, **extra):
+        env = {k: v for k, v in os.environ.items() if not k.startswith("SHOPD__")}
+        env.update(extra)
+        return env
+
+    def _run(self, *args, **kwargs):
+        return subprocess.run(
+            [sys.executable, "-m", "app.config", *args],
+            capture_output=True,
+            text=True,
+            env=self._env(**kwargs),
+        )
+
+    def test_cli_set(self):
+        p = self._run("--set", "db.port=6543")
+        self.assertEqual(p.returncode, 0, p.stderr)
+        self.assertEqual(json.loads(p.stdout)["db"]["port"], 6543)
+
+    def test_cli_repeatable_set(self):
+        p = self._run("--set", "db.port=6543", "--set", "features=a,b")
+        self.assertEqual(p.returncode, 0, p.stderr)
+        cfg = json.loads(p.stdout)
+        self.assertEqual(cfg["db"]["port"], 6543)
+        self.assertEqual(cfg["features"], ["a", "b"])
+
+    def test_cli_env(self):
+        p = self._run(SHOPD__DB__PORT="9999")
+        self.assertEqual(p.returncode, 0, p.stderr)
+        self.assertEqual(json.loads(p.stdout)["db"]["port"], 9999)
+
+    def test_cli_error_exits_2(self):
