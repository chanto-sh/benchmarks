 import json
+import os
 
 from .defaults import DEFAULTS
 from .errors import ConfigError
 from .merge import deep_merge
 
+ENV_PREFIX = "SHOPD__"
+
+
+def load(path=None, env=None, overrides=()):
+    """Effective configuration.
+
+    Layers, lowest priority first: built-in defaults, the JSON file at `path`
+    (if any), the environment mapping `env` (defaulting to ``os.environ``), and
+    `overrides`, a sequence of ``"name=value"`` strings.
+    """
+    if env is None:
+        env = os.environ
 
-def load(path=None):
-    """Effective configuration: the defaults, then the JSON file at `path` (if any)."""
     cfg = DEFAULTS
     if path:
-        try:
-            with open(path) as f:
-                data = json.load(f)
-        except (OSError, ValueError) as e:
-            raise ConfigError(f"cannot read {path}: {e}") from e
-        if not isinstance(data, dict):
-            raise ConfigError(f"{path}: top level must be an object")
-        cfg = deep_merge(cfg, data)
+        cfg = deep_merge(cfg, _read_file(path))
+    cfg = deep_merge(cfg, _env_tree(env))
+    cfg = deep_merge(cfg, _overrides_tree(overrides))
     return deep_merge(cfg, {})
+
+
+def _read_file(path):
+    try:
+        with open(path) as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        raise ConfigError(f"cannot read {path}: {e}") from e
+    if not isinstance(data, dict):
+        raise ConfigError(f"{path}: top level must be an object")
+    return data
+
+
+def _env_tree(env):
+    """Build a nested settings dict from ``SHOPD__A__B=value`` variables."""
+    tree = {}
+    for name, value in env.items():
+        if not name.startswith(ENV_PREFIX):
+            continue
+        rest = name[len(ENV_PREFIX):]
+        if not rest:
+            continue
+        dotted = ".".join(part.lower() for part in rest.split("__"))
+        _set(tree, dotted, _coerce(dotted, value))
+    return tree
+
+
+def _overrides_tree(overrides):
+    """Build a nested settings dict from ``"a.b=value"`` strings."""
+    tree = {}
+    for spec in overrides:
+        if "=" not in spec:
+            raise ConfigError(f"invalid override {spec!r}: expected name=value")
+        name, _, value = spec.partition("=")
+        dotted = name.strip().lower()
+        _set(tree, dotted, _coerce(dotted, value))
+    return tree
+
+
+def _set(tree, dotted, value):
+    node = tree
+    parts = dotted.split(".")
+    for part in parts[:-1]:
+        node = node.setdefault(part, {})
+    node[parts[-1]] = value
+
+
+def _coerce(dotted, raw):
+    """Convert the string `raw` to the type of the built-in default for `dotted`."""
+    default = _default_for(dotted)
+    if isinstance(default, bool):
+        low = raw.strip().lower()
+        if low in ("1", "true", "yes", "on"):
+            return True
+        if low in ("0", "false", "no", "off"):
+            return False
+        raise ConfigError(f"{dotted}: {raw!r} is not a boolean")
+    if isinstance(default, int):
+        try:
+            return int(raw)
+        except ValueError:
+            raise ConfigError(f"{dotted}: {raw!r} is not an integer") from None
+    if isinstance(default, float):
+        try:
+            return float(raw)
+        except ValueError:
+            raise ConfigError(f"{dotted}: {raw!r} is not a number") from None
+    if isinstance(default, str):
+        return raw
+    if isinstance(default, list):
+        return [item.strip() for item in raw.split(",") if item.strip()]
+    raise ConfigError(f"{dotted}: unsupported setting type")
+
+
+def _default_for(dotted):
+    node = DEFAULTS
+    for part in dotted.split("."):
+        if not isinstance(node, dict) or part not in node:
+            raise ConfigError(f"unknown setting: {dotted}")
+        node = node[part]
+    if isinstance(node, dict):
+        raise ConfigError(f"cannot set section {dotted!r}: set a specific setting")
+    return node
