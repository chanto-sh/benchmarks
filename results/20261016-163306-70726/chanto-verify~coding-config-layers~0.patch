+class EnvTest(unittest.TestCase):
+    def test_env_sets_nested_int(self):
+        cfg = load(env={"SHOPD__DB__POOL__SIZE": "20"})
+        self.assertEqual(cfg["db"]["pool"]["size"], 20)
+        self.assertIsInstance(cfg["db"]["pool"]["size"], int)
+
+    def test_env_key_case_insensitive(self):
+        self.assertEqual(load(env={"SHOPD__DB__PORT": "6543"})["db"]["port"], 6543)
+        self.assertEqual(load(env={"SHOPD__db__port": "6543"})["db"]["port"], 6543)
+
+    def test_env_bool(self):
+        for raw in ("1", "true", "TRUE", "yes", "On"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], True)
+        for raw in ("0", "false", "No", "off"):
+            self.assertIs(load(env={"SHOPD__DB__SSL": raw})["db"]["ssl"], False)
+
+    def test_env_float(self):
+        cfg = load(env={"SHOPD__DB__POOL__TIMEOUT": "7.5"})
+        self.assertEqual(cfg["db"]["pool"]["timeout"], 7.5)
+
+    def test_env_str(self):
+        self.assertEqual(load(env={"SHOPD__NAME": "other"})["name"], "other")
+
+    def test_env_list(self):
+        cfg = load(env={"SHOPD__FEATURES": "search, metrics , cache"})
+        self.assertEqual(cfg["features"], ["search", "metrics", "cache"])
+
+    def test_env_empty_list(self):
+        self.assertEqual(load(env={"SHOPD__FEATURES": ""})["features"], [])
+
+    def test_env_ignores_other_variables(self):
+        cfg = load(env={"PATH": "/bin", "OTHER": "1", "SHOPDX__DB__PORT": "1"})
+        self.assertEqual(cfg["db"]["port"], 5432)
+
+    def test_env_defaults_to_os_environ(self):
+        with mock.patch.dict(os.environ, {"SHOPD__LOG__LEVEL": "debug"}):
+            cfg = load()
+        self.assertEqual(cfg["log"]["level"], "debug")
+
+    def test_env_unknown_setting(self):
+        with self.assertRaises(ConfigError) as ctx:
+            load(env={"SHOPD__DB__PROT": "1"})
+        self.assertIn("db.prot", str(ctx.exception))
+
+    def test_env_section(self):
