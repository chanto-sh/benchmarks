diff --git a/nbody.py b/nbody.py
index 133b00d..83e1736 100644
--- a/nbody.py
+++ b/nbody.py
@@ -29,5 +29,35 @@ def energy(masses, positions, velocities, G=1.0):
 
 
 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses the kick-drift-kick (velocity Verlet) leapfrog scheme.  It is
+    symplectic and time-reversible, so the total energy oscillates within a
+    bounded envelope instead of drifting secularly over long runs, and the
+    symmetric pairwise forces conserve total momentum.
+
+    The inputs are not modified; fresh lists are returned.
+    """
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    acc = accelerations(masses, pos, G)
+    half = 0.5 * dt
+    for _ in range(steps):
+        # half kick: v += (dt/2) a(x)
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+        # drift: x += dt v
+        for i in range(n):
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        # recompute forces at the new positions
+        acc = accelerations(masses, pos, G)
+        # half kick: v += (dt/2) a(x_new)
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+
+    return pos, vel
diff --git a/test_nbody.py b/test_nbody.py
index 2a0b4a1..60615f3 100644
--- a/test_nbody.py
+++ b/test_nbody.py
@@ -17,6 +17,104 @@ class TestNBody(unittest.TestCase):
         for xy in p:
             self.assertAlmostEqual(math.hypot(*xy), 1.0, places=3)
 
+    # ---------- extra systems: energy, momentum, contract ----------
+
+    def _momentum(self, masses, velocities):
+        return (sum(m * v[0] for m, v in zip(masses, velocities)),
+                sum(m * v[1] for m, v in zip(masses, velocities)))
+
+    def test_momentum_conserved(self):
+        # figure-eight three-body: the three bodies start with zero net
+        # momentum, an invariant of the pairwise (equal and opposite) forces.
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753], [0.0, 0.0], [-0.97000436, 0.24308753]]
+        vel = [[0.466203685, 0.43236573], [-0.93240737, -0.86473146],
+               [0.466203685, 0.43236573]]
+        p0 = self._momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        p1 = self._momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-9)
+
+        # unequal masses carrying a net momentum: it must be carried unchanged.
+        m = [3.0, 1.0]
+        pos = [[-0.5, 0.0], [1.5, 0.1]]
+        vel = [[0.0, 0.3], [0.0, -0.9]]
+        p0 = self._momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.002, 20000)
+        p1 = self._momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-9)
+
+    def test_figure_eight_energy(self):
+        # a known periodic three-body solution; energy must be preserved too.
+        m = [1.0, 1.0, 1.0]
+        pos = [[0.97000436, -0.24308753], [0.0, 0.0], [-0.97000436, 0.24308753]]
+        vel = [[0.466203685, 0.43236573], [-0.93240737, -0.86473146],
+               [0.466203685, 0.43236573]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-5)
+
+    def test_elliptical_energy_conserved(self):
+        # eccentric (e = 0.6) two-body orbit, well clear of any close approach.
+        m = [1.0, 1.0]
+        pos = [[-0.4, 0.0], [0.4, 0.0]]
+        vel = [[0.0, -1.0], [0.0, 1.0]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.005, 40000)
+        self.assertLess(abs(energy(m, p, q) - e0) / abs(e0), 1e-3)
+
+    def test_energy_error_stays_bounded(self):
+        # A symplectic scheme has a bounded energy envelope rather than a
+        # secular drift: the worst error in the second half of a long run must
+        # be no worse than in the first half.
+        m = [1.0, 1.0]
+        pos = [[-0.4, 0.0], [0.4, 0.0]]
+        vel = [[0.0, -1.0], [0.0, 1.0]]
+        e0 = energy(m, pos, vel)
+        p, q = pos, vel
+        errs = []
+        for _ in range(24):
+            p, q = simulate(m, p, q, 0.005, 2500)
+            errs.append(abs(energy(m, p, q) - e0) / abs(e0))
+        half = len(errs) // 2
+        self.assertLess(max(errs), 1e-3)
+        self.assertLess(max(errs[half:]), 3.0 * max(errs[:half]) + 1e-9)
+
+    def test_timestep_refinement(self):
+        # error should shrink as the step size shrinks (second-order scheme).
+        m = [1.0, 1.0]
+        pos = [[-0.4, 0.0], [0.4, 0.0]]
+        vel = [[0.0, -1.0], [0.0, 1.0]]
+        e0 = energy(m, pos, vel)
+        p, q = simulate(m, pos, vel, 0.01, 40000)
+        coarse = abs(energy(m, p, q) - e0) / abs(e0)
+        p, q = simulate(m, pos, vel, 0.002, 40000)
+        fine = abs(energy(m, p, q) - e0) / abs(e0)
+        self.assertLess(fine, coarse / 4.0)
+
+    def test_single_particle_free_flight(self):
+        # no other body => no force => exact straight-line motion.
+        m = [2.5]
+        p, q = simulate(m, [[0.0, 0.0]], [[1.0, -0.5]], 0.01, 10000)
+        self.assertAlmostEqual(p[0][0], 100.0, places=9)
+        self.assertAlmostEqual(p[0][1], -50.0, places=9)
+        self.assertEqual(q, [[1.0, -0.5]])
+
+    def test_inputs_are_not_modified(self):
+        m = [1.0, 2.0]
+        pos = [[-1.0, 0.5], [2.0, -0.5]]
+        vel = [[0.1, 0.2], [-0.3, 0.4]]
+        pos0 = [list(xy) for xy in pos]
+        vel0 = [list(xy) for xy in vel]
+        p, q = simulate(m, pos, vel, 0.01, 1000)
+        self.assertEqual(pos, pos0)
+        self.assertEqual(vel, vel0)
+        self.assertIsNot(p, pos)
+        self.assertIsNot(q, vel)
+        # contract: lists of [x, y] pairs.
+        self.assertTrue(all(isinstance(xy, list) and len(xy) == 2 for xy in p))
+        self.assertTrue(all(isinstance(xy, list) and len(xy) == 2 for xy in q))
+
 
 if __name__ == "__main__":
     unittest.main()
