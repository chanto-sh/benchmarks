+import copy
 import math
 import unittest
 
 from nbody import energy, simulate
 
 
+def momentum(masses, velocities):
+    return [
+        sum(m * v[0] for m, v in zip(masses, velocities)),
+        sum(m * v[1] for m, v in zip(masses, velocities)),
+    ]
+
+
+def sample_relative_energy(masses, positions, velocities, dt, steps, every=100):
+    """Advance in chunks, returning relative energy deviations along the way.
+
+    A velocity-Verlet state is complete in (x, v), so re-entering ``simulate``
+    at a chunk boundary continues the very same trajectory as one long call.
+    """
+    pos = [list(p) for p in positions]
+    vel = [list(v) for v in velocities]
+    e0 = energy(masses, pos, vel)
+    devs = [0.0]
+    done = 0
+    while done < steps:
+        k = min(every, steps - done)
+        pos, vel = simulate(masses, pos, vel, dt, k)
+        done += k
+        devs.append((energy(masses, pos, vel) - e0) / abs(e0))
+    return devs
+
+
 class TestNBody(unittest.TestCase):
     def test_circular_two_body(self):
         # equal masses on a circular orbit about the origin
