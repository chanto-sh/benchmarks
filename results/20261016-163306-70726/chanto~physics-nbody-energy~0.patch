+    # figure-eight: a well-known periodic three-body choreography (G = m = 1)
+    FIG8_MASSES = [1.0, 1.0, 1.0]
+
+    def _figure_eight(self):
+        x, y = 0.97000436, -0.24308753
+        vx, vy = 0.93240737, 0.86473146
+        pos = [[x, y], [0.0, 0.0], [-x, -y]]
+        vel = [[vx / 2, vy / 2], [-vx, -vy], [vx / 2, vy / 2]]
+        return self.FIG8_MASSES, pos, vel
+
+    def test_eccentric_two_body_energy(self):
+        # unequal masses, zero total momentum, elliptical relative orbit
+        m = [1.0, 2.0]
+        pos = [[-1.0, 0.0], [1.0, 0.0]]
+        vel = [[0.0, 1.0], [0.0, -0.5]]
+        devs = sample_relative_energy(m, pos, vel, 0.002, 40000, every=200)
+        self.assertLess(max(abs(d) for d in devs), 1e-5)
+
+    def test_energy_is_bounded_and_does_not_drift(self):
+        # A symplectic integrator keeps the energy error bounded: extending the
+        # run must not inflate it.  A drifting scheme would show ~4x when the
+        # number of steps is quadrupled.
+        m, pos, vel = self._figure_eight()
+        short = max(abs(d) for d in sample_relative_energy(m, pos, vel, 0.002, 10000))
+        long = max(abs(d) for d in sample_relative_energy(m, pos, vel, 0.002, 40000))
+        self.assertLess(long, 1e-4)
+        self.assertLess(long, 2.0 * short)
+
+    def test_second_order_convergence(self):
+        # Halving dt should shrink the energy error by ~4x.
+        m, pos, vel = self._figure_eight()
+        coarse = max(abs(d) for d in sample_relative_energy(m, pos, vel, 0.004, 2500))
+        fine = max(abs(d) for d in sample_relative_energy(m, pos, vel, 0.002, 5000))
+        self.assertLess(coarse, 5.0 * fine)
+        self.assertGreater(coarse, 1.5 * fine)
+
+    def test_momentum_conserved(self):
+        m = [1.0, 2.0, 0.5, 1.5]
+        pos = [[0.0, 0.0], [4.0, 1.0], [-3.0, 3.0], [0.0, -5.0]]
+        vel = [[0.0, 0.2], [-0.05, -0.02], [0.1, -0.05], [0.0, 0.1]]
+        p0 = momentum(m, vel)
+        p, q = simulate(m, pos, vel, 0.001, 20000)
+        p1 = momentum(m, q)
+        self.assertLess(math.hypot(p1[0] - p0[0], p1[1] - p0[1]), 1e-9)
+
+    def test_planetary_system(self):
+        # heavy central star + light planets on near-circular orbits
+        star = 1.0
+        radii = [1.0, 1.6, 2.4, 3.5]
+        m = [star] + [1e-3] * len(radii)
+        pos = [[0.0, 0.0]]
+        vel = [[0.0, 0.0]]
+        for i, r in enumerate(radii):
+            a = 0.7 * i
+            vc = math.sqrt(star / r)
+            pos.append([r * math.cos(a), r * math.sin(a)])
+            vel.append([-vc * math.sin(a), vc * math.cos(a)])
+        devs = sample_relative_energy(m, pos, vel, 0.002, 60000, every=500)
+        self.assertLess(max(abs(d) for d in devs), 1e-5)
