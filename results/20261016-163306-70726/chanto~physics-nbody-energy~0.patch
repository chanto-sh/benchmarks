 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses the kick-drift-kick (velocity Verlet) leapfrog scheme, which is
+    symplectic: the energy error stays bounded and does not drift secularly,
+    however long the run.  Because the pair forces are equal and opposite,
+    total momentum is conserved to round-off.
+
+    The input sequences are left untouched; fresh lists are returned.
+    """
+    masses = list(masses)
+    n = len(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    acc = accelerations(masses, pos, G)
+    half = 0.5 * dt
+    for _ in range(steps):
+        # half kick with the acceleration at the current position
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+        # drift
+        for i in range(n):
+            pos[i][0] += dt * vel[i][0]
+            pos[i][1] += dt * vel[i][1]
+        # full kick from the acceleration at the new position
+        acc = accelerations(masses, pos, G)
+        for i in range(n):
+            vel[i][0] += half * acc[i][0]
+            vel[i][1] += half * acc[i][1]
+    return pos, vel
