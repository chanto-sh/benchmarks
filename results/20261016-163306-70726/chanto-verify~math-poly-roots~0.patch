@@ -9,24 +11,175 @@ def evaluate(coeffs, x):
     return y
 
 
+# Polynomials are represented as lists of coefficients, highest degree first.
+# All of the internal arithmetic uses Fraction so the Sturm sequence (and the
+# sign variations derived from it) are computed exactly -- no numerical
+# tolerances are involved until a root has already been isolated.
+
+# Width a bracketing interval is refined to before the root is returned.  This
+# is comfortably below the requested 1e-9 accuracy.
+_TOL = Fraction(1, 10 ** 12)
+
+
+def _trim(p):
+    """Drop leading zero coefficients."""
+    i = 0
+    n = len(p)
+    while i < n and p[i] == 0:
+        i += 1
+    return p[i:]
+
+
+def _deriv(p):
+    """Formal derivative of ``p``."""
+    n = len(p) - 1
+    if n < 1:
+        return []
+    return [p[i] * (n - i) for i in range(n)]
+
+
+def _poly_eval(p, x):
+    y = Fraction(0)
+    for c in p:
+        y = y * x + c
+    return y
+
+
+def _divmod(a, b):
+    """Polynomial division over the rationals; returns (quotient, remainder)."""
+    a = _trim(a)
+    b = _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = a[:]
+    db = len(b)
+    while len(r) >= db:
+        shift = len(r) - db
+        coef = r[0] / b[0]
+        q[len(q) - 1 - shift] = coef
+        for i in range(db):
+            r[i] -= coef * b[i]
+        r = r[1:]
+    return q, _trim(r)
+
+
+def _gcd(a, b):
+    a, b = _trim(a), _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, _trim(r)
+    return a
+
+
+def _square_free(p):
+    """Square-free part p / gcd(p, p'): same real roots, all simple."""
+    p = _trim(p)
+    if len(p) <= 1:
+        return p
+    d = _deriv(p)
+    if not d:
+        return p
+    g = _gcd(p, d)
+    if len(g) <= 1:
+        return p
+    q, _ = _divmod(p, g)
+    return _trim(q)
+
+
+def _sturm_chain(p):
+    """Sturm sequence for the square-free polynomial ``p``."""
+    p = _trim(p)
+    chain = [p]
+    d = _trim(_deriv(p))
+    if d:
+        chain.append(d)
+    while len(chain) >= 2:
+        _, r = _divmod(chain[-2], chain[-1])
+        r = _trim(r)
+        if not r:
+            break
+        chain.append([-c for c in r])
+    return chain
+
+
+def _sign_variations(chain, x):
+    """Number of sign changes in the Sturm sequence evaluated at ``x``."""
+    last = 0
+    count = 0
+    for poly in chain:
+        v = _poly_eval(poly, x)
+        s = 1 if v > 0 else (-1 if v < 0 else 0)
+        if s == 0:
+            continue
+        if last and s != last:
+            count += 1
+        last = s
+    return count
+
+
+def _isolate(a, b, variations, out):
+    """Append the roots of a square-free polynomial lying in the half-open
+    interval ``(a, b]`` to ``out``.
+
+    ``variations(x)`` returns the Sturm sign-variation count at ``x``; by
+    Sturm's theorem ``variations(a) - variations(b)`` is exactly the number of
+    distinct real roots in ``(a, b]``.
+    """
+    count = variations(a) - variations(b)
+    if count == 0:
+        return
+    if count == 1:
+        # A single root: shrink the bracket, evaluating the exact Sturm count
+        # so this works even when the root sits exactly on an endpoint.
+        while b - a > _TOL:
+            m = (a + b) / 2
+            if variations(a) - variations(m) >= 1:
+                b = m
+            else:
+                a = m
+        out.append((a + b) / 2)
+        return
+    # More than one root: split and recurse until each is separated.
+    m = (a + b) / 2
+    _isolate(a, m, variations, out)
+    _isolate(m, b, variations, out)
+
+
 def real_roots(coeffs, lo, hi):
     """Sorted distinct real roots of the polynomial in [lo, hi], to 1e-9.
 
     coeffs: integer coefficients, highest degree first (not all zero).
+    lo, hi: ints or fractions.Fraction; the interval is inclusive.
     """
-    n = 1000
+    p = _trim([Fraction(c) for c in coeffs])
+    if len(p) <= 1:
+        return []
+
+    lo, hi = Fraction(lo), Fraction(hi)
+    if lo > hi:
+        return []
+
+    # Repeated roots do not change the sign of the polynomial, which is why a
+    # bare grid/bisection search misses them; reduce to the square-free part
+    # (every distinct root once, all simple) before applying Sturm's theorem.
+    q = _square_free(p)
+    chain = _sturm_chain(q)
+
+    def variations(x):
+        return _sign_variations(chain, x)
+
     roots = []
-    step = (hi - lo) / n
-    for i in range(n):
-        a, b = lo + i * step, lo + (i + 1) * step
-        fa, fb = evaluate(coeffs, a), evaluate(coeffs, b)
-        if fa * fb < 0:
-            for _ in range(100):
-                m = (a + b) / 2
-                fm = evaluate(coeffs, m)
-                if fa * fm <= 0:
-                    b, fb = m, fm
-                else:
-                    a, fa = m, fm
-            roots.append((a + b) / 2)
-    return roots
+
+    # The requested interval is closed, but Sturm counting works on (a, b].
+    # Handle the left endpoint explicitly so a root sitting on it survives.
+    if _poly_eval(q, lo) == 0:
+        roots.append(lo)
+
+    if lo < hi:
+        _isolate(lo, hi, variations, roots)
+
+    roots.sort()
+    return [float(r) for r in roots]
diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..74fac60 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -20,6 +20,48 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_repeated_root_only(self):
+        # (x - 2)^2 = x^2 - 4x + 4 does not change sign at the root.
+        self.assertRoots(real_roots([1, -4, 4], 0, 3), [2])
+
+    def test_triple_root(self):
+        # (x - 1)^3 = x^3 - 3x^2 + 3x - 1 (root at an endpoint).
+        self.assertRoots(real_roots([1, -3, 3, -1], 1, 4), [1])
+
+    def test_two_close_roots(self):
+        # N x^2 - (2N + 1) x + (N + 1) roots: 1 and 1 + 1/N.
+        n = 10 ** 7
+        coeffs = [n, -(2 * n + 1), n + 1]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1.0 / n])
+
+    def test_root_on_left_boundary(self):
+        # x - 1, with the root exactly on lo.
+        self.assertRoots(real_roots([1, -1], 1, 5), [1])
+
+    def test_root_on_right_boundary(self):
+        # x - 1, with the root exactly on hi.
+        self.assertRoots(real_roots([1, -1], -5, 1), [1])
+
+    def test_root_at_degenerate_interval(self):
+        # lo == hi exactly at the root.
+        self.assertRoots(real_roots([1, -1], 1, 1), [1])
+        self.assertEqual(real_roots([1, -1], 0, 0), [])
+
+    def test_many_roots_degree_15(self):
+        # (x - 1)(x - 2)...(x - 15); all 15 roots are distinct integers.
+        coeffs = [1]
+        for k in range(1, 16):
+            nxt = [0] * (len(coeffs) + 1)
+            for i, c in enumerate(coeffs):
+                nxt[i] += c
+                nxt[i + 1] -= k * c
+            coeffs = nxt
+        self.assertRoots(real_roots(coeffs, -1, 20), list(range(1, 16)))
+
 
 if __name__ == "__main__":
     unittest.main()
