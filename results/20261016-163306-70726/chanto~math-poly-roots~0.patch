+def _sturm_sequence(p):
+    """Sturm chain for a square-free polynomial p.
+
+    Each term is normalised to primitive integers, which keeps coefficient
+    growth under control without changing any sign variation.
+    """
+    p = _primitive(p)
+    seq = [p]
+    d = _deriv(p)
+    if not d:
+        return seq
+    seq.append(_primitive(d))
+    while seq[-1]:
+        _, r = _divmod(seq[-2], seq[-1])
+        r = _trim(r)
+        if not r:
+            break
+        seq.append(_primitive([-c for c in r]))
+    return seq
+
+
+def _eval(p, x):
+    y = Fraction(0)
+    for c in p:
+        y = y * x + c
+    return y
