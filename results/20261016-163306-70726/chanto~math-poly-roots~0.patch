diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..ed8fea1 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -1,5 +1,6 @@
 import math
 import unittest
+from fractions import Fraction
 
 from roots import real_roots
 
@@ -20,6 +21,44 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4; the double root has no sign change.
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_only_a_double_root(self):
+        # (x - 2)^2 = x^2 - 4x + 4 touches the axis without crossing it.
+        self.assertRoots(real_roots([1, -4, 4], 0, 5), [2])
+
+    def test_triple_root(self):
+        # (x - 1)^3 = x^3 - 3x^2 + 3x - 1
+        self.assertRoots(real_roots([1, -3, 3, -1], 0, 5), [1])
+
+    def test_close_roots_in_one_cell(self):
+        # (x - 1)(1000x - 1001): roots 1 and 1.001 are closer than any grid step.
+        self.assertRoots(real_roots([1000, -2001, 1001], 0, 3), [1.0, 1.001])
+
+    def test_root_on_lower_boundary(self):
+        self.assertRoots(real_roots([1, -1], 1, 5), [1])
+
+    def test_root_on_upper_boundary(self):
+        self.assertRoots(real_roots([1, -1], -5, 1), [1])
+
+    def test_fraction_bounds(self):
+        # x^2 - 2 over [1, 3/2] must still find sqrt(2).
+        self.assertRoots(real_roots([1, 0, -2], Fraction(1), Fraction(3, 2)),
+                         [math.sqrt(2)])
+
+    def test_degree_fifteen(self):
+        # (x - 1)(x - 2)...(x - 15), the largest coefficients are ~15!.
+        poly = [1]
+        for r in range(1, 16):
+            new = [0] * (len(poly) + 1)
+            for i, c in enumerate(poly):
+                new[i] += c
+                new[i + 1] -= c * r
+            poly = new
+        self.assertRoots(real_roots(poly, 0, 20), list(range(1, 16)))
+
 
 if __name__ == "__main__":
     unittest.main()
