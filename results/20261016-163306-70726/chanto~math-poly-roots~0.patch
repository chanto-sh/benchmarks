+# ---------------------------------------------------------------------------
+# Polynomial helpers.  Coefficients are kept highest-degree-first and are
+# converted to Fraction internally so that every division below is exact.
+# ---------------------------------------------------------------------------
+
+def _trim(p):
+    """Drop leading zero coefficients."""
+    i = 0
+    n = len(p)
+    while i < n and p[i] == 0:
+        i += 1
+    return list(p[i:])
+
+
+def _to_fraction(p):
+    return [Fraction(c) for c in p]
+
+
+def _deriv(p):
+    """Formal derivative of an integer coefficient polynomial."""
+    p = _trim(p)
+    degree = len(p) - 1
+    return _trim([p[i] * (degree - i) for i in range(degree)])
+
+
+def _primitive(p):
+    """Scale a rational polynomial to primitive integer coefficients.
+
+    The scale factor is always positive, so the signs of the coefficients (and
+    therefore every sign variation used by Sturm's theorem) are unchanged.
+    """
+    p = _trim(_to_fraction(p))
+    if not p:
+        return []
+    den = 1
+    for c in p:
+        den = den * c.denominator // math.gcd(den, c.denominator)
+    ints = [int(c * den) for c in p]
+    g = 0
+    for c in ints:
+        g = math.gcd(g, abs(c))
+    if g > 1:
+        ints = [c // g for c in ints]
+    return ints
+
+
+def _divmod(a, b):
+    """Exact polynomial division: returns (quotient, remainder)."""
+    a = _trim(_to_fraction(a))
+    b = _trim(_to_fraction(b))
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [Fraction(0)], a
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = a[:]
+    db = len(b) - 1
+    lcb = b[0]
+    while len(r) >= len(b):
+        d = len(r) - 1 - db
+        coef = r[0] / lcb
+        q[len(q) - 1 - d] = coef
+        for i in range(len(b)):
+            r[i] -= coef * b[i]
+        r = _trim(r)
+    return _trim(q), r
+
+
+def _gcd(a, b):
+    """Monic-ish gcd over Q, returned as a primitive integer polynomial."""
+    a = _trim(_to_fraction(a))
+    b = _trim(_to_fraction(b))
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    return _primitive(a)
+
+
+def _squarefree(p):
+    """Square-free part p / gcd(p, p').
+
+    Has exactly the same distinct real roots as p, but every root is simple,
+    which is what Sturm's theorem requires.
+    """
+    p = _primitive(p)
+    if len(p) <= 1:
+        return p
+    dp = _deriv(p)
+    if not dp:
+        return p
+    g = _gcd(p, dp)
+    q, _ = _divmod(p, g)
+    return _primitive(q)
+
+
+# ---------------------------------------------------------------------------
+# Sturm sequences and exact root counting.
+# ---------------------------------------------------------------------------
