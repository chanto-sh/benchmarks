--- a/notes/fmt.py
+++ b/notes/fmt.py
@@ -1,11 +1,20 @@
+def _tags(tags):
+    return " ".join("#" + t for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    out = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        out += "  " + _tags(note.tags)
+    return out
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_tags(note.tags)}")
     if note.body:
         out += ["", note.body]
     return "\n".join(out)
diff --git a/notes/model.py b/notes/model.py
index 3750b6b..cd3087e 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,24 @@
-from dataclasses import asdict, dataclass
+from dataclasses import asdict, dataclass, field
+
+
+class InvalidTag(ValueError):
+    """Raised when a tag is empty or contains a forbidden character."""
+
+
+def normalize_tags(tags):
+    """Trim, lowercase and de-duplicate tags, keeping first-seen order.
+
+    Raises InvalidTag (naming the offending tag) if a tag is empty after
+    trimming or contains whitespace, a comma or a '#'.
+    """
+    out = []
+    for tag in tags:
+        t = tag.strip().lower()
+        if not t or any(c.isspace() for c in t) or "," in t or "#" in t:
+            raise InvalidTag(tag)
+        if t not in out:
+            out.append(t)
+    return out
 
 
 @dataclass
@@ -6,10 +26,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags") or []),
+        )
