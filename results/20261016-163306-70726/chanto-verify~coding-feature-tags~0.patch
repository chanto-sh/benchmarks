+class TagTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.db = os.path.join(self.dir.name, "notes.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.db) as f:
+            return f.read()
+
+    def test_add_normalizes_tags(self):
+        code, out, _ = run(self.db, "add", "Buy milk", "--tag", "home",
+                           "--tag", "Errands", "--tag", " HOME ")
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "added #1\n")
+        self.assertEqual(json.loads(self.read())["notes"][0]["tags"], ["home", "errands"])
+
+    def test_invalid_tag_saves_nothing(self):
+        for bad in ["bad tag", "a,b", "#nope", "   ", ""]:
+            code, out, err = run(self.db, "add", "x", "--tag", bad)
+            self.assertEqual(code, 2, bad)
+            self.assertEqual(out, "")
+            self.assertIn(bad, err)
+            self.assertFalse(os.path.exists(self.db), bad)
+
+    def test_list_shows_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list")[1],
+            "  1  Buy milk  #home #errands\n  2  Plain\n",
+        )
+
+    def test_list_filters(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "home")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "list", "--tag", "HOME")[1],
+            "  1  Buy milk  #home #errands\n  2  Call mom  #home\n",
+        )
+        self.assertEqual(
+            run(self.db, "list", "--tag", "home", "--tag", "errands")[1],
+            "  1  Buy milk  #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_show_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Plain")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Buy milk\ntags: #home #errands\n",
+        )
+        self.assertEqual(run(self.db, "show", "2")[1], "#2 Plain\n")
+
+    def test_show_tags_above_body(self):
+        run(self.db, "add", "Buy milk", "--body", "2%", "--tag", "home")
+        self.assertEqual(
+            run(self.db, "show", "1")[1],
+            "#1 Buy milk\ntags: #home\n\n2%\n",
+        )
+
+    def test_tags_command(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "zebra")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "apple")
+        run(self.db, "add", "c")
+        self.assertEqual(
+            run(self.db, "tags")[1],
+            "home 2\napple 1\nzebra 1\n",
