@@ -35,6 +35,32 @@ class Store:
                 return n
         raise NotFound(note_id)
 
+    def tag(self, note_id, tags):
+        normalized = normalize_tags(tags)
+        note = self.get(note_id)
+        for t in normalized:
+            if t not in note.tags:
+                note.tags.append(t)
+        return note
+
+    def untag(self, note_id, tags):
+        normalized = normalize_tags(tags)
+        note = self.get(note_id)
+        note.tags = [t for t in note.tags if t not in normalized]
+        return note
+
+    def tagged(self, tags):
+        wanted = normalize_tags(tags)
+        return [n for n in self.notes if all(t in n.tags for t in wanted)]
+
+    def counts(self):
+        """Tags in use as (name, count) pairs, most used first, ties alphabetical."""
+        counts = {}
+        for n in self.notes:
+            for t in n.tags:
+                counts[t] = counts.get(t, 0) + 1
+        return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+
     def delete(self, note_id):
         self.notes.remove(self.get(note_id))
 
