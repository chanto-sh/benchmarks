+def _hashtags(tags):
+    return " ".join(f"#{t}" for t in tags)
+
+
 def line(note):
     """One row of `notes list`."""
-    return f"{note.id:>3}  {note.title}"
+    row = f"{note.id:>3}  {note.title}"
+    if note.tags:
+        row += "  " + _hashtags(note.tags)
+    return row
 
 
 def detail(note):
     """`notes show` output."""
     out = [f"#{note.id} {note.title}"]
+    if note.tags:
+        out.append(f"tags: {_hashtags(note.tags)}")
