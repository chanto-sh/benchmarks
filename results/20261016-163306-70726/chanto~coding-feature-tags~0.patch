@@ -41,6 +41,72 @@ class NotesTest(unittest.TestCase):
         data = json.load(open(self.db))
         self.assertEqual(data["notes"][0]["title"], "x")
 
+    def test_add_normalizes_tags(self):
+        run(self.db, "add", "Buy milk", "--tag", " Home ", "--tag", "Errands", "--tag", "home")
+        data = json.load(open(self.db))
+        self.assertEqual(data["version"], 2)
+        self.assertEqual(data["notes"][0]["tags"], ["home", "errands"])
+        self.assertEqual(run(self.db, "show", "1")[1], "#1 Buy milk\ntags: #home #errands\n")
+
+    def test_add_without_tags_has_empty_list(self):
+        run(self.db, "add", "x")
+        self.assertEqual(json.load(open(self.db))["notes"][0]["tags"], [])
+        self.assertEqual(run(self.db, "list")[1], "  1  x\n")
+
+    def test_invalid_tag(self):
+        for bad in ("", "   ", "two words", "a,b", "a#b"):
+            with self.subTest(bad=bad):
+                code, out, err = run(self.db, "add", "x", "--tag", bad)
+                self.assertEqual(code, 2)
+                self.assertEqual(out, "")
+                self.assertIn(bad, err)
+                self.assertFalse(os.path.exists(self.db))
+
+    def test_list_filters_by_tag(self):
+        run(self.db, "add", "Buy milk", "--tag", "home", "--tag", "errands")
+        run(self.db, "add", "Call mom", "--tag", "HOME")
+        run(self.db, "add", "Read book")
+        self.assertEqual(run(self.db, "list")[1],
+                         "  1  Buy milk  #home #errands\n  2  Call mom  #home\n  3  Read book\n")
+        self.assertEqual(run(self.db, "list", "--tag", "Home")[1],
+                         "  1  Buy milk  #home #errands\n  2  Call mom  #home\n")
+        self.assertEqual(run(self.db, "list", "--tag", "home", "--tag", "errands")[1],
+                         "  1  Buy milk  #home #errands\n")
+        self.assertEqual(run(self.db, "list", "--tag", "nope")[1], "")
+
+    def test_tags_command(self):
+        run(self.db, "add", "a", "--tag", "home", "--tag", "zeta")
+        run(self.db, "add", "b", "--tag", "home", "--tag", "alpha")
+        run(self.db, "add", "c", "--tag", "alpha")
+        self.assertEqual(run(self.db, "tags")[1], "alpha 2\nhome 2\nzeta 1\n")
+        self.assertEqual(run(self.db, "tags")[0], 0)
+
+    def test_tag_and_untag(self):
