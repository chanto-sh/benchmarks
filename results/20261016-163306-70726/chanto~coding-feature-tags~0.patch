diff --git a/notes/model.py b/notes/model.py
index 3750b6b..cca91c5 100644
--- a/notes/model.py
+++ b/notes/model.py
@@ -1,4 +1,35 @@
-from dataclasses import asdict, dataclass
+import re
+from dataclasses import asdict, dataclass, field
+
+_TAG_WHITESPACE = re.compile(r"\s")
+
+
+class InvalidTag(ValueError):
+    """A user-supplied tag is empty or contains a forbidden character."""
+
+
+def normalize_tags(raw):
+    """Lowercase/trim tags, drop duplicates, keep first-seen order.
+
+    Raises InvalidTag naming the first offending tag.
+    """
+    tags = []
+    for item in raw:
+        tag = item.strip().lower()
+        if not tag or _TAG_WHITESPACE.search(tag) or "," in tag or "#" in tag:
+            raise InvalidTag(item)
+        if tag not in tags:
+            tags.append(tag)
+    return tags
+
+
+def tag_counts(notes):
+    """(tag, count) pairs, most used first, ties alphabetically."""
+    counts = {}
+    for note in notes:
+        for tag in note.tags:
+            counts[tag] = counts.get(tag, 0) + 1
+    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
 
 
 @dataclass
@@ -6,10 +37,16 @@ class Note:
     id: int
     title: str
     body: str = ""
+    tags: list = field(default_factory=list)
 
     def to_dict(self):
         return asdict(self)
 
     @classmethod
     def from_dict(cls, d):
-        return cls(id=d["id"], title=d["title"], body=d.get("body", ""))
+        return cls(
+            id=d["id"],
+            title=d["title"],
+            body=d.get("body", ""),
+            tags=list(d.get("tags", [])),
+        )
