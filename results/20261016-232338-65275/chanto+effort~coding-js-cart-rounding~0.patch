diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..84f7760
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,82 @@
+// Exact decimal helpers. A decimal is { n, s } and means n / 10^s.
+// Money is kept in integer cents wherever the README asks for rounding, so
+// binary floating point never decides a cent.
+
+function parseDecimal(value) {
+  if (typeof value === "bigint") return { n: value, s: 0 };
+
+  let str;
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new TypeError(`invalid decimal: ${value}`);
+    str = String(value);
+  } else if (typeof value === "string") {
+    str = value.trim();
+  } else {
+    throw new TypeError(`invalid decimal: ${value}`);
+  }
+
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(str);
+  const intPart = match && match[2];
+  const fracPart = (match && match[3]) || "";
+  if (!match || (!intPart && !fracPart)) throw new TypeError(`invalid decimal: ${value}`);
+
+  let n = BigInt((intPart || "") + fracPart || "0");
+  if (match[1] === "-") n = -n;
+
+  let s = fracPart.length - (match[4] ? Number(match[4]) : 0);
+  if (s < 0) {
+    n *= 10n ** BigInt(-s);
+    s = 0;
+  }
+  return { n, s };
+}
+
+function add(a, b) {
+  const s = Math.max(a.s, b.s);
+  return {
+    n: a.n * 10n ** BigInt(s - a.s) + b.n * 10n ** BigInt(s - b.s),
+    s,
+  };
+}
+
+function sub(a, b) {
+  const s = Math.max(a.s, b.s);
+  return {
+    n: a.n * 10n ** BigInt(s - a.s) - b.n * 10n ** BigInt(s - b.s),
+    s,
+  };
+}
+
+function fromCents(cents) {
+  return { n: cents, s: 2 };
+}
+
+// Round n / d to the nearest integer, ties away from zero (half up).
+function roundHalfUpDiv(n, d) {
+  const negative = n < 0n;
+  const abs = negative ? -n : n;
+  const quotient = abs / d;
+  const remainder = abs % d;
+  const rounded = remainder * 2n >= d ? quotient + 1n : quotient;
+  return negative ? -rounded : rounded;
+}
+
+// Round the decimal to whole cents.
+function toCents(amount) {
+  return roundHalfUpDiv(amount.n * 100n, 10n ** BigInt(amount.s));
+}
+
+// `pct` percent of `amount`, rounded to cents (half up).
+function percentOf(amount, pct) {
+  return roundHalfUpDiv(amount.n * pct.n, 10n ** BigInt(amount.s + pct.s));
+}
+
+module.exports = {
+  parseDecimal,
+  add,
+  sub,
+  fromCents,
+  roundHalfUpDiv,
+  toCents,
+  percentOf,
+};
