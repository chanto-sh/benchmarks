index 0000000..228b81c
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,48 @@
+// Exact decimal money helpers. Amounts are integer cents (BigInt); percentages
+// are parsed from their decimal representation so e.g. 8.25 is exactly 8.25%.
+
+// Parse a decimal value (string or number) as sign * units / 10^scale.
+function parseDecimal(value) {
+  const text = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(text);
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`Invalid decimal value: ${value}`);
+  }
+
+  const sign = match[1] === "-" ? -1n : 1n;
+  const whole = match[2] || "";
+  const fraction = match[3] || "";
+  const exponent = match[4] ? Number(match[4]) : 0;
+
+  let digits = whole + fraction;
+  let scale = fraction.length - exponent;
+  if (scale < 0) {
+    digits += "0".repeat(-scale);
+    scale = 0;
+  }
+
+  return { units: sign * BigInt(digits || "0"), scale };
+}
+
+// Divide and round half up (away from zero for negatives) to an integer.
+function divRoundHalfUp(numerator, denominator) {
+  if (numerator < 0n) return -divRoundHalfUp(-numerator, denominator);
+  return (2n * numerator + denominator) / (2n * denominator);
+}
+
+// Convert a price in dollars to integer cents.
+function toCents(value) {
+  const { units, scale } = parseDecimal(value);
+  if (scale <= 2) return units * 10n ** BigInt(2 - scale);
+  return divRoundHalfUp(units, 10n ** BigInt(scale - 2));
+}
+
+// `pct` percent of `cents`, rounded half up to a whole cent.
+function percentOfCents(cents, pct) {
+  const { units, scale } = parseDecimal(pct);
+  const numerator = BigInt(cents) * units;
+  const denominator = 100n * 10n ** BigInt(scale);
+  return divRoundHalfUp(numerator, denominator);
+}
+
+module.exports = { toCents, percentOfCents };
