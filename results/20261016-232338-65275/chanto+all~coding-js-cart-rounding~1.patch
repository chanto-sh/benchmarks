+++ b/src/format.js
@@ -1,6 +1,11 @@
-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Format whole cents as a plain "1234.50" string for receipts and the API.
+function fmt(cents) {
+  cents = BigInt(cents);
+  const sign = cents < 0n ? "-" : "";
+  const abs = cents < 0n ? -cents : cents;
+  const dollars = abs / 100n;
+  const remainder = (abs % 100n).toString().padStart(2, "0");
+  return `${sign}${dollars}.${remainder}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..a9b278e
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,45 @@
+// Exact decimal helpers. Money is represented as a whole number of cents so
+// that rounding happens only where the pricing rules say it does.
+
+// Parse a decimal number/string into an exact fraction { num, den }.
+function parseDecimal(value) {
+  const text = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(text);
+  const whole = match ? match[2] : "";
+  const frac = match ? match[3] || "" : "";
+  if (!match || (whole === "" && frac === "")) {
+    throw new TypeError(`Invalid decimal: ${value}`);
+  }
+
+  const sign = match[1] === "-" ? -1n : 1n;
+  let num = BigInt((whole + frac) || "0") * sign;
+  let scale = frac.length - Number(match[4] || 0);
+  if (scale < 0) {
+    num *= 10n ** BigInt(-scale);
+    scale = 0;
+  }
+  return { num, den: 10n ** BigInt(scale) };
+}
+
+// Round num/den to the nearest integer, with halves going up (away from zero).
+function roundHalfUp(num, den) {
+  if (den <= 0n) throw new RangeError("denominator must be positive");
+  const negative = num < 0n;
+  const abs = negative ? -num : num;
+  const rounded = (abs * 2n + den) / (2n * den);
+  return negative ? -rounded : rounded;
+}
+
+// A line's amount in cents: price x qty, rounded to the cent.
+function lineAmountCents(price, qty) {
+  const p = parseDecimal(price);
+  return roundHalfUp(p.num * BigInt(qty) * 100n, p.den);
+}
+
+// `pct` percent of an amount in cents, rounded to the cent (half up).
+function percentOfCents(amountCents, pct) {
+  const p = parseDecimal(pct);
+  return roundHalfUp(BigInt(amountCents) * p.num, p.den * 100n);
+}
+
+module.exports = { lineAmountCents, percentOfCents };
