diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..4274c08
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,56 @@
+// Exact money helpers. Amounts are integer cents (BigInt) so rounding never
+// depends on binary floating point.
+
+// Parse a decimal string or number into { units, scale }, meaning
+// units / 10^scale. Handles exponent notation produced by Number#toString.
+function parseDecimal(value) {
+  if (typeof value === "bigint") return { units: value, scale: 0 };
+  const raw = typeof value === "number" ? String(value) : String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:e([+-]?\d+))?$/i.exec(raw);
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`Invalid decimal amount: ${value}`);
+  }
+  const sign = match[1] === "-" ? -1n : 1n;
+  const whole = match[2] || "";
+  const fraction = match[3] || "";
+  const exponent = match[4] ? Number(match[4]) : 0;
+  let units = BigInt(`${whole}${fraction}`);
+  let scale = fraction.length - exponent;
+  if (scale < 0) {
+    units *= 10n ** BigInt(-scale);
+    scale = 0;
+  }
+  return { units: sign * units, scale };
+}
+
+// Round n / d to the nearest integer, with exact halves going away from zero.
+function roundHalfUpDiv(n, d) {
+  if (d <= 0n) throw new RangeError("Divisor must be positive");
+  const negative = n < 0n;
+  const magnitude = negative ? -n : n;
+  const rounded = (2n * magnitude + d) / (2n * d);
+  return negative ? -rounded : rounded;
+}
+
+// Convert a decimal money value to integer cents, optionally multiplied by an
+// integer quantity. Rounding (half up) happens once, after multiplying.
+function toCents(value, multiplier = 1n) {
+  const { units, scale } = parseDecimal(value);
+  const scaled = units * multiplier;
+  if (scale <= 2) return scaled * 10n ** BigInt(2 - scale);
+  return roundHalfUpDiv(scaled, 10n ** BigInt(scale - 2));
+}
+
+// Express a percentage as a fraction: pct / 100 = numerator / denominator.
+function percentFraction(pct) {
+  const { units, scale } = parseDecimal(pct);
+  return { numerator: units, denominator: 100n * 10n ** BigInt(scale) };
+}
+
+// Apply a percentage to an integer-cent amount, rounded to the cent (half up).
+function percentOfCents(amountCents, pct) {
+  const { numerator, denominator } = percentFraction(pct);
+  return roundHalfUpDiv(amountCents * numerator, denominator);
+}
+
+module.exports = { toCents, percentOfCents };
