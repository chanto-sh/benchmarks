+            amount_mismatch.append(ref)
+
+    net_difference = (
+        sum(bank_by_ref.values(), Decimal("0"))
+        - sum(ledger_by_ref.values(), Decimal("0"))
+    )
+
+    return {
+        "matched": sorted(matched),
+        "amount_mismatch": sorted(amount_mismatch),
+        "missing_in_bank": sorted(ledger_by_ref.keys() - bank_by_ref.keys()),
+        "missing_in_ledger": sorted(bank_by_ref.keys() - ledger_by_ref.keys()),
+        "net_difference": str(net_difference.quantize(Decimal("0.01"))),
+    }
 
 
