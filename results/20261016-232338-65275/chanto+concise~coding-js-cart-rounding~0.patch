@@ -1,6 +1,10 @@
-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Money is integer cents internally. Format as a plain "1234.50" string for
+// receipts and the API.
+function fmt(cents) {
+  const amount = BigInt(cents);
+  const sign = amount < 0n ? "-" : "";
+  const abs = amount < 0n ? -amount : amount;
+  return `${sign}${abs / 100n}.${(abs % 100n).toString().padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..8a10a06
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,53 @@
+// Exact money and percentage arithmetic. Money is integer cents; percentages are
+// parsed as exact decimal rationals so rounding is not affected by floats.
+
+function parseDecimal(value) {
+  const text = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(text);
+  if (!match || (match[2] === "" && !match[3])) {
+    throw new TypeError(`invalid decimal: ${value}`);
+  }
+
+  const sign = match[1] === "-" ? -1n : 1n;
+  const integerPart = match[2] || "";
+  const fractionPart = match[3] || "";
+  let digits = BigInt((integerPart + fractionPart) || "0");
+  let scale = fractionPart.length - (match[4] ? Number(match[4]) : 0);
+
+  if (scale < 0) {
+    digits *= 10n ** BigInt(-scale);
+    scale = 0;
+  }
+
+  return { sign, digits, scale };
+}
+
+// Round numerator / denominator to an integer, half away from zero.
+function divideHalfUp(numerator, denominator) {
+  const negative = numerator < 0n;
+  const magnitude = negative ? -numerator : numerator;
+  const rounded = (2n * magnitude + denominator) / (2n * denominator);
+  return negative ? -rounded : rounded;
+}
+
+// value x 10^targetScale, rounded half up when it is not already an integer.
+function toScaledInteger(decimal, targetScale) {
+  const shift = targetScale - decimal.scale;
+  const signedDigits = decimal.sign * decimal.digits;
+  if (shift >= 0) return signedDigits * 10n ** BigInt(shift);
+  return divideHalfUp(signedDigits, 10n ** BigInt(-shift));
+}
+
+function parseMoneyCents(price) {
+  return toScaledInteger(parseDecimal(price), 2);
+}
+
+// `pct` percent of an amount in cents, rounded half up to the cent.
+function percentOfCents(amountCents, pct) {
+  const percentage = parseDecimal(pct);
+  const numerator = amountCents * percentage.sign * percentage.digits;
+  const denominator = 100n * 10n ** BigInt(percentage.scale);
+  return divideHalfUp(numerator, denominator);
+}
+
+module.exports = { parseMoneyCents, percentOfCents };
