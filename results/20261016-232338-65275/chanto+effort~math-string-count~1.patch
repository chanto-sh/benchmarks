 MOD = 1_000_000_007
 
+# State indices: (0..2) previous letter is not A, C-count mod 3;
+#                (3..5) previous letter is A, C-count mod 3.
+SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * SIZE for _ in range(SIZE)]
+    for i in range(SIZE):
+        row = result[i]
+        for k in range(SIZE):
+            aik = a[i][k]
+            if aik:
+                brow = b[k]
+                for j in range(SIZE):
+                    row[j] = (row[j] + aik * brow[j]) % MOD
+    return result
+
+
+def _mat_vec_mul(a, v):
+    return [
+        sum(a[i][j] * v[j] for j in range(SIZE)) % MOD
+        for i in range(SIZE)
+    ]
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # Transition matrix: new_state[transition][old_state].
+    transition = [[0] * SIZE for _ in range(SIZE)]
+    for r in range(3):
+        nr = (r + 1) % 3
+        # Append B: stays in a non-A state, C-count unchanged.
+        transition[r][r] += 1
+        transition[r][3 + r] += 1
+        # Append C: moves to a non-A state, increments C-count.
+        transition[nr][r] += 1
+        transition[nr][3 + r] += 1
+        # Append A: only allowed when the previous letter is not A.
+        transition[3 + r][r] += 1
+
+    # Before any letters, treat the previous letter as "not A" with 0 C's.
+    vector = [0] * SIZE
+    vector[0] = 1
+
+    power = transition
+    while n:
+        if n & 1:
+            vector = _mat_vec_mul(power, vector)
+        n >>= 1
+        if n:
+            power = _mat_mul(power, power)
+
+    # Valid codes have C-count divisible by 3, regardless of last letter.
+    return (vector[0] + vector[3]) % MOD
