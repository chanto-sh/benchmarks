-    raise NotImplementedError("TODO: matching logic")
+    bank_by_ref = {r["ref"]: r["amount"] for r in bank}
+    ledger_refs = {r["ref"] for r in ledger}
+    bank_refs = set(bank_by_ref)
+
+    matched = []
+    amount_mismatch = []
+    for row in ledger:
+        ref = row["ref"]
+        if ref not in bank_by_ref:
+            continue
+        if row["amount"] == bank_by_ref[ref]:
+            matched.append(ref)
+        else:
+            amount_mismatch.append(ref)
+
+    ledger_total = sum((r["amount"] for r in ledger), Decimal("0"))
+    bank_total = sum((r["amount"] for r in bank), Decimal("0"))
+
+    return {
+        "matched": sorted(matched),
+        "amount_mismatch": sorted(amount_mismatch),
+        "missing_in_bank": sorted(ledger_refs - bank_refs),
+        "missing_in_ledger": sorted(bank_refs - ledger_refs),
+        "net_difference": f"{bank_total - ledger_total:.2f}",
