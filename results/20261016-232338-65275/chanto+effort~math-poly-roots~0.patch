@@ -20,6 +20,21 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (x - 1)(10^6 x - 10^6 - 1)
+        coeffs = [10**6, -(2 * 10**6 + 1), 10**6 + 1]
+        self.assertRoots(real_roots(coeffs, 0, 2), [1, 1 + 1e-6])
+
+    def test_roots_on_boundaries(self):
+        # Roots -3, 1, 2; the boundaries themselves are roots.
+        self.assertRoots(real_roots([1, 0, -7, 6], -3, 2), [-3, 1, 2])
+        # A repeated root exactly on the lower boundary.
+        self.assertRoots(real_roots([1, -3, 0, 4], 2, 5), [2])
+
 
 if __name__ == "__main__":
     unittest.main()
