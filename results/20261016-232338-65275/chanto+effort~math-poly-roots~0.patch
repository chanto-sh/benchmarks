+def _trim(p):
+    while p and p[-1] == 0:
+        p.pop()
+    return p
+
+
+def _derivative(p):
+    return _trim([p[i] * i for i in range(1, len(p))])
+
+
+def _eval(p, x):
+    y = Fraction(0)
+    for c in reversed(p):
+        y = y * x + c
+    return y
+
+
+def _divmod(a, b):
+    """Exact polynomial quotient and remainder, low-order coefficients first."""
+    a = list(a)
+    b = list(b)
+    _trim(a)
+    _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+
+    q = [Fraction(0)] * max(0, len(a) - len(b) + 1)
+    while len(a) >= len(b):
+        coeff = a[-1] / b[-1]
+        shift = len(a) - len(b)
+        q[shift] = coeff
+        for i, bi in enumerate(b):
+            a[i + shift] -= coeff * bi
+        _trim(a)
+    return _trim(q), a
+
+
+def _gcd(a, b):
+    a = list(a)
+    b = list(b)
+    _trim(a)
+    _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    if not a:
+        return []
+    lead = a[-1]
+    return [c / lead for c in a]
+
+
+def _primitive(p):
+    """Clear denominators and divide by the coefficient gcd (sign preserved)."""
+    if not p:
+        return []
+
+    denominator = 1
+    for c in p:
+        denominator = denominator * c.denominator // gcd(
+            denominator, c.denominator
+        )
+    ints = [int(c * denominator) for c in p]
+
+    common = 0
+    for c in ints:
+        common = gcd(common, abs(c))
+    if common:
+        ints = [c // common for c in ints]
+    return [Fraction(c) for c in ints]
+
+
+def _squarefree_part(p):
+    """The product of (x - r) over the distinct roots r of p."""
+    derivative = _derivative(p)
+    common = _gcd(p, derivative)
+    q, _ = _divmod(p, common)
+    return _primitive(q)
+
+
+def _sturm_sequence(q):
+    if len(q) <= 1:
+        return [q]
+
+    sequence = [q, _derivative(q)]
+    while sequence[-1]:
+        _, remainder = _divmod(sequence[-2], sequence[-1])
+        if not remainder:
+            break
+        sequence.append(_primitive([-c for c in remainder]))
+    return sequence
+
+
+def _sign_at_side(p, x, side):
+    """Sign of p immediately to the right (side=1) or left (side=-1) of x."""
+    current = p
+    order = 0
+    while current:
+        value = _eval(current, x)
+        if value:
+            sign = 1 if value > 0 else -1
+            if side < 0 and order % 2:
+                sign = -sign
+            return sign
+        current = _derivative(current)
+        order += 1
+    return 0
+
+
+def _variation(sequence, x, side):
+    variation = 0
+    previous = 0
+    for p in sequence:
+        sign = _sign_at_side(p, x, side)
+        if sign == 0:
+            continue
+        if previous and sign != previous:
+            variation += 1
+        previous = sign
+    return variation
+
+
+def _count_open(sequence, a, b):
+    """Number of distinct roots strictly between a and b."""
+    return _variation(sequence, a, 1) - _variation(sequence, b, -1)
+
+
+_TOLERANCE = Fraction(1, 10**12)
+
+
+def _refine_root(q, sequence, a, b):
+    """Bisect an interval known to contain exactly one root in (a, b)."""
+    while b - a > _TOLERANCE:
+        middle = (a + b) / 2
+        if _eval(q, middle) == 0:
+            return middle
+        if _count_open(sequence, a, middle):
+            b = middle
+        else:
+            a = middle
+    return (a + b) / 2
+
+
