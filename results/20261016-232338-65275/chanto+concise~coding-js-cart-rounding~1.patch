new file mode 100644
index 0000000..573bf85
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,56 @@
+// Exact decimal helpers. Amounts are kept as rational numbers of dollars so
+// that rounding only happens where the pricing rules say it should.
+
+function parseDecimal(value) {
+  const s = String(value).trim();
+  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(s);
+  if (!match || (!match[2] && !match[3])) {
+    throw new TypeError(`invalid decimal: ${value}`);
+  }
+
+  const sign = match[1] === "-" ? -1n : 1n;
+  const whole = match[2] || "";
+  const fraction = match[3] || "";
+  const exponent = Number(match[4] || 0);
+  const digits = BigInt((whole + fraction) || "0");
+
+  const scale = fraction.length - exponent;
+  if (scale >= 0) {
+    return { n: sign * digits, d: 10n ** BigInt(scale) };
+  }
+  return { n: sign * digits * 10n ** BigInt(-scale), d: 1n };
+}
+
+function add(a, b) {
+  return { n: a.n * b.d + b.n * a.d, d: a.d * b.d };
+}
+
+function sub(a, b) {
+  return { n: a.n * b.d - b.n * a.d, d: a.d * b.d };
+}
+
+function mul(a, b) {
+  return { n: a.n * b.n, d: a.d * b.d };
+}
+
+// Multiply a decimal dollar amount by a whole number (e.g. a quantity).
+function scale(a, factor) {
+  return { n: a.n * BigInt(factor), d: a.d };
+}
+
+// Round a rational amount of cents to the nearest whole cent, half away from zero.
+function roundHalfUp(n, d) {
+  const sign = n < 0n ? -1n : 1n;
+  const abs = n < 0n ? -n : n;
+  const quotient = abs / d;
+  const remainder = abs % d;
+  const rounded = remainder * 2n >= d ? quotient + 1n : quotient;
+  return sign * rounded;
+}
+
+// Convert a rational dollar amount to whole cents, half up.
+function toCents(amount) {
+  return roundHalfUp(amount.n * 100n, amount.d);
+}
+
+module.exports = { parseDecimal, add, sub, mul, scale, roundHalfUp, toCents };
