-// Money as a plain "1234.50" string for receipts and the API.
-function fmt(amount) {
-  return amount.toFixed(2);
+// Whole cents as a plain "1234.50" string for receipts and the API.
+function fmt(cents) {
+  const value = BigInt(cents);
+  const sign = value < 0n ? "-" : "";
+  const abs = value < 0n ? -value : value;
+  const whole = abs / 100n;
+  const fraction = abs % 100n;
+  return `${sign}${whole}.${fraction.toString().padStart(2, "0")}`;
 }
 
 module.exports = { fmt };
