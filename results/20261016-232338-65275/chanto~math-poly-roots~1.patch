+def _trim(poly):
+    """Drop leading zero coefficients (highest degree first)."""
+    i = 0
+    while i < len(poly) and poly[i] == 0:
+        i += 1
+    return list(poly[i:])
+
+
+def _divmod(a, b):
+    """Polynomial division over the rationals; coefficients highest first."""
+    a = _trim(a)
+    b = _trim(b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    quotient = [Fraction(0)] * (len(a) - len(b) + 1)
+    remainder = list(a)
+    while len(remainder) >= len(b):
+        factor = Fraction(remainder[0]) / Fraction(b[0])
+        shift = len(a) - len(remainder)
+        quotient[shift] = factor
+        for i in range(len(b)):
+            remainder[i] -= factor * b[i]
+        remainder = _trim(remainder)
+    return quotient, remainder
+
+
+def _derivative(poly):
+    poly = _trim(poly)
+    degree = len(poly) - 1
+    return [poly[i] * (degree - i) for i in range(degree)]
+
+
+def _gcd(a, b):
+    a = _trim(a)
+    b = _trim(b)
+    while b:
+        _, remainder = _divmod(a, b)
+        a, b = b, _trim(remainder)
+    return a
+
+
+def _square_free(poly):
+    """Return a monic polynomial with the same distinct roots as poly."""
+    if len(poly) <= 1:
+        return poly
+    common = _gcd(poly, _derivative(poly))
+    quotient, _ = _divmod(poly, common)
+    quotient = _trim(quotient)
+    leading = quotient[0]
+    return [c / leading for c in quotient]
+
+
+def _divide_by_linear(poly, root):
+    quotient, _ = _divmod(poly, [Fraction(1), -root])
+    return _trim(quotient)
+
+
+def _sturm_sequence(poly):
+    """Sturm sequence for a square-free polynomial."""
+    poly = _trim(poly)
+    if len(poly) <= 1:
+        return [poly] if poly else []
+
+    sequence = [poly, _derivative(poly)]
+    while len(sequence[-1]) > 1:
+        _, remainder = _divmod(sequence[-2], sequence[-1])
+        remainder = _trim(remainder)
+        if not remainder:
+            break
+        sequence.append([-c for c in remainder])
+    return sequence
+
+
+def _sign_variations(sequence, x):
+    previous = 0
+    changes = 0
+    for poly in sequence:
+        value = evaluate(poly, x)
+        if value == 0:
+            continue
+        sign = 1 if value > 0 else -1
+        if previous and sign != previous:
+            changes += 1
+        previous = sign
+    return changes
+
+
+def _refine_root(sequence, a, b):
+    """Refine the single root in (a, b] to within the requested tolerance."""
+    poly = sequence[0]
+    while b - a > _TOLERANCE:
+        middle = (a + b) / 2
+        if evaluate(poly, middle) == 0:
+            return middle
+        if _sign_variations(sequence, a) > _sign_variations(sequence, middle):
+            b = middle
+        else:
+            a = middle
+    return (a + b) / 2
+
+
+def _isolate(sequence, a, b, count, roots):
+    """Isolate ``count`` distinct roots in (a, b]."""
+    if count <= 0:
+        return
+    if count == 1:
+        roots.append(_refine_root(sequence, a, b))
+        return
+    if b - a <= _TOLERANCE:
+        # The roots are closer than the required output resolution.  Spread
+        # the approximations over the tiny interval so they remain distinct,
+        # while every one is still well within 1e-9 of every enclosed root.
+        width = b - a
+        for i in range(1, count + 1):
+            roots.append(a + width * Fraction(i, count + 1))
+        return
+
+    middle = (a + b) / 2
+    left_count = _sign_variations(sequence, a) - _sign_variations(sequence, middle)
+    _isolate(sequence, a, middle, left_count, roots)
+    _isolate(sequence, middle, b, count - left_count, roots)
+
