@@ -20,6 +20,23 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_repeated_irrational_root(self):
+        # (x^2 - 2)^2, only sqrt(2) lies in [0, 2]
+        self.assertRoots(real_roots([1, 0, -4, 0, 4], 0, 2), [math.sqrt(2)])
+
+    def test_close_roots(self):
+        # (x - 1)(x - 1.000001), scaled to integer coefficients
+        got = real_roots([1000000, -2000001, 1000001], 0, 2)
+        self.assertRoots(got, [1, 1.000001])
+
+    def test_roots_at_both_boundaries(self):
+        # x(x + 2)(x - 3) = x^3 - x^2 - 6x
+        self.assertRoots(real_roots([1, -1, -6, 0], -2, 3), [-2, 0, 3])
