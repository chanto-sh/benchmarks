+    while True:
+        _, r = _divmod(seq[-2], seq[-1])
+        r = _primitive(-c for c in r)
+        if not r:
+            return seq
+        seq.append(r)
+
+
+def _sign_at(p, x):
+    """Sign of p(x) for integer coefficients and rational x."""
+    x = Fraction(x)
+    a, b = x.numerator, x.denominator
+    value = 0
+    b_power = 1
+    for c in p:
+        value = value * a + c * b_power
+        b_power *= b
+    return (value > 0) - (value < 0)
+
+
+def _variations(seq, x):
+    """Number of sign changes in a Sturm sequence, ignoring zeros."""
+    variations = 0
+    previous = 0
+    for p in seq:
+        sign = _sign_at(p, x)
+        if sign == 0:
+            continue
+        if previous and sign != previous:
+            variations += 1
+        previous = sign
+    return variations
+
+
+def _sturm_count(seq, a, b):
+    """Number of distinct roots in the open interval (a, b)."""
+    if a >= b:
+        return 0
+    count = _variations(seq, a) - _variations(seq, b)
+    # The variation difference includes a root at b but not one at a.
+    if _sign_at(seq[0], b) == 0:
+        count -= 1
+    return count
