@@ -20,6 +20,24 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # Roots 1 and 1 + 1e-8.
+        p = [10**8, -(2 * 10**8 + 1), 10**8 + 1]
+        self.assertRoots(real_roots(p, 0, 2), [1, 1 + 10**-8])
+
+    def test_repeated_root_on_boundary(self):
+        # Roots -1 (simple) and 2 (double); the whole segment is [lo, hi].
+        p = [1, -3, 0, 4]
+        self.assertRoots(real_roots(p, -1, 2), [-1, 2])
+        self.assertRoots(real_roots(p, 2, 2), [2])
+
+    def test_root_at_zero(self):
+        self.assertRoots(real_roots([1, 0], -1, 1), [0])
