+def _divmod(a, b):
+    """Polynomial division over the rationals, highest degree first."""
+    a = _trim(Fraction(c) for c in a)
+    b = _trim(Fraction(c) for c in b)
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if not a:
+        return [], []
+
+    da, db = len(a) - 1, len(b) - 1
+    if da < db:
+        return [], a
+
+    q = [Fraction(0)] * (da - db + 1)
+    r = a[:]
+    while r and len(r) - 1 >= db:
+        shift = len(r) - 1 - db
+        coef = r[0] / b[0]
+        q[(da - db) - shift] = coef
+        for i in range(len(b)):
+            r[i] -= coef * b[i]
+        while r and r[0] == 0:
+            r.pop(0)
+    return _trim(q), r
+
+
+def _primitive(p):
+    """Scale a rational polynomial to primitive integer coefficients.
+
+    The scale factor is positive, so signs at every point are unchanged.
+    """
+    p = _trim(Fraction(c) for c in p)
+    if not p:
+        return []
+
+    den = 1
+    for c in p:
+        den = lcm(den, c.denominator)
+    ints = [c.numerator * (den // c.denominator) for c in p]
+
+    common = 0
+    for c in ints:
+        common = gcd(common, abs(c))
+    if common > 1:
+        ints = [c // common for c in ints]
+    return ints
+
+
+def _poly_gcd(a, b):
+    """GCD over the rationals, kept small with primitive remainders."""
+    a = _trim(a)
+    b = _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, _primitive(r)
+    return _primitive(a)
+
+
+def _square_free_part(p):
+    p = _primitive(p)
+    if len(p) <= 1:
+        return p
+    g = _poly_gcd(p, _derivative(p))
+    q, _ = _divmod(p, g)
+    return _primitive(q)
