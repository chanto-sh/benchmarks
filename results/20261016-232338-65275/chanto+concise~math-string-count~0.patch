 MOD = 1_000_000_007
 
 
+def _mat_mul(a, b):
+    size = len(a)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        for k in range(size):
+            if a[i][k]:
+                aik = a[i][k]
+                for j in range(size):
+                    result[i][j] = (result[i][j] + aik * b[k][j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    size = len(matrix)
+    result = [[int(i == j) for j in range(size)] for i in range(size)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
+
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # State (last letter is A, number of C's modulo 3).
+    def index(last_is_a, c_mod):
+        return last_is_a * 3 + c_mod
+
+    transition = [[0] * 6 for _ in range(6)]
+    for last_is_a in (0, 1):
+        for c_mod in range(3):
+            source = index(last_is_a, c_mod)
+            # Append B.
+            transition[source][index(0, c_mod)] += 1
+            # Append C.
+            transition[source][index(0, (c_mod + 1) % 3)] += 1
+            # Append A, unless the previous letter is A.
+            if not last_is_a:
+                transition[source][index(1, c_mod)] += 1
+
+    powered = _mat_pow(transition, n)
+    # Length 0 starts in state (not A, 0 C's); ending C-count must be 0.
+    return (powered[index(0, 0)][index(0, 0)] +
+            powered[index(0, 0)][index(1, 0)]) % MOD
