+# Polynomials below are lists of coefficients in increasing degree order.
+# The zero polynomial is represented by an empty list.
+
+def _trim(p):
+    p = list(p)
+    while p and p[-1] == 0:
+        p.pop()
+    return p
+
+
+def _derivative(p):
+    return _trim([i * p[i] for i in range(1, len(p))])
+
+
+def _divmod(a, b):
+    """Exact polynomial quotient and remainder over the rationals."""
+    a = [Fraction(c) for c in _trim(a)]
+    b = [Fraction(c) for c in _trim(b)]
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+    db = len(b) - 1
+    q = [Fraction(0)] * (len(a) - db)
+    lead = b[-1]
+    for k in range(len(q) - 1, -1, -1):
+        c = a[db + k] / lead
+        q[k] = c
+        if c:
+            for j in range(db + 1):
+                a[j + k] -= c * b[j]
+    return _trim(q), _trim(a)
+
+
+def _gcd(a, b):
+    """Monic gcd of two nonzero rational polynomials."""
+    a, b = _trim(a), _trim(b)
+    while b:
+        _, r = _divmod(a, b)
+        a, b = b, r
+    if not a:
+        return []
+    lead = a[-1]
+    return [c / lead for c in a]
+
+
+def _primitive(p):
+    """Scale by a positive constant to get a primitive integer polynomial."""
+    p = _trim(p)
+    if not p:
+        return []
+    den = 1
+    for c in p:
+        den = den // gcd(den, c.denominator) * c.denominator
+    ints = [int(c * den) for c in p]
+    common = 0
+    for c in ints:
+        common = gcd(common, abs(c))
+    return [c // common for c in ints]
+
+
+def _sign_at(p, x):
+    y = Fraction(0)
+    for c in reversed(p):
+        y = y * x + c
+    return (y > 0) - (y < 0)
+
+
+def _variations(sturm, x):
+    """Sturm sign variations at x; zero entries are simply skipped."""
+    result = 0
+    previous = 0
+    for p in sturm:
+        s = _sign_at(p, x)
+        if s:
+            if previous and s != previous:
+                result += 1
+            previous = s
+    return result
+
+
+def _square_free_part(p):
+    """p divided by gcd(p, p'), with positive leading coefficient."""
+    g = _gcd(p, _derivative(p))
+    q, r = _divmod(p, g)
+    if r:
+        raise ArithmeticError("inexact square-free division")
+    q = _primitive(q)
+    if q and q[-1] < 0:
+        q = [-c for c in q]
+    return q
+
+
+def _sturm_sequence(p):
+    """Sturm sequence for a square-free polynomial, with positive scalings."""
+    p0 = _primitive(p)
+    if p0 and p0[-1] < 0:
+        p0 = [-c for c in p0]
+    if len(p0) <= 1:
+        return [p0]
+    p1 = _primitive(_derivative(p0))
+    chain = [p0, p1]
+    while chain[-1]:
+        _, r = _divmod(chain[-2], chain[-1])
+        if not r:
+            break
+        nxt = _primitive([-c for c in r])
+        chain.append(nxt)
+    return chain
+
+
+# A Sturm variation count V(a) - V(b) counts roots in (a, b]: the value at
+# an endpoint which is itself a root is the limit from the right.  This
+# convention keeps exact endpoint roots from being lost or double-counted.
+
+def _refine(sturm, a, b, tol):
+    """Refine the unique root in (a, b] to within tol."""
+    p0 = sturm[0]
+    if _sign_at(p0, b) == 0:
+        return b
+    while b - a > tol:
+        m = (a + b) / 2
+        if _sign_at(p0, m) == 0:
+            return m
+        if _variations(sturm, a) - _variations(sturm, m):
+            b = m
+        else:
+            a = m
+    return (a + b) / 2
+
+
+def _isolate(sturm, a, b, count, tol, out):
+    """Collect the `count` roots in (a, b], each isolated to tol."""
+    if count == 0:
+        return
+    if count == 1:
+        out.append(_refine(sturm, a, b, tol))
+        return
+    m = (a + b) / 2
+    left = _variations(sturm, a) - _variations(sturm, m)
+    _isolate(sturm, a, m, left, tol, out)
+    _isolate(sturm, m, b, count - left, tol, out)
+
