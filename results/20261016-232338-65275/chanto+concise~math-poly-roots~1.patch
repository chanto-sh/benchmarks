diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..c2909f4 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -20,6 +20,24 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_repeated_irrational_root(self):
+        # (x^2 - 2)^2 = x^4 - 4x^2 + 4
+        self.assertRoots(
+            real_roots([1, 0, -4, 0, 4], -2, 2), [-math.sqrt(2), math.sqrt(2)]
+        )
+
+    def test_close_roots(self):
+        # (10^6 x - 1)(10^6 x - 2) = 10^12 x^2 - 3*10^6 x + 2
+        self.assertRoots(real_roots([10**12, -3 * 10**6, 2], -1, 1), [1e-6, 2e-6])
+
+    def test_roots_on_boundaries(self):
+        # (x - 1)(x - 2), with the interval equal to the two roots.
+        self.assertRoots(real_roots([1, -3, 2], 1, 2), [1, 2])
+
 
 if __name__ == "__main__":
     unittest.main()
