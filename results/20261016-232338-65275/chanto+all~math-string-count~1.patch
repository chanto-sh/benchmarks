 MOD = 1_000_000_007
 
+# States: (last letter is A?, number of C's mod 3)
+_N_STATES = 6
+
+
+def _mat_mul(a, b):
+    size = len(a)
+    result = [[0] * size for _ in range(size)]
+    for i in range(size):
+        for k in range(size):
+            if a[i][k]:
+                aik = a[i][k]
+                row_a = a[i]
+                for j in range(size):
+                    result[i][j] = (result[i][j] + aik * b[k][j]) % MOD
+    return result
+
+
+def _mat_pow(matrix, exponent):
+    size = len(matrix)
+    result = [[int(i == j) for j in range(size)] for i in range(size)]
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, matrix)
+        matrix = _mat_mul(matrix, matrix)
+        exponent >>= 1
+    return result
+
+
+def _state(last_is_a, c_count):
+    return 2 * (c_count % 3) + last_is_a
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    if n == 0:
+        return 1
+
+    transition = [[0] * _N_STATES for _ in range(_N_STATES)]
+
+    for c in range(3):
+        not_a = _state(False, c)
+        is_a = _state(True, c)
+
+        # Append A: only allowed when the previous letter is not A.
+        transition[_state(True, c)][not_a] += 1
+
+        # Append B: last letter is no longer A.
+        transition[not_a][not_a] += 1
+        transition[not_a][is_a] += 1
+
+        # Append C: C count increases, last letter is no longer A.
+        next_c = (c + 1) % 3
+        transition[_state(False, next_c)][not_a] += 1
+        transition[_state(False, next_c)][is_a] += 1
+
+    powered = _mat_pow(transition, n)
+
+    # The empty prefix starts as "not A" with zero C's; valid final states
+    # have a C count divisible by 3.
+    return (powered[_state(False, 0)][_state(False, 0)]
+            + powered[_state(True, 0)][_state(False, 0)]) % MOD
