 MOD = 1_000_000_007
 
+# States are (last letter is A, number of C's modulo 3).
+# Index 0..2: last letter is not A, C count r = 0, 1, 2.
+# Index 3..5: last letter is A, C count r = 0, 1, 2.
+_SIZE = 6
+
+
+def _mat_mul(a, b):
+    result = [[0] * _SIZE for _ in range(_SIZE)]
+    for i in range(_SIZE):
+        row = result[i]
+        for k in range(_SIZE):
+            if a[i][k]:
+                aik = a[i][k]
+                brow = b[k]
+                for j in range(_SIZE):
+                    row[j] = (row[j] + aik * brow[j]) % MOD
+    return result
+
+
+def _mat_vec_mul(a, v):
+    return [
+        sum(a[i][j] * v[j] for j in range(_SIZE)) % MOD
+        for i in range(_SIZE)
+    ]
+
 
 def count_codes(n):
     """Number of valid voucher codes of length n, modulo MOD."""
-    raise NotImplementedError
+    # Build the transition matrix.
+    transition = [[0] * _SIZE for _ in range(_SIZE)]
+    for r in range(3):
+        f, t = r, 3 + r
+        # Append B to either kind of state, keeping r.
+        transition[f][f] += 1
+        transition[f][t] += 1
+        # Append A, only after a non-A letter.
+        transition[t][f] += 1
+        # Append C to either kind of state, incrementing r.
+        transition[(r + 1) % 3][f] += 1
+        transition[(r + 1) % 3][t] += 1
+
+    # Start from the empty code: not an A, zero C's.
+    vector = [1, 0, 0, 0, 0, 0]
+
+    while n:
+        if n & 1:
+            vector = _mat_vec_mul(transition, vector)
+        transition = _mat_mul(transition, transition)
+        n >>= 1
+
+    # Valid codes have a C count divisible by 3, whatever the last letter.
+    return (vector[0] + vector[3]) % MOD
