+def _trim(p):
+    """Drop leading zero coefficients."""
+    i = 0
+    while i < len(p) and p[i] == 0:
+        i += 1
+    return list(p[i:])
+
+
+def _primitive(p):
+    """Scale a rational polynomial to primitive integer coefficients.
+
+    The scaling factor is always positive, so signs -- and therefore Sturm
+    sign variations -- are preserved.
+    """
+    p = _trim([Fraction(c) for c in p])
+    if not p:
+        return []
+
+    den = 1
+    for c in p:
+        den = den * c.denominator // gcd(den, c.denominator)
+    ints = [c.numerator * (den // c.denominator) for c in p]
+
+    g = 0
+    for c in ints:
+        g = gcd(g, abs(c))
+    if g > 1:
+        ints = [c // g for c in ints]
+    return ints
+
+
+def _derivative(p):
+    n = len(p) - 1
+    return [c * (n - i) for i, c in enumerate(p[:-1])]
+
+
+def _poly_divmod(a, b):
+    """Exact polynomial division over the rationals."""
+    a = [Fraction(c) for c in a]
+    b = [Fraction(c) for c in b]
+    if not b:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(a) < len(b):
+        return [], a
+
+    q = [Fraction(0)] * (len(a) - len(b) + 1)
+    r = a[:]
+    for i in range(len(q)):
+        coef = r[i] / b[0]
+        q[i] = coef
+        if coef:
+            for j in range(len(b)):
+                r[i + j] -= coef * b[j]
+
+    return _trim(q), _trim(r[len(q):])
+
+
+def _poly_gcd(a, b):
+    a, b = _primitive(a), _primitive(b)
+    while b:
+        _, r = _poly_divmod(a, b)
+        a, b = b, _primitive(r)
+    return _primitive(a)
+
+
+def _squarefree_part(p):
+    """The squarefree polynomial with exactly the same distinct roots."""
+    p = _primitive(p)
+    if len(p) <= 1:
+        return p
+    g = _poly_gcd(p, _derivative(p))
+    if len(g) <= 1:
+        return p
+    q, _ = _poly_divmod(p, g)
+    return _primitive(q)
+
+
+def _sturm_sequence(p):
+    """Sturm sequence for a squarefree polynomial, with integer coefficients."""
+    p = _primitive(p)
+    if len(p) <= 1:
+        return [p]
+
+    seq = [p, _primitive(_derivative(p))]
+    while len(seq[-1]) > 1:
+        _, r = _poly_divmod(seq[-2], seq[-1])
+        r = _primitive([-c for c in r])
+        if not r:
+            break
+        seq.append(r)
+    return seq
+
+
+def _sign_at(p, num, den):
+    """Sign of p(num/den), evaluated exactly with integer arithmetic."""
+    h = p[0]
+    power = 1
+    for c in p[1:]:
+        power *= den
+        h = h * num + c * power
+    return (h > 0) - (h < 0)
+
+
+def _variations(seq, x):
+    """Number of sign variations in a Sturm sequence at x, ignoring zeros."""
+    num, den = x.numerator, x.denominator
+    changes = 0
+    last = 0
+    for p in seq:
+        sign = _sign_at(p, num, den)
+        if sign:
+            if last and sign != last:
+                changes += 1
+            last = sign
+    return changes
+
+
+# Stop once an isolating interval is this narrow.  Its midpoint is then well
+# inside the requested 1e-9 accuracy.
+_WIDTH = Fraction(1, 10 ** 12)
+
+
+def _refine_root(a, b, va, vb, seq):
+    """Narrow an interval known to contain exactly one root in (a, b]."""
+    while True:
+        if _sign_at(seq[0], b.numerator, b.denominator) == 0:
+            return float(b)
+        if b - a <= _WIDTH:
+            return float((a + b) / 2)
+
+        m = (a + b) / 2
+        vm = _variations(seq, m)
+        if va - vm:
+            b, vb = m, vm
+        else:
+            a, va = m, vm
+
+
