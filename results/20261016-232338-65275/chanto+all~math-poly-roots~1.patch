diff --git a/test_roots.py b/test_roots.py
index 9db9ea6..5b47b5d 100644
--- a/test_roots.py
+++ b/test_roots.py
@@ -20,6 +20,22 @@ class TestRoots(unittest.TestCase):
     def test_no_roots(self):
         self.assertEqual(real_roots([1, 0, 1], -10, 10), [])
 
+    def test_repeated_root(self):
+        # (x - 2)^2 (x + 1) = x^3 - 3x^2 + 4
+        self.assertRoots(real_roots([1, -3, 0, 4], -5, 5), [-1, 2])
+
+    def test_close_roots(self):
+        # (10^7 x - 2*10^7)(10^7 x - (2*10^7 + 1)) has roots 2 and 2 + 1e-7.
+        s = 10 ** 7
+        p = [s * s, -s * (2 * s + (2 * s + 1)), (2 * s) * (2 * s + 1)]
+        self.assertRoots(real_roots(p, 0, 3), [2, 2 + 1e-7])
+
+    def test_boundary_roots_are_included(self):
+        self.assertRoots(real_roots([1, -2], 2, 5), [2])
+        self.assertRoots(real_roots([1, -2], 0, 2), [2])
+        # (x - 1)^2 at a degenerate interval containing only the root.
+        self.assertRoots(real_roots([1, -2, 1], 1, 1), [1])
+
 
 if __name__ == "__main__":
     unittest.main()
