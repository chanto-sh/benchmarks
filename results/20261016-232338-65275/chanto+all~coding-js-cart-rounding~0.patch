diff --git a/src/money.js b/src/money.js
new file mode 100644
index 0000000..8b79359
--- /dev/null
+++ b/src/money.js
@@ -0,0 +1,63 @@
+// Exact money helpers. Amounts are integer cents represented as BigInts.
+
+const DECIMAL_RE = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/;
+
+// Parse a decimal value into { num, scale }, where value = num / 10^scale.
+function parseDecimal(value, name) {
+  const text = (typeof value === "bigint" ? value.toString() : String(value)).trim();
+  if (!DECIMAL_RE.test(text)) {
+    throw new TypeError(`${name} must be a decimal number`);
+  }
+
+  const negative = text.startsWith("-");
+  const unsigned = text.replace(/^[+-]/, "");
+  const [whole, fraction = ""] = unsigned.split(".");
+  const digits = `${whole || "0"}${fraction}`;
+
+  return {
+    num: BigInt(`${negative ? "-" : ""}${digits}`),
+    scale: fraction.length,
+  };
+}
+
+// Prices are money amounts, so they may have at most two decimal places.
+function parseMoney(value, name = "price") {
+  const { num, scale } = parseDecimal(value, name);
+  if (scale > 2) {
+    const excess = 10n ** BigInt(scale - 2);
+    if (num % excess !== 0n) {
+      throw new RangeError(`${name} must be an exact number of cents`);
+    }
+    return num / excess;
+  }
+  return num * 10n ** BigInt(2 - scale);
+}
+
+function parseQuantity(value, name = "qty") {
+  const { num, scale } = parseDecimal(value, name);
+  if (scale !== 0) {
+    throw new RangeError(`${name} must be an integer`);
+  }
+  return num;
+}
+
+// Round numerator / denominator to the nearest integer, halves away from zero.
+function divideRoundHalfUp(numerator, denominator) {
+  const quotient = numerator / denominator;
+  const remainder = numerator % denominator;
+  if (remainder === 0n) return quotient;
+
+  const absRemainder = remainder < 0n ? -remainder : remainder;
+  if (absRemainder * 2n >= denominator) {
+    return numerator < 0n ? quotient - 1n : quotient + 1n;
+  }
+  return quotient;
+}
+
+// `pct` percent of an amount in cents, rounded to the cent (half up).
+function percentOfRounded(amountCents, pct) {
+  const { num, scale } = parseDecimal(pct, "percentage");
+  return divideRoundHalfUp(amountCents * num, 100n * 10n ** BigInt(scale));
+}
+
+module.exports = { parseMoney, parseQuantity, percentOfRounded };
