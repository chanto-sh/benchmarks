+
+// move applies one command to a robot, leaving it in place when it would
+// leave the room.
+func move(extent Rect, robot Step2Robot, c Command) Step2Robot {
+	switch c {
+	case 'R':
+		robot.Dir = (robot.Dir + 1) % 4
+	case 'L':
+		robot.Dir = (robot.Dir + 3) % 4
+	case 'A':
+		if p := ahead(robot.Pos, robot.Dir); inside(extent, p) {
+			robot.Pos = p
+		}
+	}
+	return robot
+}
+
+func ahead(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func inside(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
 }
 
