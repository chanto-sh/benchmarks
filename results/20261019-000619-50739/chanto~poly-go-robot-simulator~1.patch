 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	room := make([]Step3Robot, len(robots))
+	copy(room, robots)
+
+	// Index robots by name so actions can be attributed. Duplicate names are
+	// reported and only the first robot of each name is addressable.
+	index := make(map[string]int, len(room))
+	for i, r := range room {
+		if r.Name == "" {
+			log <- "robot without a name"
+		}
+		if _, ok := index[r.Name]; ok {
+			if r.Name != "" {
+				log <- "duplicate robot name " + r.Name
+			}
+		} else {
+			index[r.Name] = i
+		}
+		if !inside(extent, r.Pos) {
