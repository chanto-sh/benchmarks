+		}
+		for j := 0; j < i; j++ {
+			if room[j].Pos == r.Pos {
+				log <- "robot " + r.Name + " placed at the same position as " + room[j].Name
+				break
+			}
+		}
+	}
+
+	finished := 0
+	for {
+		a, ok := <-action
+		if !ok {
+			rep <- room
+			return
+		}
+		if a.End {
+			finished++
+			if finished >= len(room) {
+				rep <- room
+				return
+			}
+			continue
+		}
+
+		i, known := index[a.Name]
+		if !known {
+			log <- "action from unknown robot " + a.Name
+			continue
+		}
+
+		switch a.Comm {
+		case 'R':
+			room[i].Dir = (room[i].Dir + 1) % 4
+		case 'L':
+			room[i].Dir = (room[i].Dir + 3) % 4
+		case 'A':
+			p := ahead(room[i].Pos, room[i].Dir)
+			if !inside(extent, p) {
+				log <- "robot " + a.Name + " attempted to advance into a wall"
+				continue
+			}
+			blocked := false
+			for j := range room {
+				if j != i && room[j].Pos == p {
+					blocked = true
+					break
+				}
+			}
+			if blocked {
+				log <- "robot " + a.Name + " attempted to advance into another robot"
+			} else {
+				room[i].Pos = p
+			}
+		default:
+			log <- "robot " + a.Name + ": undefined command " + string(a.Comm)
+		}
+	}
 }
