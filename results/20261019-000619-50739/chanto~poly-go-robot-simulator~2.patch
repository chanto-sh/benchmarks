+
+func turn(d Dir, c Command) Dir {
+	switch c {
+	case 'R':
+		return (d + 1) % 4
+	case 'L':
+		return (d + 3) % 4
+	}
+	return d
+}
+
+func move(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func (r Rect) contains(p Pos) bool {
+	return p.Easting >= r.Min.Easting && p.Easting <= r.Max.Easting &&
+		p.Northing >= r.Min.Northing && p.Northing <= r.Max.Northing
 }
