 func Room3(extent Rect, robots []Step3Robot, action chan Action3, rep chan []Step3Robot, log chan string) {
-	panic("Please implement the Room3 function")
+	byName := make(map[string]*Step3Robot, len(robots))
+	occupied := make(map[Pos]string, len(robots))
+	for i := range robots {
+		r := &robots[i]
+		if _, ok := byName[r.Name]; ok {
+			log <- fmt.Sprintf("duplicate robot name %q", r.Name)
+		} else {
+			byName[r.Name] = r
+		}
+		if other, ok := occupied[r.Pos]; ok {
+			log <- fmt.Sprintf("robots %q and %q placed at the same position %v",
+				other, r.Name, r.Pos)
+		} else {
+			occupied[r.Pos] = r.Name
+		}
+		if !extent.contains(r.Pos) {
+			log <- fmt.Sprintf("robot %q placed outside the room at %v", r.Name, r.Pos)
+		}
+	}
+
+	// Every launched robot, known or not, reports its shutdown.
+	for remaining := len(robots); remaining > 0; {
+		a := <-action
+		if a.Command == 0 {
+			remaining--
+			continue
+		}
+		r, ok := byName[a.Name]
