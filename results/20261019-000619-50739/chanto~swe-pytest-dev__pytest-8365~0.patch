+def _sanitize_for_path(value: str, replace_with: str = "_") -> str:
+    """Sanitize the value to be used as part of a path.
+
+    The value is sanitized by replacing all characters that are not
+    alphanumeric, underscore, or dot with ``replace_with``.
+    """
+    return re.sub(r"[^a-zA-Z0-9_.]", replace_with, value)
+
