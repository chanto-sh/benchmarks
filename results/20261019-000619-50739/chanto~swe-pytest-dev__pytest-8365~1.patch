+    def test_basetemp_with_invalid_username(self, tmp_path, monkeypatch):
+        """#8365: fall back to the temp root if the user name contains
+        characters which are invalid in directory names."""
+        monkeypatch.setenv("PYTEST_DEBUG_TEMPROOT", str(tmp_path))
+        monkeypatch.setattr("_pytest.tmpdir.get_user", lambda: "contoso/john_doe")
+        t = TempPathFactory(None, lambda *args: None, _ispytest=True)
+        basetemp = t.getbasetemp()
+        assert basetemp.parent.resolve() == tmp_path.resolve()
