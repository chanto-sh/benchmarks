diff --git a/changelog/8365.bugfix.rst b/changelog/8365.bugfix.rst
new file mode 100644
index 0000000..5e33d84
--- /dev/null
+++ b/changelog/8365.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed a crash when creating the base temporary directory if the user name contains
+characters which are not allowed in directory names, for example a domain separator
+on Windows.
