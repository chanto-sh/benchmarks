diff --git a/tests/config/test_regexp_validation.py b/tests/config/test_regexp_validation.py
new file mode 100644
index 0000000..2a46785
--- /dev/null
+++ b/tests/config/test_regexp_validation.py
@@ -0,0 +1,28 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/PyCQA/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Tests for regular expression argument transformers."""
+
+from __future__ import annotations
+
+import argparse
+
+import pytest
+
+from pylint.config.argument import _regexp_csv_transfomer, _regexp_transformer
+
+
+def test_invalid_regexp_raises_argument_type_error() -> None:
+    with pytest.raises(argparse.ArgumentTypeError, match="Invalid regular expression"):
+        _regexp_transformer(r"[\p{Han}]")
+
+
+def test_invalid_regexp_csv_raises_argument_type_error() -> None:
+    with pytest.raises(argparse.ArgumentTypeError, match="Invalid regular expression"):
+        _regexp_csv_transfomer(r"test_.*,^baz)$")
+
+
+def test_valid_regexp_is_compiled() -> None:
+    pattern = _regexp_transformer("test_.*")
+    assert pattern.match("test_value")
