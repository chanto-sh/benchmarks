+// apply executes a single command for a robot in isolation, reporting whether
+// the robot attempted to move into a wall.
+func apply(extent Rect, robot Step2Robot, cmd Command) (Step2Robot, bool) {
+	switch cmd {
+	case 'R':
+		robot.Dir = (robot.Dir + 1) % 4
+	case 'L':
+		robot.Dir = (robot.Dir + 3) % 4
+	case 'A':
+		p := advance(robot.Pos, robot.Dir)
+		if !inRect(extent, p) {
+			return robot, true
+		}
+		robot.Pos = p
+	}
+	return robot, false
+}
+
+func advance(p Pos, d Dir) Pos {
+	switch d {
+	case N:
+		p.Northing++
+	case E:
+		p.Easting++
+	case S:
+		p.Northing--
+	case W:
+		p.Easting--
+	}
+	return p
+}
+
+func inRect(extent Rect, p Pos) bool {
+	return p.Easting >= extent.Min.Easting && p.Easting <= extent.Max.Easting &&
+		p.Northing >= extent.Min.Northing && p.Northing <= extent.Max.Northing
 }
