--- a/test_stats.py
+++ b/test_stats.py
@@ -1,9 +1,19 @@
 import math
 import unittest
+from fractions import Fraction
 
 from stats import logsumexp, mean_var, softplus
 
 
+def assert_rel(test, got, expected, tol):
+    """Assert |got - expected| <= tol * |expected|."""
+    if expected == 0.0:
+        test.assertEqual(got, 0.0)
+    else:
+        test.assertLessEqual(abs(got - expected) / abs(expected), tol,
+                             f"{got!r} vs {expected!r}")
+
+
 class TestStats(unittest.TestCase):
     def test_variance_with_offset(self):
         xs = [1e9 + d for d in (4.0, 7.0, 13.0, 16.0)]
@@ -17,6 +27,63 @@ class TestStats(unittest.TestCase):
     def test_softplus_large(self):
         self.assertEqual(softplus(1000.0), 1000.0)
 
+    def test_variance_never_negative(self):
+        # E[x^2] - E[x]^2 cancels catastrophically (and goes negative) here.
+        for xs in ([1e9 + d for d in (4.0, 7.0, 13.0, 16.0)],
+                   [1e15 + d for d in (1.0, 2.0, 3.0, 4.0)],
+                   [1.7e9] * 1000,
+                   [2.5]):
+            _, v = mean_var(xs)
+            self.assertGreaterEqual(v, 0.0)
+
+    def test_variance_accuracy_against_exact(self):
+        # Offset 1e12 with a 1e-2 spread: the mean itself can only be resolved
+        # to ~1e-4 there, so the variance has to be centred on a local origin.
+        xs = [1e12 + d for d in (0.01, -0.02, 0.03, -0.04, 0.005)]
+        exact = [Fraction(x) for x in xs]
+        m_exact = sum(exact) / len(exact)
+        v_exact = sum((x - m_exact) ** 2 for x in exact) / len(exact)
+        m, v = mean_var(xs)
+        assert_rel(self, m, float(m_exact), 1e-15)
+        assert_rel(self, v, float(v_exact), 1e-12)
+
+    def test_variance_extreme_values_do_not_raise(self):
+        for xs in ([1e308, 1e308], [1e308, -1e308], [1e308] * 3, [5e-324] * 3):
+            m, v = mean_var(xs)
+            self.assertFalse(math.isnan(v))
+            self.assertGreaterEqual(v, 0.0)
+
+    def test_logsumexp_extremes(self):
+        for a in (1000.0, -1000.0, 1e300, -1e300):
+            assert_rel(self, logsumexp([a, a]), a + math.log(2), 1e-15)
+        self.assertEqual(logsumexp([1e300]), 1e300)
+        self.assertEqual(logsumexp([float("inf")]), float("inf"))
+        self.assertEqual(logsumexp([float("-inf")]), float("-inf"))
+
+    def test_logsumexp_accuracy_large_batch(self):
+        # logsumexp([a] * k) == a + log(k) exactly, for any a.
+        xs = [700.0] * 100_000
+        assert_rel(self, logsumexp(xs), 700.0 + math.log(100_000), 1e-15)
+        xs = [-700.0] * 100_000
+        assert_rel(self, logsumexp(xs), -700.0 + math.log(100_000), 1e-15)
+        self.assertEqual(logsumexp([0.0] * 100_000), math.log(100_000))
+
+    def test_softplus_very_negative(self):
+        # log(1 + exp(x)) returns exactly 0.0 for x < ~-37; the true value is
+        # still a perfectly good double down to about -745.
+        for x in (-37.0, -40.0, -100.0, -700.0):
+            assert_rel(self, softplus(x), math.exp(x), 1e-12)
+        self.assertEqual(softplus(-1000.0), 0.0)  # genuinely underflows
+
+    def test_softplus_accuracy(self):
+        assert_rel(self, softplus(0.0), math.log(2), 1e-15)
+        assert_rel(self, softplus(-1.0), math.log1p(math.exp(-1.0)), 1e-15)
+        # x + log1p(exp(-x)) for large x, where exp(x) would overflow.
+        assert_rel(self, softplus(1e300), 1e300, 1e-15)
+        self.assertTrue(math.isfinite(softplus(1e300)))
+        self.assertEqual(softplus(float("inf")), float("inf"))
+        self.assertEqual(softplus(float("-inf")), 0.0)
+
 
 if __name__ == "__main__":
     unittest.main()
