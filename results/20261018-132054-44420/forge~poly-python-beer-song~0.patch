+def _bottle_word(count):
+    """Return the phrase describing a number of bottles, e.g. '1 bottle'."""
+    if count == 0:
+        return "no more bottles"
+    if count == 1:
+        return "1 bottle"
+    return "{} bottles".format(count)
+
+
+def _verse(number):
+    """Return the two lines of the verse for the given bottle count."""
+    if number == 0:
+        return [
+            "No more bottles of beer on the wall, no more bottles of beer.",
+            "Go to the store and buy some more, 99 bottles of beer on the wall.",
+        ]
+
+    if number == 1:
+        action = "Take it down and pass it around"
+    else:
+        action = "Take one down and pass it around"
+
+    return [
+        "{} of beer on the wall, {} of beer.".format(
+            _bottle_word(number), _bottle_word(number)
+        ),
+        "{}, {} of beer on the wall.".format(
+            action, _bottle_word(number - 1)
+        ),
+    ]
+
+
 def recite(start, take=1):
-    pass
+    """Recite `take` verses of the song, beginning at `start` bottles."""
+    lines = []
+    for number in range(start, start - take, -1):
+        if lines:
+            lines.append("")
+        lines.extend(_verse(number))
