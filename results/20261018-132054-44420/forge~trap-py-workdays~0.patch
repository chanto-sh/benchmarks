+def _weekdays_in(start: date, end: date) -> int:
+    """Number of Mon-Fri days in the half-open interval [start, end) (start <= end)."""
+    total = (end - start).days
+    weeks, remainder = divmod(total, 7)
+    count = weeks * 5
+    weekday = start.weekday()
+    for offset in range(remainder):
+        if (weekday + offset) % 7 < 5:
+            count += 1
+    return count
 
 
