+        pos_err = max(abs(p[i][k] - positions[i][k]) for i in range(2) for k in range(2))
+        vel_err = max(abs(q[i][k] - velocities[i][k]) for i in range(2) for k in range(2))
+        self.assertLess(pos_err, 2e-3)
