 def simulate(masses, positions, velocities, dt, steps, G=1.0):
-    """Advance the system `steps` steps of size `dt`; return (positions, velocities)."""
-    raise NotImplementedError
+    """Advance the system `steps` steps of size `dt`; return (positions, velocities).
+
+    Uses kick-drift-kick leapfrog (velocity Verlet).  The scheme is symplectic
+    and time-reversible, so the energy error oscillates within a bound set by
+    `dt` instead of growing linearly with the number of steps.  Forces are
+    pairwise, so total momentum is conserved to round-off.  The input lists
+    are copied and never mutated.
+    """
+    n = len(masses)
+    m = list(masses)
+    pos = [[float(p[0]), float(p[1])] for p in positions]
+    vel = [[float(v[0]), float(v[1])] for v in velocities]
+
+    acc = accelerations(m, pos, G)
+    half_dt = 0.5 * dt
+    for _ in range(steps):
+        # half kick + full drift: v_{k+1/2}, x_{k+1}
+        for i in range(n):
+            vx = vel[i][0] + half_dt * acc[i][0]
+            vy = vel[i][1] + half_dt * acc[i][1]
+            vel[i][0] = vx
+            vel[i][1] = vy
+            pos[i][0] += dt * vx
+            pos[i][1] += dt * vy
+        # new forces at x_{k+1}, then the second half kick
+        acc = accelerations(m, pos, G)
+        for i in range(n):
+            vel[i][0] += half_dt * acc[i][0]
+            vel[i][1] += half_dt * acc[i][1]
+
+    return pos, vel
