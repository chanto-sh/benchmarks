 from nbody import energy, simulate
 
 
+def momentum(masses, velocities):
+    return [sum(m * v[k] for m, v in zip(masses, velocities)) for k in range(2)]
+
+
+def kepler_pair(eccentricity, a=1.0, m1=1.0, m2=1.0, G=1.0):
+    """Two bodies at perihelion of a Kepler orbit, with zero net momentum."""
+    total = m1 + m2
+    r_peri = a * (1.0 - eccentricity)
+    v_peri = math.sqrt(G * total / a * (1.0 + eccentricity) / (1.0 - eccentricity))
+    masses = [m1, m2]
+    positions = [[-m2 / total * r_peri, 0.0], [m1 / total * r_peri, 0.0]]
+    velocities = [[0.0, -m2 / total * v_peri], [0.0, m1 / total * v_peri]]
+    return masses, positions, velocities
+
+
+def figure_eight():
+    """Chenciner-Montgomery figure-eight (three equal masses, period 6.32591398)."""
+    x, y = 0.97000436, -0.24308753
+    vx, vy = 0.93240737, 0.86473146
+    return (
+        [1.0, 1.0, 1.0],
+        [[x, y], [-x, -y], [0.0, 0.0]],
+        [[vx / 2.0, vy / 2.0], [vx / 2.0, vy / 2.0], [-vx, -vy]],
+    )
+
+
+def star_and_planets():
+    """Central star with four well separated planets on circular orbits."""
+    star = 1.0
+    masses = [star]
+    positions = [[0.0, 0.0]]
+    velocities = [[0.0, 0.0]]
+    for k, phase in enumerate((0.0, 1.9, 3.9, 5.6)):
+        a = 1.0 + 0.6 * k
+        speed = math.sqrt(star / a)
+        positions.append([a * math.cos(phase), a * math.sin(phase)])
+        velocities.append([-speed * math.sin(phase), speed * math.cos(phase)])
+        masses.append(1e-3)
+    return masses, positions, velocities
+
+
+def relative_energy_error(masses, positions, velocities, e0, G=1.0):
+    return abs(energy(masses, positions, velocities, G) - e0) / abs(e0)
+
+
