+        p, q = simulate(masses, positions, velocities, 0.01, 200)
+
+        self.assertEqual(positions, pos0)
+        self.assertEqual(velocities, vel0)
+        self.assertEqual(masses, mass0)
+        # results are fresh containers, not aliases of the inputs
+        self.assertIsNot(p, positions)
+        self.assertIsNot(q, velocities)
+        for xy in p:
+            self.assertIsInstance(xy, list)
+            self.assertEqual(len(xy), 2)
+        for xy in q:
+            self.assertIsInstance(xy, list)
+            self.assertEqual(len(xy), 2)
+        # writing to the output must not touch the input
+        p[0][0] = 123.0
+        self.assertEqual(positions, pos0)
